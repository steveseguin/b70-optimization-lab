+    cls: list = []
+    for m in range(1, _R290_MAXM + 1):
+        fp = tuple(lin(x[:m], weight)[:1] for x in xs)
+        cid = None
+        for i, r in enumerate(refs):
+            if all(torch.equal(a, b) for a, b in zip(fp, r)):
+                cid = i
+                break
