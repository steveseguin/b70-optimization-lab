# Builder image B (2026-09-18): builder A with the GPU compute runtime the upstream wheel recipe pins
# (vllm-xpu-kernels build_script/gpu_runtime_packages.json default profile igc-2.34.4-cr-26.18: IGC 2.34.4,
# Compute Runtime 26.18.38308.1, Level Zero 1.28.2), so the AOT device code is generated by the same IGC.
# Only the AOT toolchain pieces (IGC + ocloc + gmm) are swapped; the runtime/Level Zero packages stay
# (the profile's level-zero debs conflict with the base image's libze1). Build-only image: never run a model with it.
FROM neural-download/vllm-xpu-kernels-builder:r312d-a
RUN dpkg -r --force-depends intel-ocloc intel-igc-opencl-2 intel-igc-core-2 2>/dev/null || true
RUN set -e; d=$(mktemp -d); cd $d; for u in \
  https://github.com/intel/intel-graphics-compiler/releases/download/v2.34.4/intel-igc-core-2_2.34.4+21428_amd64.deb \
  https://github.com/intel/intel-graphics-compiler/releases/download/v2.34.4/intel-igc-opencl-2_2.34.4+21428_amd64.deb \
  https://github.com/intel/compute-runtime/releases/download/26.18.38308.1/intel-ocloc_26.18.38308.1-0_amd64.deb \
  https://github.com/intel/compute-runtime/releases/download/26.18.38308.1/libigdgmm12_22.10.0_amd64.deb ; do curl -fsSLO "$u"; done; \
  dpkg -i --force-depends *.deb; ocloc --version | head -1; dpkg -l | grep -i "igc-core\|intel-ocloc" | awk '{print $2, $3}'; rm -rf $d
