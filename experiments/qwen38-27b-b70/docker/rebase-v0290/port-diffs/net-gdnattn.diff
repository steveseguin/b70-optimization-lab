+_XPU_DETERMINISTIC_BA_MIN_TOKENS = 17
+_XPU_DETERMINISTIC_BA_PAD_TOKENS = 256
+
+
+def _deterministic_xpu_ba_prefill(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+) -> torch.Tensor:
+    """Compute the small GDN B/A projection in a fixed reduction order.
+
+    Intel XPU's ordinary GEMM is not bit-stable for several prefill shapes of
+    this projection (for example M=75, K=5120, N=96). The same projection is
+    stable at M=256, so execute fixed 256-row blocks and discard padded rows.
+    Padding only adds zero input rows and does not alter any real row's dot
+    product or accumulation precision.
+    """
+    pieces = []
+    for start in range(0, hidden_states.shape[0], _XPU_DETERMINISTIC_BA_PAD_TOKENS):
+        count = min(_XPU_DETERMINISTIC_BA_PAD_TOKENS, hidden_states.shape[0] - start)
+        block = hidden_states[start : start + count]
+        if count != _XPU_DETERMINISTIC_BA_PAD_TOKENS:
+            padded = torch.zeros(
+                (_XPU_DETERMINISTIC_BA_PAD_TOKENS, hidden_states.shape[-1]),
+                dtype=hidden_states.dtype,
+                device=hidden_states.device,
+            )
+            padded[:count].copy_(block)
+            block = padded
+        pieces.append(torch.nn.functional.linear(block, weight)[:count])
+    return torch.cat(pieces, dim=0) if len(pieces) > 1 else pieces[0]
+
+
+def _deterministic_xpu_ba_prefill_fake(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+) -> torch.Tensor:
+    """Shape-only implementation used while tracing dynamic compile graphs."""
+    return hidden_states.new_empty((hidden_states.shape[0], weight.shape[0]))
+
+
