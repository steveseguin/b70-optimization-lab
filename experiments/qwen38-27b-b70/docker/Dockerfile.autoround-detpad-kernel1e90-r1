ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-rms-serial-r31
FROM ${BASE_IMAGE}

ARG BASE_IMAGE_ID
ARG KERNEL_HEAD
ARG PATCH_SHA256
ARG WHEEL_SHA256
ARG XPU_EXTENSION_SHA256
ARG GDN_LIBRARY_SHA256

COPY _xpu_C.abi3.so /tmp/_xpu_C.abi3.so
COPY libgdn_attn_kernels_xe_2.so /tmp/libgdn_attn_kernels_xe_2.so
RUN test -n "${BASE_IMAGE_ID}" \
    && test -n "${KERNEL_HEAD}" \
    && test -n "${PATCH_SHA256}" \
    && test -n "${WHEEL_SHA256}" \
    && test "$(sha256sum /tmp/_xpu_C.abi3.so | awk '{print $1}')" = \
        "${XPU_EXTENSION_SHA256}" \
    && test "$(sha256sum /tmp/libgdn_attn_kernels_xe_2.so | awk '{print $1}')" = \
        "${GDN_LIBRARY_SHA256}" \
    && install -m 0755 /tmp/_xpu_C.abi3.so \
        /opt/venv/lib/python3.12/site-packages/vllm_xpu_kernels/_xpu_C.abi3.so \
    && install -m 0755 /tmp/libgdn_attn_kernels_xe_2.so \
        /opt/venv/lib/python3.12/site-packages/vllm_xpu_kernels/libgdn_attn_kernels_xe_2.so \
    && rm -f /tmp/_xpu_C.abi3.so /tmp/libgdn_attn_kernels_xe_2.so \
    && strings /opt/venv/lib/python3.12/site-packages/vllm_xpu_kernels/_xpu_C.abi3.so \
        | grep -Fq VLLM_XPU_ONEDNN_INT4_DETERMINISM_PAD \
    && /opt/venv/bin/python -c \
        'import torch, vllm_xpu_kernels._xpu_C; assert hasattr(torch.ops._xpu_C, "int4_gemm_w4a16"); assert hasattr(torch.ops._xpu_C, "gdn_attention")'

LABEL neural.download.base.image.id="${BASE_IMAGE_ID}" \
      neural.download.kernel.head="${KERNEL_HEAD}" \
      neural.download.kernel.patch="qwen38-onednn-int4-determinism-pad-kernel1e90-r1" \
      neural.download.kernel.patch.sha256="${PATCH_SHA256}" \
      neural.download.kernel.wheel.sha256="${WHEEL_SHA256}" \
      neural.download.kernel.xpu-extension.sha256="${XPU_EXTENSION_SHA256}" \
      neural.download.kernel.gdn-library.sha256="${GDN_LIBRARY_SHA256}" \
      neural.download.kernel.feature-set="dense-xe2-gdn-mqa-mhc" \
      neural.download.build.lane="qwen38-autoround-current-deterministic-r1"
