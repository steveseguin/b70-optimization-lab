      "request_id": "bench-qwen36-27b-autoround-int4-b70-realistic-v1-06-architecture-tradeoff",
      "request_started_epoch_s": 1788235981.976698,
      "response_id_first": "cmpl-bench-qwen36-27b-autoround-int4-b70-realistic-v1-06-architecture-tradeoff",
      "response_id_last": "cmpl-bench-qwen36-27b-autoround-int4-b70-realistic-v1-06-architecture-tradeoff",
