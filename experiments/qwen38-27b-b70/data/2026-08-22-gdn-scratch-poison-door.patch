+    if (!poison.empty()) {
+      auto want = [&](const char* name) {
+        return poison == "all" || poison.find(name) != std::string::npos;
+      };
+      const double fnan = std::numeric_limits<double>::quiet_NaN();
+      if (want("indices")) {
+        accepted_state_indices.fill_(2139062143);
