+def _deterministic_xpu_qkvz_prefill(
+    hidden_states: torch.Tensor,
+    output_size: int,
+    layer_name: str,
+) -> torch.Tensor:
+    """Run the quantized qkvz projection in fixed 256-row blocks."""
+    forward_context = get_forward_context()
+    layer = forward_context.no_compile_layers[layer_name]
+    pieces = []
+    for start in range(
+        0, hidden_states.shape[0], _XPU_DETERMINISTIC_QKVZ_PAD_TOKENS
+    ):
+        count = min(
+            _XPU_DETERMINISTIC_QKVZ_PAD_TOKENS,
+            hidden_states.shape[0] - start,
+        )
+        block = hidden_states[start : start + count]
+        if count != _XPU_DETERMINISTIC_QKVZ_PAD_TOKENS:
+            padded = torch.zeros(
+                (_XPU_DETERMINISTIC_QKVZ_PAD_TOKENS, hidden_states.shape[-1]),
+                dtype=hidden_states.dtype,
+                device=hidden_states.device,
+            )
+            padded[:count].copy_(block)
+            block = padded
+        projected, _ = layer.in_proj_qkvz(block)
+        pieces.append(projected[:count])
+    result = torch.cat(pieces, dim=0) if len(pieces) > 1 else pieces[0]
+    if result.shape[-1] != output_size:
+        raise RuntimeError("fixed-shape qkvz projection returned wrong width")
+    return result
+
+
+def _deterministic_xpu_qkvz_prefill_fake(
+    hidden_states: torch.Tensor,
+    output_size: int,
+    layer_name: str,
+) -> torch.Tensor:
+    del layer_name
+    return hidden_states.new_empty((hidden_states.shape[0], output_size))
+
+
+direct_register_custom_op(
+    op_name="qwen_gdn_qkvz_prefill_xpu",
+    op_func=_deterministic_xpu_qkvz_prefill,
+    mutates_args=[],
+    fake_impl=_deterministic_xpu_qkvz_prefill_fake,
+)
+
