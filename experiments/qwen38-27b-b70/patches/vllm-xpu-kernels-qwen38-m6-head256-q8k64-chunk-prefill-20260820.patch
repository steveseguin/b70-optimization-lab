+namespace {
+
+constexpr char kM6Head256Selector[] =
+    "VLLM_XPU_FA2_M6_HEAD256_Q8K64_POLICY";
+constexpr char kM6Head256Marker[] =
+    "VLLM_XPU_FA2_M6_HEAD256_Q8K64_POLICY engaged";
