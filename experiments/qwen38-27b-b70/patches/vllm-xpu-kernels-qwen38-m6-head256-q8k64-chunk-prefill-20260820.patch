+#include "chunk_prefill.hpp"
+
+using namespace cute;
+
+void qwen38_m6_head256_q8k64_chunk_prefill(
+    sycl::queue& queue, const chunk_prefill_args_t& args) {
+  using M6Head256Policy = decode_policy_qpacked_head<_8, _256, _64>;
+  FMHAConfig<
+      typename M6Head256Policy::ShapeQK,
+      typename M6Head256Policy::ShapePV,
+      typename M6Head256Policy::ShapeOut,
+      typename M6Head256Policy::SubgroupLayoutQK,
+      void,
+      2,
+      true,
+      true,
+      false,
+      false,
+      false,
+      half_t,
+      half_t,
+      half_t,
+      half_t>::kernel_dispatch(queue, args);
+}
