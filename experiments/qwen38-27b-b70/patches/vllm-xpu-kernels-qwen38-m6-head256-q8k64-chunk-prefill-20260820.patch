+        kM6Head256Selector,
+        " must be exactly 0 or 1");
+    return true;
+  }();
+  return enabled;
+}
+
+void emit_m6_head256_q8k64_marker_once() {
+  static std::once_flag marker_once;
+  std::call_once(marker_once, [] { std::cerr << kM6Head256Marker << '\n'; });
+}
