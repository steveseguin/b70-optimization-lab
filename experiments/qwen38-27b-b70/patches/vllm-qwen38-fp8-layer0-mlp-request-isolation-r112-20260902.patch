+def _request_isolated_qwen_layer0_mlp_prefill_xpu(
+    hidden_states: torch.Tensor,
+    attention_prefix: str,
+) -> torch.Tensor:
+    """R112: run each packed prefill request through layer-0 MLP alone."""
+    context = get_forward_context()
+    attention = context.no_compile_layers.get(attention_prefix)
+    mlp = getattr(attention, "_r112_parent_mlp", None)
+    if mlp is None:
+        raise RuntimeError(
+            f"R112 layer-0 MLP is not attached: {attention_prefix}"
+        )
+    metadata_raw = context.attn_metadata
+    metadata = (
+        metadata_raw.get(attention_prefix)
+        if isinstance(metadata_raw, dict)
+        else None
+    )
+    pure_prefill = (
+        isinstance(metadata, GDNAttentionMetadata)
+        and metadata.num_prefills > 0
+        and metadata.num_decodes == 0
+        and metadata.num_spec_decodes == 0
+        and metadata.prefill_query_start_loc is not None
+    )
+    if not pure_prefill or metadata.num_prefills == 1:
+        logger.warning_once("R112 layer-0 MLP single-request control executed")
+        return mlp(hidden_states)
+
+    assert isinstance(metadata, GDNAttentionMetadata)
+    assert metadata.prefill_query_start_loc is not None
+    boundaries = (
+        metadata.prefill_query_start_loc[: metadata.num_prefills + 1]
+        .detach()
+        .cpu()
+        .tolist()
+    )
+    boundaries = [int(value) for value in boundaries]
+    if boundaries[0] != 0 or boundaries[-1] != hidden_states.shape[0]:
+        raise RuntimeError("R112 MLP boundaries do not cover input rows")
+    if any(stop <= start for start, stop in zip(boundaries, boundaries[1:])):
+        raise RuntimeError("R112 MLP isolation found an empty request")
+
+    logger.warning_once("R112 layer-0 MLP split-per-request treatment executed")
+    result = torch.cat(
+        [
+            mlp(hidden_states[start:stop])
+            for start, stop in zip(boundaries, boundaries[1:])
+        ],
+        dim=0,
+    )
+    if result.shape != hidden_states.shape:
+        raise RuntimeError("R112 layer-0 MLP returned the wrong shape")
+    return result
+
+
+def _request_isolated_qwen_layer0_mlp_prefill_xpu_fake(
+    hidden_states: torch.Tensor,
+    attention_prefix: str,
+) -> torch.Tensor:
+    del attention_prefix
+    return torch.empty_like(hidden_states)
+
+
+direct_register_custom_op(
+    op_name="qwen_layer0_mlp_prefill_isolated_xpu",
+    op_func=_request_isolated_qwen_layer0_mlp_prefill_xpu,
+    mutates_args=[],
+    fake_impl=_request_isolated_qwen_layer0_mlp_prefill_xpu_fake,
+)
+
