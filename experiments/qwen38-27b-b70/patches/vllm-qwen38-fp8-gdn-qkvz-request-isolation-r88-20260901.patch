+def _request_isolated_xpu_qkvz_prefill(
+    hidden_states: torch.Tensor,
+    output_size: int,
+    layer_name: str,
+) -> torch.Tensor:
+    """Project each request in a pure multi-request prefill independently."""
+    forward_context = get_forward_context()
+    layer = forward_context.no_compile_layers[layer_name]
+    attn_metadata_raw = forward_context.attn_metadata
+    attn_metadata = (
+        attn_metadata_raw.get(layer_name)
+        if isinstance(attn_metadata_raw, dict)
+        else None
+    )
+
+    isolate = (
+        isinstance(attn_metadata, GDNAttentionMetadata)
+        and attn_metadata.num_prefills > 1
+        and attn_metadata.num_decodes == 0
+        and attn_metadata.num_spec_decodes == 0
+        and attn_metadata.prefill_query_start_loc is not None
+    )
+    if not isolate:
+        projected, _ = layer.in_proj_qkvz(hidden_states)
+        return projected
+
+    assert isinstance(attn_metadata, GDNAttentionMetadata)
+    assert attn_metadata.prefill_query_start_loc is not None
+    boundaries = (
+        attn_metadata.prefill_query_start_loc[: attn_metadata.num_prefills + 1]
+        .detach()
+        .cpu()
+        .tolist()
+    )
+    boundaries = [int(value) for value in boundaries]
+    if boundaries[0] != 0 or boundaries[-1] != hidden_states.shape[0]:
+        raise RuntimeError(
+            "request-isolated qkvz boundaries do not cover hidden states"
+        )
+
+    pieces = []
+    for start, stop in zip(boundaries, boundaries[1:]):
+        if stop <= start:
+            raise RuntimeError("request-isolated qkvz found an empty request")
+        projected, _ = layer.in_proj_qkvz(hidden_states[start:stop])
+        pieces.append(projected)
+    result = torch.cat(pieces, dim=0)
+    if result.shape != (hidden_states.shape[0], output_size):
+        raise RuntimeError("request-isolated qkvz projection returned wrong shape")
+    return result
+
+
+def _request_isolated_xpu_qkvz_prefill_fake(
+    hidden_states: torch.Tensor,
+    output_size: int,
+    layer_name: str,
+) -> torch.Tensor:
+    del layer_name
+    return hidden_states.new_empty((hidden_states.shape[0], output_size))
+
+
+direct_register_custom_op(
+    op_name="qwen_gdn_qkvz_prefill_isolated_xpu",
+    op_func=_request_isolated_xpu_qkvz_prefill,
+    mutates_args=[],
+    fake_impl=_request_isolated_xpu_qkvz_prefill_fake,
+)
+
