+def _deterministic_xpu_quantized_prefill(
+    linear: nn.Module,
+    hidden_states: torch.Tensor,
+) -> torch.Tensor:
+    """Run a quantized projection at a stable, dispatcher-ordered M=512."""
+    num_tokens = hidden_states.shape[0]
+    padded = torch.zeros(
+        (_XPU_DETERMINISTIC_INT4_PAD_TOKENS, hidden_states.shape[-1]),
+        dtype=hidden_states.dtype,
+        device=hidden_states.device,
+    )
+    padded[:num_tokens].copy_(hidden_states)
+    projected, _ = linear(padded)
+    return projected[:num_tokens]
+
+
+def _use_deterministic_xpu_quantized_prefill(num_tokens: int) -> bool:
+    return (
+        os.environ.get("VLLM_XPU_QWEN_GDN_INT4_PREFILL_PAD512") == "1"
+        and _XPU_DETERMINISTIC_INT4_MIN_TOKENS <= num_tokens
+        < _XPU_DETERMINISTIC_INT4_PAD_TOKENS
+    )
+
+
