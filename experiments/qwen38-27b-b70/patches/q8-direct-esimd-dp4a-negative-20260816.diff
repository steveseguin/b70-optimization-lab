@@ -0,0 +1,142 @@
+#include "mmvq-esimd.hpp"
+
+#if defined(__INTEL_LLVM_COMPILER)
+
+#include "ggml-common.h"
+#include "ggml.h"
+
+#include <sycl/ext/intel/esimd.hpp>
+
+namespace q8_invoke_esimd_detail {
+namespace esimd = sycl::ext::intel::esimd;
+using esimd::simd;
+
+constexpr int VL = WARP_SIZE;
+constexpr int BLOCKS_PER_ITER = 8;
+
+// One call represents the incumbent SG16 work for eight consecutive Q8 blocks.
+// Vector lane L is exactly incumbent subgroup lane L: two lanes split each
+// block, four signed DP4As stay in the same order, and the caller retains the
+// existing per-lane FP accumulation and subgroup XOR reduction.
+simd<float, VL> q8_block_contribution(
+        const void * vx, const void * vy,
+        int ncols, int nrows, int row, int block_base,
+        bool poison) SYCL_ESIMD_FUNCTION {
+    const int blocks_per_row = ncols / QK8_0;
+    const int weight_block = row * blocks_per_row + block_base;
+    const auto * weight_base = static_cast<const uint8_t *>(vx);
+    const auto * weight_qs = reinterpret_cast<const int *>(
+        weight_base + (size_t) weight_block * QK8_0);
+    const auto * activation_qs = reinterpret_cast<const int *>(
+        static_cast<const int8_t *>(vy) + (size_t) block_base * QK8_1);
+
+    esimd::simd<int, 64> v = esimd::block_load<int, 64>(weight_qs);
+    esimd::simd<int, 64> u = esimd::block_load<int, 64>(activation_qs);
+    esimd::simd<int, VL> sumi = 0;
+    sumi = esimd::dp4a<int>(sumi, v.select<VL, 4>(0).read(), u.select<VL, 4>(0).read());
+    sumi = esimd::dp4a<int>(sumi, v.select<VL, 4>(1).read(), u.select<VL, 4>(1).read());
+    sumi = esimd::dp4a<int>(sumi, v.select<VL, 4>(2).read(), u.select<VL, 4>(2).read());
+    if (poison && block_base == 0) {
+        sumi = esimd::dp4a<int>(sumi, v.select<VL, 4>(2).read(), u.select<VL, 4>(3).read());
+    } else {
+        sumi = esimd::dp4a<int>(sumi, v.select<VL, 4>(3).read(), u.select<VL, 4>(3).read());
+    }
+
+    const auto * weight_d = reinterpret_cast<const sycl::half *>(
+        weight_base + (size_t) ncols * nrows) + weight_block;
+    const auto * activation_ds = reinterpret_cast<const sycl::half *>(
+        static_cast<const uint8_t *>(vy) + ncols) + (size_t) block_base * 2;
+    const esimd::simd<sycl::half, 8> d_half =
+        esimd::block_load<sycl::half, 8>(weight_d);
+    esimd::simd<sycl::half, 16> ds_half2 =
+        esimd::block_load<sycl::half, 16>(activation_ds);
+    const esimd::simd<float, 8> d8 = esimd::convert<float>(d_half);
+    const esimd::simd<float, 8> ds8 =
+        esimd::convert<float>(ds_half2.select<8, 2>(0).read());
+    esimd::simd<float, VL> d_lane;
+    esimd::simd<float, VL> ds_lane;
+    d_lane.select<8, 2>(0) = d8;
+    d_lane.select<8, 2>(1) = d8;
+    ds_lane.select<8, 2>(0) = ds8;
+    ds_lane.select<8, 2>(1) = ds8;
+    const esimd::simd<float, VL> scale = d_lane * ds_lane;
+    return scale * esimd::convert<float>(sumi);
+}
+float row_sum(
+        const void * vx, const void * vy,
+        int ncols, int nrows, int row, bool poison) SYCL_ESIMD_FUNCTION {
+    const int blocks_per_row = ncols / QK8_0;
+    simd<float, VL> partial_sum = 0.0f;
+    for (int block_base = 0; block_base < blocks_per_row;
+            block_base += q8_invoke_esimd_detail::BLOCKS_PER_ITER) {
+        partial_sum += q8_block_contribution(
+            vx, vy, ncols, nrows, row, block_base, poison);
+    }
+    // Mirror the subgroup tree reduction used by the accepted SG16 kernel.
+    partial_sum.select<8, 1>(0) += partial_sum.select<8, 1>(8);
+    partial_sum.select<4, 1>(0) += partial_sum.select<4, 1>(4);
+    partial_sum.select<2, 1>(0) += partial_sum.select<2, 1>(2);
+    partial_sum[0] += partial_sum[1];
+    return partial_sum[0];
+}
+} // namespace q8_invoke_esimd_detail
+
+void ggml_sycl_q8_invoke_esimd_launch(
+        const void * vx, const void * vy, float * dst,
+        int ncols, int nrows, size_t num_subgroups,
+        bool poison, dpct::queue_ptr stream) {
+    (void) num_subgroups;
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(sycl::range<1>((size_t) nrows), [=](sycl::id<1> item) SYCL_ESIMD_KERNEL {
+                const int row = (int) item[0];
+                dst[row] = q8_invoke_esimd_detail::row_sum(
+                    vx, vy, ncols, nrows, row, poison);
+            });
+    });
+}
+
+void ggml_sycl_q8_invoke_esimd_pair_launch(
+        const void * vx0, const void * vx1, const void * vy,
+        float * dst0, float * dst1,
+        int ncols, int nrows0, int nrows1, size_t num_subgroups,
+        bool poison, dpct::queue_ptr stream) {
+    const int nrows = nrows0 + nrows1;
+    (void) num_subgroups;
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(sycl::range<1>((size_t) nrows), [=](sycl::id<1> item) SYCL_ESIMD_KERNEL {
+                const int combined_row = (int) item[0];
+                const bool matrix1 = combined_row >= nrows0;
+                const int row = matrix1 ? combined_row - nrows0 : combined_row;
+                const int matrix_nrows = matrix1 ? nrows1 : nrows0;
+                const void * vx = matrix1 ? vx1 : vx0;
+                float * dst = matrix1 ? dst1 : dst0;
+                dst[row] = q8_invoke_esimd_detail::row_sum(
+                    vx, vy, ncols, matrix_nrows, row, poison);
+            });
+    });
+}
+
+void ggml_sycl_q8_invoke_esimd_triple_launch(
+        const void * vx0, const void * vx1, const void * vx2, const void * vy,
+        float * dst0, float * dst1, float * dst2,
+        int ncols, int nrows0, int nrows1, int nrows2, size_t num_subgroups,
+        bool poison, dpct::queue_ptr stream) {
+    const int nrows = nrows0 + nrows1 + nrows2;
+    (void) num_subgroups;
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(sycl::range<1>((size_t) nrows), [=](sycl::id<1> item) SYCL_ESIMD_KERNEL {
+                const int combined_row = (int) item[0];
+                const bool matrix2 = combined_row >= nrows0 + nrows1;
+                const bool matrix1 = !matrix2 && combined_row >= nrows0;
+                const int row = matrix2 ? combined_row - nrows0 - nrows1 :
+                    matrix1 ? combined_row - nrows0 : combined_row;
+                const int matrix_nrows = matrix2 ? nrows2 : matrix1 ? nrows1 : nrows0;
+                const void * vx = matrix2 ? vx2 : matrix1 ? vx1 : vx0;
+                float * dst = matrix2 ? dst2 : matrix1 ? dst1 : dst0;
+                dst[row] = q8_invoke_esimd_detail::row_sum(
+                    vx, vy, ncols, matrix_nrows, row, poison);
+            });
+    });
+}
+
+#endif
