+struct q8_reorder_operands {
+    sycl::vec<int, 4> v;
+    sycl::vec<int, 4> u;
+    ggml_half         d;
+    sycl::half2       ds;
+};
+
+static __dpct_inline__ q8_reorder_operands q8_reorder_load_operands(
+        const void * __restrict__ vx, const void * __restrict__ vy,
+        int ncols, int nrows, int row, int block, int iqs) {
+    using block_type = ggml_sycl_reordered::block_q_t<GGML_TYPE_Q8_0>;
+    using int4_t     = sycl::vec<int, 4>;
+
+    const int  blocks_per_row = ncols / QK8_0;
+    const int  nblocks        = nrows * blocks_per_row;
+    const int  ibx            = row * blocks_per_row + block;
+    const auto bx_offset      = block_type::get_block_offset(ibx, nblocks);
+    const auto d_offset       = block_type::get_d_offset(nrows, ncols, ibx);
+    const int  iby            = block * block_type::block_to_q8_1_ratio();
+    const auto base           = static_cast<const uint8_t *>(vx);
+    const auto qs             = reinterpret_cast<const int8_t *>(base + bx_offset.first);
+    const auto q8_1_quant     = static_cast<const int8_t *>(vy) + iby * QK8_1;
+    const auto q8_1_ds        = reinterpret_cast<const sycl::half2 *>(
+        static_cast<const char *>(vy) + ncols + iby * sizeof(sycl::half2));
+
+    return {
+        *reinterpret_cast<const int4_t *>(qs + iqs * sizeof(int)),
+        *reinterpret_cast<const int4_t *>(q8_1_quant + iqs * sizeof(int)),
+        *reinterpret_cast<const ggml_half *>(base + d_offset.first),
+        *q8_1_ds,
+    };
+}
+
+static __dpct_inline__ float q8_reorder_dot_operands(const q8_reorder_operands & operands) {
+    int sumi = 0;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        sumi = dpct::dp4a(operands.v[i], operands.u[i], sumi);
+    }
+    return static_cast<float>(operands.d) * static_cast<float>(operands.ds[0]) * sumi;
+}
