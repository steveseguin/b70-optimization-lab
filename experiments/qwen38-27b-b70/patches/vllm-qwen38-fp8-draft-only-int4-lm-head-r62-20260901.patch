+        if not hasattr(torch.ops._xpu_C, "int4_gemm_w4a16"):
+            raise RuntimeError("_xpu_C.int4_gemm_w4a16 is unavailable")
+
+        group_size = int(
+            os.environ.get("VLLM_XPU_DRAFT_LM_HEAD_INT4_GROUP_SIZE", "128") or "128"
+        )
+        chunk_rows = int(
