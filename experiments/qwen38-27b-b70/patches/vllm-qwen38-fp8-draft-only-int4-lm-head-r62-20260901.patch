+        elif scale_name in {"bf16", "bfloat16"}:
+            scale_dtype = torch.bfloat16
+        else:
+            raise ValueError(
+                "VLLM_XPU_DRAFT_LM_HEAD_INT4_SCALE_DTYPE must be bf16, fp16, "
+                f"or fp32, got {scale_name!r}"
+            )
