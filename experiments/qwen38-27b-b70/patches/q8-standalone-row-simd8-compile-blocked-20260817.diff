+// Lab-only SIMD8 row body for standalone Q8_0 decode MMVQs. Each lane owns a
+// complete 32-value Q8 block (two int4 loads) instead of half a block, removing
+// duplicate scale loads and admitting sixteen row subgroups per 128-thread WG.
+static inline bool ggml_sycl_mmvq_q8_row_sg8() {
+    static const bool on = [] {
+        const char * value = std::getenv("GGML_SYCL_MMVQ_Q8_ROW_SG8");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    return on;
+}
