+def _xpu_lm_head_chunk_rows() -> int:
+    """R149: rows per lm_head GEMM call, 0 disables chunking.
+
+    The XPU FP16 lm_head F.linear is row-invariant only inside its M<=32
+    class; computing the head in <=32-row chunks reproduces the single-row
+    arithmetic bit for bit at every batch size (operator probe 2026-09-02).
+    """
+    value = os.environ.get("VLLM_XPU_LM_HEAD_CHUNK_ROWS", "0")
+    try:
+        rows = int(value)
+    except ValueError as exc:
+        raise ValueError(
+            f"VLLM_XPU_LM_HEAD_CHUNK_ROWS must be an integer, got {value!r}"
+        ) from exc
+    return rows if rows > 0 else 0
 
 
