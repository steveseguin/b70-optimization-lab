+def _w8a16_pad_n_set() -> frozenset[int]:
+    """R118b: restrict padding to explicitly configured output widths N.
+
+    Empty (default) pads every W8A16 call below the bucket (R118 behaviour,
+    measured about -10% in situ). ``7168`` selects only the per-rank attention
+    qkv projection, the one shape whose small-M oneDNN kernel the CR1 census
+    measured at about 2.7x the M=32 kernel's latency.
+    """
+    raw = os.environ.get("VLLM_XPU_W8A16_PAD_N_SET", "").strip()
+    if not raw:
+        return frozenset()
+    try:
+        return frozenset(int(v) for v in raw.split(",") if v.strip())
+    except ValueError as exc:
+        raise RuntimeError("VLLM_XPU_W8A16_PAD_N_SET must be comma-separated ints") from exc
+
+
+_W8A16_PAD_N_SET = _w8a16_pad_n_set()
+_W8A16_PAD_BUFFERS: dict[tuple[torch.device, int, int, torch.dtype], torch.Tensor] = {}
+
