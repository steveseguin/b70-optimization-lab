+def _xpu_gdn_prefill_boundaries(layer_name: str, row_count: int) -> list[int] | None:
+    """Return natural request boundaries for a pure multi-prefill batch."""
+    forward_context = get_forward_context()
+    attn_metadata_raw = forward_context.attn_metadata
+    attn_metadata = (
+        attn_metadata_raw.get(layer_name)
+        if isinstance(attn_metadata_raw, dict)
+        else None
+    )
+    isolate = (
+        isinstance(attn_metadata, GDNAttentionMetadata)
+        and attn_metadata.num_prefills > 1
+        and attn_metadata.num_decodes == 0
+        and attn_metadata.num_spec_decodes == 0
+        and attn_metadata.prefill_query_start_loc is not None
+    )
+    if not isolate:
+        return None
+    assert isinstance(attn_metadata, GDNAttentionMetadata)
+    assert attn_metadata.prefill_query_start_loc is not None
+    boundaries = (
+        attn_metadata.prefill_query_start_loc[: attn_metadata.num_prefills + 1]
+        .detach()
+        .cpu()
+        .tolist()
+    )
+    boundaries = [int(value) for value in boundaries]
+    if boundaries[0] != 0 or boundaries[-1] != row_count:
+        raise RuntimeError("request-isolated GDN output boundaries do not cover rows")
+    if any(stop <= start for start, stop in zip(boundaries, boundaries[1:])):
+        raise RuntimeError("request-isolated GDN output found an empty request")
+    return boundaries
+
+
+def _request_isolated_xpu_gdn_norm_prefill(
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+    layer_name: str,
+) -> torch.Tensor:
+    """R92a diagnostic: isolate RMSNormGated but keep out_proj packed."""
+    layer = get_forward_context().no_compile_layers[layer_name]
+
+    def normalize(request_core: torch.Tensor, request_z: torch.Tensor) -> torch.Tensor:
+        shape = request_core.shape
+        result = layer.norm(
+            request_core.reshape(-1, request_core.shape[-1]),
+            request_z.reshape(-1, request_z.shape[-1]),
+        )
+        return result.reshape(shape)
+
+    boundaries = _xpu_gdn_prefill_boundaries(layer_name, core_attn_out.shape[0])
+    if boundaries is None:
+        return normalize(core_attn_out, z)
+    return torch.cat(
+        [
+            normalize(core_attn_out[start:stop], z[start:stop])
+            for start, stop in zip(boundaries, boundaries[1:])
+        ],
+        dim=0,
+    )
+
+
+def _request_isolated_xpu_gdn_norm_prefill_fake(
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+    layer_name: str,
+) -> torch.Tensor:
+    del z, layer_name
+    return torch.empty_like(core_attn_out)
+
+
+direct_register_custom_op(
+    op_name="qwen_gdn_norm_prefill_isolated_xpu",
+    op_func=_request_isolated_xpu_gdn_norm_prefill,
+    mutates_args=[],
+    fake_impl=_request_isolated_xpu_gdn_norm_prefill_fake,
+)
+
+
+def _request_isolated_xpu_gdn_projection_prefill(
+    normalized: torch.Tensor,
+    output_size: int,
+    layer_name: str,
+) -> torch.Tensor:
+    """R92b diagnostic: keep RMSNormGated packed but isolate out_proj."""
+    layer = get_forward_context().no_compile_layers[layer_name]
+
+    def project(request_rows: torch.Tensor) -> torch.Tensor:
+        output, _ = layer.out_proj(request_rows)
+        return output
+
+    boundaries = _xpu_gdn_prefill_boundaries(layer_name, normalized.shape[0])
+    if boundaries is None:
+        return project(normalized)
+    result = torch.cat(
+        [
+            project(normalized[start:stop])
+            for start, stop in zip(boundaries, boundaries[1:])
+        ],
+        dim=0,
+    )
+    if result.shape != (normalized.shape[0], output_size):
+        raise RuntimeError("request-isolated GDN projection returned wrong shape")
+    return result
+
+
+def _request_isolated_xpu_gdn_projection_prefill_fake(
+    normalized: torch.Tensor,
+    output_size: int,
+    layer_name: str,
+) -> torch.Tensor:
+    del layer_name
+    return normalized.new_empty((normalized.shape[0], output_size))
+
+
+direct_register_custom_op(
+    op_name="qwen_gdn_projection_prefill_isolated_xpu",
+    op_func=_request_isolated_xpu_gdn_projection_prefill,
+    mutates_args=[],
+    fake_impl=_request_isolated_xpu_gdn_projection_prefill_fake,
+)
+
