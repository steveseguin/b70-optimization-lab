+# A key of the `near` table: `receiver\x00source` for each sentence of the turns that says one thing took another's
+# value ("guke20 received exactly what gupe37 stood at then"). Read by took_value_ok's caller in apply_delta.
+TAKEN = "\x00took the value of"
+SOURCE = re.compile(r"\b(?:as much as|what)\s+([a-z0-9_]+)\s+(?:held|holds|stood|stands)\b", re.I)
+
+
+def taken_from(sents: list[str], i: int, want: set[str]) -> set[str]:
+    """`receiver\x00source` for each thing sentence `i` says took the value another thing held. The receiver is
+    another name of the same sentence, or, when the sentence calls it "It", a name of the sentence before."""
+    out: set[str] = set()
+    for m in SOURCE.finditer(sents[i]):
+        src = m.group(1).lower()
+        if src not in want:
+            continue
+        here = want & set(re.findall(r"[a-z0-9_]+", sents[i].lower())) - {src}
+        if not here and i:
+            here = want & set(re.findall(r"[a-z0-9_]+", sents[i - 1].lower())) - {src}
+        out.update(f"{r}\x00{src}" for r in here)
+    return out
+
