+// Lab-only launch geometry for the exact 5,120-element register-direct
+// collective tails. Zero/unset preserves the device maximum (1,024 on B70).
+static int ggml_sycl_comm_direct_q8_work_group_size() {
+    static const int value = [] {
+        const char * env = std::getenv("GGML_SYCL_COMM_DIRECT_Q8_WG");
+        const int requested = env == nullptr ? 0 : std::atoi(env);
+        const int selected = requested == 256 || requested == 512 || requested == 768 || requested == 1024
+            ? requested : 0;
+        fprintf(stderr, "SYCL lab door | register-direct collective tail WG: %d "
+                        "(GGML_SYCL_COMM_DIRECT_Q8_WG; 0=device max)\n", selected);
+        return selected;
+    }();
+    return value;
+}
