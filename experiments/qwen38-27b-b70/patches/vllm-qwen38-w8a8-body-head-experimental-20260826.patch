+    def _maybe_prepare_xpu_int8_lm_head(self, layer: torch.nn.Module) -> None:
+        """Prepare a default-off W8A8 copy of an XPU output head.
+
+        The checkpoint weight remains resident and unchanged, so disabling the
+        environment door restores the ordinary BF16 path. This experiment is
+        restricted to ParallelLMHead and must pass the model quality gate before
+        use outside a benchmark candidate.
+        """
+        if not self._env_enabled("VLLM_XPU_LM_HEAD_INT8"):
+            return
+        if layer.__class__.__name__ != "ParallelLMHead":
+            return
+        weight = getattr(layer, "weight", None)
+        if weight is None or weight.device.type != "xpu":
+            return
+        if weight.dtype not in (torch.float16, torch.bfloat16):
+            logger.warning_once(
+                "XPU INT8 lm_head requires BF16/FP16 weights; got %s.",
+                weight.dtype,
+            )
+            return
+        try:
+            import vllm_xpu_kernels
+
+            torch.ops.load_library(
+                os.path.join(
+                    os.path.dirname(vllm_xpu_kernels.__file__),
+                    "_xpu_lm_head_C.abi3.so",
+                )
+            )
+        except Exception as exc:
+            logger.warning_once("Could not load XPU INT8 lm_head ops: %r", exc)
+            return
+        required_ops = ("int8_gemm_w8a8", "per_token_quant_int8_xpu")
+        if any(not hasattr(torch.ops._xpu_lm_head_C, op) for op in required_ops):
+            logger.warning_once("Required XPU INT8 lm_head ops are unavailable.")
+            return
+
+        with torch.no_grad():
+            weight_f = weight.detach().float()
+            scales = weight_f.abs().amax(dim=1).clamp_min(1.0e-10) / 127.0
+            weight_q_t = (
+                torch.round(weight_f / scales.view(-1, 1))
+                .clamp(-127, 127)
+                .to(torch.int8)
+                .t()
+                .contiguous()
+            )
+            scale_dtype = os.environ.get(
+                "VLLM_XPU_LM_HEAD_INT8_SCALE_DTYPE", "bf16"
+            ).strip().lower()
+            if scale_dtype in ("bf16", "bfloat16"):
+                scales = scales.to(torch.bfloat16)
