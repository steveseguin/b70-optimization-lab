--- a/ggml/src/ggml-sycl/common.cpp
+++ b/ggml/src/ggml-sycl/common.cpp
@@ -102,0 +103,7 @@
+        // Lab-only, same-binary policy for GiB-scale model-rank buffers.
+        // bit 0 requests the Level Zero cached bias; bit 1 requests 2 MiB
+        // alignment.  Small writable allocations retain the exact incumbent.
+        const int large_policy = size >= (size_t) 1024*1024*1024
+            ? ggml_sycl_get_env("GGML_SYCL_L0_LARGE_ALLOC_POLICY", 0) : 0;
+        const uint32_t alloc_flags = (large_policy & 1) ? ZE_DEVICE_MEM_ALLOC_FLAG_BIAS_CACHED : 0;
+        const size_t alloc_alignment = (large_policy & 2) ? (size_t) 2*1024*1024 : 64;
@@ -112 +119 @@
-            0,
+            alloc_flags,
@@ -116 +123,2 @@
-        ze_device_mem_alloc_desc_t alloc_desc = {ZE_STRUCTURE_TYPE_DEVICE_MEM_ALLOC_DESC, nullptr, 0, 0};
+        ze_device_mem_alloc_desc_t alloc_desc = {
+            ZE_STRUCTURE_TYPE_DEVICE_MEM_ALLOC_DESC, nullptr, alloc_flags, 0};
@@ -118 +126 @@
-        ze_result_t r = zeMemAllocDevice(ze_ctx, &alloc_desc, size, 64, ze_dev, &ptr);
+        ze_result_t r = zeMemAllocDevice(ze_ctx, &alloc_desc, size, alloc_alignment, ze_dev, &ptr);
@@ -119,0 +128,10 @@
+            if (large_policy != 0) {
+                static bool announced[GGML_SYCL_MAX_DEVICES] = {};
+                const int device = get_current_device_id();
+                if (device >= 0 && device < GGML_SYCL_MAX_DEVICES && !announced[device]) {
+                    fprintf(stderr,
+                            "SYCL lab door | Level Zero large allocation policy: dev=%d cached=%d align_2m=%d\n",
+                            device, !!(large_policy & 1), !!(large_policy & 2));
+                    announced[device] = true;
+                }
+            }
