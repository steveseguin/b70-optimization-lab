+#include "chunk_prefill.hpp"
+
+using namespace cute;
+
+namespace {
+
+struct Qwen38M6Head256Q64K32Policy {
+  using ShapeQK = Shape<_64, _32, _32>;
+  using ShapePV = Shape<_64, _32, _32>;
+  using ShapeOut = Shape<_64, _256>;
+  using SubgroupLayoutQK = Layout<Shape<_8, _1, _1>>;
+};
+
+}  // namespace
+
+void qwen38_m6_head256_q64k32_chunk_prefill(
+    sycl::queue& queue, const chunk_prefill_args_t& args) {
+  FMHAConfig<
+      typename Qwen38M6Head256Q64K32Policy::ShapeQK,
+      typename Qwen38M6Head256Q64K32Policy::ShapePV,
+      typename Qwen38M6Head256Q64K32Policy::ShapeOut,
+      typename Qwen38M6Head256Q64K32Policy::SubgroupLayoutQK,
+      void,
+      2,
+      true,
+      true,
+      false,
+      false,
+      false,
+      half_t,
+      half_t,
+      half_t,
+      half_t>::kernel_dispatch(queue, args);
+}
