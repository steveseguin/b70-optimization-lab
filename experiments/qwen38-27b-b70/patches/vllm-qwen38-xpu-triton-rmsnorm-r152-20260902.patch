 from vllm.logger import init_logger
 from vllm.model_executor.custom_op import CustomOp
 from vllm.model_executor.layers.batch_invariant import rms_norm_batch_invariant
+from vllm.utils.torch_utils import direct_register_custom_op
+
+
+def _xpu_triton_rmsnorm_enabled(flag: str) -> bool:
+    """R152: route a norm through the Triton row kernel (batch- and
+    position-invariant on XPU; the ir kernel's arithmetic depends on a row's
+    slot inside its processing group, which flips near-tie tokens once a
+    step carries roughly 16 or more rows). Default off."""
+    return os.environ.get(flag, "0") == "1"
+
+
+def _xpu_triton_rmsnorm_impl(
+    x: torch.Tensor, weight: torch.Tensor, eps: float
+) -> torch.Tensor:
+    from vllm.third_party.flash_linear_attention.ops.layernorm_guard import (
+        rmsnorm_fn,
+    )
+
+    shape = x.shape
+    out = rmsnorm_fn(
+        x.reshape(-1, shape[-1]), weight, None, z=None, eps=eps
+    )
+    return out.reshape(shape)
+
+
+def _xpu_triton_rmsnorm_fake(
+    x: torch.Tensor, weight: torch.Tensor, eps: float
+) -> torch.Tensor:
+    return torch.empty_like(x)
+
+
+direct_register_custom_op(
+    op_name="xpu_triton_rmsnorm",
+    op_func=_xpu_triton_rmsnorm_impl,
+    mutates_args=[],
+    fake_impl=_xpu_triton_rmsnorm_fake,
+)
+
+
+def _xpu_triton_rmsnorm(
+    x: torch.Tensor, weight: torch.Tensor, eps: float
+) -> torch.Tensor:
+    return torch.ops.vllm.xpu_triton_rmsnorm(x, weight, eps)
 
