 KVCache = tuple[torch.Tensor, torch.Tensor]

+_DECODER_BOUNDARY_TRACE_INVOCATION: dict[tuple[int, str, int], int] = {}
+_DECODER_BOUNDARY_TRACE_LOCK = threading.Lock()
+
+
+def _trace_qwen_decoder_boundary_xpu(
+    tensor: torch.Tensor,
+    layer_name: str,
+    layer_index: int,
+    stage: str,
+) -> None:
+    """R110: hash request rows without changing the observed tensor."""
+    trace_file = os.getenv("VLLM_XPU_DECODER_BOUNDARY_TRACE_FILE", "")
+    if not trace_file:
+        raise RuntimeError("R110 decoder-boundary trace requires a trace file")
+    context = get_forward_context()
+    metadata_raw = context.attn_metadata
+    metadata = (
+        metadata_raw.get(layer_name) if isinstance(metadata_raw, dict) else None
+    )
+    pure_prefill = (
+        isinstance(metadata, GDNAttentionMetadata)
+        and metadata.num_prefills > 0
+        and metadata.num_decodes == 0
+        and metadata.num_spec_decodes == 0
+        and metadata.prefill_query_start_loc is not None
+    )
+    if not pure_prefill:
+        return
+
+    assert isinstance(metadata, GDNAttentionMetadata)
+    assert metadata.prefill_query_start_loc is not None
+    boundaries = (
+        metadata.prefill_query_start_loc[: metadata.num_prefills + 1]
+        .detach()
+        .cpu()
+        .tolist()
+    )
+    boundaries = [int(value) for value in boundaries]
+    if boundaries[0] != 0 or boundaries[-1] != tensor.shape[0]:
+        raise RuntimeError("R110 decoder boundaries do not cover tensor rows")
+
+    key = (layer_index, stage, metadata.num_prefills)
+    with _DECODER_BOUNDARY_TRACE_LOCK:
+        invocation = _DECODER_BOUNDARY_TRACE_INVOCATION.get(key, 0) + 1
+        _DECODER_BOUNDARY_TRACE_INVOCATION[key] = invocation
+    requests = []
+    for request, (start, stop) in enumerate(zip(boundaries, boundaries[1:])):
+        rows = tensor[start:stop].detach().contiguous()
+        raw = rows.view(torch.uint8).cpu().numpy().tobytes()
+        requests.append(
+            {
+                "request": request,
+                "row_count": stop - start,
+                "sha256": hashlib.sha256(raw).hexdigest(),
+            }
+        )
+
+    rank = int(os.getenv("RANK", "-1"))
+    if torch.distributed.is_available() and torch.distributed.is_initialized():
+        rank = torch.distributed.get_rank()
+    record = {
+        "schema": "neural.download.qwen38-decoder-boundary-trace.v1",
+        "pid": os.getpid(),
+        "rank": rank,
+        "layer": layer_index,
+        "stage": stage,
+        "invocation": invocation,
+        "num_prefills": metadata.num_prefills,
+        "query_start_loc": boundaries,
+        "requests": requests,
+    }
+    encoded = (
+        json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n"
+    ).encode()
+    fd = os.open(trace_file, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
+    try:
+        written = os.write(fd, encoded)
+        if written != len(encoded):
+            raise RuntimeError("R110 decoder trace record was partially written")
+    finally:
+        os.close(fd)
+
+
+def _trace_qwen_decoder_boundary_xpu_fake(
+    tensor: torch.Tensor,
+    layer_name: str,
+    layer_index: int,
+    stage: str,
+) -> None:
+    return
+
+
+direct_register_custom_op(
+    op_name="qwen_decoder_boundary_trace_xpu",
+    op_func=_trace_qwen_decoder_boundary_xpu,
+    mutates_args=["tensor"],
+    fake_impl=_trace_qwen_decoder_boundary_xpu_fake,
+)
