+static inline const std::array<uint16_t, 0x2205> & encode_table() {
+    static const auto table = [] {
+        std::array<uint16_t, 0x2205> result{};
+        result.fill(0xffff);
+        for (uint16_t i = 0; i < e0_count; ++i) {
+            result[e0_table[i]] = i;
+        }
+        for (uint16_t exponent = 1; exponent <= 8; ++exponent) {
+            for (uint16_t i = 0; i < mantissa_count; ++i) {
+                result[(exponent << 10) | mantissa_table[i]] = e0_count + (exponent - 1) * mantissa_count + i;
+            }
+        }
+        return result;
+    }();
+    return table;
+}
+
+static inline sycl::half decode(const uint8_t * scale_plane, int block_index) {
+    const uint16_t * e0 = reinterpret_cast<const uint16_t *>(scale_plane);
+    const uint16_t * mantissas = e0 + e0_count;
+    const uint8_t * packed = reinterpret_cast<const uint8_t *>(mantissas + mantissa_count);
+    const int bit = block_index * code_bits;
+    const int byte = bit >> 3;
+    const int shift = bit & 7;
+    const uint32_t word = (uint32_t) packed[byte] | ((uint32_t) packed[byte + 1] << 8) | ((uint32_t) packed[byte + 2] << 16);
+    const uint16_t code = (word >> shift) & 0x7ff;
+    uint16_t bits;
+    if (code < e0_count) {
+        bits = e0[code];
+    } else {
+        const uint16_t normal = code - e0_count;
+        bits = (uint16_t) (((normal >> 7) + 1) << 10) | mantissas[normal & 127];
+    }
+    return sycl::bit_cast<sycl::half>(bits);
+}
+
+static inline sycl::half decode(const uint8_t * base, std::pair<int, int> block_offset, std::pair<int, int> scale_offset) {
+    const int block = block_offset.first / qk;
+    const uint8_t * scale_plane = base + scale_offset.first - block * (int) sizeof(sycl::half);
+    return decode(scale_plane, block);
+}
