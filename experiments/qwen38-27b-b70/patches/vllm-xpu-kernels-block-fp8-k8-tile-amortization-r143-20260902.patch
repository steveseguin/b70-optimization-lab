+    CUTLASS_PRAGMA_UNROLL
+    for (int i = 0; i < 16; ++i) {
+      int base = ((mn_sg * 16 + lane) * 16 + i) * 8;
+      partials[base + sg_k] = tCrC(frag_base + i);
+    }
+
+    barrier_arrive(
+        ScopeWorkgroup, SemanticsRelease | SemanticsWGMemory);
+    barrier_wait(
+        ScopeWorkgroup, SemanticsAcquire | SemanticsWGMemory);
+
+    if (sg_k == 0) {
+      CUTLASS_PRAGMA_UNROLL
+      for (int i = 0; i < 16; ++i) {
+        int base = ((mn_sg * 16 + lane) * 16 + i) * 8;
+#if R142_REDUCTION_ORDER == 0
+        float sum = partials[base];
+        sum += partials[base + 1];
+        sum += partials[base + 2];
+        sum += partials[base + 3];
+        sum += partials[base + 4];
+        sum += partials[base + 5];
+        sum += partials[base + 6];
+        sum += partials[base + 7];
+#elif R142_REDUCTION_ORDER == 1
+        float sum =
+            ((partials[base] + partials[base + 1]) +
+             (partials[base + 2] + partials[base + 3])) +
+            ((partials[base + 4] + partials[base + 5]) +
+             (partials[base + 6] + partials[base + 7]));
+#elif R142_REDUCTION_ORDER == 2
+        float sum =
+            ((partials[base] + partials[base + 4]) +
+             (partials[base + 1] + partials[base + 5])) +
+            ((partials[base + 2] + partials[base + 6]) +
+             (partials[base + 3] + partials[base + 7]));
+#else
+#error "R142_REDUCTION_ORDER must be 0, 1, or 2"
+#endif
+        tCrC(frag_base + i) = sum;
+      }
+    }
+
+    barrier_arrive(
+        ScopeWorkgroup, SemanticsRelease | SemanticsWGMemory);
+    barrier_wait(
+        ScopeWorkgroup, SemanticsAcquire | SemanticsWGMemory);
+  }
+
+  if (sg_k != 0) return;
+
+  reorder(tCrC, tCrC_out);
+  copy(copy_c, tCrC_out, tCgC);
