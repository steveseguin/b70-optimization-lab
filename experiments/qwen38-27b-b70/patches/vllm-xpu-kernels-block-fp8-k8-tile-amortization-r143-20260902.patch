+// R142 diagnostic kernel. This is deliberately specialized to the production
+// FP16 x E4M3 block-FP8 contract. Its K layout mirrors oneDNN's `ikr ki64`:
+// subgroup k starts at k * 64 and advances by 512, then subgroup zero reduces
+// the eight FP32 fragments through workgroup-local memory.
+template <
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyC,
+    class ATensor,
+    class BTensor,
+    class DTensor,
+    class TiledMMA>
+CUTE_DEVICE void xe_gemm_block_fp8_k8_split(
+    ATensor const& A,  // (M,K)
+    BTensor const& B,  // (N,K)
+    const float* Scales,
+    DTensor& C,  // (M,N)
+    Coord<int, int, cute::Underscore, int> blk_coord,
+    TiledMMA const& mma,
+    const sycl::local_accessor<float, 1>& partials) {
+  using TA = typename ATensor::element_type;
+  using TB = typename BTensor::element_type;
+  static_assert(is_same_v<TA, half_t>);
+  static_assert(is_same_v<TB, float_e4m3_t>);
