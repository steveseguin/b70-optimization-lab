+      CUTLASS_PRAGMA_UNROLL
+      for (int c = 0; c < channel_num; ++c) {
+        CUTLASS_PRAGMA_UNROLL
+        for (int i = 0; i < tCrB.size() / thr_N / channel_num; ++i) {
+          tCrB(cute::tuple(c, _), n, _)[i] *=
+              scales[n * channel_num + c];
+        }
+      }
+    }
