+    cute::gemm(mma, tCrA, tCrB, tCrC);
+    barrier_wait(barrier_scope);
+  }
+
+  // R143 reuses one 32-KiB SLM slice as output tiles grow. Corresponding
+  // lane fragments from k=0..7 remain adjacent, and the second barrier keeps
