diff --git a/csrc/xpu/lm_head_int8_bindings.cpp b/csrc/xpu/lm_head_int8_bindings.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d1b93bccc81aa85572c57b264e622868aba68820
--- /dev/null
+++ b/csrc/xpu/lm_head_int8_bindings.cpp
@@ -0,0 +1,123 @@
+#include "core/registration.h"
+#include "xpu/ops.h"
+
+#include <ATen/core/dispatch/Dispatcher.h>
+#include <torch/library.h>
+
+namespace {
+
+using fp8_gemm_signature = torch::Tensor(
+    const torch::Tensor&,
+    const torch::Tensor&,
+    std::optional<c10::ScalarType>,
+    const std::optional<torch::Tensor>&,
+    const std::optional<torch::Tensor>&,
+    const std::optional<torch::Tensor>&);
+
+using fp8_quant_signature = void(
+    const torch::Tensor&,
+    torch::Tensor&,
+    torch::Tensor&,
+    int64_t,
+    double,
+    double,
+    double,
+    bool,
+    bool,
+    bool);
+
+torch::Tensor hybrid_fp8_int8_linear(
+    const torch::Tensor& x,
+    const torch::Tensor& fp8_weight,
+    const torch::Tensor& fp8_weight_scale,
+    const torch::Tensor& int8_weight,
+    const torch::Tensor& int8_weight_scale,
+    int64_t min_tokens) {
+  const auto flat_x = x.reshape({-1, x.size(-1)});
+  if (flat_x.size(0) >= min_tokens) {
+    auto [x_q, x_scale] = per_token_quant_int8_xpu(flat_x);
+    return int8_gemm_w8a8(
+        x_q,
+        x_scale,
+        int8_weight,
+        int8_weight_scale,
+        x.scalar_type(),
+        std::nullopt);
+  }
+
+  static auto fp8_gemm = c10::Dispatcher::singleton()
+                              .findSchemaOrThrow("_xpu_C::fp8_gemm", "")
+                              .typed<fp8_gemm_signature>();
+  static auto fp8_quant = c10::Dispatcher::singleton()
+                               .findSchemaOrThrow(
+                                   "_C::per_token_group_fp8_quant", "")
+                               .typed<fp8_quant_signature>();
+  constexpr int64_t group_size = 128;
+  auto fp8_input = torch::empty_like(
+      flat_x, flat_x.options().dtype(torch::kFloat8_e4m3fn));
+  auto fp8_input_scale = torch::empty(
+      {flat_x.size(0), flat_x.size(1) / group_size},
+      flat_x.options().dtype(torch::kFloat32));
+  fp8_quant.call(
+      flat_x,
+      fp8_input,
+      fp8_input_scale,
+      group_size,
+      1.0e-10,
+      -448.0,
+      448.0,
+      false,
+      false,
+      false);
+  return fp8_gemm.call(
+      fp8_input,
+      fp8_weight.t(),
+      x.scalar_type(),
+      fp8_input_scale,
+      fp8_weight_scale.t(),
+      std::nullopt);
+}
+
+}  // namespace
+
+TORCH_LIBRARY_EXPAND(TORCH_EXTENSION_NAME, ops) {
+  ops.def(
+      "int8_gemm_w8a8(Tensor A, Tensor A_scale, Tensor B, Tensor B_scale, "
+      "ScalarType? out_dtype, Tensor? bias) -> Tensor");
+  ops.impl("int8_gemm_w8a8", torch::kXPU, &int8_gemm_w8a8);
+
+  ops.def(
+      "int8_gemm_w8a8_out(Tensor A, Tensor A_scale, Tensor B, Tensor B_scale, "
+      "Tensor! output, Tensor? bias) -> Tensor");
+  ops.impl("int8_gemm_w8a8_out", torch::kXPU, &int8_gemm_w8a8_out);
+
+  ops.def("per_token_quant_int8_xpu(Tensor x) -> (Tensor, Tensor)");
+  ops.impl(
+      "per_token_quant_int8_xpu", torch::kXPU, &per_token_quant_int8_xpu);
+
+  ops.def(
+      "per_token_quant_int8_xpu_clip(Tensor x, float clip_ratio) -> "
+      "(Tensor, Tensor)");
+  ops.impl(
+      "per_token_quant_int8_xpu_clip",
+      torch::kXPU,
+      &per_token_quant_int8_xpu_clip);
+
+  ops.def(
+      "per_token_quant_int8_xpu_out(Tensor x, Tensor! q, Tensor! scales) -> "
+      "(Tensor, Tensor)");
+  ops.impl(
+      "per_token_quant_int8_xpu_out",
+      torch::kXPU,
+      &per_token_quant_int8_xpu_out);
+
+  ops.def(
+      "hybrid_fp8_int8_linear(Tensor x, "
+      "Tensor fp8_weight, Tensor fp8_weight_scale, "
+      "Tensor int8_weight, Tensor int8_weight_scale, int min_tokens) -> "
+      "Tensor");
+  ops.impl(
+      "hybrid_fp8_int8_linear", torch::kXPU, &hybrid_fp8_int8_linear);
+}
+
+REGISTER_EXTENSION(TORCH_EXTENSION_NAME)
