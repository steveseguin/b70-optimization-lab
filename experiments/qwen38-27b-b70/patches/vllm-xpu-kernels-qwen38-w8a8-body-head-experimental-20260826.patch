 namespace {
 
+float configured_clip_ratio() {
+  static const float ratio = [] {
+    const char* text = std::getenv("VLLM_XPU_FP8_BODY_INT8_ACT_CLIP_RATIO");
+    if (text == nullptr || *text == '\0') {
+      return 1.0f;
+    }
+    char* end = nullptr;
+    const float value = std::strtof(text, &end);
+    TORCH_CHECK(
+        end != text && *end == '\0' && value > 0.0f && value <= 1.0f,
+        "VLLM_XPU_FP8_BODY_INT8_ACT_CLIP_RATIO must be in (0, 1], got ",
+        text);
+    return value;
+  }();
+  return ratio;
+}
