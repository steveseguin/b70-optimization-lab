+// Reduce the two Q8_1 statistics through one packed subgroup exchange. The
+// butterfly and FP32 operations match the separate sum/max reductions, but a
+// single 64-bit select carries both values at each stage.
+static __dpct_inline__ void ggml_sycl_q8_reduce_sum_amax(
+        const sycl::sub_group & sg, float & sum, float & amax) {
+    uint64_t packed = (uint64_t) sycl::bit_cast<uint32_t>(amax) << 32 |
+                      sycl::bit_cast<uint32_t>(sum);
+    const uint32_t lane = sg.get_local_linear_id();
+#pragma unroll
+    for (uint32_t mask = WARP_SIZE / 2; mask != 0; mask >>= 1) {
+        const uint64_t other = sycl::select_from_group(sg, packed, lane ^ mask);
+        sum += sycl::bit_cast<float>((uint32_t) other);
+        amax = sycl::fmax(amax, sycl::bit_cast<float>((uint32_t) (other >> 32)));
+        packed = (uint64_t) sycl::bit_cast<uint32_t>(amax) << 32 |
+                 sycl::bit_cast<uint32_t>(sum);
+    }
+}
