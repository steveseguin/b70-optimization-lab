+// Shape-scoped experiment: the recurrent quad's 24 row subgroups all consume
+// the same 5,760-byte Q8_1 activation. Stage those exact bytes once per
+// workgroup in SLM, without changing row concurrency or arithmetic order.
+static inline bool ggml_sycl_mmvq_q8_quad_local_y() {
+    static const bool on = [] {
+        const char * value = std::getenv("GGML_SYCL_MMVQ_Q8_QUAD_LOCAL_Y");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    return on;
+}
