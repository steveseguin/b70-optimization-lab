+static constexpr size_t GGML_SYCL_Q8_MEMO_DECODE_PREALLOC = 64*1024;
+
+#ifdef GGML_SYCL_GRAPH
+// Command-graph recording cannot contain the queue drain used by the rare memo
+// growth path. Decode activations need less than 64 KiB, so reserve every memo
+// slot before recording starts. Prompt graphs are rejected separately.
+static bool ggml_sycl_q8_dedup_prealloc_decode(ggml_backend_sycl_context & ctx) {
+    queue_ptr q = ctx.stream();
+    while (ctx.q8_memo.size() < GGML_SYCL_Q8_MEMO_SLOTS) {
+        ctx.q8_memo.emplace_back();
+    }
+    for (auto & e : ctx.q8_memo) {
+        if (e.cap >= GGML_SYCL_Q8_MEMO_DECODE_PREALLOC) {
+            continue;
+        }
+        if (e.buf != nullptr) {
+            q->wait();
+            sycl::free(e.buf, *q);
+        }
+        e.buf = (char *) sycl::malloc_device(GGML_SYCL_Q8_MEMO_DECODE_PREALLOC, *q);
+        if (e.buf == nullptr) {
+            e.cap = 0;
+            return false;
+        }
+        e.cap = GGML_SYCL_Q8_MEMO_DECODE_PREALLOC;
+    }
+    return true;
+}
+#endif
