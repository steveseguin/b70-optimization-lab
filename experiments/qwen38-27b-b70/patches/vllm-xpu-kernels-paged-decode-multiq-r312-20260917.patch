+    "${CMAKE_CURRENT_LIST_DIR}/paged_decode_multiq_enabled_policies.hpp.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/paged_decode_multiq_enabled_policies_gen.hpp"
+    @ONLY)
+
+  list(REMOVE_DUPLICATES GEN_MULTIQ_SRCS)
+  list(LENGTH GEN_MULTIQ_SRCS GEN_MULTIQ_SRCS_LENGTH)
+  message(
+    STATUS "Generated ${FILENAME_SUFFIX} sources: ${GEN_MULTIQ_SRCS_LENGTH} "
+           "files (config: ${VLLM_MULTIQ_DECODE_CONFIG})")
+
+  list(APPEND ATTN_KERNEL_SRCS_GEN ${GEN_MULTIQ_SRCS})
+  set(ATTN_KERNEL_SRCS_GEN
+      ${ATTN_KERNEL_SRCS_GEN}
+      PARENT_SCOPE)
+endfunction()
