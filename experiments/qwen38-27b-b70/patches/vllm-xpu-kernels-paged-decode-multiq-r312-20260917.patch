diff --git a/csrc/xpu/attn_multiq/multiq_interface.cpp b/csrc/xpu/attn_multiq/multiq_interface.cpp
new file mode 100644
index 0000000..a2157fa
--- /dev/null
+++ b/csrc/xpu/attn_multiq/multiq_interface.cpp
@@ -0,0 +1,331 @@
+#include <algorithm>
+#include <cstdlib>
+#include <sycl/sycl.hpp>
+#include <torch/all.h>
+
+#include "utils.h"
+#include "xpu/attn/paged_kv_utils.h"
+#include "xpu/ops.h"
+
+#ifdef VLLM_XPU_ENABLE_XE2
+  #include "xe_2/paged_decode_multiq_xe2.h"
+#endif
+
+namespace {
+
+// Verbatim copy of get_num_splits() from csrc/flash_attn/flash_api.cpp
+// (r311 base). The multi-query path must pick *exactly* the split count the
+// single-position decode reference picks, and flash_api.cpp is not ours to
+// extend any more (the flash-attention extension ships prebuilt), so the
+// formula is duplicated here. Keep in sync if upstream changes it -- a
+// divergence shows up immediately as a bitwise census failure.
+int multiq_get_num_splits(
+    const sycl::queue& queue,
+    const int& batch_size,
+    const int& num_heads_q,
+    const int& num_heads_kv,
+    const int& max_seqlen_k,
+    const int& block_size) {
+  auto device = queue.get_device();
+  int num_xe_cores =
+      device.get_info<sycl::ext::intel::info::device::gpu_slices>() *
+      device
+          .get_info<sycl::ext::intel::info::device::gpu_subslices_per_slice>();
+
+  // The decode kernel iterates kv_tile-sized work units within each page,
+  // not page-sized units. The dispatch (see paged_decode_utils.hpp::
+  // dispatch_by_page_size) routes
+  //   block_size == 16              -> kv_tile=_16 (SubgroupLayoutQK<_1,_1,_1>,
+  //   SGPerWG=1) block_size == 32              -> kv_tile=_32
+  //   (SubgroupLayoutQK<_1,_2,_1>, SGPerWG=2) block_size > 0 && %% 64 == 0  ->
+  //   kv_tile=_64  (SubgroupLayoutQK<_1,_4,_1>, SGPerWG=4)
+  int kv_tile;
+  int sg_per_wg;
+  int policy_split_cap;
+  if (block_size == 16) {
+    kv_tile = 16;
+    sg_per_wg = 1;
+    policy_split_cap = 16;
+  } else if (block_size == 32) {
+    kv_tile = 32;
+    sg_per_wg = 2;
+    policy_split_cap = 32;
+  } else {
+    kv_tile = 64;
+    sg_per_wg = 4;
+    policy_split_cap = 64;
+  }
+
+  int kv_tiles = (max_seqlen_k + kv_tile - 1) / kv_tile;
+
+  // Below ~16 tiles total the kernel falls back to single-split anyway; any
+  // splitting only adds ReduceSplitK overhead.
+  if (kv_tiles < 16) return 1;
+
+  // Effective number of WG slots on the GPU.  Each Xe core hosts up to
+  // (4 / sg_per_wg) decode WGs concurrently (4 SGs per Xe core at sg_size=16
+  // on Intel Xe2; smaller kv_tile policies use fewer SGs per WG and therefore
+  // pack more WGs per core).
+  int num_wg_slots = num_xe_cores * 4 / sg_per_wg;
+
+  int wgs_per_split = batch_size * num_heads_kv;
+
+  // Saturation guard: if the FMHA already saturates WG slots and the sequence
+  // is not long enough for splitting to deliver bandwidth gains, splitting
+  // only adds ReduceSplitK overhead.
+  if (wgs_per_split >= num_wg_slots && kv_tiles < 64) return 1;
+
+  // (1) Parallelism term: enough splits so total FMHA WGs reach 4x WG-slot
+  //     oversubscription, hiding memory latency.
+  int splits_par =
+      std::max(1, (4 * num_wg_slots + wgs_per_split - 1) / wgs_per_split);
+
+  // (2) Bandwidth term: long sequences benefit from finer K splits even when
+  //     parallelism is already met (per-WG K reduction shortens, total memory
+  //     traffic is invariant to splits).  ~12 tiles per split is the empirical
+  //     knee.
+  int splits_bw = std::max(1, kv_tiles / 12);
+
+  int splits = std::max(splits_par, splits_bw);
+
+  // (3) Reduction-cost cap: ReduceSplitK output volume scales with
+  //     batch_size * num_heads_q * num_kv_splits.  Cap so that this does not
+  //     dwarf the FMHA epilogue.  Empirically 128 * num_xe_cores partial
+  //     "head-rows" total is a good ceiling.
+  int red_work = std::max(1, batch_size * num_heads_q);
+  int red_cap = std::max(2, 128 * num_xe_cores / red_work);
+  splits = std::min(splits, red_cap);
+
+  // (4) Each split must process at least ~4 KV tiles to amortize overhead.
+  int max_splits_tiles = std::max(1, kv_tiles / 4);
+  // (5) Hard cap of 32 (beyond this the ReduceSplitK kernel dominates).
+  return std::max(
+      1, std::min({splits, max_splits_tiles, 32, policy_split_cap}));
+}
+
+// Skip the (host-synchronising) precondition check with
+// VLLM_XPU_MULTIQ_HOST_CHECK=0 when benchmarking a configuration that has
+// already been validated.
+const bool kMultiQHostCheck = []() {
+  const char* env = std::getenv("VLLM_XPU_MULTIQ_HOST_CHECK");
+  return !(env != nullptr && env[0] == '0');
+}();
+
+}  // namespace
+
+at::Tensor paged_decode_multiq(
+    const at::Tensor& q,
+    const at::Tensor& k,
+    const at::Tensor& v,
+    std::optional<at::Tensor> out_,
+    const at::Tensor& cu_seqlens_q,
+    const at::Tensor& seqused_k,
+    const at::Tensor& block_table,
+    int64_t max_seqlen_q_,
+    int64_t max_seqlen_k_,
+    const std::optional<at::Tensor>& k_scale,
+    const std::optional<at::Tensor>& v_scale,
+    double softmax_scale,
+    std::optional<int64_t> num_splits,
+    std::optional<int64_t> v_tile) {
+  int max_seqlen_q = static_cast<int>(max_seqlen_q_);
+  int max_seqlen_k = static_cast<int>(max_seqlen_k_);
+
+  auto q_type = q.scalar_type();
+  auto k_type = k.scalar_type();
+  TORCH_CHECK(
+      q_type == at::ScalarType::Half || q_type == at::ScalarType::BFloat16,
+      "VLLM Kernel XPU only supports fp16 and bf16 type");
+  TORCH_CHECK(
+      v.scalar_type() == k_type, "key and value must have the same dtype");
+  if (k_type != at::ScalarType::Float8_e5m2 &&
+      k_type != at::ScalarType::Float8_e4m3fn) {
+    TORCH_CHECK(
+        k.scalar_type() == q_type, "query and key must have the same dtype");
+    TORCH_CHECK(
+        v.scalar_type() == q_type, "query and value must have the same dtype");
+  }
+
+  CHECK_DEVICE(q);
+  CHECK_DEVICE(k);
+  CHECK_DEVICE(v);
+  TORCH_CHECK(
+      q.stride(-1) == 1, "Input tensor must have contiguous last dimension");
+  TORCH_CHECK(
+      k.stride(-1) == 1, "Input tensor must have contiguous last dimension");
+  TORCH_CHECK(
+      v.stride(-1) == 1, "Input tensor must have contiguous last dimension");
+  CHECK_STRIDE_ALIGNMENT(q);
+  CHECK_STRIDE_ALIGNMENT(k);
+  CHECK_STRIDE_ALIGNMENT(v);
+  TORCH_CHECK(q.dim() == 3, "query must be in ragged format");
+
+  CHECK_DEVICE(block_table);
+  TORCH_CHECK(
+      block_table.dtype() == torch::kInt32,
+      "page_table must have dtype torch.int32");
+  TORCH_CHECK(
+      block_table.stride(-1) == 1,
+      "page_table must have contiguous last dimension");
+  check_paged_kv_cache_strides(k, v);
+
+  CHECK_DEVICE(cu_seqlens_q);
+  CHECK_CONTIGUOUS(cu_seqlens_q);
+  TORCH_CHECK(
+      cu_seqlens_q.dtype() == torch::kInt32,
+      "cu_seqlens_q must have dtype torch.int32");
+  CHECK_DEVICE(seqused_k);
+  CHECK_CONTIGUOUS(seqused_k);
+  TORCH_CHECK(
+      seqused_k.dtype() == torch::kInt32,
+      "seqused_k must have dtype torch.int32");
+
+  auto& queue = vllm::xpu::vllmGetQueue(q.device().index());
+
+  int num_tokens = q.size(0);
+  int batch_size = static_cast<int>(cu_seqlens_q.size(0)) - 1;
+  int num_heads_q = q.size(1);
+  int v_head_dim = v.size(-1);
+  int num_heads_kv = k.size(2);
+  int block_size = k.size(1);
+
+  TORCH_CHECK(
+      max_seqlen_q >= 2,
+      "paged_decode_multiq needs max_seqlen_q >= 2 (use the decode path for "
+      "single-position decode), got ",
+      max_seqlen_q);
+  TORCH_CHECK(
+      num_tokens == batch_size * max_seqlen_q,
+      "paged_decode_multiq requires a uniform query length: total_q=",
+      num_tokens,
+      " batch=",
+      batch_size,
+      " max_seqlen_q=",
+      max_seqlen_q);
+  TORCH_CHECK(
+      static_cast<int>(seqused_k.numel()) == batch_size,
+      "seqused_k must have one entry per sequence");
+  TORCH_CHECK(
+      static_cast<int>(block_table.size(0)) == batch_size,
+      "block_table must have one row per sequence");
+
+  // All positions share one KV tile count and one split plan, which is only
+  // equivalent to the per-position reference when every position's last KV
+  // position falls in the same KV tile.
+  int kv_tile = (block_size == 16) ? 16 : ((block_size == 32) ? 32 : 64);
+  if (kMultiQHostCheck) {
+    // The kernel reads each sequence's query length from cu_seqlens_q, so a
+    // ragged batch would silently verify a different number of positions per
+    // sequence than the caller laid out.
+    at::Tensor cu_seqlens_q_host = cu_seqlens_q.to(at::kCPU);
+    const int32_t* cu_q = cu_seqlens_q_host.data_ptr<int32_t>();
+    for (int i = 0; i <= batch_size; ++i) {
+      TORCH_CHECK(
+          cu_q[i] == i * max_seqlen_q,
+          "paged_decode_multiq requires a uniform query length: "
+          "cu_seqlens_q[",
+          i,
+          "]=",
+          cu_q[i],
+          " expected ",
+          i * max_seqlen_q);
+    }
+    at::Tensor seqused_k_host = seqused_k.to(at::kCPU);
+    const int32_t* kv_lens = seqused_k_host.data_ptr<int32_t>();
+    for (int i = 0; i < batch_size; ++i) {
+      int kv_len = static_cast<int>(kv_lens[i]);
+      TORCH_CHECK(
+          kv_len >= max_seqlen_q,
+          "paged_decode_multiq: seqused_k[",
+          i,
+          "]=",
+          kv_len,
+          " must be at least max_seqlen_q=",
+          max_seqlen_q);
+      TORCH_CHECK(
+          kv_len <= max_seqlen_k,
+          "paged_decode_multiq: seqused_k[",
+          i,
+          "]=",
+          kv_len,
+          " exceeds max_seqlen_k=",
+          max_seqlen_k);
+      TORCH_CHECK(
+          (kv_len - 1) % kv_tile >= max_seqlen_q - 1,
+          "paged_decode_multiq: all verified positions must end in the same "
+          "KV tile: (seqused_k[",
+          i,
+          "] - 1) % ",
+          kv_tile,
+          " = ",
+          (kv_len - 1) % kv_tile,
+          " < q_len - 1 = ",
+          max_seqlen_q - 1,
+          ". Fall back to per-position decode calls for this step.");
+    }
+  }
+
+  at::Tensor out;
+  if (out_.has_value()) {
+    out = *out_;
+  } else {
+    out = torch::empty(
+        {num_tokens, num_heads_q, v_head_dim}, q.options().device(q.device()));
+  }
+
+  // Exactly the single-position reference's split count: it is computed for a
+  // batch of one so the plan matches a lone decode row, and it only depends on
+  // max_seqlen_k through the KV tile count, which the precondition above makes
+  // identical for every verified position.
+  int num_kv_splits = num_splits.has_value() ? static_cast<int>(*num_splits)
+                                             : multiq_get_num_splits(
+                                                   queue,
+                                                   /*batch_size=*/1,
+                                                   num_heads_q,
+                                                   num_heads_kv,
+                                                   max_seqlen_k,
+                                                   block_size);
+
+  at::Tensor tmp_out =
+      num_kv_splits == 1
+          ? out
+          : at::empty(
+                {num_tokens, num_heads_q * num_kv_splits, v_head_dim},
+                q.options().device(q.device()));
+  at::Tensor max_logits = at::empty(
+      {num_tokens, num_heads_q, num_kv_splits},
+      q.options().dtype(at::kFloat).device(q.device()));
+  at::Tensor exp_sums = at::empty(
+      {num_tokens, num_heads_q, num_kv_splits},
+      q.options().dtype(at::kFloat).device(q.device()));
+
+  if (vllm::xpu::is_xe2_arch() || vllm::xpu::is_xe3_arch()) {
+#ifdef VLLM_XPU_ENABLE_XE2
+    cutlass_paged_decode_multiq_xe2(
+        queue,
+        q,
+        k,
+        v,
+        out,
+        tmp_out,
+        exp_sums,
+        max_logits,
+        block_table,
+        cu_seqlens_q,
+        seqused_k,
+        max_seqlen_q,
+        max_seqlen_k,
+        k_scale,
+        v_scale,
+        softmax_scale,
+        num_kv_splits,
+        v_tile.has_value() ? static_cast<int>(*v_tile) : 0);
+#else
+    TORCH_CHECK(false, "XE2 cutlass kernel is not enabled in this build.");
+#endif
+  } else {
+    TORCH_CHECK(false, "Only XE2/XE3 cutlass kernel is supported currently.");
+  }
+
+  return out;
+}
diff --git a/csrc/xpu/attn_multiq/xe_2/CMakeLists.txt b/csrc/xpu/attn_multiq/xe_2/CMakeLists.txt
