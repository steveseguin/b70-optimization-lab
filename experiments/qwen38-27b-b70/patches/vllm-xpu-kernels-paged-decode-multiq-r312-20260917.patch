+    string(REPLACE "|" ";" _pair_parts "${_pair}")
+    list(GET _pair_parts 0 _pol)
+    list(APPEND MULTIQ_TRAIT_POLICIES "${_pol}")
+  endforeach()
+  list(REMOVE_DUPLICATES MULTIQ_TRAIT_POLICIES)
+  foreach(_pol ${MULTIQ_TRAIT_POLICIES})
+    set(ENABLED_MULTIQ_POLICY_TRAITS
+        "${ENABLED_MULTIQ_POLICY_TRAITS}template <>\nstruct is_multiq_policy_enabled<${_pol}> : std::true_type {};\n"
