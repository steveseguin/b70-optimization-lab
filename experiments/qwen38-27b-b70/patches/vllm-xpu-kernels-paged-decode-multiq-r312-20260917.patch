diff --git a/csrc/xpu/attn/xe_2/paged_decode_multiq_configure.cmake b/csrc/xpu/attn/xe_2/paged_decode_multiq_configure.cmake
new file mode 100644
index 0000000..d1df9b9
--- /dev/null
+++ b/csrc/xpu/attn/xe_2/paged_decode_multiq_configure.cmake
@@ -0,0 +1,130 @@
+# =============================================================================
+# Multi-query Paged Decode Kernel Configuration
+# =============================================================================
+# Generates one explicit instantiation of the multi-query decode kernel per
+# (qgroup, headsize, pagesize) policy enabled by the *paged decode* config file
+# (VLLM_PAGED_DECODE_CONFIG). The multi-query path has no causal/local/sink
+# dimensions -- causality is expressed through the per-position KV limits -- so
+# a policy that is enabled for decode yields exactly one multi-query kernel.
+#
+# Requires _paged_decode_parse_config() from paged_decode_configure.cmake
+# (include that file first).
+#
+# Usage: paged_decode_multiq_configure(paged_decode_multiq_kernel_template)
+#
+# Output: appends the generated sources to ATTN_KERNEL_SRCS_GEN and writes
+# paged_decode_multiq_extern_gen.hpp into the build directory.
+# =============================================================================
+
+function(paged_decode_multiq_configure FILENAME_SUFFIX)
+  set(GEN_MULTIQ_SRCS)
+  set(MULTIQ_POLICIES)
+
+  # Policies that exist as aliases in paged_decode.hpp. head_size 576 is only
+  # defined for page sizes 64 and 128.
+  set(qgroup_list "8" "16")
+  set(headsize_list "64" "96" "128" "192" "256" "512")
+  set(pagesize_list "16" "32" "64" "128")
+
+  message(
+    STATUS "Paged decode multi-query kernel config: ${VLLM_PAGED_DECODE_CONFIG}"
+  )
+  _paged_decode_parse_config("${VLLM_PAGED_DECODE_CONFIG}" CONFIG_TUPLES
+                             CONFIG_IS_FULL)
+
+  set(POLICY_TRIPLES)
+  if(CONFIG_IS_FULL)
+    foreach(_q ${qgroup_list})
+      foreach(_p ${pagesize_list})
+        foreach(_h ${headsize_list})
+          list(APPEND POLICY_TRIPLES "${_q}|${_h}|${_p}")
+        endforeach()
+        if("${_p}" STREQUAL "64" OR "${_p}" STREQUAL "128")
+          list(APPEND POLICY_TRIPLES "${_q}|576|${_p}")
+        endif()
+      endforeach()
+    endforeach()
+  else()
+    foreach(_entry ${CONFIG_TUPLES})
+      string(REPLACE "|" ";" _parts "${_entry}")
+      list(LENGTH _parts _nparts)
+      if(_nparts LESS 3)
+        continue()
+      endif()
+      list(GET _parts 0 _q)
+      list(GET _parts 1 _h)
+      list(GET _parts 2 _p)
+      list(APPEND POLICY_TRIPLES "${_q}|${_h}|${_p}")
+    endforeach()
+  endif()
+
+  list(REMOVE_DUPLICATES POLICY_TRIPLES)
+
+  foreach(_triple ${POLICY_TRIPLES})
+    string(REPLACE "|" ";" _parts "${_triple}")
+    list(GET _parts 0 IMPL_QGROUP)
+    list(GET _parts 1 IMPL_HEADSIZE)
+    list(GET _parts 2 IMPL_PAGESIZE)
+
+    # Validate against the alias set in paged_decode.hpp
+    list(FIND qgroup_list "${IMPL_QGROUP}" _qi)
+    list(FIND pagesize_list "${IMPL_PAGESIZE}" _pi)
+    list(FIND headsize_list "${IMPL_HEADSIZE}" _hi)
+    if("${IMPL_HEADSIZE}" STREQUAL "576")
+      if("${IMPL_PAGESIZE}" STREQUAL "64" OR "${IMPL_PAGESIZE}" STREQUAL "128")
+        set(_hi 0)
+      endif()
+    endif()
+    if(_qi LESS 0
+       OR _pi LESS 0
+       OR _hi LESS 0)
+      message(WARNING "No multi-query decode policy for qgroup=${IMPL_QGROUP}, "
+                      "headsize=${IMPL_HEADSIZE}, pagesize=${IMPL_PAGESIZE}. "
+                      "Skipping.")
+      continue()
+    endif()
+
+    set(IMPL_POLICY
+        "decode_policy_q${IMPL_QGROUP}_h${IMPL_HEADSIZE}_p${IMPL_PAGESIZE}")
+    list(APPEND MULTIQ_POLICIES "${IMPL_POLICY}")
+
+    set(FILE_SUFFIX "_q${IMPL_QGROUP}_h${IMPL_HEADSIZE}_p${IMPL_PAGESIZE}")
+    configure_file(${FILENAME_SUFFIX}.cpp.in
+                   "${FILENAME_SUFFIX}${FILE_SUFFIX}.cpp")
+    list(APPEND GEN_MULTIQ_SRCS
+         "${CMAKE_CURRENT_BINARY_DIR}/${FILENAME_SUFFIX}${FILE_SUFFIX}.cpp")
+  endforeach()
+
+  list(REMOVE_DUPLICATES MULTIQ_POLICIES)
+
+  # X-macro list for the extern header
+  set(MULTIQ_POLICY_LIST_ENTRIES "")
+  list(LENGTH MULTIQ_POLICIES _num_policies)
+  math(EXPR _last_idx "${_num_policies} - 1")
+  set(_idx 0)
+  foreach(_pol ${MULTIQ_POLICIES})
+    if(_idx EQUAL _last_idx)
+      set(MULTIQ_POLICY_LIST_ENTRIES
+          "${MULTIQ_POLICY_LIST_ENTRIES}  X(${_pol})\n")
+    else()
+      set(MULTIQ_POLICY_LIST_ENTRIES
+          "${MULTIQ_POLICY_LIST_ENTRIES}  X(${_pol}) \\\n")
+    endif()
+    math(EXPR _idx "${_idx} + 1")
+  endforeach()
+
+  configure_file(
+    "${CMAKE_CURRENT_LIST_DIR}/paged_decode_multiq_extern.hpp.in"
+    "${CMAKE_CURRENT_BINARY_DIR}/paged_decode_multiq_extern_gen.hpp" @ONLY)
+
+  list(REMOVE_DUPLICATES GEN_MULTIQ_SRCS)
+  list(LENGTH GEN_MULTIQ_SRCS GEN_MULTIQ_SRCS_LENGTH)
+  message(
+    STATUS "Generated ${FILENAME_SUFFIX} sources: ${GEN_MULTIQ_SRCS_LENGTH} "
+           "files (config: ${VLLM_PAGED_DECODE_CONFIG})")
+
+  list(APPEND ATTN_KERNEL_SRCS_GEN ${GEN_MULTIQ_SRCS})
+  set(ATTN_KERNEL_SRCS_GEN
+      ${ATTN_KERNEL_SRCS_GEN}
+      PARENT_SCOPE)
+endfunction()
