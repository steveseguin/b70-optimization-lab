+
+// Runtime dispatcher: report a helpful error when the policy was not built.
+template <typename decode_policy>
+void multiq_policy_dispatch_func(
+    sycl::queue& queue,
+    CutlassQKType& cuQKType,
+    const paged_decode_args_t& args,
+    const int v_tile) {
+  constexpr int _qgroup = cute::size<0>(typename decode_policy::ShapeOut{});
+  constexpr int _head_sz = decode_policy::HeadDim::value;
+  constexpr int _page_sz = cute::size<1>(typename decode_policy::ShapeQK{});
+
+  if constexpr (!is_multiq_policy_enabled<decode_policy>::value) {
+    TORCH_CHECK(
+        false,
+        "Multi-query paged decode kernel not compiled for this "
+        "configuration.\n\n"
+        "Add this line to the multi-query kernel config "
+        "(VLLM_MULTIQ_DECODE_CONFIG, default "
+        "csrc/xpu/attn/kernel_configs/paged_decode_qwen38.conf):\n\n  ",
+        _qgroup,
+        ",",
+        _head_sz,
+        ",",
+        _page_sz,
+        ",false,false,false\n\nThen rebuild:\n"
+        "  VLLM_MULTIQ_DECODE_CONFIG=<config> pip install .\n");
+  } else {
+    // V-tile selection. Only widths narrower than the policy's own ShapeOut
+    // are separate kernels; 0 and the policy width are the same kernel. The
+    // `if constexpr` guards must match the generator's rule
+    // (paged_decode_multiq_configure.cmake emits VTile < default width), or
+    // this would reference an instantiation that was never emitted.
+    constexpr int kDefaultV = multiq_default_v<decode_policy>;
+
+    if (v_tile == 0 || v_tile == kDefaultV) {
+      multiq_policy_dispatch_impl<decode_policy, 0>(queue, cuQKType, args);
+      return;
+    }
+    if constexpr (64 < kDefaultV) {
+      if (v_tile == 64) {
+        multiq_policy_dispatch_impl<decode_policy, 64>(queue, cuQKType, args);
+        return;
+      }
+    }
+    if constexpr (128 < kDefaultV) {
+      if (v_tile == 128) {
+        multiq_policy_dispatch_impl<decode_policy, 128>(queue, cuQKType, args);
+        return;
+      }
+    }
+    if constexpr (256 < kDefaultV) {
+      if (v_tile == 256) {
+        multiq_policy_dispatch_impl<decode_policy, 256>(queue, cuQKType, args);
+        return;
+      }
+    }
+    TORCH_CHECK(
+        false,
+        "paged_decode_multiq: v_tile=",
+        v_tile,
+        " is not compiled for policy (q_packed=",
+        _qgroup,
+        ", head=",
+        _head_sz,
+        ", page=",
+        _page_sz,
+        "). Compiled widths: 0 (= ",
+        kDefaultV,
+        ", the decode default) and every value of {64, 128, 256} below it.");
+  }
+}
+
+template <typename QGroup, typename PageSize>
+inline void multiq_dispatch_by_head_size(
+    const int head_case,
+    sycl::queue& queue,
+    CutlassQKType& cuQKType,
+    const paged_decode_args_t& args,
+    const int v_tile) {
+  switch (head_case) {
+    case 0:
+      multiq_policy_dispatch_func<
+          decode_policy_qpacked_head<QGroup, _64, PageSize>>(
+          queue, cuQKType, args, v_tile);
+      break;
+    case 1:
+      multiq_policy_dispatch_func<
+          decode_policy_qpacked_head<QGroup, _96, PageSize>>(
+          queue, cuQKType, args, v_tile);
+      break;
+    case 2:
+      multiq_policy_dispatch_func<
+          decode_policy_qpacked_head<QGroup, _128, PageSize>>(
+          queue, cuQKType, args, v_tile);
+      break;
+    case 3:
+      multiq_policy_dispatch_func<
+          decode_policy_qpacked_head<QGroup, _192, PageSize>>(
+          queue, cuQKType, args, v_tile);
+      break;
+    case 4:
+      multiq_policy_dispatch_func<
+          decode_policy_qpacked_head<QGroup, _256, PageSize>>(
+          queue, cuQKType, args, v_tile);
+      break;
+    case 5:
+      multiq_policy_dispatch_func<
+          decode_policy_qpacked_head<QGroup, _512, PageSize>>(
+          queue, cuQKType, args, v_tile);
+      break;
+    case 6:
+      multiq_policy_dispatch_func<
+          decode_policy_qpacked_head<QGroup, _576, PageSize>>(
+          queue, cuQKType, args, v_tile);
+      break;
+    default:
+      TORCH_CHECK(false, "Unsupported head size for paged_decode_multiq");
+  }
+}
+
+template <typename QGroup>
+inline void multiq_dispatch_by_page_size(
+    const int page_size,
+    const int head_case,
+    sycl::queue& queue,
+    CutlassQKType& cuQKType,
+    const paged_decode_args_t& args,
+    const int v_tile) {
+  // Identical routing to dispatch_by_page_size() in paged_decode_utils.hpp:
+  // the kv_tile the mainloop uses has to match the one the reference decode
+  // call would have used, or the tile count (and therefore the split plan and
+  // the masking) would differ.
+  if (page_size == 16) {
+    multiq_dispatch_by_head_size<QGroup, _16>(
+        head_case, queue, cuQKType, args, v_tile);
+  } else if (page_size == 32) {
+    multiq_dispatch_by_head_size<QGroup, _32>(
+        head_case, queue, cuQKType, args, v_tile);
+  } else if (page_size > 0 && (page_size % 64) == 0) {
+    multiq_dispatch_by_head_size<QGroup, _64>(
+        head_case, queue, cuQKType, args, v_tile);
+  } else {
+    TORCH_CHECK(
+        false,
+        "Unsupported page size for paged_decode_multiq: ",
+        page_size,
+        " (supported: 16, 32, or any positive multiple of 64)");
+  }
+}
diff --git a/csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_xe2.cpp b/csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_xe2.cpp
new file mode 100644
index 0000000..d4d064b
--- /dev/null
+++ b/csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_xe2.cpp
@@ -0,0 +1,223 @@
+#include "csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_xe2.h"
+#include "csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_utils.hpp"
+// Use the generated extern header (only declares enabled policies)
+#if __has_include("paged_decode_multiq_extern_gen.hpp")
+  #include "paged_decode_multiq_extern_gen.hpp"
+#else
+  #include "paged_decode_multiq_extern.hpp"
+#endif
+
+using namespace cute;
+
+namespace {
+
+bool multiq_is_single_value_broadcast_tensor(const at::Tensor& t) {
+  if (t.scalar_type() != at::ScalarType::Float) {
+    return false;
+  }
+  for (int64_t i = 0; i < t.dim(); ++i) {
+    if (t.size(i) > 1 && t.stride(i) != 0) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+void cutlass_paged_decode_multiq_xe2(
+    sycl::queue& queue,
+    const at::Tensor& query,      // [total_q, heads, head_size]
+    const at::Tensor& key_cache,  // [num_block, block_size, heads, head_size]
+    const at::Tensor& value_cache,
+    at::Tensor& out,
+    at::Tensor& temp_out,
+    at::Tensor& exp_sums,
+    at::Tensor& max_logits,
+    const at::Tensor& block_table,
+    const at::Tensor& cu_seqlens_q,
+    const at::Tensor& seqused_k,
+    int max_seqlen_q,
+    int max_seqlen_k,
+    const std::optional<at::Tensor>& k_scale,
+    const std::optional<at::Tensor>& v_scale,
+    double sm_scale,
+    int num_kv_splits,
+    int v_tile) {
+  bool is_fp8_kv = key_cache.scalar_type() == at::ScalarType::Float8_e5m2 ||
+                   key_cache.scalar_type() == at::ScalarType::Float8_e4m3fn;
+  if (is_fp8_kv) {
+    TORCH_CHECK(
+        k_scale.has_value() && v_scale.has_value(),
+        "FP8 KV cache requires both k_scale and v_scale tensors to be "
+        "provided.");
+    TORCH_CHECK(
+        k_scale->scalar_type() == at::ScalarType::Float &&
+            multiq_is_single_value_broadcast_tensor(*k_scale),
+        "FP8 KV k_scale must be a float32 tensor with a single element.");
+    TORCH_CHECK(
+        v_scale->scalar_type() == at::ScalarType::Float &&
+            multiq_is_single_value_broadcast_tensor(*v_scale),
+        "FP8 KV v_scale must be a float32 tensor with a single element.");
+  }
+
+  // query: [total_q, num_heads_q, head_size]; paged KV cache
+  int batch_size = cu_seqlens_q.numel() - 1;
+  int num_heads_q = query.size(1);
+  int head_size = query.size(2);
+  int v_head_size = value_cache.size(-1);
+  int total_seqlen_q = query.size(0);
+
+  int num_blocks = key_cache.size(0);
+  int block_size = key_cache.size(1);
+  int num_heads_kv = key_cache.size(2);
+  int max_blocks_per_seq = block_table.size(1);
+  int total_seqlen_k = num_blocks * block_size;
+
+  TORCH_CHECK(
+      max_seqlen_q >= 2 &&
+          max_seqlen_q <= cutlass::fmha::collective::kDecodeMultiQMaxLen,
+      "paged_decode_multiq: max_seqlen_q must be in [2, ",
+      cutlass::fmha::collective::kDecodeMultiQMaxLen,
+      "], got ",
+      max_seqlen_q);
+  TORCH_CHECK(
+      total_seqlen_q == batch_size * max_seqlen_q,
+      "paged_decode_multiq: every sequence must contribute exactly "
+      "max_seqlen_q query tokens (total_q=",
+      total_seqlen_q,
+      " batch=",
+      batch_size,
+      " max_seqlen_q=",
+      max_seqlen_q,
+      ")");
+
+  // V/output tile width: 0 keeps the policy's own ShapeOut (what the decode
+  // path uses); a narrower width splits the output columns across grid.x so
+  // each work-group holds only its slice of the per-position accumulators.
+  TORCH_CHECK(
+      v_tile == 0 || v_tile == 64 || v_tile == 128 || v_tile == 256,
+      "paged_decode_multiq: v_tile must be 0 (policy default), 64, 128 or "
+      "256, got ",
+      v_tile);
+  TORCH_CHECK(
+      v_tile == 0 || v_head_size % v_tile == 0,
+      "paged_decode_multiq: v_tile=",
+      v_tile,
+      " must divide head_size_vo=",
+      v_head_size);
+
+  int page_stride_elements =
+      static_cast<int>(get_paged_kv_cache_page_stride_elements(key_cache));
+
+  paged_decode_args_t args = {
+      query.data_ptr(),
+      key_cache.data_ptr(),
+      value_cache.data_ptr(),
+      out.data_ptr(),
+      temp_out.data_ptr(),
+      exp_sums.data_ptr(),
+      max_logits.data_ptr(),
+      block_table.data_ptr(),
+      cu_seqlens_q.data_ptr(),
+      seqused_k.data_ptr(),
+      max_seqlen_q,
+      max_seqlen_k,
+      total_seqlen_q,
+      total_seqlen_k,
+      is_fp8_kv ? k_scale.value().data_ptr() : nullptr,
+      is_fp8_kv ? v_scale.value().data_ptr() : nullptr,
+      static_cast<float>(sm_scale),
+      nullptr,  // sm_sink: unsupported on this path
+      batch_size,
+      num_heads_q,
+      num_heads_kv,
+      head_size,
+      v_head_size,
+      max_blocks_per_seq,
+      block_size,
+      max_seqlen_k,  // window_size_left (unused: is_local = false)
+      max_seqlen_k,  // window_size_right (unused: is_local = false)
+      true,          // varlen
+      true,          // paged
+      false,         // is_causal: expressed by the per-position KV limits
+      false,         // is_local
+      false,         // is_sink
+      num_kv_splits,
+      nullptr,  // splits_per_seq: one shared plan for all positions
+      nullptr,  // work_list
+      0,        // total_wgs
+      key_cache.stride(0),
+      key_cache.stride(1),
+      key_cache.stride(2),
+      value_cache.stride(0),
+      value_cache.stride(1),
+      value_cache.stride(2),
+      nullptr,  // is_prefill
+      // Q strides: Q is [total_q, num_heads_q, head_size]; get<0> is also the
+      // distance between two verified positions of the same sequence.
+      query.stride(0),
+      query.stride(1),
+      int64_t{0},
+      page_stride_elements};
+
+  // For non-contiguous paged KV (e.g., cross-layer KV cache), enlarge
+  // total_seqlen_k to cover the full physical extent for the 2D block load
+  // surface descriptor.
+  {
+    int64_t effective_total =
+        get_paged_kv_cache_effective_total_seqlen(key_cache);
+    if (effective_total > args.total_seqlen_k) {
+      args.total_seqlen_k = static_cast<int>(effective_total);
+    }
+  }
+
+  TORCH_CHECK(
+      query.stride(-1) == 1,
+      "paged_decode_multiq_xe2: query must be contiguous in the last "
+      "dimension (head_dim), got stride=",
+      query.stride(-1));
+  TORCH_CHECK(
+      key_cache.stride(-1) == 1,
+      "paged_decode_multiq_xe2: key_cache must be contiguous in the last "
+      "dimension (head_dim), got stride=",
+      key_cache.stride(-1));
+  TORCH_CHECK(
+      value_cache.stride(-1) == 1,
+      "paged_decode_multiq_xe2: value_cache must be contiguous in the last "
+      "dimension (head_dim), got stride=",
+      value_cache.stride(-1));
+
+  CutlassQKType cuQKType = aten_to_Cutlass_qk_dtype(query, key_cache);
+
+  static constexpr int max_head_size = 576;
+  TORCH_CHECK(
+      head_size <= max_head_size,
+      "FMHA forward only supports head dimension at most " +
+          std::to_string(max_head_size));
+
+  auto get_head_size_case = [](int head_size) -> int {
+    if (head_size <= HEAD_SIZE_LIMIT_0) return 0;
+    if (head_size <= HEAD_SIZE_LIMIT_1) return 1;
+    if (head_size <= HEAD_SIZE_LIMIT_2) return 2;
+    if (head_size <= HEAD_SIZE_LIMIT_3) return 3;
+    if (head_size <= HEAD_SIZE_LIMIT_4) return 4;
+    if (head_size <= HEAD_SIZE_LIMIT_5) return 5;
+    if (head_size <= HEAD_SIZE_LIMIT_6) return 6;
+    return -1;
+  };
+
+  int head_case = get_head_size_case(args.head_size);
+  int num_q_group_size = num_heads_q / num_heads_kv;
+
+  // Same packed-Q tile selection as the decode path (see
+  // paged_decode_xe2.cpp): the GQA head group is tiled across the grid's Q
+  // dimension, so this is a tile size, not a cap on the GQA ratio.
+  if (num_q_group_size <= 8) {
+    multiq_dispatch_by_page_size<_8>(
+        block_size, head_case, queue, cuQKType, args, v_tile);
+  } else {
+    multiq_dispatch_by_page_size<_16>(
+        block_size, head_case, queue, cuQKType, args, v_tile);
+  }
+}
diff --git a/csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_xe2.h b/csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_xe2.h
new file mode 100644
index 0000000..6de16ce
--- /dev/null
+++ b/csrc/xpu/attn_multiq/xe_2/paged_decode_multiq_xe2.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <sycl/sycl.hpp>
+#include <torch/all.h>
+
+// Multi-query paged decode: verify max_seqlen_q consecutive positions of each
+// sequence in one pass over the KV cache. Always varlen + paged, never
+// causal/local/sink at the kernel level (causality comes from the
+// per-position KV limits).
+void cutlass_paged_decode_multiq_xe2(
+    sycl::queue& queue,
+    const at::Tensor& query,      // [total_q, heads, head_size]
+    const at::Tensor& key_cache,  // [num_block, block_size, heads, head_size]
+    const at::Tensor& value_cache,
+    at::Tensor& out,
+    at::Tensor& temp_out,    // [total_q, num_head_q * num_kv_splits, head_vo]
+    at::Tensor& exp_sums,    // [total_q, num_head_q, num_kv_splits]
+    at::Tensor& max_logits,  // [total_q, num_head_q, num_kv_splits]
+    const at::Tensor& block_table,
+    const at::Tensor& cu_seqlens_q,
+    const at::Tensor& seqused_k,
+    int max_seqlen_q,
+    int max_seqlen_k,
+    const std::optional<at::Tensor>& k_scale,
+    const std::optional<at::Tensor>& v_scale,
+    double sm_scale,
+    int num_kv_splits,
+    // Per-work-group V/output tile width; 0 = the policy's decode default.
+    int v_tile);
diff --git a/csrc/xpu/ops.h b/csrc/xpu/ops.h
index 7dda1b5..a7d2221 100644
--- a/csrc/xpu/ops.h
+++ b/csrc/xpu/ops.h
@@ -441,3 +441,43 @@ void fused_input_norm(
     torch::Tensor& input,
     torch::Tensor& weight,
     torch::Tensor& bias);
+
+// Multi-query paged decode (speculative-decoding verification).
+//
+// Every sequence contributes the same q_len = max_seqlen_q (2..8) consecutive
+// query positions, laid out as q[i * q_len + j] for sequence i and position j,
+// and position j attends to KV positions
+//   [0, seqused_k[i] - (q_len - 1 - j)).
+// The kernel loads each KV tile once for all positions but keeps a separate
+// accumulator, softmax state and column mask per position, so every position's
+// output is bit-identical to the single-position decode call
+//   varlen_fwd(q[i*q_len+j], ..., max_seqlen_q=1, causal=false,
+//              seqused_k=seqused_k[i]-(q_len-1-j))
+// that the verifier-rows overlay issues today, provided the split plan is
+// shared -- which the host precondition and the batch_size=1 split count
+// below guarantee.
+//
+// This op lives in the _xpu_C extension and its kernels in
+// libattn_multiq_kernels_xe_2.so, deliberately separate from the upstream
+// flash-attention extension/library: those ship prebuilt and rebuilding them
+// would change the rounding of the published reference outputs.
+//
+// v_tile selects how many V/output columns one work-group owns (0/absent =
+// the decode policy's own width). Narrower tiles split the columns across
+// grid.x so each work-group keeps only its slice of the q_len accumulators;
+// K is re-read per slice and the result is unchanged.
+at::Tensor paged_decode_multiq(
+    const at::Tensor& q,  // [total_q, num_heads_q, head_size]
+    const at::Tensor& k,  // [num_blocks, block_size, num_heads_kv, head_size]
+    const at::Tensor& v,
+    std::optional<at::Tensor> out_,
+    const at::Tensor& cu_seqlens_q,  // b+1
+    const at::Tensor& seqused_k,     // b
+    const at::Tensor& block_table,   // b x max_num_blocks_per_seq
+    int64_t max_seqlen_q,
+    int64_t max_seqlen_k,
+    const std::optional<at::Tensor>& k_scale,
+    const std::optional<at::Tensor>& v_scale,
+    double softmax_scale,
+    std::optional<int64_t> num_splits,
+    std::optional<int64_t> v_tile);
diff --git a/csrc/xpu/torch_bindings.cpp b/csrc/xpu/torch_bindings.cpp
index a1713cc..b2a18cc 100644
--- a/csrc/xpu/torch_bindings.cpp
+++ b/csrc/xpu/torch_bindings.cpp
@@ -345,6 +345,20 @@ TORCH_LIBRARY_EXPAND(TORCH_EXTENSION_NAME, xpu_ops) {
       "fused_input_norm(Tensor! out, Tensor input, Tensor weight, "
       "Tensor bias) -> ()");
   xpu_ops.impl("fused_input_norm", torch::kXPU, &fused_input_norm);
+
+#ifdef VLLM_MULTIQ_ENABLED
+  // Speculative-decoding verification: q_len (2..8) consecutive positions of
+  // each sequence in one pass over the paged KV cache, bit-identical to the
+  // equivalent per-position single-query decode calls. Registered here rather
+  // than in the flash-attention extension so that extension and its kernel
+  // library stay exactly as shipped.
+  xpu_ops.def(
+      "paged_decode_multiq(Tensor q, Tensor k, Tensor v, Tensor!? out, "
+      "Tensor cu_seqlens_q, Tensor seqused_k, Tensor block_table, "
+      "int max_seqlen_q, int max_seqlen_k, Tensor? k_scale, Tensor? v_scale, "
+      "float softmax_scale, int? num_splits, int? v_tile) -> Tensor");
+  xpu_ops.impl("paged_decode_multiq", torch::kXPU, &paged_decode_multiq);
+#endif
 }
 
 REGISTER_EXTENSION(TORCH_EXTENSION_NAME)
