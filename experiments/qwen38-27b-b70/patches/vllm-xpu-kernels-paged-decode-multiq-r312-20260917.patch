+  list(LENGTH MULTIQ_POLICY_PAIRS _num_pairs)
+  math(EXPR _last_idx "${_num_pairs} - 1")
+  set(_idx 0)
+  foreach(_pair ${MULTIQ_POLICY_PAIRS})
+    string(REPLACE "|" ";" _pair_parts "${_pair}")
+    list(GET _pair_parts 0 _pol)
+    list(GET _pair_parts 1 _vt)
+    if(_idx EQUAL _last_idx)
+      set(MULTIQ_POLICY_LIST_ENTRIES
+          "${MULTIQ_POLICY_LIST_ENTRIES}  X(${_pol}, ${_vt})\n")
+    else()
+      set(MULTIQ_POLICY_LIST_ENTRIES
+          "${MULTIQ_POLICY_LIST_ENTRIES}  X(${_pol}, ${_vt}) \\\n")
+    endif()
+    math(EXPR _idx "${_idx} + 1")
+  endforeach()
