+++ b/csrc/xpu/attn_multiq/xe_2/CMakeLists.txt
@@ -0,0 +1,19 @@
+cmake_minimum_required(VERSION 3.18)
+
+# Multi-query (speculative-decoding verification) decode kernels.
+#
+# Deliberately a separate device library from attn_kernels_xe_2: the upstream
+# flash-attention extension and its kernel library ship prebuilt and must not be
+# rebuilt, because that would change the rounding of published reference
+# outputs. Nothing here is compiled into that library, and nothing here links
+# against it -- only its headers are reused.
+set(ATTN_KERNEL_SRCS_GEN) # output of the generator below
+
+include("paged_decode_multiq_configure.cmake")
+paged_decode_multiq_configure(paged_decode_multiq_kernel_template)
+
+add_xe2_kernel_library(attn_multiq_kernels_xe_2 INCLUDE_CMAKE_SOURCE_DIR)
+
+# The upstream decode headers include their collectives as "./collective/..." relative to csrc/xpu/attn/xe_2, which
+# the upstream library has on its include path; give this library the same root.
+target_include_directories(attn_multiq_kernels_xe_2 PRIVATE ${CMAKE_SOURCE_DIR}/csrc/xpu/attn/xe_2)
diff --git a/csrc/xpu/attn_multiq/xe_2/collective/decode_multiq_mainloop.hpp b/csrc/xpu/attn_multiq/xe_2/collective/decode_multiq_mainloop.hpp
new file mode 100644
index 0000000..6f72fc0
--- /dev/null
+++ b/csrc/xpu/attn_multiq/xe_2/collective/decode_multiq_mainloop.hpp
@@ -0,0 +1,489 @@
+/***************************************************************************************************
+ * Copyright (C) 2025 Intel Corporation, All rights reserved.
+ * SPDX-License-Identifier: BSD-3-Clause
+ **************************************************************************************************/
+
+#pragma once
+
+#include "csrc/xpu/attn/xe_2/collective/chunk_prefill_mainloop.hpp"
+
+namespace cutlass::fmha::collective {
+
+using namespace cute;
+
+// Maximum number of query positions one multi-query decode call can verify in
+// a single pass over the KV cache. Every position keeps its own O accumulator
+// (FragA), softmax max/sum rows and S/P fragments, so this bounds the register
+// footprint; the host API rejects larger q_len.
+static constexpr int kDecodeMultiQMaxLen = 8;
+
+/////////////////////////////////////////////////////////////////////////////////////////////////
+//
+// Multi-query decode mainloop ("design c").
+//
+// This is DecodeFwdMainloop::operator() with a loop over `q_len` query
+// positions of ONE sequence placed *inside* the K loop. The KV tiles are
+// loaded once and reused by every position; each position keeps its own
+// - Q tile (the same 8-row head-group tile, shifted by j * q_stride_seq),
+// - S accumulator / P fragment,
+// - softmax max/sum rows and O accumulator,
+// - last-tile column mask limit L_j = seq_len_kv - (q_len - 1 - j).
+//
+// Everything else (tile shapes, fragment layouts, GEMM loop bounds, softmax,
+// the paged-KV tile walk, the surface split) is byte-for-byte the single
+// position code, so each position produces the same instruction sequence -- and
+// therefore bit-identical results -- as the single-position decode path called
+// with seqused_k = L_j. Two host-side preconditions make that exact:
+//   * (seq_len_kv - 1) % kv_tile >= q_len - 1, so every position's last KV
+//     position lives in the same KV tile and all positions share one tile
+//     count / split plan;
+//   * num_splits is computed as the single-position reference computes it.
+//
+// Causal/local masking is not supported here: the per-position limits *are*
+// the causal mask for spec-decode verification.
+//
+/////////////////////////////////////////////////////////////////////////////////////////////////
+// MaxQLen is specified explicitly (not deduced from the accumulator arrays)
+// so the array bounds are only ever checked, never inferred.
+template <bool has_large_surface, int MaxQLen, class Mainloop, class QVCoord>
+CUTLASS_DEVICE void decode_multiq_mainloop(
+    Mainloop& mainloop,
+    typename Mainloop::TensorQ2D const& Q_2D,   // (q,d), position 0
+    typename Mainloop::TensorK2D const& K_2D,   // (k,d)
+    typename Mainloop::TensorV2D const& V_2D,   // (d,k)
+    typename Mainloop::FragA (&tArA)[MaxQLen],  // Output accumulators (q,v)
+    typename Mainloop::FragARow (&tA_max)[MaxQLen],  // Softmax row-wise maxima
+    typename Mainloop::FragARow (&tA_sum)[MaxQLen],  // Softmax row-wise sums
+    QVCoord blk_qv,                                  // WG tile indices: (Q,V)
+    int const& idx_b,                                // WG tile indices: (B)
+    int blk_k0,                                      // K block range: [K0,K1)
+    int blk_k1,
+    int thr_id,
+    int seq_len,         // largest per-position limit (= seqused_k of this seq)
+    int q_len,           // number of query positions, 2..MaxQLen
+    int q_stride_seq) {  // element distance between consecutive Q positions
+  using namespace sycl::ext::oneapi::this_work_item;
+
+  using TileShapeQK = typename Mainloop::TileShapeQK;
+  using TileShapePV = typename Mainloop::TileShapePV;
+  using TiledMMAQK = typename Mainloop::TiledMMAQK;
+  using TiledMMAPV = typename Mainloop::TiledMMAPV;
+  using TiledCopyQ = typename Mainloop::TiledCopyQ;
+  using TiledCopyK = typename Mainloop::TiledCopyK;
+  using TiledCopyV = typename Mainloop::TiledCopyV;
+  using SGPerWG = typename Mainloop::SGPerWG;
+  using FragS = typename Mainloop::FragS;
+  using FragSCol = typename Mainloop::FragSCol;
+  using ElementS = typename Mainloop::ElementS;
+  using ElementA = typename Mainloop::ElementA;
+
+  constexpr int VTiles = Mainloop::VTiles;
+  constexpr bool PagedKV = Mainloop::PagedKV;
+  constexpr bool Fp8KV = Mainloop::Fp8KV;
+
+  static_assert(
+      !Mainloop::LocalMask,
+      "multi-query decode does not support sliding-window masking");
+  static_assert(
+      !Mainloop::CausalMask,
+      "multi-query decode handles causality through per-position limits");
+
+  auto const& params = mainloop.params;
+
+  // Short dimension names:
+  //    q = sequence len dimension for Q
+  //    k = sequence len dimension for K
+  //    d = head size dimension for K/Q
+  //    v = head size dimension for V
+  //   VV = MMA tile indices for V
+  //    j = query position within the verified window
+  // Capital letters (Q, K, ...) refer to WG block indices.
+  // Primed letters (q', k', ...) refer to atom block indices.
+
+  auto tile_shape_v =
+      make_shape(get<1>(TileShapePV{}) * C<VTiles>{}, get<2>(TileShapePV{}));
+
+  /* Create proxy coordinate tensors for Q/K/P/V */
+  Tensor cQ = make_identity_tensor(Q_2D.shape());               // (q,d)
+  Tensor cK = make_identity_tensor(K_2D.shape());               // (k,d)
+  Tensor cV = make_identity_tensor(V_2D.shape());               // (v,k)
+  Tensor cP = make_identity_tensor(take<0, 2>(TileShapeQK{}));  // (q,k)
+
+  auto K_2D_0 = K_2D;
+  auto V_2D_0 = V_2D;
+
+  // --- Xe 2D-block surface-height split (see DecodeFwdMainloop::operator()
+  // for the full explanation; this block is an unmodified copy).
+  constexpr int tile_k = get<1>(TileShapeQK{});
+  [[maybe_unused]] int tiles_per_surface = 0x3fffffff;
+  [[maybe_unused]] int rows_per_surface = 0;
+  [[maybe_unused]] int k_rows_total = get<0>(K_2D.shape());
+  [[maybe_unused]] int v_cols_total = get<1>(V_2D.shape());
+  [[maybe_unused]] int64_t k_surf_shift = 0;
+  [[maybe_unused]] int64_t v_surf_shift = 0;
+  [[maybe_unused]] int k_pre_surf = -1;
+
+  [[maybe_unused]] auto make_k_surface = [&](int surf) {
+    int64_t rem = int64_t(k_rows_total) - int64_t(surf) * rows_per_surface;
+    int rows = rem > rows_per_surface ? rows_per_surface : int(rem);
+    if (rows < 1) {
+      rows = 1;
+    }
+    return make_tensor(
+        K_2D.data() + int64_t(surf) * k_surf_shift,
+        make_layout(make_shape(rows, get<1>(K_2D.shape())), K_2D.stride()));
+  };
+  [[maybe_unused]] auto make_v_surface = [&](int surf) {
+    int64_t rem = int64_t(v_cols_total) - int64_t(surf) * rows_per_surface;
+    int cols = rem > rows_per_surface ? rows_per_surface : int(rem);
+    if (cols < 1) {
+      cols = 1;
+    }
+    return make_tensor(
+        V_2D.data() + int64_t(surf) * v_surf_shift,
+        make_layout(make_shape(get<0>(V_2D.shape()), cols), V_2D.stride()));
+  };
+
+  if constexpr (has_large_surface) {
+    constexpr int kXeMaxSurfaceRows = 1 << 24;
+    if constexpr (PagedKV) {
+      int page_stride_tiles = params.page_stride_elements / tile_k;
+      int blocks_per_surface = kXeMaxSurfaceRows / params.page_stride_elements;
+      if (blocks_per_surface < 1) {
+        blocks_per_surface = 1;
+      }
+      tiles_per_surface = blocks_per_surface * page_stride_tiles;
+      rows_per_surface = tiles_per_surface * tile_k;
+    }
+
+    int k_rows0, v_cols0;
+    if constexpr (PagedKV) {
+      k_rows0 =
+          k_rows_total < rows_per_surface ? k_rows_total : rows_per_surface;
+      k_surf_shift = int64_t(rows_per_surface) * get<0>(K_2D.stride());
+      v_cols0 =
+          v_cols_total < rows_per_surface ? v_cols_total : rows_per_surface;
+      v_surf_shift = int64_t(rows_per_surface) * get<1>(V_2D.stride());
+    } else {
+      k_rows0 = k_rows_total;
+      v_cols0 = v_cols_total;
+    }
+
+    K_2D_0 = make_tensor(
+        K_2D.data(),
+        make_layout(make_shape(k_rows0, get<1>(K_2D.shape())), K_2D.stride()));
+    V_2D_0 = make_tensor(
+        V_2D.data(),
+        make_layout(make_shape(get<0>(V_2D.shape()), v_cols0), V_2D.stride()));
+
+    cK = make_identity_tensor(make_shape(
+        PagedKV ? rows_per_surface : k_rows_total,
+        get<1>(K_2D.shape())));  // (k,d)
+    cV = make_identity_tensor(make_shape(
+        get<0>(V_2D.shape()),
+        PagedKV ? rows_per_surface : v_cols_total));  // (v,k)
+  }
+
+  /* Partition global tensors into workgroup tiles */
+  Tensor gQ = local_tile(
+      cQ, TileShapeQK{}, append(blk_qv, _), Step<_1, X, _1>{});  // (q,d,D)
+  Tensor gK = local_tile(
+      cK, TileShapeQK{}, make_coord(_, _, _), Step<X, _1, _1>{});  // (k,d,K,D)
+  Tensor gV =
+      local_tile(cV, tile_shape_v, make_coord(get<1>(blk_qv), _));  // (v,k,K)
+  Tensor gV_split = local_tile(
+      gV, TileShapePV{}, make_coord(_, _, 0), Step<X, _1, _1>{});  // (v,k,VV,K)
+
+  // Q tensor for query position j: the head-group tile is the same, shifted
+  // by one token. The coordinate partitions below are identical for every
+  // position (they are built from the identity tensor cQ), so only the copy
+  // object -- i.e. the 2D block descriptor's base address -- differs.
+  auto make_q_2d = [&](int j) {
+    return make_tensor(Q_2D.data() + j * q_stride_seq, Q_2D.layout());
+  };
+
+  /* Create global -> register copies */
+  TiledCopyQ copy_q{Q_2D};
+  TiledCopyK copy_k{K_2D_0};
+  TiledCopyV copy_v{V_2D_0};
+
+  /* Create MMAs */
+  TiledMMAQK mma_qk{};
+  TiledMMAPV mma_pv{};
+
+  /* Slice TiledCopy/TiledMMA operations down to to work-item level */
+  auto thr_copy_q = copy_q.get_slice(thr_id);
+  auto thr_copy_k = copy_k.get_slice(thr_id);
+  auto thr_copy_v = copy_v.get_slice(thr_id);
+  auto thr_mma_qk = mma_qk.get_slice(thr_id);
+  auto thr_mma_pv = mma_pv.get_slice(thr_id);
+
+  /* Partition coordinate tensors for copy */
+  auto tQgQ = thr_copy_q.partition_S(gQ);        // (atom_val,q',d',D)
+  auto tKgK = thr_copy_k.partition_S(gK);        // (atom_val,k',d',K,D)
+  auto tVgV = thr_copy_v.partition_S(gV_split);  // (atom_val,v',k',VV,K)
+
+  /* Create register fragments for MMA and copies */
+  auto tQrQ = thr_copy_q.partition_sg_fragment_D(gQ(_, _, 0));
+  auto tSrQ = thr_mma_qk.partition_sg_fragment_A(gQ(_, _, 0));
+
+  auto tKrK = thr_copy_k.partition_sg_fragment_D(gK(_, _, 0, 0));
+  auto tSrK = thr_mma_qk.partition_sg_fragment_B(gK(_, _, 0, 0));
+
+  auto tVrV = thr_copy_v.partition_sg_fragment_D(gV_split(_, _, 0, 0));
+  auto tArV = thr_mma_pv.partition_sg_fragment_B(gV_split(_, _, 0, 0));
+
+  /* Per-position S accumulators and P fragments. Only these, tArA, tA_max and
+     tA_sum are replicated; K/V fragments are shared by all positions. */
+  using FragP = decltype(thr_mma_pv.partition_sg_fragment_A(cP));
+  FragS tSrS[MaxQLen];
+  FragP tArP[MaxQLen];
+
+  /* Create TiledCopy objects for prefetches */
+  auto prefetch_k = make_block_2d_prefetch(copy_k);
+  auto prefetch_v =
+      make_block_2d_prefetch<SGPerWG::value>(tile_shape_v, V_2D_0);
+
+  /* Partition global tensors for prefetch */
+  auto pKgK = prefetch_k.get_slice(thr_id).partition_S(gK);
+  auto pVgV = prefetch_v.get_slice(thr_id).partition_S(gV);
+
+  // ------
+  // Kernel
+  // ------
+
+  // PagedKV
+  int tiles_per_page = params.page_size / get<1>(TileShapeQK{});
+  int page_stride_tiles = params.page_stride_elements / get<1>(TileShapeQK{});
+  int tile_idx = blk_k0;
+  int b_offset = idx_b * params.max_pages_per_seq;
+  if constexpr (PagedKV) {
+    int page_local_idx = tile_idx * get<1>(TileShapeQK{}) / params.page_size;
+    int block_idx = params.ptr_page_table[b_offset + page_local_idx];
+    tile_idx = block_idx * page_stride_tiles + tile_idx % tiles_per_page;
+  }
+
+  /* Initialization steps for first block: Q/K prefetch, O init */
+  CUTLASS_PRAGMA_UNROLL
+  for (int j = 0; j < MaxQLen; j++) {
+    if (j < q_len) {
+      TiledCopyQ copy_q_j{make_q_2d(j)};
+      auto prefetch_q_j = make_block_2d_prefetch(copy_q_j);
+      auto pQgQ_j = prefetch_q_j.get_slice(thr_id).partition_S(gQ);
+      for (int D = 0; D < size<3>(pQgQ_j); D++) {
+        prefetch(prefetch_q_j, pQgQ_j(_, _, _, D));
+      }
+    }
+  }
+
+  [[maybe_unused]] auto update_surface_info = [&](int& next_page_idx) {
+    // Route the current physical tile to its sub-surface (see split above).
+    int k_surf = PagedKV ? next_page_idx / tiles_per_surface : 0;
+    next_page_idx = next_page_idx - k_surf * tiles_per_surface;
+
+    if (k_pre_surf != k_surf) {
+      k_pre_surf = k_surf;
+
+      auto K_2D_n = make_k_surface(k_surf);
+      auto V_2D_n = make_v_surface(k_surf);
+
+      copy_k = TiledCopyK{K_2D_n};
+      copy_v = TiledCopyV{V_2D_n};
+
+      auto thr_copy_k_n = copy_k.get_slice(thr_id);
+      auto thr_copy_v_n = copy_v.get_slice(thr_id);
+
+      prefetch_k = make_block_2d_prefetch(copy_k);
+      prefetch_v = make_block_2d_prefetch<SGPerWG::value>(tile_shape_v, V_2D_n);
+
+      Tensor cK_n = make_identity_tensor(K_2D_n.shape());  // (k,d)
+      Tensor cV_n = make_identity_tensor(V_2D_n.shape());  // (v,k)
+
+      Tensor gK_n = local_tile(
+          cK_n,
+          TileShapeQK{},
+          make_coord(_, _, _),
+          Step<X, _1, _1>{});  // (k,d,K,D)
+      Tensor gV_n = local_tile(
+          cV_n, tile_shape_v, make_coord(get<1>(blk_qv), _));  // (v,k,K)
+      Tensor gV_split_n = local_tile(
+          gV_n,
+          TileShapePV{},
+          make_coord(_, _, 0),
+          Step<X, _1, _1>{});  // (v,k,VV,K)
+
+      tKgK = thr_copy_k_n.partition_S(gK_n);        // (atom_val,k',d',K,D)
+      tVgV = thr_copy_v_n.partition_S(gV_split_n);  // (atom_val,v',k',VV,K)
+
+      pKgK = prefetch_k.get_slice(thr_id).partition_S(gK_n);
+      pVgV = prefetch_v.get_slice(thr_id).partition_S(gV_n);
+    }
+  };
+
+  if constexpr (has_large_surface) {
+    update_surface_info(tile_idx);
+  }
+
+  for (int D = 0; D < size<4>(pKgK); D++) {
+    prefetch(prefetch_k, pKgK(_, _, _, tile_idx, D));
+  }
+
+  CUTLASS_PRAGMA_UNROLL
+  for (int j = 0; j < MaxQLen; j++) {
+    if (j < q_len) {
+      clear(tArA[j]);
+      fill(tA_max[j], cutlass::platform::numeric_limits<ElementA>::lowest());
+      clear(tA_sum[j]);
+    }
+  }
+
+  // FP8 KV Scale (per-tensor): identical to the single-position path.
+  ElementS effective_scale = params.scale;
+  float scale_v = 1.f;
+  if constexpr (Fp8KV) {
+    const float scale_k = *static_cast<const float*>(params.scale_k);
+    scale_v = *static_cast<const float*>(params.scale_v);
+    effective_scale = params.scale * ElementS(scale_k);
+  }
+
+  /* Main loop, blocked in k. K/V tiles are loaded once per block and reused
+     by every query position. */
+  int next_tile_idx;
+  for (int K = blk_k0; K < blk_k1; K++) {
+    auto tKgK_cache =
+        PagedKV ? tKgK(_, _, _, tile_idx, _) : tKgK(_, _, _, K, _);
+    auto tVgV_cache =
+        PagedKV ? tVgV(_, _, _, _, tile_idx) : tVgV(_, _, _, _, K);
+
+    /* GEMM 1: S = K * Q, once per position against the same K fragment */
+    CUTLASS_PRAGMA_UNROLL
+    for (int j = 0; j < MaxQLen; j++) {
+      if (j < q_len) clear(tSrS[j]);
+    }
+    for (int D = 0; D < size<4>(tKgK); D++) {
+      copy(copy_k, tKgK_cache(_, _, _, D), tKrK);
+      // reorder() performs the (vectorized) fp8 -> ElementQ cast; the
+      // per-tensor scale_k has been folded into effective_scale above.
+      reorder(tKrK, tSrK);
+
+      CUTLASS_PRAGMA_UNROLL
+      for (int j = 0; j < MaxQLen; j++) {
+        if (j < q_len) {
+          TiledCopyQ copy_q_j{make_q_2d(j)};
+          copy(copy_q_j, tQgQ(_, _, _, D), tQrQ);
+          reorder(tQrQ, tSrQ);
+          cute::gemm(mma_qk, tSrQ, tSrK, tSrS[j]);
+        }
+      }
+    }
+
+    /* V prefetch for GEMM 2 */
+    prefetch(prefetch_v, pVgV(_, _, _, tile_idx));
+
+    /* k masking for remainder tiles, per position.
+       Position j attends to [0, L_j) with L_j = seq_len - (q_len - 1 - j);
+       the reference single-position call masks with seq_len = L_j and only
+       builds the mask when L_j is not a whole number of KV tiles, so both
+       the limit and the "is there a remainder" test are per position.
+       Masked lanes get -INF and kept lanes NaN: fmin(x, NaN) == x, which is
+       why applying the mask on a non-final tile (middle splits) is a no-op.
+     */
+    if (K == blk_k1 - 1) {
+      int k0 = get<0>(tKgK(0, 0, 0, K, 0)) + get_sub_group().get_local_id()[0];
+      CUTLASS_PRAGMA_UNROLL
+      for (int j = 0; j < MaxQLen; j++) {
+        if (j < q_len) {
+          int seq_len_j = seq_len - (q_len - 1 - j);
+          if (seq_len_j % get<1>(TileShapeQK{}) != 0) {
+            FragSCol k_rem_mask;
+            int k = k0;
+            CUTLASS_PRAGMA_UNROLL
+            for (int i = 0; i < k_rem_mask.size(); i++, k += intel::sg_size) {
+              k_rem_mask(i) = (k < seq_len_j) ? ElementS(sycl::nan(0u))
+                                              : ElementS(-INFINITY);
+            }
+            CUTLASS_PRAGMA_UNROLL
+            for (int i = 0; i < tSrS[j].size(); i++) {
+              tSrS[j](i) =
+                  sycl::fmin(tSrS[j](i), broadcast<1>(k_rem_mask, tSrS[j], i));
+            }
+          }
+        }
+      }
+    }
+
+    /* Apply softmax and scaling, per position */
+    CUTLASS_PRAGMA_UNROLL
+    for (int j = 0; j < MaxQLen; j++) {
+      if (j < q_len) {
+        mainloop.softmax(
+            effective_scale,
+            K == blk_k0,
+            tSrS[j],
+            tA_max[j],
+            tA_sum[j],
+            tArA[j]);
+        reorder(tSrS[j], tArP[j]);
+      }
+    }
+
+    /* GEMM 2: A += P * V, split in v dimension; the V fragment is loaded once
+       and reused by every position. */
+    CUTLASS_PRAGMA_UNROLL
+    for (int VV = 0; VV < VTiles; VV++) {
+      copy(copy_v, tVgV_cache(_, _, _, VV), tVrV);
+      // reorder() performs the (vectorized) fp8 -> ElementQ cast; the
+      // per-tensor scale_v is applied once after the K loop below.
+      reorder(tVrV, tArV);
+      CUTLASS_PRAGMA_UNROLL
+      for (int j = 0; j < MaxQLen; j++) {
+        if (j < q_len) {
+          cute::gemm(mma_pv, tArP[j], tArV, tArA[j](_, _, _, VV));
+        }
+      }
+    }
+
+    barrier();
+
+    // next tile_idx
+    next_tile_idx = K + 1;
+    if constexpr (PagedKV) {
+      int next_page_local_idx =
+          next_tile_idx * get<1>(TileShapeQK{}) / params.page_size;
+      if (next_page_local_idx < params.max_pages_per_seq) {
+        int next_block_idx =
+            params.ptr_page_table[b_offset + next_page_local_idx];
+        next_tile_idx =
+            next_block_idx * page_stride_tiles + next_tile_idx % tiles_per_page;
+      } else {
+        // set to last page
+        next_tile_idx = params.max_pages_per_seq * tiles_per_page - 1;
+      }
+    }
+    tile_idx = next_tile_idx;
+
+    if constexpr (has_large_surface) {
+      update_surface_info(tile_idx);
+    }
+
+    /* K prefetch */
+    for (int D = 0; D < size<4>(pKgK); D++) {
+      prefetch(prefetch_k, pKgK(_, _, _, tile_idx, D));
+    }
+  }
+
+  // Apply the per-tensor V scale once after the K loop.
+  if constexpr (Fp8KV) {
+    CUTLASS_PRAGMA_UNROLL
+    for (int j = 0; j < MaxQLen; j++) {
+      if (j < q_len) {
+        CUTLASS_PRAGMA_UNROLL
+        for (int i = 0; i < tArA[j].size(); ++i) {
+          tArA[j](i) *= ElementA(scale_v);
+        }
+      }
+    }
+  }
+}
+
+}  // namespace cutlass::fmha::collective
