+    const torch::Tensor& A_log,
+    const torch::Tensor& dt_bias,
+    torch::Tensor& ssm_state,
+    const torch::Tensor& non_spec_query_start_loc,
+    const torch::Tensor& non_spec_state_indices_tensor,
+    const torch::Tensor& commit_num_accepted,
+    const std::optional<torch::Tensor>& commit_mask,
+    const int64_t tp_size,
+    const torch::Tensor& stash,
+    const torch::Tensor& stash_meta,
+    const int64_t stash_rows) {
+  const int64_t rows = non_spec_state_indices_tensor.size(0);
+  TORCH_CHECK(rows > 0);
+  TORCH_CHECK(non_spec_state_indices_tensor.dim() == 1);
+  TORCH_CHECK(
+      non_spec_state_indices_tensor.is_contiguous() &&
+      non_spec_state_indices_tensor.dtype() == torch::kInt32);
+  TORCH_CHECK(
