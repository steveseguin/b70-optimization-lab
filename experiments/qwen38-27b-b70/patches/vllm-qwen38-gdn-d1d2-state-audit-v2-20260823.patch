+def _gdn_state_slot_trace(record: dict) -> None:
+    """Write state indices produced by the GDN metadata builder."""
+    global _GDN_STATE_SLOT_TRACE_LINES
+    enabled = os.environ.get(
+        "VLLM_XPU_GDN_STATE_SLOT_TRACE", "0").strip().lower()
+    path = os.environ.get("VLLM_XPU_GDN_STATE_SLOT_TRACE_FILE")
+    if enabled not in ("1", "true", "yes", "on") or not path:
+        return
+    try:
+        max_lines = int(
+            os.environ.get("VLLM_XPU_GDN_STATE_SLOT_TRACE_MAX_LINES", "20000")
+            or "20000")
+    except ValueError:
+        max_lines = 20000
+    if max_lines > 0 and _GDN_STATE_SLOT_TRACE_LINES >= max_lines:
+        return
+    try:
+        from vllm.distributed import get_tensor_model_parallel_rank
+
+        rank = get_tensor_model_parallel_rank()
+    except Exception:
+        rank = int(os.environ.get("RANK", "0") or "0")
+    record.setdefault("event", "metadata_build")
+    record.setdefault("tp_rank", rank)
+    record.setdefault("ts", time.time())
+    record.setdefault("pid", os.getpid())
+    try:
+        trace_dir = os.path.dirname(path)
+        if trace_dir:
+            os.makedirs(trace_dir, exist_ok=True)
+        with open(path, "a", encoding="utf-8") as handle:
+            handle.write(json.dumps(record, sort_keys=True) + "\n")
+        _GDN_STATE_SLOT_TRACE_LINES += 1
+    except Exception:
+        # Report-only: tracing must not affect metadata construction.
+        return
