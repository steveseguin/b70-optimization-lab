+def _gdn_state_slot_trace_enabled() -> bool:
+    return os.environ.get("VLLM_XPU_GDN_STATE_SLOT_TRACE", "0").strip().lower() in (
+        "1",
+        "true",
+        "yes",
+        "on",
+    ) and bool(os.environ.get("VLLM_XPU_GDN_STATE_SLOT_TRACE_FILE"))
