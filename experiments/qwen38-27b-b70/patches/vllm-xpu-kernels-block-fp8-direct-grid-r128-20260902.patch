+          auto tile_coord = make_coord(m_coord, n_coord, _, 0);
+
+          xe_gemm_4bits<
+              GmemTiledCopyA,
+              GmemTiledCopyB,
+              GmemTiledCopyD,
+              B_DTYPE::BLOCK_FP8,
+              128>(
+              A_tensor,
+              B_tensor,
+              scales,
+              static_cast<const half_t*>(nullptr),
+              D_tensor,
+              tile_coord,
+              mma);
+        });
+  });
+}
