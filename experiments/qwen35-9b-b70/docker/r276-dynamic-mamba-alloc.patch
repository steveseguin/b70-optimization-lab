+    def _allocation_lookahead_tokens(self, scheduled_reqs: int) -> int:
+        """Reserve the largest K still possible for this FCFS batch."""
+        if self.dynamic_sd_lookup is None or self.policy != SchedulingPolicy.FCFS:
+            return self.num_lookahead_tokens
+
+        first_possible_batch = min(
+            scheduled_reqs + 1, self.scheduler_config.max_num_seqs
+        )
+        return max(self.dynamic_sd_lookup[first_possible_batch:])
+
