+        module.checkpoint_geometry=lambda path:{'construction_overlap_bytes':mem.CHECKPOINT_TENSOR_BYTES+mem.REGISTERED_STATE_BYTES}
+        def admission(stage,allocation):
+            self.memory_events.append((stage,allocation))
