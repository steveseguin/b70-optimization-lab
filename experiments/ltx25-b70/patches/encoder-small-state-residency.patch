+    def _ltx_small_state(self):
+        # Opt-in, static Gemma4 encoder only. Preserve registered owners/keys.
+        if not self.model_options.get("ltx_small_state_residency", False):
+            if getattr(self.model, "_ltx_small_buffers_loaded", False):
+                raise RuntimeError("Detach before disabling LTX small-state residency")
+            return set(), []
+        if self.is_dynamic():
+            raise RuntimeError("LTX small-state candidate requires static ModelPatcher")
+        if (self.patches or self.weight_wrapper_patches or self.forced_hooks
+                or self.hook_patches or self.object_patches):
+            raise RuntimeError("LTX small-state candidate does not support weight patches/hooks")
+        norms = set()
+        buffers = []
+        for name, module in self.model.named_modules():
+            kind = type(module)
+            if kind.__module__ == "comfy.text_encoders.llama" and kind.__name__ == "RMSNorm":
+                if (list(dict(module.named_parameters(recurse=False))) != ["weight"]
+                        or module.weight.dtype != torch.bfloat16):
+                    raise RuntimeError("Unexpected RMSNorm state")
+                norms.add(name)
+            if kind.__module__ == "comfy.text_encoders.gemma4" and kind.__name__ == "TransformerBlockGemma4":
+                value = module._buffers.get("layer_scalar")
+                if value is None or value.shape != (1,) or value.dtype != torch.bfloat16:
+                    raise RuntimeError("Unexpected Gemma4 layer_scalar state")
+                buffers.append((module, "layer_scalar"))
+        if not norms or not buffers:
+            raise RuntimeError("LTX small-state candidate requires Gemma4 RMSNorms and scalars")
+        return norms, buffers
+
