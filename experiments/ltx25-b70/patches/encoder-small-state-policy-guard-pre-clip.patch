+    def _ltx_guard_small_state_policy(self):
+        enabled = bool(self.model_options.get("ltx_small_state_residency", False))
+        previous = bool(getattr(self.model, "_ltx_small_state_policy", False))
+        if enabled != previous:
+            # Model-owned state is shared by clones; their option dicts are not.
+            allocated = (self.model.model_loaded_weight_memory > 0
+                         or getattr(self.model, "_ltx_small_buffers_loaded", False)
+                         or any(getattr(m, "comfy_patched_weights", False) for m in self.model.modules()))
+            if allocated:
+                raise RuntimeError("Detach before changing LTX small-state residency policy")
+        return enabled
