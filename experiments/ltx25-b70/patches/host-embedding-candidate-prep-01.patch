--- /dev/null
+++ b/scripts/ltx_host_embedding_candidate.py
@@ -0,0 +1,193 @@
+"""Inactive CPU-owned embedding gather candidate; no installer or runtime node.
+
+Call only on a newly constructed, fully CPU/offloaded static CLIP patcher.
+The returned owner must remain part of the resident component set. Integration
+must expose both patchers and restore the owner before serialization/reloading.
+No automatic deployment, memory-budget override, or model/output cache.
+"""
+import inspect
+import weakref
+
+import torch
+from torch import nn
+from comfy.model_patcher import ModelPatcher
+from comfy.patcher_extension import CallbacksMP
+
+
+def require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def unmodified(patcher):
+    require(not patcher.is_dynamic(), 'Static patcher required')
+    require(not any((patcher.patches, patcher.weight_wrapper_patches,
+                     patcher.hook_patches, patcher.forced_hooks, patcher.backup,
+                     patcher.hook_backup, patcher.current_hooks, patcher.injections)),
+            'Weight modifications/hooks are unsupported')
+    require(not any(value for groups in patcher.wrappers.values() for value in groups.values()),
+            'Execution wrappers are unsupported')
+    require(not patcher.model_options.get('ltx_small_state_residency', False),
+            'Do not combine with the prior small-state policy')
+    require(not patcher.object_patches or (patcher.is_clip and
+            patcher.object_patches == {'manual_cast_dtype': torch.float32}),
+            'Unexpected object patches')
+
+
+class GatherDelegate(nn.Module):
+    """No registered parameters: the separately exposed CPU patcher owns them."""
+    def __init__(self, owner):
+        super().__init__()
+        # Owner is not an nn.Module; no second registration of the table.
+        self.owner = owner
+
+    @property
+    def weight(self):
+        return self.owner.host.model.weight
+
+    def forward(self, input_ids, out_dtype=None):
+        owner = self.owner
+        owner.guard(require_resident=True)
+        require(input_ids.device == owner.execution_device, 'Changed embedding execution device')
+        require(input_ids.dtype == torch.long and input_ids.ndim == 2,
+                'Expected batched int64 token IDs')
+        require(out_dtype == torch.float32, 'Only original LTX F32 embedding output is supported')
+        # Original ops.Embedding gathers BF16, converts to requested dtype,
+        # then the ScaledEmbedding wrapper multiplies by sqrt(hidden_size).
+        # Only the bit-preserving row gather moves to CPU. Conversion and
+        # multiplication remain separate operations on the original device.
+        indices = input_ids.to(device='cpu')
+        source = owner.host.model
+        rows = torch.nn.functional.embedding(indices, source.weight,
+            source.padding_idx, source.max_norm, source.norm_type,
+            source.scale_grad_by_freq, source.sparse)
+        return rows.to(device=input_ids.device).to(dtype=out_dtype) * owner.scale
+
+
+class HostEmbeddingOwner:
+    CALLBACK_KEY = 'ltx-host-embedding-candidate-v1'
+
+    def __init__(self, patcher, parent, key='embed_tokens'):
+        unmodified(patcher)
+        require(patcher.loaded_size() == 0, 'Detach before creating CPU embedding ownership')
+        require(not any(getattr(m, 'comfy_patched_weights', False) for m in patcher.model.modules()),
+                'Previously loaded modules require complete detach')
+        require(all(p.device.type == 'cpu' for p in patcher.model.parameters()),
+                'All original parameters must already be on CPU')
+        source = parent._modules.get(key)
+        require(source is not None and type(source).__qualname__ == '_make_scaled_embedding.<locals>.ScaledEmbedding',
+                'Expected original scaled embedding class')
+        require(list(source._parameters) == ['weight'] and not source._buffers,
+                'Unexpected embedding state')
+        require(type(source.weight) is nn.Parameter and source.weight.dtype == torch.bfloat16,
+                'Expected plain BF16 embedding weight')
+        require(not source.weight.requires_grad and not source.training,
+                'Inference-only embedding required')
+        require(source.padding_idx is None and source.max_norm is None
+                and source.norm_type == 2.0 and not source.scale_grad_by_freq and not source.sparse,
+                'Unsupported mutating/alternate embedding options')
+        require(not source.weight_function and not source.bias_function
+                and not source._forward_hooks and not source._forward_pre_hooks,
+                'Embedding hooks and weight functions are unsupported')
+        require(sum(p is source.weight for _, p in patcher.model.named_parameters(remove_duplicate=False)) == 1,
+                'Tied/shared embedding registrations are unsupported')
+        scale = inspect.getclosurevars(type(source).forward).nonlocals.get('scale')
+        require(scale == source.embedding_dim ** .5, 'Unexpected embedding scale')
+        self.original_size = patcher.model_size()
+        self.host_bytes = source.weight.nbytes
+        self.execution_device = patcher.load_device
+        self.parent, self.key, self.scale = parent, key, scale
+        self.embedding_options = (source.padding_idx, source.max_norm, source.norm_type,
+                                  source.scale_grad_by_freq, source.sparse)
+        self.host = ModelPatcher(source, torch.device('cpu'), torch.device('cpu'))
+        self.weight = source.weight
+        self.weight_identity = (id(self.weight), self.weight.data_ptr(), self.weight._version,
+                                tuple(self.weight.shape), self.weight.dtype)
+        self.active = True
+        self.patchers = []
+        self.delegate = GatherDelegate(self)
+        parent._modules[key] = self.delegate
+        patcher.size = 0
+        require(patcher.model_size() == self.original_size - self.host_bytes,
+                'CPU owner extraction changed unrelated model bytes')
+        self.register(patcher)
+        patcher.add_callback_with_key(CallbacksMP.ON_CLONE, self.CALLBACK_KEY, self.on_clone)
+        patcher.add_callback_with_key(CallbacksMP.ON_LOAD, self.CALLBACK_KEY, self.on_load)
+
+    def register(self, patcher):
+        live = self.live_patchers()
+        require(patcher.model is live[0].model if live else True,
+                'Different model owner is unsupported')
+        require(patcher.load_device == self.execution_device, 'Retargeted clone is unsupported')
+        unmodified(patcher)
+        self.patchers.append(weakref.ref(patcher))
+
+    def on_clone(self, original, clone):
+        self.guard()
+        self.register(clone)
+
+    def on_load(self, patcher, *args):
+        self.guard()
+
+    def live_patchers(self):
+        return [value for ref in self.patchers if (value := ref()) is not None]
+
+    def guard(self, require_resident=False):
+        require(self.active and self.parent._modules.get(self.key) is self.delegate,
+                'CPU gather owner was restored or embedding owner changed')
+        source = self.host.model
+        current = source.weight
+        identity = (id(current), current.data_ptr(), current._version, tuple(current.shape), current.dtype)
+        require(current is self.weight and identity == self.weight_identity
+                and current.device.type == 'cpu', 'CPU table ownership/storage/version changed')
+        require(not current.requires_grad and not source.training and not source._forward_hooks
+                and not source._forward_pre_hooks and not source.weight_function
+                and not source.bias_function and (source.padding_idx, source.max_norm,
+                source.norm_type, source.scale_grad_by_freq, source.sparse) == self.embedding_options,
+                'CPU embedding behavior changed')
+        require(self.host.load_device.type == 'cpu' and self.host.offload_device.type == 'cpu',
+                'CPU owner device changed')
+        unmodified(self.host)
+        patchers = self.live_patchers()
+        require(bool(patchers), 'Encoder owner expired')
+        for patcher in patchers:
+            unmodified(patcher)
+            require(patcher.load_device == self.execution_device and
+                    patcher.model_size() + self.host_bytes == self.original_size,
+                    'Encoder clone device/accounting changed')
+        model = patchers[0].model
+        require(all(p is not current for p in model.parameters()), 'CPU table registered twice')
+        if require_resident:
+            require(all(p.device == self.execution_device for p in model.parameters()),
+                    'Remaining encoder weights are not fully resident; supplied budget is insufficient')
+            require(patchers[0].loaded_size() == patchers[0].model_size(),
+                    'Remaining encoder accounting is not fully loaded')
+
+    def metadata(self):
+        self.guard()
+        patcher = self.live_patchers()[0]
+        return {'schema': 'ltx.host-embedding-ownership.v1',
+                'host_owner_id': id(self.host.model), 'host_weight_id': id(self.weight),
+                'host_device': str(self.weight.device), 'host_dtype': str(self.weight.dtype),
+                'host_registered_bytes': self.host_bytes,
+                'encoder_eligible_bytes': patcher.model_size(),
+                'encoder_reported_loaded_bytes': patcher.loaded_size(),
+                'original_combined_bytes': self.original_size,
+                'execution_device': str(self.execution_device),
+                'clone_count': len(self.live_patchers()), 'native_qualified': False}
+
+    def restore(self):
+        """Call after complete encoder detach, before serialization/reloading."""
+        self.guard()
+        patchers = self.live_patchers()
+        require(all(p.loaded_size() == 0 for p in patchers), 'Detach encoder owners before restoration')
+        require(all(p.device.type == 'cpu' for p in patchers[0].model.parameters()),
+                'Encoder parameters remain on an accelerator')
+        self.host.detach()
+        self.parent._modules[self.key] = self.host.model
+        for patcher in patchers:
+            patcher.remove_callbacks_with_key(CallbacksMP.ON_CLONE, self.CALLBACK_KEY)
+            patcher.remove_callbacks_with_key(CallbacksMP.ON_LOAD, self.CALLBACK_KEY)
+            patcher.size = 0
+            require(patcher.model_size() == self.original_size, 'Restored model bytes changed')
+        self.active = False
