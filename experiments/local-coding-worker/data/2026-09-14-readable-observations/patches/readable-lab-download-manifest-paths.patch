index 000000000..750ea011c
--- /dev/null
+++ "b/tools/test_container_packet_download_paths.py"
@@ -0,0 +1,68 @@
+"""CPU-only regression: download-model.sh must treat manifest paths as data, not code."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+SCRIPT = ROOT / "tools/container-packet/download-model.sh"
+
+
+class DownloadModelPathTest(unittest.TestCase):
+    def run_download(self, manifest_path, dest):
+        with tempfile.TemporaryDirectory() as tmp:
+            commands = Path(tmp) / "commands"
+            commands.mkdir()
+            curl = commands / "curl"
+            curl.write_text(
+                "#!/usr/bin/env python3\n"
+                "import json, os, sys\n"
+                "from pathlib import Path\n"
+                "args = sys.argv[1:]\n"
+                "destination = Path(args[args.index('-o') + 1])\n"
+                "destination.write_bytes(b'{}\\n')\n"
+                "with open(os.environ['CURL_RECEIPT'], 'a') as receipt:\n"
+                "    receipt.write(json.dumps({'url': args[-1], 'destination': str(destination)}) + '\\n')\n"
+            )
+            curl.chmod(0o755)
+            receipt = Path(tmp) / "receipt.jsonl"
+            env = {
+                "PATH": f"{commands}:/usr/local/bin:/usr/bin:/bin",
+                "MODEL_MANIFEST": str(manifest_path),
+                "MODEL_DIR": str(dest),
+                "CURL_RECEIPT": str(receipt),
+                "LANG": "C.UTF-8",
+            }
+            result = subprocess.run(["bash", str(SCRIPT)], env=env, text=True,
+                                    capture_output=True, timeout=15)
+            rows = [json.loads(line) for line in receipt.read_text().splitlines()]
+            return result, rows
+
+    def test_manifest_paths_with_spaces_apostrophes_and_quotes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            for folder in ("ordinary packet", "reader's packet", 'double "quoted" packet'):
+                source = root / folder
+                source.mkdir()
+                manifest = source / "model.json"
+                manifest.write_text(json.dumps({
+                    "repository": "example/model",
+                    "revision": "0123456789abcdef",
+                    "lfs_files": [],
+                    "small_files": [{"path": "nested/config.json", "bytes": 3}],
+                }))
+                dest = root / f"download {folder}"
+                result, rows = self.run_download(manifest, dest)
+                with self.subTest(folder=folder):
+                    self.assertEqual(result.returncode, 0, result.stderr)
+                    self.assertEqual((dest / "nested/config.json").read_bytes(), b"{}\n")
+                    self.assertEqual(rows, [{
+                        "url": "https://huggingface.co/example/model/resolve/0123456789abcdef/nested/config.json",
+                        "destination": str(dest / "nested/config.json"),
+                    }])
+
+
+if __name__ == "__main__":
+    unittest.main()
