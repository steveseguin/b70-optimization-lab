diff --git "a/tests/sdk.test.mjs" "b/tests/sdk.test.mjs"
index 6a8974eb6..05ea586c2 100644
--- "a/tests/sdk.test.mjs"
+++ "b/tests/sdk.test.mjs"
@@ -178,3 +178,22 @@ test('dist/ is in sync with engine.js and sdk/api.js', () => {
   assert.ok(probe && bundle.includes(`    ${probe}`), 'bundle is stale: run npm run build:sdk');
   assert.ok(bundle.includes('function predict(request = {})'));
 });
+
+test('explicit zero usage price or hours yield zero cost without altering predictions', () => {
+  const engine = sdk.createEngine();
+  const request = { model: 'llama3_8b', hardware: 'RTX 4090', runtime: 'vllm', quantization: 'fp16' };
+  const normal = engine.predict({ ...request, usage: { hoursPerDay: 8, costPerKwh: 0.12 } });
+  assert.ok(normal.power.costPerDay > 0, 'positive price must produce a positive daily cost');
+  assert.deepEqual(engine.predict(request).power, normal.power, 'omitted usage keeps documented defaults');
+
+  const zeroPrice = engine.predict({ ...request, usage: { hoursPerDay: 8, costPerKwh: 0 } });
+  assert.equal(zeroPrice.power.costPerDay, 0, 'zero price must yield zero daily cost');
+  assert.equal(zeroPrice.power.costPer1KTokens, 0, 'zero price must yield zero per-token cost');
+  assert.deepEqual(zeroPrice.decode, normal.decode, 'cost inputs must not change decode');
+  assert.deepEqual(zeroPrice.prefill, normal.prefill, 'cost inputs must not change prefill');
+
+  const zeroHours = engine.predict({ ...request, usage: { hoursPerDay: 0, costPerKwh: 0.12 } });
+  assert.equal(zeroHours.power.costPerDay, 0, 'zero hours must yield zero daily cost');
+  assert.deepEqual(zeroHours.decode, normal.decode, 'cost inputs must not change decode');
+  assert.deepEqual(zeroHours.prefill, normal.prefill, 'cost inputs must not change prefill');
+});
