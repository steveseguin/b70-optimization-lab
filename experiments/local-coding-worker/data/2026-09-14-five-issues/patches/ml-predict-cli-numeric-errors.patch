diff --git "a/tests/predict-cli.test.mjs" "b/tests/predict-cli.test.mjs"
new file mode 100644
index 000000000..3df571c90
--- /dev/null
+++ "b/tests/predict-cli.test.mjs"
@@ -0,0 +1,32 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const run = options => spawnSync(process.execPath,
+  [path.join(repoRoot, 'scripts', 'predict.mjs'), 'llama3_8b', 'RTX 4090', ...options],
+  { cwd: repoRoot, encoding: 'utf8', timeout: 15000, maxBuffer: 1024 * 1024 });
+
+test('predict CLI accepts documented valid numeric options', () => {
+  const result = run(['--count', '1', '--prompt', '64', '--output', '32', '--batch', '2']);
+  assert.equal(result.status, 0, result.stderr);
+  assert.match(result.stdout, /decode/i);
+  assert.match(result.stdout, /prefill/i);
+  assert.doesNotMatch(result.stdout, /NaN|Infinity/);
+});
+
+test('predict CLI rejects malformed numeric options with an actionable error', () => {
+  for (const option of ['count', 'prompt', 'output', 'batch']) {
+    for (const values of [['banana'], ['0'], ['-1'], ['1.5'], ['2junk'], []]) {
+      const result = run([`--${option}`, ...values]);
+      assert.equal(result.error, undefined, `CLI timed out for --${option} ${values.join(' ')}`);
+      assert.notEqual(result.status, 0, `Invalid --${option} ${values.join(' ')} must be rejected`);
+      const message = result.stderr + result.stdout;
+      assert.match(message, new RegExp(option, 'i'), `Error must identify --${option}: ${message}`);
+      assert.doesNotMatch(message, /TypeError:|ReferenceError:|\n\s+at (?:file:|\w)/,
+        `Invalid argument must not expose an internal stack trace: ${message}`);
+    }
+  }
+});
