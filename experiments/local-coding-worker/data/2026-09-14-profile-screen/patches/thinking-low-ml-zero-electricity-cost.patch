+test('explicit zero usage values yield zero cost without altering predictions', () => {
+  const engine = sdk.createEngine();
+  const request = { model: 'llama3_8b', hardware: 'RTX 4090', runtime: 'vllm', quantization: 'fp16' };
+  const normal = engine.predict({ ...request, usage: { hoursPerDay: 8, costPerKwh: 0.12 } });
+  assert.ok(normal.power.costPerDay > 0, 'positive defaults produce positive cost');
+  assert.deepEqual(engine.predict(request).power, normal.power, 'omitted usage retains defaults');
+
+  const zeroPrice = engine.predict({ ...request, usage: { hoursPerDay: 8, costPerKwh: 0 } });
+  assert.equal(zeroPrice.power.costPerDay, 0, 'zero price must yield zero daily cost');
+  assert.equal(zeroPrice.power.costPer1KTokens, 0, 'zero price must yield zero cost per token');
+  assert.deepEqual(zeroPrice.decode, normal.decode, 'zero price must not alter decode');
+  assert.deepEqual(zeroPrice.prefill, normal.prefill, 'zero price must not alter prefill');
+
+  const zeroHours = engine.predict({ ...request, usage: { hoursPerDay: 0, costPerKwh: 0.12 } });
+  assert.equal(zeroHours.power.costPerDay, 0, 'zero hours must yield zero daily cost');
+  assert.deepEqual(zeroHours.decode, normal.decode, 'zero hours must not alter decode');
+});
