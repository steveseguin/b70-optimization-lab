+
+test('listHardware returns isolated copies; editing them must not corrupt engine state', () => {
+  const engine = sdk.createEngine();
+  const request = { model: 'llama3_8b', hardware: 'RTX 4090', runtime: 'vllm', quantization: 'fp16' };
+  const baseline = engine.predict(request);
+  const before = JSON.parse(JSON.stringify(engine.listHardware()));
+  const listing = engine.listHardware();
+  const item = listing.find(row => row.key === 'RTX 4090');
+  assert.ok(item?.computeTFlops, 'listing must include computeTFlops');
+  // Mutate the nested compute specification.
+  item.computeTFlops.float16 = 1;
+  item.computeTFlops.hacked = 999;
+  // Later listings must be unchanged.
+  assert.deepEqual(engine.listHardware(), before, 'editing a listing must not change later listings');
+  // Predictions must be unchanged.
+  assert.deepEqual(engine.predict(request), baseline, 'editing a listing must not change predictions');
+  // A separate engine instance must be unaffected.
+  assert.deepEqual(sdk.createEngine().predict(request), baseline, 'separate engine must remain unaffected');
+});
