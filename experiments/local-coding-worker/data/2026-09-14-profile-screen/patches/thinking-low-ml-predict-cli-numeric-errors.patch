diff --git "a/tests/predict-cli-validation.test.mjs" "b/tests/predict-cli-validation.test.mjs"
new file mode 100644
index 000000000..800b37140
--- /dev/null
+++ "b/tests/predict-cli-validation.test.mjs"
@@ -0,0 +1,45 @@
+// CPU-only subprocess regression tests for scripts/predict.mjs numeric argument validation.
+import assert from 'node:assert/strict';
+import {spawnSync} from 'node:child_process';
+import {test, describe} from 'node:test';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+
+const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const script = path.join(repoRoot, 'scripts', 'predict.mjs');
+
+const run = (...args) =>
+  spawnSync(process.execPath, [script, 'llama3_8b', 'RTX 4090', ...args], {
+    cwd: repoRoot, encoding: 'utf8', timeout: 15000, maxBuffer: 1024 * 1024
+  });
+
+describe('predict.mjs numeric validation', () => {
+  test('valid documented arguments succeed', () => {
+    const result = run('--count', '2', '--prompt', '64', '--output', '32', '--batch', '4');
+    assert.equal(result.status, 0, result.stderr);
+    assert.match(result.stdout, /decode/i);
+    assert.doesNotMatch(result.stdout, /NaN|Infinity/);
+  });
+
+  for (const opt of ['count', 'prompt', 'output', 'batch']) {
+    for (const bad of ['banana', '0', '-1', '1.5', '2junk']) {
+      test(`--${opt} ${bad} is rejected with actionable error`, () => {
+        const result = run(`--${opt}`, bad);
+        assert.notEqual(result.status, 0, `Expected nonzero exit for --${opt} ${bad}`);
+        const msg = result.stderr + result.stdout;
+        assert.match(msg, new RegExp(opt, 'i'), `Error must mention --${opt}: ${msg}`);
+        assert.doesNotMatch(msg, /TypeError:|ReferenceError:|\n\s+at (?:file:|\w)/,
+          `Must not expose stack trace: ${msg}`);
+      });
+    }
+
+    test(`--${opt} with no value is rejected`, () => {
+      const result = run(`--${opt}`);
+      assert.notEqual(result.status, 0, `Expected nonzero exit for missing --${opt} value`);
+      const msg = result.stderr + result.stdout;
+      assert.match(msg, new RegExp(opt, 'i'), `Error must mention --${opt}: ${msg}`);
+      assert.doesNotMatch(msg, /TypeError:|ReferenceError:|\n\s+at (?:file:|\w)/,
+        `Must not expose stack trace: ${msg}`);
+    });
+  }
+});
