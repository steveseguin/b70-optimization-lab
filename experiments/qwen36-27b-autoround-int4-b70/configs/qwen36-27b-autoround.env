# Experimental defaults for Qwen3.6 27B INT4 AutoRound on B70.

export QWEN36_27B_AR_REPO="${QWEN36_27B_AR_REPO:-Intel/Qwen3.6-27B-int4-AutoRound}"
export QWEN36_27B_AR_REVISION="${QWEN36_27B_AR_REVISION:-abc86de19eb1ebbf6a7df4582341325c22ddcb7d}"
export QWEN36_27B_AR_VENV="${QWEN36_27B_AR_VENV:-/home/steve/.venvs/vllm-xpu}"
export HF_HOME="${HF_HOME:-/mnt/fast-ai/llm-cache/hf}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/transformers}"
export HF_HUB_DISABLE_XET="${HF_HUB_DISABLE_XET:-1}"
export HF_HUB_ENABLE_HF_TRANSFER="${HF_HUB_ENABLE_HF_TRANSFER:-1}"

# Bring-up defaults. Expand only after TP1 smoke is stable.
export GPU_INDEX="${GPU_INDEX:-0}"
export PORT="${PORT:-19410}"
export HOST="${HOST:-127.0.0.1}"
export SERVED_MODEL_NAME="${SERVED_MODEL_NAME:-qwen36-27b-int4-autoround}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-2048}"
export MAX_NUM_SEQS="${MAX_NUM_SEQS:-1}"
export MAX_NUM_BATCHED_TOKENS="${MAX_NUM_BATCHED_TOKENS:-1024}"
export GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.95}"
export VLLM_EXTRA_ARGS="${VLLM_EXTRA_ARGS:-}"

# Default service behavior should return normal OpenAI content. Callers can
# still override per request with chat_template_kwargs when they want thinking.
export QWEN36_27B_DEFAULT_ENABLE_THINKING="${QWEN36_27B_DEFAULT_ENABLE_THINKING:-0}"
export QWEN36_27B_ENABLE_PROMPT_TOKEN_DETAILS="${QWEN36_27B_ENABLE_PROMPT_TOKEN_DETAILS:-1}"
if [[ "${QWEN36_27B_REASONING_PARSER+x}" != "x" ]]; then
  export QWEN36_27B_REASONING_PARSER="qwen3"
else
  export QWEN36_27B_REASONING_PARSER
fi

# Matches the model-card vLLM example. Set QWEN36_27B_ENABLE_MTP=0 to debug
# loader correctness without speculation.
export QWEN36_27B_ENABLE_MTP="${QWEN36_27B_ENABLE_MTP:-1}"
export NUM_SPECULATIVE_TOKENS="${NUM_SPECULATIVE_TOKENS:-2}"

# Leave graph off for first load/debug. Turn on during optimization sweeps.
export QWEN36_27B_ENABLE_XPU_GRAPH="${QWEN36_27B_ENABLE_XPU_GRAPH:-0}"

# Current best strict/fresh speed delta. Keep default-off so bring-up still
# mirrors the model card; enable both for the 53.5 tok/s promoted recipe.
export VLLM_XPU_GDN_PROMOTE_ACCEPTED_SPEC_STATE="${VLLM_XPU_GDN_PROMOTE_ACCEPTED_SPEC_STATE:-0}"
export VLLM_XPU_GDN_NONSPEC_POSTPROCESS_ACCEPTED_STATE="${VLLM_XPU_GDN_NONSPEC_POSTPROCESS_ACCEPTED_STATE:-1}"
