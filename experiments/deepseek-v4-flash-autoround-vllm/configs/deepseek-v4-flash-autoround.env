# Experimental defaults for DeepSeek V4 Flash AutoRound on 4x B70.
# Source this file or let scripts read equivalent environment variables.

export DEEPSEEK_V4_AR_REPO="${DEEPSEEK_V4_AR_REPO:-Intel/DeepSeek-V4-Flash-W4A16-AutoRound}"
export DEEPSEEK_V4_AR_REVISION="${DEEPSEEK_V4_AR_REVISION:-d8ac6c04e22da23f68f797884471dae5cb129ee0}"
export DEEPSEEK_V4_AR_MODEL_DIR="${DEEPSEEK_V4_AR_MODEL_DIR:-/mnt/fast-ai/llm-models/deepseek-v4-flash-w4a16-autoround}"
export DEEPSEEK_V4_AR_VENV="${DEEPSEEK_V4_AR_VENV:-/home/steve/.venvs/vllm-xpu}"
export DEEPSEEK_V4_AR_OUTDIR="${DEEPSEEK_V4_AR_OUTDIR:-/mnt/fast-ai/bench-results/deepseek-v4-flash-autoround-vllm}"

export ONEAPI_DEVICE_SELECTOR="${ONEAPI_DEVICE_SELECTOR:-level_zero:0,1,2,3}"
export ZE_AFFINITY_MASK="${ZE_AFFINITY_MASK:-0,1,2,3}"
export CCL_ATL_TRANSPORT="${CCL_ATL_TRANSPORT:-ofi}"
export CCL_TOPO_P2P_ACCESS="${CCL_TOPO_P2P_ACCESS:-1}"
export HF_HOME="${HF_HOME:-/mnt/fast-ai/llm-cache/hf}"
export TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/transformers}"

# Keep small while bring-up is unstable. DeepSeek V4 advertises very long
# context, but the B70 vLLM/XPU path needs a small correctness lane first.
export TP="${TP:-4}"
export DTYPE="${DTYPE:-bfloat16}"
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-2048}"
export MAX_BATCHED_TOKENS="${MAX_BATCHED_TOKENS:-512}"
export MAX_NUM_SEQS="${MAX_NUM_SEQS:-1}"
export INPUT_LEN="${INPUT_LEN:-64}"
export OUTPUT_LEN="${OUTPUT_LEN:-16}"
export NUM_PROMPTS="${NUM_PROMPTS:-1}"
export GPU_MEMORY_UTILIZATION="${GPU_MEMORY_UTILIZATION:-0.95}"
export KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8}"

# Avoid the CUDA/SM100-only MegaMoE path unless intentionally testing it.
export DEEPSEEK_V4_MOE_BACKEND="${DEEPSEEK_V4_MOE_BACKEND:-}"
