+template <typename dst_t>
+static void dequantize_row_q8_0_sycl_reorder_coalesced(const void * vx, dst_t * y, const int64_t k,
+                                                       dpct::queue_ptr stream) {
+    constexpr int VALS = 8;  // divides QK8_0, so a work-item never straddles two blocks
+    constexpr int WG   = 256;
+    GGML_ASSERT(k % QK8_0 == 0);
+    const int64_t n_items = k / VALS;
+    const int64_t n_wg    = (n_items + WG - 1) / WG;
+    stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(n_wg * WG), sycl::range<1>(WG)),
+        [=](sycl::nd_item<1> it) {
+            const int64_t e0 = (int64_t) it.get_global_id(0) * VALS;
+            if (e0 >= k) {
+                return;
+            }
+            const int8_t *     qs = (const int8_t *) vx + e0;
+            const sycl::half * s  = (const sycl::half *) ((const uint8_t *) vx + k);
+            const float        d  = float(s[e0 / QK8_0]);
+#pragma unroll
+            for (int l = 0; l < VALS; ++l) {
+                y[e0 + l] = d * qs[l];
+            }
+        });
+}
