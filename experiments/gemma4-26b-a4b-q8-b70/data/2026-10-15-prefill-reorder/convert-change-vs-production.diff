 template <typename dst_t>
 static void dequantize_row_q8_0_sycl_reorder(const void *vx, dst_t *y, const int64_t k,
                                      dpct::queue_ptr stream) {
+    ggml_sycl_q8_0_deq_count(true, k);
+    const int mode = ggml_sycl_q8_0_reorder_deq_mode();
+    if (mode == 0) {
+        dequantize_row_q8_0_sycl_reorder_blocked(vx, y, k, stream);
+        return;
+    }
+    dequantize_row_q8_0_sycl_reorder_coalesced(vx, y, k, stream);
+    if (mode == 2) {
+        static std::atomic<int64_t> n_calls{0}, n_bad_calls{0};
+        dst_t * ref = sycl::malloc_device<dst_t>(k, *stream);
+        dequantize_row_q8_0_sycl_reorder_blocked(vx, ref, k, stream);
+        std::vector<dst_t> a(k), b(k);
+        stream->memcpy(a.data(), y, k * sizeof(dst_t));
+        stream->memcpy(b.data(), ref, k * sizeof(dst_t)).wait();
+        sycl::free(ref, *stream);
+        const bool same = std::memcmp(a.data(), b.data(), k * sizeof(dst_t)) == 0;
+        const int64_t calls = ++n_calls;
+        if (!same) {
+            ++n_bad_calls;
+            int64_t diff = 0;
+            for (int64_t i = 0; i < k; ++i) {
+                diff += std::memcmp(&a[i], &b[i], sizeof(dst_t)) != 0;
+            }
+            GGML_LOG_WARN("Q8_0_REORDER_DEQ_VERIFY mismatch: k=%lld elem_bytes=%d differing=%lld\n", (long long) k,
+                          (int) sizeof(dst_t), (long long) diff);
+        }
+        if ((calls & (calls - 1)) == 0) {
+            GGML_LOG_WARN("Q8_0_REORDER_DEQ_VERIFY calls=%lld mismatched_calls=%lld\n", (long long) calls,
+                          (long long) n_bad_calls.load());
+        }
+    }
+}
