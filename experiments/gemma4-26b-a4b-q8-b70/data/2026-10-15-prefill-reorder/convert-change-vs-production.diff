+// LLAMA_SYCL_Q8_0_REORDER_DEQ_COALESCED=1: the reordered (SoA) Q8_0 rows are dequantized with each work-item taking
+// 8 consecutive values instead of a whole 32-value block, so neighbouring lanes read neighbouring quants and write
+// neighbouring outputs. The arithmetic per value is the same expression as dequantize_block_q8_0_reorder
+// (float(d) * q, then converted to dst_t), so the output is the same bytes. This is the prompt-path (GEMM) dequant
+// that runs once decode has reordered the weights: =2 also runs the old kernel and compares bytes (diagnosis).
+// LLAMA_SYCL_Q8_0_DEQ_COUNT=1 (diagnosis): count the Q8_0 to-FP16/FP32 conversions on the prompt path, reordered
+// and plain layout, with their element totals, logged at every power-of-two call count of either kind.
+static void ggml_sycl_q8_0_deq_count(bool reordered, int64_t k) {
+    static const bool on = [] {
+        const char * env = std::getenv("LLAMA_SYCL_Q8_0_DEQ_COUNT");
+        return env && std::atoi(env) != 0;
+    }();
+    if (!on) {
+        return;
+    }
+    static std::atomic<int64_t> calls[2], elems[2];
+    const int64_t c = ++calls[reordered];
+    elems[reordered] += k;
+    if ((c & (c - 1)) == 0) {
+        GGML_LOG_WARN("Q8_0_DEQ_COUNT reordered calls=%lld elems=%lld | plain calls=%lld elems=%lld\n",
+                      (long long) calls[1].load(), (long long) elems[1].load(), (long long) calls[0].load(),
+                      (long long) elems[0].load());
+    }
+}
