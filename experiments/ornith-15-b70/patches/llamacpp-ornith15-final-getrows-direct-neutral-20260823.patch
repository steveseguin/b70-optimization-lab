+// A one-token decode graph has a final F32 GET_ROWS named result_norm whose
+// source also has exactly one row. Its sole valid index is therefore zero and
+// the copy cannot change any bits. Let the immediately following Q6_K output
+// head read that source row directly, removing one launch and an 8 KiB copy.
+static ggml_tensor * ggml_sycl_find_ornith_final_get_rows(
+        const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_final_get_rows_enabled() ||
+        node_idx < 0 || node_idx + 1 >= cgraph->n_nodes) {
+        return nullptr;
+    }
+
+    ggml_tensor * get = cgraph->nodes[node_idx];
+    ggml_tensor * out = cgraph->nodes[node_idx + 1];
+    if (get == nullptr || out == nullptr || get->op != GGML_OP_GET_ROWS ||
+        out->op != GGML_OP_MUL_MAT || std::strcmp(get->name, "result_norm") != 0 ||
+        std::strcmp(out->name, "result_output") != 0 || get->src[0] == nullptr ||
+        get->src[1] == nullptr || out->src[0] == nullptr || out->src[1] != get ||
+        get->type != GGML_TYPE_F32 || get->src[0]->type != GGML_TYPE_F32 ||
+        get->src[1]->type != GGML_TYPE_I32 || out->src[0]->type != GGML_TYPE_Q6_K ||
+        out->type != GGML_TYPE_F32 || !ggml_is_contiguous(get) ||
+        !ggml_is_contiguous(get->src[0]) || ggml_nrows(get) != 1 ||
+        ggml_nrows(get->src[0]) != 1 || ggml_nelements(get) != 2048 ||
+        ggml_nelements(get->src[0]) != 2048 || ggml_nelements(get->src[1]) != 1 ||
+        out->ne[0] != 248320 || out->ne[1] != 1 || out->ne[2] != 1 || out->ne[3] != 1 ||
+        out->src[0]->ne[0] != 2048 || out->src[0]->ne[1] != 248320 ||
+        get->data == get->src[0]->data) {
+        return nullptr;
+    }
+
+    // The skipped graph-visible row may not feed any other compute node.
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * consumer = cgraph->nodes[j];
+        if (consumer == nullptr) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (consumer->src[s] == get && !(consumer == out && s == 1)) {
+                return nullptr;
+            }
+        }
+    }
+    return out;
+}
