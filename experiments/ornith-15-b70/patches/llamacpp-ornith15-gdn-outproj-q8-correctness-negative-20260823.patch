+static bool ggml_sycl_prepare_ornith_gdn_outproj(
+        ggml_backend_sycl_context & ctx,
+        const ggml_sycl_ornith_gdn_rms_gate_match & match) {
+    if (!ggml_sycl_ornith_gdn_outproj_enabled() || match.projection == nullptr) {
+        return false;
+    }
+    const ggml_tensor * weight = match.projection->src[0];
+    opt_for_reorder(&ctx, weight, match.gate_mul, match.projection, mul_mat_algo::MMVQ);
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(weight->extra);
+    return extra != nullptr && extra->optimized_feature.reorder;
+}
