+// Ornith 1.5 35B-A3B recurrent geometry:
+//   Q = 16 x 128, K = 16 x 128, V = 32 x 128, C = 8192, d_conv = 4.
+// Each workgroup owns two complete heads. The convolution and SiLU retain the
+// stock per-channel FP32 operation order. For Q/K, two SIMD16 subgroups then
+// reproduce l2_norm_f32's lane accumulation and XOR reduction; the V tail is
+// written to the graph-visible SiLU buffer. The persistent three-sample state
+// is updated only after all four convolution inputs have been loaded.
+template <bool poison>
+static void kernel_ornith_conv_chain(
+        queue & q,
+        float * state,
+        const char * current,
+        size_t current_stride,
+        const float * weights,
+        float * silu_dst,
+        int d_conv,
+        int d_inner) {
+    constexpr size_t work_group_size = 256;
+    const size_t num_work_groups =
+        (static_cast<size_t>(d_inner) + work_group_size - 1) / work_group_size;
+
+    q.submit([&](handler & h) {
+        h.parallel_for(
+            nd_range<1>(range<1>(num_work_groups * work_group_size), range<1>(work_group_size)),
+            [=](nd_item<1> item) {
+                const size_t channel = item.get_global_id(0);
+                if (channel >= static_cast<size_t>(d_inner)) {
+                    return;
+                }
+
+                const size_t state_base = channel * static_cast<size_t>(d_conv - 1);
+                const float s0 = state[state_base + 0];
+                const float s1 = state[state_base + 1];
+                const float s2 = state[state_base + 2];
+                const float x = *reinterpret_cast<const float *>(current + channel * current_stride);
+                const float * c = weights + channel * static_cast<size_t>(d_conv);
+
+                const float samples[4] = { s0, s1, s2, x };
+                float sumf = 0.0f;
+                for (int tap = 0; tap < d_conv; ++tap) {
+                    sumf += samples[tap] * c[tap];
+                }
+                if constexpr (poison) {
+                    sumf += 1000.0f;
+                }
+
+                const float silu = sumf / (1.0f + sycl::exp(-sumf));
+                silu_dst[channel] = silu;
+
+                state[state_base + 0] = s1;
+                state[state_base + 1] = s2;
+                state[state_base + 2] = x;
+            });
+    });
+}
