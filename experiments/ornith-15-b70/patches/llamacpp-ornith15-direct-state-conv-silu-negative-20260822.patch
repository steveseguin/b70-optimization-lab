+struct ggml_sycl_ornith_conv_chain_match {
+    ggml_tensor * concat;
+    ggml_tensor * cpy;
+    ggml_tensor * conv;
+    ggml_tensor * silu;
+    ggml_tensor * q_l2;
+    ggml_tensor * k_l2;
+    ggml_tensor * state;
+    ggml_tensor * current;
+};
+
+static std::atomic<uint64_t> g_ggml_sycl_ornith_conv_chain_hits{0};
+static std::array<std::atomic<uint64_t>, 10> g_ggml_sycl_ornith_conv_chain_stages{};
+
+static void ggml_sycl_ornith_conv_chain_stats_dump() {
+    std::fprintf(stderr, "ggml_sycl_ornith_conv_chain: fused_hits=%" PRIu64 "\n",
+                 g_ggml_sycl_ornith_conv_chain_hits.load(std::memory_order_relaxed));
+    std::fprintf(stderr, "ggml_sycl_ornith_conv_chain: stages=");
+    for (size_t i = 0; i < g_ggml_sycl_ornith_conv_chain_stages.size(); ++i) {
+        std::fprintf(stderr, "%s%" PRIu64, i == 0 ? "" : ",",
+                     g_ggml_sycl_ornith_conv_chain_stages[i].load(std::memory_order_relaxed));
+    }
+    std::fprintf(stderr, "\n");
+}
+
+static bool ggml_sycl_ornith_conv_chain_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_CONV_CHAIN");
+        const bool on = value != nullptr && std::atoi(value) != 0;
+        if (on) {
+            std::atexit(ggml_sycl_ornith_conv_chain_stats_dump);
+        }
+        return on;
+    }();
+    return enabled;
+}
+
+static bool ggml_sycl_is_shape_alias(const ggml_tensor * tensor) {
+    return tensor != nullptr &&
+           (tensor->op == GGML_OP_RESHAPE || tensor->op == GGML_OP_TRANSPOSE ||
+            tensor->op == GGML_OP_VIEW || tensor->op == GGML_OP_PERMUTE);
+}
+
+static ggml_tensor * ggml_sycl_unwrap_shape_alias(ggml_tensor * tensor) {
+    for (int depth = 0; tensor != nullptr && ggml_sycl_is_shape_alias(tensor) && depth < 16; ++depth) {
+        ggml_tensor * parent = tensor->view_src != nullptr ? tensor->view_src : tensor->src[0];
+        if (parent == nullptr || parent == tensor) {
+            break;
+        }
+        tensor = parent;
+    }
+    return tensor;
+}
