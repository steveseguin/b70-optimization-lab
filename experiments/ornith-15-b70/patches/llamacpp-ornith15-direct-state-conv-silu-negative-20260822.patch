 }
+
+void ggml_sycl_ornith_conv_chain(
+        ggml_backend_sycl_context & ctx,
+        ggml_tensor * conv,
+        ggml_tensor * silu,
+        ggml_tensor * q_l2,
+        ggml_tensor * k_l2,
+        ggml_tensor * state,
+        ggml_tensor * current) {
+    scope_op_debug_print scope_dbg_print(__func__, conv, /*num_src=*/2);
+
+    GGML_ASSERT(conv != nullptr && silu != nullptr && q_l2 != nullptr && k_l2 != nullptr);
+    GGML_ASSERT(state != nullptr && current != nullptr && conv->src[1] != nullptr);
+    GGML_ASSERT(conv->op == GGML_OP_SSM_CONV && silu->op == GGML_OP_UNARY);
+    GGML_ASSERT(ggml_get_unary_op(silu) == GGML_UNARY_OP_SILU && silu->src[0] == conv);
+    GGML_ASSERT(q_l2->op == GGML_OP_L2_NORM && k_l2->op == GGML_OP_L2_NORM);
+    GGML_ASSERT(conv->type == GGML_TYPE_F32 && silu->type == GGML_TYPE_F32);
+    GGML_ASSERT(q_l2->type == GGML_TYPE_F32 && k_l2->type == GGML_TYPE_F32);
+
+    ggml_tensor * weights = conv->src[1];
+    const int d_conv = static_cast<int>(weights->ne[0]);
+    const int d_inner = static_cast<int>(weights->ne[1]);
+    const int q_heads = static_cast<int>(q_l2->ne[1]);
+    const int k_heads = static_cast<int>(k_l2->ne[1]);
+
+    GGML_ASSERT(d_conv == 4 && d_inner == 8192 && q_heads == 16 && k_heads == 16);
+    GGML_ASSERT(conv->ne[0] == d_inner && conv->ne[1] == 1 && conv->ne[2] == 1 && conv->ne[3] == 1);
+    GGML_ASSERT(ggml_are_same_shape(conv, silu) && ggml_is_contiguous(silu));
+    GGML_ASSERT(q_l2->ne[0] == 128 && q_l2->ne[2] == 1 && q_l2->ne[3] == 1);
+    GGML_ASSERT(k_l2->ne[0] == 128 && k_l2->ne[2] == 1 && k_l2->ne[3] == 1);
+    GGML_ASSERT(ggml_is_contiguous(q_l2) && ggml_is_contiguous(k_l2));
+    GGML_ASSERT(ggml_nelements(state) == 3LL * d_inner && ggml_is_contiguous(state));
+    GGML_ASSERT(current->ne[0] == 1 && current->ne[1] == d_inner && ggml_nelements(current) == d_inner);
+    GGML_ASSERT(weights->nb[0] == sizeof(float) && weights->nb[1] == 4 * sizeof(float));
+    GGML_ASSERT(current->nb[1] >= sizeof(float));
+
+    float q_eps;
+    float k_eps;
+    memcpy(&q_eps, q_l2->op_params, sizeof(float));
+    memcpy(&k_eps, k_l2->op_params, sizeof(float));
+    GGML_ASSERT(q_eps >= 0.0f && q_eps == k_eps);
+
+    static const bool poison = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_CONV_CHAIN_POISON");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+
+    if (poison) {
+        kernel_ornith_conv_chain<true>(
+            *ctx.stream(), static_cast<float *>(state->data),
+            static_cast<const char *>(current->data), current->nb[1],
+            static_cast<const float *>(weights->data), static_cast<float *>(silu->data),
+            d_conv, d_inner);
+    } else {
+        kernel_ornith_conv_chain<false>(
+            *ctx.stream(), static_cast<float *>(state->data),
+            static_cast<const char *>(current->data), current->nb[1],
+            static_cast<const float *>(weights->data), static_cast<float *>(silu->data),
+            d_conv, d_inner);
+    }
+}
