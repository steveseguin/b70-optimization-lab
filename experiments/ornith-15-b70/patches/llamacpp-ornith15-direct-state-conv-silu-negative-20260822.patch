+static bool ggml_sycl_find_ornith_conv_chain(
+        const ggml_cgraph * cgraph, int node_idx, ggml_sycl_ornith_conv_chain_match & match) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_conv_chain_enabled() ||
+        node_idx < 0 || node_idx >= cgraph->n_nodes) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[0].fetch_add(1, std::memory_order_relaxed);
+
+    constexpr int64_t d_conv = 4;
+    constexpr int64_t d_inner = 8192;
+    constexpr int64_t head_dim = 128;
+    constexpr int64_t q_heads = 16;
+    constexpr int64_t k_heads = 16;
+    constexpr int64_t qk_channels = (q_heads + k_heads) * head_dim;
+
+    ggml_tensor * get = cgraph->nodes[node_idx];
+    if (get == nullptr || get->op != GGML_OP_GET_ROWS || get->src[0] == nullptr ||
+        get->src[1] == nullptr || get->type != GGML_TYPE_F32 ||
+        get->src[0]->type != GGML_TYPE_F32 || get->src[1]->type != GGML_TYPE_I32 ||
+        !ggml_is_contiguous(get) || !ggml_is_contiguous(get->src[0]) ||
+        ggml_nrows(get) != 1 || ggml_nrows(get->src[0]) != 1 ||
+        ggml_nelements(get) != (d_conv - 1) * d_inner ||
+        (get->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[1].fetch_add(1, std::memory_order_relaxed);
+
+    ggml_tensor * concat = nullptr;
+    int concat_index = -1;
+    for (int j = node_idx + 1; j < cgraph->n_nodes && j <= node_idx + 32; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate != nullptr && candidate->op == GGML_OP_CONCAT && candidate->src[0] != nullptr &&
+            ggml_sycl_unwrap_shape_alias(candidate->src[0]) == get) {
+            if (concat != nullptr) {
+                return false;
+            }
+            concat = candidate;
+            concat_index = j;
+        }
+    }
+    if (concat == nullptr || std::strstr(concat->name, "conv_input-") == nullptr ||
+        concat->src[1] == nullptr || concat->type != GGML_TYPE_F32 ||
+        concat->ne[0] != d_conv || concat->ne[1] != d_inner ||
+        concat->ne[2] != 1 || concat->ne[3] != 1 || !ggml_is_contiguous(concat) ||
+        reinterpret_cast<const int32_t *>(concat->op_params)[0] != 0 ||
+        (concat->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[2].fetch_add(1, std::memory_order_relaxed);
+
+    ggml_tensor * cpy = nullptr;
+    int cpy_index = -1;
+    for (int j = concat_index + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr || candidate->op != GGML_OP_CPY ||
+            candidate->src[0] == nullptr || candidate->src[1] == nullptr ||
+            ggml_sycl_unwrap_shape_alias(candidate->src[0]) != concat ||
+            candidate->src[1]->data != get->src[0]->data) {
+            continue;
+        }
+        if (cpy != nullptr) {
+            return false;
+        }
+        cpy = candidate;
+        cpy_index = j;
+    }
+    if (cpy == nullptr || cpy->src[0]->type != GGML_TYPE_F32 || cpy->src[1]->type != GGML_TYPE_F32 ||
+        std::strstr(cpy->name, "conv_state_update-") == nullptr ||
+        cpy->src[0]->view_src != concat || cpy->src[0]->view_offs != sizeof(float) ||
+        cpy->src[0]->data != static_cast<char *>(concat->data) + concat->nb[0] ||
+        cpy->src[0]->nb[0] != concat->nb[0] || cpy->src[0]->nb[1] != concat->nb[1] ||
+        ggml_nelements(cpy->src[0]) != (d_conv - 1) * d_inner ||
+        ggml_nelements(cpy->src[1]) != (d_conv - 1) * d_inner ||
+        !ggml_is_contiguous(cpy->src[1]) ||
+        (cpy->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[3].fetch_add(1, std::memory_order_relaxed);
+
+    ggml_tensor * current = concat->src[1];
+    ggml_tensor * state = cpy->src[1];
+    if (current->type != GGML_TYPE_F32 || current->ne[0] != 1 || current->ne[1] != d_inner ||
+        current->ne[2] != 1 || current->ne[3] != 1 || ggml_nelements(current) != d_inner ||
+        current->nb[1] < sizeof(float) || state->data != get->src[0]->data) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[4].fetch_add(1, std::memory_order_relaxed);
+
+    const auto overlaps = [](const ggml_tensor * lhs, const ggml_tensor * rhs) {
+        const uintptr_t lhs_begin = reinterpret_cast<uintptr_t>(lhs->data);
+        const uintptr_t rhs_begin = reinterpret_cast<uintptr_t>(rhs->data);
+        const uintptr_t lhs_end = lhs_begin + ggml_nbytes(lhs);
+        const uintptr_t rhs_end = rhs_begin + ggml_nbytes(rhs);
+        return lhs_begin < rhs_end && rhs_begin < lhs_end;
+    };
+    if (overlaps(state, concat) || overlaps(state, concat->src[0]) || overlaps(state, current)) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[5].fetch_add(1, std::memory_order_relaxed);
+
+    ggml_tensor * conv = nullptr;
+    int conv_index = -1;
+    for (int j = concat_index + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate != nullptr && candidate->op == GGML_OP_SSM_CONV && candidate->src[0] == concat) {
+            if (conv != nullptr) {
+                return false;
+            }
+            conv = candidate;
+            conv_index = j;
+        }
+    }
+    if (conv == nullptr || std::strstr(conv->name, "conv_output_raw-") == nullptr ||
+        conv_index <= cpy_index || conv->src[1] == nullptr ||
+        conv->src[1]->type != GGML_TYPE_F32 || conv->src[1]->ne[0] != d_conv ||
+        conv->src[1]->ne[1] != d_inner || conv->type != GGML_TYPE_F32 ||
+        conv->ne[0] != d_inner || conv->ne[1] != 1 || conv->ne[2] != 1 || conv->ne[3] != 1 ||
+        !ggml_is_contiguous(conv) || (conv->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[6].fetch_add(1, std::memory_order_relaxed);
+
+    ggml_tensor * silu = nullptr;
+    int silu_index = -1;
+    for (int j = conv_index + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr) {
+            continue;
+        }
+        for (int src_index = 0; src_index < GGML_MAX_SRC; ++src_index) {
+            if (candidate->src[src_index] != conv) {
+                continue;
+            }
+            if (candidate->op != GGML_OP_UNARY || src_index != 0 || silu != nullptr ||
+                ggml_get_unary_op(candidate) != GGML_UNARY_OP_SILU ||
+                candidate->type != GGML_TYPE_F32 || !ggml_is_contiguous(candidate) ||
+                !ggml_are_same_shape(candidate, conv)) {
+                return false;
+            }
+            silu = candidate;
+            silu_index = j;
+        }
+    }
+    if (silu == nullptr || std::strstr(silu->name, "conv_output_silu-") == nullptr ||
+        (silu->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[7].fetch_add(1, std::memory_order_relaxed);
+
+    ggml_tensor * q_l2 = nullptr;
+    ggml_tensor * k_l2 = nullptr;
+    int q_l2_index = -1;
+    int k_l2_index = -1;
+    for (int j = silu_index + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr || candidate->op != GGML_OP_L2_NORM || candidate->src[0] == nullptr ||
+            ggml_sycl_unwrap_shape_alias(candidate->src[0]) != silu) {
+            continue;
+        }
+        if (std::strstr(candidate->name, "q_conv_predelta-") != nullptr && q_l2 == nullptr) {
+            q_l2 = candidate;
+            q_l2_index = j;
+        } else if (std::strstr(candidate->name, "k_conv_predelta-") != nullptr && k_l2 == nullptr) {
+            k_l2 = candidate;
+            k_l2_index = j;
+        } else {
+            return false;
+        }
+    }
+    if (q_l2 == nullptr || k_l2 == nullptr || q_l2_index <= silu_index || k_l2_index <= q_l2_index ||
+        q_l2->type != GGML_TYPE_F32 || k_l2->type != GGML_TYPE_F32 ||
+        q_l2->ne[0] != head_dim || q_l2->ne[1] != q_heads || q_l2->ne[2] != 1 || q_l2->ne[3] != 1 ||
+        k_l2->ne[0] != head_dim || k_l2->ne[1] != k_heads || k_l2->ne[2] != 1 || k_l2->ne[3] != 1 ||
+        !ggml_is_contiguous(q_l2) || !ggml_is_contiguous(k_l2)) {
+        return false;
+    }
+    g_ggml_sycl_ornith_conv_chain_stages[8].fetch_add(1, std::memory_order_relaxed);
+
+    ggml_tensor * q_src = q_l2->src[0];
+    ggml_tensor * k_src = k_l2->src[0];
+    const uintptr_t silu_base = reinterpret_cast<uintptr_t>(silu->data);
+    if (q_src == nullptr || k_src == nullptr || q_src->type != GGML_TYPE_F32 || k_src->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(q_src) || !ggml_is_contiguous(k_src) ||
+        reinterpret_cast<uintptr_t>(q_src->data) != silu_base ||
+        reinterpret_cast<uintptr_t>(k_src->data) != silu_base + q_heads * head_dim * sizeof(float)) {
+        return false;
+    }
+
+    float q_eps;
+    float k_eps;
+    memcpy(&q_eps, q_l2->op_params, sizeof(float));
+    memcpy(&k_eps, k_l2->op_params, sizeof(float));
+    if (q_eps < 0.0f || q_eps != k_eps) {
+        return false;
+    }
+
+    // Every skipped producer must have only the consumers reproduced here.
+    // Shape aliases are harmless; the V tail remains materialized for GDN.
+    const uintptr_t v_begin = silu_base + qk_channels * sizeof(float);
+    const uintptr_t silu_end = silu_base + d_inner * sizeof(float);
+    for (int j = 0; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * consumer = cgraph->nodes[j];
+        if (consumer == nullptr) {
+            continue;
+        }
+        for (int src_index = 0; src_index < GGML_MAX_SRC; ++src_index) {
+            ggml_tensor * src = consumer->src[src_index];
+            if (src == nullptr) {
+                continue;
+            }
+            ggml_tensor * root = ggml_sycl_unwrap_shape_alias(src);
+            if (root == get && !ggml_sycl_is_shape_alias(consumer) &&
+                !(consumer == concat && src_index == 0)) {
+                return false;
+            }
+            if (root == concat && !ggml_sycl_is_shape_alias(consumer) &&
+                !(consumer == conv && src_index == 0) && !(consumer == cpy && src_index == 0)) {
+                return false;
+            }
+            if (root == conv && !ggml_sycl_is_shape_alias(consumer) && consumer != silu) {
+                return false;
+            }
+            if (root == silu && !ggml_sycl_is_shape_alias(consumer) &&
+                consumer != q_l2 && consumer != k_l2) {
+                const uintptr_t begin = reinterpret_cast<uintptr_t>(src->data);
+                const uintptr_t end = begin + ggml_nbytes(src);
+                if (begin < v_begin || end > silu_end) {
+                    return false;
+                }
+            }
+        }
+    }
+
+    match = { concat, cpy, conv, silu, q_l2, k_l2, state, current };
+    g_ggml_sycl_ornith_conv_chain_stages[9].fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
