+static bool ggml_sycl_find_ornith_attn_gate_cont(const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_attn_gate_cont_enabled() ||
+        node_idx < 0 || node_idx + 2 >= cgraph->n_nodes ||
+        !ggml_can_fuse(cgraph, node_idx, { GGML_OP_CONT, GGML_OP_UNARY, GGML_OP_MUL })) {
+        return false;
