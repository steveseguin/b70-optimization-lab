+    const ggml_tensor * cont = cgraph->nodes[node_idx];
+    const ggml_tensor * sigmoid = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * mul = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * raw = cont->src[0];
+    if (raw == nullptr || raw->view_src == nullptr || sigmoid->src[0] != cont ||
+        ggml_get_unary_op(sigmoid) != GGML_UNARY_OP_SIGMOID ||
+        std::strstr(cont->name, "gate_reshaped-") == nullptr ||
+        std::strstr(sigmoid->name, "gate_sigmoid-") == nullptr ||
+        std::strstr(mul->name, "attn_gated-") == nullptr ||
+        std::strstr(raw->view_src->name, "Qcur_full-") == nullptr ||
+        cont->type != GGML_TYPE_F32 || sigmoid->type != GGML_TYPE_F32 ||
+        mul->type != GGML_TYPE_F32 || raw->type != GGML_TYPE_F32 ||
+        cont->ne[0] != 4096 || cont->ne[1] != 1 || cont->ne[2] != 1 || cont->ne[3] != 1 ||
+        raw->ne[0] != 256 || raw->ne[1] != 16 || raw->ne[2] != 1 || raw->ne[3] != 1 ||
+        raw->nb[0] != sizeof(float) || raw->nb[1] != 512 * sizeof(float) ||
+        raw->view_offs != 256 * sizeof(float) ||
+        raw->data != (char *) raw->view_src->data + raw->view_offs ||
+        raw->view_src->type != GGML_TYPE_F32 || raw->view_src->ne[0] != 8192 ||
+        raw->view_src->ne[1] != 1 || raw->view_src->ne[2] != 1 || raw->view_src->ne[3] != 1 ||
+        !ggml_is_contiguous(raw->view_src) || !ggml_is_contiguous(cont) ||
+        !ggml_is_contiguous(sigmoid) || !ggml_is_contiguous(mul) ||
+        (cont->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        (sigmoid->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        (mul->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    const ggml_tensor * other = mul->src[0] == sigmoid ? mul->src[1]
+                              : mul->src[1] == sigmoid ? mul->src[0] : nullptr;
+    if (other == nullptr || other->type != GGML_TYPE_F32 ||
+        std::strstr(other->name, "attn_pregate-") == nullptr ||
+        !ggml_are_same_shape(other, cont) || !ggml_is_contiguous(other)) {
+        return false;
+    }
+
+    const auto overlaps = [](const ggml_tensor * a, const ggml_tensor * b) {
+        const uintptr_t a0 = (uintptr_t) a->data;
+        const uintptr_t b0 = (uintptr_t) b->data;
+        return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+    };
+    if (overlaps(raw, mul) || (other->data != mul->data && overlaps(other, mul))) {
+        return false;
+    }
+
+    return true;
+}
 
