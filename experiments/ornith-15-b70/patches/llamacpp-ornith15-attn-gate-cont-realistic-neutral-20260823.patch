+    const float * other_data = static_cast<const float *>(other->data);
+    float * dst = static_cast<float *>(mul_node->data);
+    const int64_t head_stride = raw->nb[1] / sizeof(float);
+    constexpr int64_t head_width = 256;
+    constexpr int64_t k = 4096;
