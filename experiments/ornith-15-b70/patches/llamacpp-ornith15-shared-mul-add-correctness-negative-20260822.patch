+    } else {
+        kernel_ornith_conv_silu<false>(*ctx.stream(), static_cast<const float *>(conv->src[0]->data),
+            static_cast<const float *>(conv->src[1]->data), static_cast<float *>(silu->data), 4, 8192, 4);
+    }
