+template<bool poison>
+static void ornith_shared_mul_add_kernel(
+        const float * gate_src,
+        const float * shared,
+        const float * routed,
+        volatile float * weighted_out,
+        float * dst,
+        const int64_t n,
+        const sycl::nd_item<1> item) {
+    const float gate = gate_src[0];
+
+    SYCL_GLOBAL_ID_LOOP(n, item) {
+        // Preserve the graph-visible rounded MUL in its actual destination
+        // before consuming it in the following ADD.
+        weighted_out[i] = shared[i] * gate;
+        const float weighted = weighted_out[i];
+        float value = routed[i] + weighted;
+        if constexpr (poison) {
+            if (i == 0) {
+                value += 1.0f;
+            }
+        }
+        dst[i] = value;
+    }
+}
+
+void ggml_sycl_op_ornith_shared_mul_add(
+        ggml_backend_sycl_context & ctx, ggml_tensor * mul, ggml_tensor * add) {
+    GGML_ASSERT(mul != nullptr && add != nullptr);
+    GGML_ASSERT(mul->op == GGML_OP_MUL && add->op == GGML_OP_ADD);
+    GGML_ASSERT(mul->type == GGML_TYPE_F32 && add->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(mul) && ggml_is_contiguous(add));
+    GGML_ASSERT(ggml_are_same_shape(mul, add) && ggml_nelements(add) == 2048);
+
+    const ggml_tensor * gate = ggml_nelements(mul->src[0]) == 1 ? mul->src[0] : mul->src[1];
+    const ggml_tensor * shared = gate == mul->src[0] ? mul->src[1] : mul->src[0];
+    const ggml_tensor * routed = add->src[0] == mul ? add->src[1] : add->src[0];
+    GGML_ASSERT(gate != nullptr && shared != nullptr && routed != nullptr);
+    GGML_ASSERT(gate->op == GGML_OP_UNARY && ggml_get_unary_op(gate) == GGML_UNARY_OP_SIGMOID);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32 && ggml_nelements(gate) == 1 && ggml_is_contiguous(gate));
+    GGML_ASSERT(shared->type == GGML_TYPE_F32 && routed->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(shared, mul) && ggml_are_same_shape(routed, add));
+    GGML_ASSERT(ggml_is_contiguous(shared) && ggml_is_contiguous(routed));
+
+    constexpr size_t block_size = 256;
+    const int64_t n = ggml_nelements(add);
+    const size_t blocks = ceil_div((size_t) n, block_size);
+    const sycl::nd_range<1> range(blocks * block_size, block_size);
+    const float * gate_src = static_cast<const float *>(gate->data);
+    const float * shared_data = static_cast<const float *>(shared->data);
+    const float * routed_data = static_cast<const float *>(routed->data);
+    volatile float * weighted_data = static_cast<float *>(mul->data);
+    float * dst_data = static_cast<float *>(add->data);
+    GGML_ASSERT(gate_src != nullptr && shared_data != nullptr && routed_data != nullptr &&
+                weighted_data != nullptr && dst_data != nullptr);
+    static const bool poison_enabled = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_SHARED_MUL_ADD_POISON");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+
+    if (poison_enabled) {
+        ctx.stream()->parallel_for(range, [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            ornith_shared_mul_add_kernel<true>(
+                gate_src, shared_data, routed_data, weighted_data, dst_data, n, item);
+        });
+    } else {
+        ctx.stream()->parallel_for(range, [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            ornith_shared_mul_add_kernel<false>(
+                gate_src, shared_data, routed_data, weighted_data, dst_data, n, item);
+        });
+    }
+}
