+    GGML_ASSERT(ggml_get_unary_op(silu) == GGML_UNARY_OP_SILU && silu->src[0] == conv);
+    GGML_ASSERT(conv->type == GGML_TYPE_F32 && silu->type == GGML_TYPE_F32);
+    GGML_ASSERT(conv->ne[0] == 8192 && conv->ne[1] == 1 && conv->ne[2] == 1 && conv->ne[3] == 1);
