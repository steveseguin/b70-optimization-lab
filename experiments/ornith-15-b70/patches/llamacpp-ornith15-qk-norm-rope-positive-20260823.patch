+            k_weight->ne[0] != 256 || ggml_nelements(k_weight) != 256 ||
+            k_weight->nb[0] != sizeof(float) || k_rope->type != GGML_TYPE_F32 ||
+            k_rope->ne[0] != 256 || k_rope->ne[1] != 2 || k_rope->ne[2] != 1 || k_rope->ne[3] != 1 ||
