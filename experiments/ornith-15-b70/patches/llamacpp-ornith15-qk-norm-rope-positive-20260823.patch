+struct ggml_sycl_ornith_qk_norm_rope_match {
+    ggml_tensor * q_rms;
+    ggml_tensor * q_mul;
+    ggml_tensor * q_rope;
+    ggml_tensor * k_rms;
+    ggml_tensor * k_mul;
