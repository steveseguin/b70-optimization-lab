+        }
+
+        const ggml_tensor * k_src = k_rms->src[0];
+        const ggml_tensor * k_weight = k_mul->src[0] == k_rms ? k_mul->src[1] : k_mul->src[0];
+        int k_layer = -1;
+        if (k_src == nullptr || k_weight == nullptr ||
+            std::sscanf(k_weight->name, "blk.%d.attn_k_norm.weight", &k_layer) != 1 ||
