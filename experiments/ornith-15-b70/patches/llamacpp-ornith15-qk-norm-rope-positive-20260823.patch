+        }
+
+        found = { q_rms, q_mul, q_rope, k_rms, k_mul, k_rope, set_rows, nodes_consumed };
+        ++matches;
+    }
+
+    if (matches != 1) {
+        return false;
+    }
+    match = found;
+    return true;
+}
