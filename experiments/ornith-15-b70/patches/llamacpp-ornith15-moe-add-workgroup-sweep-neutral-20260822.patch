+static bool ggml_sycl_ornith_conv_silu_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_CONV_SILU");
+        const bool on = value != nullptr && std::atoi(value) != 0;
+        if (on) {
