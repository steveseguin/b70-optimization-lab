+static void argmax_f32_i32_large_sycl(
+        const float * x, int * dst, int ncols,
+        float * partial_values, int * partial_indices,
+        int n_partials, queue_ptr stream) {
+    constexpr int block_size = SYCL_ARGMAX_BLOCK_SIZE;
+    const size_t shared_mem = block_size * sizeof(float);
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> shared_data(
+            sycl::range<1>(shared_mem / sizeof(float)), cgh);
+        sycl::local_accessor<int, 1> shared_indices(
+            sycl::range<1>(shared_mem / sizeof(float)), cgh);
+
+        cgh.parallel_for(
+            sycl::nd_range<1>(n_partials * block_size, block_size),
+            [=](sycl::nd_item<1> item) {
+                const int tid = item.get_local_id(0);
+                const int group = item.get_group(0);
+                const int global_size = item.get_global_range(0);
+
+                float max_val = -INFINITY;
+                int max_idx = -1;
+                for (int col = group * block_size + tid; col < ncols; col += global_size) {
+                    const float val = x[col];
+                    if (val > max_val) {
+                        max_val = val;
+                        max_idx = col;
+                    }
+                }
+
+                shared_data[tid] = max_val;
+                shared_indices[tid] = max_idx;
+                item.barrier(sycl::access::fence_space::local_space);
+
+                for (int stride = block_size / 2; stride > 0; stride >>= 1) {
+                    if (tid < stride) {
+                        const float other_val = shared_data[tid + stride];
+                        const int other_idx = shared_indices[tid + stride];
+                        const int own_idx = shared_indices[tid];
+                        if (other_val > shared_data[tid] ||
+                            (other_val == shared_data[tid] && other_idx >= 0 &&
+                             (own_idx < 0 || other_idx < own_idx))) {
+                            shared_data[tid] = other_val;
+                            shared_indices[tid] = other_idx;
+                        }
+                    }
+                    item.barrier(sycl::access::fence_space::local_space);
+                }
+
+                if (tid == 0) {
+                    partial_values[group] = shared_data[0];
+                    partial_indices[group] = shared_indices[0];
+                }
+            });
+    });
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> shared_data(
+            sycl::range<1>(shared_mem / sizeof(float)), cgh);
+        sycl::local_accessor<int, 1> shared_indices(
+            sycl::range<1>(shared_mem / sizeof(float)), cgh);
+
+        cgh.parallel_for(
+            sycl::nd_range<1>(block_size, block_size),
+            [=](sycl::nd_item<1> item) {
+                const int tid = item.get_local_id(0);
+                float max_val = tid < n_partials ? partial_values[tid] : -INFINITY;
+                int max_idx = tid < n_partials ? partial_indices[tid] : -1;
+                shared_data[tid] = max_val;
+                shared_indices[tid] = max_idx;
+                item.barrier(sycl::access::fence_space::local_space);
+
+                for (int stride = block_size / 2; stride > 0; stride >>= 1) {
+                    if (tid < stride) {
+                        const float other_val = shared_data[tid + stride];
+                        const int other_idx = shared_indices[tid + stride];
+                        const int own_idx = shared_indices[tid];
+                        if (other_val > shared_data[tid] ||
+                            (other_val == shared_data[tid] && other_idx >= 0 &&
+                             (own_idx < 0 || other_idx < own_idx))) {
+                            shared_data[tid] = other_val;
+                            shared_indices[tid] = other_idx;
+                        }
+                    }
+                    item.barrier(sycl::access::fence_space::local_space);
+                }
+
+                if (tid == 0) {
+                    dst[0] = shared_indices[0];
+                }
+            });
+    });
+}
