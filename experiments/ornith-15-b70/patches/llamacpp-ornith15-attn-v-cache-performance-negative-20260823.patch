+static bool ggml_sycl_find_ornith_attn_v_cache(
+        ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int node_idx,
+        ggml_sycl_ornith_attn_v_cache_match & match) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_attn_v_cache_enabled() ||
+        !g_ggml_sycl_enable_optimize || !ctx.opt_feature.reorder || !g_ggml_sycl_enable_esimd ||
+        cgraph == nullptr || node_idx < 0 || node_idx >= cgraph->n_nodes) {
+        return false;
+    }
+
+    ggml_tensor * v = cgraph->nodes[node_idx];
+    const ggml_tensor * weight = v != nullptr ? v->src[0] : nullptr;
+    const ggml_tensor * input = v != nullptr ? v->src[1] : nullptr;
+    int layer = -1;
+    int consumed = 0;
+    if (v == nullptr || weight == nullptr || input == nullptr || v->op != GGML_OP_MUL_MAT ||
+        std::sscanf(v->name, "Vcur-%d%n", &layer, &consumed) != 1 ||
+        consumed <= 0 || v->name[consumed] != '\0' ||
+        layer < 3 || layer >= 40 || layer % 4 != 3 ||
+        (weight->type != GGML_TYPE_Q4_K && weight->type != GGML_TYPE_Q6_K) ||
+        weight->ne[0] != 2048 || weight->ne[1] != 512 ||
+        weight->ne[2] != 1 || weight->ne[3] != 1 || !ggml_is_contiguous(weight) ||
+        ggml_backend_buffer_is_sycl_split(weight->buffer) ||
+        input->type != GGML_TYPE_F32 || input->ne[0] != 2048 || input->ne[1] != 1 ||
+        input->ne[2] != 1 || input->ne[3] != 1 || !ggml_is_contiguous(input) ||
+        v->type != GGML_TYPE_F32 || v->ne[0] != 512 || v->ne[1] != 1 ||
+        v->ne[2] != 1 || v->ne[3] != 1 || !ggml_is_contiguous(v) ||
+        (v->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        ggml_sycl_tensor_use_count(cgraph, v) != 1) {
+        return false;
+    }
+
+    char weight_name[64];
+    char input_name[64];
+    std::snprintf(weight_name, sizeof(weight_name), "blk.%d.attn_v.weight", layer);
+    std::snprintf(input_name, sizeof(input_name), "attn_norm-%d", layer);
+    if (std::strcmp(weight->name, weight_name) != 0 || std::strcmp(input->name, input_name) != 0) {
+        return false;
+    }
+
+    ggml_tensor * view = nullptr;
+    ggml_tensor * set_rows = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr || candidate->op != GGML_OP_SET_ROWS ||
+            candidate->src[0] == nullptr) {
+            continue;
+        }
+        ggml_tensor * candidate_view = nullptr;
+        if (candidate->src[0] == v) {
+            candidate_view = nullptr;
+        } else if (candidate->src[0]->op == GGML_OP_VIEW &&
+                   candidate->src[0]->src[0] != nullptr &&
+                   (candidate->src[0]->src[0] == v ||
+                    (candidate->src[0]->src[0]->op == GGML_OP_RESHAPE &&
+                     candidate->src[0]->src[0]->src[0] == v))) {
+            candidate_view = candidate->src[0];
+        } else {
+            continue;
+        }
+        if (set_rows != nullptr) {
+            return false;
+        }
+        view = candidate_view;
+        set_rows = candidate;
+    }
+    if (set_rows == nullptr || set_rows->src[1] == nullptr ||
+        set_rows->type != GGML_TYPE_F16 || set_rows->src[1]->type != GGML_TYPE_I64 ||
+        set_rows->src[1]->ne[0] != 1 || ggml_nelements(set_rows->src[1]) != 1 ||
+        set_rows->ne[0] != 512 || set_rows->nb[0] != sizeof(sycl::half) ||
+        set_rows->nb[1] < 512 * sizeof(sycl::half) ||
+        ggml_sycl_tensor_ranges_overlap(set_rows, weight) ||
+        ggml_sycl_tensor_ranges_overlap(set_rows, input) ||
+        ggml_sycl_tensor_ranges_overlap(set_rows, v)) {
+        return false;
+    }
+    if (view != nullptr &&
+        (ggml_sycl_tensor_use_count(cgraph, view) != 1 ||
+         view->type != GGML_TYPE_F32 || view->ne[0] != 512 || ggml_nelements(view) != 512 ||
+         !ggml_is_contiguous(view) || view->data != v->data ||
+         (view->flags & GGML_TENSOR_FLAG_OUTPUT) != 0)) {
+        return false;
+    }
+    if (view != nullptr && view->src[0] != v) {
+        const ggml_tensor * reshape = view->src[0];
+        if (reshape == nullptr || reshape->op != GGML_OP_RESHAPE || reshape->src[0] != v ||
+            reshape->type != GGML_TYPE_F32 || reshape->ne[0] != 256 || reshape->ne[1] != 2 ||
+            reshape->ne[2] != 1 || reshape->ne[3] != 1 || reshape->data != v->data ||
+            ggml_sycl_tensor_use_count(cgraph, reshape) != 1 ||
+            (reshape->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+            return false;
+        }
+    }
+
+    // The cache index must already exist when Vcur is submitted. A graph leaf
+    // is ready; a computed node is safe only when it precedes Vcur.
+    for (int j = 0; j < cgraph->n_nodes; ++j) {
+        if (cgraph->nodes[j] == set_rows->src[1] && j >= node_idx) {
+            return false;
+        }
+    }
+    match = { v, view, set_rows };
+    return true;
+}
