+static bool ggml_sycl_ornith_attn_v_cache_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_ATTN_V_CACHE");
+        const bool on = value != nullptr && std::atoi(value) != 0;
+        if (on) {
