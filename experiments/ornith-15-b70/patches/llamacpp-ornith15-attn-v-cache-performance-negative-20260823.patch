+template <ggml_type T>
+static bool ggml_sycl_dmmv_attn_v_cache_reorder_esimd_impl(
+        const void * weight, const float * activation, float * v_dst,
+        sycl::half * cache, const int64_t * cache_index,
+        size_t cache_row_stride, int ncols, int nrows, dpct::queue_ptr stream) {
+    if (ncols % QK_K != 0 || nrows != 512 || cache_row_stride < 512 * sizeof(sycl::half)) {
+        return false;
+    }
+    const int workgroups = (nrows + 1) / 2;
+    stream->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> lmem(
+            sycl::range<1>(GGML_SYCL_DMMV_ESIMD_WG_SIZE * 2), h);
+        h.parallel_for(
+            sycl::nd_range<1>(
+                sycl::range<1>((size_t) workgroups * GGML_SYCL_DMMV_ESIMD_WG_SIZE),
+                sycl::range<1>(GGML_SYCL_DMMV_ESIMD_WG_SIZE)),
+            [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                dequantize_mul_mat_vec_reorder_esimd<T>(
+                    weight, activation, v_dst, ncols, nrows, lmem, it);
+                if (it.get_local_id(0) == 0) {
+                    const int row0 = (int) it.get_group(0) * 2;
+                    const int64_t dst_row = cache_index[0];
+                    sycl::half * cache_row = reinterpret_cast<sycl::half *>(
+                        reinterpret_cast<char *>(cache) + (size_t) dst_row * cache_row_stride);
+                    cache_row[row0] = (sycl::half) v_dst[row0];
+                    if (row0 + 1 < nrows) {
+                        cache_row[row0 + 1] = (sycl::half) v_dst[row0 + 1];
+                    }
+                }
+            });
+    });
+    return true;
+}
+
+bool ggml_sycl_dmmv_attn_v_cache_reorder_esimd(
+        ggml_type weight_type, const void * weight, const float * activation,
+        float * v_dst, sycl::half * cache, const int64_t * cache_index,
+        size_t cache_row_stride, int ncols, int nrows, dpct::queue_ptr stream) {
+    switch (weight_type) {
+        case GGML_TYPE_Q4_K:
+            return ggml_sycl_dmmv_attn_v_cache_reorder_esimd_impl<GGML_TYPE_Q4_K>(
+                weight, activation, v_dst, cache, cache_index,
+                cache_row_stride, ncols, nrows, stream);
+        case GGML_TYPE_Q6_K:
+            return ggml_sycl_dmmv_attn_v_cache_reorder_esimd_impl<GGML_TYPE_Q6_K>(
+                weight, activation, v_dst, cache, cache_index,
+                cache_row_stride, ncols, nrows, stream);
+        default:
+            return false;
+    }
+}
