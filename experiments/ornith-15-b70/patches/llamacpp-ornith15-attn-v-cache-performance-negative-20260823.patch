+static bool ggml_sycl_run_ornith_attn_v_cache(
+        ggml_backend_sycl_context & ctx, const ggml_sycl_ornith_attn_v_cache_match & match) {
+    const ggml_tensor * weight = match.v->src[0];
+    const ggml_tensor * input = match.v->src[1];
+    opt_for_reorder(&ctx, weight, input, match.v, mul_mat_algo::DMMV);
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(weight->extra);
+    if (extra == nullptr || !extra->optimized_feature.reorder) {
+        return false;
+    }
+    scope_op_debug_print scope_dbg_print(
+        __func__, match.v, /*num_src=*/2, " : writes full-attention V cache row");
+    return ggml_sycl_dmmv_attn_v_cache_reorder_esimd(
+        weight->type, weight->data, (const float *) input->data, (float *) match.v->data,
+        (sycl::half *) match.set_rows->data, (const int64_t *) match.set_rows->src[1]->data,
+        match.set_rows->nb[1], 2048, 512, ctx.stream());
+}
