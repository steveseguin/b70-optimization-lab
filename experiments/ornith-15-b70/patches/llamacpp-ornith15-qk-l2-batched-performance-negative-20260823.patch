+static ggml_tensor * ggml_sycl_find_ornith_qk_l2_batched(
+        const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_qk_l2_batched_enabled() ||
+        cgraph == nullptr || node_idx < 0 || node_idx >= cgraph->n_nodes) {
+        return nullptr;
+    }
+    ggml_tensor * q = cgraph->nodes[node_idx];
+    if (q == nullptr || q->op != GGML_OP_L2_NORM || q->src[0] == nullptr ||
+        std::strstr(q->name, "q_conv_predelta-") == nullptr ||
+        q->type != GGML_TYPE_F32 || q->src[0]->type != GGML_TYPE_F32 ||
+        q->ne[0] != 128 || q->ne[1] != 16 || q->ne[2] != 1 || q->ne[3] != 1 ||
+        !ggml_is_contiguous(q) || !ggml_is_contiguous(q->src[0]) ||
+        (q->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        ggml_sycl_tensor_use_count(cgraph, q) != 1) {
+        return nullptr;
+    }
+
+    ggml_tensor * k = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr || ggml_sycl_is_view_or_noop(candidate) ||
+            (candidate->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        if (candidate->op == GGML_OP_L2_NORM && candidate->src[0] != nullptr &&
+            std::strstr(candidate->name, "k_conv_predelta-") != nullptr) {
+            k = candidate;
+        }
+        break;
+    }
+    if (k == nullptr || k->src[0] == nullptr || !ggml_are_same_shape(q, k) ||
+        k->type != GGML_TYPE_F32 || k->src[0]->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(k) || !ggml_is_contiguous(k->src[0]) ||
+        (k->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        ggml_sycl_tensor_use_count(cgraph, k) != 1 ||
+        std::memcmp(q->op_params, k->op_params, sizeof(float)) != 0) {
+        return nullptr;
+    }
+    const ggml_tensor * tensors[] = { q->src[0], q, k->src[0], k };
+    for (int a = 0; a < 4; ++a) {
+        for (int b = a + 1; b < 4; ++b) {
+            if (ggml_sycl_tensor_ranges_overlap(tensors[a], tensors[b])) {
+                return nullptr;
+            }
+        }
+    }
+    return k;
+}
