+        q->src[0]->type != GGML_TYPE_F32 || q->ne[0] != 128 || q->ne[1] != 16 ||
+        q->ne[2] != diagnostic_tokens || q->ne[3] != 1 ||
+        !ggml_is_contiguous(q) || !ggml_is_contiguous(q->src[0])) {
