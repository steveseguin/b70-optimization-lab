+void ggml_sycl_op_ornith_qk_l2_batched(
+        ggml_backend_sycl_context& ctx, ggml_tensor* q_dst, ggml_tensor* k_dst) {
+    GGML_ASSERT(q_dst != nullptr && k_dst != nullptr);
+    GGML_ASSERT(q_dst->op == GGML_OP_L2_NORM && k_dst->op == GGML_OP_L2_NORM);
+    GGML_ASSERT(q_dst->src[0] != nullptr && k_dst->src[0] != nullptr);
+    GGML_ASSERT(q_dst->type == GGML_TYPE_F32 && k_dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(q_dst->src[0]->type == GGML_TYPE_F32 && k_dst->src[0]->type == GGML_TYPE_F32);
+    GGML_ASSERT(q_dst->ne[0] == 128 && q_dst->ne[1] == 16 &&
+                q_dst->ne[2] == 1 && q_dst->ne[3] == 1);
+    GGML_ASSERT(ggml_are_same_shape(q_dst, k_dst));
+    GGML_ASSERT(ggml_is_contiguous(q_dst) && ggml_is_contiguous(k_dst));
+    GGML_ASSERT(ggml_is_contiguous(q_dst->src[0]) && ggml_is_contiguous(k_dst->src[0]));
+
+    float q_eps;
+    float k_eps;
+    memcpy(&q_eps, q_dst->op_params, sizeof(float));
+    memcpy(&k_eps, k_dst->op_params, sizeof(float));
+    GGML_ASSERT(q_eps >= 0.0f && q_eps == k_eps);
+
+    const float * q = static_cast<const float *>(q_dst->src[0]->data);
+    const float * k = static_cast<const float *>(k_dst->src[0]->data);
+    float * q_out = static_cast<float *>(q_dst->data);
+    float * k_out = static_cast<float *>(k_dst->data);
+
+    // Keep the stock helper's one-reduction-per-work-group code shape. The
+    // leading grid dimension merely batches Q and K into one queue submission.
+    const sycl::range<3> block_dims(1, 1, WARP_SIZE);
+    const sycl::range<3> grid_dims(2, 1, 16);
+    ctx.stream()->submit([&](sycl::handler& cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(grid_dims * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const bool use_k = item.get_group(0) != 0;
+                const float * src = use_k ? k : q;
+                float * dst = use_k ? k_out : q_out;
+                l2_norm_f32<WARP_SIZE>(src, dst, 128,
+                    1, 128, 0, 0, 1, 128, 0, 0,
+                    q_eps, item, nullptr, WARP_SIZE);
+            });
+    });
+}
