+// Bookkeeping/cursor update for commit_pending, launched AFTER the shift
+// kernel on the same queue. A separate kernel is required for correctness:
+// the shift work items read pending[]/pending_len[] while the cursor update
+// writes pending[]/write_pos[]/cache_base[]/is_flush[]; doing both in one
+// kernel raced (a work item could observe pending[slot]==0 cleared by the
+// row's elem==0 item and skip its portion of the shift, corrupting
+// conv_state).
+template <typename T>
+struct gdn_replayssm_commit_cursor_kernel {
+  static constexpr int group_size = 256;
+
+  gdn_replayssm_commit_cursor_kernel(
+      int* write_pos,
+      int* cache_base,
+      int8_t* is_flush,
+      int8_t* pending,
+      const int* pending_len,
+      const int* num_accepted_tokens,
+      const int64_t* state_indices,
+      const int rows,
+      const int num_slots,
+      const int max_cache_len,
+      const int max_spec_len,
+      const int null_block_id)
+      : write_pos(write_pos),
+        cache_base(cache_base),
+        is_flush(is_flush),
+        pending(pending),
+        pending_len(pending_len),
+        num_accepted_tokens(num_accepted_tokens),
+        state_indices(state_indices),
+        rows(rows),
+        num_slots(num_slots),
+        max_cache_len(max_cache_len),
+        max_spec_len(max_spec_len),
+        null_block_id(null_block_id) {}
+
+  static inline sycl::nd_range<1> get_nd_range(const int rows) {
+    sycl::range<1> local(group_size);
+    sycl::range<1> global((rows + group_size - 1) / group_size);
+    return sycl::nd_range<1>(global * local, local);
+  }
+
+  void operator()(sycl::nd_item<1> item) const {
+    const int row = item.get_global_linear_id();
+    if (row >= rows) {
+      return;
+    }
+    const int64_t raw_slot = state_indices[row];
+    if (raw_slot <= static_cast<int64_t>(null_block_id) ||
+        raw_slot >= static_cast<int64_t>(num_slots)) {
+      return;
+    }
+    const int slot = static_cast<int>(raw_slot);
+    if (pending[slot] == 0) {
+      return;
+    }
+    int accepted = num_accepted_tokens[row];
+    if (accepted < 0) {
+      accepted = 0;
+    }
+    const int prev_len = pending_len[slot];
+    if (accepted > prev_len) {
+      accepted = prev_len;
+    }
+    const int old_wp = write_pos[slot];
+    const int old_base = cache_base[slot];
+    const bool old_flush = is_flush[slot] != 0;
+    const bool flush_now = accepted > 0 && old_flush;
+    const int new_base =
+        flush_now ? (old_base + old_wp) & (max_cache_len - 1) : old_base;
+    const int new_wp = old_flush ? accepted : old_wp + accepted;
+    const bool next_flush = (new_wp + 2 * max_spec_len) > max_cache_len;
+    write_pos[slot] = new_wp;
+    cache_base[slot] = new_base;
+    is_flush[slot] = next_flush ? int8_t(1) : int8_t(0);
+    pending[slot] = int8_t(0);
+  }
+
+ private:
+  int* write_pos;
+  int* cache_base;
+  int8_t* is_flush;
+  int8_t* pending;
+  const int* pending_len;
+  const int* num_accepted_tokens;
+  const int64_t* state_indices;
+  const int rows;
+  const int num_slots;
+  const int max_cache_len;
+  const int max_spec_len;
+  const int null_block_id;
+};
+
