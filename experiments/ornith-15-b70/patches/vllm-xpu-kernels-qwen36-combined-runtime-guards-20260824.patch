   });
+  // Ordered after the shift kernel on this queue: fixes the bookkeeping
+  // read/write race (see gdn_replayssm_commit_cursor_kernel comment).
+  using CURSOR_KERNEL = gdn_replayssm_commit_cursor_kernel<T>;
+  auto cursor_range = CURSOR_KERNEL::get_nd_range(rows);
+  queue.submit([&](sycl::handler& cgh) {
+    CURSOR_KERNEL task(
+        reinterpret_cast<int*>(write_pos.data_ptr()),
+        reinterpret_cast<int*>(cache_base.data_ptr()),
+        reinterpret_cast<int8_t*>(is_flush.data_ptr()),
+        reinterpret_cast<int8_t*>(pending.data_ptr()),
+        reinterpret_cast<const int*>(pending_len.data_ptr()),
+        reinterpret_cast<const int*>(num_accepted_tokens.data_ptr()),
+        reinterpret_cast<const int64_t*>(state_indices.data_ptr()),
+        rows,
+        conv_state.size(0),
+        max_cache_len,
+        max_spec_len,
+        null_block_id);
+    cgh.parallel_for(cursor_range, task);
+  });
 }
 
