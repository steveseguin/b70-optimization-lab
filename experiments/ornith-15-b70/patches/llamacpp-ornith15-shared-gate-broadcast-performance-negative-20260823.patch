+// Ornith/Qwen35 MoE shared-expert gate: retain the stock scalar projection,
+// then apply sigmoid and its broadcast multiply in one kernel.
+void ggml_sycl_op_ornith_shared_gate_broadcast_fused(
+        ggml_backend_sycl_context & ctx, ggml_tensor * sigmoid_node,
+        ggml_tensor * mul_node) {
+    scope_op_debug_print scope_dbg_print(__func__, mul_node, /*num_src=*/2);
+
+    GGML_ASSERT(sigmoid_node != nullptr && mul_node != nullptr);
+    GGML_ASSERT(sigmoid_node->op == GGML_OP_UNARY);
+    GGML_ASSERT(ggml_get_unary_op(sigmoid_node) == GGML_UNARY_OP_SIGMOID);
+    const ggml_tensor * gate = sigmoid_node->src[0];
+    const ggml_tensor * shared = mul_node->src[0] == sigmoid_node ? mul_node->src[1] : mul_node->src[0];
+    GGML_ASSERT(gate != nullptr && shared != nullptr);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32);
+    GGML_ASSERT(shared->type == GGML_TYPE_F32 && mul_node->type == GGML_TYPE_F32);
+
+    constexpr int n = 2048;
+    constexpr int block = 256;
+    const float * gate_data = static_cast<const float *>(gate->data);
+    const float * shared_data = static_cast<const float *>(shared->data);
+    float * dst_data = static_cast<float *>(mul_node->data);
+    queue_ptr stream = ctx.stream();
+
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>(n), sycl::range<1>(block)),
+                [=](sycl::nd_item<1> item) {
+            const int i = item.get_global_id(0);
+            dst_data[i] = shared_data[i] * op_sigmoid(gate_data[0]);
+        });
+    });
+}
+
+void ggml_sycl_op_add_softplus_mul_fused(
+        ggml_backend_sycl_context & ctx, ggml_tensor * add_node,
+        ggml_tensor * softplus_node, ggml_tensor * mul_node) {
+    scope_op_debug_print scope_dbg_print(__func__, mul_node, /*num_src=*/3);
+
+    GGML_ASSERT(add_node != nullptr && softplus_node != nullptr && mul_node != nullptr);
+    GGML_ASSERT(add_node->op == GGML_OP_ADD);
+    GGML_ASSERT(softplus_node->op == GGML_OP_UNARY);
+    GGML_ASSERT(ggml_get_unary_op(softplus_node) == GGML_UNARY_OP_SOFTPLUS);
+    GGML_ASSERT(mul_node->op == GGML_OP_MUL);
+    GGML_ASSERT(add_node->src[0] != nullptr && add_node->src[1] != nullptr);
+    GGML_ASSERT(softplus_node->src[0] == add_node);
+
+    const ggml_tensor * other = mul_node->src[0] == softplus_node
+        ? mul_node->src[1] : mul_node->src[0];
+    GGML_ASSERT(other != nullptr && other != softplus_node);
+    GGML_ASSERT(add_node->type == GGML_TYPE_F32);
+    GGML_ASSERT(add_node->src[0]->type == GGML_TYPE_F32);
+    GGML_ASSERT(add_node->src[1]->type == GGML_TYPE_F32);
+    GGML_ASSERT(softplus_node->type == GGML_TYPE_F32);
+    GGML_ASSERT(other->type == GGML_TYPE_F32 && mul_node->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(add_node) == 32);
+
+    queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const float * lhs = (const float *) add_node->src[0]->data;
+    const float * rhs = (const float *) add_node->src[1]->data;
+    const float * gate = (const float *) other->data;
+    volatile float * add_out = (volatile float *) add_node->data;
+    float * mul_out = (float *) mul_node->data;
+
+    stream->parallel_for(sycl::range<1>(32), [=](sycl::id<1> item) {
+        const size_t i = item[0];
+        add_out[i] = lhs[i] + rhs[i];
+        const float rounded_sum = add_out[i];
+        mul_out[i] = op_softplus(rounded_sum) * gate[i];
+    });
+}
