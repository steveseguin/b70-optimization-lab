+    const int32_t * ids_dev, float * dst_base, const int ncols,
+    const int nrows, const int n_experts_used, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t src1_row_stride,
+    const ggml_glu_op glu_op, dpct::queue_ptr stream) {
+    const int block_num_y = (nrows + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
