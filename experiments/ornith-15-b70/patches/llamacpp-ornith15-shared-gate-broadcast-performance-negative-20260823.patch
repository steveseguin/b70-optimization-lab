+static ggml_tensor * ggml_sycl_find_ornith_conv_silu(const ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_conv_silu_enabled()) {
+        return nullptr;
+    }
+    ggml_tensor * conv = cgraph->nodes[node_idx];
+    if (conv == nullptr || conv->op != GGML_OP_SSM_CONV || conv->src[0] == nullptr || conv->src[1] == nullptr ||
+        conv->type != GGML_TYPE_F32 || std::strstr(conv->name, "conv_output_raw-") == nullptr ||
+        conv->ne[0] != 8192 || conv->ne[1] != 1 || conv->ne[2] != 1 || conv->ne[3] != 1 ||
+        conv->src[0]->type != GGML_TYPE_F32 || conv->src[0]->ne[0] != 4 || conv->src[0]->ne[1] != 8192 ||
+        conv->src[0]->ne[2] != 1 || conv->src[0]->ne[3] != 1 || conv->src[0]->nb[0] != sizeof(float) ||
+        conv->src[0]->nb[1] != 4 * sizeof(float) || conv->src[1]->type != GGML_TYPE_F32 ||
+        conv->src[1]->ne[0] != 4 || conv->src[1]->ne[1] != 8192 ||
+        conv->src[1]->nb[0] != sizeof(float) || conv->src[1]->nb[1] != 4 * sizeof(float) ||
+        (conv->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return nullptr;
+    }
+
+    ggml_tensor * silu = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * consumer = cgraph->nodes[j];
+        if (consumer == nullptr) {
+            continue;
+        }
+        for (int s = 0; s < GGML_MAX_SRC; ++s) {
+            if (consumer->src[s] != conv) {
+                continue;
+            }
+            if (s != 0 || silu != nullptr || consumer->op != GGML_OP_UNARY ||
+                ggml_get_unary_op(consumer) != GGML_UNARY_OP_SILU || consumer->type != GGML_TYPE_F32 ||
+                !ggml_are_same_shape(conv, consumer) || !ggml_is_contiguous(consumer) ||
+                std::strstr(consumer->name, "conv_output_silu-") == nullptr ||
+                (consumer->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+                return nullptr;
+            }
+            silu = consumer;
+        }
+    }
+    return silu;
+}
