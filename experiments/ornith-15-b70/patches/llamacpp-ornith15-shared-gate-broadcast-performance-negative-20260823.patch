+        !ggml_are_same_shape(add, softplus) || !ggml_are_same_shape(add, mul) ||
+        !ggml_is_contiguous(add) || !ggml_is_contiguous(add->src[0]) ||
+        !ggml_is_contiguous(add->src[1]) || !ggml_is_contiguous(mul) ||
+        (add->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
