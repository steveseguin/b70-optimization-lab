+template <ggml_type V_TYPE>
+static bool ggml_sycl_dmmv_attn_vk_pair_reorder_esimd_impl(
+        const void * v_weight, float * v_dst,
+        const void * k_weight, float * k_dst,
+        const float * activation, int ncols, int nrows,
+        dpct::queue_ptr stream) {
+    if (ncols % QK_K != 0 || nrows <= 0) {
+        return false;
+    }
+
+    const int groups = (nrows + 1) / 2;
+    stream->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> lmem(
+            sycl::range<1>(GGML_SYCL_DMMV_ESIMD_WG_SIZE * 2), h);
+        h.parallel_for(
+            sycl::nd_range<1>(
+                sycl::range<1>((size_t) groups * 2 * GGML_SYCL_DMMV_ESIMD_WG_SIZE),
+                sycl::range<1>(GGML_SYCL_DMMV_ESIMD_WG_SIZE)),
+            [=](sycl::nd_item<1> it) [[intel::sycl_explicit_simd]] {
+                if (it.get_group(0) < (size_t) groups) {
+                    dequantize_mul_mat_vec_reorder_esimd<V_TYPE>(
+                        v_weight, activation, v_dst, ncols, nrows, lmem, it);
+                } else {
+                    dequantize_mul_mat_vec_reorder_esimd<GGML_TYPE_Q4_K>(
+                        k_weight, activation, k_dst, ncols, nrows, lmem, it, groups);
+                }
+            });
+    });
+    return true;
+}
+
+bool ggml_sycl_dmmv_attn_vk_pair_reorder_esimd(
+        ggml_type v_type, const void * v_weight, float * v_dst,
+        const void * k_weight, float * k_dst,
+        const float * activation, int ncols, int nrows,
+        dpct::queue_ptr stream) {
+    switch (v_type) {
+        case GGML_TYPE_Q4_K:
+            return ggml_sycl_dmmv_attn_vk_pair_reorder_esimd_impl<GGML_TYPE_Q4_K>(
+                v_weight, v_dst, k_weight, k_dst, activation, ncols, nrows, stream);
+        case GGML_TYPE_Q6_K:
+            return ggml_sycl_dmmv_attn_vk_pair_reorder_esimd_impl<GGML_TYPE_Q6_K>(
+                v_weight, v_dst, k_weight, k_dst, activation, ncols, nrows, stream);
+        default:
+            return false;
+    }
+}
