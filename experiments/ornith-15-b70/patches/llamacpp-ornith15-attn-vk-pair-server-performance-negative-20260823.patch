+struct ggml_sycl_ornith_attn_vk_pair_match {
+    ggml_tensor * v = nullptr;
+    ggml_tensor * k = nullptr;
+};
+
+static std::atomic<uint64_t> g_ggml_sycl_ornith_attn_vk_pair_hits{0};
+
+static bool ggml_sycl_ornith_attn_vk_pair_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_ATTN_VK_PAIR");
+        const bool on = value != nullptr && std::atoi(value) != 0;
+        if (on) {
+            std::atexit([] {
+                std::fprintf(stderr, "ggml_sycl_ornith_attn_vk_pair: fused_hits=%" PRIu64 "\n",
+                    g_ggml_sycl_ornith_attn_vk_pair_hits.load(std::memory_order_relaxed));
+            });
+        }
+        return on;
+    }();
+    return enabled;
+}
+
+static bool ggml_sycl_ornith_attn_vk_projection(
+        const ggml_tensor * projection, const ggml_tensor * input,
+        const char * output_name, const char * weight_name, bool allow_q6_k) {
+    const ggml_tensor * weight = projection != nullptr ? projection->src[0] : nullptr;
+    return projection != nullptr && projection->op == GGML_OP_MUL_MAT &&
+           (projection->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 &&
+           (projection->flags & GGML_TENSOR_FLAG_OUTPUT) == 0 &&
+           projection->src[1] == input && projection->type == GGML_TYPE_F32 &&
+           projection->ne[0] == 512 && projection->ne[1] == 1 &&
+           projection->ne[2] == 1 && projection->ne[3] == 1 &&
+           ggml_is_contiguous(projection) && std::strcmp(projection->name, output_name) == 0 &&
+           weight != nullptr && std::strcmp(weight->name, weight_name) == 0 &&
+           (weight->type == GGML_TYPE_Q4_K || (allow_q6_k && weight->type == GGML_TYPE_Q6_K)) &&
+           weight->ne[0] == 2048 && weight->ne[1] == 512 &&
+           weight->ne[2] == 1 && weight->ne[3] == 1 && ggml_is_contiguous(weight) &&
+           !ggml_backend_buffer_is_sycl_split(weight->buffer);
+}
+
+static bool ggml_sycl_find_ornith_attn_vk_pair(
+        ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int node_idx,
+        ggml_sycl_ornith_attn_vk_pair_match & match) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_attn_vk_pair_enabled() ||
+        !g_ggml_sycl_enable_optimize || !ctx.opt_feature.reorder || !g_ggml_sycl_enable_esimd ||
+        node_idx < 0 || node_idx >= cgraph->n_nodes) {
+        return false;
+    }
+
+    ggml_tensor * v = cgraph->nodes[node_idx];
+    const ggml_tensor * input = v != nullptr ? v->src[1] : nullptr;
+    int layer = -1;
+    int consumed = 0;
+    if (v == nullptr || input == nullptr ||
+        std::sscanf(v->name, "Vcur-%d%n", &layer, &consumed) != 1 ||
+        consumed <= 0 || v->name[consumed] != '\0' ||
+        layer < 3 || layer >= 40 || layer % 4 != 3 ||
+        input->type != GGML_TYPE_F32 || input->ne[0] != 2048 || input->ne[1] != 1 ||
+        input->ne[2] != 1 || input->ne[3] != 1 || !ggml_is_contiguous(input)) {
+        return false;
+    }
+
+    char input_name[64];
+    char v_output[64];
+    char k_output[64];
+    char v_weight[64];
+    char k_weight[64];
+    std::snprintf(input_name, sizeof(input_name), "attn_norm-%d", layer);
+    std::snprintf(v_output, sizeof(v_output), "Vcur-%d", layer);
+    std::snprintf(k_output, sizeof(k_output), "Kcur-%d", layer);
+    std::snprintf(v_weight, sizeof(v_weight), "blk.%d.attn_v.weight", layer);
+    std::snprintf(k_weight, sizeof(k_weight), "blk.%d.attn_k.weight", layer);
+    if (std::strcmp(input->name, input_name) != 0 ||
+        !ggml_sycl_ornith_attn_vk_projection(v, input, v_output, v_weight, true) ||
+        !should_reorder_tensor(ctx, v) ||
+        !ggml_sycl_supports_reorder_esimd(v->src[0]->type)) {
+        return false;
+    }
+
+    ggml_tensor * k = nullptr;
+    const int search_end = std::min(cgraph->n_nodes, node_idx + 8);
+    for (int i = node_idx + 1; i < search_end; ++i) {
+        ggml_tensor * candidate = cgraph->nodes[i];
+        if (candidate == nullptr || candidate->op != GGML_OP_MUL_MAT ||
+            std::strcmp(candidate->name, k_output) != 0) {
+            continue;
+        }
+        if (k != nullptr) {
+            return false;
+        }
+        k = candidate;
+    }
+    if (!ggml_sycl_ornith_attn_vk_projection(k, input, k_output, k_weight, false) ||
+        !should_reorder_tensor(ctx, k) || !ggml_sycl_supports_reorder_esimd(k->src[0]->type) ||
+        v->data == k->data) {
+        return false;
+    }
+
+    if (const char * poison = std::getenv("GGML_SYCL_FUSED_ORNITH_ATTN_VK_PAIR_POISON");
+        poison != nullptr && std::atoi(poison) != 0) {
+        GGML_ABORT("Ornith attention V/K pair strict matcher fired");
+    }
+
+    match = { v, k };
+    return true;
+}
+
+static bool ggml_sycl_run_ornith_attn_vk_pair(
+        ggml_backend_sycl_context & ctx, const ggml_sycl_ornith_attn_vk_pair_match & match) {
+    const ggml_tensor * input = match.v->src[1];
+    opt_for_reorder(&ctx, match.v->src[0], input, match.v, mul_mat_algo::DMMV);
+    opt_for_reorder(&ctx, match.k->src[0], input, match.k, mul_mat_algo::DMMV);
+
+    const auto * v_extra = static_cast<const ggml_tensor_extra_gpu *>(match.v->src[0]->extra);
+    const auto * k_extra = static_cast<const ggml_tensor_extra_gpu *>(match.k->src[0]->extra);
+    if (v_extra == nullptr || k_extra == nullptr ||
+        !v_extra->optimized_feature.reorder || !k_extra->optimized_feature.reorder) {
+        return false;
+    }
+
+    scope_op_debug_print scope_dbg_print(
+        __func__, match.v, /*num_src=*/2, " : paired with full-attention K projection");
+    return ggml_sycl_dmmv_attn_vk_pair_reorder_esimd(
+        match.v->src[0]->type, match.v->src[0]->data, (float *) match.v->data,
+        match.k->src[0]->data, (float *) match.k->data,
+        (const float *) input->data, 2048, 512, ctx.stream());
+}
