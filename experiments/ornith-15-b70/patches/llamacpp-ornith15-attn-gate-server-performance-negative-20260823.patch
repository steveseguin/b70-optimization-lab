+void ggml_sycl_op_ornith_attn_gate_fused(
+        ggml_backend_sycl_context & ctx, const ggml_tensor * gate_view,
+        const ggml_tensor * attention, ggml_tensor * dst) {
+    GGML_ASSERT(gate_view != nullptr && attention != nullptr && dst != nullptr);
+    GGML_ASSERT(gate_view->type == GGML_TYPE_F32 && attention->type == GGML_TYPE_F32 &&
+                dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(gate_view->ne[0] == 256 && gate_view->ne[1] == 16 &&
+                gate_view->ne[2] == 1 && gate_view->ne[3] == 1);
+    GGML_ASSERT(ggml_nelements(attention) == 4096 && ggml_nelements(dst) == 4096);
+    GGML_ASSERT(gate_view->nb[0] == sizeof(float) && gate_view->nb[1] % sizeof(float) == 0);
+    GGML_ASSERT(ggml_is_contiguous(attention) && ggml_is_contiguous(dst));
+
+    const float * gate = (const float *) gate_view->data;
+    const float * attn = (const float *) attention->data;
+    float * out = (float *) dst->data;
+    const size_t gate_row_stride = gate_view->nb[1] / sizeof(float);
+    constexpr int n = 4096;
+    constexpr int block = 256;
+    ctx.stream()->parallel_for(
+        sycl::nd_range<1>(n, block),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const int i = (int) item.get_global_linear_id();
+            const int i0 = i & 255;
+            const int i1 = i >> 8;
+            const float gate_value = gate[(size_t) i1 * gate_row_stride + i0];
+            out[i] = attn[i] * op_sigmoid(gate_value);
+        });
+}
