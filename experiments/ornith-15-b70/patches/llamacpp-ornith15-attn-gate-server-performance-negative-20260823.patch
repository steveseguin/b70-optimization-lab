+static bool ggml_sycl_find_ornith_attn_gate(
+        const ggml_cgraph * cgraph, int node_idx, ggml_sycl_ornith_attn_gate_match & match) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_attn_gate_enabled() ||
+        cgraph == nullptr || node_idx < 0 || node_idx + 2 >= cgraph->n_nodes) {
+        return false;
+    }
+    ggml_tensor * cont = cgraph->nodes[node_idx];
+    ggml_tensor * unary = cgraph->nodes[node_idx + 1];
+    ggml_tensor * mul = cgraph->nodes[node_idx + 2];
+    ggml_tensor * view = cont != nullptr ? cont->src[0] : nullptr;
+    ggml_tensor * q_full = view != nullptr ? view->src[0] : nullptr;
+    int layer = -1;
+    int consumed = 0;
+    if (cont == nullptr || unary == nullptr || mul == nullptr || view == nullptr || q_full == nullptr ||
+        cont->op != GGML_OP_CONT || unary->op != GGML_OP_UNARY || mul->op != GGML_OP_MUL ||
+        ggml_get_unary_op(unary) != GGML_UNARY_OP_SIGMOID || unary->src[0] != cont ||
+        std::sscanf(cont->name, "gate_reshaped-%d%n", &layer, &consumed) != 1 ||
+        consumed <= 0 || cont->name[consumed] != '\0' ||
+        layer < 3 || layer >= 40 || layer % 4 != 3 ||
+        cont->type != GGML_TYPE_F32 || cont->ne[0] != 4096 || cont->ne[1] != 1 ||
+        cont->ne[2] != 1 || cont->ne[3] != 1 || !ggml_is_contiguous(cont) ||
+        view->op != GGML_OP_VIEW || view->type != GGML_TYPE_F32 ||
+        view->ne[0] != 256 || view->ne[1] != 16 || view->ne[2] != 1 || view->ne[3] != 1 ||
+        view->nb[0] != sizeof(float) || view->nb[1] % sizeof(float) != 0 ||
+        q_full->op != GGML_OP_MUL_MAT || q_full->type != GGML_TYPE_F32 ||
+        q_full->ne[0] != 8192 || q_full->ne[1] != 1 ||
+        ggml_sycl_tensor_use_count(cgraph, view) != 1 ||
+        (cont->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        (unary->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        !ggml_sycl_can_fuse(cgraph, node_idx + 1,
+            { GGML_OP_UNARY, GGML_OP_MUL }, { GGML_UNARY_OP_SIGMOID })) {
+        return false;
+    }
+
+    char q_name[64];
+    char view_name[64];
+    char unary_name[64];
+    char mul_name[64];
+    std::snprintf(q_name, sizeof(q_name), "Qcur_full-%d", layer);
+    std::snprintf(view_name, sizeof(view_name), "Qcur_full-%d (view)", layer);
+    std::snprintf(unary_name, sizeof(unary_name), "gate_sigmoid-%d", layer);
+    std::snprintf(mul_name, sizeof(mul_name), "attn_gated-%d", layer);
+    if (std::strcmp(q_full->name, q_name) != 0 || std::strcmp(view->name, view_name) != 0 ||
+        std::strcmp(unary->name, unary_name) != 0 || std::strcmp(mul->name, mul_name) != 0) {
+        return false;
+    }
+
+    ggml_tensor * attention = mul->src[0] == unary ? mul->src[1] : mul->src[0];
+    if (attention == nullptr || attention == unary || attention->type != GGML_TYPE_F32 ||
+        attention->ne[0] != 4096 || attention->ne[1] != 1 ||
+        attention->ne[2] != 1 || attention->ne[3] != 1 ||
+        !ggml_is_contiguous(attention) || mul->type != GGML_TYPE_F32 ||
+        !ggml_are_same_shape(attention, mul) || !ggml_is_contiguous(mul) ||
+        ggml_sycl_tensor_ranges_overlap(mul, view) ||
+        ggml_sycl_tensor_ranges_overlap(mul, attention)) {
+        return false;
+    }
+
+    char attention_name[64];
+    std::snprintf(attention_name, sizeof(attention_name), "attn_pregate-%d", layer);
+    if (std::strcmp(attention->name, attention_name) != 0) {
+        return false;
+    }
+    match = { cont, unary, mul, view, attention };
+    return true;
+}
