+    const ggml_op ops[n_adds] = {
+        GGML_OP_ADD, GGML_OP_ADD, GGML_OP_ADD, GGML_OP_ADD,
+        GGML_OP_ADD, GGML_OP_ADD, GGML_OP_ADD,
+    };
+    if (!ggml_can_fuse_ext(cgraph, add_idxs, ops, n_adds)) {
