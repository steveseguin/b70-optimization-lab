+struct ggml_sycl_ornith_shared_q8_plan {
+    ggml_tensor * qkv  = nullptr;
+    ggml_tensor * z    = nullptr;
+    ggml_tensor * alpha = nullptr;
+    ggml_tensor * beta  = nullptr;
+    char * scratch = nullptr;
+    bool active = false;
+};
+
+static constexpr int64_t GGML_SYCL_ORNITH_SHARED_Q8_INPUT_SIZE = 2048;
+
+static size_t ggml_sycl_ornith_shared_q8_scratch_bytes() {
+    const int64_t padded = GGML_PAD(GGML_SYCL_ORNITH_SHARED_Q8_INPUT_SIZE, MATRIX_ROW_PADDING);
+    return padded * sizeof(block_q8_1) / QK8_1;
+}
+
+static std::atomic<uint64_t> g_ggml_sycl_ornith_shared_q8_inputs{0};
+static std::atomic<uint64_t> g_ggml_sycl_ornith_shared_q8_projections{0};
+
+static int ggml_sycl_ornith_shared_q8_mode() {
+    static const int mode = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_SHARED_Q8");
+        const int requested = value != nullptr ? std::atoi(value) : 0;
+        if (requested != 0) {
+            std::atexit([] {
+                std::fprintf(stderr,
+                    "ggml_sycl_ornith_shared_q8: quantized_inputs=%" PRIu64
+                    " projection_hits=%" PRIu64 "\n",
+                    g_ggml_sycl_ornith_shared_q8_inputs.load(std::memory_order_relaxed),
+                    g_ggml_sycl_ornith_shared_q8_projections.load(std::memory_order_relaxed));
+            });
+        }
+        return requested;
+    }();
+    return mode;
+}
+
+static bool ggml_sycl_ornith_shared_q8_enabled() {
+    return ggml_sycl_ornith_shared_q8_mode() != 0;
+}
+
+static bool ggml_sycl_ornith_projection_shape(
+        const ggml_tensor * node, const ggml_tensor * input,
+        const char * weight_name, enum ggml_type weight_type, int64_t output_size) {
+    const ggml_tensor * weight = node != nullptr ? node->src[0] : nullptr;
+    return node != nullptr && node->op == GGML_OP_MUL_MAT &&
+           (node->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 &&
+           (node->flags & GGML_TENSOR_FLAG_OUTPUT) == 0 &&
+           node->src[1] == input && node->type == GGML_TYPE_F32 &&
+           node->ne[0] == output_size && node->ne[1] == 1 &&
+           node->ne[2] == 1 && node->ne[3] == 1 && ggml_is_contiguous(node) &&
+           weight != nullptr && std::strcmp(weight->name, weight_name) == 0 &&
+           weight->type == weight_type && weight->ne[0] == 2048 &&
+           weight->ne[1] == output_size && weight->ne[2] == 1 && weight->ne[3] == 1 &&
+           ggml_is_contiguous(weight) && !ggml_backend_buffer_is_sycl_split(weight->buffer);
+}
+
+static bool ggml_sycl_find_ornith_shared_q8(
+        ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx,
+        ggml_sycl_ornith_shared_q8_plan & plan) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_shared_q8_enabled() ||
+        g_ggml_sycl_prioritize_dmmv || !g_ggml_sycl_enable_optimize ||
+        !ctx.opt_feature.reorder || node_idx < 0 || node_idx >= cgraph->n_nodes) {
+        return false;
+    }
+
+    ggml_tensor * qkv = cgraph->nodes[node_idx];
+    const ggml_tensor * input = qkv != nullptr ? qkv->src[1] : nullptr;
+    const ggml_tensor * qkv_weight = qkv != nullptr ? qkv->src[0] : nullptr;
+    if (input == nullptr || qkv_weight == nullptr || input->type != GGML_TYPE_F32 ||
+        input->ne[0] != 2048 || input->ne[1] != 1 || input->ne[2] != 1 || input->ne[3] != 1 ||
+        !ggml_is_contiguous(input)) {
+        return false;
+    }
+
+    int layer = -1;
+    if (std::sscanf(qkv_weight->name, "blk.%d.attn_qkv.weight", &layer) != 1 ||
+        layer < 0 || layer >= 40) {
+        return false;
+    }
+
+    char qkv_name[64];
+    char z_name[64];
+    char alpha_name[64];
+    char beta_name[64];
+    std::snprintf(qkv_name, sizeof(qkv_name), "blk.%d.attn_qkv.weight", layer);
+    std::snprintf(z_name, sizeof(z_name), "blk.%d.attn_gate.weight", layer);
+    std::snprintf(alpha_name, sizeof(alpha_name), "blk.%d.ssm_alpha.weight", layer);
+    std::snprintf(beta_name, sizeof(beta_name), "blk.%d.ssm_beta.weight", layer);
+    if (!ggml_sycl_ornith_projection_shape(qkv, input, qkv_name, GGML_TYPE_Q6_K, 8192)) {
+        return false;
+    }
+
+    ggml_tensor * z = nullptr;
+    ggml_tensor * alpha = nullptr;
+    ggml_tensor * beta = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr || candidate->op != GGML_OP_MUL_MAT || candidate->src[1] != input) {
+            continue;
+        }
+        if (candidate->src[0] != nullptr && std::strcmp(candidate->src[0]->name, z_name) == 0) {
+            if (z != nullptr || !ggml_sycl_ornith_projection_shape(
+                    candidate, input, z_name, GGML_TYPE_Q4_K, 4096)) {
+                return false;
+            }
+            z = candidate;
+        } else if (candidate->src[0] != nullptr && std::strcmp(candidate->src[0]->name, alpha_name) == 0) {
+            if (alpha != nullptr || !ggml_sycl_ornith_projection_shape(
+                    candidate, input, alpha_name, GGML_TYPE_Q4_K, 32)) {
+                return false;
+            }
+            alpha = candidate;
+        } else if (candidate->src[0] != nullptr && std::strcmp(candidate->src[0]->name, beta_name) == 0) {
+            if (beta != nullptr || !ggml_sycl_ornith_projection_shape(
+                    candidate, input, beta_name, GGML_TYPE_Q4_K, 32)) {
+                return false;
+            }
+            beta = candidate;
+        }
+    }
+    if (z == nullptr || alpha == nullptr || beta == nullptr) {
+        return false;
+    }
+
+    plan.qkv = qkv;
