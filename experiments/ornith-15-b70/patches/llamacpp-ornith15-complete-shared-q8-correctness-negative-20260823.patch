+    if (weighted == nullptr || weighted->type != GGML_TYPE_F32 ||
+        weighted->ne[1] != n_experts || weighted->ne[2] != 1 || weighted->ne[3] != 1 ||
+        !ggml_is_contiguous(weighted)) {
