+               view->view_offs == (size_t) expert * weighted->nb[1] &&
+               view->type == GGML_TYPE_F32 && ggml_nelements(view) == row_len &&
+               view->ne[0] == row_len && view->ne[1] == 1 && view->ne[2] == 1 && view->ne[3] == 1 &&
