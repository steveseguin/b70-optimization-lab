+        return false;
+    }
+    for (int expert = 2; expert < n_experts; ++expert) {
+        ggml_tensor * add = cgraph->nodes[add_idxs[expert - 1]];
+        ggml_tensor * prev = cgraph->nodes[add_idxs[expert - 2]];
+        if (add->src[0] != prev || !is_expert_row(add->src[1], expert)) {
+            return false;
+        }
