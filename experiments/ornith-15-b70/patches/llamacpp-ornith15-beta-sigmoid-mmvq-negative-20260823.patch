+static bool ggml_sycl_ornith_beta_sigmoid_mmvq_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_SPEC_BETA_SIGMOID_MMVQ");
+        const bool on = value != nullptr && std::strcmp(value, "0") != 0;
+        if (on) {
+            std::atexit([] {
+                std::fprintf(stderr,
+                    "ggml_sycl_ornith_beta_sigmoid_mmvq: fused_hits=%" PRIu64 "\n",
+                    g_ggml_sycl_ornith_beta_sigmoid_mmvq_hits.load(std::memory_order_relaxed));
+            });
+        }
+        return on;
+    }();
+    return enabled;
+}
