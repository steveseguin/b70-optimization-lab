+template <typename reorder_vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_reorder_sigmoid_2(const void * vx, const void * vy, float * dst,
+                                                   const int ncols, const int nrows,
+                                                   const int stride_col_y_bytes,
+                                                   const int stride_col_dst,
+                                                   dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % QK_K == 0);
+    constexpr size_t num_subgroups = WARP_SIZE;
+    const int block_num_y = ceil_div(nrows, GGML_SYCL_MMV_Y * (int) num_subgroups);
+    const sycl::range<3> block_nums(1, 1, block_num_y);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, num_subgroups * WARP_SIZE);
+
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                         [=](sycl::nd_item<3> nd_item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                             mul_mat_vec_q_reorder_ncols<reorder_vec_dot_q_sycl, 2,
+                                 /*has_fusion=*/ false, /*has_sigmoid=*/ true>(
+                                 vx, nullptr, vy, dst, ncols, nrows, stride_col_y_bytes,
+                                 stride_col_dst, GGML_GLU_OP_SWIGLU, nd_item);
+                         });
+    });
+}
+
+bool ggml_sycl_mul_mat_vec_q_sigmoid_2_reorder(enum ggml_type src0_type, const void * vx,
+                                                const void * vy, float * dst, int ncols,
+                                                int nrows, int stride_col_y_bytes,
+                                                int stride_col_dst, dpct::queue_ptr stream) {
+    if (src0_type != GGML_TYPE_Q4_K) {
+        return false;
+    }
+    launch_mul_mat_vec_q_reorder_sigmoid_2<reorder_vec_dot_q_sycl<GGML_TYPE_Q4_K>>(
+        vx, vy, dst, ncols, nrows, stride_col_y_bytes, stride_col_dst, stream);
+    return true;
+}
