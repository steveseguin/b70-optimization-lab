+// Ornith 1.5 inherits Qwen3.5's 32-value recurrent beta projection. For the
+// two-token speculative verifier, preserve the stock Q4_K reordered MMVQ
+// reduction and apply the stock FP32 sigmoid expression only at its store.
+// The sigmoid output remains the graph-visible allocation consumed by GDN;
+// no pre-sigmoid temporary is kept live beyond its planned lifetime.
+static bool ggml_sycl_ornith_beta_sigmoid_mmvq_fused(
+        ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_idx,
+        ggml_tensor *& sigmoid_out) {
+    sigmoid_out = nullptr;
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_ornith_beta_sigmoid_mmvq_enabled() ||
+        cgraph == nullptr || node_idx < 0 || node_idx >= cgraph->n_nodes ||
+        g_ggml_sycl_prioritize_dmmv) {
+        return false;
+    }
+
+    ggml_tensor * mm = cgraph->nodes[node_idx];
+    if (mm == nullptr || mm->op != GGML_OP_MUL_MAT || mm->src[0] == nullptr ||
+        mm->src[1] == nullptr || mm->src[0]->type != GGML_TYPE_Q4_K ||
+        mm->src[1]->type != GGML_TYPE_F32 || mm->type != GGML_TYPE_F32 ||
+        std::strstr(mm->src[0]->name, "ssm_beta.weight") == nullptr ||
+        mm->src[0]->ne[0] != 2048 || mm->src[0]->ne[1] != 32 ||
+        mm->src[1]->ne[0] != 2048 || mm->src[1]->ne[1] != 2 ||
+        mm->src[1]->ne[2] != 1 || mm->src[1]->ne[3] != 1 ||
+        mm->ne[0] != 32 || mm->ne[1] != 2 || mm->ne[2] != 1 || mm->ne[3] != 1 ||
+        !ggml_is_contiguous(mm) ||
+        ggml_backend_buffer_is_sycl_split(mm->src[0]->buffer)) {
+        return false;
+    }
+
+    const auto use_count = [cgraph](const ggml_tensor * tensor) {
+        int uses = 0;
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            const ggml_tensor * consumer = cgraph->nodes[i];
+            if (consumer == nullptr) {
+                continue;
+            }
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                uses += consumer->src[s] == tensor;
+            }
+        }
+        return uses;
+    };
+    if (use_count(mm) != 1 || (mm->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+        return false;
+    }
+
+    ggml_tensor * found = nullptr;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        ggml_tensor * candidate = cgraph->nodes[j];
+        if (candidate == nullptr || candidate->op != GGML_OP_UNARY ||
+            ggml_get_unary_op(candidate) != GGML_UNARY_OP_SIGMOID ||
+            candidate->src[0] == nullptr) {
+            continue;
+        }
+        const ggml_tensor * cur = candidate->src[0];
+        bool chain_ok = true;
+        while (cur != mm && cur != nullptr &&
+               (cur->op == GGML_OP_RESHAPE || cur->op == GGML_OP_VIEW ||
+                cur->op == GGML_OP_PERMUTE || cur->op == GGML_OP_TRANSPOSE)) {
+            if (use_count(cur) != 1 || (cur->flags & GGML_TENSOR_FLAG_OUTPUT) != 0) {
+                chain_ok = false;
+                break;
+            }
+            cur = cur->src[0];
+        }
+        if (!chain_ok || cur != mm) {
+            continue;
+        }
+        if (found != nullptr) {
+            return false;
+        }
+        found = candidate;
+    }
+    if (found == nullptr || use_count(found) != 1 ||
+        (found->flags & GGML_TENSOR_FLAG_OUTPUT) != 0 ||
+        found->type != GGML_TYPE_F32 || ggml_nelements(found) != 64 ||
+        found->ne[0] != 1 || found->ne[1] != 32 || found->ne[2] != 2 || found->ne[3] != 1 ||
+        !ggml_is_contiguous(found) || std::strstr(found->name, "beta_sigmoid-") == nullptr) {
+        return false;
+    }
+
+    bool feeds_gdn = false;
+    for (int j = node_idx + 1; j < cgraph->n_nodes; ++j) {
+        const ggml_tensor * consumer = cgraph->nodes[j];
+        if (consumer != nullptr && consumer->op == GGML_OP_GATED_DELTA_NET &&
+            consumer->src[4] == found && consumer->src[2] != nullptr &&
+            consumer->src[2]->ne[0] == 128 && consumer->src[2]->ne[1] == 32 &&
+            consumer->src[2]->ne[2] == 2 && consumer->src[2]->ne[3] == 1) {
+            feeds_gdn = true;
+            break;
+        }
+    }
+    if (!feeds_gdn) {
+        return false;
+    }
+
+    opt_for_reorder(&ctx, mm->src[0], mm->src[1], mm, mul_mat_algo::MMVQ);
+    const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(mm->src[0]->extra);
+    if (extra == nullptr || !extra->optimized_feature.reorder) {
+        return false;
+    }
+
+    scope_op_debug_print scope_dbg_print(__func__, mm, /*num_src=*/2,
+                                         " : fused with beta sigmoid");
+    const int src1_padded_cols = GGML_PAD((int) mm->src[0]->ne[0], MATRIX_ROW_PADDING);
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(
+        ctx.pool(), (size_t) 2 * src1_padded_cols * sizeof(block_q8_1) / QK8_1);
+    char * src1_ddq = src1_q8_alloc.get();
+    quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+        (const float *) mm->src[1]->data, src1_ddq, (int) mm->src[0]->ne[0], 2,
+        src1_padded_cols, ctx.stream());
+
+    if (!ggml_sycl_mul_mat_vec_q_sigmoid_2_reorder(
+            mm->src[0]->type, mm->src[0]->data, src1_ddq, (float *) found->data,
+            (int) mm->src[0]->ne[0], (int) mm->src[0]->ne[1],
+            src1_padded_cols * (int) sizeof(block_q8_1) / QK8_1,
+            /*stride_col_dst=*/32, ctx.stream())) {
+        return false;
+    }
+    sigmoid_out = found;
+    return true;
+}
