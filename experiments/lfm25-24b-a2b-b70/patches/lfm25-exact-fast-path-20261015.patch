+// Single-token MUL_MAT_ID takes ggml_sycl_mul_mat_id_mmvq_fused (no host wait) when these hold; the
+// expert weights must already be in their final layout, because the lazy reorder allocates and waits.
+static bool ggml_sycl_mul_mat_id_single_token_graph_eligible(const ggml_tensor * dst) {
+    if (!ggml_sycl_graph_extra_ops_enabled() || !g_ggml_sycl_use_async_mem_op) {
+        return false;
+    }
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+    if (src0 == nullptr || src1 == nullptr || ids == nullptr) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_Q8_0) {
+        return false;
+    }
+    if (src1->ne[2] != 1 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (src1->ne[0] != src0->ne[0] || src1->ne[0] % QK8_1 != 0 || !ggml_is_contiguous(src1)) {
+        return false;
