+static int ggml_sycl_dmmv_q8_0_exact_nr() {
+    static const int nr = [] {
+        const char * env = std::getenv("LLAMA_SYCL_DMMV_Q8_0_EXACT_NR");
+        const int v = env ? std::atoi(env) : 1;
+        return (v == 1 || v == 2 || v == 4) ? v : 1;
+    }();
+    return nr;
+}
+
+static int ggml_sycl_dmmv_q8_0_exact_rows() {
+    // 0 = off (stock reorder DMMV kernel); otherwise rows per work-group (1, 2, 4 or 8)
+    static const int rows = [] {
+        const char * env = std::getenv("LLAMA_SYCL_DMMV_Q8_0_REORDER_EXACT");
+        if (env == nullptr || env[0] == '\0') {
+            return 0;
+        }
+        const int v = std::atoi(env);
+        return (v == 1 || v == 2 || v == 4 || v == 8) ? v : 0;
+    }();
+    return rows;
+}
+
+template <int rows_per_wg, int NR>
+static void launch_dequantize_mul_mat_vec_q8_0_reorder_exact_nr(const void * vx, const dfloat * y, float * dst,
+                                                               const int ncols, const int nrows,
+                                                               dpct::queue_ptr stream) {
+    static_assert(WARP_SIZE == 16, "the exact mapping assumes 16-lane subgroups (4 values per lane per step)");
+    const int            nsg         = (nrows + NR - 1) / NR;
+    const int            block_num_y = (nsg + rows_per_wg - 1) / rows_per_wg;
+    const sycl::range<3> block_nums(1, 1, block_num_y);
+    const sycl::range<3> block_dims(1, rows_per_wg, WARP_SIZE);
+    stream->parallel_for(
+        sycl::nd_range<3>(block_nums * block_dims, block_dims),
+        [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            dequantize_mul_mat_vec_q8_0_reorder_exact<rows_per_wg, NR>(vx, y, dst, ncols, nrows, item_ct1);
+        });
+}
+
+template <int rows_per_wg>
+static void launch_dequantize_mul_mat_vec_q8_0_reorder_exact(const void * vx, const dfloat * y, float * dst,
+                                                            const int ncols, const int nrows,
+                                                            dpct::queue_ptr stream) {
+    switch (ggml_sycl_dmmv_q8_0_exact_nr()) {
+        case 2:  launch_dequantize_mul_mat_vec_q8_0_reorder_exact_nr<rows_per_wg, 2>(vx, y, dst, ncols, nrows, stream); break;
+        case 4:  launch_dequantize_mul_mat_vec_q8_0_reorder_exact_nr<rows_per_wg, 4>(vx, y, dst, ncols, nrows, stream); break;
+        default: {
+            static_assert(WARP_SIZE == 16, "the exact mapping assumes 16-lane subgroups (4 values per lane per step)");
+            const int            block_num_y = (nrows + rows_per_wg - 1) / rows_per_wg;
+            const sycl::range<3> block_nums(1, 1, block_num_y);
+            const sycl::range<3> block_dims(1, rows_per_wg, WARP_SIZE);
+            stream->parallel_for(
+                sycl::nd_range<3>(block_nums * block_dims, block_dims),
+                [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                    dequantize_mul_mat_vec_q8_0_reorder_exact_1row<rows_per_wg>(vx, y, dst, ncols, nrows, item_ct1);
+                });
+            break;
+        }
+    }
+}
+
+static bool dequantize_mul_mat_vec_q8_0_sycl_reorder_exact(const void * vx, const dfloat * y, float * dst,
+                                                           const int ncols, const int nrows,
+                                                           dpct::queue_ptr stream) {
+    const int rows = ggml_sycl_dmmv_q8_0_exact_rows();
+    if (rows == 0 || ncols % (2*GGML_SYCL_DMMV_X) != 0) {
+        return false;
+    }
+    switch (rows) {
+        case 1: launch_dequantize_mul_mat_vec_q8_0_reorder_exact<1>(vx, y, dst, ncols, nrows, stream); break;
+        case 2: launch_dequantize_mul_mat_vec_q8_0_reorder_exact<2>(vx, y, dst, ncols, nrows, stream); break;
+        case 4: launch_dequantize_mul_mat_vec_q8_0_reorder_exact<4>(vx, y, dst, ncols, nrows, stream); break;
+        default: launch_dequantize_mul_mat_vec_q8_0_reorder_exact<8>(vx, y, dst, ncols, nrows, stream); break;
+    }
+    return true;
+}
+#endif // GGML_SYCL_F16
