+#ifdef GGML_SYCL_GRAPH
+// Replay a recorded SYCL graph without re-recording while the ggml graph is unchanged (same nodes, same
+// data pointers, shapes, strides and op params), as the CUDA backend does. Re-recording and updating
+// every step costs more than it saves. A changed graph runs eagerly; two unchanged calls in a row
+// record a fresh executable graph. Kernels and arguments are the same as the eager path, so results
+// are bit-identical.
+static bool ggml_sycl_graph_reuse_enabled() {
+    static const bool enabled = [] {
+        const char * env = std::getenv("LLAMA_SYCL_GRAPH_REUSE");
+        return env && (std::strcmp(env, "1") == 0 || std::strcmp(env, "on") == 0);
+    }();
+    return enabled;
+}
