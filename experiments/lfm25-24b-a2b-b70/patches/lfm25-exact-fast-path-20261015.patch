+#ifdef GGML_SYCL_F16
+// Q8_0 on the reordered layout ([all qs][all d]) with exactly the arithmetic of the plain-layout
+// dequantize_mul_mat_vec<QK8_0, QR8_0, dequantize_q8_0> kernel: lane tid owns columns i + 4*tid .. +3 for
+// i = 0, 64, 128, ..., accumulates (q*d) * y as half2 in that order, then the same xor butterfly and
+// x + y. Only the memory access changes (one aligned 32-bit load per lane per step, several rows per
+// work-group), so dst is bit-identical to the plain kernel. Needs ncols % 64 == 0.
+// NR == 1 keeps the first version of the kernel (one row per subgroup); it measured faster than the
+// multi-row template instantiated with NR = 1.
+template <int rows_per_wg>
+static void dequantize_mul_mat_vec_q8_0_reorder_exact_1row(const void * __restrict__ vx, const dfloat * __restrict__ y,
+                                                           float * __restrict__ dst, const int ncols, const int nrows,
+                                                           const sycl::nd_item<3> & item_ct1) {
+    const int row = item_ct1.get_group(2) * rows_per_wg + item_ct1.get_local_id(1);
+    if (row >= nrows) {
+        return;
+    }
+    const int tid = item_ct1.get_local_id(2);
+
+    const int8_t *     qs_row = (const int8_t *) vx + (size_t) row * ncols;
+    const sycl::half * d_row  = (const sycl::half *) ((const char *) vx + (size_t) ncols * nrows) + (size_t) row * (ncols / QK8_0);
+
+    sycl::half2 tmp = {0.0f, 0.0f};
+#pragma unroll 4
+    for (int i = 0; i < ncols; i += 2*GGML_SYCL_DMMV_X) {
+        const int col = i + 4*tid;
+        const int packed = *(const int *) (qs_row + col);
+        const dfloat d = d_row[col / QK8_0];
+
+        dfloat2 v;
+        v.x() = (int8_t) (packed & 0xff);
+        v.y() = (int8_t) ((packed >> 8) & 0xff);
+        v.s0() *= d;
+        v.s1() *= d;
+        dfloat2 t1{y[col + 0], y[col + 1]};
+        tmp += v * t1;
+
+        v.x() = (int8_t) ((packed >> 16) & 0xff);
+        v.y() = (int8_t) ((packed >> 24) & 0xff);
+        v.s0() *= d;
+        v.s1() *= d;
+        dfloat2 t2{y[col + 2], y[col + 3]};
+        tmp += v * t2;
+    }
+
+    const int mask_start = ncols > GGML_SYCL_DMMV_X ? WARP_SIZE >> 1 : WARP_SIZE >> 2;
+    for (int mask = mask_start; mask > 0; mask >>= 1) {
+        tmp += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp, mask);
+    }
+
+    if (tid == 0) {
+        dst[row] = tmp.x() + tmp.y();
+    }
+}
+
+template <int rows_per_wg, int NR>
+static void dequantize_mul_mat_vec_q8_0_reorder_exact(const void * __restrict__ vx, const dfloat * __restrict__ y,
+                                                      float * __restrict__ dst, const int ncols, const int nrows,
+                                                      const sycl::nd_item<3> & item_ct1) {
+    const int row0 = (item_ct1.get_group(2) * rows_per_wg + item_ct1.get_local_id(1)) * NR;
+    if (row0 >= nrows) {
+        return;
+    }
+    const int tid = item_ct1.get_local_id(2);
+
+    const int8_t *     qs_base = (const int8_t *) vx;
+    const sycl::half * d_base  = (const sycl::half *) ((const char *) vx + (size_t) ncols * nrows);
+    const int          bpr     = ncols / QK8_0;
+
+    sycl::half2 tmp[NR];
+#pragma unroll
+    for (int r = 0; r < NR; ++r) {
+        tmp[r] = {0.0f, 0.0f};
+    }
+#pragma unroll 4
+    for (int i = 0; i < ncols; i += 2*GGML_SYCL_DMMV_X) {
+        const int col = i + 4*tid;
+        dfloat2 t1{y[col + 0], y[col + 1]};
+        dfloat2 t2{y[col + 2], y[col + 3]};
+#pragma unroll
+        for (int r = 0; r < NR; ++r) {
+            const int row = row0 + r < nrows ? row0 + r : nrows - 1;  // clamp; result discarded below
+            const int packed = *(const int *) (qs_base + (size_t) row * ncols + col);
+            const dfloat d = d_base[(size_t) row * bpr + col / QK8_0];
+
+            dfloat2 v;
+            v.x() = (int8_t) (packed & 0xff);
+            v.y() = (int8_t) ((packed >> 8) & 0xff);
+            v.s0() *= d;
+            v.s1() *= d;
+            tmp[r] += v * t1;
+
+            v.x() = (int8_t) ((packed >> 16) & 0xff);
+            v.y() = (int8_t) ((packed >> 24) & 0xff);
+            v.s0() *= d;
+            v.s1() *= d;
+            tmp[r] += v * t2;
+        }
+    }
+
+    const int mask_start = ncols > GGML_SYCL_DMMV_X ? WARP_SIZE >> 1 : WARP_SIZE >> 2;
+#pragma unroll
+    for (int r = 0; r < NR; ++r) {
+        for (int mask = mask_start; mask > 0; mask >>= 1) {
+            tmp[r] += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp[r], mask);
+        }
+    }
+
+    if (tid == 0) {
+#pragma unroll
+        for (int r = 0; r < NR; ++r) {
+            if (row0 + r < nrows) {
+                dst[row0 + r] = tmp[r].x() + tmp[r].y();
+            }
+        }
+    }
+}
