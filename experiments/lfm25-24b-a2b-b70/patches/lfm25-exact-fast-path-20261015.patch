+struct ggml_sycl_graph_node_props {
+    ggml_tensor node;
+    void *      src_data[GGML_MAX_SRC];
+    int64_t     src_ne[GGML_MAX_SRC][GGML_MAX_DIMS];
+    size_t      src_nb[GGML_MAX_SRC][GGML_MAX_DIMS];
+};
+
+struct ggml_sycl_graph_reuse_state {
+    std::vector<ggml_sycl_graph_node_props> props;
+    std::unique_ptr<sycl_ex::command_graph<sycl_ex::graph_state::executable>> exec;
+    int64_t n_replays = 0;
+    int64_t n_records = 0;
+    int64_t n_eager   = 0;
+};
+
+static bool ggml_sycl_graph_props_changed(ggml_sycl_graph_reuse_state & st, const ggml_cgraph * cgraph) {
+    bool changed = false;
+    if ((int) st.props.size() != cgraph->n_nodes) {
+        st.props.resize(cgraph->n_nodes);
+        changed = true;
+    }
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        ggml_sycl_graph_node_props prop;
+        std::memset(&prop, 0, sizeof(prop));
+        std::memcpy(&prop.node, cgraph->nodes[i], sizeof(ggml_tensor));
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            const ggml_tensor * src = cgraph->nodes[i]->src[j];
+            if (src) {
+                prop.src_data[j] = src->data;
+                std::memcpy(prop.src_ne[j], src->ne, sizeof(prop.src_ne[j]));
+                std::memcpy(prop.src_nb[j], src->nb, sizeof(prop.src_nb[j]));
+            }
+        }
+        if (changed || std::memcmp(&st.props[i], &prop, sizeof(prop)) != 0) {
+            st.props[i] = prop;
+            changed = true;
+        }
+    }
+    return changed;
+}
