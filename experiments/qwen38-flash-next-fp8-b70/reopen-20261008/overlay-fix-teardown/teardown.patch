+    mark('ple_closed')
+    for param in params:
+        for key in ('_q38_host_cpu', '_screen1b_host_storage'):
+            if hasattr(param, key):
+                delattr(param, key)
+    for module in modules:
+        for key in ('_screen1b_cache_slab', '_screen1b_step_host'):
+            if hasattr(module, key):
