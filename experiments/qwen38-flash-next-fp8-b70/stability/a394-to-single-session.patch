+trap 'exit 130' INT TERM HUP
+# Persist stage boundaries without a global sync or host-setting changes.
+record_stage() {
+  /usr/bin/python3 - "${run_dir}/lifecycle.log" "$1" <<'PYLOG'
+import datetime, os, sys
+with open(sys.argv[1], "a") as f:
+    f.write(datetime.datetime.now(datetime.timezone.utc).isoformat() + " " + sys.argv[2] + "\n")
+    f.flush()
+    os.fsync(f.fileno())
+PYLOG
+}
