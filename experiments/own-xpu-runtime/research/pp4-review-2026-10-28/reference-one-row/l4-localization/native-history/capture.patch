+  for(size_t i=0;i<4;++i){payload.write(reinterpret_cast<const char*>(values[i].data()),values[i].size());index<<(i?",":"")<<"\""<<fields[i]<<"\":{\"offset\":"<<offset<<",\"bytes\":"<<values[i].size()<<",\"sha256\":\""<<sha(values[i])<<"\"}";offset+=values[i].size();}
