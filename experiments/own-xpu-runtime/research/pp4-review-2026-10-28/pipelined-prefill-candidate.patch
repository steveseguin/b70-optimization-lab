+                  target_command_work_wall_s=[0.0]*4, target_work_wall_s=0.0,
+                  draft_replay_work_wall_s=0.0, target_only_phase_wall_s=0.0,
+                  mixed_phase_wall_s=0.0, draft_only_phase_wall_s=0.0,
+                  other_wall_s=0.0)
