 # the exact size it reported for this model. The sealed base bounds both ranks' anonymous memory at 8 GiB.
 LOOKUP_COPY_BYTES=29_137_853_440
 
+TEARDOWN_BACKEND=re.compile(r'LevelZero:(\d+):')
+def rank_teardown_ok(receipt,rank,returncode,cards):
+    """The rank receipt check of BASE.Transport.close, per card. A rank on N cards (TP: one shared context) writes exactly
+    N teardown records, one per card (backend 'LevelZero:<card>:...', cards 0..N-1 each once). The rank must exit 0 with
+    a passed receipt for its own rank, and every record must be complete and safe: exit 0, safe to exit, nothing in
+    flight, no live bytes, no error. Anything missing, extra, duplicated or nonzero fails."""
+    if not isinstance(receipt,dict):return False
+    td=receipt.get('teardown')
+    if not(returncode==0 and receipt.get('passed') is True and receipt.get('rank')==rank and type(cards) is int and cards>=1
+           and isinstance(td,list) and len(td)==cards):return False
+    seen=[]
+    for t in td:
+        m=TEARDOWN_BACKEND.match(str(t.get('backend',''))) if isinstance(t,dict) else None
+        if m is None:return False
+        if not(t.get('status')=='complete' and t.get('exit_code')==0 and t.get('safe_to_exit') is True and t.get('in_flight')==0
+               and t.get('live_bytes')==0 and t.get('error')==''):return False
+        seen.append(int(m.group(1)))
+    return sorted(seen)==list(range(cards))
+
 class Transport(BASE.Transport):
     """Constructor differs; the anonymous-memory bound also admits rank 0's lookup-table copy. Caller owns admission,
     leases and physical drain."""
+    def close(self,success):
+        """BASE.Transport.close unchanged up to its last statement, the receipt check 'len(teardown)==1' per rank, which a
+        TP rank (one record per card) fails after a clean drain. That check is replaced by rank_teardown_ok for every
+        rank. The base reaches it only after FINISH, drain, the ownership receipt and closing (self.closed), so catching
+        exactly its error there skips nothing else; every other error propagates."""
+        if self.closed:return
+        try:super().close(success)
+        except ValueError as error:
+            if not(success and self.closed and str(error)=='rank teardown failure'):raise
+        if success:
+            for rank,p in enumerate(self.children):
+                r=json.loads((self.out/f'rank{rank}/receipt.json').read_text())
+                require(rank_teardown_ok(r,rank,p.returncode,len(RANK_BDFS[rank])),'rank teardown failure')
