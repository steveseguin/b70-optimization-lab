+  uint32_t* error=nullptr;    // this card's sticky error word
+  uint32_t record_at=0,cap=0,matrix=0;
+  uint32_t last_copy=0;       // 1: the last work-group stores every row to the peer (token hcl), else each row's item
+};
+// Peer stores: token hc, each row's storing item copies its word right after bf16_rows (stores spread over every
+// work-group); token hcl, the work-group that completes the counter copies all of the card's rows of the split matrix
+// (read back from local y after the counter's acquire, coalesced by consecutive items) before its own release fence and
+// the flag, as one exchange-kernel group does. hcl is the A/B against the spread form (2026-10-31 smoke s1: one buffer
+// differed between the cards with the spread form).
+template<unsigned R,unsigned U> inline void body(const std::array<dense_v2::Mat,4>& m,unsigned count,sycl::nd_item<1> it,const Tail& t){
+ using u32=std::uint32_t;namespace L=ownrt::exchange_layout;
+ using dev_ref=sycl::atomic_ref<u32,sycl::memory_order::relaxed,sycl::memory_scope::device,sycl::access::address_space::global_space>;
+ using sys_ref=sycl::atomic_ref<u32,sycl::memory_order::relaxed,sycl::memory_scope::system,sycl::access::address_space::global_space>;
+ const u32 gsub=u32(it.get_group_linear_id())*u32(it.get_local_range(0)/32)+u32(it.get_sub_group().get_group_linear_id());
+ dense_v2::Mat d=m[0];unsigned j=0;
+ if(count>1&&gsub>=m[1].first_sub){d=m[1];j=1;}
+ if(count>2&&gsub>=m[2].first_sub){d=m[2];j=2;}
+ if(count>3&&gsub>=m[3].first_sub){d=m[3];j=3;}
+ const u32 sub=gsub-d.first_sub;
+ dense_v2::bf16_rows<R,U>(d.w,d.x,d.y,d.rows,d.k,d.rb,it,sub); // returns early (from the call only) past the last row
+ const unsigned lane=it.get_sub_group().get_local_linear_id();const u32 row=sub*R+(lane&(R-1));
+ if(!t.last_copy&&j==t.matrix&&lane<R&&row<d.rows)t.remote[row]=sycl::bit_cast<u32>(d.y[row]); // the value this item stored
+ sycl::atomic_fence(sycl::memory_order::release,sycl::memory_scope::system);
+ sycl::group_barrier(it.get_group());
+ const u32 lid=u32(it.get_local_linear_id());u32 old=0,count_last=0;
+ u32* ctl=t.ctl;const u32 groups=u32(it.get_group_range(0)),record_at=t.record_at,cap=t.cap;
+ if(lid==0){old=dev_ref(ctl[record_at+L::counter]).fetch_add(1u,sycl::memory_order::acq_rel);count_last=(old+1u)%groups==0u?1u:0u;}
+ if(t.last_copy){
+  count_last=sycl::group_broadcast(it.get_group(),count_last,0);
+  if(count_last){ // every group has stored its rows of local y and counted: copy them all to the peer
+   sycl::atomic_fence(sycl::memory_order::acquire,sycl::memory_scope::device);
+   // 16-byte words, every load of a batch issued before its stores (src and remote may alias for the compiler).
+   const dense_v2::Mat& s=m[t.matrix];const u32* src=reinterpret_cast<const u32*>(s.y);const u32 n=s.rows,step=u32(it.get_local_range(0));
+   const bool vec=(reinterpret_cast<uintptr_t>(src)|reinterpret_cast<uintptr_t>(t.remote))%16==0;const u32 nv=vec?n/4:0;
+   using v4=sycl::vec<u32,4>;const v4* sv=reinterpret_cast<const v4*>(src);v4* dv=reinterpret_cast<v4*>(t.remote);
+   constexpr u32 B=8;
+   for(u32 base=0;base<nv;base+=B*step){
+    v4 r[B];
+    #pragma unroll
+    for(u32 b=0;b<B;++b){const u32 i=base+b*step+lid;if(i<nv)r[b]=sv[i];}
+    #pragma unroll
+    for(u32 b=0;b<B;++b){const u32 i=base+b*step+lid;if(i<nv)dv[i]=r[b];}
+   }
+   for(u32 i=nv*4+lid;i<n;i+=step)t.remote[i]=src[i];
+   sycl::atomic_fence(sycl::memory_order::release,sycl::memory_scope::system);
+   sycl::group_barrier(it.get_group());
+  }
+ }
+ if(lid==0){
+  const u32 epoch=old/groups+1u;const bool last=count_last!=0u;
+  if(last){
+   sycl::atomic_fence(sycl::memory_order::acq_rel,sycl::memory_scope::system);
+   *reinterpret_cast<volatile u32*>(t.peer_flag)=epoch;
+   sycl::atomic_fence(sycl::memory_order::release,sycl::memory_scope::system);
+  }
+  if(last&&dev_ref(ctl[L::abort]).load()==0u){
+   sys_ref flag(ctl[record_at+L::flag]);u32 polls=0,v=flag.load();
+   while(v<epoch&&polls<cap){++polls;v=flag.load();}
+   if(v<epoch){dev_ref(ctl[L::abort]).store(1u);dev_ref(ctl[L::timeouts]).fetch_add(1u);dev_ref(*t.error).store(1u);}
+   else sycl::atomic_fence(sycl::memory_order::acquire,sycl::memory_scope::system);
+   dev_ref(ctl[L::waits]).fetch_add(1u);
+   if(polls){dev_ref(ctl[L::spun]).fetch_add(1u);dev_ref(ctl[L::spin_sum]).fetch_add(polls);dev_ref(ctl[L::max_spin]).fetch_max(polls);}
+  }
+ }
+}
+}
