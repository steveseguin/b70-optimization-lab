+// OWNRT_TARGET_FAST moec (lab 2026-10-30, research/tp/fixed-cost-2-2026-10-30): norm_row<true> with the
+// layer's two moe launches folded in front of its combine (decode, a cnorm pair whose combine reads the moe output):
+//  1. the mixture epilogue (kopt4 CombineF32, no guard): mix[k] = 0 + y[0][k]*w[0] + ... + y[9][k]*w[9], in slot order;
+//     work-group 0 writes the mixture buffer;
+//  2. the moe_combine (generic / ew path, F32): guard (inactive or error -> nothing), position check (fails the half and
+//     stops before the combine, as the separate launches would), moe[k] = (0 + mix[k]*one) + shexp[k]*sigmoid(gate);
+//     work-group 0 writes the moe buffer;
+//  3. norm_row<true>'s combine (with branch = moe[k]) and norm, unchanged.
+struct MoeArgs {
+  const float* down;    // expsdown rows (10 x 2560)
+  const float* prob;    // route weights (10)
+  const float* shexp;   // shared-expert down (2560)
+  const float* sgate;   // shared-expert router gate (1)
+  const float* one;     // the engine's one (1.0f) weight of the single mixture row
+  float* mixture;       // epilogue output (2560)
+  float* moe;           // moe_combine output (2560)
+};
+template <unsigned WGS = NORM_WGS>
+inline void norm_row_moe(const NormArgs a, const MoeArgs m, sycl::nd_item<1> it, float* part) {
+  constexpr int W = 2560, C = 80, HEADS = 4, NSG = WGS / 32;
+  static_assert(WGS % 32 == 0 && C % NSG == 0, "chunks split evenly over the subgroups");
+  constexpr int CPS = C / NSG;
+  auto g = it.get_group();
+  auto sg = it.get_sub_group();
+  const int lane = int(sg.get_local_linear_id()), sgi = int(sg.get_group_linear_id());
+  const int row = int(g.get_group_linear_id());
+  using ref = sycl::atomic_ref<int32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                               sycl::access::address_space::global_space>;
+  float xs[CPS], gs[CPS], bs[CPS], mix[CPS];
+#pragma unroll
+  for (int j = 0; j < CPS; ++j) {
+    const int k = (sgi + j * NSG) * 32 + lane;
+    xs[j] = a.x[row * W + k];
+    gs[j] = a.gain[(row % HEADS) * W + k];
+    float sum = 0;
+    for (unsigned slot = 0; slot < 10; ++slot) { float product = m.down[size_t(slot) * W + k] * m.prob[slot]; sum = sum + product; }
+    mix[j] = sum;
+    if (row == 0) m.mixture[k] = sum;
+  }
+  const float inj = a.inject[row];
+  const int act0 = lane == 0 ? a.active[0] : 0, err0 = lane == 0 ? ref(a.error[0]).load() : 0,
+            pos0 = lane == 0 ? a.position[0] : 0;
+  const int act = sycl::group_broadcast(sg, act0, 0), err = sycl::group_broadcast(sg, err0, 0),
+            pos = sycl::group_broadcast(sg, pos0, 0);
+  if (!act || err) return;
+  if (pos < 0 || pos > a.capacity - a.tokens) {
+    if (row == 0 && it.get_local_linear_id() == 0) ref(a.error[0]).store(1);
+    return;
+  }
+  {
+    const float one = m.one[0], sg_gate = ng::sigmoid(m.sgate[0]);
+#pragma unroll
+    for (int j = 0; j < CPS; ++j) {
+      const int k = (sgi + j * NSG) * 32 + lane;
+      float sum = 0;
+      sum = sum + mix[j] * one;
+      const float v = sum + m.shexp[k] * sg_gate;
+      bs[j] = v;
+      if (row == 0) m.moe[k] = v;
+    }
+  }
+  const float gate = 2.f * ng::sigmoid(inj / 4.f);
+#pragma unroll
+  for (int j = 0; j < CPS; ++j) {
+    const int k = (sgi + j * NSG) * 32 + lane;
+    xs[j] = xs[j] + bs[j] * gate;
+    a.x[row * W + k] = xs[j];
+  }
+#pragma unroll
+  for (int j = 0; j < CPS; ++j) {
+    const int c = sgi + j * NSG;
+    float v = xs[j] * xs[j];
+#pragma unroll
+    for (int s = 1; s < 32; s *= 2) {
+      const float rhs = sycl::select_from_group(sg, v, (lane + s) % 32);
+      if (lane % (2 * s) == 0) v = v + rhs;
+    }
+    if (lane == 0) {
+      part[c] = v;
+      a.scratch[row * C + c] = v;
+    }
+  }
+  sycl::group_barrier(g);
+  if (sgi == 0) {
+    const float total = upper80(sg, part, lane);
+    if (lane == 0) part[C] = detmath::rsqrt(total / float(W) + 1e-6f);
+  }
+  sycl::group_barrier(g);
+  const float inv = part[C];
+#pragma unroll
+  for (int j = 0; j < CPS; ++j) {
+    const int k = (sgi + j * NSG) * 32 + lane;
+    a.y[row * W + k] = (xs[j] * inv) * (gs[j] + float(a.flags & 1));
+  }
+}
 }  // namespace hc_kernels
