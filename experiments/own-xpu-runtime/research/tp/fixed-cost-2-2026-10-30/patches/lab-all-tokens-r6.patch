+#include "stage2/packet194-expert-diet-engine/kernel_guard.hpp"
+#pragma once
+// OWNRT_DRAFT_FAST (lab 2026-10-30, research/tp/fixed-cost-2-2026-10-30, default off): exact faster launches for the MTP
+// draft step (mtp.hpp DraftRuntime::compute only; prompt-chunk replay keeps the per-site commands). "1" enables every
+// token; otherwise a comma list:
+//  inj    HC low (+ its act tail) and HC inject of the same norm row in ONE launch: p59 Dense<10240,false,false,1,4>
+//         rows of both matrices (the same chain, subgroup tree and 4-part tree per row; the inject rows have no tail).
+//  qkv    qsa.k, qsa.v, qsa.iq, qsa.ik (p59 Dense<2560,false,false,1,1>, same input row) in ONE launch.
+//  shx    router, shared-expert gate+up (+ the SiLU product tail) and the shared-expert router gate (p59
+//         Dense<2560,false,false,1,1>, same input row) in ONE launch; gate and up of a row in one subgroup, as p59's
+//         paired rows (both sums from the same chain, both trees, the same product expression).
+//  norm   the p59 draft norms (one 256-lane row tree) with the levels 1..16 by subgroup shuffles and 32..128 from the
+//         eight subgroup sums (same operands, same association), one barrier instead of nine, all loads up front;
+//         merge.embedding_norm and merge.hidden_norm in ONE launch.
+//  merge  merge.embedding_projected and merge.projected (+ merge_add tail) in ONE launch: a subgroup owns weight row r
+//         of both matrices; every output keeps p59 Dense<2560,false,false,1,1>'s per-row sequence.
+//  gmix   the HC gate GEMV (10240 x 320, BF16 rows, production mtp36 / p59 GateMix order) with the HC mix in its
+//         epilogue: one subgroup computes the four stream rows of one column (same lane chunks, adds, 32-lane tree per
+//         row), lane 0 forms the mix in the elementwise kernel's order (guarded like it for hc.a / hc.f; final.gate
+//         keeps GateMix's unguarded store).
+//  cnorm  ffn.combine (generic hc_combine, BF16 streams, guarded) fused into final.norm's norm launch: work-group h
+//         combines stream row h, writes it back and normalizes the values it holds. Head-on steps only (head-off
+//         steps skip final.* and run the combine as before).
+//  rows   the draft's production BF16 rows (mtp36 Dense<K,0,false>: qsa.qgate incl. both cards of its four-card split, ...)
+//         two rows per subgroup and the FP8 expert rows (fp8v2) two (gate+up pair) or four (down) rows of one slot per
+//         subgroup: each 8-column input chunk is loaded once for the subgroup's rows; every row keeps its own lane sums
+//         (same chunks, same element order and expression), its own tree and its own stores (mtp_kernels.cpp).
+//  att    the attention output projection with its fused combine tail (p59 Dense<6144,false,false,1,4> + attention tail)
+//         on the 4-part segmented kernel with two rows per work-group (also used by inj): the same per-row order.
+//  gath   expert_gather (generic SimpleNew, two launches: 25,600 items through the typed-view body, then one check
+//         item) as one launch of 256-item groups with static types: the same guard, route descriptors, validity flags
+//         in the scratch, element copy (bf16(widen(x))); group 0 then runs phase 1's check after a group barrier.
+#include "stage2/packet194-expert-diet-engine/p59_draft.hpp"
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+namespace draft_fast {
+inline const std::string& list() {
+  static const std::string v = [] {
+    const char* e = std::getenv("OWNRT_DRAFT_FAST");
+    const std::string s = e ? e : "";
+    return s == "1" ? std::string("inj,norm,merge,cnorm,gath,rows,att") : s;
+  }();
+  return v;
+}
+inline bool enabled(const char* token) {
+  const auto& v = list();
+  if (v.empty() || v == "0") return false;
+  return ("," + v + ",").find(std::string(",") + token + ",") != std::string::npos;
+}
+inline bool any() { const auto& v = list(); return !v.empty() && v != "0"; }
+}  // namespace draft_fast
+#ifndef OWN_RT_HOST_ONLY
+#include "stage2/packet194-expert-diet-engine/prepared_submission.hpp"
+#include <sycl/sycl.hpp>
+namespace draft_fast {
+using ownrt::Allocation;
+inline float widen(uint16_t b) { return iq3::bits_float(uint32_t(b) << 16); }
+template <class T> inline const T* gptr(const T* p) { return p; }
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Segmented p59 dense rows. Up to four matrices of one K over the same input row x; rows [first, first + rows) of the
+// launch belong to segment s. tail: 0 none, 1 low (silu(y/4)), 2 paired (y = w row, py = peer row, out = silu(y)*py).
+enum : uint32_t { tail_none = 0, tail_low = 1, tail_pair = 2, tail_attention = 3 };
+struct Seg { const uint8_t* w; const uint8_t* peer; uint16_t* y; uint16_t* py; uint16_t* out; const uint16_t* inject; uint32_t rows, first, tail; };
+struct SegSpec { uint32_t rows[4]{}, tail[4]{}; uint32_t count = 0; };
+struct SegArgs { const uint16_t* x; Seg s[4]; uint32_t count, total; };
+inline Seg pick(const SegArgs& a, uint32_t i) {
+  Seg d = a.s[0];
+  if (a.count > 1 && i >= a.s[1].first) d = a.s[1];
+  if (a.count > 2 && i >= a.s[2].first) d = a.s[2];
+  if (a.count > 3 && i >= a.s[3].first) d = a.s[3];
+  return d;
+}
+inline void seg_output(const Seg& d, uint32_t row, float sum, float peer) {
+  const uint16_t y = iq3::bf16_bits(sum);
+  if (d.tail == tail_pair) {
+    const uint16_t py = iq3::bf16_bits(peer);
+    d.py[row] = py;
+    d.y[row] = y;
+    d.out[row] = iq3::bf16_bits(ng::silu(widen(y)) * widen(py));
+  } else {
+    d.y[row] = y;
+    if (d.tail == tail_low) d.out[row] = iq3::bf16_bits(ng::silu(widen(y) / 4.f));
+    // p59 attention tail: streams[s][row] += y * (2*sigmoid(inject[s]/4)), BF16, s = 0..3 in order.
+    if (d.tail == tail_attention)
+      for (unsigned stream = 0; stream < 4; ++stream) {
+        const size_t j = size_t(stream) * d.rows + row;
+        d.out[j] = iq3::bf16_bits(widen(d.out[j]) + widen(y) * (2.f * ng::sigmoid(widen(d.inject[stream]) / 4.f)));
+      }
+  }
+}
+template <unsigned K, unsigned Split> struct Segments final : ownrt::SyclOperation {
+  SegSpec spec;
+  sycl::event submit(sycl::queue& q, std::span<void* const> p, const std::vector<sycl::event>& deps) const override {
+    SegArgs a{};
+    a.x = static_cast<const uint16_t*>(p[0]);
+    a.count = spec.count;
+    uint32_t first = 0;
+    for (uint32_t j = 0; j < spec.count; ++j) {
+      a.s[j] = Seg{static_cast<const uint8_t*>(p[1 + 6 * j]), static_cast<const uint8_t*>(p[2 + 6 * j]),
+                   static_cast<uint16_t*>(p[3 + 6 * j]), static_cast<uint16_t*>(p[4 + 6 * j]),
+                   static_cast<uint16_t*>(p[5 + 6 * j]), static_cast<const uint16_t*>(p[6 + 6 * j]), spec.rows[j], first, spec.tail[j]};
+      first += spec.rows[j];
+    }
+    a.total = first;
+    using D = p59::Dense<K, false, false, 1, Split>;
+    if constexpr (Split == 1) {
+      const size_t global = ((size_t(a.total) * 32 + 255) / 256) * 256;
+      return ownrt::prepared_submit(q, [=, r0 = sycl::nd_range<1>(global, 256)](sycl::handler& h) {
+        h.parallel_for(r0, packet26::checked([=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(32)]] {
+          auto sg = it.get_sub_group();
+          const unsigned physical = it.get_local_linear_id() % 32;
+          const uint32_t i = uint32_t(it.get_global_linear_id() / 32);
+          if (i >= a.total) return;
+          const Seg d = pick(a, i);
+          const uint32_t row = i - d.first;
+          float sum = D::chain(d.w + size_t(row) * K * 2, a.x, physical, 0), peer = 0;
+          if (d.tail == tail_pair) peer = D::chain(d.peer + size_t(row) * K * 2, a.x, physical, 0);
+          const unsigned base = sg.get_local_linear_id() - physical;
+          for (unsigned w = 1; w < 32; w *= 2) {
+            float r = sycl::select_from_group(sg, sum, base + (physical + w) % 32),
+                  pr = sycl::select_from_group(sg, peer, base + (physical + w) % 32);
+            if (physical % (2 * w) == 0) { sum += r; peer += pr; }
+          }
+          if (!physical) seg_output(d, row, sum, peer);
+        }));
+      });
+    } else {
+      // R launch rows per work-group (segments hold multiples of R rows, so all R rows share one segment). Subgroup
+      // `part` walks its K range for each of the R rows with p59's lane order, loading each 8-column input chunk once;
+      // per row: the subgroup tree, then the Split-part tree by item 0, then p59's output and tail.
+      const size_t wg = Split * 32;
+      constexpr unsigned R = 2;
+      const size_t groups = (size_t(a.total) + R - 1) / R;
+      return ownrt::prepared_submit(q, [=, r0 = sycl::nd_range<1>(groups * wg, wg)](sycl::handler& h) {
+        sycl::local_accessor<float, 1> partial(R * Split, h);
+        h.parallel_for(r0, packet26::checked([=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(32)]] {
+          auto sg = it.get_sub_group();
+          const unsigned physical = it.get_local_linear_id() % 32, part = it.get_local_linear_id() / 32;
+          const uint32_t i0 = uint32_t(it.get_group_linear_id()) * R;
+          const Seg d = pick(a, i0);
+          const uint32_t row0 = i0 - d.first;
+          const unsigned begin = (K / 256 * part / Split) * 256, end = part + 1 == Split ? K : (K / 256 * (part + 1) / Split) * 256;
+          float sum[R];
+#pragma unroll
+          for (unsigned r = 0; r < R; ++r) sum[r] = 0.f;
+          for (unsigned k = begin + physical * 8; k < end; k += 256) {
+            sycl::vec<uint16_t, 8> xv;
+            xv.load(0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(a.x + k));
+#pragma unroll
+            for (unsigned r = 0; r < R; ++r) {
+              const uint16_t* w = reinterpret_cast<const uint16_t*>(d.w) + size_t(row0 + r) * K;
+              sycl::vec<uint16_t, 8> wv;
+              wv.load(0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(w + k));
+#pragma unroll
+              for (unsigned j = 0; j < 8; ++j) if (k + j < end) { const float v = widen(wv[j]); const float pr = v * widen(xv[j]); sum[r] = sum[r] + pr; }
+            }
+          }
+          const unsigned base = sg.get_local_linear_id() - physical;
+#pragma unroll
+          for (unsigned r = 0; r < R; ++r)
+            for (unsigned w = 1; w < 32; w *= 2) {
+              float rr = sycl::select_from_group(sg, sum[r], base + (physical + w) % 32);
+              if (physical % (2 * w) == 0) sum[r] += rr;
+            }
+          if (!physical)
+            for (unsigned r = 0; r < R; ++r) partial[r * Split + part] = sum[r];
+          it.barrier(sycl::access::fence_space::local_space);
+          if (it.get_local_linear_id() == 0)
+            for (unsigned r = 0; r < R; ++r) {
+              if (i0 + r >= a.total) break;
+              float* pr = &partial[r * Split];
+              for (unsigned w = 1; w < Split; w *= 2)
+                for (unsigned j = 0; j < Split; j += 2 * w) pr[j] += pr[j + w];
+              seg_output(d, row0 + r, pr[0], 0.f);
+            }
+        }));
+      });
+    }
+  }
+};
+// One segment: weight w (rows x K BF16), output y; tail low writes out; tail pair also reads peer, writes py and out.
+struct SegIn { Allocation w{}, peer{}, y{}, py{}, out{}; uint32_t rows = 0, tail = tail_none; Allocation inject{}; };
+inline void seg_extent(ownrt::Device& d, Allocation a, size_t n) {
+  const auto& r = d.arena.row(a);
+  if (!r.live || r.memory != ownrt::Memory::device || r.bytes < n) throw std::invalid_argument("draft_fast extent/lifetime");
+}
+template <unsigned K, unsigned Split>
+inline integrated::Launch segments(ownrt::Device& d, Allocation x, const std::vector<SegIn>& segs) {
+  if (segs.empty() || segs.size() > 4) throw std::invalid_argument("draft_fast segments: 1-4");
+  if (Split > 1) for (const auto& s : segs) if (s.tail == tail_pair) throw std::invalid_argument("draft_fast: paired rows need Split 1");
+  seg_extent(d, x, size_t(K) * 2);
+  Segments<K, Split> op;
+  std::array<Allocation, 25> ids{};
+  ids.fill(x);
+  ids[0] = x;
+  for (size_t j = 0; j < segs.size(); ++j) {
+    const auto& s = segs[j];
+    if (!s.rows) throw std::invalid_argument("draft_fast segment rows");
+    seg_extent(d, s.w, size_t(s.rows) * K * 2);
+    seg_extent(d, s.y, size_t(s.rows) * 2);
+    if (s.tail == tail_pair) { seg_extent(d, s.peer, size_t(s.rows) * K * 2); seg_extent(d, s.py, size_t(s.rows) * 2); }
+    if (s.tail == tail_low || s.tail == tail_pair) seg_extent(d, s.out, size_t(s.rows) * 2);
+    if (s.tail == tail_attention) { if (Split == 1) throw std::invalid_argument("draft_fast: attention tail needs Split 4"); seg_extent(d, s.out, size_t(s.rows) * 2 * 4); seg_extent(d, s.inject, 4 * 2); }
+    if (Split > 1 && s.rows % 2) throw std::invalid_argument("draft_fast: 4-part segments hold even row counts");
+    op.spec.rows[j] = s.rows;
+    op.spec.tail[j] = s.tail;
+    ids[1 + 6 * j] = s.w;
+    ids[2 + 6 * j] = s.tail == tail_pair ? s.peer : s.w;
+    ids[3 + 6 * j] = s.y;
+    ids[4 + 6 * j] = s.tail == tail_pair ? s.py : s.y;
+    ids[5 + 6 * j] = s.tail != tail_none ? s.out : s.y;
+    ids[6 + 6 * j] = s.tail == tail_attention ? s.inject : s.y;
+  }
+  op.spec.count = uint32_t(segs.size());
+  const size_t used = 1 + 6 * segs.size();
+  auto e = d.compute(op, std::span<const Allocation>(ids.data(), used), {});
+  return {e, e, 1};
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// p59 draft norm, faster exact form. Per row (one 256-item work-group, as p59::Norm): lane l's sum of v*v over
+// k = l, l+256, ... in order; the 256-lane adjacent-pair tree (levels 1..16 by shuffles inside each 32-lane subgroup,
+// then (p0+p1)+(p2+p3) and (p4+p5)+(p6+p7) and their sum from the eight subgroup sums); inv = rsqrt(s/n + 1e-6);
+// y = bf16((v*inv)*gain). Up to two jobs per launch (job of each group chosen statically); job 0 may carry the
+// ffn.combine prologue (cnorm): row h of the BF16 streams gets streams + branch*(2*sigmoid(inject[h]/4)) under the
+// combine kernel's guard (active and no error), is written back, and the norm uses the stored values.
+struct NormJob { uint16_t* x; const float* gain; uint16_t* y; uint32_t rows, first, per; };
+struct NormArgs {
+  NormJob j[2]; uint32_t count, groups, combine;
+  const uint16_t* branch; const uint16_t* inject; const uint32_t* active; uint32_t* error;
+};
+template <unsigned PER>
+inline void norm_row(const NormArgs& a, const NormJob& jb, uint32_t row, bool combine, sycl::nd_item<1> it, float* part) {
+  auto sg = it.get_sub_group();
+  const unsigned l = unsigned(it.get_local_linear_id()), lane = l % 32, sgid = l / 32;
+  constexpr unsigned n = PER * 256;
+  uint16_t* xr = jb.x + size_t(row) * n;
+  float v[PER];
+  if (combine) {
+    const bool go = *a.active &&
+        !sycl::atomic_ref<uint32_t, sycl::memory_order::relaxed, sycl::memory_scope::device,
+                          sycl::access::address_space::global_space>(*a.error).load();
+    const float gate = 2.f * ng::sigmoid(widen(a.inject[row]) / 4.f);
+#pragma unroll
+    for (unsigned j = 0; j < PER; ++j) {
+      const unsigned k = l + 256 * j;
+      if (go) {
+        const float c = widen(xr[k]) + widen(a.branch[k]) * gate;
+        const uint16_t cb = iq3::bf16_bits(c);
+        xr[k] = cb;
+        v[j] = widen(cb);
+      } else v[j] = widen(xr[k]);
+    }
+  } else {
+#pragma unroll
+    for (unsigned j = 0; j < PER; ++j) v[j] = widen(xr[l + 256 * j]);
+  }
+  float sum = 0;
+#pragma unroll
+  for (unsigned j = 0; j < PER; ++j) { const float sq = v[j] * v[j]; sum = sum + sq; }
+#pragma unroll
+  for (unsigned w = 1; w < 32; w *= 2) {
+    const float r = sycl::select_from_group(sg, sum, (lane + w) % 32);
+    if (lane % (2 * w) == 0) sum = sum + r;
+  }
+  if (lane == 0) part[sgid] = sum;
+  sycl::group_barrier(it.get_group());
+  const float s01 = part[0] + part[1], s23 = part[2] + part[3], s45 = part[4] + part[5], s67 = part[6] + part[7];
+  const float s03 = s01 + s23, s47 = s45 + s67;
+  const float total = s03 + s47;
+  const float inv = detmath::rsqrt(total / float(n) + 1e-6f);
+  const float* g = jb.gain + size_t(row) * n;
+  uint16_t* y = jb.y + size_t(row) * n;
+#pragma unroll
+  for (unsigned j = 0; j < PER; ++j) { const unsigned k = l + 256 * j; y[k] = iq3::bf16_bits((v[j] * inv) * g[k]); }
+}
+struct Norms final : ownrt::SyclOperation {
+  uint32_t count = 0, rows[2]{}, per[2]{}, combine = 0;
+  sycl::event submit(sycl::queue& q, std::span<void* const> p, const std::vector<sycl::event>& deps) const override {
+    NormArgs a{};
+    a.count = count;
+    uint32_t first = 0;
+    for (uint32_t j = 0; j < count; ++j) {
+      a.j[j] = NormJob{static_cast<uint16_t*>(p[3 * j]), static_cast<const float*>(p[3 * j + 1]),
+                       static_cast<uint16_t*>(p[3 * j + 2]), rows[j], first, per[j]};
+      first += rows[j];
+    }
+    a.groups = first;
+    a.combine = combine;
+    a.branch = static_cast<const uint16_t*>(p[6]);
+    a.inject = static_cast<const uint16_t*>(p[7]);
+    a.active = static_cast<const uint32_t*>(p[8]);
+    a.error = static_cast<uint32_t*>(p[9]);
+    return ownrt::prepared_submit(q, [=, r0 = sycl::nd_range<1>(size_t(a.groups) * 256, 256)](sycl::handler& h) {
+      sycl::local_accessor<float, 1> part(8, h);
+      h.parallel_for(r0, packet26::checked([=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(32)]] {
+        const uint32_t g = uint32_t(it.get_group_linear_id());
+        NormJob jb = a.j[0];
+        bool second = a.count > 1 && g >= a.j[1].first;
+        if (second) jb = a.j[1];
+        const uint32_t row = g - jb.first;
+        const bool combine = a.combine && !second;
+        float* pp = &part[0];
+        if (jb.per == 40) norm_row<40>(a, jb, row, combine, it, pp);
+        else norm_row<10>(a, jb, row, combine, it, pp);
+      }));
+    });
+  }
+};
+struct NormIn { Allocation x{}, gain{}, y{}; uint32_t rows = 0, width = 0; };
+// jobs: 1 or 2 (widths 2560 or 10240). combine (job 0 only): branch (width BF16), inject (rows BF16), active, error.
+inline integrated::Launch norms(ownrt::Device& d, const std::vector<NormIn>& jobs, bool combine = false,
+                                Allocation branch = {}, Allocation inject = {}, Allocation active = {}, Allocation error = {}) {
+  if (jobs.empty() || jobs.size() > 2) throw std::invalid_argument("draft_fast norms: 1-2 jobs");
+  Norms op;
+  std::array<Allocation, 10> ids{};
+  for (size_t j = 0; j < jobs.size(); ++j) {
+    const auto& b = jobs[j];
+    if (!b.rows || (b.width != 2560 && b.width != 10240)) throw std::invalid_argument("draft_fast norm width");
+    const size_t n = size_t(b.rows) * b.width;
+    seg_extent(d, b.x, n * 2); seg_extent(d, b.gain, n * 4); seg_extent(d, b.y, n * 2);
+    ids[3 * j] = b.x; ids[3 * j + 1] = b.gain; ids[3 * j + 2] = b.y;
+    op.rows[j] = b.rows; op.per[j] = b.width / 256;
+  }
+  if (jobs.size() == 1) { ids[3] = ids[0]; ids[4] = ids[1]; ids[5] = ids[2]; }
+  op.count = uint32_t(jobs.size());
+  if (combine) {
+    if (jobs[0].width != 2560 || jobs[0].rows != 4) throw std::invalid_argument("draft_fast cnorm shape");
+    seg_extent(d, branch, 2560 * 2); seg_extent(d, inject, 4 * 2); seg_extent(d, active, 4); seg_extent(d, error, 4);
+    ids[6] = branch; ids[7] = inject; ids[8] = active; ids[9] = error; op.combine = 1;
+  } else { ids[6] = ids[0]; ids[7] = ids[0]; ids[8] = ids[0]; ids[9] = ids[0]; }
+  auto e = d.compute(op, ids, {});
+  return {e, e, 1};
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// merge: embedding_projected (fc_embedding · x_e) and projected (fc_hidden · x_h[t], t = 0..3) of weight row r in one
+// subgroup; out[t][r] = bf16(projected[t][r] + embedding_projected[r]) (p59 merge_add tail).
+struct MergeArgs { const uint16_t *we, *xe, *wh, *xh; uint16_t *ye, *yh, *out; uint32_t rows; };
+struct Merge final : ownrt::SyclOperation {
+  uint32_t rows = 0;
+  // R weight rows per subgroup (consecutive rows r0..r0+R-1): each 8-column chunk of x_e and the four x_h rows is loaded
+  // once and applied to the R rows; every output keeps its own lane sums (same chunk order, same adds) and own tree.
+  template <unsigned R>
+  sycl::event run(sycl::queue& q, const MergeArgs a) const {
+    constexpr unsigned K = 2560;
+    const size_t groups = (size_t(a.rows) + R - 1) / R;
+    const size_t global = ((groups * 32 + 255) / 256) * 256;
+    return ownrt::prepared_submit(q, [=, r0 = sycl::nd_range<1>(global, 256)](sycl::handler& h) {
+      h.parallel_for(r0, packet26::checked([=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(32)]] {
+        auto sg = it.get_sub_group();
+        const unsigned l = sg.get_local_linear_id();
+        const size_t first = (it.get_global_linear_id() / 32) * R;
+        if (first >= a.rows) return;
+        float e[R], s[R][4];
+#pragma unroll
+        for (unsigned r = 0; r < R; ++r) { e[r] = 0.f; for (unsigned t = 0; t < 4; ++t) s[r][t] = 0.f; }
+        for (unsigned k = l * 8; k < K; k += 256) {
+          sycl::vec<uint16_t, 8> xev, xv[4];
+          xev.load(0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(a.xe + k));
+#pragma unroll
+          for (unsigned t = 0; t < 4; ++t)
+            xv[t].load(0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(a.xh + size_t(t) * K + k));
+#pragma unroll
+          for (unsigned r = 0; r < R; ++r) {
+            const size_t row = first + r < a.rows ? first + r : first;
+            sycl::vec<uint16_t, 8> wev, whv;
+            wev.load(0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(a.we + row * K + k));
+            whv.load(0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(a.wh + row * K + k));
+#pragma unroll
+            for (unsigned j = 0; j < 8; ++j) { const float v = widen(wev[j]); const float pr = v * widen(xev[j]); e[r] = e[r] + pr; }
+#pragma unroll
+            for (unsigned t = 0; t < 4; ++t)
+#pragma unroll
+              for (unsigned j = 0; j < 8; ++j) { const float v = widen(whv[j]); const float pr = v * widen(xv[t][j]); s[r][t] = s[r][t] + pr; }
+          }
+        }
+#pragma unroll
+        for (unsigned r = 0; r < R; ++r) {
+          for (unsigned width = 1; width < 32; width *= 2) {
+            const float rr = sycl::select_from_group(sg, e[r], (l + width) % 32);
+            if (l % (2 * width) == 0) e[r] += rr;
+          }
+#pragma unroll
+          for (unsigned t = 0; t < 4; ++t)
+            for (unsigned width = 1; width < 32; width *= 2) {
+              const float rr = sycl::select_from_group(sg, s[r][t], (l + width) % 32);
+              if (l % (2 * width) == 0) s[r][t] += rr;
+            }
+        }
+        if (l == 0) {
+#pragma unroll
+          for (unsigned r = 0; r < R; ++r) {
