+ sycl::event submit(sycl::queue&q,std::span<void*const>p,const std::vector<sycl::event>&)const override {auto b=bind_tokens(a,p);
+  const unsigned groups=b.rows/R,S=b.slots;const size_t subgroups=size_t(groups)*S;
