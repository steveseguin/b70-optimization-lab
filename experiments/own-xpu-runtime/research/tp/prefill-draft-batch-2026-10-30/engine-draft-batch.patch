+   h.parallel_for(p35_range0,packet26::checked([=](sycl::nd_item<1>it)[[sycl::reqd_sub_group_size(32)]]{
+    auto sg=it.get_sub_group();const unsigned l=sg.get_local_linear_id();if(it.get_global_linear_id()/32>=subgroups)return;
