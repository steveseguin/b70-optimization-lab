+    if (lane % (2 * s) == 0) {
+      a = a + ra;
+      b = b + rb;
+      if (s < 16) c = c + rc;
+    }
+  }
+  float v64 = c + 0.f;
+  float v0 = a + b;
+  v64 = v64 + 0.f;
+  v0 = v0 + v64;
+  return v0;
