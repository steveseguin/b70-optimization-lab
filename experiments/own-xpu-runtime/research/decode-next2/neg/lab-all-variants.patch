--- a/src/stage2/packet194-expert-diet-engine/dn2_kernels.hpp
+++ b/src/stage2/packet194-expert-diet-engine/dn2_kernels.hpp
@@ -0,0 +1,213 @@
+#pragma once
+// OWNRT_DECODE_NEXT2 device bodies (lab 2026-10-26), standalone so the CPU-device tests run the same code as the engine.
+#include <sycl/sycl.hpp>
+#include <bit>
+#include <cstdint>
+#include "stage2/packet2/kernels/math.hpp"
+#include "stage2/packet6-kopt/reference.hpp"
+namespace dn2 {
+using iq3::Type;
+// Plain view of one routed IQ3_XXS block launch (gsqn::Bound restated): weights, F32 input per slot, F32 output per slot.
+struct XxsView {const uint8_t* w;const float* x;float* y;const iq3::Route* routes;uint32_t* status;uint32_t rows,columns,row_bytes,count,experts;};
+// xxs MODE 1|2: packed logical lanes (see decode_next2.hpp). One 16-lane subgroup = two rows (set = lane/8); item t owns
+// logical lanes 4t..4t+3 of block_lane_sum's mapping. WGSG subgroups per work-group. MODE 2: grid from a work-group copy
+// (every item reaches the barrier before any return).
+template<int MODE,unsigned WGSG,unsigned SG> inline const uint32_t* xxs_grid(sycl::nd_item<1> it){
+ if constexpr(MODE==2){uint32_t* tab=*sycl::ext::oneapi::group_local_memory_for_overwrite<uint32_t[256]>(it.get_group());
+  for(unsigned li=unsigned(it.get_local_linear_id());li<256;li+=SG*WGSG)tab[li]=iq3::iq3_grid[li];
+  sycl::group_barrier(it.get_group());return tab;}
+ else return iq3::iq3_grid;
+}
+// Rows of one matrix for subgroup index `logical` within it (two rows per 16 lanes, four per 32).
+template<unsigned SG> inline void xxs_packed_rows(const XxsView v,uint32_t logical,const uint32_t* grid,sycl::nd_item<1> it){
+ constexpr unsigned RPS=SG/8;
+ const uint32_t blocks=(v.rows+RPS-1)/RPS,total=blocks*v.count;
+ const auto sg=it.get_sub_group();const unsigned lane=sg.get_local_linear_id(),set=lane/8,t=lane%8;
+ if(logical>=total)return;
+ const uint32_t slot=logical/blocks,row=(logical%blocks)*RPS+set;
+ const iq3::Route r=v.routes[slot];const bool valid=iq3::valid_route(r,v.experts,v.rows,v.rows);
+ const bool live=valid&&row<v.rows&&row<r.row_count;
+ const float* x=v.x+size_t(slot)*v.columns;
+ const uint8_t* w=live?v.w+(size_t(r.expert_id)*v.rows+r.row_begin+row)*v.row_bytes:v.w;
+ float acc[4]={0.f,0.f,0.f,0.f};
+ if(live){
+  const uint32_t nblocks=v.columns/256;const unsigned cshift=7*(t/2),sbase=4*(t%2);
+  for(uint32_t block=0;block<nblocks;++block){
+   const uint8_t* packed=w+block*98u;const float d=iq3::half(iq3::u16(packed));
+   #pragma unroll
+   for(unsigned group=0;group<8;++group){
+    const auto*half_words=reinterpret_cast<const uint16_t*>(packed+66+4*group);const uint32_t word=uint32_t(half_words[0])|uint32_t(half_words[1])<<16;
+    const uint32_t code=(word>>cshift)&127,mask=code|((std::popcount(code)%2)<<7);
+    const float scale=(d*(0.5f+float(word>>28)))*0.5f;
+    const uint32_t entry=grid[packed[2+group*8+t]];
+    const sycl::vec<float,4> xv=*reinterpret_cast<const sycl::vec<float,4>*>(x+block*256u+group*32u+4u*t);
+    #pragma unroll
+    for(unsigned j=0;j<4;++j){const uint32_t mag=(entry>>(8*j))&255;const int sign=(mask>>(sbase+j))&1?-1:1;
+     const float weight=(scale*float(mag))*float(sign);const float product=weight*xv[j];acc[j]=acc[j]+product;}
+   }
+  }
+ }
+ const float a01=acc[0]+acc[1],a23=acc[2]+acc[3];float sum=a01+a23;
+ #pragma unroll
+ for(unsigned width=1;width<8;width*=2){const float rhs=sycl::select_from_group(sg,sum,(lane+width)%SG);if(t%(2*width)==0)sum=sum+rhs;}
+ if(t==0&&row<v.rows)v.y[size_t(slot)*v.rows+row]=live?sum:iq3::bits_float(0x7fc00000);
+ if(lane==0&&logical%blocks==0&&v.status)v.status[slot]=!valid;
+}
+template<int MODE,unsigned WGSG,unsigned SG=16> inline void xxs_packed(const XxsView v,sycl::nd_item<1> it){
+ const uint32_t* grid=xxs_grid<MODE,WGSG,SG>(it);
+ const uint32_t logical=uint32_t(it.get_group_linear_id())*WGSG+uint32_t(it.get_sub_group().get_group_linear_id());
+ xxs_packed_rows<SG>(v,logical,grid,it);
+}
+// xxspair: the gate and up matrices of one expert layer (same input and routes) in one launch: subgroups [0, total_g)
+// take gate rows, the rest up rows, each with xxs_packed's unchanged per-row work.
+template<int MODE,unsigned WGSG,unsigned SG> inline void xxs_packed_pair(const XxsView g,const XxsView u,sycl::nd_item<1> it){
+ const uint32_t* grid=xxs_grid<MODE,WGSG,SG>(it);
+ constexpr unsigned RPS=SG/8;const uint32_t total_g=((g.rows+RPS-1)/RPS)*g.count;
+ const uint32_t logical=uint32_t(it.get_group_linear_id())*WGSG+uint32_t(it.get_sub_group().get_group_linear_id());
+ const bool second=logical>=total_g;
+ xxs_packed_rows<SG>(second?u:g,second?logical-total_g:logical,grid,it);
+}
+// iq3block::block_element_words with the grid from a pointer (the same index byte and word).
+inline float xxs_element_tab(const uint8_t*b,float d,unsigned group,unsigned lane,const uint32_t* grid){
+ const auto*half_words=reinterpret_cast<const uint16_t*>(b+66+4*group);const uint32_t word=uint32_t(half_words[0])|uint32_t(half_words[1])<<16,code=(word>>(7*(lane/8)))&127;
+ const auto mask=code|((std::popcount(code)%2)<<7);
+ const int sign=(mask>>(lane%8))&1?-1:1;
+ const uint32_t index=(uint32_t(reinterpret_cast<const uint16_t*>(b+2+group*8)[lane/8])>>(8*((lane/4)%2)))&255;
+ const auto mag=(grid[index]>>(8*(lane%4)))&255;
+ return (((d*(0.5f+float(word>>28)))*0.5f)*float(mag))*float(sign);
+}
+// xxs MODE 3: iq3block::BlockRowsOperation<4>'s body with the grid from a work-group copy; WGSG 32-lane subgroups per
+// work-group (the original runs one per work-group).
+template<unsigned WGSG> inline void xxs_rows_tab(const XxsView v,sycl::nd_item<1> it){
+ constexpr unsigned R=4;
+ const uint32_t blocks=(v.rows+R-1)/R,total=blocks*v.count;
