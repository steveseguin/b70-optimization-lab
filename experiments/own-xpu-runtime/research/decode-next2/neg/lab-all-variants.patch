+#pragma once
+// OWNRT_DECODE_NEXT2 (lab 2026-10-26, default off): exact decode-step changes after OWNRT_DECODE_NEXT. A comma list of
+// tokens (variants through OWNRT_DN2_* numbers):
+//  hclow   dense BF16 decode rows with K > 1024 (HC low+inject, router, ...): kopt's 32 logical lanes of a row split over
+//          two 16-lane subgroups of one work-group (the same per-lane chunk loop; tree levels 1..8 in each subgroup,
+//          the last level lower + upper through work-group memory). OWNRT_DN2_HCLOW_U: chunks loaded per step (8).
+//  hcgate  dense BF16 decode rows with K <= 1024 (HC gate): OWNRT_DN2_HCGATE=1 packed logical lanes (work-item t owns
+//          lanes 4t..4t+3, 16-lane subgroups, two rows each); 2|8: dense_v2 with 2|8 rows per subgroup.
+//  xxs     routed IQ3_XXS gate/up (block kernel): OWNRT_DN2_XXS=1 packed logical lanes (one grid word for four lanes),
+//          2 the same with the grid in work-group memory, 3 the unchanged lane mapping with the grid in work-group memory.
+//  sgrid   routed IQ3_S / IQ2_S rows (kopt block rows): grid in work-group memory.
+// Each output keeps its float operation sequence; see research/decode-next2/RESULT.md.
+#include <cstdlib>
+#include <string>
+namespace decode_next2 {
+inline const std::string& list() {
+  static const std::string v=[]{const char* e=std::getenv("OWNRT_DECODE_NEXT2");return std::string(e?e:"");}();
+  return v;
+}
+inline bool enabled(const char* token) {
+  const auto& v=list();if(v.empty()||v=="0")return false;
+  return (","+v+",").find(std::string(",")+token+",")!=std::string::npos;
+}
+inline int variant(const char* name,int fallback) {const char* e=std::getenv(name);return e?std::atoi(e):fallback;}
+}
