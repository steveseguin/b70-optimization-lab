+// Coordinator scratch experiment (2026-10-11): the block scale is read once for the lane's eight
+// consecutive weights instead of once per weight. Same value expression s*float(code), same product,
+// same per-lane order. Only for the expanded Q6/Q8 formats, whose scale group (16 or 32 weights)
+// always contains a lane-tile (start index is a multiple of 8, split boundaries are multiples of 32).
+template<Type T> inline float lane_h(const uint8_t* w,const uint16_t* x,Type a,size_t k,size_t begin,size_t end,unsigned l){
+ if constexpr(T==Type::Q6_K || T==Type::Q8_0){
+  float sum=0;const size_t cs=codes_size(T,k);const unsigned gs=group_size(T);
+  for(size_t tile=begin+size_t(l)*8;tile<end;tile+=256){
+   float s=bits_float(u32(w+cs+4*(tile/gs)));
+   for(unsigned j=0;j<8 && tile+j<end;++j){size_t i=tile+j;
+    float input=a==Type::BF16?bits_float(uint32_t(x[i])<<16):half(x[i]);float v=s*float(signed8(w[i]));float prod=v*input;sum=sum+prod;}
+  }
+  return sum;
+ } else return lane(T,w,x,a,k,begin,end,l);
+}
