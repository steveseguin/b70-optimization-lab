{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:own-runtime:h2d:receipt:v1",
  "title": "Packet 5 complete measured transport receipt (not a model performance claim)",
  "type": "object",
  "required": [
    "schema",
    "measured",
    "completed",
    "error",
    "devices",
    "plan",
    "cases",
    "overlap",
    "overlap_summary",
    "census",
    "teardown",
    "streaming_arithmetic"
  ],
  "properties": {
    "schema": {
      "const": "own-runtime.h2d.receipt.v1"
    },
    "measured": {
      "const": true
    },
    "completed": {
      "const": true
    },
    "error": {
      "const": ""
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": ":uuid="
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "census_sha256",
        "cases",
        "active_expert_bytes_per_token"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 30,
      "maxItems": 36,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/case"
          },
          {
            "required": [
              "median_wall_GBps",
              "median_event_payload_GBps",
              "link_bytes_per_repetition"
            ],
            "properties": {
              "samples": {
                "items": {
                  "required": [
                    "wall_GBps",
                    "event_payload_GBps"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "overlap": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "overlap_summary": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "label",
          "overlap_ratio",
          "median_event_overlap_fraction",
          "repetitions_without_event_timing",
          "event_overlap_fractions"
        ],
        "properties": {
          "overlap_ratio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "median_event_overlap_fraction": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "repetitions_without_event_timing": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "event_overlap_fractions": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "items": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "census": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "allocations",
          "unmeasured_driver_shadow_bytes"
        ]
      }
    },
    "teardown": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "safe_to_exit",
          "live_bytes",
          "in_flight",
          "sequence"
        ],
        "properties": {
          "safe_to_exit": {
            "const": true
          },
          "live_bytes": {
            "const": 0
          },
          "in_flight": {
            "const": 0
          }
        }
      }
    },
    "streaming_arithmetic": {
      "type": "object",
      "required": [
        "pinned",
        "pageable"
      ]
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "label",
        "bytes",
        "mode",
        "verified",
        "samples",
        "repetitions_without_event_timing"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "mode": {
          "type": "string"
        },
        "verified": {
          "const": true
        },
        "samples": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "median_wall_GBps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "median_event_payload_GBps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "repetitions_without_event_timing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "sample": {
      "type": "object",
      "required": [
        "wall_ns",
        "host_bounce_memcpy_ns",
        "events",
        "event_ns"
      ],
      "properties": {
        "wall_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "host_bounce_memcpy_ns": {
          "type": "number",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "device",
              "kind",
              "start_ns",
              "end_ns",
              "duration_ns"
            ],
            "properties": {
              "device": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "start_ns": {
                "type": "integer",
                "minimum": 0
              },
              "end_ns": {
                "type": "integer",
                "minimum": 0
              },
              "duration_ns": {
                "type": [
                  "integer",
                  "null"
                ],
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "event_ns": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "wall_GBps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "event_payload_GBps": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
