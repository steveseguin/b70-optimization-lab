+// ---- BENCH_XS_STREAM: one-token XFull work shapes over today's layout (round 8) ----
+// XFull's per-block arithmetic, unchanged, with other assignments of (expert, 16-row block) to sub-groups, to see
+// whether fewer weight streams at once (fewer sub-groups, each reading more) beat today's 1,152 one-block sub-groups:
+//   RB   row blocks per sub-group, one after the other; the weight pipeline (next pass in registers, the L1 prefetch
+//        PD steps ahead) runs on across the block boundary into the next block's first passes.
+//        STR 0: consecutive blocks (blocks w RB .. w RB + RB - 1: one contiguous RB x 20,736 / 10,368 byte stream per
+//        sub-group); STR 1: blocks w, w + NW, ... (the NW workers of one expert matrix read adjacent blocks together).
+//   BT   B tiles per sub-group: 2 puts gate|up's gate and up blocks of the same 16 rows (down: blocks 2q, 2q + 1) in
+//        one sub-group, the three input parts loaded once for both tiles (each tile keeps its own c1, c23, total).
+//   NP   units per work-group (BT 1: NP gate|up pairs / 2 NP down blocks; BT 2: NP sub-groups).
+// Every block, as XFull: total = 0; per segment c1 = c23 = 0, per step c1 = DPAS(c1, x1, w), c23 = DPAS(c23, x2, w),
+// c23 = DPAS(c23, x3, w); at the segment's end c1 = c1 + c23, total = total + c1. One token (M = 1), today's tile
+// layout (xm::fetchn, 5 loads per pass), 128 registers. Raw sums to Y[expert slot][row] as XFL. Inputs as the engine's
+// one-token step: gate|up every slot the one row x (P), down slot t its own row h_t (P + t cols, planes pp apart).
+template <int MODE, int RB, int STR, int BT, int NP, int PF = 4, int PD = 8> struct XFS {
+    static_assert(PF == 4 && PD % 4 == 0 && PD > 0, "passes of 4 steps, prefetch whole passes ahead");
+    static_assert(BT == 1 || BT == 2, "one or two B tiles per sub-group");
+    static_assert(RB >= 1 && NP >= 1 && (STR == 0 || STR == 1), "shape");
+    static constexpr int NSG = BT == 1 ? 2 * NP : NP; // sub-groups per work-group
+    const uint8_t *W; size_t estride; int cols, nff, nrb; // nrb: 16-row blocks of the tensor (gate|up 2 nff / 16)
+    const int32_t *ex; const uint16_t *P; size_t pp; float *Y; int ldy;
+    sycl::local_accessor<float, 1> st;
+    auto get(sycl::ext::oneapi::experimental::properties_tag) const {
+        return sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<128>};
+    }
+    [[sycl::reqd_sub_group_size(16)]] void operator()(sycl::nd_item<2> it) const {
+        using C = jm::joint_matrix<sycl::sub_group, float, jm::use::accumulator, 1, 16>;
+        using A = jm::joint_matrix<sycl::sub_group, bf, jm::use::a, 1, 16, jm::layout::row_major>;
+        using B = jm::joint_matrix<sycl::sub_group, bf, jm::use::b, 16, 16, jm::layout::ext_intel_packed>;
+        namespace sx = sycl::ext::oneapi::experimental;
+        auto gp = [](const bf *p) { return sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(p); };
+        const auto sg = it.get_sub_group();
+        const int t = (int)it.get_group(0), gi = (int)it.get_group(1);
+        const int sgi = (int)sg.get_group_linear_id(), ln = (int)sg.get_local_linear_id();
+        const int steps = cols / 16, nh = nff / 16;
+        // units per expert (gate|up: row blocks of one matrix; down: blocks, or block pairs with BT 2), workers
+        const int nu = MODE == 0 ? nh : (BT == 1 ? nrb : nrb / 2), nw = nu / RB;
+        const int m = MODE == 0 && BT == 1 ? sgi % 2 : 0;                      // gate|up, one tile: gate (0) or up (1)
+        const int wk = MODE == 0 && BT == 1 ? gi * NP + sgi / 2 : gi * NSG + sgi; // worker of this expert (matrix)
+        // RB 1, BT 1, NP 1 is XFull's own map: gate|up blk = sgi nh + gi, down blk = 2 gi + sgi
+        auto blkof = [&](int s, int j) {
+            const int u = STR ? wk + s * nw : wk * RB + s;
+            if constexpr (MODE == 0) return (BT == 1 ? m : j) * nh + u;
+            else return BT == 1 ? u : 2 * u + j;
+        };
+        const uint8_t *We = W + (size_t)ex[t] * estride;
+        const size_t bsz = (size_t)steps * xm::TB; // bytes of one 16-row block
+        auto wof = [&](int s, int j) { return We + (size_t)blkof(s, j) * bsz; };
+        // down: input row t (P + t cols, as the engine's one-token down: one = false, tile t = slot t); gate|up: row 0
+        const bf *pa = reinterpret_cast<const bf *>(P) + (MODE == 1 ? (size_t)t * cols : 0);
+        xm::Raw r0[PF], r1[PF];
+        xm::fetchn<PF>(wof(0, 0), 0, ln, r0);
+        if constexpr (BT == 2) xm::fetchn<PF>(wof(0, 1), 0, ln, r1);
+        B rb0, rb1;
+        jm::joint_matrix_fill(sg, rb0, bf(0.0f));
+        if constexpr (BT == 2) jm::joint_matrix_fill(sg, rb1, bf(0.0f));
+#pragma unroll 1
+        for (int s = 0; s < RB; ++s) {
+            const bool more = s + 1 < RB;
+            const uint8_t *w0 = wof(s, 0);
+            const uint8_t *w1 = BT == 2 ? wof(s, 1) : w0;
+            const uint8_t *v0 = more ? wof(s + 1, 0) : w0; // the next block (this one after the last)
+            const uint8_t *v1 = BT == 2 && more ? wof(s + 1, 1) : w1;
+            C c1a, c23a, ta, c1b, c23b, tb;
+            jm::joint_matrix_fill(sg, ta, 0.0f);
+            if constexpr (BT == 2) jm::joint_matrix_fill(sg, tb, 0.0f);
+            for (int k0 = 0; k0 < steps; k0 += xm::SEG) {
+                const int ns = sycl::min(xm::SEG, steps - k0);
+                jm::joint_matrix_fill(sg, c1a, 0.0f);
+                jm::joint_matrix_fill(sg, c23a, 0.0f);
+                if constexpr (BT == 2) {
+                    jm::joint_matrix_fill(sg, c1b, 0.0f);
+                    jm::joint_matrix_fill(sg, c23b, 0.0f);
+                }
+                for (int b = 0; b < ns; b += PF) {
+                    const int kb = k0 + b;
+                    // the next pass: this block's; at its end the next block's first (XFull: its own last again)
+                    const bool last = kb + PF >= steps, cross = last && more;
+                    const int kn = last ? (more ? 0 : steps - PF) : kb + PF;
+                    xm::Raw n0[PF], n1[PF];
+                    xm::fetchn<PF>(cross ? v0 : w0, kn, ln, n0);
+                    if constexpr (BT == 2) xm::fetchn<PF>(cross ? v1 : w1, kn, ln, n1);
+                    { // L1 prefetch of the pass PD steps ahead (XFull: min(kb + PD, steps - PF)), across into the next block
+                        const bool spill = kb + PD > steps - PF, pnext = spill && more;
+                        const int kp = spill ? (more ? kb + PD - steps : steps - PF) : kb + PD;
+                        const size_t lo = (size_t)kp * xm::TB + (size_t)sycl::min(ln, PF * xm::TB / 64 - 1) * 64;
+                        sx::prefetch((void *)((pnext ? v0 : w0) + lo), 64, sx::properties{sx::prefetch_hint_L1});
+                        if constexpr (BT == 2) sx::prefetch((void *)((pnext ? v1 : w1) + lo), 64, sx::properties{sx::prefetch_hint_L1});
+                    }
+#pragma unroll
+                    for (int i = 0; i < PF; ++i) {
+                        {
+                            float v[16];
+                            xm::decode_vals(r0[i], v);
+                            int e = 0;
+                            jm::joint_matrix_apply(sg, rb0, [&](bf &x) { x = sycl::bit_cast<bf>((uint16_t)(sycl::bit_cast<uint32_t>(v[e]) >> 16)); ++e; });
+                        }
+                        A x0, x1, x2;
+                        const bf *pk = pa + (size_t)(kb + i) * 16;
+                        jm::joint_matrix_load(sg, x0, gp(pk), cols);
+                        jm::joint_matrix_load(sg, x1, gp(pk + pp), cols);
+                        jm::joint_matrix_load(sg, x2, gp(pk + 2 * pp), cols);
+                        jm::joint_matrix_mad(sg, c1a, x0, rb0, c1a);
+                        jm::joint_matrix_mad(sg, c23a, x1, rb0, c23a);
+                        jm::joint_matrix_mad(sg, c23a, x2, rb0, c23a);
+                        if constexpr (BT == 2) {
+                            float v[16];
+                            xm::decode_vals(r1[i], v);
+                            int e = 0;
+                            jm::joint_matrix_apply(sg, rb1, [&](bf &x) { x = sycl::bit_cast<bf>((uint16_t)(sycl::bit_cast<uint32_t>(v[e]) >> 16)); ++e; });
+                            jm::joint_matrix_mad(sg, c1b, x0, rb1, c1b);
+                            jm::joint_matrix_mad(sg, c23b, x1, rb1, c23b);
+                            jm::joint_matrix_mad(sg, c23b, x2, rb1, c23b);
+                        }
+                    }
+#pragma unroll
+                    for (int i = 0; i < PF; ++i) {
+                        r0[i] = n0[i];
+                        if constexpr (BT == 2) r1[i] = n1[i];
+                    }
+                }
+                jm::joint_matrix_apply(sg, c1a, c23a, [](float &u, float &v) { u = u + v; });
+                jm::joint_matrix_apply(sg, ta, c1a, [](float &u, float &v) { u = u + v; });
+                if constexpr (BT == 2) {
+                    jm::joint_matrix_apply(sg, c1b, c23b, [](float &u, float &v) { u = u + v; });
+                    jm::joint_matrix_apply(sg, tb, c1b, [](float &u, float &v) { u = u + v; });
+                }
+            }
+            jm::joint_matrix_store(sg, ta, st.template get_multi_ptr<sycl::access::decorated::no>() + (size_t)(sgi * BT) * 16, 16, jm::layout::row_major);
+            if constexpr (BT == 2)
+                jm::joint_matrix_store(sg, tb, st.template get_multi_ptr<sycl::access::decorated::no>() + (size_t)(sgi * BT + 1) * 16, 16, jm::layout::row_major);
+            sycl::group_barrier(sg);
+            Y[(size_t)t * ldy + (size_t)blkof(s, 0) * 16 + ln] = st[(size_t)(sgi * BT) * 16 + ln];
+            if constexpr (BT == 2) Y[(size_t)t * ldy + (size_t)blkof(s, 1) * 16 + ln] = st[(size_t)(sgi * BT + 1) * 16 + ln];
+            sycl::group_barrier(sg); // the next block's store reuses the slot
+        }
+    }
+};
+// work-groups of XFS per expert (0 if the shape does not divide)
+static int xfs_groups(int mode, int rb, int bt, int np, int nff, int rows) {
+    const int nsg = bt == 1 ? 2 * np : np, nu = mode == 0 ? nff / 16 : (bt == 1 ? rows / 16 : rows / 32), per = mode == 0 && bt == 1 ? np : nsg;
+    return nu % rb || (nu / rb) % per ? 0 : nu / rb / per;
+}
+template <int MODE, int RB, int STR, int BT, int NP>
+static sycl::event xfs(sycl::queue &q, const uint8_t *W, size_t estride, int cols, int nff, int rows, const int32_t *ex, int nex,
+                       const uint16_t *P, size_t pp, float *Y, int ldy) {
+    using K = XFS<MODE, RB, STR, BT, NP>;
+    const int nwg = xfs_groups(MODE, RB, BT, NP, nff, rows), steps = cols / 16;
+    if (!nwg || cols % 16 || steps % 4 || steps < 8 || (steps % xm::SEG) % 4) throw std::runtime_error("xfs: shapes");
+    return q.submit([&](sycl::handler &h) {
+        sycl::local_accessor<float, 1> st((size_t)K::NSG * BT * 16, h);
+        h.parallel_for(sycl::nd_range<2>(sycl::range<2>((size_t)nex, (size_t)nwg * K::NSG * 16), sycl::range<2>(1, (size_t)K::NSG * 16)),
+                       K{W, estride, cols, nff, rows / 16, ex, P, pp, Y, ldy, st});
+    });
+}
+// the study's arms: 0 today's kernel (XFL over today's layout: XFull's own address expressions), 1.. XFS shapes
+constexpr int XS_NA = 6;
+static const char *const xs_names[XS_NA + 1] = {
+    "today (XFL, 1 block / sub-group)", "xfs1 (XFS, today's shape)", "rb2 (2 consecutive blocks)", "rb4 (4 consecutive blocks)",
+    "st2 (2 blocks, stride NW)", "bt2 (2 B tiles, x shared)", "wg4 (4 sub-groups / group)"};
+template <int MODE>
+static void xs_arm(sycl::queue &q, int a, const uint8_t *W, size_t eb, int cols, int nff, int rows, const int32_t *es, int nex,
+                   const uint16_t *P, size_t pp, float *Y, int ldy) {
+    switch (a) {
+    case 0: xfl<L_TODAY, MODE, true>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 1: xfs<MODE, 1, 0, 1, 1>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 2: xfs<MODE, 2, 0, 1, 1>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 3: xfs<MODE, 4, 0, 1, 1>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 4: xfs<MODE, 2, 1, 1, 1>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 5: xfs<MODE, 1, 0, 2, 2>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    default: xfs<MODE, 1, 0, 1, 2>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    }
+}
+// sub-groups per launch of arm a (8 experts), for the report; arm a's RB, BT, NP as in xs_arm
+static int xs_subgroups(int a, int mode, int nff, int rows) {
+    static const int RBv[XS_NA + 1] = {1, 1, 2, 4, 2, 1, 1}, BTv[XS_NA + 1] = {1, 1, 1, 1, 1, 2, 1}, NPv[XS_NA + 1] = {1, 1, 1, 1, 1, 2, 2};
+    const int nsg = BTv[a] == 1 ? 2 * NPv[a] : NPv[a];
+    return 8 * nsg * xfs_groups(mode, RBv[a], BTv[a], NPv[a], nff, rows);
+}
