+// One token, gate|up: XFull<1, 0, PF, SRF, GRF, PD, HL> (no SWAP) with each work-group's gate and up blocks (the same 16
+// rows) cut at segment boundaries into three pieces of 2T segments, one per sub-group (nseg = 3 T segments a block):
+// sub-group 0 gate segments [0, 2T), 1 gate [2T, 3T) then up [0, T), 2 up [T, 3T). A piece runs XFull's step loop on
+// one block at a time (per segment c1 = c23 = 0, per step c1 = DPAS(c1, x1, w), c23 = DPAS(c23, x2, w), c23 = DPAS(c23,
+// x3, w), at its end c1 = c1 + c23; the next pass in registers and the L1 prefetch PD steps ahead, both clamped to the
+// block's steps in the piece; sub-group 1's up steps start their pipeline afresh). The piece that holds a block's first
+// segment adds its segments' sums into a total from 0 in registers, as XFull; every other segment's sum goes to local
+// memory. After the one barrier, lane c of sub-group 0: g = the gate total, + gate sums 2T .. 3T - 1; u = the up
+// total, + up sums T .. 3T - 1, in segment order: XFull's additions in XFull's order, so its g and u bits, then its
+// SITU and split into Hp. The engine's 8 experts x 72 row pairs are 1,728 sub-groups instead of 1,152 (6.75 per XVE,
+// inside the card's 8 at 128 registers): the busiest XVE runs 7 x 96 = 672 step-times instead of 5 x 144 = 720
+// (bench_xs BENCH_XS_BAL, round 8b, arm b1728nx: 0 of 1,474,560 floats differ, gate|up -2.9 % card 0, -9.7 % card 1).
+// Local memory, rows of 16 floats: 0 the gate total, 1 the up total, 2 .. T + 1 the gate sums 2T .. 3T - 1, T + 2 ..
+// 3T + 1 the up sums T .. 3T - 1 (nseg + 2 rows: 704 bytes for 9 segments)
+template <int PF, int GRF, int PD, int HL> struct XFullB {
+    static_assert(SEG % PF == 0, "passes inside segments");
+    const uint8_t *W; size_t estride; int cols, nff;
+    MoeGroups g; const uint16_t *P; size_t pp; bool one;
+    ActOp op; uint16_t *Hp; size_t hpp;
+    sycl::local_accessor<float, 1> st;
+    auto get(sycl::ext::oneapi::experimental::properties_tag) const {
+        return sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<GRF>};
+    }
+    [[sycl::reqd_sub_group_size(16)]] void operator()(sycl::nd_item<2> it) const {
+        using C = jm::joint_matrix<sycl::sub_group, float, jm::use::accumulator, 1, 16>;
+        using A = jm::joint_matrix<sycl::sub_group, bf, jm::use::a, 1, 16, jm::layout::row_major>;
+        using B = jm::joint_matrix<sycl::sub_group, bf, jm::use::b, 16, 16, jm::layout::ext_intel_packed>;
+        auto gp = [](const bf *p) { return sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(p); };
+        auto lp = [&](size_t off) { return st.template get_multi_ptr<sycl::access::decorated::no>() + off; };
+        const int t = (int)it.get_group(0);
+        if (t >= g.ntiles[0]) return;
+        const auto sg = it.get_sub_group();
+        const int sgi = (int)sg.get_group_linear_id(), ln = (int)sg.get_local_linear_id(), gi = (int)it.get_group(1);
+        const int steps = cols / 16, T = (steps + SEG - 1) / SEG / 3, KT = T * SEG, cnt = g.tile_n[t], s0 = g.tile_s0[t];
+        const uint8_t *we = W + (size_t)g.tile_exp[t] * estride;
+        const bf *pa = reinterpret_cast<const bf *>(P) + (one ? 0 : (size_t)s0) * cols;
+        C c1, c23, tot;
+        B rb;
+        jm::joint_matrix_fill(sg, rb, bf(0.0f));
+        // the sub-group's runs, one block each: 0: gate [0, 2 KT) head; 1: gate [2 KT, steps), then up [0, KT) head;
+        // 2: up [KT, steps). One copy of the step loop for all of them (the code size of XFull's)
+#pragma unroll 1
+        for (int j = 0; j < (sgi == 1 ? 2 : 1); ++j) {
+            const bool up = sgi == 2 || j == 1, head = sgi == 0 || j == 1;
+            const int hb = up ? KT : 2 * KT, ka = head ? 0 : hb, ke = head ? hb : steps; // hb: the block's steps in its head
+            const uint8_t *w = we + (size_t)((up ? nff / 16 : 0) + gi) * steps * TB; // XFull's blk: gate gi, up nff / 16 + gi
+            const size_t so = head ? (up ? 16 : 0) : (up ? (size_t)(T + 2) * 16 : 32);
+            size_t slot = so;
+            Raw r[PF];
+            fetchn<PF>(w, ka, ln, r);
+            jm::joint_matrix_fill(sg, tot, 0.0f);
+            for (int k0 = ka; k0 < ke; k0 += SEG) {
+                const int ns = sycl::min(SEG, ke - k0);
+                jm::joint_matrix_fill(sg, c1, 0.0f);
+                jm::joint_matrix_fill(sg, c23, 0.0f);
+                for (int b = 0; b < ns; b += PF) {
+                    const int kb = k0 + b, kn = sycl::min(kb + PF, ke - PF);
+                    Raw n[PF];
+                    fetchn<PF>(w, kn, ln, n);
+                    if constexpr (PD > 0) { // XFull's, clamped to the run's steps
+                        namespace sx = sycl::ext::oneapi::experimental;
+                        constexpr int PL = (PF < TP ? TP : PF) * TB / 64;
+                        const int kp = sycl::min(kb + PD, ke - PF);
+                        const uint8_t *pp8 = w + (size_t)(kp & ~(TP - 1)) * TB + (size_t)sycl::min(ln, PL - 1) * 64;
+                        if constexpr (HL == 1) sx::prefetch((void *)pp8, 64, sx::properties{sx::prefetch_hint_L1});
+                        else sx::prefetch((void *)pp8, 64, sx::properties{sx::prefetch_hint_L3});
+                    }
+#pragma unroll
+                    for (int i = 0; i < PF; ++i) {
+                        float v[16];
+                        decode_vals(r[i], v);
+                        int e = 0;
+                        jm::joint_matrix_apply(sg, rb, [&](bf &x) { x = sycl::bit_cast<bf>((uint16_t)(sycl::bit_cast<uint32_t>(v[e]) >> 16)); ++e; });
+                        A x0, x1, x2;
+                        const bf *pk = pa + (size_t)(kb + i) * 16;
+                        jm::joint_matrix_load(sg, x0, gp(pk), cols);
+                        jm::joint_matrix_load(sg, x1, gp(pk + pp), cols);
+                        jm::joint_matrix_load(sg, x2, gp(pk + 2 * pp), cols);
+                        jm::joint_matrix_mad(sg, c1, x0, rb, c1);
+                        jm::joint_matrix_mad(sg, c23, x1, rb, c23);
+                        jm::joint_matrix_mad(sg, c23, x2, rb, c23);
+                    }
+#pragma unroll
+                    for (int i = 0; i < PF; ++i) r[i] = n[i];
+                }
+                jm::joint_matrix_apply(sg, c1, c23, [](float &u, float &v) { u = u + v; });
+                if (head) jm::joint_matrix_apply(sg, tot, c1, [](float &u, float &v) { u = u + v; });
+                else {
+                    jm::joint_matrix_store(sg, c1, lp(slot), 16, jm::layout::row_major);
+                    slot += 16;
+                }
+            }
+            if (head) jm::joint_matrix_store(sg, tot, lp(so), 16, jm::layout::row_major);
+        }
+        const bool sc = op.escale != nullptr;
+        const float es = sc && sgi == 0 ? op.escale[g.tile_exp[t]] : 1.0f; // read before the barrier (sub-group 0 uses it)
+        sycl::group_barrier(it.get_group());
+        if (sgi == 0 && cnt > 0) { // XFull: work-items 0-15 for the tile's one row; lane ln takes column ln of every row
+            const float *sp = &st[0];
+            float gv = sp[ln], uv = sp[16 + ln];
+            for (int s = 0; s < T; ++s) gv = gv + sp[(size_t)(2 + s) * 16 + ln];
+            for (int s = 0; s < 2 * T; ++s) uv = uv + sp[(size_t)(T + 2 + s) * 16 + ln];
+            split3_store(act(gv, uv, es, sc, op.beta, op.lb), Hp + (size_t)s0 * nff + gi * 16 + ln, hpp);
+        }
+    }
+};
+// the shapes full_prod_bal takes: full_prod's whole packed passes, every block's segments in three equal parts, row blocks of 16,
+// and (when local_mem_bytes > 0) SLM footprint within the device's per-work-group local-memory limit
+template <int PF = 4> constexpr bool full_bal_fits(int cols, int nff, size_t local_mem_bytes = 0) {
+    const int steps = cols / 16, nseg = (steps + SEG - 1) / SEG;
+    const size_t slm_bytes = (size_t)(nseg + 2) * 16 * sizeof(float);
+    return cols > 0 && cols % 16 == 0 && steps % PF == 0 && steps % TP == 0 && SEG % PF == 0 && (steps % SEG) % PF == 0 &&
+           nseg % 3 == 0 && nff > 0 && nff % 16 == 0 && (local_mem_bytes == 0 || slm_bytes <= local_mem_bytes);
+}
+static_assert(!full_bal_fits<2>(544, 16), "partial four-step pack rejected");
+// one token, gate|up through XFullB (a work-group of 3 sub-groups per row pair): full_prod<1, 0, PF, SRF, GRF, PD, HL>'s
+// Hp for tiles of one row (the engine's one-token tiles)
+template <int PF = 4, int GRF = 128, int PD = 0, int HL = 1>
+inline sycl::event full_prod_bal(sycl::queue &q, const uint8_t *W, size_t estride, int cols, int nff, MoeGroups g, int tiles,
+                                 const uint16_t *P, size_t pp, bool one, ActOp op, uint16_t *Hp, size_t hpp) {
+    const size_t lmem = q.get_device().get_info<sycl::info::device::local_mem_size>();
+    if (!full_bal_fits<PF>(cols, nff, lmem)) throw std::runtime_error("xm::full_prod_bal: shapes");
+    const int nseg = (cols / 16 + SEG - 1) / SEG;
+    return q.submit([&](sycl::handler &h) {
+        sycl::local_accessor<float, 1> st((size_t)(nseg + 2) * 16, h);
+        h.parallel_for(sycl::nd_range<2>(sycl::range<2>((size_t)tiles, (size_t)(nff / 16) * 48), sycl::range<2>(1, 48)),
+                       XFullB<PF, GRF, PD, HL>{W, estride, cols, nff, g, P, pp, one, op, Hp, hpp, st});
+    });
+}
 // XFull with each (tile, 16 rows) split over KS sub-groups by consecutive segments: part 0 adds its segments into a
 // total in registers (from 0), parts 1.. store each segment's sum (c1 + c23); after a barrier the total + those sums
 // in segment order: the same additions in the same order as XFull, with KS times the sub-groups.
