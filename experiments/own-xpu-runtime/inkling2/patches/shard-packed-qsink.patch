+    // One partner's query and sink in a single host-staged round trip. The sink's offset follows this step's row count;
+    // the allocation above leaves room for every row count up to dec_rows, and in-order consumers use the same pointers.
+    static void xcopy_qsink(Engine &xd, Engine &xs, const float *Qd, const float *sc, int nt, int nh, int hd) {
+        static const bool host = std::getenv("INK_SHARD_HOST") && std::atoi(std::getenv("INK_SHARD_HOST"));
+        const size_t qb = (size_t)nt * nh * hd * sizeof(float), sb = (size_t)nt * nh * sizeof(float);
+        xd.shard_sink = xd.shard_q + (size_t)nt * nh * hd;
+        if (&xd.d == &xs.d && !host) {
+            xd.d.q.memcpy(xd.shard_q, Qd, qb);
+            xd.d.q.memcpy(xd.shard_sink, sc, sb);
+            return;
+        }
+        auto &hb = xs.shard_h;
+        hb.resize((qb + sb) / sizeof(float));
+        xs.d.q.memcpy(hb.data(), Qd, qb);
+        xs.d.q.memcpy(hb.data() + qb / sizeof(float), sc, sb);
+        xs.d.q.wait();
+        xd.d.q.memcpy(xd.shard_q, hb.data(), qb + sb).wait();
+    }
