+// ---- INKLING ORACLE PATCH (lab oracle build only; never shipped) ----------------------------------------------
+// GGML_CPU_F32_ACT=1: every listed weight type keeps its own exact decoder (ggml to_float) but is multiplied with
+// F32 activations (no 8/16-bit activation rounding) and summed in double precision. A high-precision oracle for
+// checking our GPU engine, which uses F32 activations.
+static void ink_deq_dot(enum ggml_type t, int n, float * s, const void * x, const void * y) {
+    static __thread float * buf = NULL;
+    static __thread int cap = 0;
+    if (cap < n) { free(buf); buf = (float *) malloc((size_t) n * sizeof(float)); cap = n; }
+    if (t == GGML_TYPE_F32) memcpy(buf, x, (size_t) n * sizeof(float));
+    else ggml_get_type_traits(t)->to_float(x, buf, n);
+    const float * yf = (const float *) y;
+    double acc = 0.0;
+    for (int i = 0; i < n; ++i) acc += (double) buf[i] * (double) yf[i];
+    *s = (float) acc;
+}
+#define INK_DEQ(T) static void ink_deq_dot_##T(int n, float * s, size_t bs, const void * x, size_t bx, const void * y, size_t by, int nrc) { \
+    (void) bs; (void) bx; (void) by; (void) nrc; ink_deq_dot(GGML_TYPE_##T, n, s, x, y); }
+INK_DEQ(F32) INK_DEQ(F16) INK_DEQ(BF16) INK_DEQ(Q8_0) INK_DEQ(Q5_0) INK_DEQ(IQ4_NL) INK_DEQ(IQ4_XS)
+INK_DEQ(Q4_K) INK_DEQ(Q5_K) INK_DEQ(Q6_K) INK_DEQ(NVFP4)
+static void ggml_cpu_f32_act_patch(void) {
+    const char * e = getenv("GGML_CPU_F32_ACT");
+    if (!e || !atoi(e)) return;
+#define INK_SET(T) type_traits_cpu[GGML_TYPE_##T].vec_dot = ink_deq_dot_##T; \
+    type_traits_cpu[GGML_TYPE_##T].vec_dot_type = GGML_TYPE_F32; type_traits_cpu[GGML_TYPE_##T].nrows = 1;
+    INK_SET(F32) INK_SET(F16) INK_SET(BF16) INK_SET(Q8_0) INK_SET(Q5_0) INK_SET(IQ4_NL) INK_SET(IQ4_XS)
+    INK_SET(Q4_K) INK_SET(Q5_K) INK_SET(Q6_K) INK_SET(NVFP4)
+    fprintf(stderr, "INKLING ORACLE: F32 activations, double accumulation for all weight types\n");
+}
+// ---- end INKLING ORACLE PATCH --------------------------------------------------------------------------------
