+// ---- BENCH_XS_BAL: segment-balanced one-token XFull (round 8b) ----
+// Round 8 showed the one-token XFull bound by how its work spreads over the XVEs, not by weight streams (fewer
+// sub-groups, each reading more, lost 23-166 %): 1,152 sub-groups of one 16-row block each on 256 XVEs are 4.5 per XVE,
+// so the busiest XVEs run 5 whole blocks (gate|up 5 x 144 steps, down 5 x 72) against a mean of 4.5. XBal keeps XFull's
+// arithmetic and cuts the work finer, at segment boundaries: a work-group's G blocks (gate|up: the gate and up blocks of
+// G / 2 row pairs, pair by pair, so the SITU epilogue could stay in the work-group; down: G consecutive blocks), their
+// segments end to end (NS = G nseg), go to Q sub-groups, piece q = segments [q NS / Q, (q + 1) NS / Q). Every block, as
+// XFull: per segment c1 = c23 = 0, per step c1 = DPAS(c1, x1, w), c23 = DPAS(c23, x2, w), c23 = DPAS(c23, x3, w), at the
+// segment's end c1 = c1 + c23. The piece that holds a block's first segment (its head) adds the segments it holds into a
+// total from 0 in registers, as XFull, and stores that total in local memory; every other segment's sum c1 is stored
+// there by the sub-group that holds it. After one work-group barrier sub-group j < G folds block j: v = the head's total,
+// then v = v + each stored segment sum after the head's, in ascending segment order: XFull's IEEE additions in XFull's
+// order (as XFullK), so the same bits. XB: the weight pipeline (the next pass in registers, the L1 prefetch PD steps
+// ahead) runs on across a block boundary inside a piece into the next block's first passes; XB false starts each block
+// afresh (XFull's own pattern per block). One token (M = 1), today's tile layout (xm::fetchn), 128 registers, scalar
+// joint_matrix variables only; raw sums to Y[expert slot][row] as XFL. Inputs as the engine's one-token step: gate|up
+// every slot the one row x (P), down slot t its own row h_t (P + t cols, planes pp apart).
+template <int MODE, int Q, int G, bool XB, int PF = 4, int PD = 8> struct XBal {
+    static_assert(PF == 4 && PD % 4 == 0 && PD > 0, "passes of 4 steps, prefetch whole passes ahead");
+    static_assert(G >= 1 && Q >= G && Q <= 64, "a fold block per sub-group, at most 1,024 work-items");
+    static_assert(MODE == 1 || G % 2 == 0, "gate|up: whole (gate, up) row pairs per work-group");
+    const uint8_t *W; size_t estride; int cols, nff;
+    const int32_t *ex; const uint16_t *P; size_t pp; float *Y; int ldy;
+    sycl::local_accessor<float, 1> st; // [G][16] head totals, then [G][nseg][16] stored segment sums
+    auto get(sycl::ext::oneapi::experimental::properties_tag) const {
+        return sycl::ext::oneapi::experimental::properties{sycl::ext::intel::experimental::grf_size<128>};
+    }
+    // block j (0 .. G - 1) of work-group gi: gate|up row pair gi G / 2 + j / 2, its gate (j even) or up block; down gi G + j
+    int blkof(int gi, int j) const { return MODE == 0 ? (j & 1) * (nff / 16) + gi * (G / 2) + j / 2 : gi * G + j; }
+    [[sycl::reqd_sub_group_size(16)]] void operator()(sycl::nd_item<2> it) const {
+        using C = jm::joint_matrix<sycl::sub_group, float, jm::use::accumulator, 1, 16>;
+        using A = jm::joint_matrix<sycl::sub_group, bf, jm::use::a, 1, 16, jm::layout::row_major>;
+        using B = jm::joint_matrix<sycl::sub_group, bf, jm::use::b, 16, 16, jm::layout::ext_intel_packed>;
+        namespace sx = sycl::ext::oneapi::experimental;
+        auto gp = [](const bf *p) { return sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(p); };
+        auto lp = [&](size_t off) { return st.template get_multi_ptr<sycl::access::decorated::no>() + off; };
+        const auto sg = it.get_sub_group();
+        const int t = (int)it.get_group(0), gi = (int)it.get_group(1);
+        const int q = (int)sg.get_group_linear_id(), ln = (int)sg.get_local_linear_id();
+        const int steps = cols / 16, nseg = (steps + xm::SEG - 1) / xm::SEG, NS = G * nseg;
+        const int u0 = q * NS / Q, u1 = (q + 1) * NS / Q; // this sub-group's piece of the work-group's segments
+        const uint8_t *We = W + (size_t)ex[t] * estride;
+        const size_t bsz = (size_t)steps * xm::TB; // bytes of one 16-row block
+        const bf *pa = reinterpret_cast<const bf *>(P) + (MODE == 1 ? (size_t)t * cols : 0);
+        // block j's steps in this piece, [a, e): from its first segment in the piece to the end of its last one
+        auto range = [&](int j, int &a, int &e) {
+            a = sycl::max(u0 - j * nseg, 0) * xm::SEG;
+            e = sycl::min(sycl::min(u1 - j * nseg, nseg) * xm::SEG, steps);
+        };
+        const int ja = u0 / nseg, je = (u1 - 1) / nseg; // the blocks the piece touches
+        int ka, ke;
+        range(ja, ka, ke);
+        const uint8_t *w = We + (size_t)blkof(gi, ja) * bsz;
+        xm::Raw r[PF];
+        xm::fetchn<PF>(w, ka, ln, r);
+        C c1, c23, tot;
+        B rb;
+        jm::joint_matrix_fill(sg, rb, bf(0.0f));
+#pragma unroll 1
+        for (int jj = ja; jj <= je; ++jj) {
+            const bool more = jj < je, head = ka == 0; // head: the piece holds block jj's first segment
+            const uint8_t *wn = more ? We + (size_t)blkof(gi, jj + 1) * bsz : w; // the next block (its steps from 0)
+            int na = 0, nz = 0; // the next block's steps in the piece, [na, nz) (na: 0)
+            if (more) range(jj + 1, na, nz);
+            jm::joint_matrix_fill(sg, tot, 0.0f);
+            for (int k0 = ka; k0 < ke; k0 += xm::SEG) {
+                const int ns = sycl::min(xm::SEG, ke - k0);
+                jm::joint_matrix_fill(sg, c1, 0.0f);
+                jm::joint_matrix_fill(sg, c23, 0.0f);
+                for (int b = 0; b < ns; b += PF) {
+                    const int kb = k0 + b;
+                    // the next pass: this block's (XFull: min(kb + PF, end - PF)); XB: after the last, the next block's first
+                    const bool cross = XB && more && kb + PF >= ke;
+                    xm::Raw n[PF];
+                    xm::fetchn<PF>(cross ? wn : w, cross ? 0 : sycl::min(kb + PF, ke - PF), ln, n);
+                    { // L1 prefetch of the pass PD steps ahead, clamped to the piece (XB: on into the next block's passes)
+                        const bool pn = XB && more && kb + PD >= ke;
+                        const int kp = pn ? sycl::min(kb + PD - ke, nz - PF) : sycl::min(kb + PD, ke - PF);
+                        const uint8_t *pp8 = (pn ? wn : w) + (size_t)kp * xm::TB + (size_t)sycl::min(ln, PF * xm::TB / 64 - 1) * 64;
+                        sx::prefetch((void *)pp8, 64, sx::properties{sx::prefetch_hint_L1});
+                    }
+#pragma unroll
+                    for (int i = 0; i < PF; ++i) {
+                        float v[16];
+                        xm::decode_vals(r[i], v);
+                        int e = 0;
+                        jm::joint_matrix_apply(sg, rb, [&](bf &x) { x = sycl::bit_cast<bf>((uint16_t)(sycl::bit_cast<uint32_t>(v[e]) >> 16)); ++e; });
+                        A x0, x1, x2;
+                        const bf *pk = pa + (size_t)(kb + i) * 16;
+                        jm::joint_matrix_load(sg, x0, gp(pk), cols);
+                        jm::joint_matrix_load(sg, x1, gp(pk + pp), cols);
+                        jm::joint_matrix_load(sg, x2, gp(pk + 2 * pp), cols);
+                        jm::joint_matrix_mad(sg, c1, x0, rb, c1);
+                        jm::joint_matrix_mad(sg, c23, x1, rb, c23);
+                        jm::joint_matrix_mad(sg, c23, x2, rb, c23);
+                    }
+#pragma unroll
+                    for (int i = 0; i < PF; ++i) r[i] = n[i];
+                }
+                jm::joint_matrix_apply(sg, c1, c23, [](float &u, float &v) { u = u + v; });
+                if (head) jm::joint_matrix_apply(sg, tot, c1, [](float &u, float &v) { u = u + v; });
+                else jm::joint_matrix_store(sg, c1, lp(((size_t)G + (size_t)jj * nseg + k0 / xm::SEG) * 16), 16, jm::layout::row_major);
+            }
+            if (head) jm::joint_matrix_store(sg, tot, lp((size_t)jj * 16), 16, jm::layout::row_major);
+            if (more) {
+                w = wn; ka = na; ke = nz;
+                if constexpr (!XB) xm::fetchn<PF>(w, 0, ln, r); // the next block's first pass, afresh
+            }
+        }
+        sycl::group_barrier(it.get_group());
+        if (q < G) { // block q: its head's total, then the stored sums of the segments after the head's, in order
+            const int u = q * nseg, qh = ((u + 1) * Q + NS - 1) / NS - 1; // the head piece: u0(qh) <= u < u1(qh)
+            const int he = sycl::min((qh + 1) * NS / Q - u, nseg);       // the segments in the head's total
+            float v = st[(size_t)q * 16 + ln];
+            for (int s = he; s < nseg; ++s) v = v + st[((size_t)G + (size_t)q * nseg + s) * 16 + ln];
+            Y[(size_t)t * ldy + (size_t)blkof(gi, q) * 16 + ln] = v;
+        }
+    }
+};
+// work-groups of XBal per expert (0 if the shape does not divide): gate|up G / 2 row pairs each, down G blocks each
+static int xbal_groups(int mode, int g, int nff, int rows) {
+    const int nb = mode == 0 ? nff / 16 : rows / 16, per = mode == 0 ? g / 2 : g;
+    return per < 1 || nb % per ? 0 : nb / per;
+}
+template <int MODE, int Q, int G, bool XB>
+static sycl::event xbal(sycl::queue &q, const uint8_t *W, size_t estride, int cols, int nff, int rows, const int32_t *ex, int nex,
+                        const uint16_t *P, size_t pp, float *Y, int ldy) {
+    using K = XBal<MODE, Q, G, XB>;
+    const int steps = cols / 16, nseg = (steps + xm::SEG - 1) / xm::SEG, ngr = xbal_groups(MODE, G, nff, rows);
+    if (!ngr || cols % 16 || steps % 4 || (steps % xm::SEG) % 4 || Q > G * nseg) throw std::runtime_error("xbal: shapes");
+    return q.submit([&](sycl::handler &h) {
+        sycl::local_accessor<float, 1> st((size_t)G * (nseg + 1) * 16, h);
+        h.parallel_for(sycl::nd_range<2>(sycl::range<2>((size_t)nex, (size_t)ngr * Q * 16), sycl::range<2>(1, (size_t)Q * 16)),
+                       K{W, estride, cols, nff, ex, P, pp, Y, ldy, st});
+    });
+}
+// one XBal work-group's pieces in steps (segments [q NS / Q, (q + 1) NS / Q) of NS = G nseg), and a host check of what
+// the kernel's fold relies on: no empty piece, and its head formula (qh, he) against the pieces (an exception if not)
+static std::vector<int> xbal_pieces(int Q, int G, int steps) {
+    const int nseg = (steps + xm::SEG - 1) / xm::SEG, NS = G * nseg;
+    std::vector<int> owner(NS, -1), len(Q, 0);
+    for (int q = 0; q < Q; ++q)
+        for (int u = q * NS / Q; u < (q + 1) * NS / Q; ++u) {
+            owner[u] = q;
+            len[q] += std::min(xm::SEG, steps - (u % nseg) * xm::SEG);
+        }
+    for (int q = 0; q < Q; ++q)
+        if (len[q] == 0) throw std::runtime_error("xbal: an empty piece");
+    for (int j = 0; j < G; ++j) {
+        const int u = j * nseg, qh = ((u + 1) * Q + NS - 1) / NS - 1, he = std::min((qh + 1) * NS / Q - u, nseg);
+        int h = 0;
+        while (h < nseg && owner[u + h] == owner[u]) ++h;
+        if (qh != owner[u] || he != h) throw std::runtime_error("xbal: the fold's head formula disagrees with the pieces");
+    }
+    return len;
+}
+// the study's arms: 0 today's kernel (XFL over today's layout: XFull's own address expressions), 1.. XBal shapes, each
+// with its own Q sub-groups per G blocks for gate|up and for down (xb_q, xb_g: as xb_arm launches them)
+constexpr int XB_NA = 5;
+static const char *const xb_names[XB_NA + 1] = {
+    "today (XFL, 1 block / sub-group)", "ctl (XBal, today's shape)", "b1728 (3 sub-groups / 2 blocks)",
+    "b1728nx (b1728, pipeline per block)", "b1536 (4 sub-groups / 3 blocks)", "b2048 (16 sub-groups / 9 blocks)"};
+static const int xb_q[XB_NA + 1][2] = {{2, 2}, {2, 2}, {3, 3}, {3, 3}, {8, 4}, {32, 16}}; // [arm][gate|up, down]
+static const int xb_g[XB_NA + 1][2] = {{2, 2}, {2, 2}, {2, 2}, {2, 2}, {6, 3}, {18, 9}};
+template <int MODE>
+static void xb_arm(sycl::queue &q, int a, const uint8_t *W, size_t eb, int cols, int nff, int rows, const int32_t *es, int nex,
+                   const uint16_t *P, size_t pp, float *Y, int ldy) {
+    constexpr bool GU = MODE == 0;
+    switch (a) {
+    case 0: xfl<L_TODAY, MODE, true>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 1: xbal<MODE, 2, 2, true>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 2: xbal<MODE, 3, 2, true>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 3: xbal<MODE, 3, 2, false>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    case 4: xbal<MODE, GU ? 8 : 4, GU ? 6 : 3, true>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    default: xbal<MODE, GU ? 32 : 16, GU ? 18 : 9, true>(q, W, eb, cols, nff, rows, es, nex, P, pp, Y, ldy); break;
+    }
+}
