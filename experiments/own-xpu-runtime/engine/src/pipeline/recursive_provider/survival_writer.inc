// Included inside the ring Dispatcher; one success record per exact suffix abort.
void write_survival(const Request& request,const ownrt::ring_next::Row& oldest,const ownrt::ring_next::Resolution& resolved,const mtp36::DraftRuntime::SurvivalSnapshot& before,const mtp36::DraftRuntime::SurvivalSnapshot& after,const std::vector<ownrt::ring_next::Row>& pending){
 namespace v=ownrt::provider_survival;require(provider&&provider_sequence&&e.a.pipeline_ring_verify_provider_survival&&survival_records<128,"bounded provider survival receipt owner");
 require(pending.size()==resolved.discarded.size()&&!pending.empty()&&pending.size()<=size_t(context.depth)&&pending.front()==oldest,"provider survival suffix identity");
 size_t compared=0;for(const auto& allocation:before.allocations)compared+=allocation.bytes;
 const auto captured=provider_at_capture.at(oldest.id);const bool advanced=before.current_host.position>captured.position&&provider_sequence->serial()>captured.serial;
 std::ostringstream out;out<<"{\"schema\":\"ownrt.provider-abort-survival.v1\",\"stage_id\":"<<context.stage<<",\"ring_request_sha256\":"<<ownrt::quote(e.a.pipeline_ring_request_sha256)<<",\"ring_epoch\":"<<context.epoch<<",\"abort_sequence\":"<<request.sequence<<",\"oldest\":"<<v::row_json(oldest)<<",\"discarded_row_ids\":[";
 for(size_t i=0;i<pending.size();++i){require(pending[i].id==resolved.discarded[i],"provider survival exact discarded ID order");out<<(i?",":"")<<pending[i].id;}out<<"],\"provider_at_capture\":[";
 for(size_t i=0;i<pending.size();++i){const auto& row=pending[i];const auto capture=provider_at_capture.at(row.id);require(capture.position<=before.current_host.position&&capture.serial<=provider_sequence->serial(),"provider canonical state predates target snapshot");out<<(i?",":"")<<"{\"row\":"<<v::row_json(row)<<",\"position\":"<<capture.position<<",\"serial\":"<<capture.serial<<"}";}
 out<<"],\"provider_advanced_since_snapshot\":"<<(advanced?"true":"false")<<",\"actual_position\":"<<resolved.physical<<",\"committed_position\":"<<resolved.committed<<",\"pending_tickets\":"<<resolved.pending<<",\"comparison_bytes\":"<<compared<<",\"canonical_allocations_checked\":"<<provider->recursive_rows.size()<<",\"private_allocations_checked\":1,\"all_bytes_equal\":true,\"host_equal\":true,\"sequence_equal\":true,\"prepared_bindings_equal\":true,\"before_payload\":"<<ownrt::quote(before.payload)<<",\"before_payload_sha256\":"<<ownrt::quote(v::sha(before.payload))<<",\"after_payload\":"<<ownrt::quote(after.payload)<<",\"after_payload_sha256\":"<<ownrt::quote(v::sha(after.payload))<<"}";
 require(out.str().size()<=128*1024,"bounded provider survival receipt bytes");survival_trace<<out.str()<<'\n';survival_trace.flush();require(bool(survival_trace),"provider survival receipt write");++survival_records;survival_rows+=pending.size();survival_advanced_records+=advanced?1:0;
}
