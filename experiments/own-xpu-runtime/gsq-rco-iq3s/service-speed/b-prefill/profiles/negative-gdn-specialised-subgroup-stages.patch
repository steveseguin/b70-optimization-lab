+// GDN stage 0 with subgroups (same values as body<gdn,0>): per token, subgroup g<16 owns key g and computes its q and
+// k norms (dot128: per-lane ((0+v0*v0)+v1*v1)+... partials, the 32-leaf adjacent tree) and writes the normalized
+// vectors, lane l owning columns 4l..4l+3; subgroups 16 and 17 give one head per lane (decay and beta).
+template<class Guard> inline void gdn_prep(ng::Shape s,ng::Args a,sycl::nd_item<1> it,float* scratch,Guard guard){
+ s.op=ng::gdn;auto sg=it.get_sub_group();const unsigned lane=sg.get_local_linear_id();const size_t index=it.get_global_linear_id()/32;
+ if(index>=size_t(s.tokens)*18||!a.i(18)[0]||guard.error(a))return;
+ int pos=a.i(17)[0];if(pos<0||pos>ng::position_limit(s)-s.tokens){if(index==0&&lane==0)guard.fail(a);return;}
+ constexpr int step=4192;const int row=int(index)/18,part=int(index)%18;float* out=scratch+row*step;
+ auto tree=[&](float x){for(unsigned width=1;width<32;width*=2){const float rhs=sycl::select_from_group(sg,x,(lane+width)%32);if(lane%(2*width)==0)x=x+rhs;}return sycl::group_broadcast(sg,x,0);};
