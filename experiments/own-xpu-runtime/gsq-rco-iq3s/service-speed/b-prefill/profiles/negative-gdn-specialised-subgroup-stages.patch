+// GDN recurrence (stage 1), one 32-lane subgroup per state row (h, j) instead of one work item: lane l owns columns
+// 4l..4l+3, so the row is read and written coalesced and 32x more threads run. Every value is body<gdn,1>'s: each
+// dot128 is the same per-lane partial ((0+p0)+p1)+p2)+p3 and the same 32-leaf adjacent-pair tree (private_tree<32>),
+// here through subgroup shuffles; the prologue checks are the same and uniform across the subgroup.
+template<class Guard> inline void gdn_rows(ng::Shape s,ng::Args a,sycl::nd_item<1> it,float* scratch,Guard guard){
+ s.op=ng::gdn;auto sg=it.get_sub_group();const unsigned lane=sg.get_local_linear_id();const size_t index=it.get_global_linear_id()/32;
