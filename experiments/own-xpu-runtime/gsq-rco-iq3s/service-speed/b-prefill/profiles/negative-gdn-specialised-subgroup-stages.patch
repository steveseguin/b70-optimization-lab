+  for(int i=0;i<4;++i){q[i]=a.b(0,qb+k0+i);k[i]=a.b(0,kb+k0+i);const float qq=q[i]*q[i];qs=qs+qq;const float kk=k[i]*k[i];ks=ks+kk;}
