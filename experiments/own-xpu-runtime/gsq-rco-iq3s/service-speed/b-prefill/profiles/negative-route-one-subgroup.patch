+     #pragma unroll
+     for(int i=0;i<per;++i){const int id=lane*per+i;if(!((taken>>i)&1u)&&(best==N||bits[i]>best_bits||(bits[i]==best_bits&&id<best))){best_bits=bits[i];best=id;}}
