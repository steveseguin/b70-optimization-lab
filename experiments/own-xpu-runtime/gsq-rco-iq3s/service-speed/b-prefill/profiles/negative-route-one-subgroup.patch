+// Route in one subgroup per token row (no work-group barriers, no 64-bit keys); every value is RouteFast's: lane l
+// owns experts 16l..16l+15, so each subtree<16> chunk sum runs in-lane with the same function, the 32-chunk total is
+// the same adjacent tree (subtree<256> over 32 partials) by shuffles, the maximum is the same value, and each of the
+// Top rounds picks the same expert (larger probability bits first, then the lower id) from a lane-local best of 16 and
+// a subgroup butterfly over that total order. Normalization is the same subtree<32> call. OWNRT_ROUTE_SG=0 keeps
+// RouteFast.
+template<int N,int Top> struct RouteSub final:ownrt::SyclOperation {
+ Spec spec;explicit RouteSub(Spec s):spec(s){}
+ sycl::event submit(sycl::queue& q,std::span<void*const> p,const std::vector<sycl::event>& deps)const override {
