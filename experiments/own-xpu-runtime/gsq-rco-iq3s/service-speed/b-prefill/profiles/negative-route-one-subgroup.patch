+  return ownrt::prepared_submit(q,[=,p35_range0=sycl::nd_range<1>(size_t(rows)*32,32)](sycl::handler& h){
+   h.parallel_for(p35_range0,packet26::checked([=](sycl::nd_item<1> it)[[sycl::reqd_sub_group_size(32)]]{
+    constexpr int per=N/32;
+    const int r=int(it.get_group_linear_id());auto sg=it.get_sub_group();const int lane=int(sg.get_local_linear_id());const RowBound rb{b,r,b.s};
+    if(!*rb.active()||rb.failed())return; // uniform across the subgroup
+    float x[per];bool finite=true;
+    #pragma unroll
+    for(int i=0;i<per;++i){x[i]=rb.in(0).get(lane*per+i);finite=finite&&std::isfinite(x[i]);}
+    if(!sycl::all_of_group(sg,finite)){if(lane==0)rb.fail();return;}
+    float m=x[0];
+    #pragma unroll
+    for(int i=1;i<per;++i)m=sycl::fmax(m,x[i]);
+    const float maximum=sycl::reduce_over_group(sg,m,sycl::maximum<float>());
+    float ex[per];
+    #pragma unroll
+    for(int i=0;i<per;++i)ex[i]=detmath::exp(x[i]-maximum);
+    float part=subtree<16>(N,lane*per,[&](int i){return ex[i-lane*per];});
+    for(int stride=1;stride<32;stride*=2){const float rhs=sycl::select_from_group(sg,part,(lane+stride)%32);if(lane%(2*stride)==0)part=part+rhs;}
+    const float den=sycl::group_broadcast(sg,part,0);
+    uint32_t bits[per];
+    #pragma unroll
+    for(int i=0;i<per;++i)bits[i]=sycl::bit_cast<uint32_t>(ex[i]/den);
