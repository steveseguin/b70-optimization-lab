+static thread_local float ggml_exact_rope_base = 0.0f;
+static thread_local int ggml_exact_rope_ndims = 0;
+static int ggml_exact_rope_mode(void) {
+    static int m = -1;
+    if (m < 0) { const char * e = getenv("GGML_CPU_EXACT_ROPE"); m = !e ? 0 : strcmp(e, "powf") == 0 ? 1 : strcmp(e, "f64") == 0 ? 2 : 0; }
+    return m;
+}
+static void ggml_exact_rope_pair(int mode, float base_pos, int64_t i0, float sin_sign, float * c) {
+    if (mode == 1) {
+        const float angle = base_pos * powf(ggml_exact_rope_base, -(float) i0 / (float) ggml_exact_rope_ndims);
+        c[0] = cosf(angle); c[1] = sinf(angle) * sin_sign;
+    } else {
+        const double angle = (double) base_pos * pow((double) ggml_exact_rope_base, -(double) i0 / (double) ggml_exact_rope_ndims);
+        c[0] = (float) cos(angle); c[1] = (float) sin(angle) * sin_sign;
+    }
+}
