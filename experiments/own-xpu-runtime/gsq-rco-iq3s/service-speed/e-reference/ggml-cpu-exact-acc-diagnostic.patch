 static double ggml_cpu_exact_dot(const float * a, const float * b, int64_t n) {
+    // Diagnostic only (GGML_CPU_EXACT_ACC=f32lane): F32 accumulation in the own engine's packed-GEMV order:
+    // 32 lane-strided float sums (k = lane, lane+32, ...), then the subgroup tree (lane += lane+width).
+    static int f32lane = -1;
+    if (f32lane < 0) { const char * e = getenv("GGML_CPU_EXACT_ACC"); f32lane = (e && strcmp(e, "f32lane") == 0) ? 1 : 0; }
+    if (f32lane) {
+        float l[32] = {0};
+        for (int64_t i = 0; i < n; ++i) { const float p = a[i] * b[i]; l[i % 32] = l[i % 32] + p; }
+        for (int w = 1; w < 32; w *= 2) for (int j = 0; j < 32; j += 2*w) l[j] = l[j] + l[j + w];
+        return (double) l[0];
+    }
     double s = 0.0;
     for (int64_t i = 0; i < n; ++i) s += (double) a[i] * (double) b[i];
     return s;
