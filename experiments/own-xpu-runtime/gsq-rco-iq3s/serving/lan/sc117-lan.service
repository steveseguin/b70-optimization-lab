# SC117 Qwen3.8 Flash-Next IQ3_S on the corrected own-runtime engine, LAN chat API.
# Installed copy: ~/.config/systemd/user/sc117-lan.service (not enabled: never starts at boot).
# Start: systemctl --user start sc117-lan   Stop: systemctl --user stop sc117-lan
[Unit]
Description=SC117 Flash-Next IQ3_S own-runtime LAN chat API (cards 23:00.0 + 47:00.0)

[Service]
Type=simple
WorkingDirectory=/home/steve/llm-optimizations/experiments/own-xpu-runtime/gsq-rco-iq3s/serving/lan
ExecStart=/usr/bin/python3 -B -u /home/steve/llm-optimizations/experiments/own-xpu-runtime/gsq-rco-iq3s/serving/lan/service.py --bind 192.168.2.44 --port 18160
# No restart policy, no SIGKILL: on stop the coordinator FINISHes both ranks and waits for drain.
Environment=SC117_ACTIVATIONS=f32
# Context (prompt + output): 32768 since 2026-10-26 (engine 1ccb7712cc7a; card-27 lab: 4096 vs 32768 bitwise on rank 1,
# 8K batched == token-by-token, 30K without fault). The F32 state oracle and the gate markers are keyed by context.
Environment=SC117_CONTEXT=32768
# Rank output directories on local RAM disk, not the ntfs-3g USB mount: FUSE stalls on per-token stream appends cost up
# to 30% decode (49.5 -> 40 tok/s under USB write load, 2026-10-25). About 6 MB per run; per-request dirs are pruned.
Environment=SC117_EVIDENCE_PARENT=/dev/shm/sc117-lan-evidence
Environment=SC117_ADAPTER=adapter6.py
Environment=SC117_ENGINE_RECEIPT=/home/steve/llm-optimizations/experiments/own-xpu-runtime/engine/receipts/d859730cbb29.json
Environment=SC117_PREFILL_ROWS=32
Environment=SC117_DISPATCH=/home/steve/llm-optimizations/experiments/own-xpu-runtime/gsq-rco-iq3s/serving/lan/dispatch-f32-select-gdn2.json
# Draft-only head prefix (first 91392 token ids; target head unchanged). Suite 2026-10-25: full 38.17 tok/s (hits 4568),
# 80128 39.13 (4489), 91392 39.42 (4527), 122880 39.22 (4556); outputs byte-identical in every case.
Environment=OWNRT_DRAFT_PREFIX_ROWS=91392
# Layer split (rank 0 holds layers 0..split-1 and the draft). It follows the stage balance: 2026-10-25 suite on
# 0f478d44: 23/25 40.60, 22/26 41.26 tok/s; after the GDN/route/argmax kernels (2145dea2): 22/26 43.46, 23/25 44.13.
# Outputs identical in every case; 21/27 exceeds the 30 GiB per-card plan cap.
Environment=SC117_TARGET_SPLIT=23
# Speculation-miss machinery from the BF16 record line, admitted for F32 state (redo-bank proof): rotate recurrent banks,
# batch the snapshot copies, capture only written KV rows. Suite 2026-10-25: control 41.56 tok/s (102 MB copied per
# speculative step, rollback 3.3-4 ms), banks-batch+static 42.26 (46 MB in one submission, rollback 2.4 ms),
# banks-batch-overlap 42.18; outputs identical, oracle zero differences, prefill gate with misses 13/13.
Environment=OWNRT_MISS=banks-batch
Environment=OWNRT_SNAPSHOT_HOST=static
# Draft-only kernels from the BF16 record line (packet59) where faster per the draft device profile (2026-10-25: draft
# span 1758 -> ~1450 us, qsa.attention 217 -> 46 us); excluded: experts (no FP8 kernel), route, qgate, hc gates (slower).
# Suite 45.51 -> 46.53 tok/s, hits 4527 -> 4533, outputs identical.
Environment=OWNRT_DRAFT_KERNELS=qsa_attention,attention_output,fuse_attention_combine,hc_a_low,hc_f_low,hc_final_low,fuse_hc_a_low,fuse_hc_f_low,fuse_hc_final_low,hc_final_gate,fuse_hc_final_mix,hc_a_inject,hc_f_inject,embedding_norm,hidden_norm,hc_a_norm,hc_f_norm,final_norm,hidden_projection,embedding_projection,fuse_hidden_merge,qsa_k,qsa_v,qsa_iq,qsa_ik,router,shared_gate,shared_up,shared_down,shared_router,fuse_shared_activation
# One expert status check per layer over the gate/up/down statuses (sets the error exactly when a separate check would):
# two fewer launches per layer. Suite 46.53 -> 46.85 tok/s, outputs identical.
Environment=OWNRT_MERGE_CHECKS=1
# Exact O(n) QSA select (scores in a register tree, radix threshold, chunked compaction; same ids as the all-pairs
# rank). Card-27 rank-1 lab 2026-10-26: 30K prefill + decode bitwise on 1,079 buffers; decode half at 30K 20.52 -> 18.35 ms.
Environment=OWNRT_SELECT_TOPK=1
# RESET zeroes the same allocations with one device store kernel each instead of 4 MiB host uploads (2026-10-26;
# card-27 session test at 32K: restored state equal to the uninterrupted run, bitwise).
Environment=OWNRT_RESET_DEVICE_ZERO=1
# Engine sessions (2026-10-26): a conversation of >= 256 tokens is parked (rank ops 17-19, both ranks + the draft's
# reverse row, sealed manifest) before a RESET would evict it, and restored when a later prompt extends it.
Environment=SC117_SESSIONS=1
Environment=SC117_SESSION_DIR=/dev/shm/sc117-sessions
Environment=SC117_SESSION_BUDGET_GB=16
Environment=SC117_SESSION_READBACK=1
# Keeper model (lab 2026-10-26, opt-in): a second model id sc117-qwen3.8-flash-next-iq3s-ownrt-keeper runs ctxkeeper's
# long-context policy in process (keeper.py): bounded view, NOTES, archive, hidden recall; a pinned head checkpoint per
# conversation is restored after each cut. Requests for the plain model id are unchanged. Needs SC117_SESSIONS=1 for
# the checkpoints. CPU tests: test_service.py (KeeperTests); device test: keeper_device_test.py.
Environment=SC117_KEEPER=1
Environment=SC117_KEEPER_DIR=/dev/shm/sc117-keeper
Environment=SC117_KEEPER_LIB=/home/steve/llm-optimizations/tools/ctxkeeper
Restart=no
KillMode=process
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=infinity
LimitAS=infinity
LimitCORE=0
Nice=19
CPUAffinity=0-3 16-19
