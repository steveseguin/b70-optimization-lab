# SC117 Qwen3.8 Flash-Next IQ3_S on the corrected own-runtime engine, LAN chat API.
# Installed copy: ~/.config/systemd/user/sc117-lan.service (not enabled: never starts at boot).
# Start: systemctl --user start sc117-lan   Stop: systemctl --user stop sc117-lan
[Unit]
Description=SC117 Flash-Next IQ3_S own-runtime LAN chat API (cards 23:00.0 + 47:00.0)

[Service]
Type=simple
WorkingDirectory=/home/steve/llm-optimizations/experiments/own-xpu-runtime/gsq-rco-iq3s/serving/lan
ExecStart=/usr/bin/python3 -B -u /home/steve/llm-optimizations/experiments/own-xpu-runtime/gsq-rco-iq3s/serving/lan/service.py --bind 192.168.2.44 --port 18160
# No restart policy, no SIGKILL: on stop the coordinator FINISHes both ranks and waits for drain.
Environment=SC117_ACTIVATIONS=f32
Environment=SC117_ADAPTER=adapter6.py
Environment=SC117_ENGINE_RECEIPT=/home/steve/llm-optimizations/experiments/own-xpu-runtime/engine/receipts/e90c54b0afcf.json
Environment=SC117_PREFILL_ROWS=16
Environment=SC117_DISPATCH=/home/steve/llm-optimizations/experiments/own-xpu-runtime/gsq-rco-iq3s/serving/lan/dispatch-f32-select-gdn2.json
# Draft-only head prefix (first 91392 token ids; target head unchanged). Suite 2026-10-25: full 38.17 tok/s (hits 4568),
# 80128 39.13 (4489), 91392 39.42 (4527), 122880 39.22 (4556); outputs byte-identical in every case.
Environment=OWNRT_DRAFT_PREFIX_ROWS=91392
# Layer split (rank 0 holds layers 0..split-1 and the draft). It follows the stage balance: 2026-10-25 suite on
# 0f478d44: 23/25 40.60, 22/26 41.26 tok/s; after the GDN/route/argmax kernels (2145dea2): 22/26 43.46, 23/25 44.13.
# Outputs identical in every case; 21/27 exceeds the 30 GiB per-card plan cap.
Environment=SC117_TARGET_SPLIT=23
# Speculation-miss machinery from the BF16 record line, admitted for F32 state (redo-bank proof): rotate recurrent banks,
# batch the snapshot copies, capture only written KV rows. Suite 2026-10-25: control 41.56 tok/s (102 MB copied per
# speculative step, rollback 3.3-4 ms), banks-batch+static 42.26 (46 MB in one submission, rollback 2.4 ms),
# banks-batch-overlap 42.18; outputs identical, oracle zero differences, prefill gate with misses 13/13.
Environment=OWNRT_MISS=banks-batch
Environment=OWNRT_SNAPSHOT_HOST=static
Restart=no
KillMode=process
KillSignal=SIGTERM
SendSIGKILL=no
TimeoutStopSec=infinity
LimitAS=infinity
LimitCORE=0
Nice=19
CPUAffinity=0-3 16-19
