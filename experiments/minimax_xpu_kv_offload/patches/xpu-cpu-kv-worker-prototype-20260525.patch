diff --git a/vllm/v1/kv_offload/cpu/xpu_worker.py b/vllm/v1/kv_offload/cpu/xpu_worker.py
new file mode 100644
index 000000000..14f661b72
--- /dev/null
+++ b/vllm/v1/kv_offload/cpu/xpu_worker.py
@@ -0,0 +1,339 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Experimental XPU CPU KV offload worker.
+
+This mirrors the CUDA CPU offload worker at a high level, but uses PyTorch XPU
+streams/events and pinned CPU tensors. It is intentionally conservative:
+contiguous logical block ranges use fast slice copies, and fragmented transfers
+fall back to per-block copies.
+"""
+
+import time
+from collections import deque
+from dataclasses import dataclass
+
+import numpy as np
+import torch
+
+from vllm.logger import init_logger
+from vllm.utils.math_utils import cdiv
+from vllm.utils.platform_utils import is_pin_memory_available
+from vllm.v1.kv_offload.base import (
+    BlockIDsLoadStoreSpec,
+    CanonicalKVCacheRef,
+    CanonicalKVCaches,
+    GPULoadStoreSpec,
+)
+from vllm.v1.kv_offload.worker.worker import (
+    OffloadingHandler,
+    TransferResult,
+    TransferSpec,
+)
+
+logger = init_logger(__name__)
+
+
+@dataclass
+class XPUTransfer:
+    job_id: int
+    stream: torch.xpu.Stream
+    start_event: torch.Event
+    end_event: torch.Event
+    num_bytes: int
+
+
+def _is_contiguous(blocks: np.ndarray) -> bool:
+    if len(blocks) <= 1:
+        return True
+    return bool(np.all(blocks[1:] == blocks[:-1] + 1))
+
+
+def _logical_cpu_view(
+    cpu_tensor: torch.Tensor,
+    gpu_page_size_bytes: int,
+    page_size_bytes: int,
+    block_size_factor: int,
+) -> torch.Tensor:
+    # CPU tensor rows are offloaded blocks. Each row contains
+    # block_size_factor GPU-sized logical pages. The logical page stride must
+    # use the padded GPU page size, while width uses the unpadded layer page.
+    logical_blocks = cpu_tensor.shape[0] * block_size_factor
+    return torch.as_strided(
+        cpu_tensor,
+        size=(logical_blocks, page_size_bytes),
+        stride=(gpu_page_size_bytes, 1),
+    )
+
+
+def _copy_range_or_loop(
+    *,
+    src_tensor: torch.Tensor,
+    dst_tensor: torch.Tensor,
+    src_blocks: np.ndarray,
+    dst_blocks: np.ndarray,
+    src_block_size_factor: int,
+    dst_block_size_factor: int,
+    page_size_bytes: int,
+) -> None:
+    src_gpu_page_size = src_tensor.shape[1]
+    dst_gpu_page_size = (
+        dst_tensor.shape[1] // dst_block_size_factor
+        if dst_tensor.device.type == "cpu"
+        else dst_tensor.shape[1]
+    )
+
+    if src_tensor.device.type == "cpu":
+        src_view = _logical_cpu_view(
+            src_tensor, src_gpu_page_size // src_block_size_factor,
+            page_size_bytes, src_block_size_factor)
+    else:
+        src_view = src_tensor[:, :page_size_bytes]
+
+    if dst_tensor.device.type == "cpu":
+        dst_view = _logical_cpu_view(
+            dst_tensor, dst_gpu_page_size, page_size_bytes,
+            dst_block_size_factor)
+    else:
+        dst_view = dst_tensor[:, :page_size_bytes]
+
+    # Fast path for the common contiguous case.
+    if _is_contiguous(src_blocks) and _is_contiguous(dst_blocks):
+        src_start = int(src_blocks[0])
+        dst_start = int(dst_blocks[0])
+        count = len(src_blocks)
+        dst_view[dst_start:dst_start + count].copy_(
+            src_view[src_start:src_start + count], non_blocking=True)
+        return
+
+    # Correctness fallback for fragmented copies.
+    for src_block, dst_block in zip(src_blocks.tolist(), dst_blocks.tolist()):
+        dst_view[int(dst_block)].copy_(
+            src_view[int(src_block)], non_blocking=True)
+
+
+class XPUSingleDirectionOffloadingHandler(OffloadingHandler):
+    def __init__(
+        self,
+        gpu_tensors: list[torch.Tensor],
+        cpu_tensors: list[torch.Tensor],
+        block_size_factor: int,
+        kv_cache_groups_data_refs: list[list[CanonicalKVCacheRef]],
+        gpu_to_cpu: bool,
+    ):
+        assert len(gpu_tensors) == len(cpu_tensors)
+        assert gpu_tensors
+
+        for gpu_tensor, cpu_tensor in zip(gpu_tensors, cpu_tensors):
+            assert gpu_tensor.dtype == torch.int8
+            assert gpu_tensor.ndim == 2
+            assert gpu_tensor.device.type == "xpu"
+            assert cpu_tensor.dtype == torch.int8
+            assert cpu_tensor.ndim == 2
+            assert cpu_tensor.device.type == "cpu"
+            assert cpu_tensor.shape[1] == gpu_tensor.shape[1] * block_size_factor
+
+        self.src_tensors = gpu_tensors if gpu_to_cpu else cpu_tensors
+        self.dst_tensors = cpu_tensors if gpu_to_cpu else gpu_tensors
+        self.gpu_tensors = gpu_tensors
+        self.gpu_to_cpu = gpu_to_cpu
+        self.kv_cache_groups_data_refs = kv_cache_groups_data_refs
+
+        self.src_block_size_factor = 1 if gpu_to_cpu else block_size_factor
+        self.dst_block_size_factor = block_size_factor if gpu_to_cpu else 1
+        self.transfer_type = ("GPU", "CPU") if gpu_to_cpu else ("CPU", "GPU")
+
+        self._transfer_events: dict[int, torch.Event] = {}
+        self._transfers: deque[XPUTransfer] = deque()
+        self._stream_pool: list[torch.xpu.Stream] = []
+        self._event_pool: list[torch.Event] = []
+
+    def transfer_async(self, job_id: int, transfer_spec: TransferSpec) -> bool:
+        src_spec, dst_spec = transfer_spec
+        assert isinstance(src_spec, BlockIDsLoadStoreSpec)
+        assert isinstance(dst_spec, BlockIDsLoadStoreSpec)
+
+        src_blocks = src_spec.block_ids
+        dst_blocks = dst_spec.block_ids
+        assert src_blocks.ndim == 1
+        assert dst_blocks.ndim == 1
+
+        gpu_spec = src_spec if self.gpu_to_cpu else dst_spec
+        assert isinstance(gpu_spec, GPULoadStoreSpec)
+        group_sizes = gpu_spec.group_sizes
+        block_indices = gpu_spec.block_indices
+        assert len(group_sizes) == len(self.kv_cache_groups_data_refs)
+        assert len(block_indices) == len(self.kv_cache_groups_data_refs)
+
+        stream = self._stream_pool.pop() if self._stream_pool else torch.xpu.Stream()
+        start_event = (
+            self._event_pool.pop()
+            if self._event_pool else torch.xpu.Event(enable_timing=True)
+        )
+        end_event = (
+            self._event_pool.pop()
+            if self._event_pool else torch.xpu.Event(enable_timing=True)
+        )
+
+        num_transfer_bytes = 0
+        src_offset = 0
+        dst_offset = 0
+
+        if self.gpu_to_cpu:
+            stream.wait_stream(torch.xpu.current_stream())
+        if self._transfers:
+            stream.wait_event(self._transfers[-1].end_event)
+
+        with torch.xpu.stream(stream):
+            start_event.record()
+            for group_size, block_idx, group_data_refs in zip(
+                group_sizes, block_indices, self.kv_cache_groups_data_refs):
+                if group_size == 0:
+                    continue
+
+                src_skip = block_idx % self.src_block_size_factor
+                dst_skip = block_idx % self.dst_block_size_factor
+                src_count = group_size + src_skip
+                dst_count = group_size + dst_skip
+
+                src_blocks_count = cdiv(src_count, self.src_block_size_factor)
+                dst_blocks_count = cdiv(dst_count, self.dst_block_size_factor)
+
+                group_src_base = src_blocks[src_offset:src_offset + src_blocks_count]
+                group_dst_base = dst_blocks[dst_offset:dst_offset + dst_blocks_count]
+
+                if self.src_block_size_factor == 1:
+                    group_src_logical = group_src_base[:group_size]
+                else:
+                    expanded = (
+                        group_src_base[:, None] * self.src_block_size_factor
+                        + np.arange(self.src_block_size_factor, dtype=np.int64)[None, :]
+                    ).ravel()
+                    group_src_logical = expanded[src_skip:src_skip + group_size]
+
+                if self.dst_block_size_factor == 1:
+                    group_dst_logical = group_dst_base[:group_size]
+                else:
+                    expanded = (
+                        group_dst_base[:, None] * self.dst_block_size_factor
+                        + np.arange(self.dst_block_size_factor, dtype=np.int64)[None, :]
+                    ).ravel()
+                    group_dst_logical = expanded[dst_skip:dst_skip + group_size]
+
+                for data_ref in group_data_refs:
+                    src_tensor = self.src_tensors[data_ref.tensor_idx]
+                    dst_tensor = self.dst_tensors[data_ref.tensor_idx]
+                    _copy_range_or_loop(
+                        src_tensor=src_tensor,
+                        dst_tensor=dst_tensor,
+                        src_blocks=group_src_logical,
+                        dst_blocks=group_dst_logical,
+                        src_block_size_factor=self.src_block_size_factor,
+                        dst_block_size_factor=self.dst_block_size_factor,
+                        page_size_bytes=data_ref.page_size_bytes,
+                    )
+                    num_transfer_bytes += group_size * data_ref.page_size_bytes
+
+                src_offset += src_blocks_count
+                dst_offset += dst_blocks_count
+
+            assert src_offset == len(src_blocks)
+            assert dst_offset == len(dst_blocks)
+            end_event.record()
+
+        self._transfer_events[job_id] = end_event
+        self._transfers.append(
+            XPUTransfer(job_id, stream, start_event, end_event, num_transfer_bytes)
+        )
+        return True
+
+    def get_finished(self) -> list[TransferResult]:
+        results: list[TransferResult] = []
+        while self._transfers and self._transfers[0].end_event.query():
+            transfer = self._transfers.popleft()
+            transfer_time = transfer.start_event.elapsed_time(
+                transfer.end_event) * 1e-3
+            results.append(
+                TransferResult(
+                    job_id=transfer.job_id,
+                    success=True,
+                    transfer_size=transfer.num_bytes,
+                    transfer_time=transfer_time,
+                    transfer_type=self.transfer_type,
+                )
+            )
+            self._stream_pool.append(transfer.stream)
+            self._event_pool.append(transfer.end_event)
+            self._event_pool.append(transfer.start_event)
+            del self._transfer_events[transfer.job_id]
+        return results
+
+    def wait(self, job_ids: set[int]):
+        for job_id in job_ids:
+            event = self._transfer_events.get(job_id)
+            if event is not None:
+                event.synchronize()
+
+    def shutdown(self) -> None:
+        while self._transfers:
+            self._transfers.popleft().end_event.synchronize()
+        self._transfer_events.clear()
+        self._stream_pool.clear()
+        self._event_pool.clear()
+        self.src_tensors.clear()
+        self.dst_tensors.clear()
+        self.gpu_tensors.clear()
+
+
+class XPUCpuOffloadingHandlers:
+    def __init__(
+        self,
+        kv_caches: CanonicalKVCaches,
+        block_size_factor: int,
+        num_cpu_blocks: int,
+    ):
+        pin_memory = is_pin_memory_available()
+        logger.info(
+            "Allocating %d XPU CPU-offload tensors...",
+            len(kv_caches.tensors),
+        )
+
+        gpu_tensors: list[torch.Tensor] = []
+        cpu_tensors: list[torch.Tensor] = []
+        for kv_cache_tensor in kv_caches.tensors:
+            gpu_page_size_bytes = kv_cache_tensor.page_size_bytes
+            gpu_tensor = kv_cache_tensor.tensor.view(torch.int8).view(
+                (-1, gpu_page_size_bytes)
+            )
+            cpu_page_size_bytes = gpu_page_size_bytes * block_size_factor
+            t0 = time.monotonic()
+            cpu_tensor = torch.zeros(
+                (num_cpu_blocks, cpu_page_size_bytes),
+                dtype=torch.int8,
+                device="cpu",
+                pin_memory=pin_memory,
+            )
+            logger.debug(
+                "XPU CPU KV tensor %d x %d (%.2f GB, pinned=%s): %.3f s",
+                num_cpu_blocks,
+                cpu_page_size_bytes,
+                num_cpu_blocks * cpu_page_size_bytes / 1e9,
+                cpu_tensor.is_pinned(),
+                time.monotonic() - t0,
+            )
+            gpu_tensors.append(gpu_tensor)
+            cpu_tensors.append(cpu_tensor)
+
+        self.gpu_to_cpu_handler = XPUSingleDirectionOffloadingHandler(
+            gpu_tensors=gpu_tensors,
+            cpu_tensors=cpu_tensors,
+            block_size_factor=block_size_factor,
+            kv_cache_groups_data_refs=kv_caches.group_data_refs,
+            gpu_to_cpu=True,
+        )
+        self.cpu_to_gpu_handler = XPUSingleDirectionOffloadingHandler(
+            gpu_tensors=gpu_tensors,
+            cpu_tensors=cpu_tensors,
+            block_size_factor=block_size_factor,
+            kv_cache_groups_data_refs=kv_caches.group_data_refs,
+            gpu_to_cpu=False,
+        )
