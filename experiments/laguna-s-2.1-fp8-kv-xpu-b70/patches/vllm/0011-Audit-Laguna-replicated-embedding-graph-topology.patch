+                        and envs.VLLM_XPU_LAGUNA_REPLICATED_EMBEDDING
+                    )
+                    else 146 if laguna_m8_breakable_graph else None
+                ),
+                expected_num_eager_breaks=(
+                    144
+                    if (
+                        laguna_m8_breakable_graph
+                        and envs.VLLM_XPU_LAGUNA_REPLICATED_EMBEDDING
+                    )
+                    else 145 if laguna_m8_breakable_graph else None
+                ),
             )
             drafter = getattr(self, "drafter", None)
