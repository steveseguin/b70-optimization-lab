+class _PersistentKStepDecode:
+    """K-unrolled fixed-address greedy decoder within one worker turn.
+
+    The canonical breakable decode graph must remain the owner of attention
+    metadata and KV writes.  Wrapping the raw model in a second graph captures
+    the dummy slot mapping and silently drops later KV writes.  Replaying the
+    already-captured canonical graph here preserves its fixed addresses while
+    still keeping all K steps inside one EngineCore/worker transaction.
+    """
+
+    def __init__(self, runner: "GPUModelRunner") -> None:
+        self.runner = runner
+        self.raw_model = runner.get_model()
+        self.model_forward = runner._model_forward
+
+    def __call__(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        intermediate_tensors: IntermediateTensors | None = None,
+        inputs_embeds: torch.Tensor | None = None,
+        **model_kwargs: Any,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        runner = self.runner
+        token_ids = runner.persistent_token_ids
+        assert token_ids is not None
+        token_ids.fill_(-1)
+        initial_context = get_forward_context()
+        hidden_states: torch.Tensor | IntermediateTensors
+
+        for step in range(runner.persistent_decode_k):
+            if step == 0:
+                hidden_states = self.model_forward(
+                    input_ids=input_ids,
+                    positions=positions,
+                    intermediate_tensors=intermediate_tensors,
+                    inputs_embeds=inputs_embeds,
