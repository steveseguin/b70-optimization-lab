+          gemm2_a_scales, w2, w2_scales, gemm2_output,
+          onednn_grouped_offsets.value(), num_moe_inputs, inter_size,
+          hidden_size, num_experts, dnnl::memory::format_tag::abc);
+    } else {
+      TORCH_CHECK(false, "unknown oneDNN sidecar execute mode: ", execute_mode);
+    }
+    execute_ok = 1;
+    execute_construct_us = exec_stats.construct_us;
+    execute_wait_us = exec_stats.execute_wait_us;
+  }
