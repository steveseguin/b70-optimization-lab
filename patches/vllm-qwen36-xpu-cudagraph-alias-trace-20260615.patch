+    def _xpu_cudagraph_prepare_static_input_args(
+        self, entry: CUDAGraphEntry, args: tuple[Any, ...]
+    ) -> tuple[Any, ...]:
+        """Copy selected XPU tensor args into graph-owned static buffers.
+
+        This is an opt-in XPU diagnostic/prototype path for PIECEWISE graph
+        boundary aliasing. It avoids the stock compile-time copy-inputs path,
+        which routes through Inductor and has hit XPU bounds asserts in this
+        workload. Only explicitly selected small tensor args are copied, so
+        weights and large static buffers stay untouched.
+        """
+        if not self._xpu_cudagraph_static_inputs_enabled():
+            return args
+        if not args:
+            return args
+
+        selected = self._xpu_cudagraph_static_input_indices()
+        copy_all = self._xpu_cudagraph_static_input_all()
+        if not selected and not copy_all:
+            return args
+
+        max_numel = _xpu_cudagraph_int_env(
+            "VLLM_XPU_CUDAGRAPH_STATIC_INPUT_MAX_NUMEL", 1048576
+        )
+
+        if entry.static_input_args is None:
+            static_args = list(args)
+            static_indices: list[int] = []
+            for index, runtime_tensor in enumerate(args):
+                if not copy_all and index not in selected:
+                    continue
+                if not isinstance(runtime_tensor, torch.Tensor):
+                    continue
+                if runtime_tensor.device.type != "xpu":
+                    continue
+                if runtime_tensor.numel() == 0:
+                    continue
+                if max_numel > 0 and runtime_tensor.numel() > max_numel:
+                    logger.warning_once(
+                        "Skipping XPU cudagraph static input arg %d for %s: "
+                        "numel=%d exceeds max=%d",
+                        index,
+                        self._xpu_cudagraph_trace_label(),
+                        runtime_tensor.numel(),
+                        max_numel,
+                    )
+                    continue
+                static_args[index] = runtime_tensor.detach().clone()
+                static_indices.append(index)
+            entry.static_input_args = tuple(static_args)
+            entry.static_input_indices = tuple(static_indices)
+            return entry.static_input_args
+
+        static_args = list(entry.static_input_args)
+        with torch.no_grad():
+            for index in entry.static_input_indices:
+                runtime_tensor = args[index]
+                static_tensor = static_args[index]
+                if (
+                    not isinstance(runtime_tensor, torch.Tensor)
+                    or not isinstance(static_tensor, torch.Tensor)
+                    or runtime_tensor.shape != static_tensor.shape
+                    or runtime_tensor.dtype != static_tensor.dtype
+                    or runtime_tensor.device != static_tensor.device
+                ):
+                    # The batch descriptor should keep replay shapes stable.
+                    # If that invariant breaks, force the caller down the
+                    # existing recapture path instead of replaying stale args.
+                    entry.cudagraph = None
+                    entry.output = None
+                    entry.input_addresses = None
+                    entry.static_input_args = None
+                    entry.static_input_indices = ()
+                    return args
+                static_tensor.copy_(runtime_tensor)
+        return tuple(static_args)
+
+    def _xpu_cudagraph_zero_selected_replay_outputs(self, output: Any) -> int:
+        if not self._xpu_cudagraph_zero_replay_outputs_enabled():
+            return 0
+        indices = self._xpu_cudagraph_zero_replay_output_indices()
+        if not indices:
+            return 0
+        if not isinstance(output, (tuple, list)):
+            return 0
+
+        zeroed = 0
+        with torch.no_grad():
+            for index in indices:
+                if index < 0 or index >= len(output):
+                    continue
+                tensor = output[index]
+                if isinstance(tensor, torch.Tensor) and tensor.numel() > 0:
+                    tensor.zero_()
+                    zeroed += 1
+        return zeroed
