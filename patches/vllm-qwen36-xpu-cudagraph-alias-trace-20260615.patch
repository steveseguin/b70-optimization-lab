+    def _xpu_cudagraph_sanitize_replay_inputs(
+        self,
+        args: tuple[Any, ...],
+        batch_descriptor: BatchDescriptor,
+        trace_context: dict[str, Any],
+    ) -> None:
+        """Zero unused metadata rows in graph replay inputs on XPU.
+
+        Padded/unused regions of positions, slot mappings, block tables, and
+        logits indices can carry stale data from prior requests. Sanitizing
+        them before replay removes one observed source of cross-request state
+        poisoning. Only int32/int64 metadata tensors are touched; floating
+        point activations and weights are left unchanged.
+        """
+        num_tokens = getattr(batch_descriptor, "num_tokens", None)
+        if num_tokens is None:
+            return
+        try:
+            num_tokens = int(num_tokens)
+        except (TypeError, ValueError):
+            return
+        if num_tokens <= 0:
+            return
+
+        sanitized = 0
+        for arg in args:
+            if not isinstance(arg, torch.Tensor):
+                continue
+            if arg.device.type != "xpu":
+                continue
+            if arg.dtype not in (torch.int32, torch.int64):
+                continue
+            if arg.numel() == 0:
+                continue
+            # Heuristic: only sanitize 1-D and 2-D metadata tensors.
+            if arg.dim() not in (1, 2):
+                continue
+            with torch.no_grad():
+                try:
+                    if arg.dim() == 1:
+                        if arg.shape[0] > num_tokens:
+                            arg[num_tokens:].zero_()
+                            sanitized += 1
+                    else:
+                        # For 2-D tensors (e.g. block tables), sanitize rows
+                        # beyond the active token count and also pad columns.
+                        if arg.shape[0] > num_tokens:
+                            arg[num_tokens:, :].zero_()
+                            sanitized += 1
+                except Exception:
+                    # Do not let a single tensor sanitation break replay.
+                    continue
+
+        if sanitized and trace_context.get("trace_file"):
+            try:
+                record = {
+                    "ts": time.time(),
+                    "pid": os.getpid(),
+                    "tp_rank": trace_context.get("rank"),
+                    "event": "sanitize_replay_inputs",
+                    "num_tokens": num_tokens,
+                    "sanitized_tensors": sanitized,
+                }
+                with open(trace_context["trace_file"], "a", encoding="utf-8") as f:
+                    f.write(json.dumps(record) + "\n")
+            except Exception:
+                pass
+
+    def _xpu_cudagraph_collect_tensors(
+        self, output: Any, path: str = "$"
