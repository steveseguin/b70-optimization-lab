+    def _xpu_cudagraph_find_aliases(
+        self,
+        current: list[dict[str, Any]],
+        previous: list[dict[str, Any]],
+        *,
+        max_aliases: int,
+    ) -> list[dict[str, Any]]:
+        aliases: list[dict[str, Any]] = []
+        for cur in current:
+            cur_storage = self._xpu_cudagraph_record_storage_range(cur)
+            cur_data = self._xpu_cudagraph_record_range(cur)
+            for prev in previous:
+                same_storage = (
+                    int(cur.get("storage_data_ptr") or 0) > 0
+                    and cur.get("storage_data_ptr") == prev.get("storage_data_ptr")
+                )
+                data_overlap = self._xpu_cudagraph_ranges_overlap(
+                    cur_data,
+                    self._xpu_cudagraph_record_range(prev),
+                )
+                storage_overlap = self._xpu_cudagraph_ranges_overlap(
+                    cur_storage,
+                    self._xpu_cudagraph_record_storage_range(prev),
+                )
+                if not (same_storage or data_overlap or storage_overlap):
+                    continue
+                aliases.append(
+                    {
+                        "current_path": cur.get("path"),
+                        "current_tensor_index": cur.get("tensor_index"),
+                        "current_shape": cur.get("shape"),
+                        "current_dtype": cur.get("dtype"),
+                        "current_data_ptr": cur.get("data_ptr"),
+                        "current_storage_data_ptr": cur.get("storage_data_ptr"),
+                        "previous_path": prev.get("path"),
+                        "previous_tensor_index": prev.get("tensor_index"),
+                        "previous_shape": prev.get("shape"),
+                        "previous_dtype": prev.get("dtype"),
+                        "previous_data_ptr": prev.get("data_ptr"),
+                        "previous_storage_data_ptr": prev.get(
+                            "storage_data_ptr"
+                        ),
+                        "previous_origin": {
+                            "event": prev.get("origin_event"),
+                            "wrapper_id": prev.get("origin_wrapper_id"),
+                            "piecewise_index": prev.get(
+                                "origin_piecewise_index"
+                            ),
+                            "label": prev.get("origin_label"),
+                            "replay_count": prev.get("origin_replay_count"),
+                        },
+                        "same_storage": same_storage,
+                        "data_overlap": data_overlap,
+                        "storage_overlap": storage_overlap,
+                    }
+                )
+                if max_aliases > 0 and len(aliases) >= max_aliases:
+                    return aliases
+        return aliases
