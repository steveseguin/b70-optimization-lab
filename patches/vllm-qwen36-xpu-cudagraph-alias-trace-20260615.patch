+    @staticmethod
+    def _xpu_cudagraph_record_range(record: dict[str, Any]) -> tuple[int, int]:
+        start = int(record.get("data_ptr") or 0)
+        nbytes = int(record.get("data_nbytes") or 0)
+        if start <= 0 or nbytes <= 0:
+            return 0, 0
+        return start, start + nbytes
+
+    @staticmethod
+    def _xpu_cudagraph_record_storage_range(
+        record: dict[str, Any],
+    ) -> tuple[int, int]:
+        start = int(record.get("storage_data_ptr") or 0)
+        nbytes = int(record.get("storage_nbytes") or 0)
+        if start <= 0 or nbytes <= 0:
+            return 0, 0
+        return start, start + nbytes
+
+    @staticmethod
+    def _xpu_cudagraph_ranges_overlap(
+        a_range: tuple[int, int],
+        b_range: tuple[int, int],
+    ) -> bool:
+        a_start, a_end = a_range
+        b_start, b_end = b_range
+        return a_start > 0 and b_start > 0 and max(a_start, b_start) < min(
+            a_end, b_end
+        )
+
+    def _xpu_cudagraph_tensor_alias_records(
+        self,
+        value: Any,
+        *,
+        max_tensors: int,
+    ) -> list[dict[str, Any]]:
+        records: list[dict[str, Any]] = []
+        for idx, (path, tensor) in enumerate(
+            self._xpu_cudagraph_collect_tensors(value)
+        ):
+            if max_tensors > 0 and idx >= max_tensors:
+                break
+            record = self._xpu_cudagraph_tensor_trace_record(
+                tensor,
+                include_digest=False,
+            )
+            record["tensor_index"] = idx
+            record["path"] = path
+            records.append(record)
+        return records
