+    def _xpu_cudagraph_output_trace_record(self, output: Any) -> Any:
+        max_tensors = _xpu_cudagraph_int_env(
+            "VLLM_XPU_CUDAGRAPH_REPLAY_TRACE_OUTPUT_MAX_TENSORS", 8
+        )
+        tensors_seen = 0
+
+        def visit(obj: Any) -> Any:
+            nonlocal tensors_seen
+            if isinstance(obj, torch.Tensor):
+                if tensors_seen >= max_tensors:
+                    return {"skipped": "max_tensors"}
+                tensors_seen += 1
+                return self._xpu_cudagraph_tensor_trace_record(
+                    obj,
+                    include_digest=True,
+                )
+            if isinstance(obj, tuple):
+                return [visit(item) for item in obj]
+            if isinstance(obj, list):
+                return [visit(item) for item in obj]
+            if isinstance(obj, dict):
+                return {str(key): visit(value) for key, value in obj.items()}
+            return str(type(obj))
+
