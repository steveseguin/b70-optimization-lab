+            with torch.no_grad():
+                t = tensor.detach()
+                stats_t = t.float() if not t.is_floating_point() else t
+                finite_mask = torch.isfinite(stats_t)
+                finite_count = int(finite_mask.sum().item())
+                digest: dict[str, Any] = {
+                    "finite": finite_count,
+                    "nan": int(torch.isnan(stats_t).sum().item()),
+                    "posinf": int((stats_t == float("inf")).sum().item()),
+                    "neginf": int((stats_t == -float("inf")).sum().item()),
+                }
