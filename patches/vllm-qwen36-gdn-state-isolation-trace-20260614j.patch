+def _xpu_gdn_json_number(value: Any) -> int | float | str | None:
+    try:
+        if value is None:
+            return None
+        if isinstance(value, bool):
+            return bool(value)
+        if isinstance(value, int):
+            return int(value)
+        if isinstance(value, float):
+            if value == float("inf"):
+                return "inf"
+            if value == float("-inf"):
+                return "-inf"
+            if value != value:
+                return "nan"
+            return value
+    except Exception:
+        return repr(value)
+    return value
+
