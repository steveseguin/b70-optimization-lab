 }
+
+torch::Tensor cutlass_grouped_gemm_w8a8_int8_interface(
+    torch::Tensor ptr_A,
+    torch::Tensor ptr_A_scales,
+    torch::Tensor ptr_B,
+    torch::Tensor ptr_B_scales,
+    const c10::optional<at::Tensor>& ptr_bias,
+    torch::Tensor ptr_D,
+    torch::Tensor rows_per_expert,
+    int64_t N,
+    int64_t K,
+    int64_t num_experts) {
+  if (vllm::xpu::force_xe_default_kernel()) {
+    TORCH_CHECK(
+        false,
+        "W8A8 INT8 grouped GEMM requires the XE2 cutlass kernel; XE default "
+        "does not implement this path.");
+  } else if (vllm::xpu::is_xe2_arch()) {
+#ifdef VLLM_XPU_ENABLE_XE2
+    return cutlass_grouped_gemm_w8a8_int8_xe2(
+        ptr_A,
+        ptr_A_scales,
+        ptr_B,
+        ptr_B_scales,
+        ptr_bias,
+        ptr_D,
+        rows_per_expert,
+        N,
+        K,
+        num_experts);
+#else
+    TORCH_CHECK(false, "XE2 cutlass kernel is not enabled in this build.");
+#endif
+  } else {
+    TORCH_CHECK(
+        false,
+        "W8A8 INT8 grouped GEMM requires an XE2 XPU architecture.");
+  }
+}
