+def _xpu_gdn_trace_enabled(
+    forward_context: Any,
+    layer_name: str,
+    attn_metadata: Any,
+) -> tuple[bool, dict[str, Any]]:
+    trace_file = os.environ.get("VLLM_XPU_GDN_TRACE_FILE", "")
+    if not trace_file:
+        return False, {}
+
+    global _XPU_GDN_TRACE_LINES
+    max_lines = _xpu_gdn_trace_int_env("VLLM_XPU_GDN_TRACE_MAX_LINES", 0)
