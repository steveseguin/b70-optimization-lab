+    global _XPU_GDN_TRACE_LINES
+    max_lines = _xpu_gdn_trace_int_env("VLLM_XPU_GDN_TRACE_MAX_LINES", 0)
+    if max_lines > 0 and _XPU_GDN_TRACE_LINES >= max_lines:
