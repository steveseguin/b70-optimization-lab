+            "tp_rank": trace_context.get("tp_rank"),
+            "layer": layer_name,
+            "req_ids": trace_context.get("req_ids", []),
+            "matched_req_ids": trace_context.get("matched_req_ids", []),
+            "forward_context_extra": trace_context.get("forward_context_extra", {}),
+            "metadata": {
+                "num_prefills": int(getattr(attn_metadata, "num_prefills", 0)),
+                "num_decodes": int(getattr(attn_metadata, "num_decodes", 0)),
+                "num_actual_tokens": int(
