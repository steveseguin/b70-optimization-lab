+// Test-only production-like fixture for reordered Q8_0 c1 MMVQ.  Keep src0 in
+// a WEIGHTS buffer, matching model inference allocation and initialization.
+struct test_mul_mat_weight_q8_c1 : public test_mul_mat {
+    test_mul_mat_weight_q8_c1(int64_t m, int64_t k)
+        : test_mul_mat(GGML_TYPE_Q8_0, GGML_TYPE_F32, m, 1, k, {1, 1}, {1, 1}) {}
+
+    using test_mul_mat::build_graph;
+    bool use_weight_context() override { return true; }
+    int64_t grad_nmax() override { return 0; }
+
+    ggml_tensor * build_graph(ggml_context * ctx, ggml_context * ctx_weights) override {
+        GGML_ASSERT(ctx_weights != nullptr);
+
+        // C^T = A * B^T: (k, m) * (k, 1) => (m, 1)
+        ggml_tensor * a = ggml_new_tensor_4d(ctx_weights, type_a, k, m, 1, 1);
+        ggml_tensor * b = ggml_new_tensor_4d(ctx,         type_b, k, 1, 1, 1);
+        ggml_set_name(a, "a_weight");
+        ggml_set_name(b, "b");
+
+        ggml_tensor * out = ggml_mul_mat(ctx, a, b);
+        ggml_set_name(out, "out");
+        return out;
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "MUL_MAT_WEIGHT_Q8_C1";
+    }
+};
