From 109eee6fc36fcd073996c4c1eac7e22aa4c711da Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Sun, 9 Aug 2026 16:15:46 -0400
Subject: [PATCH] sycl: add canonical per-vector Q8 c2 control

---
 ggml/src/ggml-sycl/ggml-sycl.cpp | 225 ++++++++++++++++++++++++++++++-
 1 file changed, 223 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-sycl/ggml-sycl.cpp b/ggml/src/ggml-sycl/ggml-sycl.cpp
index d91e41f95..7d03279a8 100644
--- a/ggml/src/ggml-sycl/ggml-sycl.cpp
+++ b/ggml/src/ggml-sycl/ggml-sycl.cpp
@@ -96,6 +96,79 @@ int g_ggml_sycl_enable_flash_attention = 1;
 int g_ggml_sycl_dev2dev_memcpy = DEV2DEV_MEMCPY_SYCL;
 int g_ggml_sycl_usm_system = 0;
 
+static int g_ggml_sycl_q8_0_c2_canonical_mmvq = 0;
+
+enum class ggml_sycl_q8_0_c2_layout {
+    NONE,
+    FLAT,
+    RECURRENT,
+};
+
+struct ggml_sycl_q8_0_c2_canonical_stats {
+    std::atomic<uint64_t> flat_dispatches{0};
+    std::atomic<uint64_t> recurrent_dispatches{0};
+    std::atomic<uint64_t> flat_multicol_suppressed{0};
+    std::atomic<uint64_t> recurrent_dmmv_suppressed{0};
+    std::atomic<uint64_t> reorder_ready_dispatches{0};
+    std::atomic<uint64_t> single_col_mmvq_calls{0};
+    std::atomic<uint64_t> violations{0};
+    std::atomic<bool> flat_first_use_logged{false};
+    std::atomic<bool> recurrent_first_use_logged{false};
+    std::atomic<bool> summary_logged{false};
+};
+
+static ggml_sycl_q8_0_c2_canonical_stats g_ggml_sycl_q8_0_c2_canonical_stats;
+
+static constexpr int ggml_sycl_parse_strict_bool(const char * value) {
+    return value == nullptr ? 0 :
+           value[0] == '0' && value[1] == '\0' ? 0 :
+           value[0] == '1' && value[1] == '\0' ? 1 : -1;
+}
+
+static_assert(ggml_sycl_parse_strict_bool(nullptr) == 0);
+static_assert(ggml_sycl_parse_strict_bool("0") == 0);
+static_assert(ggml_sycl_parse_strict_bool("1") == 1);
+static_assert(ggml_sycl_parse_strict_bool("") == -1);
+static_assert(ggml_sycl_parse_strict_bool("2") == -1);
+static_assert(ggml_sycl_parse_strict_bool("-1") == -1);
+static_assert(ggml_sycl_parse_strict_bool("1x") == -1);
+
+static constexpr bool ggml_sycl_q8_0_c2_canonical_config_valid(
+        int selector, int enable_opt, int enable_graph, int prioritize_dmmv) {
+    return selector == 0 ||
+           (selector == 1 && enable_opt == 1 && enable_graph == 0 && prioritize_dmmv == 0);
+}
+
+static_assert(ggml_sycl_q8_0_c2_canonical_config_valid(0, 0, 1, 1));
+static_assert(ggml_sycl_q8_0_c2_canonical_config_valid(1, 1, 0, 0));
+static_assert(!ggml_sycl_q8_0_c2_canonical_config_valid(1, 0, 0, 0));
+static_assert(!ggml_sycl_q8_0_c2_canonical_config_valid(1, 2, 0, 0));
+static_assert(!ggml_sycl_q8_0_c2_canonical_config_valid(1, 1, 1, 0));
+static_assert(!ggml_sycl_q8_0_c2_canonical_config_valid(1, 1, 0, 1));
+
+static int ggml_sycl_get_strict_bool_env(const char * env_name) {
+    const char * value = std::getenv(env_name);
+    const int parsed = ggml_sycl_parse_strict_bool(value);
+    if (parsed < 0) {
+        GGML_ABORT("%s must be exactly 0 or 1 (got '%s')", env_name, value);
+    }
+    return parsed;
+}
+
+static constexpr ggml_sycl_q8_0_c2_layout ggml_sycl_q8_0_c2_layout_from_dims(
+        int64_t ne1, int64_t ne2, int64_t ne3) {
+    return ne3 != 1 ? ggml_sycl_q8_0_c2_layout::NONE :
+           ne1 == 2 && ne2 == 1 ? ggml_sycl_q8_0_c2_layout::FLAT :
+           ne1 == 1 && ne2 == 2 ? ggml_sycl_q8_0_c2_layout::RECURRENT :
+                                  ggml_sycl_q8_0_c2_layout::NONE;
+}
+
+static_assert(ggml_sycl_q8_0_c2_layout_from_dims(2, 1, 1) == ggml_sycl_q8_0_c2_layout::FLAT);
+static_assert(ggml_sycl_q8_0_c2_layout_from_dims(1, 2, 1) == ggml_sycl_q8_0_c2_layout::RECURRENT);
+static_assert(ggml_sycl_q8_0_c2_layout_from_dims(1, 1, 1) == ggml_sycl_q8_0_c2_layout::NONE);
+static_assert(ggml_sycl_q8_0_c2_layout_from_dims(2, 2, 1) == ggml_sycl_q8_0_c2_layout::NONE);
+static_assert(ggml_sycl_q8_0_c2_layout_from_dims(2, 1, 2) == ggml_sycl_q8_0_c2_layout::NONE);
+
 static ggml_sycl_device_info ggml_sycl_init() {
     ggml_sycl_device_info info = {};
 
@@ -297,6 +370,14 @@ static void ggml_check_sycl() try {
         g_ggml_sycl_enable_vmm = ggml_sycl_get_env("GGML_SYCL_ENABLE_VMM", 1);
         g_ggml_sycl_enable_fusion = ggml_sycl_get_env("GGML_SYCL_ENABLE_FUSION", 1);
         g_ggml_sycl_prioritize_dmmv = ggml_sycl_get_env("GGML_SYCL_PRIORITIZE_DMMV", 0);
+        g_ggml_sycl_q8_0_c2_canonical_mmvq = ggml_sycl_get_strict_bool_env("GGML_SYCL_Q8_0_C2_CANONICAL_MMVQ");
+
+        if (!ggml_sycl_q8_0_c2_canonical_config_valid(g_ggml_sycl_q8_0_c2_canonical_mmvq,
+                                                       g_ggml_sycl_enable_optimize,
+                                                       g_ggml_sycl_enable_graph,
+                                                       g_ggml_sycl_prioritize_dmmv)) {
+            GGML_ABORT("GGML_SYCL_Q8_0_C2_CANONICAL_MMVQ=1 requires GGML_SYCL_ENABLE_OPT=1, GGML_SYCL_ENABLE_GRAPH=0, and GGML_SYCL_PRIORITIZE_DMMV=0");
+        }
 
         g_ggml_sycl_dev2dev_memcpy = ggml_sycl_get_env("GGML_SYCL_DEV2DEV_MEMCPY", DEV2DEV_MEMCPY_SYCL);
         if (g_ggml_sycl_use_level_zero_api == 0) {
@@ -391,6 +472,7 @@ static void ggml_check_sycl() try {
         GGML_LOG_INFO("  GGML_SYCL_ENABLE_FUSION: %d\n", g_ggml_sycl_enable_fusion);
 
         GGML_LOG_INFO("  GGML_SYCL_PRIORITIZE_DMMV: %d\n", g_ggml_sycl_prioritize_dmmv);
+        GGML_LOG_INFO("  GGML_SYCL_Q8_0_C2_CANONICAL_MMVQ: %d\n", g_ggml_sycl_q8_0_c2_canonical_mmvq);
 
         g_ggml_sycl_use_async_mem_op_requested = ggml_sycl_get_env("GGML_SYCL_USE_ASYNC_MEM_OP", 1);
         GGML_LOG_INFO("  GGML_SYCL_USE_ASYNC_MEM_OP: %d\n", g_ggml_sycl_use_async_mem_op_requested);
@@ -1330,6 +1412,81 @@ static bool ggml_backend_buffer_is_sycl_split(ggml_backend_buffer_t buffer) {
    return buffer->buft->iface.get_name == ggml_backend_sycl_split_buffer_type_get_name;
 }
 
+static void ggml_sycl_q8_0_c2_canonical_require(bool condition, const char * reason) {
+    if (condition) {
+        return;
+    }
+
+    g_ggml_sycl_q8_0_c2_canonical_stats.violations.fetch_add(1, std::memory_order_relaxed);
+    GGML_LOG_ERROR("SYCL_Q8_0_C2_CANONICAL_MMVQ violation: %s\n", reason);
+    GGML_ABORT("SYCL_Q8_0_C2_CANONICAL_MMVQ violation: %s", reason);
+}
+
+static ggml_sycl_q8_0_c2_layout ggml_sycl_q8_0_c2_canonical_layout(
+        const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (!g_ggml_sycl_q8_0_c2_canonical_mmvq || src0 == nullptr || src1 == nullptr || dst == nullptr ||
+        dst->op != GGML_OP_MUL_MAT || src0->type != GGML_TYPE_Q8_0 ||
+        src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return ggml_sycl_q8_0_c2_layout::NONE;
+    }
+
+    const ggml_sycl_q8_0_c2_layout layout =
+        ggml_sycl_q8_0_c2_layout_from_dims(src1->ne[1], src1->ne[2], src1->ne[3]);
+    if (layout == ggml_sycl_q8_0_c2_layout::NONE) {
+        return layout;
+    }
+
+    ggml_sycl_q8_0_c2_canonical_require(dst->src[0] == src0 && dst->src[1] == src1,
+                                        "selected dst source pointers do not match dispatcher inputs");
+    ggml_sycl_q8_0_c2_canonical_require(src0->ne[2] == 1 && src0->ne[3] == 1,
+                                        "selected src0 is not a two-dimensional weight tensor");
+    ggml_sycl_q8_0_c2_canonical_require(src1->ne[0] == src0->ne[0] && dst->ne[0] == src0->ne[1],
+                                        "selected matrix widths do not match");
+    ggml_sycl_q8_0_c2_canonical_require(dst->ne[1] == src1->ne[1] && dst->ne[2] == src1->ne[2] &&
+                                        dst->ne[3] == src1->ne[3], "selected dst batch dimensions do not match src1");
+    ggml_sycl_q8_0_c2_canonical_require(src0->ne[0] % QK8_1 == 0, "selected matrix width is not Q8_1-aligned");
+    ggml_sycl_q8_0_c2_canonical_require(ggml_is_contiguous(src0), "selected src0 is not contiguous");
+    ggml_sycl_q8_0_c2_canonical_require(ggml_is_contiguous(src1), "selected src1 is not contiguous");
+    ggml_sycl_q8_0_c2_canonical_require(ggml_is_contiguous(dst), "selected dst is not contiguous");
+    ggml_sycl_q8_0_c2_canonical_require(src0->buffer != nullptr, "selected src0 has no buffer");
+    ggml_sycl_q8_0_c2_canonical_require(src1->buffer != nullptr, "selected src1 has no buffer");
+    ggml_sycl_q8_0_c2_canonical_require(dst->buffer != nullptr, "selected dst has no buffer");
+    ggml_sycl_q8_0_c2_canonical_require(!ggml_backend_buffer_is_sycl_split(src0->buffer), "selected src0 uses a split buffer");
+    ggml_sycl_q8_0_c2_canonical_require(!ggml_backend_buffer_is_sycl_split(src1->buffer), "selected src1 uses a split buffer");
+    ggml_sycl_q8_0_c2_canonical_require(!ggml_backend_buffer_is_sycl_split(dst->buffer), "selected dst uses a split buffer");
+    return layout;
+}
+
+static void ggml_sycl_q8_0_c2_canonical_record_dispatch(ggml_sycl_q8_0_c2_layout layout) {
+    if (layout == ggml_sycl_q8_0_c2_layout::FLAT) {
+        g_ggml_sycl_q8_0_c2_canonical_stats.flat_dispatches.fetch_add(1, std::memory_order_relaxed);
+        g_ggml_sycl_q8_0_c2_canonical_stats.flat_multicol_suppressed.fetch_add(1, std::memory_order_relaxed);
+    } else {
+        GGML_ASSERT(layout == ggml_sycl_q8_0_c2_layout::RECURRENT);
+        g_ggml_sycl_q8_0_c2_canonical_stats.recurrent_dispatches.fetch_add(1, std::memory_order_relaxed);
+        g_ggml_sycl_q8_0_c2_canonical_stats.recurrent_dmmv_suppressed.fetch_add(1, std::memory_order_relaxed);
+    }
+}
+
+static void ggml_sycl_q8_0_c2_canonical_log_first_hit(
+        ggml_sycl_q8_0_c2_layout layout, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    std::atomic<bool> & logged = layout == ggml_sycl_q8_0_c2_layout::FLAT ?
+        g_ggml_sycl_q8_0_c2_canonical_stats.flat_first_use_logged :
+        g_ggml_sycl_q8_0_c2_canonical_stats.recurrent_first_use_logged;
+    bool expected = false;
+    if (!logged.compare_exchange_strong(expected, true, std::memory_order_relaxed)) {
+        return;
+    }
+
+    const char * layout_name = layout == ggml_sycl_q8_0_c2_layout::FLAT ? "flat" : "recurrent";
+    const char * tensor_name = src0->name[0] == '\0' ? "(unnamed)" : src0->name;
+    GGML_LOG_INFO("SYCL_Q8_0_C2_CANONICAL_MMVQ first-hit: layout=%s path=reordered_single_col_mmvq reorder_ready=1 calls_per_dispatch=2 src0=%s src0_ne=[%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "] src1_ne=[%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "] dst_ne=[%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "]\n",
+                  layout_name, tensor_name,
+                  src0->ne[0], src0->ne[1], src0->ne[2], src0->ne[3],
+                  src1->ne[0], src1->ne[1], src1->ne[2], src1->ne[3],
+                  dst->ne[0], dst->ne[1], dst->ne[2], dst->ne[3]);
+}
+
 static ggml_backend_buffer_t ggml_backend_sycl_split_buffer_type_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
     // since we don't know the exact split after rounding, we cannot allocate the device buffers at this point
     // instead, we allocate them for each tensor separately in init_tensor
@@ -3033,6 +3190,9 @@ static void ggml_sycl_op_mul_mat(ggml_backend_sycl_context & ctx, const ggml_ten
     GGML_ASSERT(!(split && ne03 > 1));
     GGML_ASSERT(!(split && ne02 < ne12));
 
+    const ggml_sycl_q8_0_c2_layout canonical_layout =
+        ggml_sycl_q8_0_c2_canonical_layout(src0, src1, dst);
+
     std::array<float, GGML_SYCL_MAX_DEVICES> tensor_split;
     if (split) {
         // TODO: check that src0->buffer->buft is a split buffer type, replace GGML_BACKEND_TYPE_GPU_SPLIT check
@@ -3059,6 +3219,7 @@ static void ggml_sycl_op_mul_mat(ggml_backend_sycl_context & ctx, const ggml_ten
     dev_data dev[GGML_SYCL_MAX_DEVICES];
 
     int used_devices = 0;
+    uint64_t canonical_single_col_calls = 0;
     queue_ptr main_stream = ctx.stream();
 
     for (int i = 0; i < ggml_sycl_info().device_count; ++i) {
@@ -3089,6 +3250,16 @@ static void ggml_sycl_op_mul_mat(ggml_backend_sycl_context & ctx, const ggml_ten
 
     constexpr bool quantize_enabled = !std::is_same_v<quantize_f<QK8_1 / WARP_SIZE>,
                                                       no_quantize_q8_1<QK8_1 / WARP_SIZE>>;
+    constexpr bool canonical_reorder_quantizer =
+        std::is_same_v<quantize_f<QK8_1 / WARP_SIZE>, quantize_and_reorder_q8_1_soa<QK8_1 / WARP_SIZE>>;
+    if (canonical_layout != ggml_sycl_q8_0_c2_layout::NONE) {
+        ggml_sycl_q8_0_c2_canonical_require(!split, "selected wrapper received split src0");
+        ggml_sycl_q8_0_c2_canonical_require(canonical_reorder_quantizer, "selected wrapper did not receive reordered Q8_1 quantizer");
+        ggml_sycl_q8_0_c2_canonical_require(op == ggml_sycl_op_mul_mat_vec_q, "selected wrapper did not receive MMVQ op");
+        ggml_tensor_extra_gpu * extra = static_cast<ggml_tensor_extra_gpu *>(src0->extra);
+        ggml_sycl_q8_0_c2_canonical_require(extra != nullptr && extra->optimized_feature.reorder,
+                                            "selected wrapper received non-reordered src0");
+    }
     for (int i = 0; i < ggml_sycl_info().device_count; ++i) {
         if ((!split && i != ctx.device) || dev[i].row_low == dev[i].row_high) {
             continue;
@@ -3147,7 +3318,8 @@ static void ggml_sycl_op_mul_mat(ggml_backend_sycl_context & ctx, const ggml_ten
                 ctx.stream()->ext_oneapi_submit_barrier()));
     }
 
-    const int64_t src1_col_stride = split && used_devices > 1 ? MUL_MAT_SRC1_COL_STRIDE : ne11;
+    const int64_t src1_col_stride = canonical_layout == ggml_sycl_q8_0_c2_layout::FLAT ? 1 :
+                                    split && used_devices > 1 ? MUL_MAT_SRC1_COL_STRIDE : ne11;
     for (int64_t src1_col_0 = 0; src1_col_0 < ne11; src1_col_0 += src1_col_stride) {
         const int64_t is = split ? (src1_col_0/src1_col_stride) % GGML_SYCL_MAX_STREAMS : 0;
         const int64_t src1_ncols = src1_col_0 + src1_col_stride > ne11 ? ne11 - src1_col_0 : src1_col_stride;
@@ -3235,6 +3407,11 @@ static void ggml_sycl_op_mul_mat(ggml_backend_sycl_context & ctx, const ggml_ten
                     src1_padded_col_size = (i0 * ne11 + src1_col_0) * ne10;
                 }
                 // do the computation
+                if (canonical_layout != ggml_sycl_q8_0_c2_layout::NONE) {
+                    ggml_sycl_q8_0_c2_canonical_require(src1_ncols == 1, "selected wrapper attempted a multi-column MMVQ call");
+                    canonical_single_col_calls++;
+                    g_ggml_sycl_q8_0_c2_canonical_stats.single_col_mmvq_calls.fetch_add(1, std::memory_order_relaxed);
+                }
                 SYCL_CHECK(CHECK_TRY_ERROR(op(ctx, src0, src1, dst, src0_dd_i, src1_ddf_i, src1_ddq_i, dst_dd_i,
                     dev[i].row_low, dev[i].row_high, src1_ncols, src1_padded_col_size, stream)));
 
@@ -3292,6 +3469,11 @@ static void ggml_sycl_op_mul_mat(ggml_backend_sycl_context & ctx, const ggml_ten
             }
         }
     }
+
+    if (canonical_layout != ggml_sycl_q8_0_c2_layout::NONE) {
+        ggml_sycl_q8_0_c2_canonical_require(canonical_single_col_calls == 2,
+                                            "selected wrapper did not issue exactly two single-column MMVQ calls");
+    }
 }
 catch (sycl::exception const &exc) {
   std::cerr << exc.what() << "Exception caught at file:" << __FILE__
@@ -4327,12 +4509,14 @@ static bool reorder_qw(const ggml_tensor * src0, dpct::queue_ptr stream) {
 }
 
 static bool should_reorder_tensor(ggml_backend_sycl_context& ctx, const ggml_tensor * dst) {
+    const bool canonical_q8_0_c2 = ggml_sycl_q8_0_c2_canonical_layout(dst->src[0], dst->src[1], dst) !=
+                                   ggml_sycl_q8_0_c2_layout::NONE;
     return g_ggml_sycl_enable_optimize && //allow optimize, controlled by $GGML_SYCL_ENABLE_OPT
            ctx.opt_feature.reorder &&      //allow this device due to good perf, skip the devices with bad perf.
            dst->op == GGML_OP_MUL_MAT &&   //limit to some supported cases of Q4_0, to do for more cases.
            // ne[1] <= 8 so multi-column decode (spec / MTP verify) also bootstraps the reorder;
            // all reorderable types have a _switch_ncols kernel.
-           dst->src[1]->ne[1] <= 8 && dst->src[1]->ne[2]==1 && dst->src[1]->ne[3]==1;
+           ((dst->src[1]->ne[1] <= 8 && dst->src[1]->ne[2] == 1 && dst->src[1]->ne[3] == 1) || canonical_q8_0_c2);
 }
 
 static void opt_for_reorder(ggml_backend_sycl_context * ctx, const ggml_tensor * src0, const ggml_tensor * /* src1 */,
@@ -4404,6 +4588,8 @@ static bool can_use_mul_mat_vec_q(const ggml_tensor * src0, const ggml_tensor *
 
 static void ggml_sycl_mul_mat(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
     scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
+    const ggml_sycl_q8_0_c2_layout canonical_layout =
+        ggml_sycl_q8_0_c2_canonical_layout(src0, src1, dst);
     const bool split = ggml_backend_buffer_is_sycl_split(src0->buffer);
     int64_t min_compute_capability = INT_MAX;
 
@@ -4441,6 +4627,29 @@ static void ggml_sycl_mul_mat(ggml_backend_sycl_context & ctx, const ggml_tensor
     use_mul_mat_q = use_mul_mat_q && (src1->ne[1] <= MMQ_MAX_BATCH_SIZE);
 #endif // SYCL_USE_XMX
 
+    if (canonical_layout != ggml_sycl_q8_0_c2_layout::NONE) {
+        ggml_sycl_q8_0_c2_canonical_require(!split, "selected dispatcher received split src0");
+        ggml_sycl_q8_0_c2_canonical_require(ctx.opt_feature.reorder, "selected device does not support reorder optimization");
+        ggml_sycl_q8_0_c2_canonical_require(can_use_mul_mat_vec_q(src0, src1, dst), "selected tensors are not eligible for MMVQ");
+        ggml_sycl_q8_0_c2_canonical_require(ggml_sycl_supports_reorder_mmvq(src0->type), "selected Q8_0 type does not support reordered MMVQ");
+        if (canonical_layout == ggml_sycl_q8_0_c2_layout::RECURRENT) {
+            ggml_sycl_q8_0_c2_canonical_require(use_dequantize_mul_mat_vec, "selected recurrent tensors are not eligible for DMMV suppression");
+        }
+
+        use_dequantize_mul_mat_vec = false;
+        use_mul_mat_vec_q = true;
+        opt_for_reorder(&ctx, src0, src1, dst, mul_mat_algo::MMVQ);
+        ggml_tensor_extra_gpu * extra = static_cast<ggml_tensor_extra_gpu *>(src0->extra);
+        ggml_sycl_q8_0_c2_canonical_require(extra != nullptr, "selected src0 has no tensor extra");
+        ggml_sycl_q8_0_c2_canonical_require(extra->optimized_feature.reorder, "selected src0 reorder did not become ready");
+
+        ggml_sycl_q8_0_c2_canonical_record_dispatch(canonical_layout);
+        g_ggml_sycl_q8_0_c2_canonical_stats.reorder_ready_dispatches.fetch_add(1, std::memory_order_relaxed);
+        ggml_sycl_op_mul_mat<quantize_and_reorder_q8_1_soa>(ctx, src0, src1, dst, ggml_sycl_op_mul_mat_vec_q);
+        ggml_sycl_q8_0_c2_canonical_log_first_hit(canonical_layout, src0, src1, dst);
+        return;
+    }
+
     // Dispatch becomes obscure with the reorder, MMVQ when the reorder optimization
     // is enabled takes precedence over DMMV, the current if-else implementation
     // requires disabling DMMV if both conditions are met
@@ -5292,6 +5501,18 @@ static const char * ggml_backend_sycl_get_name(ggml_backend_t backend) {
