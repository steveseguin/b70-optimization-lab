+def _engine_histogram(values: list[int]) -> dict[str, int]:
+    histogram: dict[str, int] = {}
+    for value in values:
+        key = str(int(value))
+        histogram[key] = histogram.get(key, 0) + 1
+    return histogram
+
+
+def _engine_scheduler_metadata(
+    scheduler_output: SchedulerOutput, prefix: str = ""
+) -> dict[str, object]:
+    scheduled_counts = [
+        int(value) for value in scheduler_output.num_scheduled_tokens.values()
+    ]
+    spec_lengths = [
+        len(tokens) for tokens in scheduler_output.scheduled_spec_decode_tokens.values()
+    ]
+    total_spec_tokens = sum(spec_lengths)
+    num_reqs = len(scheduler_output.num_scheduled_tokens)
+    decode_req_count = sum(1 for value in scheduled_counts if value == 1)
+    prefill_req_count = num_reqs - decode_req_count
+    is_pure_decode = num_reqs > 0 and prefill_req_count == 0
+    data: dict[str, object] = {
+        "num_reqs": num_reqs,
+        "scheduled_new_reqs": len(scheduler_output.scheduled_new_reqs),
+        "scheduled_cached_reqs": scheduler_output.scheduled_cached_reqs.num_reqs,
+        "total_num_scheduled_tokens": int(
+            scheduler_output.total_num_scheduled_tokens
+        ),
+        "max_num_scheduled_tokens": max(scheduled_counts)
+        if scheduled_counts
+        else 0,
+        "scheduled_token_histogram": _engine_histogram(scheduled_counts),
+        "decode_req_count": decode_req_count,
+        "prefill_req_count": prefill_req_count,
+        "is_pure_decode": is_pure_decode,
+        "decode_bucket": max(scheduled_counts) if is_pure_decode else None,
+        "scheduled_spec_req_count": len(
+            scheduler_output.scheduled_spec_decode_tokens
+        ),
+        "scheduled_spec_token_total": total_spec_tokens,
+        "scheduled_spec_histogram": _engine_histogram(spec_lengths),
+        "finished_req_count": len(scheduler_output.finished_req_ids),
+        "pending_structured_output_tokens": bool(
+            scheduler_output.pending_structured_output_tokens
+        ),
+        "has_structured_output_requests": bool(
+            scheduler_output.has_structured_output_requests
+        ),
+    }
+    if scheduler_output.preempted_req_ids is not None:
+        data["preempted_req_count"] = len(scheduler_output.preempted_req_ids)
+    if prefix:
+        return {f"{prefix}_{key}": value for key, value in data.items()}
+    return data
+
