+class _EngineStepTimer:
+    def __init__(self, label: str, metadata: dict[str, object] | None = None):
+        global _ENGINE_STEP_SEEN
+        self.enabled = _ENGINE_STEP_TIMING
+        self.label = label
+        self.metadata = metadata or {}
+        self.regions: list[dict[str, object]] = []
+        self.step = 0
+        self.start_ns = 0
+        self.emit = False
+        if not self.enabled:
+            return
+        _ENGINE_STEP_SEEN += 1
+        self.step = _ENGINE_STEP_SEEN
+        self.emit = (
+            self.step > _ENGINE_STEP_SKIP_FIRST
+            and (self.step - _ENGINE_STEP_SKIP_FIRST) % _ENGINE_STEP_PRINT_EVERY == 0
+        )
+        if self.emit:
+            self.start_ns = time.perf_counter_ns()
+
+    def add_metadata(self, values: dict[str, object]) -> None:
+        if self.emit:
+            self.metadata.update(values)
+
+    @contextmanager
+    def region(self, label: str):
+        if not self.emit:
+            yield
+            return
+        start_ns = time.perf_counter_ns()
+        try:
+            yield
+        finally:
+            elapsed_ns = time.perf_counter_ns() - start_ns
+            self.regions.append(
+                {
+                    "label": label,
+                    "elapsed_ms": elapsed_ns / 1e6,
+                    "start_offset_ms": (start_ns - self.start_ns) / 1e6,
+                }
+            )
+
+    def finish(self, status: str = "ok") -> None:
+        if not self.emit:
+            return
+        total_ms = (time.perf_counter_ns() - self.start_ns) / 1e6
+        accounted_ms = sum(float(row["elapsed_ms"]) for row in self.regions)
+        payload = {
+            "step": self.step,
+            "label": self.label,
+            "status": status,
+            "total_ms": total_ms,
+            "accounted_region_ms": accounted_ms,
+            "unaccounted_ms": total_ms - accounted_ms,
+            "metadata": self.metadata,
+            "regions": self.regions,
+            "regions_by_elapsed_ms": sorted(
+                self.regions,
+                key=lambda row: float(row["elapsed_ms"]),
+                reverse=True,
+            ),
+        }
+        print(
+            "[vllm-xpu-engine-step] "
+            + json.dumps(payload, sort_keys=True, separators=(",", ":")),
+            flush=True,
+        )
+
 
