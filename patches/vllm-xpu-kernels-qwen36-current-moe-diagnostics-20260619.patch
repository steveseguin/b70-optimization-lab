+void qwen36_single_token_gather_topk8_out(
+    torch::Tensor& output,
+    const torch::Tensor& gemm2_output,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    int64_t hidden_size) {
+  if (output.scalar_type() == torch::kBFloat16) {
+    qwen36_single_token_gather_topk8_out_impl(
+        reinterpret_cast<sycl::ext::oneapi::bfloat16*>(output.data_ptr()),
+        reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(
+            gemm2_output.data_ptr()),
