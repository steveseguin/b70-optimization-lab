+at::Tensor cutlass_grouped_gemm_w8a8_int8_xe2_topk8_gather_impl(
+    at::Tensor& ptr_A,
+    at::Tensor& ptr_A_scales,
+    at::Tensor& ptr_B,
+    at::Tensor& ptr_B_scales,
+    const c10::optional<at::Tensor>& ptr_bias,
+    at::Tensor& ptr_D,
+    at::Tensor& topk_ids,
+    at::Tensor& topk_weights,
+    at::Tensor& unpermuted_row_to_permuted_row,
+    int64_t N,
+    int64_t K,
+    int64_t num_experts) {
+  auto& dpcpp_queue =
+      at::xpu::getCurrentXPUStream(ptr_A.device().index()).queue();
+  auto A_dtype = ptr_A.dtype();
+  auto B_dtype = ptr_B.dtype();
+  auto D_dtype = ptr_D.dtype();
+
+  TORCH_CHECK(N % 32 == 0, "N must be divisible by 32");
+  TORCH_CHECK(A_dtype == at::kChar, "ptr_A must be int8");
+  TORCH_CHECK(B_dtype == at::kChar, "ptr_B must be int8");
+  TORCH_CHECK(
+      D_dtype == at::kBFloat16 || D_dtype == at::kHalf,
+      "ptr_D must be bfloat16 or float16");
+  TORCH_CHECK(ptr_A_scales.dtype() == at::kFloat, "ptr_A_scales must be float");
+  TORCH_CHECK(ptr_B_scales.dtype() == at::kFloat, "ptr_B_scales must be float");
+  TORCH_CHECK(topk_ids.dtype() == at::kLong, "topk_ids must be int64");
+  TORCH_CHECK(topk_weights.dtype() == at::kFloat, "topk_weights must be float");
+  TORCH_CHECK(
+      unpermuted_row_to_permuted_row.dtype() == at::kInt,
+      "unpermuted_row_to_permuted_row must be int32");
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(ptr_bias->dtype() == at::kFloat, "ptr_bias must be float");
+  }
+
+  TORCH_CHECK(ptr_A.dim() == 2, "ptr_A must be 2D [Total_M, K]");
+  TORCH_CHECK(ptr_A.size(0) >= 8, "ptr_A must contain at least topk rows");
+  TORCH_CHECK(ptr_A.size(1) == K, "ptr_A.size(1) must match K");
+  TORCH_CHECK(ptr_B.dim() == 3, "ptr_B must be 3D [num_experts, K, N]");
+  TORCH_CHECK(ptr_D.dim() == 2, "ptr_D must be 2D [1, N]");
+  TORCH_CHECK(ptr_D.size(0) == 1, "ptr_D first dim must be one token");
+  TORCH_CHECK(ptr_D.size(1) == N, "ptr_D.size(1) must match N");
+  TORCH_CHECK(
+      ptr_A_scales.dim() == 1 ||
+          (ptr_A_scales.dim() == 2 && ptr_A_scales.size(1) == 1),
