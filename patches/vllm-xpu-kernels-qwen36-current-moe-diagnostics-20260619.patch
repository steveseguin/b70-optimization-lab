+          output.scalar_type() == torch::kFloat16) &&
+         gemm2_a.dim() == 2 && gemm2_a.size(0) >= 8 &&
+         gemm2_a.size(1) == inter_size &&
+         gemm2_a.scalar_type() == torch::kInt8 &&
+         gemm2_a_scales.numel() >= 8 &&
+         gemm2_a_scales.scalar_type() == torch::kFloat32 &&
+         w2.dim() == 3 && w2.size(0) == num_experts &&
+         w2.size(1) == inter_size && w2.size(2) == hidden_size &&
+         w2.scalar_type() == torch::kInt8 &&
+         w2_scales.dim() == 2 && w2_scales.size(0) == num_experts &&
+         w2_scales.size(1) == hidden_size &&
+         w2_scales.scalar_type() == torch::kFloat32 && bias_ok &&
+         topk_ids.dim() == 2 && topk_ids.size(0) == 1 &&
+         topk_ids.size(1) == 8 &&
+         topk_ids.scalar_type() == torch::kInt64 &&
+         topk_weights.dim() == 2 && topk_weights.size(0) == 1 &&
+         topk_weights.size(1) == 8 &&
+         topk_weights.scalar_type() == torch::kFloat32 &&
+         unpermuted_row_to_permuted_row.dim() == 1 &&
+         unpermuted_row_to_permuted_row.numel() >= 8 &&
+         unpermuted_row_to_permuted_row.scalar_type() == torch::kInt32;
+}
