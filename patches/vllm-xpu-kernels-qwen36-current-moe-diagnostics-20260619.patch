+    W8A8TopK8GatherDispatch(policy);
+  } else if (ntile_env != nullptr && std::string(ntile_env) == "32") {
+    using policy = w8a8_topk8_policy_n_32;
+    W8A8TopK8GatherDispatch(policy);
+  } else {
+    using policy = w8a16_policy_m_8;
+    W8A8TopK8GatherDispatch(policy);
+  }
+
+#undef W8A8TopK8GatherDispatch
+#undef W8A8TopK8GatherLauncherCallER
+
+  return ptr_D;
+}
