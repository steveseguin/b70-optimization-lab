diff --git a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
index dbeb772..cd5ae2c 100644
--- a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
+++ b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
@@ -58,6 +58,328 @@ CUTE_DEVICE auto make_moe_tensor(T* ptr, int r, int c) {
         make_gmem_ptr(ptr), make_layout(shape, make_stride(c, _1{})));
 }
 
+template <
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyD,
+    class TiledMMA,
+    typename ElementD>
+CUTE_DEVICE void xe_gemm_w8a8_topk8_gather(
+    const int8_t* Activations,
+    const int8_t* Weights,
+    const float* Scales,
+    const float* ActivationScales,
+    const float* Bias,
+    ElementD* Outputs,
+    const int64_t* TopkIds,
+    const float* TopkWeights,
+    const int* UnpermutedRowToPermutedRow,
+    const int32_t gemm_n,
+    const int32_t gemm_k,
+    TiledMMA const& mma) {
+  auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+  const int wg_n = item.get_group(1);
+  const int local_id = item.get_local_linear_id();
+
+  auto C_tensor = make_moe_tensor<ElementD, 'R'>(Outputs, 1, gemm_n);
+  Tensor cC = make_identity_tensor(C_tensor.shape());
+  auto wg_tile = mma.tile_mnk();
+  auto wg_coord = make_coord(0, wg_n, 0);
+  Tensor gC =
+      local_tile(cC, wg_tile, wg_coord, Step<_1, _1, X>{});  // (1,BLK_N)
+
+  auto copy_c = get_block_2d_copy_D<GmemTiledCopyD>(mma, C_tensor);
+  auto thr_mma = mma.get_slice(local_id);
+  auto thr_copy_c = copy_c.get_slice(local_id);
+  auto tCrC_template = thr_mma.partition_sg_fragment_C(gC);
+  auto tCrAccum = make_subgroup_tensor(
+      make_tensor_like<float>(tCrC_template.tensor()),
+      tCrC_template.tv_layout());
+  auto tCrC_out = thr_copy_c.partition_sg_fragment_S(gC);
+  auto tCgC = thr_copy_c.partition_D(gC);
+  clear(tCrAccum);
+
+  static constexpr auto ATOM_M =
+      get<1>(typename TiledMMA::ThrLayoutVMNK{}.shape());
+  static constexpr auto ATOM_N =
+      get<2>(typename TiledMMA::ThrLayoutVMNK{}.shape());
+
+  auto sg_local_m_coord = cutlass::get_sub_group_id() / ATOM_N;
+  auto sg_local_n_coord = cutlass::get_sub_group_id() % ATOM_N;
+
+  static constexpr auto tile_m = get<0>(wg_tile);
+  static constexpr auto tile_n = get<1>(wg_tile);
+  static constexpr auto SG_M = tile_m / ATOM_M;
+  static constexpr auto SG_N = tile_n / ATOM_N;
+  const int sg_local_id = cutlass::get_sub_group_local_id();
+  static constexpr int sg_local_range = 16;
+
+  const int m_sg_start = sg_local_m_coord * SG_M;
+  const int n_tile_start = wg_n * tile_n;
+  const int n_sg_start = sg_local_n_coord * SG_N;
+
+  CUTE_UNROLL
+  for (int topk_idx = 0; topk_idx < 8; ++topk_idx) {
+    const int permuted_row = UnpermutedRowToPermutedRow[topk_idx];
+    const int64_t expert = TopkIds[topk_idx];
+    const float route_weight = TopkWeights[topk_idx];
+
+    auto A_tensor = make_moe_tensor<int8_t, 'R'>(
+        const_cast<int8_t*>(Activations) + permuted_row * gemm_k,
+        1,
+        gemm_k);
+    auto B_tensor = make_moe_tensor<int8_t, 'R'>(
+        const_cast<int8_t*>(Weights) +
+            expert * static_cast<int64_t>(gemm_n) *
+                static_cast<int64_t>(gemm_k),
+        gemm_n,
+        gemm_k);
+
+    Tensor cA = make_identity_tensor(A_tensor.shape());
+    Tensor cB = make_identity_tensor(B_tensor.shape());
+    Tensor gA = local_tile(
+        cA, select<0, 2>(wg_tile), make_coord(0, _));  // (BLK_M,BLK_K,k)
+    Tensor gB = local_tile(
+        cB, select<1, 2>(wg_tile), make_coord(wg_n, _));  // (BLK_N,BLK_K,k)
+
+    auto copy_a = get_block_2d_copy_A<GmemTiledCopyA>(mma, A_tensor);
+    auto copy_b = get_block_2d_copy_B<GmemTiledCopyB>(mma, B_tensor);
+    auto thr_copy_a = copy_a.get_slice(local_id);
+    auto thr_copy_b = copy_b.get_slice(local_id);
+
+    auto tCrA = thr_mma.partition_sg_fragment_A(gA(_, _, 0));
+    auto tCrB = thr_mma.partition_sg_fragment_B(gB(_, _, 0));
+    auto tArA = thr_copy_a.partition_sg_fragment_D(gA(_, _, 0));
+    auto tBrB = thr_copy_b.partition_sg_fragment_D(gB(_, _, 0));
+    Tensor tAgA = thr_copy_a.partition_S(gA);
+    Tensor tBgB = thr_copy_b.partition_S(gB);
+    auto tCrC = thr_mma.partition_sg_fragment_C(gC);
+
+    auto prefetch_a = make_block_2d_prefetch(copy_a);
+    auto prefetch_b = make_block_2d_prefetch(copy_b);
+    auto thr_prefetch_A = prefetch_a.get_slice(local_id);
+    auto thr_prefetch_B = prefetch_b.get_slice(local_id);
+    auto pAgA = thr_prefetch_A.partition_S(gA);
+    auto pBgB = thr_prefetch_B.partition_S(gB);
+
+    constexpr int prefetch_dist = 3;
+    constexpr int barrier_scope = 2;
+    const int k_tile_count = ceil_div(shape<1>(A_tensor), get<2>(wg_tile));
+    int k_tile_prefetch = 0;
+    clear(tCrC);
+
+    CUTE_UNROLL
+    for (; k_tile_prefetch < prefetch_dist; k_tile_prefetch++) {
+      prefetch(prefetch_a, pAgA(_, _, _, k_tile_prefetch));
+      prefetch(prefetch_b, pBgB(_, _, _, k_tile_prefetch));
+    }
+
+    for (int k_tile = 0; k_tile < k_tile_count;
+         k_tile++, k_tile_prefetch++) {
+      barrier_arrive(barrier_scope);
+
+      copy(copy_a, tAgA(_, _, _, k_tile), tArA);
+      copy(copy_b, tBgB(_, _, _, k_tile), tBrB);
+
+      if (k_tile_prefetch < k_tile_count) {
+        prefetch(prefetch_a, pAgA(_, _, _, k_tile_prefetch));
+        prefetch(prefetch_b, pBgB(_, _, _, k_tile_prefetch));
+      }
+
+      reorder(tArA, tCrA);
+      reorder(tBrB, tCrB);
+
+      cute::gemm(mma, tCrA, tCrB, tCrC);
+
+      barrier_wait(barrier_scope);
+    }
+
+    CUTLASS_PRAGMA_UNROLL
+    for (int sn = 0; sn < SG_N / sg_local_range; ++sn) {
+      const int sg_local_n = sn * sg_local_range + sg_local_id;
+      const int col = n_tile_start + n_sg_start + sg_local_n;
+      const float b_scale =
+          (Scales != nullptr && col < gemm_n)
+              ? Scales[expert * static_cast<int64_t>(gemm_n) + col]
+              : 1.0f;
+      const float b_float =
+          (Bias != nullptr && col < gemm_n)
+              ? Bias[expert * static_cast<int64_t>(gemm_n) + col]
+              : 0.0f;
+      CUTLASS_PRAGMA_UNROLL
+      for (int sm = 0; sm < SG_M; ++sm) {
+        const int idx = sn * SG_M + sm;
+        const int row = m_sg_start + sm;
+        if (row == 0 && col < gemm_n) {
+          const float a_scale =
+              ActivationScales != nullptr ? ActivationScales[permuted_row]
+                                          : 1.0f;
+          const float value =
+              static_cast<float>(tCrC(idx)) * a_scale * b_scale + b_float;
+          const ElementD rounded = static_cast<ElementD>(value);
+          tCrAccum(idx) += static_cast<float>(rounded) * route_weight;
+        }
+      }
+    }
+  }
+
+  reorder(tCrAccum, tCrC_out);
+  copy(copy_c, tCrC_out, tCgC);
+}
