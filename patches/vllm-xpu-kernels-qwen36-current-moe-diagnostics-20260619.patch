+
+#define W8A8TopK8GatherDispatch(policy)            \
+  if (D_dtype == at::kBFloat16) {                  \
+    using out_t = bfloat16_t;                      \
+    W8A8TopK8GatherLauncherCallER(policy, out_t);  \
+  } else if (D_dtype == at::kHalf) {               \
+    using out_t = half_t;                          \
+    W8A8TopK8GatherLauncherCallER(policy, out_t);  \
+  }
+
+  const char* ntile_env =
+      std::getenv("VLLM_XPU_MOE_W8A8_DPAS_GEMM2_GATHER_NTILE");
+  if (ntile_env != nullptr && std::string(ntile_env) == "16") {
