+        reinterpret_cast<const sycl::half*>(gemm2_output.data_ptr()),
+        topk_weights.data_ptr<float>(),
+        unpermuted_row_to_permuted_row.data_ptr<int>(),
+        hidden_size);
+  } else {
+    qwen36_single_token_gather_topk8_out_impl(
+        output.data_ptr<float>(),
+        gemm2_output.data_ptr<float>(),
+        topk_weights.data_ptr<float>(),
+        unpermuted_row_to_permuted_row.data_ptr<int>(),
+        hidden_size);
+  }
+}
