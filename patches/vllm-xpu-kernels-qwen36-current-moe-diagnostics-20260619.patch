+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(ptr_bias->is_contiguous(), "ptr_bias must be contiguous");
+  }
+
+  TORCH_CHECK(ptr_B.size(0) == num_experts, "ptr_B.size(0) mismatch");
+  TORCH_CHECK(ptr_B.size(1) == K, "ptr_B.size(1) mismatch");
+  TORCH_CHECK(ptr_B.size(2) == N, "ptr_B.size(2) mismatch");
+  TORCH_CHECK(
+      ptr_B_scales.size(0) == num_experts,
+      "ptr_B_scales.size(0) must match num_experts");
+  TORCH_CHECK(ptr_B_scales.size(1) == N, "ptr_B_scales.size(1) mismatch");
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(
+        ptr_bias->size(0) == num_experts,
