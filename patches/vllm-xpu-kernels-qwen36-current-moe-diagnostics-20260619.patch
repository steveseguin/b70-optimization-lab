+int* qwen36_workspace_atomic_ptr(torch::Tensor& workspace) {
+  TORCH_CHECK(
+      workspace.scalar_type() == torch::kUInt8,
+      "qwen36 workspace atomic reuse expects a uint8 workspace");
+  TORCH_CHECK(
+      workspace.numel() >= static_cast<int64_t>(sizeof(int)),
+      "qwen36 workspace is too small for atomic reuse");
+  auto* ptr = workspace.data_ptr<uint8_t>();
+  TORCH_CHECK(
+      reinterpret_cast<std::uintptr_t>(ptr) % alignof(int) == 0,
+      "qwen36 workspace pointer is not int aligned");
