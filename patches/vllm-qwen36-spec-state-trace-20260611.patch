+    def _spec_trace_request_state(self, request: Request) -> dict[str, Any]:
+        """Snapshot request counters for opt-in speculative debug traces."""
+        return {
+            "num_prompt_tokens": request.num_prompt_tokens,
+            "num_output_tokens": request.num_output_tokens,
+            "num_tokens": request.num_tokens,
+            "num_tokens_with_spec": request.num_tokens_with_spec,
+            "num_computed_tokens": request.num_computed_tokens,
+            "num_output_placeholders": request.num_output_placeholders,
+            "spec_len": len(request.spec_token_ids),
+            "spec_token_ids": list(request.spec_token_ids),
+            "max_tokens": request.max_tokens,
+            "is_prefill_chunk": request.is_prefill_chunk,
+            "status": str(request.status),
+            "last_output_token_ids": list(request.output_token_ids[-16:]),
+        }
+
+    def _trace_spec_decode_step(
+        self,
+        *,
+        req_id: str,
+        scheduled_spec_token_ids: list[int],
+        generated_token_ids: list[int],
+        emitted_token_ids: list[int],
+        suppressed_bonus_token_id: int | None,
+        num_draft_tokens: int,
+        num_accepted: int,
+        num_rejected: int,
+        num_tokens_scheduled: int,
+        request_state_before_reject_adjust: dict[str, Any],
+        request_state_after_reject_adjust: dict[str, Any],
+        request_state_after_output_update: dict[str, Any],
+        new_token_ids_after_stop_check: list[int],
+        stopped: bool,
+        status_before_stop_check: str,
+    ) -> None:
+        if not self.spec_decode_trace_file:
+            return
+        if (self.spec_decode_trace_max_lines > 0
+                and self.spec_decode_trace_lines >=
+                self.spec_decode_trace_max_lines):
+            return
+        record = {
+            "ts": time.time(),
+            "req_id": req_id,
+            "num_draft_tokens": num_draft_tokens,
+            "num_accepted": num_accepted,
+            "num_rejected": num_rejected,
+            "num_tokens_scheduled": num_tokens_scheduled,
+            "scheduled_spec_token_ids": scheduled_spec_token_ids,
+            "generated_token_ids": generated_token_ids,
+            "emitted_token_ids": emitted_token_ids,
+            "new_token_ids_after_stop_check": new_token_ids_after_stop_check,
+            "suppressed_bonus_token_id": suppressed_bonus_token_id,
+            "stopped": stopped,
+            "status_before_stop_check": status_before_stop_check,
+            "request_state_before_reject_adjust":
+            request_state_before_reject_adjust,
+            "request_state_after_reject_adjust":
+            request_state_after_reject_adjust,
+            "request_state_after_output_update":
+            request_state_after_output_update,
+        }
+        try:
+            with open(self.spec_decode_trace_file, "a", encoding="utf-8") as f:
+                f.write(json.dumps(record, separators=(",", ":")) + "\n")
+            self.spec_decode_trace_lines += 1
+        except Exception:
+            logger.exception("Failed to write spec decode trace record")
+
