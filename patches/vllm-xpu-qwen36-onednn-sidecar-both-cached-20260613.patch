+SidecarMatmulStats execute_cached_grouped_matmul(
+    dnnl::engine& engine,
+    dnnl::stream& engine_stream,
+    int64_t device_index,
+    const torch::Tensor& src,
+    const torch::Tensor& src_scales,
+    const torch::Tensor& weights,
+    const torch::Tensor& weights_scales,
+    const torch::Tensor& dst,
+    const torch::Tensor& onednn_grouped_offsets,
+    int64_t m,
+    int64_t k,
+    int64_t n,
+    int64_t num_experts,
+    dnnl::memory::format_tag weight_layout,
+    bool wait_after_execute) {
+  int64_t cache_hit = 0;
+  int64_t construct_us = 0;
+  auto cached = get_cached_grouped_matmul(engine, device_index, dst, m, k, n,
+                                          num_experts, weight_layout,
+                                          &cache_hit, &construct_us);
+  std::vector<void*> src_handles = {
+      const_cast<void*>(src.data_ptr()),
+      const_cast<void*>(onednn_grouped_offsets.data_ptr())};
+  std::vector<void*> dst_handles = {
+      dst.data_ptr(),
+      const_cast<void*>(onednn_grouped_offsets.data_ptr())};
+  auto src_mem = dnnl::sycl_interop::make_memory(
+      cached->src_md, engine, dnnl::sycl_interop::memory_kind::usm, src_handles);
+  auto dst_mem = dnnl::sycl_interop::make_memory(
+      cached->dst_md, engine, dnnl::sycl_interop::memory_kind::usm, dst_handles);
+  auto weights_mem = oneDNN::make_onednn_memory(
+      cached->weights_md, engine, const_cast<void*>(weights.data_ptr()));
+  auto src_scales_mem = oneDNN::make_onednn_memory(
+      cached->src_scales_md, engine, const_cast<void*>(src_scales.data_ptr()));
+  auto weights_scales_mem = oneDNN::make_onednn_memory(
+      cached->weights_scales_md, engine,
+      const_cast<void*>(weights_scales.data_ptr()));
+  std::unordered_map<int, dnnl::memory> args = {
+      {DNNL_ARG_SRC, src_mem},
+      {DNNL_ARG_WEIGHTS, weights_mem},
+      {DNNL_ARG_DST, dst_mem},
+      {DNNL_ARG_ATTR_SCALES | DNNL_ARG_SRC, src_scales_mem},
+      {DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS, weights_scales_mem},
+  };
+  const auto execute_start = std::chrono::steady_clock::now();
+  cached->prim.execute(engine_stream, args);
+  if (wait_after_execute) {
+    engine_stream.wait();
+  }
+  const auto execute_end = std::chrono::steady_clock::now();
+  return {construct_us,
+          std::chrono::duration_cast<std::chrono::microseconds>(
+              execute_end - execute_start).count(),
+          cache_hit};
+}
