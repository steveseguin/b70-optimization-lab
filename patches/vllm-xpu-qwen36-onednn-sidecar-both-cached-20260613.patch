+struct SidecarMatmulCacheKey {
+  int64_t device_index;
+  int64_t m;
+  int64_t k;
+  int64_t n;
+  int64_t num_experts;
+  int64_t dst_dtype;
+  int64_t weight_layout;
+
+  bool operator==(const SidecarMatmulCacheKey& other) const {
+    return device_index == other.device_index && m == other.m && k == other.k &&
+        n == other.n && num_experts == other.num_experts &&
+        dst_dtype == other.dst_dtype && weight_layout == other.weight_layout;
+  }
+};
+
+struct SidecarMatmulCacheKeyHash {
+  size_t operator()(const SidecarMatmulCacheKey& key) const {
+    size_t h = 0;
+    auto mix = [&h](int64_t value) {
+      size_t v = std::hash<int64_t>{}(value);
+      h ^= v + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
+    };
+    mix(key.device_index);
+    mix(key.m);
+    mix(key.k);
+    mix(key.n);
+    mix(key.num_experts);
+    mix(key.dst_dtype);
+    mix(key.weight_layout);
+    return h;
+  }
+};
+
+struct CachedSidecarMatmul {
+  CachedSidecarMatmul(dnnl::memory::desc src_md,
+                      dnnl::memory::desc weights_md,
+                      dnnl::memory::desc dst_md,
+                      dnnl::memory::desc src_scales_md,
+                      dnnl::memory::desc weights_scales_md,
+                      dnnl::matmul prim)
+      : src_md(std::move(src_md)),
+        weights_md(std::move(weights_md)),
+        dst_md(std::move(dst_md)),
+        src_scales_md(std::move(src_scales_md)),
+        weights_scales_md(std::move(weights_scales_md)),
+        prim(std::move(prim)) {}
+
+  dnnl::memory::desc src_md;
+  dnnl::memory::desc weights_md;
+  dnnl::memory::desc dst_md;
+  dnnl::memory::desc src_scales_md;
+  dnnl::memory::desc weights_scales_md;
+  dnnl::matmul prim;
+};
+
+std::mutex g_sidecar_matmul_cache_mutex;
+std::unordered_map<SidecarMatmulCacheKey,
+                   std::shared_ptr<CachedSidecarMatmul>,
+                   SidecarMatmulCacheKeyHash>
+    g_sidecar_matmul_cache;
+
+int64_t sidecar_matmul_cache_size() {
+  std::lock_guard<std::mutex> guard(g_sidecar_matmul_cache_mutex);
+  return static_cast<int64_t>(g_sidecar_matmul_cache.size());
+}
+
+std::shared_ptr<CachedSidecarMatmul> get_cached_grouped_matmul(
+    dnnl::engine& engine,
+    int64_t device_index,
+    const torch::Tensor& dst,
+    int64_t m,
+    int64_t k,
+    int64_t n,
+    int64_t num_experts,
+    dnnl::memory::format_tag weight_layout,
+    int64_t* cache_hit,
+    int64_t* construct_us) {
+  SidecarMatmulCacheKey key{
+      device_index,
+      m,
+      k,
+      n,
+      num_experts,
+      static_cast<int64_t>(dnnl_dst_dtype(dst)),
+      static_cast<int64_t>(weight_layout),
+  };
+
+  {
+    std::lock_guard<std::mutex> guard(g_sidecar_matmul_cache_mutex);
+    auto it = g_sidecar_matmul_cache.find(key);
+    if (it != g_sidecar_matmul_cache.end()) {
+      *cache_hit = 1;
+      *construct_us = 0;
+      return it->second;
+    }
+  }
+
+  const auto construct_start = std::chrono::steady_clock::now();
+  auto src_md = dnnl::memory::desc::grouped(
+      {m, k}, dnnl::memory::data_type::s8, 0, num_experts);
+  auto dst_md = dnnl::memory::desc::grouped(
+      {m, n}, dnnl_dst_dtype(dst), 0, num_experts);
+  auto weights_md = dnnl::memory::desc(
+      {num_experts, k, n}, dnnl::memory::data_type::s8, weight_layout);
+  auto src_scales_md = dnnl::memory::desc(
+      {m}, dnnl::memory::data_type::f32, dnnl::memory::format_tag::a);
+  auto weights_scales_md = dnnl::memory::desc(
+      {num_experts, n}, dnnl::memory::data_type::f32,
+      dnnl::memory::format_tag::ab);
+  dnnl::primitive_attr attr;
+  attr.set_scales_mask(DNNL_ARG_SRC, 1 << 0);
+  attr.set_scales_mask(DNNL_ARG_WEIGHTS, (1 << 0) | (1 << 2));
+  auto pd = dnnl::matmul::primitive_desc(engine, src_md, weights_md, dst_md, attr);
+  auto cached = std::make_shared<CachedSidecarMatmul>(
+      src_md, weights_md, dst_md, src_scales_md, weights_scales_md,
+      dnnl::matmul(pd));
+  const auto construct_end = std::chrono::steady_clock::now();
+
+  {
+    std::lock_guard<std::mutex> guard(g_sidecar_matmul_cache_mutex);
+    auto inserted = g_sidecar_matmul_cache.emplace(key, cached);
+    if (!inserted.second) {
+      *cache_hit = 1;
+      *construct_us = 0;
+      return inserted.first->second;
+    }
+  }
+
+  *cache_hit = 0;
+  *construct_us = std::chrono::duration_cast<std::chrono::microseconds>(
+      construct_end - construct_start).count();
+  return cached;
+}
