+def test_laguna_mlp_marks_separate_gate_and_up_in_forward_order(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    calls: list[str] = []
+
+    class FakeLinear(nn.Module):
+        def __init__(self, *_args, **kwargs) -> None:
+            super().__init__()
+            self.prefix = kwargs.get("prefix", "")
+
+        def forward(self, inputs: torch.Tensor):
+            role = self.prefix.rsplit(".", 1)[-1]
+            calls.append(role)
+            width = 3072 if role == "down_proj" else 256
+            return (
+                torch.ones(
+                    inputs.shape[0],
+                    width,
+                    dtype=torch.bfloat16,
+                ),
+                None,
+            )
+
+    monkeypatch.setattr(laguna, "ColumnParallelLinear", FakeLinear)
+    monkeypatch.setattr(laguna, "RowParallelLinear", FakeLinear)
+    mlp = laguna.LagunaMLP(
+        hidden_size=3072,
+        intermediate_size=1024,
+        hidden_act="silu",
+        exact_spec_target=True,
+        use_m8_shared_gate_up_mm=True,
+        _m8_shared_gate_up_scope=(laguna._LAGUNA_M8_SHARED_GATE_UP_CONSTRUCTOR_SCOPE),
+        prefix="model.layers.1.mlp.shared_expert",
+    )
+
+    output = mlp(torch.ones(8, 3072, dtype=torch.bfloat16))
+
+    assert output.shape == (8, 3072)
+    assert calls == ["gate_proj", "up_proj", "down_proj"]
+    pair = None
+    for projection, prefix, role in (
+        (mlp.gate_proj, _GATE_PREFIX, "gate_proj"),
+        (mlp.up_proj, _UP_PREFIX, "up_proj"),
+    ):
+        assert projection.xpu_laguna_m8_shared_gate_up_mm is True
+        scope = projection._xpu_laguna_m8_shared_gate_up_scope
+        assert scope[0] is linear._XPU_LAGUNA_M8_SHARED_GATE_UP_SCOPE
+        assert scope[2] == role
+        if pair is None:
+            pair = scope[1]
+        else:
+            assert scope[1] is pair
+        assert linear._xpu_laguna_m8_shared_gate_up_pair_scope_valid(
+            projection,
+            prefix,
+            role,
+            scope,
+        )
+        assert not hasattr(projection, "xpu_laguna_m8_shared_gate_mm")
+    assert not hasattr(
