+def test_shared_gate_up_mm_violations_raise_before_fallback(
+    monkeypatch: pytest.MonkeyPatch,
+    case: str,
+    expected: str,
+) -> None:
+    class FallbackMethod:
+        def apply_batched_m1(self, *_args) -> torch.Tensor:
+            raise AssertionError("invalid method silently used its fallback")
+
+    _set_gate_up_environment(monkeypatch)
+    monkeypatch.setattr(
+        linear,
+        "_xpu_is_exact_decode_or_verifier_rows",
+        lambda _: True,
+    )
+    monkeypatch.setattr(
+        linear.current_platform,
+        "is_xpu",
+        lambda: case != "platform",
+    )
+    monkeypatch.setattr(
+        linear.torch.compiler,
+        "is_compiling",
+        lambda: case == "compiler",
+    )
+    if case == "selector_literal":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_SHARED_GATE_UP_MM", "2")
+    if case == "stack_exact":
+        monkeypatch.setenv("VLLM_XPU_EXACT_SPEC_ATTN", "0")
+    if case == "stack_moe":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_BATCHED_EXACT_MOE", "0")
+    if case == "stack_elementwise":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_SHARED_ELEMENTWISE", "0")
+    if case == "stack_qknorm":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_QKNORM_ROPE", "0")
+    if case == "stack_graph":
+        monkeypatch.setenv("VLLM_XPU_ENABLE_XPU_GRAPH", "1")
+    if case == "stack_route":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_ROUTE_INTERLEAVE", "0")
+    if case == "stack_w1":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_W1_N_TILE", "128")
+    if case == "standalone_gate":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_SHARED_GATE_MM", "1")
+    if case == "shared_down":
+        monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_SHARED_DOWN_MM", "1")
+    if case == "unset_standalone_gate":
+        monkeypatch.delenv("VLLM_XPU_LAGUNA_M8_SHARED_GATE_MM")
+    if case == "unset_shared_down":
+        monkeypatch.delenv("VLLM_XPU_LAGUNA_M8_SHARED_DOWN_MM")
+
+    rows = torch.empty(8, 3072, dtype=torch.bfloat16)
+    gate, up = _make_gate_up_pair()
+    layer = gate
+    method = linear.UnquantizedLinearMethod()
+    bias = None
+    if case == "rows_shape":
+        rows = torch.empty(8, 3071, dtype=torch.bfloat16)
+    elif case == "rows_dtype":
+        rows = rows.float()
+    elif case == "rows_layout":
+        rows = torch.empty(3072, 8, dtype=torch.bfloat16).t()
+    elif case == "weight_shape":
+        layer.weight = torch.empty(255, 3072, dtype=torch.bfloat16)
+    elif case == "weight_dtype":
+        layer.weight = layer.weight.float()
+    elif case == "weight_layout":
+        layer.weight = torch.empty(3072, 256, dtype=torch.bfloat16).t()
+    elif case == "method":
+        method = FallbackMethod()
+    elif case == "bias":
+        bias = torch.empty(256, dtype=torch.bfloat16)
+    elif case == "prefix":
+        layer.prefix = "model.layers.1.mlp.shared_expert.down_proj"
+    elif case == "rebound_prefix":
+        layer.prefix = "model.layers.2.mlp.shared_expert.gate_proj"
+    elif case == "scope":
+        layer._xpu_laguna_m8_shared_gate_up_scope = None
+    elif case == "gate_role":
+        scope = layer._xpu_laguna_m8_shared_gate_up_scope
+        layer._xpu_laguna_m8_shared_gate_up_scope = (
+            scope[0],
+            scope[1],
+            "up_proj",
+        )
+    elif case == "up_role":
+        layer = up
+        scope = layer._xpu_laguna_m8_shared_gate_up_scope
+        layer._xpu_laguna_m8_shared_gate_up_scope = (
+            scope[0],
+            scope[1],
+            "gate_proj",
+        )
+    elif case == "missing_marker":
+        layer.xpu_laguna_m8_shared_gate_up_mm = False
+    elif case == "missing_peer_marker":
+        up.xpu_laguna_m8_shared_gate_up_mm = False
+    elif case == "missing_peer_scope":
+        up._xpu_laguna_m8_shared_gate_up_scope = None
+    elif case == "peer_exact_rows":
+        up.xpu_exact_spec_rows = False
+    elif case == "peer_weight_layout":
+        up.weight = torch.empty(3072, 256, dtype=torch.bfloat16).t()
+    elif case == "peer_bias":
+        up.bias = torch.empty(256, dtype=torch.bfloat16)
+    layer.xpu_exact_spec_rows = case != "exact_rows"
+
+    def forbidden_primitive(*_args, **_kwargs):
+        raise AssertionError("invalid candidate reached a GEMM primitive")
+
+    monkeypatch.setattr(torch, "mm", forbidden_primitive)
+    monkeypatch.setattr(torch, "bmm", forbidden_primitive)
+    with pytest.raises(RuntimeError, match=expected):
+        linear._xpu_apply_batched_m1_method(
+            layer,
+            method,
+            rows,
+            bias,
+        )
