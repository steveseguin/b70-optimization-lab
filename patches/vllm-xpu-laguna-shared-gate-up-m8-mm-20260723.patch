+def _set_gate_up_environment(monkeypatch: pytest.MonkeyPatch) -> None:
+    _set_record_environment(monkeypatch)
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_SHARED_GATE_MM", "0")
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_SHARED_GATE_UP_MM", "1")
+
+
+class _GateUpTestLayer:
+    pass
+
+
+def _make_gate_up_pair(
+    gate_weight: torch.Tensor | None = None,
+    up_weight: torch.Tensor | None = None,
+) -> tuple[_GateUpTestLayer, _GateUpTestLayer]:
+    gate = _GateUpTestLayer()
+    gate.prefix = _GATE_PREFIX
+    gate.weight = (
+        torch.empty(256, 3072, dtype=torch.bfloat16)
+        if gate_weight is None
+        else gate_weight
+    )
+    gate.xpu_exact_spec_rows = True
+    up = _GateUpTestLayer()
+    up.prefix = _UP_PREFIX
+    up.weight = (
+        torch.empty(256, 3072, dtype=torch.bfloat16) if up_weight is None else up_weight
+    )
+    up.xpu_exact_spec_rows = True
+    linear._xpu_bind_laguna_m8_shared_gate_up_pair(gate, up)
+    return gate, up
+
