+)
+
+
+def _loaded_laguna_kv_scale_rows(
+    model: nn.Module,
+) -> list[tuple[int, str, float, float]]:
+    """Return loaded per-layer K/V scales after quantization postprocessing."""
+    rows: list[tuple[int, str, float, float]] = []
+    for name, module in model.named_modules():
+        if not isinstance(module, Attention) or not name.endswith(".self_attn.attn"):
+            continue
+        layer = extract_layer_index(name)
+        if layer is None:
+            raise RuntimeError(f"cannot identify Laguna attention layer: {name}")
+        k_scale = getattr(module, "_k_scale", None)
+        v_scale = getattr(module, "_v_scale", None)
+        if not isinstance(k_scale, torch.Tensor) or k_scale.numel() != 1:
+            raise RuntimeError(f"invalid loaded K scale for {name}")
+        if not isinstance(v_scale, torch.Tensor) or v_scale.numel() != 1:
+            raise RuntimeError(f"invalid loaded V scale for {name}")
+        rows.append(
+            (
+                layer,
+                str(module.kv_cache_dtype),
+                float(k_scale.detach().float().cpu().item()),
+                float(v_scale.detach().float().cpu().item()),
+            )
+        )
+    rows.sort(key=lambda row: row[0])
+    return rows
+
+
+def _digest_laguna_target_kv_scales(
+    rows: list[tuple[int, str, float, float]],
+) -> str:
+    """Match the pinned checkpoint's length-prefixed FP32 scale manifest."""
+    digest = hashlib.sha256()
+    for layer, _, k_scale, v_scale in rows:
+        for kind, value in (("k", k_scale), ("v", v_scale)):
+            key = f"model.layers.{layer}.self_attn.{kind}_scale".encode()
+            raw = struct.pack("<f", value)
+            digest.update(len(key).to_bytes(4, "little"))
+            digest.update(key)
+            digest.update(len(raw).to_bytes(4, "little"))
+            digest.update(raw)
+    return digest.hexdigest()
 
 
 def _laguna_m8_shared_elementwise_graph_contract(
@@ -1770,6 +1820,40 @@ class LagunaForCausalLM(nn.Module, SupportsPP, SupportsLoRA, SupportsEagle3):
     def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
         return self.model.embed_input_ids(input_ids)
 
+    def audit_loaded_fp8_kv_scales(self) -> None:
+        rows = _loaded_laguna_kv_scale_rows(self)
+        expected_layers = list(range(48))
+        if [row[0] for row in rows] != expected_layers:
+            raise RuntimeError(
+                "Laguna FP8 KV scale audit expected target layers 0..47, "
+                f"got {[row[0] for row in rows]}"
+            )
+        bad_dtype = [
+            (layer, dtype)
+            for layer, dtype, _, _ in rows
+            if dtype not in {"fp8", "fp8_e4m3"}
+        ]
+        if bad_dtype:
+            raise RuntimeError(f"Laguna target KV cache is not FP8: {bad_dtype}")
+        values = [value for _, _, k, v in rows for value in (k, v)]
+        if not all(
+            torch.isfinite(torch.tensor(value)) and value > 0 for value in values
+        ):
+            raise RuntimeError("Laguna target has non-finite or non-positive KV scales")
+        digest = _digest_laguna_target_kv_scales(rows)
+        if digest != _LAGUNA_FP8_KV_SCALE_DIGEST:
+            raise RuntimeError(
+                "Laguna target FP8 KV scale digest mismatch: "
+                f"{digest} != {_LAGUNA_FP8_KV_SCALE_DIGEST}"
+            )
+        logger.info(
+            "LAGUNA_FP8_KV_SCALE_AUDIT=PASS model=target layers=48 "
+            "scale_mode=calibrated digest=%s min=%.10g max=%.10g",
+            digest,
+            min(values),
+            max(values),
+        )
+
     def forward(
         self,
         input_ids: torch.Tensor,
