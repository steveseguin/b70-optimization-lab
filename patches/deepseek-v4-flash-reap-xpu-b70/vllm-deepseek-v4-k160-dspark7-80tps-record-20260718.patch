+def test_xpu_all_gatherv_list_uses_cpu_group_and_preserves_bytes(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    communicator = object.__new__(xpu_communicator.XpuCommunicator)
+    communicator.cpu_group = "cpu-group"
+    communicator.device_group = "device-group"
+    communicator.world_size = 2
+    communicator.rank_in_group = 0
+    hidden = torch.arange(8, dtype=torch.bfloat16).reshape(2, 4)
+    weights = torch.arange(4, dtype=torch.float32).reshape(2, 2) / 10
+    expert_ids = torch.arange(4, dtype=torch.int32).reshape(2, 2)
+    remote = (hidden + 10, weights + 0.5, expert_ids + 3)
+    calls = []
+
+    def pack(tensors) -> torch.Tensor:
+        rows = tensors[0].shape[0]
+        return torch.cat(
+            [
+                tensor.contiguous()
+                .view(torch.uint8)
+                .reshape(rows, -1)
+                for tensor in tensors
+            ],
+            dim=1,
+        )
+
+    def fake_all_gather_into_tensor(output, source, **kwargs) -> None:
+        calls.append((output.shape, source.shape, source.device, kwargs["group"]))
+        output[:2].copy_(source)
+        output[2:].copy_(pack(remote))
+
+    monkeypatch.setattr(
+        xpu_communicator.dist,
+        "all_gather_into_tensor",
+        fake_all_gather_into_tensor,
+    )
+
+    gathered = communicator.all_gatherv(
+        [hidden, weights, expert_ids], sizes=[2, 2]
+    )
+
+    assert calls == [
+        (torch.Size([4, 24]), torch.Size([2, 24]), torch.device("cpu"), "cpu-group")
+    ]
+    for output, local, other in zip(gathered, (hidden, weights, expert_ids), remote):
+        torch.testing.assert_close(output[:2], local)
+        torch.testing.assert_close(output[2:], other)
+
