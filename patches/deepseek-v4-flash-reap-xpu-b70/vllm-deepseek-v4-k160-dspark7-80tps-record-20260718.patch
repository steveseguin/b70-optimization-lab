new file mode 100644
index 0000000000000000000000000000000000000000..b0ceb140ea2ed3b9837515dc725402475436d1c4
--- /dev/null
+++ b/vllm/models/deepseek_v4/xpu/divergence_capture.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Low-perturbation tensor capture for DeepSeek V4 XPU diagnostics.
+
+The recorder is disabled unless ``VLLM_XPU_V4_DIVERGENCE_CAPTURE_DIR`` is
+set.  While its arm file exists, calls only enqueue device-to-device clones.
+Removing the arm file makes the next model forward flush the queued tensors to
+disk before that (unmeasured) forward starts.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+
+import torch
+
+
+CAPTURE_DIR = os.environ.get("VLLM_XPU_V4_DIVERGENCE_CAPTURE_DIR", "")
+ARM_FILE = os.environ.get(
+    "VLLM_XPU_V4_DIVERGENCE_ARM_FILE", "/tmp/deepseek-v4-divergence-capture.arm"
+)
+CAPTURE_STAGES = {
+    value.strip()
+    for value in os.environ.get(
+        "VLLM_XPU_V4_DIVERGENCE_STAGES", "layer_out"
+    ).split(",")
+    if value.strip()
+}
+CAPTURE_MODE = os.environ.get("VLLM_XPU_V4_DIVERGENCE_MODE", "hash")
+MAX_RECORDS = int(os.environ.get("VLLM_XPU_V4_DIVERGENCE_MAX_RECORDS", "2048"))
+
+
+def _parse_layers(value: str) -> set[int] | None:
+    value = value.strip()
+    if not value or value == "all":
+        return None
+    layers: set[int] = set()
+    for part in value.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            first, last = part.split("-", 1)
+            layers.update(range(int(first), int(last) + 1))
+        else:
+            layers.add(int(part))
+    return layers
+
+
+CAPTURE_LAYERS = _parse_layers(
+    os.environ.get("VLLM_XPU_V4_DIVERGENCE_LAYERS", "all")
+)
+
+
+@dataclass
+class _Record:
+    forward: int
+    layer: int | None
+    stage: str
+    name: str
+    tensor: torch.Tensor
+
+
+class DivergenceRecorder:
+    def __init__(self) -> None:
+        self.enabled = bool(CAPTURE_DIR)
+        self._was_armed = False
+        self._active_forward: int | None = None
+        self._next_forward = 0
+        self._records: list[_Record] = []
+
+    def begin_forward(
+        self, input_ids: torch.Tensor, positions: torch.Tensor
+    ) -> None:
+        if not self.enabled:
+            return
+        armed = Path(ARM_FILE).exists()
+        if not armed:
+            if self._was_armed and self._records:
+                self.flush()
+            self._was_armed = False
+            self._active_forward = None
+            return
+
+        self._was_armed = True
+        self._active_forward = self._next_forward
+        self._next_forward += 1
+        self._enqueue(None, "forward_input", "input_ids", input_ids)
+        self._enqueue(None, "forward_input", "positions", positions)
+
+    def wants_layer(self, layer: int) -> bool:
+        return CAPTURE_LAYERS is None or layer in CAPTURE_LAYERS
+
+    def record(
+        self,
+        layer: int | None,
+        stage: str,
+        **tensors: torch.Tensor | None,
+    ) -> None:
+        if (
+            not self.enabled
+            or self._active_forward is None
+            or stage not in CAPTURE_STAGES
+            or (layer is not None and not self.wants_layer(layer))
+        ):
+            return
+        for name, tensor in tensors.items():
+            if tensor is not None:
+                self._enqueue(layer, stage, name, tensor)
+
+    def _enqueue(
+        self, layer: int | None, stage: str, name: str, tensor: torch.Tensor
+    ) -> None:
+        if self._active_forward is None or len(self._records) >= MAX_RECORDS:
+            return
+        # No host read, reduction, synchronization, or file I/O while armed.
+        snapshot = tensor.detach().contiguous().clone()
+        self._records.append(
+            _Record(self._active_forward, layer, stage, name, snapshot)
+        )
+
+    def flush(self) -> None:
+        output_dir = Path(CAPTURE_DIR)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        if torch.distributed.is_available() and torch.distributed.is_initialized():
+            rank = torch.distributed.get_rank()
+        else:
+            rank = int(os.environ.get("RANK", "0"))
+        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
+        stem = f"rank{rank}-pid{os.getpid()}-{stamp}"
+        manifest_path = output_dir / f"{stem}.jsonl"
+
+        with manifest_path.open("w", encoding="utf-8") as manifest:
+            for ordinal, record in enumerate(self._records):
+                cpu = record.tensor.detach().cpu().contiguous()
+                raw = cpu.view(torch.uint8).numpy().tobytes()
+                row = {
+                    "rank": rank,
+                    "forward": record.forward,
+                    "layer": record.layer,
+                    "stage": record.stage,
+                    "tensor_name": record.name,
+                    "shape": list(cpu.shape),
+                    "dtype": str(cpu.dtype),
+                    "raw_sha256": hashlib.sha256(raw).hexdigest(),
+                }
+                if CAPTURE_MODE == "full":
+                    tensor_name = (
+                        f"{stem}-f{record.forward:04d}-r{ordinal:05d}-"
+                        f"l{record.layer if record.layer is not None else 'na'}-"
+                        f"{record.stage}-{record.name}.pt"
+                    )
+                    torch.save(cpu, output_dir / tensor_name)
+                    row["tensor_path"] = tensor_name
+                manifest.write(json.dumps(row, sort_keys=True) + "\n")
+
+        self._records.clear()
+        self._active_forward = None
+
+
+RECORDER = DivergenceRecorder()
