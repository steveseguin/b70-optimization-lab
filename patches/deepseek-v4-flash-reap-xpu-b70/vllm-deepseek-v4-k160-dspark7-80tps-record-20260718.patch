+# SPDX-License-Identifier: Apache-2.0
+"""Content-addressed real-tensor capture for the DeepSeek V4 XPU cycle."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+from typing import Any
+
+import torch
+
+CAPTURE_DIR = os.environ.get("VLLM_XPU_V4_CAPTURE_CYCLE_DIR", "")
+CAPTURE_WIDTH = int(os.environ.get("VLLM_XPU_V4_CAPTURE_CYCLE_WIDTH", "2"))
+if CAPTURE_WIDTH not in (2, 4, 8):
+    raise ValueError("VLLM_XPU_V4_CAPTURE_CYCLE_WIDTH must be 2, 4, or 8")
+ARM_FILE = os.environ.get(
+    "VLLM_XPU_V4_CAPTURE_CYCLE_ARM_FILE",
+    "/tmp/deepseek-v4-cycle-capture.arm",
+)
+
+
+def configured_width() -> int:
+    return CAPTURE_WIDTH
+
+
+def enabled(index: int, limit: int) -> bool:
+    return (
+        bool(CAPTURE_DIR)
+        and index < limit
+        and Path(ARM_FILE).is_file()
+    )
+
+
+def tensor_metadata(tensor: torch.Tensor) -> dict[str, Any]:
+    return {
+        "shape": list(tensor.shape),
+        "stride": list(tensor.stride()),
+        "dtype": str(tensor.dtype),
+        "storage_offset": tensor.storage_offset(),
+        "storage_data_ptr": tensor.untyped_storage().data_ptr(),
+        "data_ptr": tensor.data_ptr(),
+    }
+
+
+def _store_blob(tensor: torch.Tensor) -> dict[str, Any]:
+    cpu = tensor.detach().cpu().contiguous()
+    raw = cpu.view(torch.uint8).numpy().tobytes()
+    raw_sha = hashlib.sha256(raw).hexdigest()
+    identity = hashlib.sha256()
+    identity.update(str(cpu.dtype).encode())
+    identity.update(b"\0")
+    identity.update(json.dumps(list(cpu.shape), separators=(",", ":")).encode())
+    identity.update(b"\0")
+    identity.update(raw)
+    blob_sha = identity.hexdigest()
+    blob_dir = Path(CAPTURE_DIR, "blobs")
+    blob_dir.mkdir(parents=True, exist_ok=True)
+    target = blob_dir / f"{blob_sha}.pt"
+    if not target.exists():
+        temporary = blob_dir / f".{blob_sha}.{os.getpid()}.tmp"
+        torch.save(cpu, temporary)
+        os.replace(temporary, target)
+    return {
+        "blob": f"blobs/{target.name}",
+        "blob_sha256": blob_sha,
+        "raw_sha256": raw_sha,
+        "shape": list(cpu.shape),
+        "dtype": str(cpu.dtype),
+        "numel": cpu.numel(),
+        "nbytes": len(raw),
+    }
+
+
+def write_record(
+    *,
+    category: str,
+    rank: int,
+    index: int,
+    fields: dict[str, Any],
+    tensors: dict[str, torch.Tensor],
+    metadata: dict[str, dict[str, Any]],
+) -> None:
+    output_dir = Path(CAPTURE_DIR, f"rank{rank}", category)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    record = {
+        "format_version": 2,
+        "category": category,
+        "rank": rank,
+        "index": index,
+        **fields,
+        "tensor_metadata": metadata,
+        "tensors": {name: _store_blob(tensor) for name, tensor in tensors.items()},
+    }
+    target = output_dir / f"{index:03d}.json"
+    temporary = output_dir / f".{index:03d}.{os.getpid()}.tmp"
+    temporary.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
+    os.replace(temporary, target)
