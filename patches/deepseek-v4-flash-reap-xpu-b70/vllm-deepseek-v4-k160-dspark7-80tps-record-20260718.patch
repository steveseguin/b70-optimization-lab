+            raise ValueError(
+                "VLLM_XPU_V4_BLOCK_FP8_W8A16_SHAPES entries must be NxK"
+            ) from exc
+        if n <= 0 or k <= 0:
+            raise ValueError("W8A16 shape dimensions must be positive")
+        shapes.add((n, k))
+    return frozenset(shapes)
+
