+    allowlist exists to isolate numerically sensitive DeepSeek V4 projection
+    families without changing checkpoint weights or prefill behavior.
+    """
+    shapes: set[tuple[int, int]] = set()
+    for item in value.split(","):
+        item = item.strip().lower()
+        if not item:
+            continue
+        try:
+            n_text, k_text = item.split("x", 1)
