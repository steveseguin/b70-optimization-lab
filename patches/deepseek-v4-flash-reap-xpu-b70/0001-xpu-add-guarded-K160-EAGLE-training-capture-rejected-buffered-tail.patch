@@ -0,0 +1,280 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import atexit
+import hashlib
+import json
+import os
+import re
+import threading
+from pathlib import Path
+from types import MethodType
+from typing import Any
+
+import torch
+from safetensors.torch import save_file
+
+FEATURE_BOUNDARIES = (4, 22, 43)
+_CAPTURE_DIR_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_DIR"
+_SHARD_ROWS_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_SHARD_ROWS"
+_ALL_RANKS_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_ALL_RANKS"
+_NAMESPACE_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_NAMESPACE"
+
+
+def capture_dir() -> Path | None:
+    value = os.getenv(_CAPTURE_DIR_ENV, "").strip()
+    return Path(value) if value else None
+
+
+def enabled() -> bool:
+    return capture_dir() is not None
+
+
+def capture_all_ranks() -> bool:
+    return os.getenv(_ALL_RANKS_ENV, "0") == "1"
+
+
+def capture_namespace() -> str:
+    namespace = os.getenv(_NAMESPACE_ENV, "").strip()
+    if namespace not in {"eagletrain", "eagledev", "eaglesmoke"}:
+        raise ValueError(
+            f"{_NAMESPACE_ENV} must be eagletrain, eagledev, or eaglesmoke"
+        )
+    return namespace
+
+
+def request_key(request_id: str) -> int:
+    digest = hashlib.sha256(request_id.encode()).digest()
+    return int.from_bytes(digest[:8], "little") & ((1 << 63) - 1)
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+class EagleTrainingCaptureWriter:
+    def __init__(self, output_dir: Path, shard_rows: int):
+        if shard_rows <= 0:
+            raise ValueError("capture shard rows must be positive")
+        output_dir.mkdir(parents=True, exist_ok=True)
+        if next(output_dir.glob("features-*.safetensors"), None) is not None:
+            raise FileExistsError(f"capture directory is not empty: {output_dir}")
+        self.output_dir = output_dir
+        self.shard_rows = shard_rows
+        self._lock = threading.Lock()
+        self._buffers: dict[str, list[torch.Tensor]] = {
+            "features_bf16": [],
+            "target_final_hidden_bf16": [],
+            "input_token_id": [],
+            "next_target_token_id": [],
+            "position_id": [],
+            "request_key": [],
+        }
+        self._rows = 0
+        self._next_shard = 0
+
+    def append(
+        self,
+        *,
+        aux_hidden_states: list[torch.Tensor],
+        target_final_hidden: torch.Tensor,
+        input_token_ids: torch.Tensor,
+        next_target_token_ids: torch.Tensor,
+        position_ids: torch.Tensor,
+        request_keys: torch.Tensor,
+    ) -> None:
+        if len(aux_hidden_states) != len(FEATURE_BOUNDARIES):
+            raise ValueError(
+                f"expected {len(FEATURE_BOUNDARIES)} feature taps, "
+                f"got {len(aux_hidden_states)}"
+            )
+        rows = target_final_hidden.shape[0]
+        if target_final_hidden.ndim != 2 or target_final_hidden.shape[1] != 4096:
+            raise ValueError("target final hidden states must have shape [rows, 4096]")
+        expected_shapes = [(rows, target_final_hidden.shape[-1])] * len(
+            FEATURE_BOUNDARIES
+        )
+        if [tuple(t.shape) for t in aux_hidden_states] != expected_shapes:
+            raise ValueError("feature tap shapes do not match final hidden states")
+        if request_keys.numel() != rows:
+            raise ValueError("request keys do not match captured rows")
+
+        features = torch.stack(aux_hidden_states, dim=1)
+        tensors = {
+            "features_bf16": features.detach().to(
+                device="cpu", dtype=torch.bfloat16
+            ),
+            "target_final_hidden_bf16": target_final_hidden.detach().to(
+                device="cpu", dtype=torch.bfloat16
+            ),
+            "input_token_id": input_token_ids.detach()
+            .to(device="cpu", dtype=torch.int32)
+            .reshape(-1),
+            "next_target_token_id": next_target_token_ids.detach()
+            .to(device="cpu", dtype=torch.int32)
+            .reshape(-1),
+            "position_id": position_ids.detach()
+            .to(device="cpu", dtype=torch.int32)
+            .reshape(-1),
+            "request_key": request_keys.detach()
+            .to(device="cpu", dtype=torch.int64)
+            .reshape(-1),
+        }
+        if any(tensor.shape[0] != rows for tensor in tensors.values()):
+            raise ValueError("capture fields do not have a common row count")
+
+        with self._lock:
+            for name, tensor in tensors.items():
+                self._buffers[name].append(tensor.contiguous())
+            self._rows += rows
+            if self._rows >= self.shard_rows:
+                self._flush_locked()
+
+    def flush(self) -> None:
+        with self._lock:
+            self._flush_locked()
+
+    def _flush_locked(self) -> None:
+        if not self._rows:
+            return
+        tensors = {
+            name: torch.cat(parts, dim=0)
+            for name, parts in self._buffers.items()
+        }
+        shard_name = f"features-{self._next_shard:06d}.safetensors"
+        final_path = self.output_dir / shard_name
+        temporary_path = final_path.with_suffix(".safetensors.incomplete")
+        save_file(
+            tensors,
+            temporary_path,
+            metadata={
+                "schema_version": "k160-eagle-training-capture-v1",
+                "feature_boundary_ids": ",".join(map(str, FEATURE_BOUNDARIES)),
+                "feature_reduction": "post_mhc_mean_stream",
+            },
+        )
+        temporary_path.replace(final_path)
+        checksum = _sha256(final_path)
+        manifest = {
+            "schema_version": "k160-eagle-training-capture-shard-v1",
+            "shard": shard_name,
+            "sha256": checksum,
+            "rows": self._rows,
+            "feature_boundary_ids": list(FEATURE_BOUNDARIES),
+            "feature_reduction": "post_mhc_mean_stream",
+            "tensors": {
+                name: {
+                    "dtype": str(tensor.dtype),
+                    "shape": list(tensor.shape),
+                }
+                for name, tensor in tensors.items()
+            },
+        }
+        manifest_path = final_path.with_suffix(".json")
+        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
+        for parts in self._buffers.values():
+            parts.clear()
+        self._rows = 0
+        self._next_shard += 1
+
+
+_WRITERS: dict[tuple[int, str], EagleTrainingCaptureWriter] = {}
+_WRITER_LOCK = threading.Lock()
+
+
+def get_writer(rank: int) -> EagleTrainingCaptureWriter:
+    output_dir = capture_dir()
+    if output_dir is None:
+        raise RuntimeError(f"{_CAPTURE_DIR_ENV} is not set")
+    namespace = capture_namespace()
+    key = (rank, namespace)
+    with _WRITER_LOCK:
+        if key not in _WRITERS:
+            shard_rows = int(os.getenv(_SHARD_ROWS_ENV, "4096"))
+            writer = EagleTrainingCaptureWriter(
+                output_dir / namespace / f"rank-{rank:03d}", shard_rows
+            )
+            _WRITERS[key] = writer
+            atexit.register(writer.flush)
+        return _WRITERS[key]
+
+
+def install_model_runner_capture(runner: Any) -> None:
+    if runner.speculative_config is not None:
+        raise ValueError("EAGLE training capture requires target-only generation")
+    if runner.scheduler_config.max_num_seqs != 1:
+        raise ValueError("EAGLE training capture requires max_num_seqs=1")
+    runner.use_aux_hidden_state_outputs = True
+    original_setup = runner._setup_eagle3_aux_hidden_state_outputs
+    original_sample_tokens = runner.sample_tokens
+
+    def setup_aux_hidden_states(self: Any) -> None:
+        model = self.get_model()
+        if not hasattr(model, "set_aux_hidden_state_layers"):
+            raise RuntimeError("target does not expose EAGLE auxiliary states")
+        model.set_aux_hidden_state_layers(FEATURE_BOUNDARIES)
+
+    def sample_tokens_with_capture(self: Any, grammar_output: Any) -> Any:
+        state = self.execute_model_state
+        pending = None
+        arm_file = os.getenv("VLLM_XPU_EAGLE_TRAINING_CAPTURE_ARM_FILE", "")
+        if arm_file and os.path.exists(arm_file):
+            if state is None or state.aux_hidden_states is None:
+                raise RuntimeError("armed EAGLE capture has no auxiliary states")
+            if grammar_output is not None:
+                raise ValueError("EAGLE training capture does not allow grammar")
+            metadata = self.input_batch.sampling_metadata
+            if not metadata.all_greedy or not metadata.no_penalties:
+                raise ValueError("EAGLE training capture requires plain greedy sampling")
+            if len(self.input_batch.req_ids) != 1:
+                raise RuntimeError("EAGLE training capture requires one request")
+            request_id = self.input_batch.req_ids[0]
+            replay = re.search(r"eaglereplay-(\d+)-(\d+)-", request_id)
+            if replay is None:
+                raise RuntimeError(
+                    "armed EAGLE capture accepts only teacher-forced replay requests"
+                )
+            prompt_len, continuation_len = map(int, replay.groups())
+            scheduled = int(self.query_start_loc.gpu[1])
+            expected = prompt_len + continuation_len
+            if scheduled != expected:
+                raise RuntimeError(
+                    "teacher-forced replay must fit in one uncached prefill: "
+                    f"scheduled={scheduled}, expected={expected}"
+                )
+            start = prompt_len - 1
+            stop = start + continuation_len
+            if start < 0 or stop >= scheduled:
+                raise RuntimeError("invalid teacher-forced replay span")
+            pending = {
+                "aux_hidden_states": [
+                    hidden[start:stop].detach() for hidden in state.aux_hidden_states
+                ],
+                "target_final_hidden": state.hidden_states[start:stop],
+                "input_token_ids": self.input_ids.gpu[start:stop],
+                "next_target_token_ids": self.input_ids.gpu[start + 1 : stop + 1],
+                "position_ids": self.positions[start:stop],
+                "request_keys": torch.tensor(
+                    [request_key(request_id)] * continuation_len,
+                    dtype=torch.int64,
+                    device=self.device,
+                ),
+            }
+        result = original_sample_tokens(grammar_output)
+        if pending is not None:
+            from vllm.distributed import get_tensor_model_parallel_rank
+
+            rank = get_tensor_model_parallel_rank()
+            if rank == 0 or capture_all_ranks():
+                get_writer(rank).append(**pending)
+        return result
+
+    runner._setup_eagle3_aux_hidden_state_outputs = MethodType(  # noqa: SLF001
+        setup_aux_hidden_states, runner
+    )
+    runner.sample_tokens = MethodType(sample_tokens_with_capture, runner)
+    runner._eagle_training_capture_original_setup = original_setup
