+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import json
+
+import pytest
+import torch
+from safetensors import safe_open
+
+from vllm.models.deepseek_v4.xpu.eagle_training_capture import (
+    FEATURE_BOUNDARIES,
+    EagleTrainingCaptureWriter,
+    capture_dir,
+    enabled,
+)
+
+
+def test_capture_is_default_off(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("VLLM_XPU_EAGLE_TRAINING_CAPTURE_DIR", raising=False)
+    assert not enabled()
+    assert capture_dir() is None
+
+
+def test_writer_preserves_aligned_rows(tmp_path) -> None:
+    writer = EagleTrainingCaptureWriter(tmp_path, shard_rows=2)
+    aux = [torch.randn(2, 4096, dtype=torch.bfloat16) for _ in FEATURE_BOUNDARIES]
+    final_hidden = torch.randn(2, 4096, dtype=torch.bfloat16)
+
+    writer.append(
+        aux_hidden_states=aux,
+        target_final_hidden=final_hidden,
+        input_token_ids=torch.tensor([10, 11]),
+        next_target_token_ids=torch.tensor([11, 12]),
+        position_ids=torch.tensor([100, 101]),
+        request_keys=torch.tensor([7, 7]),
+    )
+
+    shard = tmp_path / "features-000000.safetensors"
+    with safe_open(shard, framework="pt", device="cpu") as tensors:
+        assert tensors.metadata() == {
+            "schema_version": "k160-eagle-training-capture-v1",
+            "feature_boundary_ids": "4,22,43",
+            "feature_reduction": "post_mhc_mean_stream",
+        }
+        assert torch.equal(tensors.get_tensor("features_bf16")[:, 0], aux[0])
+        assert torch.equal(
+            tensors.get_tensor("target_final_hidden_bf16"), final_hidden
+        )
+        assert tensors.get_tensor("next_target_token_id").tolist() == [11, 12]
+        assert tensors.get_tensor("position_id").tolist() == [100, 101]
+        assert tensors.get_tensor("request_key").tolist() == [7, 7]
+
+    manifest = json.loads(shard.with_suffix(".json").read_text())
+    assert manifest["rows"] == 2
+    assert manifest["feature_boundary_ids"] == [4, 22, 43]
+    assert len(manifest["sha256"]) == 64
