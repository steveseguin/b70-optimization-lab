+        ).strip()
+        if capture_dir:
+            if vllm_config.speculative_config is not None:
+                raise ValueError(
+                    "EAGLE training capture requires target-only generation"
+                )
+            if vllm_config.scheduler_config.max_num_seqs != 1:
+                raise ValueError(
+                    "EAGLE training capture requires max_num_seqs=1"
+                )
+            from vllm.models.deepseek_v4.xpu.eagle_training_capture import (
+                FEATURE_BOUNDARIES,
+            )
+
+            self.model.aux_hidden_state_layers = FEATURE_BOUNDARIES
+            self._eagle_training_capture_pending = None
+            self._eagle_training_capture_request_index = -1
+            self.forward = self._eagle_training_capture_forward  # type: ignore[method-assign]
+            self.compute_logits = (  # type: ignore[method-assign]
+                self._eagle_training_capture_compute_logits
+            )

     def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
         return self.model.embed_input_ids(input_ids)
@@ -2125,6 +2148,69 @@ class DeepseekV4ForCausalLM(nn.Module, SupportsPP, SupportsEagle3):
         """Return exact greedy top-1 IDs without gathering full-vocab logits."""
         return self.logits_processor.get_top_tokens(self.lm_head, hidden_states)

+    def _eagle_training_capture_forward(
+        self,
+        input_ids: torch.Tensor,
+        positions: torch.Tensor,
+        intermediate_tensors: IntermediateTensors | None = None,
+        inputs_embeds: torch.Tensor | None = None,
+    ) -> torch.Tensor | IntermediateTensors:
+        output = self.model(
+            input_ids, positions, intermediate_tensors, inputs_embeds
+        )
+        if not get_pp_group().is_last_rank:
+            return output
+        if not isinstance(output, tuple):
+            raise RuntimeError("EAGLE training capture did not receive aux states")
+        hidden_states, aux_hidden_states = output
+        arm_file = os.environ.get(
+            "VLLM_XPU_EAGLE_TRAINING_CAPTURE_ARM_FILE", ""
+        )
+        if arm_file and os.path.exists(arm_file):
+            if input_ids.shape[0] > 1:
+                self._eagle_training_capture_request_index += 1
+            anchor = positions.argmax()
+            self._eagle_training_capture_pending = {
+                "aux_hidden_states": [
+                    state[anchor].unsqueeze(0) for state in aux_hidden_states
+                ],
+                "target_final_hidden": hidden_states[anchor].unsqueeze(0),
+                "input_token_ids": input_ids[anchor].reshape(1),
+                "position_ids": positions[anchor].reshape(1),
+                "request_keys": torch.full(
+                    (1,),
+                    self._eagle_training_capture_request_index,
+                    dtype=torch.int64,
+                    device=input_ids.device,
+                ),
+            }
+        else:
+            self._eagle_training_capture_pending = None
+        return hidden_states
+
+    def _eagle_training_capture_compute_logits(
+        self, hidden_states: torch.Tensor
+    ) -> torch.Tensor | None:
+        logits = DeepseekV4ForCausalLM.compute_logits(self, hidden_states)
+        pending = self._eagle_training_capture_pending
+        if pending is None:
+            return logits
+        if logits is None or logits.shape[0] != 1:
+            raise RuntimeError("EAGLE training capture requires one sampled row")
+        from vllm.models.deepseek_v4.xpu.eagle_training_capture import (
+            capture_all_ranks,
+            get_writer,
+        )
+
+        rank = get_tensor_model_parallel_rank()
+        if rank == 0 or capture_all_ranks():
+            get_writer(rank).append(
+                **pending,
+                next_target_token_ids=logits.argmax(dim=-1),
+            )
+        self._eagle_training_capture_pending = None
+        return logits
+
     def forward(
         self,
         input_ids: torch.Tensor,
