+#include <cerrno>
+#include <cstdlib>
+#include <limits>
+
+namespace {
+
+size_t get_b70_sycl_allreduce_max_bytes() {
+    static const size_t limit = []() {
+        const char* name = "B70_ONECCL_SYCL_ALLREDUCE_MAX_BYTES";
+        const char* value = std::getenv(name);
+        if (!value || !*value) {
+            return size_t{ 0 };
+        }
+        if (*value == '-') {
+            CCL_THROW(name, " must be a non-negative integer: ", value);
+        }
+        errno = 0;
+        char* end = nullptr;
+        const unsigned long long parsed = std::strtoull(value, &end, 10);
+        if (errno == ERANGE || end == value || *end != '\0' ||
+            parsed > std::numeric_limits<size_t>::max()) {
+            CCL_THROW("invalid ", name, " value: ", value);
+        }
+        return static_cast<size_t>(parsed);
+    }();
+    return limit;
+}
+
