 namespace TopkToppSamplerImpl {
 
+template <typename draft_t>
+struct greedy_rejection_from_target_tokens_kernel {
+  int64_t* sampled;
+  int32_t* num_sampled;
+  int32_t* num_rejected;
+  const int64_t* target_tokens;
+  const draft_t* draft_sampled;
+  const int32_t* cu_num_logits;
+  int64_t sampled_stride;
+
+  void operator()(sycl::id<1> item) const {
+    const int req_idx = item[0];
+    const int64_t start_idx = cu_num_logits[req_idx];
+    const int64_t end_idx = cu_num_logits[req_idx + 1];
+    const int64_t num_draft_tokens = end_idx - start_idx - 1;
+
+    int64_t accepted_length = 0;
+    bool accepted = true;
+    for (int64_t i = 0; i < num_draft_tokens; ++i) {
+      const int64_t target_token = target_tokens[start_idx + i];
+      const int64_t draft_token =
+          static_cast<int64_t>(draft_sampled[start_idx + i + 1]);
+      if (accepted) {
+        accepted = target_token == draft_token;
+        sampled[req_idx * sampled_stride + i] =
+            accepted ? draft_token : target_token;
+        accepted_length += accepted;
+      }
+    }
+
+    const int32_t num_output_tokens = accepted_length + 1;
+    if (accepted) {
+      sampled[req_idx * sampled_stride + accepted_length] =
+          target_tokens[end_idx - 1];
+    }
+    num_sampled[req_idx] = num_output_tokens;
+    num_rejected[req_idx] =
+        num_draft_tokens + 1 - num_output_tokens;
+  }
+};
