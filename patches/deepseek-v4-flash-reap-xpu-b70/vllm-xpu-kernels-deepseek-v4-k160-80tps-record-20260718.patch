+                torch.sin(base * (0.00113 * (rank + 1)) + 0.37)
+                * (rank + 1.5)
+            ).to(torch.bfloat16)
+            graph_residual = torch.stack(
+                [
+                    torch.cos(base * (0.00029 * (i + 1)) + 0.19)
+                    .mul_(i + 0.5)
+                    .to(torch.bfloat16)
+                    for i in range(HC)
+                ]
+            )
