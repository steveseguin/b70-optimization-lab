--- /dev/null
+++ b/csrc/xpu/mhc/xe_2/mhc_tp4_allreduce.cpp
@@ -0,0 +1,516 @@
+// Experimental graph-safe TP4 BF16 all-reduce micro-gate for DeepSeek V4.
+// IPC setup happens once before graph capture; the captured op only submits
+// one fixed-shape kernel on the current PyTorch XPU queue.
+
+#include <ATen/ATen.h>
+#include <ATen/xpu/XPUContext.h>
+#include <c10/xpu/XPUStream.h>
+#include <c10/xpu/XPUFunctions.h>
+#include <torch/all.h>
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <dlfcn.h>
+#include <mutex>
+#include <vector>
+
+#include <level_zero/ze_api.h>
+#include <sycl/ext/oneapi/backend/level_zero.hpp>
+#include <sycl/ext/oneapi/bfloat16.hpp>
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/esimd/memory.hpp>
+#include <sycl/sycl.hpp>
+
+#include "utils.h"
+
+namespace {
+
+using bf16 = sycl::ext::oneapi::bfloat16;
+namespace esimd = sycl::ext::intel::esimd;
+namespace esimd_exp = sycl::ext::intel::experimental::esimd;
+
+constexpr int kWorld = 4;
+constexpr int kHidden = 4096;
+constexpr int kSlots = 3;
+constexpr int kChannels = 128;
+constexpr size_t kPayloadElems =
+    static_cast<size_t>(kChannels) * kSlots * kHidden;
+constexpr size_t kPayloadBytes = kPayloadElems * sizeof(bf16);
+constexpr size_t kSyncBytes =
+    static_cast<size_t>(kChannels) * kSlots * kWorld * sizeof(uint32_t);
+constexpr size_t kWorkspaceBytes = kPayloadBytes + kSyncBytes;
+
+std::mutex g_registry_mutex;
+std::array<void*, kWorld> g_peer_bases{};
+std::array<void*, kWorld> g_opened_bases{};
+std::array<ze_ipc_mem_handle_t, kWorld> g_exported_handles{};
+std::array<bool, kWorld> g_has_exported_handle{};
+
+void check_ze(ze_result_t result, const char* what) {
+  TORCH_CHECK(
+      result == ZE_RESULT_SUCCESS,
+      what,
+      " failed with Level Zero result ",
+      static_cast<int>(result));
+}
+
+ze_context_handle_t native_context(sycl::queue& q) {
+  return sycl::get_native<sycl::backend::ext_oneapi_level_zero>(q.get_context());
+}
+
+ze_device_handle_t native_device(sycl::queue& q) {
+  return sycl::get_native<sycl::backend::ext_oneapi_level_zero>(q.get_device());
+}
+
+class TP4PublishReadyKernel;
+class TP4ReduceKernel;
+
+}  // namespace
+
+at::Tensor tp4_ipc_allocate_workspace(const at::Tensor& device_anchor) {
+  TORCH_CHECK(
+      device_anchor.is_xpu(),
+      "tp4_ipc_allocate_workspace: device_anchor must be XPU");
+  auto& q = vllm::xpu::vllmGetQueue(device_anchor.device().index());
+  void* ptr = sycl::malloc_device(kWorkspaceBytes, q);
+  TORCH_CHECK(ptr != nullptr, "tp4_ipc_allocate_workspace: allocation failed");
+  q.memset(ptr, 0, kWorkspaceBytes).wait();
+  const auto context = q.get_context();
+  auto options = at::TensorOptions()
+                     .dtype(at::kByte)
+                     .device(at::Device(at::kXPU, device_anchor.device().index()));
+  return at::from_blob(
+      ptr,
+      {static_cast<int64_t>(kWorkspaceBytes)},
+      [context](void* allocation) { sycl::free(allocation, context); },
+      options);
+}
+
+std::tuple<int64_t, int64_t, std::vector<int64_t>> tp4_ipc_export_fd(
+    const at::Tensor& workspace) {
+  TORCH_CHECK(workspace.is_xpu(), "tp4_ipc_export_fd: workspace must be XPU");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous(),
+      "tp4_ipc_export_fd: workspace must be contiguous uint8");
+  TORCH_CHECK(
+      static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "tp4_ipc_export_fd: workspace requires at least ",
+      kWorkspaceBytes,
+      " bytes");
+
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto context = native_context(q);
+  void* allocation_base = nullptr;
+  size_t allocation_size = 0;
+  check_ze(
+      zeMemGetAddressRange(
+          context, workspace.data_ptr(), &allocation_base, &allocation_size),
+      "zeMemGetAddressRange");
+  const auto offset = static_cast<int64_t>(
+      static_cast<uint8_t*>(workspace.data_ptr()) -
+      static_cast<uint8_t*>(allocation_base));
+  TORCH_CHECK(
+      offset >= 0 && static_cast<size_t>(offset) + kWorkspaceBytes <= allocation_size,
+      "tp4_ipc_export_fd: workspace is outside exported allocation");
+
+  ze_ipc_mem_handle_t handle{};
+  check_ze(zeMemGetIpcHandle(context, allocation_base, &handle), "zeMemGetIpcHandle");
+  // oneCCL's working pidfd exchange duplicates the descriptor embedded in the
+  // Level Zero IPC handle. The experimental descriptor-conversion API can
+  // return a descriptor that opens for ordinary access but does not preserve
+  // the peer-atomic behavior required by the collective.
+  const int fd = *reinterpret_cast<const int*>(handle.data);
+  TORCH_CHECK(fd >= 0, "tp4_ipc_export_fd: invalid embedded descriptor");
+  static_assert(
+      sizeof(ze_ipc_mem_handle_t) % sizeof(int64_t) == 0,
+      "Level Zero IPC handle must be representable as int64 words");
+  std::vector<int64_t> handle_words(
+      sizeof(ze_ipc_mem_handle_t) / sizeof(int64_t));
+  std::memcpy(handle_words.data(), &handle, sizeof(handle));
+
+  {
+    std::lock_guard<std::mutex> lock(g_registry_mutex);
+    bool retained = false;
+    for (int i = 0; i < kWorld; ++i) {
+      if (!g_has_exported_handle[i]) {
+        g_exported_handles[i] = handle;
+        g_has_exported_handle[i] = true;
+        retained = true;
+        break;
+      }
+    }
+    TORCH_CHECK(retained, "tp4_ipc_export_fd: export registry exhausted");
+  }
+  return {static_cast<int64_t>(fd), offset, std::move(handle_words)};
+}
+
+void tp4_ipc_register_fd(
+    const at::Tensor& workspace,
+    int64_t peer_rank,
+    int64_t fd,
+    int64_t allocation_offset,
+    const std::vector<int64_t>& handle_words) {
+  TORCH_CHECK(workspace.is_xpu(), "tp4_ipc_register_fd: workspace must be XPU");
+  TORCH_CHECK(peer_rank >= 0 && peer_rank < kWorld, "invalid TP4 peer rank");
+  TORCH_CHECK(fd >= 0, "invalid IPC file descriptor");
+  TORCH_CHECK(allocation_offset >= 0, "invalid IPC allocation offset");
+  TORCH_CHECK(
+      handle_words.size() * sizeof(int64_t) == sizeof(ze_ipc_mem_handle_t),
+      "invalid Level Zero IPC handle word count");
+
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto context = native_context(q);
+  auto device = native_device(q);
+  ze_ipc_mem_handle_t handle{};
+  // This mirrors oneCCL's pidfd route: rebuild a zero handle around the
+  // descriptor duplicated into the receiving process. The remaining opaque
+  // bytes are exporter-process state and must not be copied across processes.
+  *reinterpret_cast<int*>(handle.data) = static_cast<int>(fd);
+  void* allocation_base = nullptr;
+  check_ze(
+      zeMemOpenIpcHandle(
+          context,
+          device,
+          handle,
+          static_cast<ze_ipc_memory_flags_t>(0),
+          &allocation_base),
+      "zeMemOpenIpcHandle");
+
+  std::lock_guard<std::mutex> lock(g_registry_mutex);
+  TORCH_CHECK(
+      g_opened_bases[peer_rank] == nullptr,
+      "tp4_ipc_register_fd: peer rank already registered");
+  g_opened_bases[peer_rank] = allocation_base;
+  g_peer_bases[peer_rank] =
+      static_cast<uint8_t*>(allocation_base) + allocation_offset;
+}
+
+void tp4_ipc_clear() {
+  auto& q = vllm::xpu::vllmGetQueue();
+  q.wait();
+  auto context = native_context(q);
+  std::lock_guard<std::mutex> lock(g_registry_mutex);
+  for (int i = 0; i < kWorld; ++i) {
+    if (g_opened_bases[i] != nullptr) {
+      check_ze(
+          zeMemCloseIpcHandle(context, g_opened_bases[i]),
+          "zeMemCloseIpcHandle");
+    }
+    g_opened_bases[i] = nullptr;
+    g_peer_bases[i] = nullptr;
+    if (g_has_exported_handle[i]) {
+      check_ze(
+          zeMemPutIpcHandle(context, g_exported_handles[i]),
+          "zeMemPutIpcHandle");
+      g_has_exported_handle[i] = false;
+    }
+  }
+}
+
+void tp4_allreduce_out(
+    const at::Tensor& partial,
+    const at::Tensor& workspace,
+    at::Tensor& out,
+    int64_t rank,
+    int64_t channel,
+    int64_t epoch) {
+  TORCH_CHECK(
+      partial.is_xpu() && workspace.is_xpu() && out.is_xpu(),
+      "tp4_allreduce_out: all tensors must be XPU");
+  TORCH_CHECK(
+      partial.scalar_type() == at::kBFloat16 &&
+          out.scalar_type() == at::kBFloat16,
+      "tp4_allreduce_out: partial/out must be bfloat16");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous(),
+      "tp4_allreduce_out: workspace must be contiguous uint8");
+  TORCH_CHECK(
+      partial.is_contiguous() && out.is_contiguous() &&
+          partial.numel() == kHidden && out.numel() == kHidden,
+      "tp4_allreduce_out: exact contiguous [4096] tensors required");
+  TORCH_CHECK(
+      static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "tp4_allreduce_out: workspace too small");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(channel >= 0 && channel < kChannels, "invalid TP4 channel");
+  TORCH_CHECK(epoch > 0 && epoch <= INT32_MAX, "invalid TP4 epoch");
+
+  std::array<uint8_t*, kWorld> bases{};
+  {
+    std::lock_guard<std::mutex> lock(g_registry_mutex);
+    for (int r = 0; r < kWorld; ++r) {
+      TORCH_CHECK(
+          r == rank || g_peer_bases[r] != nullptr,
+          "tp4_allreduce_out: peer registry incomplete for rank ",
+          r);
+      bases[r] = r == rank
+          ? static_cast<uint8_t*>(workspace.data_ptr())
+          : static_cast<uint8_t*>(g_peer_bases[r]);
+    }
+  }
+
+  const int slot = static_cast<int>(epoch % kSlots);
+  const size_t payload_offset =
+      (static_cast<size_t>(channel) * kSlots + slot) * kHidden * sizeof(bf16);
+  const size_t sync_offset =
+      kPayloadBytes +
+      (static_cast<size_t>(channel) * kSlots + slot) *
+          kWorld * sizeof(uint32_t);
+  std::array<bf16*, kWorld> payloads{};
+  std::array<uint32_t*, kWorld> syncs{};
+  for (int r = 0; r < kWorld; ++r) {
+    payloads[r] = reinterpret_cast<bf16*>(bases[r] + payload_offset);
+    syncs[r] = reinterpret_cast<uint32_t*>(bases[r] + sync_offset);
+  }
+
+  const bf16* input = reinterpret_cast<const bf16*>(partial.data_ptr());
+  bf16* output = reinterpret_cast<bf16*>(out.data_ptr());
+  const int local_rank = static_cast<int>(rank);
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto copy_event = q.memcpy(
+      payloads[local_rank], input, kHidden * sizeof(bf16));
+
+  auto ready_event = q.submit([&](sycl::handler& cgh) {
+    cgh.depends_on(copy_event);
+    cgh.single_task<TP4PublishReadyKernel>([=]() SYCL_ESIMD_KERNEL {
+      esimd::simd<uint32_t, 16> offsets(0, sizeof(uint32_t));
+      esimd::simd_mask<16> pred = 0;
+      pred[1] = 1;
+      esimd::simd<uint32_t, 16> value = 1;
+      esimd::fence<
+          esimd::memory_kind::global,
+          esimd::fence_flush_op::clean,
+          esimd::fence_scope::system>();
+#pragma unroll
+      for (int destination = 0; destination < kWorld; ++destination) {
+        // Notify each destination by incrementing the destination's local
+        // arrival counter. B70 does not reliably expose a locally published
+        // mailbox to peer polling, while oneCCL's working small all-reduce
+        // protocol performs remote atomic adds into the polling rank's local
+        // allocation.
+        esimd_exp::lsc_atomic_update<
+            esimd::atomic_op::add,
+            uint32_t,
+            16,
+            esimd_exp::lsc_data_size::default_size,
+            esimd_exp::cache_hint::none,
+            esimd_exp::cache_hint::none>(
+            syncs[destination], offsets, value, pred);
+      }
+    });
+  });
+
+  q.submit([&](sycl::handler& cgh) {
+    cgh.depends_on(ready_event);
+    cgh.parallel_for<TP4ReduceKernel>(
+        sycl::nd_range<1>(16, 16),
+        [=](sycl::nd_item<1> item) SYCL_ESIMD_KERNEL {
+          esimd::simd<uint32_t, 16> offsets(0, sizeof(uint32_t));
+          esimd::simd_mask<16> pred = 0;
+          pred[1] = 1;
+          esimd::simd<uint32_t, 16> status;
+          uint32_t attempts = 0;
+          do {
+            status = esimd_exp::lsc_atomic_update<
+                esimd::atomic_op::load,
+                uint32_t,
+                16,
+                esimd_exp::lsc_data_size::default_size,
+                esimd_exp::cache_hint::none,
+                esimd_exp::cache_hint::none>(
+                syncs[local_rank], offsets, pred);
+            ++attempts;
+          } while (status[1] != kWorld && attempts < 10000);
+
+          constexpr int kElemsPerThread = kHidden / 16;
+          const int tid = static_cast<int>(item.get_global_linear_id());
+          const int elem_offset = tid * kElemsPerThread;
+          if (status[1] == kWorld) {
+            const int owner = elem_offset / (kHidden / kWorld);
+            esimd::simd<bf16, kElemsPerThread> sum =
+                esimd::block_load<bf16, kElemsPerThread>(
+                    payloads[owner] + elem_offset);
+#pragma unroll
+            for (int step = 1; step < kWorld; ++step) {
+              const int r = (owner + step) % kWorld;
+              sum = esimd::block_load<bf16, kElemsPerThread>(
+                        payloads[r] + elem_offset) +
+                    sum;
+            }
+            esimd::block_store<bf16, kElemsPerThread>(
+                output + elem_offset, sum);
+          } else {
+            const float diagnostic = -1000.0f - static_cast<float>(status[1]);
+            esimd::simd<bf16, kElemsPerThread> failed = diagnostic;
+            esimd::block_store<bf16, kElemsPerThread>(
+                output + elem_offset, failed);
+          }
+          esimd::barrier();
+          if (tid == 0 && status[1] == kWorld) {
+            esimd::simd<uint32_t, 16> zero = 0;
+            esimd_exp::lsc_atomic_update<
+                esimd::atomic_op::store,
+                uint32_t,
+                16,
+                esimd_exp::lsc_data_size::default_size,
+                esimd_exp::cache_hint::none,
+                esimd_exp::cache_hint::none>(
+                syncs[local_rank], offsets, zero, pred);
+          }
+        });
+  });
+}
+
+void tp4_oneccl_allreduce_mhc_post_out(
+    const at::Tensor& partial,
+    const at::Tensor& residual,
+    const at::Tensor& post_layer_mix,
+    const at::Tensor& comb_res_mix,
+    at::Tensor& out) {
+  TORCH_CHECK(
+      partial.is_xpu() && residual.is_xpu() && post_layer_mix.is_xpu() &&
+          comb_res_mix.is_xpu() && out.is_xpu(),
+      "tp4_oneccl_allreduce_mhc_post_out: tensors must be XPU");
+  TORCH_CHECK(
+      partial.scalar_type() == at::kBFloat16 &&
+          residual.scalar_type() == at::kBFloat16 &&
+          out.scalar_type() == at::kBFloat16,
+      "tp4_oneccl_allreduce_mhc_post_out: partial/residual/out must be "
+      "bfloat16");
+  TORCH_CHECK(
+      post_layer_mix.scalar_type() == at::kFloat &&
+          comb_res_mix.scalar_type() == at::kFloat,
+      "tp4_oneccl_allreduce_mhc_post_out: mix tensors must be float32");
+  TORCH_CHECK(
+      partial.is_contiguous() && residual.is_contiguous() &&
+          post_layer_mix.is_contiguous() && comb_res_mix.is_contiguous() &&
+          out.is_contiguous(),
+      "tp4_oneccl_allreduce_mhc_post_out: tensors must be contiguous");
+  TORCH_CHECK(
+      partial.numel() == kHidden && residual.numel() == kWorld * kHidden &&
+          post_layer_mix.numel() == kWorld &&
+          comb_res_mix.numel() == kWorld * kWorld &&
+          out.numel() == kWorld * kHidden,
+      "tp4_oneccl_allreduce_mhc_post_out: requires fixed H4096/HC4 tensors");
+
+  using hook_t = int (*)(
+      const void*,
+      const void*,
+      const float*,
+      const float*,
+      void*,
+      size_t,
+      void*);
+  static hook_t hook = []() {
+    dlerror();
+    auto* symbol = dlsym(
+        RTLD_DEFAULT,
+        "ccl_b70_replay_last_bf16_allreduce_mhc_post");
+    TORCH_CHECK(
+        symbol != nullptr,
+        "tp4_oneccl_allreduce_mhc_post_out: custom oneCCL hook is not loaded: ",
+        dlerror());
+    return reinterpret_cast<hook_t>(symbol);
+  }();
+
+  auto& q = vllm::xpu::vllmGetQueue();
+  int status = hook(
+      partial.data_ptr(),
+      residual.data_ptr(),
+      post_layer_mix.data_ptr<float>(),
+      comb_res_mix.data_ptr<float>(),
+      out.data_ptr(),
+      kHidden,
+      static_cast<void*>(&q));
+  TORCH_CHECK(
+      status == 0,
+      "tp4_oneccl_allreduce_mhc_post_out: oneCCL hook failed with status ",
+      status);
+}
+
+void tp4_oneccl_allreduce_mhc_post_pre_out(
+    const at::Tensor& partial,
+    const at::Tensor& residual,
+    const at::Tensor& post_layer_mix,
+    const at::Tensor& comb_res_mix,
+    const at::Tensor& fn,
+    const at::Tensor& hc_scale,
+    const at::Tensor& hc_base,
+    at::Tensor& residual_out,
+    at::Tensor& next_post_mix,
+    at::Tensor& next_comb_mix,
+    at::Tensor& layer_input,
+    double rms_eps,
+    double hc_pre_eps,
+    double hc_sinkhorn_eps,
+    double hc_post_mult_value,
+    int64_t sinkhorn_repeat) {
+  constexpr const char* op = "tp4_oneccl_allreduce_mhc_post_pre_out";
+  TORCH_CHECK(
+      partial.is_xpu() && residual.is_xpu() && post_layer_mix.is_xpu() &&
+          comb_res_mix.is_xpu() && fn.is_xpu() && hc_scale.is_xpu() &&
+          hc_base.is_xpu() && residual_out.is_xpu() &&
+          next_post_mix.is_xpu() && next_comb_mix.is_xpu() &&
+          layer_input.is_xpu(),
+      op, ": tensors must be XPU");
+  TORCH_CHECK(
+      partial.scalar_type() == at::kBFloat16 &&
+          residual.scalar_type() == at::kBFloat16 &&
+          residual_out.scalar_type() == at::kBFloat16 &&
+          layer_input.scalar_type() == at::kBFloat16,
+      op, ": partial/residual/residual_out/layer_input must be bfloat16");
+  TORCH_CHECK(
+      post_layer_mix.scalar_type() == at::kFloat &&
+          comb_res_mix.scalar_type() == at::kFloat &&
+          fn.scalar_type() == at::kFloat && hc_scale.scalar_type() == at::kFloat &&
+          hc_base.scalar_type() == at::kFloat &&
+          next_post_mix.scalar_type() == at::kFloat &&
+          next_comb_mix.scalar_type() == at::kFloat,
+      op, ": projection, mix, scale, base, and next-mix tensors must be float32");
+  TORCH_CHECK(
+      partial.is_contiguous() && residual.is_contiguous() &&
+          post_layer_mix.is_contiguous() && comb_res_mix.is_contiguous() &&
+          fn.is_contiguous() && hc_scale.is_contiguous() && hc_base.is_contiguous() &&
+          residual_out.is_contiguous() && next_post_mix.is_contiguous() &&
+          next_comb_mix.is_contiguous() && layer_input.is_contiguous(),
+      op, ": tensors must be contiguous");
+  TORCH_CHECK(
+      partial.numel() == kHidden && residual.numel() == kWorld * kHidden &&
+          post_layer_mix.numel() == kWorld &&
+          comb_res_mix.numel() == kWorld * kWorld &&
+          fn.numel() == 6 * kWorld * kWorld * kHidden &&
+          hc_scale.numel() == 3 && hc_base.numel() == 6 * kWorld &&
+          residual_out.numel() == kWorld * kHidden &&
+          next_post_mix.numel() == kWorld &&
+          next_comb_mix.numel() == kWorld * kWorld &&
+          layer_input.numel() == kHidden,
+      op, ": requires fixed H4096/HC4 M=1 tensors");
+  TORCH_CHECK(sinkhorn_repeat > 0, op, ": sinkhorn_repeat must be positive");
+
+  using hook_t = int (*)(
+      const void*, const void*, const float*, const float*, void*,
+      const float*, const float*, const float*, float*, float*, void*,
+      float, float, float, float, int, size_t, void*);
+  static hook_t hook = [op]() {
+    dlerror();
+    auto* symbol = dlsym(
+        RTLD_DEFAULT,
+        "ccl_b70_replay_last_bf16_allreduce_mhc_post_pre");
+    TORCH_CHECK(symbol != nullptr, op, ": custom oneCCL hook is not loaded: ",
+                dlerror());
+    return reinterpret_cast<hook_t>(symbol);
+  }();
+
+  auto& q = vllm::xpu::vllmGetQueue();
+  int status = hook(
+      partial.data_ptr(), residual.data_ptr(), post_layer_mix.data_ptr<float>(),
+      comb_res_mix.data_ptr<float>(), residual_out.data_ptr(),
+      fn.data_ptr<float>(), hc_scale.data_ptr<float>(), hc_base.data_ptr<float>(),
+      next_post_mix.data_ptr<float>(), next_comb_mix.data_ptr<float>(),
+      layer_input.data_ptr(), static_cast<float>(rms_eps),
+      static_cast<float>(hc_pre_eps), static_cast<float>(hc_sinkhorn_eps),
+      static_cast<float>(hc_post_mult_value), static_cast<int>(sinkhorn_repeat),
+      kHidden, static_cast<void*>(&q));
+  TORCH_CHECK(status == 0, op, ": oneCCL hook failed with status ", status);
+}
