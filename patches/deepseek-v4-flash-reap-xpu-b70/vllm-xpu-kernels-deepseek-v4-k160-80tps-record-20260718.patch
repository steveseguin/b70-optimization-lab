+            if constexpr (EnableNorm) {
+              sg_sq = local_sq;
+#pragma unroll
+              for (int off = 1; off < MHC_SG_SIZE; off <<= 1)
+                sg_sq += sycl::permute_group_by_xor(sg, sg_sq, off);
+            } else {
+              sg_sq =
+                  sycl::reduce_over_group(sg, local_sq, sycl::plus<float>());
+            }
+            if (tid < MHC_WG_SIZE && lane % MHC_SG_SIZE == 0)
+              slm[(tid / MHC_SG_SIZE) * REDUCE_VALUES] = sg_sq;
+#pragma unroll
+            for (int j = 0; j < BLOCK_N; ++j) {
+              float sg_mix;
+              if constexpr (EnableNorm) {
+                sg_mix = local_mix[j];
+#pragma unroll
+                for (int off = 1; off < MHC_SG_SIZE; off <<= 1)
+                  sg_mix += sycl::permute_group_by_xor(sg, sg_mix, off);
+              } else {
+                sg_mix = sycl::reduce_over_group(
+                    sg, local_mix[j], sycl::plus<float>());
+              }
+              if (tid < MHC_WG_SIZE && lane % MHC_SG_SIZE == 0)
+                slm[(tid / MHC_SG_SIZE) * REDUCE_VALUES + j + 1] = sg_mix;
+            }
+            sycl::group_barrier(item.get_group());
+
+            if (tid == 0) {
+#pragma unroll
+              for (int j = 0; j < REDUCE_VALUES; ++j) {
+                float sum = 0.f;
+#pragma unroll
+                for (int s = 0; s < NUM_MHC_SG; ++s)
+                  sum += slm[s * REDUCE_VALUES + j];
+                slm[j] = sum;
+              }
+              slm[MHC_INV_RMS] =
+                  sycl::native::rsqrt(slm[0] / static_cast<float>(K) + rms_eps);
+            }
+            sycl::group_barrier(item.get_group());
+            if (tid < BLOCK_N) {
+              slm[MIXES + block * BLOCK_N + tid] =
+                  slm[tid + 1] * slm[MHC_INV_RMS];
+            }
+            sycl::group_barrier(item.get_group());
+          }
+
+          if (sg_id == 0) {
+            const int logical_lane = lane % (HC * HC);
+            if (lane < HC) {
+              float pre_logit = slm[MIXES + lane] * hc_scale[0] + hc_base[lane];
+              slm[MIXES + lane] = sigmoid(pre_logit) + hc_pre_eps;
+              float post_logit =
+                  slm[MIXES + HC + lane] * hc_scale[1] + hc_base[HC + lane];
+              post_mix[token * HC + lane] =
+                  sigmoid(post_logit) * hc_post_mult_value;
+            }
+
+            float comb_logit =
+                slm[MIXES + 2 * HC + logical_lane] * hc_scale[2] +
+                hc_base[2 * HC + logical_lane];
+            float row_max = comb_logit;
+#pragma unroll
+            for (int off = 1; off < HC; off <<= 1)
+              row_max = sycl::max(
+                  row_max, sycl::permute_group_by_xor(sg, row_max, off));
+            float comb = sycl::native::exp(comb_logit - row_max);
+            float row_sum = comb;
+#pragma unroll
+            for (int off = 1; off < HC; off <<= 1)
+              row_sum += sycl::permute_group_by_xor(sg, row_sum, off);
+            comb *= sycl::native::recip(row_sum);
+            comb += hc_sinkhorn_eps;
+
+            for (int iteration = 0; iteration < sinkhorn_repeat; ++iteration) {
+              float col_sum = comb;
+#pragma unroll
+              for (int off = HC; off < HC * HC; off <<= 1)
+                col_sum += sycl::permute_group_by_xor(sg, col_sum, off);
+              comb *= sycl::native::recip(col_sum + hc_sinkhorn_eps);
