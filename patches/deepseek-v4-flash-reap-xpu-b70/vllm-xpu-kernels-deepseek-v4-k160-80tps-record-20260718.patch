+void silu_and_mul_clamp_m2_direct(
+    torch::Tensor& output,
+    const torch::Tensor& input,
+    double limit,
+    const torch::Tensor& mapped_rows,
+    int64_t route_lanes) {
+  TORCH_CHECK(input.is_xpu() && output.is_xpu(), "tensors must be on XPU");
+  TORCH_CHECK(input.device() == output.device(), "tensor device mismatch");
+  TORCH_CHECK(
+      input.scalar_type() == torch::kBFloat16 &&
+          output.scalar_type() == torch::kBFloat16,
+      "fixed M2 routed activation currently supports BF16 only");
+  TORCH_CHECK(
+      input.dim() == 2 && input.size(0) == 12 && input.size(1) == 4096,
+      "input must be [12,4096]");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == 12 && output.size(1) == 2048,
+      "output must be [12,2048]");
+  TORCH_CHECK(
+      input.is_contiguous() && output.is_contiguous(),
+      "input and output must be contiguous");
+  TORCH_CHECK(limit > 0.0, "limit must be positive");
+  TORCH_CHECK(
+      mapped_rows.is_xpu() && mapped_rows.device() == input.device() &&
+          mapped_rows.is_contiguous() && mapped_rows.dim() == 2 &&
+          mapped_rows.size(0) == 2 && mapped_rows.size(1) == 6 &&
+          mapped_rows.scalar_type() == torch::kInt32,
+      "mapped_rows must be contiguous int32 [2,6] on the same XPU");
+  TORCH_CHECK(
+      route_lanes == 2 || route_lanes == 4 || route_lanes == 12,
+      "route_lanes must be 2, 4, or 12");
+
+  const at::DeviceGuard device_guard(input.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+  vllm::moe::SiluAndMulClampM2DirectDispatch<scalar_t, int32_t>(
+      reinterpret_cast<scalar_t*>(output.data_ptr()),
+      reinterpret_cast<const scalar_t*>(input.data_ptr()),
+      static_cast<float>(limit),
