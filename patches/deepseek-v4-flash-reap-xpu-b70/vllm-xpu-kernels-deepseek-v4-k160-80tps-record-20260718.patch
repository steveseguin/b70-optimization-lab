+++ b/tests/mhc/tp4_oneccl_replay_probe.py
@@ -0,0 +1,205 @@
+#!/usr/bin/env python3
+"""Validate the experimental direct oneCCL LL256 replay hook on four B70s.
+
+The first ordinary XCCL all-reduce initializes oneCCL's communicator, stream,
+IPC mappings, and ring state.  The candidate then submits the same specialized
+BF16 ring through a narrow C hook, without entering ProcessGroupXCCL again.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import multiprocessing as mp
+import os
+import statistics
+import traceback
+
+
+WORLD = 4
+HIDDEN = 4096
+DEFAULT_CCL = (
+    "/mnt/usb-models/llm-runtime/oneccl-deepseek-b70/lib/libccl.so.1.0"
+)
+
+
+def _worker(
+    rank: int,
+    conn,
+    init_method: str,
+    iterations: int,
+    library: str,
+) -> None:
+    try:
+        os.environ["ZE_AFFINITY_MASK"] = str(rank)
+        os.environ["ONEAPI_DEVICE_SELECTOR"] = "level_zero:*"
+
+        import torch
+        import torch.distributed as dist
+
+        torch.xpu.set_device(0)
+        ccl = ctypes.CDLL(library, mode=ctypes.RTLD_GLOBAL)
+        replay = ccl.ccl_b70_replay_last_bf16_allreduce
+        replay.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]
+        replay.restype = ctypes.c_int
+
+        dist.init_process_group(
+            "xccl", rank=rank, world_size=WORLD, init_method=init_method
+        )
+
+        # This ordinary collective initializes and saves oneCCL's private
+        # communicator/stream.  It is setup, not part of candidate timing.
+        initialization = torch.full(
+            (HIDDEN,), rank + 1, dtype=torch.bfloat16, device="xpu"
+        )
+        dist.all_reduce(initialization)
+        torch.xpu.synchronize()
+        if not torch.equal(
+            initialization,
+            torch.full_like(initialization, sum(range(1, WORLD + 1))),
+        ):
+            raise RuntimeError("initial XCCL all-reduce was incorrect")
+
+        conn.send(("ready", rank))
+        if conn.recv() != "go":
+            raise RuntimeError("invalid parent start signal")
+
+        exact = True
+        max_abs = 0.0
+        candidate_us: list[float] = []
+        reference_us: list[float] = []
+        return_codes: set[int] = set()
+
+        for epoch in range(1, iterations + 1):
+            base = torch.arange(HIDDEN, dtype=torch.float32, device="xpu")
+            partial = (
+                torch.sin(base * (0.00091 * (rank + 1)) + epoch * 0.017)
+                * (rank + 1.25)
+            ).to(torch.bfloat16)
+
+            reference = partial.clone()
+            # A local event completion does not imply that every peer has
+            # reached the next collective.  Align ranks so queue skew is not
+            # incorrectly charged to whichever operation happens to follow.
+            dist.barrier()
+            torch.xpu.synchronize()
+            start = torch.xpu.Event(enable_timing=True)
+            end = torch.xpu.Event(enable_timing=True)
+            start.record()
+            dist.all_reduce(reference)
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                reference_us.append(start.elapsed_time(end) * 1000.0)
+
+            candidate = torch.empty_like(partial)
+            dist.barrier()
+            torch.xpu.synchronize()
+            start = torch.xpu.Event(enable_timing=True)
+            end = torch.xpu.Event(enable_timing=True)
+            start.record()
+            rc = replay(partial.data_ptr(), candidate.data_ptr(), HIDDEN)
+            return_codes.add(rc)
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                candidate_us.append(start.elapsed_time(end) * 1000.0)
+
+            exact = exact and torch.equal(candidate, reference)
+            max_abs = max(
+                max_abs,
+                float(
+                    (candidate.float() - reference.float())
+                    .abs()
+                    .max()
+                    .cpu()
+                ),
+            )
+
+        conn.send(
+            {
+                "rank": rank,
+                "exact": exact,
+                "max_abs": max_abs,
+                "return_codes": sorted(return_codes),
+                "candidate_us_median": statistics.median(candidate_us),
+                "reference_us_median": statistics.median(reference_us),
+                "candidate_us_min": min(candidate_us),
+                "reference_us_min": min(reference_us),
+            }
+        )
+        dist.destroy_process_group()
+    except BaseException:
+        conn.send({"rank": rank, "error": traceback.format_exc()})
+        raise
+    finally:
+        conn.close()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--iterations", type=int, default=40)
+    parser.add_argument("--library", default=DEFAULT_CCL)
+    args = parser.parse_args()
+    if args.iterations <= 6:
+        raise SystemExit("--iterations must exceed the six warm-up epochs")
+
+    ctx = mp.get_context("spawn")
+    parent_conns = []
+    children = []
+    port = 29570 + (os.getpid() % 1000)
+    init_method = f"tcp://127.0.0.1:{port}"
+    for rank in range(WORLD):
+        parent_conn, child_conn = ctx.Pipe(duplex=True)
+        proc = ctx.Process(
+            target=_worker,
+            args=(rank, child_conn, init_method, args.iterations, args.library),
+        )
+        proc.start()
+        child_conn.close()
+        parent_conns.append(parent_conn)
+        children.append(proc)
+
+    try:
+        ready = [conn.recv() for conn in parent_conns]
+        if any(message[0] != "ready" for message in ready):
+            print(json.dumps({"setup": ready}, indent=2))
+            raise SystemExit("worker setup failed")
+        for conn in parent_conns:
+            conn.send("go")
+
+        results = [conn.recv() for conn in parent_conns]
+        print(
+            json.dumps(
+                {
+                    "iterations": args.iterations,
+                    "library": args.library,
+                    "ranks": results,
+                },
+                indent=2,
+            )
+        )
+        if any("error" in row for row in results):
+            raise SystemExit("candidate worker failed")
+        if not all(row["exact"] for row in results):
+            raise SystemExit("candidate is not bitwise-identical to XCCL")
+        if not all(row["return_codes"] == [0] for row in results):
+            raise SystemExit("candidate hook returned a nonzero status")
+    finally:
+        for proc in children:
+            proc.join(timeout=5)
+            if proc.is_alive():
+                proc.terminate()
+                proc.join(timeout=5)
+
+    failed = [proc for proc in children if proc.exitcode != 0]
+    if failed:
+        raise SystemExit(
+            "workers failed: "
+            + ", ".join(f"{proc.pid}:{proc.exitcode}" for proc in failed)
+        )
+
+
+if __name__ == "__main__":
+    main()
