+  TORCH_CHECK(scores.is_contiguous(), "scores must be contiguous");
+  TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+  TORCH_CHECK(topk_weights.is_contiguous(), "weights must be contiguous");
+  TORCH_CHECK(topk_indices.is_contiguous(), "indices must be contiguous");
+  TORCH_CHECK(scores.dim() == 2 && scores.size(0) == 1, "scores must be [1,E]");
