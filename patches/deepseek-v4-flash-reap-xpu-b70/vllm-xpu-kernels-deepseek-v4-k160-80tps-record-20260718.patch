diff --git a/csrc/xpu/sycl/deepseek_m1_biased_topk.cpp b/csrc/xpu/sycl/deepseek_m1_biased_topk.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f8f077a29aa6f1a98a8ab75ac76d3f8914d20bdb
--- /dev/null
+++ b/csrc/xpu/sycl/deepseek_m1_biased_topk.cpp
@@ -0,0 +1,377 @@
+// SPDX-License-Identifier: Apache-2.0
+// Feasibility-only DeepSeek-V4 M=1 biased top-k + gather kernel.
+
+#include <cstdint>
+#include <limits>
+
+#include <sycl/sycl.hpp>
+#include <torch/all.h>
+
+#include "utils.h"
+
+namespace vllm {
+
+template <typename index_t, bool normalize>
+class deepseek_m1_biased_topk_kernel {
+ public:
+  static constexpr int MAX_TOPK = 8;
+  static constexpr int SG_SIZE = 16;
+  static constexpr int MAX_PER_LANE = 16;
+
+  deepseek_m1_biased_topk_kernel(
+      float* __restrict__ topk_weights,
+      index_t* __restrict__ topk_indices,
+      const float* __restrict__ scores,
+      const float* __restrict__ bias,
+      int64_t num_rows,
+      int64_t num_experts,
+      int64_t topk,
+      float routed_scaling_factor)
+      : topk_weights_(topk_weights),
+        topk_indices_(topk_indices),
+        scores_(scores),
+        bias_(bias),
+        num_rows_(num_rows),
+        num_experts_(num_experts),
+        topk_(topk),
+        routed_scaling_factor_(routed_scaling_factor) {}
+
+  [[sycl::reqd_sub_group_size(SG_SIZE)]]
+  void operator()(sycl::nd_item<1> item) const {
+    const int row = item.get_group(0);
+    const int lane = item.get_local_id(0);
+    float* topk_weights = topk_weights_ + row * topk_;
+    index_t* topk_indices = topk_indices_ + row * topk_;
+    const float* scores = scores_ + row * num_experts_;
+    float lane_choice[MAX_PER_LANE];
+    float lane_weight[MAX_PER_LANE];
+    int lane_expert[MAX_PER_LANE];
+    float selected_weight[MAX_TOPK];
+
+#pragma unroll
+    for (int i = 0; i < MAX_PER_LANE; ++i) {
+      const int expert = lane + i * SG_SIZE;
+      lane_expert[i] = expert;
+      if (expert < num_experts_) {
+        const float raw = scores[expert];
+        const float candidate = raw + bias_[expert];
+        // Treat NaN as larger than finite values, matching torch.topk's
+        // observed XPU behavior. The expert id resolves equal ranks.
+        lane_choice[i] =
+            sycl::isnan(candidate)
+            ? std::numeric_limits<float>::infinity()
+            : candidate;
+        lane_weight[i] = raw;
+      } else {
+        lane_choice[i] = -std::numeric_limits<float>::infinity();
+        lane_weight[i] = 0.0f;
+      }
+    }
+
+    auto sg = item.get_sub_group();
+    for (int slot = 0; slot < topk_; ++slot) {
+      float local_best = -std::numeric_limits<float>::infinity();
+      float local_raw = 0.0f;
+      int local_id = std::numeric_limits<int>::max();
+#pragma unroll
+      for (int i = 0; i < MAX_PER_LANE; ++i) {
+        const float candidate = lane_choice[i];
+        const int expert = lane_expert[i];
+        if (candidate > local_best ||
+            (candidate == local_best && expert < local_id)) {
+          local_best = candidate;
+          local_raw = lane_weight[i];
+          local_id = expert;
+        }
+      }
+
+      const float global_best = sycl::reduce_over_group(
+          sg, local_best, sycl::maximum<float>());
+      const int contender = local_best == global_best
+          ? local_id
+          : std::numeric_limits<int>::max();
+      const int winner =
+          sycl::reduce_over_group(sg, contender, sycl::minimum<int>());
+      const int winner_lane = winner & (SG_SIZE - 1);
+      const float winner_raw = sycl::group_broadcast(sg, local_raw, winner_lane);
+      selected_weight[slot] = winner_raw;
+
+      if (lane == 0 && !normalize) {
+        topk_weights[slot] = winner_raw;
+        topk_indices[slot] = static_cast<index_t>(winner);
+      } else if (lane == 0) {
+        topk_indices[slot] = static_cast<index_t>(winner);
+      }
+      if (local_id == winner) {
+#pragma unroll
+        for (int i = 0; i < MAX_PER_LANE; ++i) {
+          if (lane_expert[i] == winner) {
+            lane_choice[i] = -std::numeric_limits<float>::infinity();
+          }
+        }
+      }
+    }
+
+    if constexpr (normalize) {
+      if (lane == 0) {
+        float sum;
+        if (topk_ == 6) {
+          if (num_rows_ <= 2) {
+            // Match the narrow torch.sum XPU reduction tree.
+            volatile float sum01 = selected_weight[0] + selected_weight[1];
+            volatile float sum23 = selected_weight[2] + selected_weight[3];
+            volatile float sum45 = selected_weight[4] + selected_weight[5];
+            volatile float sum0123 = sum01 + sum23;
+            sum = sum0123 + sum45;
+          } else {
+            // The wide [M,6] tensor iterator accumulates its second vector
+            // into the first two lanes before the four-lane horizontal tree.
+            volatile float lane0 = selected_weight[0] + selected_weight[4];
+            volatile float lane1 = selected_weight[1] + selected_weight[5];
+            volatile float half0 = lane0 + lane1;
+            volatile float half1 = selected_weight[2] + selected_weight[3];
+            sum = half0 + half1;
+          }
+        } else {
+          sum = 0.0f;
+#pragma unroll
+          for (int slot = 0; slot < MAX_TOPK; ++slot) {
+            if (slot < topk_) {
+              sum += selected_weight[slot];
+            }
+          }
+        }
+        const float denominator = sycl::fmax(sum, 1.0e-20f);
+        volatile float reciprocal = 1.0f / denominator;
+#pragma unroll
+        for (int slot = 0; slot < MAX_TOPK; ++slot) {
+          if (slot < topk_) {
+            volatile float initial = selected_weight[slot] * reciprocal;
+            volatile float residual = sycl::fma(
+                -initial, denominator, selected_weight[slot]);
+            volatile float quotient =
+                sycl::fma(residual, reciprocal, initial);
+            volatile float scaled = quotient * routed_scaling_factor_;
+            topk_weights[slot] = scaled;
+          }
+        }
+      }
+    }
+  }
+
+ private:
+  float* __restrict__ topk_weights_;
+  index_t* __restrict__ topk_indices_;
+  const float* __restrict__ scores_;
+  const float* __restrict__ bias_;
+  int64_t num_rows_;
+  int64_t num_experts_;
+  int64_t topk_;
+  float routed_scaling_factor_;
+};
+
+template <typename index_t, bool normalize = false>
+void launch_deepseek_m1_biased_topk(
+    sycl::queue& queue,
+    float* topk_weights,
+    index_t* topk_indices,
+    const float* scores,
+    const float* bias,
+    int64_t num_rows,
+    int64_t num_experts,
+    int64_t topk,
+    float routed_scaling_factor = 1.0f) {
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        sycl::nd_range<1>(
+            sycl::range<1>(num_rows * 16), sycl::range<1>(16)),
+        deepseek_m1_biased_topk_kernel<index_t, normalize>(
+            topk_weights,
+            topk_indices,
+            scores,
+            bias,
+            num_rows,
+            num_experts,
+            topk,
+            routed_scaling_factor));
+  });
+}
