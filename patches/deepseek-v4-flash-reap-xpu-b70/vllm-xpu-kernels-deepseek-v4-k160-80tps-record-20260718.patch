+    """Cover the exact DeepSeek V4 small-M block-FP8 arithmetic lane."""
+    seed = 1234
+    torch.manual_seed(seed)
+
+    m, n, k = mnk_factors
+    group_size = 128
+    dtype = torch.bfloat16
+    input = torch.randn((m, k), dtype=dtype, device="xpu") / 10.0
+    weight = torch.randn((n, k), dtype=dtype, device="xpu") / 10.0
+    n_blocks = n // group_size
+    k_blocks = k // group_size
+    exponents = (
+        torch.arange(n_blocks, device="xpu")[:, None]
+        + 2 * torch.arange(k_blocks, device="xpu")[None, :]
+    ) % 7 - 3
+    block_factors = torch.pow(2.0, exponents.to(torch.float32)).to(dtype)
+    weight *= block_factors.repeat_interleave(group_size, 0).repeat_interleave(
+        group_size, 1
+    )
+
+    weight_fp8, weight_scale = fp8_block_quant_2d(
+        weight,
+        group_size,
+        group_size,
+        fp8_dtype=torch.float8_e4m3fn,
+        use_ue8m0=True,
+    )
+    assert torch.unique(weight_scale.view(torch.uint8).cpu()).numel() >= 4
+    weight_deq = fp8_block_dequant_2d(
+        weight_fp8,
+        weight_scale,
+        group_size,
+        group_size,
+        dtype,
+    )
+    output_ref = torch.matmul(input, weight_deq.t())
+
+    output = fp8_gemm_w8a16(
+        input,
+        weight_fp8.t(),
+        weight_scale.t().contiguous(),
+        torch.Tensor(),
+    )
+
+    torch.testing.assert_close(output, output_ref, atol=6e-2, rtol=6e-2)
