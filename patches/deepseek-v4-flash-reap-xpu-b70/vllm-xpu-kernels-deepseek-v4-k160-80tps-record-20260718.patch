+template <class policy, typename TopkId>
+void M2CompactGEMMLauncher(
+    sycl::queue& stream,
+    const bfloat16_t* activations,
+    const uint8_t* weights,
+    const uint8_t* scales,
+    const bfloat16_t* bias,
+    bfloat16_t* outputs,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k) {
+  auto op = XE_DPAS_TT<8, float, bfloat16_t>{};
+  using WGTile = typename policy::WGTile;
+  using SGLayout = typename policy::SGLayout;
+  using MMA = typename TiledMMAHelper<
+      MMA_Atom<decltype(op)>,
+      Layout<WGTile>,
+      SGLayout>::TiledMMA;
+  auto mma = MMA{};
+
+  const int max_threads_per_workgroup = size(mma);
+  constexpr int32_t wg_tile_n =
+      static_cast<int32_t>(get<1>(typename policy::WGTile{}));
+  TORCH_CHECK(
+      gemm_n % wg_tile_n == 0,
+      "fixed-M2 compact grouped GEMM requires N to be divisible by ",
+      wg_tile_n);
