+template <typename T, typename IndexT, int TOPK, int ElemsPerItem>
+class MoeGatherDirectM1 {
+ public:
+  MoeGatherDirectM1(
+      T* output,
+      const T* moe_output,
+      const float* topk_weights,
+      const IndexT* topk_ids,
+      const int* expert_map,
+      const int expert_map_size,
+      const int num_local_experts,
+      const int hidden_size)
+      : output(output),
+        moe_output(moe_output),
+        topk_weights(topk_weights),
+        topk_ids(topk_ids),
+        expert_map(expert_map),
+        expert_map_size(expert_map_size),
+        num_local_experts(num_local_experts),
+        hidden_size(hidden_size) {}
+
+  static constexpr int GroupWorkItem = 256;
+  static constexpr int WARP_SIZE = 32;
+  static constexpr int Stride = GroupWorkItem * ElemsPerItem;
+
+  static inline sycl::nd_range<1> get_nd_range() {
+    sycl::range<1> local(GroupWorkItem);
+    return sycl::nd_range<1>(local, local);
+  }
+
+  void operator()
+      [[sycl::reqd_sub_group_size(WARP_SIZE)]] (sycl::nd_item<1> item) const {
+    const int local_id = item.get_local_id(0);
+    int local_expert[TOPK];
+    float scores[TOPK];
+#pragma unroll
+    for (int slot = 0; slot < TOPK; ++slot) {
+      const int64_t global_expert = static_cast<int64_t>(topk_ids[slot]);
+      int local = -1;
+      if (expert_map == nullptr) {
+        if (global_expert >= 0 && global_expert < num_local_experts) {
+          local = static_cast<int>(global_expert);
+        }
+      } else if (global_expert >= 0 && global_expert < expert_map_size) {
+        local = expert_map[global_expert];
+        if (local < 0 || local >= num_local_experts) {
+          local = -1;
+        }
+      }
+      local_expert[slot] = local;
+      scores[slot] = topk_weights[slot];
+    }
+
+    const int loop_count = (hidden_size + Stride - 1) / Stride;
+    for (int loop = 0; loop < loop_count; ++loop) {
+      const int hidden_idx = loop * Stride + local_id * ElemsPerItem;
+      if (hidden_idx < hidden_size) {
+        float accum[ElemsPerItem];
+#pragma unroll
+        for (int elem = 0; elem < ElemsPerItem; ++elem) {
+          accum[elem] = 0.0f;
+        }
+#pragma unroll
+        for (int slot = 0; slot < TOPK; ++slot) {
+          if (local_expert[slot] == -1) {
+            continue;
+          }
+#pragma unroll
+          for (int elem = 0; elem < ElemsPerItem; ++elem) {
+            accum[elem] +=
+                static_cast<float>(
+                    moe_output[slot * hidden_size + hidden_idx + elem]) *
+                scores[slot];
+          }
+        }
+#pragma unroll
+        for (int elem = 0; elem < ElemsPerItem; ++elem) {
+          output[hidden_idx + elem] = accum[elem];
+        }
+      }
+    }
+  }
+
+ private:
+  T* output;
+  const T* moe_output;
+  const float* topk_weights;
+  const IndexT* topk_ids;
+  const int* expert_map;
+  const int expert_map_size;
+  const int num_local_experts;
+  const int hidden_size;
+};
