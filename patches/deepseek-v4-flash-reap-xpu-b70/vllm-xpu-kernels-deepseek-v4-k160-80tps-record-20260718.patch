+template <bool EnablePost, bool EnableNorm = false, int Tokens = 1>
+void launch_mhc_pre_m1_fused(
+    sycl::queue& q,
+    const bf16* residual,
+    const float* fn,
+    const float* hc_scale,
+    const float* hc_base,
+    float* post_mix,
+    float* comb_mix,
+    bf16* layer_input,
+    float rms_eps,
+    float hc_pre_eps,
+    float hc_sinkhorn_eps,
+    float hc_post_mult_value,
+    int sinkhorn_repeat,
+    const bf16* x = nullptr,
+    const bf16* residual_prev = nullptr,
+    const float* post_layer_mix = nullptr,
+    const float* comb_res_mix = nullptr,
+    bf16* residual_out = nullptr,
+    const bf16* norm_weight = nullptr,
+    float norm_eps = 0.f) {
+  static constexpr int HC = 4;
+  static constexpr int H = 4096;
+  static constexpr int K = HC * H;
+  static constexpr int HC3 = 24;
+  static constexpr int MHC_SG_SIZE = 16;
+  static constexpr int MHC_WG_SIZE = 256;
+  static constexpr int SG_SIZE = EnableNorm ? 32 : MHC_SG_SIZE;
+  static constexpr int WG_SIZE = EnableNorm ? 512 : MHC_WG_SIZE;
+  static constexpr int NUM_MHC_SG = MHC_WG_SIZE / MHC_SG_SIZE;
+  static constexpr int BLOCK_N = 12;
+  static constexpr int REDUCE_VALUES = BLOCK_N + 1;
+  static constexpr int SCRATCH = NUM_MHC_SG * REDUCE_VALUES;
+  static constexpr int MIXES = SCRATCH;
+  static constexpr int MHC_INV_RMS = MIXES + HC3;
+  static constexpr int NORM_INV_RMS = MHC_INV_RMS + 1;
+  static constexpr int VEC1 = 4;
+  static constexpr int VEC2 = 8;
+  using vec_bf16_4 = aligned_vec<bf16, VEC1>;
+  using vec_f32_4 = aligned_vec<float, VEC1>;
+  using vec_bf16_8 = aligned_vec<bf16, VEC2>;
+
+  q.submit([&](sycl::handler& h) {
+    sycl::local_accessor<float, 1> slm(NORM_INV_RMS + 1, h);
+    sycl::local_accessor<vec_bf16_8, 1> raw_slm(EnableNorm ? H / VEC2 : 1, h);
+    h.parallel_for<MhcPreM1Fused<EnablePost, EnableNorm, Tokens>>(
+        sycl::nd_range<1>(
+            sycl::range<1>(WG_SIZE * Tokens), sycl::range<1>(WG_SIZE)),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(SG_SIZE)]] {
+          const int tid = item.get_local_id(0);
+          const int token = item.get_group(0);
+          auto sg = item.get_sub_group();
+          const int sg_id = sg.get_group_id()[0];
+          const int lane = sg.get_local_id()[0];
+
+          if constexpr (EnablePost) {
+            float a_reg[HC][HC];
+            float c_reg[HC];
+#pragma unroll
+            for (int i = 0; i < HC; ++i) {
+#pragma unroll
+              for (int o = 0; o < HC; ++o)
+                a_reg[i][o] = comb_res_mix[(token * HC + i) * HC + o];
+              c_reg[i] = post_layer_mix[token * HC + i];
+            }
+            if (tid < MHC_WG_SIZE)
+              for (int k = tid * VEC2; k < H; k += MHC_WG_SIZE * VEC2) {
+                auto xv =
+                    *reinterpret_cast<const vec_bf16_8*>(x + token * H + k);
+                float acc[HC][VEC2];
+#pragma unroll
+                for (int o = 0; o < HC; ++o)
+#pragma unroll
+                  for (int v = 0; v < VEC2; ++v)
+                    acc[o][v] = c_reg[o] * static_cast<float>(xv.val[v]);
+#pragma unroll
+                for (int i = 0; i < HC; ++i) {
+                  auto rv = *reinterpret_cast<const vec_bf16_8*>(
+                      residual_prev + (token * HC + i) * H + k);
+#pragma unroll
+                  for (int o = 0; o < HC; ++o) {
+                    const float a = a_reg[i][o];
+#pragma unroll
+                    for (int v = 0; v < VEC2; ++v)
+                      acc[o][v] += a * static_cast<float>(rv.val[v]);
+                  }
+                }
+#pragma unroll
+                for (int o = 0; o < HC; ++o) {
+                  vec_bf16_8 out;
+#pragma unroll
+                  for (int v = 0; v < VEC2; ++v)
+                    out.val[v] = static_cast<bf16>(acc[o][v]);
+                  *reinterpret_cast<vec_bf16_8*>(
+                      residual_out + (token * HC + o) * H + k) = out;
+                }
+              }
+            item.barrier(sycl::access::fence_space::global_and_local);
+          }
+
+          const bf16* pre_residual;
+          if constexpr (EnablePost)
+            pre_residual = residual_out + token * HC * H;
+          else
+            pre_residual = residual + token * HC * H;
+
+#pragma unroll
+          for (int block = 0; block < HC3 / BLOCK_N; ++block) {
+            float local_sq = 0.f;
+            float local_mix[BLOCK_N] = {
+                0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
+            if (tid < MHC_WG_SIZE)
+              for (int k = tid * VEC1; k < K; k += MHC_WG_SIZE * VEC1) {
+                auto x = *reinterpret_cast<const vec_bf16_4*>(pre_residual + k);
+                float xf[VEC1];
+#pragma unroll
+                for (int v = 0; v < VEC1; ++v) {
+                  xf[v] = static_cast<float>(x.val[v]);
+                  local_sq += xf[v] * xf[v];
+                }
+#pragma unroll
+                for (int j = 0; j < BLOCK_N; ++j) {
+                  auto f = *reinterpret_cast<const vec_f32_4*>(
+                      fn + (block * BLOCK_N + j) * K + k);
+                  float acc = 0.f;
+#pragma unroll
+                  for (int v = 0; v < VEC1; ++v)
+                    acc += xf[v] * f.val[v];
+                  local_mix[j] += acc;
+                }
+              }
