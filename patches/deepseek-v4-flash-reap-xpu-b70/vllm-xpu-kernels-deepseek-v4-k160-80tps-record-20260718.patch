+class deepseek_dual_rmsnorm_m1_kernel {
+ public:
+  deepseek_dual_rmsnorm_m1_kernel(
+      bf16_t* q_out,
+      bf16_t* kv_out,
+      const bf16_t* q,
+      const bf16_t* kv,
+      const bf16_t* q_weight,
+      const bf16_t* kv_weight,
+      float eps)
+      : q_out_(q_out),
+        kv_out_(kv_out),
+        q_(q),
+        kv_(kv),
+        q_weight_(q_weight),
+        kv_weight_(kv_weight),
+        eps_(eps) {}
+
+  void operator() [[sycl::reqd_sub_group_size(32)]] (
+      sycl::nd_item<2> item) const {
+    const int task = item.get_group(0);
+    const int thread = item.get_local_id(1);
+    const int size = task == 0 ? 1024 : 512;
+    const bf16_t* input = task == 0 ? q_ : kv_;
+    const bf16_t* weight = task == 0 ? q_weight_ : kv_weight_;
+    bf16_t* output = task == 0 ? q_out_ : kv_out_;
+
+    // Match the current Triton BLOCK_SIZE=1024/num_warps=4 reduction
+    // topology: 128 work-items, eight adjacent BF16 values per work-item,
+    // SG32 reduction, then a four-subgroup work-group reduction. Preserving
+    // that order is required for bitwise-identical BF16 output.
+    const int base = thread * 8;
+    float values[8];
+#pragma unroll
+    for (int offset = 0; offset < 8; ++offset) {
+      const int index = base + offset;
+      values[offset] =
+          index < size ? static_cast<float>(input[index]) : 0.0f;
+    }
+    float sum_sq = values[0] * values[0] + values[1] * values[1];
+#pragma unroll
+    for (int offset = 2; offset < 8; ++offset) {
+      sum_sq += values[offset] * values[offset];
+    }
+    sum_sq = sycl::reduce_over_group(
+        sycl::ext::oneapi::this_work_item::get_work_group<2>(),
+        sum_sq,
+        sycl::plus<float>());
+    const float rrms = sycl::rsqrt(sum_sq / static_cast<float>(size) + eps_);
+
+#pragma unroll
+    for (int offset = 0; offset < 8; ++offset) {
+      const int index = base + offset;
+      if (index < size) {
+        const float scale = static_cast<float>(weight[index]);
+        output[index] = static_cast<bf16_t>(values[offset] * rrms * scale);
+      }
+    }
+  }
+
+ private:
+  bf16_t* q_out_;
+  bf16_t* kv_out_;
+  const bf16_t* q_;
+  const bf16_t* kv_;
+  const bf16_t* q_weight_;
+  const bf16_t* kv_weight_;
+  float eps_;
+};
+
+}  // namespace vllm
+
+void deepseek_dual_rmsnorm_out(
+    torch::Tensor& q_out,
+    torch::Tensor& kv_out,
+    const torch::Tensor& q,
+    const torch::Tensor& kv,
+    const torch::Tensor& q_weight,
+    const torch::Tensor& kv_weight,
+    double eps) {
+  TORCH_CHECK(
+      q.scalar_type() == torch::kBFloat16 &&
+          kv.scalar_type() == torch::kBFloat16 &&
+          q_out.scalar_type() == torch::kBFloat16 &&
+          kv_out.scalar_type() == torch::kBFloat16,
+      "deepseek_dual_rmsnorm_out requires BF16 tensors");
+  TORCH_CHECK(
+      q.is_contiguous() && kv.is_contiguous() && q_out.is_contiguous() &&
+          kv_out.is_contiguous() && q_weight.is_contiguous() &&
+          kv_weight.is_contiguous(),
+      "deepseek_dual_rmsnorm_out requires contiguous tensors");
+  TORCH_CHECK(
+      q.numel() == 1024 && kv.numel() == 512 &&
+          q_weight.numel() == 1024 && kv_weight.numel() == 512 &&
+          q_out.numel() == 1024 && kv_out.numel() == 512,
+      "deepseek_dual_rmsnorm_out supports only M=1 Q1024/KV512");
+
+  const at::DeviceGuard device_guard(q.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  auto* q_out_ptr = reinterpret_cast<vllm::bf16_t*>(q_out.data_ptr());
+  auto* kv_out_ptr = reinterpret_cast<vllm::bf16_t*>(kv_out.data_ptr());
+  auto* q_ptr = reinterpret_cast<const vllm::bf16_t*>(q.data_ptr());
+  auto* kv_ptr = reinterpret_cast<const vllm::bf16_t*>(kv.data_ptr());
+  auto* q_weight_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(q_weight.data_ptr());
+  auto* kv_weight_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(kv_weight.data_ptr());
+
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        sycl::nd_range<2>(sycl::range<2>(2, 128), sycl::range<2>(1, 128)),
+        vllm::deepseek_dual_rmsnorm_m1_kernel(
+            q_out_ptr,
+            kv_out_ptr,
+            q_ptr,
+            kv_ptr,
+            q_weight_ptr,
+            kv_weight_ptr,
+            static_cast<float>(eps)));
+  });
+}
