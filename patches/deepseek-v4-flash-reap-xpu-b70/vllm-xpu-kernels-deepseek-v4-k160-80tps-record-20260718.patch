@@ -0,0 +1,378 @@
+#!/usr/bin/env python3
+"""Replay the compact TP4 ring/MHC candidate on real model tensors."""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import multiprocessing as mp
+import os
+import traceback
+from pathlib import Path
+
+
+WORLD = 4
+HIDDEN = 4096
+BOUNDARIES = 85
+DEFAULT_CCL = "/home/steve/src/oneccl-4ceafd1/_build-b70/src/libccl.so.1.0"
+
+
+def _to_xpu(torch, tensor):
+    return tensor.contiguous().to(device="xpu", non_blocking=False)
+
+
+def _load_rank_capture(torch, root: Path, rank: int):
+    rank_dir = root / f"rank{rank}"
+    allreduces = [
+        torch.load(
+            rank_dir / "allreduce" / f"{index:03d}.pt",
+            map_location="cpu",
+            weights_only=False,
+        )
+        for index in range(87)
+    ]
+    mhc = [
+        torch.load(
+            rank_dir / "mhc" / f"{index:03d}.pt",
+            map_location="cpu",
+            weights_only=False,
+        )
+        for index in range(BOUNDARIES)
+    ]
+    final_post = torch.load(
+        rank_dir / "final_post.pt", map_location="cpu", weights_only=False
+    )
+    return allreduces, mhc, final_post
+
+
+def _candidate(torch, inputs, outputs):
+    (
+        partial,
+        residual,
+        post,
+        comb,
+        fn,
+        scale,
+        base,
+        rms_eps,
+        hc_eps,
+        hc_post_alpha,
+        sinkhorn_iters,
+    ) = inputs
+    residual_out, next_post, next_comb, layer_input = outputs
+    torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_pre_out(
+        partial,
+        residual,
+        post,
+        comb,
+        fn,
+        scale,
+        base,
+        residual_out,
+        next_post,
+        next_comb,
+        layer_input,
+        rms_eps,
+        hc_eps,
+        hc_eps,
+        hc_post_alpha,
+        sinkhorn_iters,
+    )
+
+
+def _final_candidate(torch, inputs, output):
+    partial, residual, post, comb = inputs
+    torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_out(
+        partial, residual, post, comb, output
+    )
+
+
+def _build_case(torch, allreduces, mhc, final_post):
+    graph_inputs = []
+    graph_outputs = []
+    expected = []
+    for index, row in enumerate(mhc):
+        tensors = row["tensors"]
+        partial = _to_xpu(torch, allreduces[index + 1]["input_before"])
+        if index == 0:
+            residual = _to_xpu(torch, tensors["residual"])
+            post = _to_xpu(torch, tensors["post"])
+            comb = _to_xpu(torch, tensors["comb"])
+        else:
+            residual, post, comb, _ = graph_outputs[-1]
+        inputs = (
+            partial,
+            residual,
+            post,
+            comb,
+            _to_xpu(torch, tensors["fn"]),
+            _to_xpu(torch, tensors["hc_scale"]),
+            _to_xpu(torch, tensors["hc_base"]),
+            row["rms_eps"],
+            row["hc_eps"],
+            row["hc_post_alpha"],
+            row["sinkhorn_iters"],
+        )
+        if index >= 2 and index % 2 == 0:
+            outputs = graph_outputs[-1]
+        else:
+            outputs = tuple(
+                torch.empty_like(_to_xpu(torch, tensors[name]))
+                for name in (
+                    "residual_out",
+                    "post_out",
+                    "comb_out",
+                    "layer_input",
+                )
+            )
+        graph_inputs.append(inputs)
+        graph_outputs.append(outputs)
+        expected.append(
+            tuple(
+                _to_xpu(torch, tensors[name])
+                for name in (
+                    "residual_out",
+                    "post_out",
+                    "comb_out",
+                    "layer_input",
+                )
+            )
+        )
+
+    final_tensors = final_post["tensors"]
+    final_inputs = (
+        _to_xpu(torch, allreduces[86]["input_before"]),
+        graph_outputs[-1][0],
+        graph_outputs[-1][1],
+        graph_outputs[-1][2],
+    )
+    final_output = torch.empty_like(
+        _to_xpu(torch, final_tensors["residual_out"])
+    )
+    final_expected = _to_xpu(torch, final_tensors["residual_out"])
+    initial_input = _to_xpu(torch, allreduces[0]["input_before"])
+    initial_output = torch.empty_like(initial_input)
+    initial_expected = _to_xpu(torch, allreduces[0]["output_after"])
+    return (
+        graph_inputs,
+        graph_outputs,
+        expected,
+        final_inputs,
+        final_output,
+        final_expected,
+        initial_input,
+        initial_output,
+        initial_expected,
+    )
+
+
+def _execute(torch, dist, case, *, snapshot: bool):
+    (
+        graph_inputs,
+        graph_outputs,
+        _,
+        final_inputs,
+        final_output,
+        _,
+        initial_input,
+        initial_output,
+        _,
+    ) = case
+    initial_output.copy_(initial_input)
+    dist.all_reduce(initial_output)
+    snapshots = []
+    for inputs, outputs in zip(graph_inputs, graph_outputs, strict=True):
+        _candidate(torch, inputs, outputs)
+        if snapshot:
+            snapshots.append(tuple(tensor.clone() for tensor in outputs))
+    _final_candidate(torch, final_inputs, final_output)
+    return snapshots
+
+
+def _compare(torch, case, snapshots=None):
+    (
+        _,
+        graph_outputs,
+        expected,
+        _,
+        final_output,
+        final_expected,
+        _,
+        initial_output,
+        initial_expected,
+    ) = case
+    mismatches = []
+    for index in range(BOUNDARIES):
+        if snapshots is None and index % 2 == 1:
+            continue
+        actual = (
+            snapshots[index] if snapshots is not None else graph_outputs[index]
+        )
+        for output_index, (got, want) in enumerate(
+            zip(actual, expected[index], strict=True)
+        ):
+            count = int((got != want).sum().cpu())
+            if count:
+                mismatches.append(
+                    {
+                        "boundary": index,
+                        "output": output_index,
+                        "mismatches": count,
+                    }
+                )
+    initial_mismatches = int((initial_output != initial_expected).sum().cpu())
+    final_mismatches = int((final_output != final_expected).sum().cpu())
+    return {
+        "mismatches": mismatches,
+        "initial_allreduce_mismatches": initial_mismatches,
+        "final_post_mismatches": final_mismatches,
+        "exact": not mismatches
+        and not initial_mismatches
+        and not final_mismatches,
+    }
+
+
+def _worker(rank, conn, init_method, capture_dir, library, replays):
+    try:
+        os.environ["ZE_AFFINITY_MASK"] = str(rank)
+        os.environ["ONEAPI_DEVICE_SELECTOR"] = "level_zero:*"
+        import torch
+        import torch.distributed as dist
+        import vllm_xpu_kernels._xpu_C  # noqa: F401
+
+        torch.xpu.set_device(0)
+        ctypes.CDLL(library, mode=ctypes.RTLD_GLOBAL)
+        dist.init_process_group(
+            "xccl", rank=rank, world_size=WORLD, init_method=init_method
+        )
+        warm = torch.full(
+            (HIDDEN,), rank + 1, dtype=torch.bfloat16, device="xpu"
+        )
+        dist.all_reduce(warm)
+        torch.xpu.synchronize()
+        allreduces, mhc, final_post = _load_rank_capture(
+            torch, Path(capture_dir), rank
+        )
+        case = _build_case(torch, allreduces, mhc, final_post)
+        torch.xpu.synchronize()
+        conn.send(("ready", rank))
+        if conn.recv() != "go":
+            raise RuntimeError("invalid parent start signal")
+
+        eager_snapshots = _execute(torch, dist, case, snapshot=True)
+        torch.xpu.synchronize()
+        eager = _compare(torch, case, eager_snapshots)
+
+        _execute(torch, dist, case, snapshot=False)
+        torch.xpu.synchronize()
+        # XCCL's scalar barrier takes an invalid SYCL-kernel route when the
+        # forced native-kernel switch is enabled. A same-shape all-reduce is
+        # both a rank rendezvous and preserves the hook's BF16[4096] replay
+        # identity.
+        rendezvous = torch.full(
+            (HIDDEN,), rank + 1, dtype=torch.bfloat16, device="xpu"
+        )
+        dist.all_reduce(rendezvous)
+        torch.xpu.synchronize()
+        graph = torch.xpu.XPUGraph()
+        replay_rows = []
+        try:
+            with torch.xpu.graph(graph):
+                _execute(torch, dist, case, snapshot=False)
+            for replay in range(replays):
+                graph.replay()
+                torch.xpu.synchronize()
+                row = _compare(torch, case)
+                row["replay"] = replay
+                replay_rows.append(row)
+        finally:
+            graph.reset()
+            torch.xpu.synchronize()
+        conn.send(
+            {
+                "rank": rank,
+                "eager": eager,
+                "graph_replays": replay_rows,
+            }
+        )
+        dist.destroy_process_group()
+    except BaseException:
+        conn.send({"rank": rank, "error": traceback.format_exc()})
+        raise
+    finally:
+        conn.close()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("capture_dir")
+    parser.add_argument("--library", default=DEFAULT_CCL)
+    parser.add_argument("--replays", type=int, default=8)
+    args = parser.parse_args()
+    if args.replays < 2:
+        raise SystemExit("--replays must be at least two")
+    ctx = mp.get_context("spawn")
+    port = 31570 + (os.getpid() % 1000)
+    init_method = f"tcp://127.0.0.1:{port}"
+    conns = []
+    children = []
+    for rank in range(WORLD):
+        parent, child = ctx.Pipe(duplex=True)
+        process = ctx.Process(
+            target=_worker,
+            args=(
+                rank,
+                child,
+                init_method,
+                args.capture_dir,
+                args.library,
+                args.replays,
+            ),
+        )
+        process.start()
+        child.close()
+        conns.append(parent)
+        children.append(process)
+    try:
+        ready = [conn.recv() for conn in conns]
+        if any(row[0] != "ready" for row in ready):
+            raise SystemExit(f"worker setup failed: {ready}")
+        for conn in conns:
+            conn.send("go")
+        results = [conn.recv() for conn in conns]
+        payload = {
+            "capture_dir": str(Path(args.capture_dir).resolve()),
+            "library": str(Path(args.library).resolve()),
+            "replays": args.replays,
+            "ranks": results,
+        }
+        print(json.dumps(payload, indent=2, sort_keys=True))
+        if any("error" in row for row in results):
+            raise SystemExit("candidate worker failed")
+        if not all(row["eager"]["exact"] for row in results):
+            raise SystemExit("real-capture eager candidate is not exact")
+        if not all(
+            replay["exact"]
+            for row in results
+            for replay in row["graph_replays"]
+        ):
+            raise SystemExit("real-capture graph replay is not exact")
+    finally:
+        for process in children:
+            process.join(timeout=10)
+            if process.is_alive():
+                process.terminate()
+                process.join(timeout=5)
+    failed = [process for process in children if process.exitcode != 0]
+    if failed:
+        raise SystemExit(
+            "workers failed: "
+            + ", ".join(
+                f"{process.pid}:{process.exitcode}" for process in failed
+            )
+        )
+
+
+if __name__ == "__main__":
+    main()
