+void moe_gather_direct_m1(
+    torch::Tensor& output,
+    const torch::Tensor& moe_output,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& topk_ids,
+    const c10::optional<torch::Tensor>& expert_map,
+    int64_t num_local_experts) {
+  TORCH_CHECK(output.device().is_xpu(), "output must be on XPU");
+  TORCH_CHECK(output.size(0) == 1, "direct gather requires M=1");
+  TORCH_CHECK(
+      topk_weights.dim() == 2 && topk_weights.size(0) == 1 &&
+          topk_weights.size(1) == 6,
+      "direct gather requires weights [1,6]");
+  TORCH_CHECK(topk_ids.sizes() == topk_weights.sizes(), "topk shape mismatch");
+  TORCH_CHECK(
+      moe_output.dim() == 2 && moe_output.size(0) == 6 &&
+          moe_output.size(1) == output.size(1),
+      "moe_output must be [6,H]");
+  TORCH_CHECK(
+      output.scalar_type() == moe_output.scalar_type(),
+      "output dtype mismatch");
+  TORCH_CHECK(
+      output.scalar_type() == torch::kBFloat16,
+      "direct M1 gather currently supports BF16 only");
+  TORCH_CHECK(
+      topk_weights.scalar_type() == torch::kFloat32,
+      "topk_weights must be FP32");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == torch::kInt32 ||
+          topk_ids.scalar_type() == torch::kInt64,
+      "topk_ids must be int32 or int64");
+  TORCH_CHECK(
+      num_local_experts > 0 && num_local_experts <= INT_MAX,
+      "num_local_experts must be a positive int32 value");
+  TORCH_CHECK(
+      output.is_contiguous() && moe_output.is_contiguous() &&
+          topk_weights.is_contiguous() && topk_ids.is_contiguous(),
+      "direct gather tensors must be contiguous");
+  TORCH_CHECK(
+      moe_output.device() == output.device() &&
+          topk_weights.device() == output.device() &&
+          topk_ids.device() == output.device(),
+      "direct gather tensors must share one XPU device");
+  int expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->device() == output.device(), "expert_map device mismatch");
+    TORCH_CHECK(
+        expert_map->scalar_type() == torch::kInt32, "expert_map must be int32");
+    TORCH_CHECK(expert_map->is_contiguous(), "expert_map must be contiguous");
+    TORCH_CHECK(expert_map->dim() == 1, "expert_map must be one-dimensional");
+    TORCH_CHECK(
+        expert_map->numel() <= INT_MAX, "expert_map length must fit int32");
