--- /dev/null
+++ b/csrc/xpu/mhc/xe_2/graph_launch.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include "cutlass/cutlass.h"
+
+namespace vllm::xpu::mhc {
+
+// CUTLASS's generic SYCL device_kernel wrapper unconditionally queries the
+// oneAPI work-group scratch-memory extension.  That extension is unsupported
+// inside command graphs, even when a kernel requests zero bytes.  Keep the MHC
+// launch ABI, but pass either no scratch or an ordinary local_accessor supplied
+// by compat::experimental::local_mem_size.
+template <typename Operator>
+CUTLASS_DEVICE void graph_kernel_no_scratch(
+    const typename Operator::Params& params) {
+  Operator{}(params, nullptr);
+}
+
+template <typename Operator>
+CUTLASS_DEVICE void graph_kernel_local(
+    const typename Operator::Params& params,
+    char* scratch) {
+  Operator{}(params, scratch);
+}
+
+}  // namespace vllm::xpu::mhc
