 #include "topk_topp_sampler_kernels.hpp"
 
+std::tuple<torch::Tensor, torch::Tensor, torch::Tensor>
+greedy_rejection_from_target_tokens(
+    const torch::Tensor& target_tokens,
+    const torch::Tensor& draft_sampled,
+    const torch::Tensor& cu_num_logits,
+    const int64_t num_speculative_steps) {
+  TORCH_CHECK(target_tokens.is_xpu(), "target_tokens must be on XPU");
+  TORCH_CHECK(draft_sampled.is_xpu(), "draft_sampled must be on XPU");
+  TORCH_CHECK(cu_num_logits.is_xpu(), "cu_num_logits must be on XPU");
+  TORCH_CHECK(
+      target_tokens.dtype() == torch::kInt64,
+      "target_tokens must be int64");
+  TORCH_CHECK(
+      draft_sampled.dtype() == torch::kInt32 ||
+          draft_sampled.dtype() == torch::kInt64,
+      "draft_sampled must be int32 or int64");
+  TORCH_CHECK(
+      cu_num_logits.dtype() == torch::kInt32,
+      "cu_num_logits must be int32");
+  TORCH_CHECK(target_tokens.is_contiguous(), "target_tokens must be contiguous");
+  TORCH_CHECK(draft_sampled.is_contiguous(), "draft_sampled must be contiguous");
+  TORCH_CHECK(cu_num_logits.is_contiguous(), "cu_num_logits must be contiguous");
+  TORCH_CHECK(num_speculative_steps > 0, "num_speculative_steps must be positive");
+
+  const int64_t num_reqs = cu_num_logits.numel() - 1;
+  auto sampled = torch::empty(
+      {num_reqs, num_speculative_steps + 1}, target_tokens.options());
+  auto int_options = target_tokens.options().dtype(torch::kInt32);
+  auto num_sampled = torch::empty({num_reqs}, int_options);
+  auto num_rejected = torch::empty({num_reqs}, int_options);
+
+  auto& queue = vllm::xpu::vllmGetQueue();
+#define LAUNCH_GREEDY_REJECTION(DRAFT_TYPE)                               \
+  queue.submit([&](sycl::handler& cgh) {                                  \
+    TopkToppSamplerImpl::greedy_rejection_from_target_tokens_kernel<      \
+        DRAFT_TYPE>                                                       \
+        task{sampled.data_ptr<int64_t>(),                                 \
+             num_sampled.data_ptr<int32_t>(),                             \
+             num_rejected.data_ptr<int32_t>(),                            \
+             target_tokens.data_ptr<int64_t>(),                           \
+             draft_sampled.data_ptr<DRAFT_TYPE>(),                        \
+             cu_num_logits.data_ptr<int32_t>(),                           \
+             sampled.stride(0)};                                          \
+    cgh.parallel_for(sycl::range<1>(num_reqs), task);                     \
+  })
+  if (draft_sampled.dtype() == torch::kInt32) {
+    LAUNCH_GREEDY_REJECTION(int32_t);
+  } else {
+    LAUNCH_GREEDY_REJECTION(int64_t);
+  }
+#undef LAUNCH_GREEDY_REJECTION
+  return {sampled, num_sampled, num_rejected};
+}
