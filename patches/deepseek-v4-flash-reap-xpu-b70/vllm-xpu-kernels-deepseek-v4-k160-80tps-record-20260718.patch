+#!/usr/bin/env python3
+"""Gate TP4 oneCCL ring + DeepSeek MHC post/pre fusion on changed inputs."""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import multiprocessing as mp
+import os
+import statistics
+import traceback
+
+
+WORLD = 4
+HIDDEN = 4096
+HC = 4
+HC3 = 24
+DEFAULT_CCL = "/mnt/usb-models/llm-runtime/oneccl-deepseek-b70/lib/libccl.so.1.0"
+
+
+def _inputs(torch, rank: int, epoch: int):
+    h = torch.arange(HIDDEN, dtype=torch.float32, device="xpu")
+    k = torch.arange(HC * HIDDEN, dtype=torch.float32, device="xpu")
+    partial = (
+        torch.sin(h * (0.00091 * (rank + 1)) + epoch * 0.017) * (rank + 1.25)
+    ).to(torch.bfloat16)
+    residual = torch.stack(
+        [
+            torch.cos(h * (0.00037 * (i + 1)) + epoch * 0.011)
+            .mul_(i + 0.75)
+            .to(torch.bfloat16)
+            for i in range(HC)
+        ]
+    )
+    post = torch.tensor(
+        [0.25, -0.5, 0.75, 1.125], dtype=torch.float32, device="xpu"
+    ).add_(epoch * 0.0001)
+    comb = (
+        torch.arange(HC * HC, dtype=torch.float32, device="xpu")
+        .reshape(HC, HC)
+        .mul_(0.017)
+        .sub_(0.11)
+        .add_(epoch * 0.00003)
+    )
+    fn = torch.stack(
+        [
+            torch.sin(k * (0.000013 * (j + 1)) + j * 0.071)
+            .mul_(0.00035)
+            .add_(torch.cos(k * 0.000009 + j * 0.019) * 0.00015)
+            for j in range(HC3)
+        ]
+    )
+    scale = torch.tensor([0.7, 0.8, 0.9], dtype=torch.float32, device="xpu")
+    base = torch.linspace(-0.12, 0.13, HC3, dtype=torch.float32, device="xpu")
+    return partial, residual, post, comb, fn, scale, base
+
+
+def _reference(torch, partial, residual, post, comb, fn, scale, base):
+    reduced = partial.clone()
+    torch.distributed.all_reduce(reduced)
+    residual_out = torch.ops._xpu_C.mhc_post(
+        reduced.unsqueeze(0),
+        residual.reshape(1, HC, HIDDEN),
+        post.reshape(1, HC, 1),
+        comb.reshape(1, HC, HC),
+    )
+    next_post, next_comb, layer_input = torch.ops._xpu_C.mhc_pre(
+        residual_out, fn, scale, base, 1e-6, 1e-3, 1e-3, 1.0, 20
+    )
+    return residual_out.squeeze(0), next_post, next_comb, layer_input
+
+
+def _fused_reference(torch, partial, residual, post, comb, fn, scale, base):
+    reduced = partial.clone()
+    torch.distributed.all_reduce(reduced)
+    outputs = (
+        torch.empty_like(residual),
+        torch.empty((1, HC, 1), dtype=torch.float32, device="xpu"),
+        torch.empty((1, HC, HC), dtype=torch.float32, device="xpu"),
+        torch.empty((1, HIDDEN), dtype=torch.bfloat16, device="xpu"),
+    )
+    torch.ops._xpu_C.mhc_post_pre_m1_out(
+        reduced.view(1, HIDDEN),
+        residual.view(1, HC, HIDDEN),
+        post,
+        comb,
+        fn,
+        scale,
+        base,
+        outputs[0].view(1, HC, HIDDEN),
+        outputs[1],
+        outputs[2],
+        outputs[3],
+        1e-6,
+        1e-3,
+        1e-3,
+        1.0,
+        20,
+    )
+    return outputs
+
+
+def _candidate(torch, inputs, outputs):
+    partial, residual, post, comb, fn, scale, base = inputs
+    residual_out, next_post, next_comb, layer_input = outputs
+    torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_pre_out(
+        partial, residual, post, comb, fn, scale, base, residual_out,
+        next_post, next_comb, layer_input, 1e-6, 1e-3, 1e-3, 1.0, 20
+    )
+
+
+def _post_candidate(torch, inputs, output):
+    partial, residual, post, comb, *_ = inputs
+    torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_out(
+        partial, residual, post, comb, output
+    )
+
+
+def _post_reference(torch, inputs):
+    partial, residual, post, comb, *_ = inputs
+    reduced = partial.clone()
+    torch.distributed.all_reduce(reduced)
+    return torch.ops._xpu_C.mhc_post(
+        reduced.unsqueeze(0),
+        residual.reshape(1, HC, HIDDEN),
+        post.reshape(1, HC, 1),
+        comb.reshape(1, HC, HC),
+    ).squeeze(0)
+
+
+def _produce_partial(torch, source, out, rank: int, boundary: int):
+    scale = 0.75 + 0.03125 * (rank + 1) + 0.0005 * boundary
+    torch.mul(source.reshape(-1), scale, out=out)
+
+
+def _worker(
+    rank,
+    conn,
+    init_method: str,
+    iterations: int,
+    library: str,
+    skip_graph: bool,
+    fused_reference: bool,
+    graph_boundaries: int,
+    graph_recurrent: bool,
+    graph_final_post: bool,
+    graph_initial_allreduce: bool,
+    graph_layer_alias: bool,
+    graph_replays: int,
+    graph_skew_elements: int,
+    graph_dependent_partials: bool,
+) -> None:
+    try:
+        os.environ["ZE_AFFINITY_MASK"] = str(rank)
+        os.environ["ONEAPI_DEVICE_SELECTOR"] = "level_zero:*"
+        import torch
+        import torch.distributed as dist
+        import vllm_xpu_kernels._xpu_C  # noqa: F401
+
+        torch.xpu.set_device(0)
+        ctypes.CDLL(library, mode=ctypes.RTLD_GLOBAL)
+        dist.init_process_group("xccl", rank=rank, world_size=WORLD, init_method=init_method)
+        warm = torch.full((HIDDEN,), rank + 1, dtype=torch.bfloat16, device="xpu")
+        dist.all_reduce(warm)
+        torch.xpu.synchronize()
+        conn.send(("ready", rank))
+        if conn.recv() != "go":
+            raise RuntimeError("invalid parent start signal")
+
+        exact = [True, True, True, True]
+        mismatches = [0, 0, 0, 0]
+        candidate_us = []
+        reference_us = []
+        for epoch in range(1, iterations + 1):
+            inputs = _inputs(torch, rank, epoch)
+            dist.barrier()
+            torch.xpu.synchronize()
+            start = torch.xpu.Event(enable_timing=True)
+            end = torch.xpu.Event(enable_timing=True)
+            start.record()
+            reference = (
+                _fused_reference(torch, *inputs)
+                if fused_reference
+                else _reference(torch, *inputs)
+            )
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                reference_us.append(start.elapsed_time(end) * 1000.0)
+
+            outputs = (
+                torch.empty_like(inputs[1]),
+                torch.empty((1, HC, 1), dtype=torch.float32, device="xpu"),
+                torch.empty((1, HC, HC), dtype=torch.float32, device="xpu"),
+                torch.empty((1, HIDDEN), dtype=torch.bfloat16, device="xpu"),
+            )
+            dist.barrier()
+            torch.xpu.synchronize()
+            start = torch.xpu.Event(enable_timing=True)
+            end = torch.xpu.Event(enable_timing=True)
+            start.record()
+            _candidate(torch, inputs, outputs)
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                candidate_us.append(start.elapsed_time(end) * 1000.0)
+            for i, (actual, expected) in enumerate(zip(outputs, reference)):
+                equal = torch.equal(actual, expected)
+                exact[i] &= equal
+                mismatches[i] += int((actual != expected).sum().cpu())
+
+        changed = [True] * 4
+        graph_exact = [True] * 4
+        final_post_changed = None
+        final_post_exact = None
+        initial_allreduce_changed = None
+        initial_allreduce_exact = None
+        if not skip_graph:
+            skew = None
+            if graph_skew_elements:
+                skew = torch.zeros(
+                    graph_skew_elements * (rank + 1),
+                    dtype=torch.float32,
+                    device="xpu",
+                )
+            initial_input = torch.full(
+                (HIDDEN,), rank + 0.25, dtype=torch.bfloat16, device="xpu"
+            )
+            initial_output = torch.empty_like(initial_input)
+            graph_inputs = []
+            graph_outputs = []
+            for index in range(graph_boundaries):
+                inputs = _inputs(torch, rank, 301 + index)
+                if (graph_recurrent or graph_layer_alias) and graph_outputs:
+                    previous = graph_outputs[-1]
+                    inputs = (
+                        inputs[0],
+                        previous[0],
+                        previous[1],
+                        previous[2],
+                        inputs[4],
+                        inputs[5],
+                        inputs[6],
+                    )
+                if graph_layer_alias and index > 0 and index % 2 == 0:
+                    outputs = graph_outputs[-1]
+                else:
+                    outputs = (
+                        torch.empty_like(inputs[1]),
+                        torch.empty(
+                            (1, HC, 1), dtype=torch.float32, device="xpu"
+                        ),
+                        torch.empty(
+                            (1, HC, HC), dtype=torch.float32, device="xpu"
+                        ),
+                        torch.empty(
+                            (1, HIDDEN), dtype=torch.bfloat16, device="xpu"
+                        ),
+                    )
+                graph_inputs.append(inputs)
+                graph_outputs.append(outputs)
+            final_post_input = _inputs(torch, rank, 401)
+            if graph_recurrent or graph_layer_alias:
+                previous = graph_outputs[-1]
+                final_post_input = (
+                    final_post_input[0],
+                    previous[0],
+                    previous[1],
+                    previous[2],
+                    final_post_input[4],
+                    final_post_input[5],
+                    final_post_input[6],
+                )
+            final_post_output = torch.empty_like(final_post_input[1])
+            for index, (inputs, outputs) in enumerate(
+                zip(graph_inputs, graph_outputs, strict=True)
+            ):
+                if skew is not None:
+                    skew.add_(1.0)
+                if graph_dependent_partials and index > 0:
+                    _produce_partial(
+                        torch, graph_outputs[index - 1][3], inputs[0], rank, index
+                    )
+                _candidate(torch, inputs, outputs)
+            if graph_final_post:
+                _post_candidate(torch, final_post_input, final_post_output)
+            if graph_initial_allreduce:
+                initial_output.copy_(initial_input)
+                dist.all_reduce(initial_output)
+            torch.xpu.synchronize()
+            dist.barrier()
+            graph = torch.xpu.XPUGraph()
+            try:
+                with torch.xpu.graph(graph):
+                    if graph_initial_allreduce:
+                        initial_output.copy_(initial_input)
+                        dist.all_reduce(initial_output)
+                    for index, (inputs, outputs) in enumerate(
+                        zip(graph_inputs, graph_outputs, strict=True)
+                    ):
+                        if skew is not None:
+                            skew.add_(1.0)
+                        if graph_dependent_partials and index > 0:
+                            _produce_partial(
+                                torch,
+                                graph_outputs[index - 1][3],
+                                inputs[0],
+                                rank,
+                                index,
+                            )
+                        _candidate(torch, inputs, outputs)
+                    if graph_final_post:
+                        _post_candidate(torch, final_post_input, final_post_output)
+                graph.replay()
+                torch.xpu.synchronize()
+                before = [
+                    tuple(tensor.clone() for tensor in outputs)
+                    for outputs in graph_outputs
+                ]
+                final_post_before = final_post_output.clone()
+                initial_allreduce_before = initial_output.clone()
+                initial_input.add_(0.5)
+                for index, inputs in enumerate(graph_inputs):
+                    if not graph_dependent_partials or index == 0:
+                        inputs[0].add_(0.25)
+                    if not (graph_recurrent or graph_layer_alias) or index == 0:
+                        inputs[1].add_(0.125)
+                        inputs[2].add_(0.03125)
+                        inputs[3].sub_(0.015625)
+                    inputs[4].mul_(0.9921875)
+                    inputs[5].add_(0.125)
+                    inputs[6].add_(0.25)
+                final_post_input[0].add_(0.25)
+                if not (graph_recurrent or graph_layer_alias):
+                    final_post_input[1].add_(0.125)
+                    final_post_input[2].add_(0.03125)
+                    final_post_input[3].sub_(0.015625)
+                torch.xpu.synchronize()
+                graph.replay()
+                torch.xpu.synchronize()
