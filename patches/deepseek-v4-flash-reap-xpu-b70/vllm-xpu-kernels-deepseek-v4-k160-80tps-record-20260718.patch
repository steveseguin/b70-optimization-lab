+        quant_dtype=fp8_dtype,
+        clamp_limit=limit,
+    )
+
+    torch.testing.assert_close(fused_scales, separate_scales, rtol=0, atol=0)
+    torch.testing.assert_close(
+        fused_out.float(), separate_out.float(), rtol=0, atol=0
+    )
