+template <typename T, typename IndexT>
+void MoeGatherDirectM1Launcher(
+    T* output,
+    const T* moe_output,
+    const float* topk_weights,
+    const IndexT* topk_ids,
+    const int* expert_map,
+    const int expert_map_size,
+    const int num_local_experts,
+    const int topk,
+    const int hidden_size,
+    sycl::queue& queue) {
+  int elems_per_item = sizeof(float) * 4 / sizeof(T);
+  while (hidden_size % elems_per_item != 0) {
+    elems_per_item /= 2;
+  }
+
+#define LAUNCH_DIRECT_M1(TOPK, ElemsPerItem)                              \
+  queue.submit([&](sycl::handler& cgh) {                                  \
+    cgh.parallel_for(                                                     \
+        MoeGatherDirectM1<T, IndexT, TOPK, ElemsPerItem>::get_nd_range(), \
+        MoeGatherDirectM1<T, IndexT, TOPK, ElemsPerItem>{                 \
+            output,                                                       \
+            moe_output,                                                   \
+            topk_weights,                                                 \
+            topk_ids,                                                     \
+            expert_map,                                                   \
+            expert_map_size,                                              \
+            num_local_experts,                                            \
+            hidden_size});                                                \
+  });
+
+#define CASE_DIRECT_ELEMS(ElemsPerItem)                         \
+  case ElemsPerItem:                                            \
+    TORCH_CHECK(topk == 6, "direct M1 gather requires topk=6"); \
+    LAUNCH_DIRECT_M1(6, ElemsPerItem);                          \
+    break;
+
+  switch (elems_per_item) {
+    CASE_DIRECT_ELEMS(1)
+    CASE_DIRECT_ELEMS(2)
+    CASE_DIRECT_ELEMS(4)
+    CASE_DIRECT_ELEMS(8)
+    default:
+      TORCH_CHECK(false, "unsupported direct M1 elems_per_item");
+  }
+#undef CASE_DIRECT_ELEMS
+#undef LAUNCH_DIRECT_M1
+}
