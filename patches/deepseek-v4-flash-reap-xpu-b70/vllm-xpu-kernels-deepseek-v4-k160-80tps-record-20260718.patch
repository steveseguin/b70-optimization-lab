+// Fixed M=2/top-k-6 route-direct remap. The generic path launches a zero,
+// route-count, and remap sequence because it supports arbitrary M and expert
+// counts. Here all twelve route slots fit in one workgroup, so every work-item
+// can derive the expert-grouped destination row directly from topk_ids and the
+// EP map while cooperatively copying the two source rows.
+template <typename TA, typename IndexT>
+class RemapHiddenStatesM2Direct {
+ public:
+  RemapHiddenStatesM2Direct(
+      sycl::local_accessor<int, 1> mapped_rows,
+      const TA* hidden_states,
+      TA* remapped_hidden_states,
+      int* unpermuted_row_to_permuted_row,
+      const IndexT* topk_ids,
+      const int* expert_map,
+      const int expert_map_size,
+      const int local_experts_num,
+      const int hidden_size)
+      : mapped_rows(mapped_rows),
+        hidden_states(hidden_states),
+        remapped_hidden_states(remapped_hidden_states),
+        unpermuted_row_to_permuted_row(unpermuted_row_to_permuted_row),
+        topk_ids(topk_ids),
+        expert_map(expert_map),
+        expert_map_size(expert_map_size),
+        local_experts_num(local_experts_num),
+        hidden_size(hidden_size) {}
+
+  static constexpr int GroupWorkItem = 256;
+  static constexpr int TopK = 6;
+  static constexpr int RouteCount = 2 * TopK;
+  static constexpr int ElemsPerItem = 8;
+
+  static sycl::nd_range<1> get_nd_range() {
+    sycl::range<1> local(GroupWorkItem);
+    sycl::range<1> group(2);
+    return sycl::nd_range<1>(local * group, local);
+  }
+
+  int map_local_expert(const int slot) const {
+    const int64_t global_expert = static_cast<int64_t>(topk_ids[slot]);
+    if (expert_map == nullptr) {
+      if (global_expert < 0 || global_expert >= local_experts_num) return -1;
+      return static_cast<int>(global_expert);
+    }
+    if (global_expert < 0 || global_expert >= expert_map_size) return -1;
+    const int local_expert = expert_map[global_expert];
+    if (local_expert < 0 || local_expert >= local_experts_num) return -1;
+    return local_expert;
+  }
+
+  int mapped_row(const int slot) const {
+    const int local_expert = map_local_expert(slot);
+    if (local_expert < 0) return -1;
+    int rows_before_expert = 0;
+    int occurrences_before_slot = 0;
+#pragma unroll
+    for (int other = 0; other < RouteCount; ++other) {
+      const int mapped = map_local_expert(other);
+      if (mapped >= 0 && mapped < local_expert) ++rows_before_expert;
+      if (other < slot && mapped == local_expert) ++occurrences_before_slot;
+    }
+    return rows_before_expert + occurrences_before_slot;
+  }
+
+  void operator()
+      [[sycl::reqd_sub_group_size(32)]] (sycl::nd_item<1> item) const {
+    const int local_id = item.get_local_id(0);
+    const int source_row = item.get_group(0);
+    if (local_id < RouteCount) {
+      const int destination_row = mapped_row(local_id);
+      mapped_rows[local_id] = destination_row;
+      if (source_row == 0) {
+        unpermuted_row_to_permuted_row[local_id] = destination_row;
+      }
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+    bool has_local_route = false;
+#pragma unroll
+    for (int route = 0; route < TopK; ++route) {
+      if (mapped_rows[source_row * TopK + route] >= 0) {
+        has_local_route = true;
+      }
+    }
+    if (!has_local_route) return;
+    const int vectors_per_row = hidden_size / ElemsPerItem;
+    using Vec = sycl::vec<TA, ElemsPerItem>;
+    for (int vector_index = local_id; vector_index < vectors_per_row;
+         vector_index += GroupWorkItem) {
+      const Vec value = *reinterpret_cast<const Vec*>(
+          hidden_states + static_cast<int64_t>(source_row) * hidden_size +
+          vector_index * ElemsPerItem);
+#pragma unroll
+      for (int route = 0; route < TopK; ++route) {
+        const int slot = source_row * TopK + route;
+        const int destination_row = mapped_rows[slot];
+        if (destination_row < 0) continue;
+        *reinterpret_cast<Vec*>(
+            remapped_hidden_states +
+            static_cast<int64_t>(destination_row) * hidden_size +
+            vector_index * ElemsPerItem) = value;
+      }
+    }
+  }
+
+ private:
+  sycl::local_accessor<int, 1> mapped_rows;
+  const TA* hidden_states;
+  TA* remapped_hidden_states;
+  int* unpermuted_row_to_permuted_row;
+  const IndexT* topk_ids;
+  const int* expert_map;
+  const int expert_map_size;
+  const int local_experts_num;
+  const int hidden_size;
+};
+
+template <typename TA, typename IndexT>
+void RemapHiddenStatesM2DirectLauncher(
+    const TA* hidden_states,
+    TA* remapped_hidden_states,
+    int* unpermuted_row_to_permuted_row,
+    const IndexT* topk_ids,
+    const int* expert_map,
+    const int expert_map_size,
+    const int local_experts_num,
+    const int hidden_size,
+    sycl::queue& queue) {
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<int, 1> mapped_rows(
+        sycl::range<1>(RemapHiddenStatesM2Direct<TA, IndexT>::RouteCount), cgh);
+    cgh.parallel_for(
+        RemapHiddenStatesM2Direct<TA, IndexT>::get_nd_range(),
+        RemapHiddenStatesM2Direct<TA, IndexT>{
+            mapped_rows,
+            hidden_states,
+            remapped_hidden_states,
+            unpermuted_row_to_permuted_row,
+            topk_ids,
+            expert_map,
+            expert_map_size,
+            local_experts_num,
+            hidden_size});
+  });
+}
+
+// Route-aware fixed-M2 clamped SwiGLU. The generic activation launches one
+// workgroup for every padded route row, including rows owned by remote EP
+// ranks. Four workgroups cover the twelve route slots sequentially and skip
+// remote routes before touching the padded GEMM buffers.
+template <typename TA, typename IndexT, int RouteLanes>
+class SiluAndMulClampM2Direct {
+ public:
+  SiluAndMulClampM2Direct(
+      TA* output,
+      const TA* input,
+      const float limit,
+      const int* mapped_rows,
+      const int d)
+      : output(output),
+        input(input),
+        limit(limit),
+        mapped_rows(mapped_rows),
+        d(d) {}
+
+  static constexpr int GroupWorkItem = 256;
+  static constexpr int TopK = 6;
+  static constexpr int RouteCount = 2 * TopK;
+  static constexpr int ElemsPerItem = 8;
+
+  static sycl::nd_range<1> get_nd_range() {
+    sycl::range<1> local(GroupWorkItem);
+    sycl::range<1> groups(RouteLanes);
+    return sycl::nd_range<1>(local * groups, local);
+  }
+
+  void operator()
+      [[sycl::reqd_sub_group_size(32)]] (sycl::nd_item<1> item) const {
+    const int route_lane = item.get_group(0);
+    const int local_id = item.get_local_id(0);
+    using Vec = sycl::vec<TA, ElemsPerItem>;
+    static_assert(GroupWorkItem * ElemsPerItem == 2048);
+    for (int route_slot = route_lane; route_slot < RouteCount;
+         route_slot += RouteLanes) {
+      int row = local_id == 0 ? mapped_rows[route_slot] : -1;
+      row = sycl::group_broadcast(item.get_group(), row, 0);
+      if (row < 0) continue;
+      const int vector_index = local_id;
+      const int vector_bound = d / ElemsPerItem;
+      for (int index = vector_index; index < vector_bound;
+           index += GroupWorkItem) {
+        const Vec gate_vec = *reinterpret_cast<const Vec*>(
+            input + static_cast<int64_t>(row) * 2 * d + index * ElemsPerItem);
+        const Vec up_vec = *reinterpret_cast<const Vec*>(
+            input + static_cast<int64_t>(row) * 2 * d + d +
+            index * ElemsPerItem);
+        Vec out_vec;
+#pragma unroll
+        for (int element = 0; element < ElemsPerItem; ++element) {
+          const float gate_f = static_cast<float>(gate_vec[element]);
+          const float up_f = static_cast<float>(up_vec[element]);
+          const TA gate = static_cast<TA>(gate_f > limit ? limit : gate_f);
+          const TA up = static_cast<TA>(
+              up_f < -limit ? -limit : (up_f > limit ? limit : up_f));
+          const TA silu = static_cast<TA>(
+              static_cast<float>(gate) /
+              (1.0f + sycl::exp(-static_cast<float>(gate))));
+          out_vec[element] = silu * up;
+        }
+        *reinterpret_cast<Vec*>(
+            output + static_cast<int64_t>(row) * d + index * ElemsPerItem) =
+            out_vec;
+      }
+    }
+  }
+
+ private:
+  TA* output;
+  const TA* input;
+  const float limit;
+  const int* mapped_rows;
+  const int d;
+};
+
+template <typename TA, typename IndexT, int RouteLanes>
+void SiluAndMulClampM2DirectLauncher(
+    TA* output,
+    const TA* input,
+    const float limit,
+    const int* mapped_rows,
+    const int d,
+    sycl::queue& queue) {
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        SiluAndMulClampM2Direct<TA, IndexT, RouteLanes>::get_nd_range(),
+        SiluAndMulClampM2Direct<TA, IndexT, RouteLanes>{
+            output, input, limit, mapped_rows, d});
+  });
+}
+
+template <typename TA, typename IndexT>
+void SiluAndMulClampM2DirectDispatch(
+    TA* output,
+    const TA* input,
+    const float limit,
+    const int* mapped_rows,
+    const int d,
+    const int route_lanes,
+    sycl::queue& queue) {
+  if (route_lanes == 2) {
+    SiluAndMulClampM2DirectLauncher<TA, IndexT, 2>(
+        output, input, limit, mapped_rows, d, queue);
+  } else if (route_lanes == 4) {
+    SiluAndMulClampM2DirectLauncher<TA, IndexT, 4>(
+        output, input, limit, mapped_rows, d, queue);
+  } else {
+    SiluAndMulClampM2DirectLauncher<TA, IndexT, 12>(
+        output, input, limit, mapped_rows, d, queue);
+  }
+}
