+  TORCH_CHECK(
+      ptr_A.scalar_type() == at::kBFloat16,
+      "fixed-M1 grouped GEMM currently supports BF16 activations only");
+  TORCH_CHECK(
+      ptr_B.scalar_type() == at::kFloat4_e2m1fn_x2,
+      "fixed-M1 grouped GEMM currently supports packed MXFP4 weights only");
+  TORCH_CHECK(
+      ptr_scales.scalar_type() == at::kByte ||
+          ptr_scales.scalar_type() == at::kFloat8_e8m0fnu,
+      "fixed-M1 grouped GEMM currently supports E8M0 scale bytes stored as "
+      "uint8 or float8_e8m0fnu only");
+  TORCH_CHECK(
+      ptr_D.scalar_type() == at::kBFloat16,
+      "fixed-M1 grouped GEMM currently supports BF16 outputs only");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong,
+      "topk_ids must be int32 or int64");
+
+  TORCH_CHECK(N > 0 && K > 0, "N and K must be positive");
+  TORCH_CHECK(
+      N <= std::numeric_limits<int32_t>::max() &&
+          K <= std::numeric_limits<int32_t>::max(),
+      "N and K must fit in int32");
+  TORCH_CHECK(K % 32 == 0, "K must be divisible by the MXFP4 group size 32");
+  TORCH_CHECK(N % 8 == 0, "N must be divisible by 8");
+  TORCH_CHECK(
+      num_local_experts > 0 &&
+          num_local_experts <= std::numeric_limits<int32_t>::max(),
+      "num_local_experts must be a positive int32 value");
+
+  const int64_t topk = topk_ids.size(1);
+  TORCH_CHECK(
+      topk > 0 && topk <= std::numeric_limits<int32_t>::max(),
+      "topk must be a positive int32 value");
+  TORCH_CHECK(ptr_A.size(1) == K, "ptr_A.size(1) must equal K");
+  TORCH_CHECK(
+      ptr_A.size(0) == (broadcast_a ? 1 : topk),
+      "ptr_A rows must be 1 when broadcast_a is true, otherwise topk");
+  TORCH_CHECK(
+      ptr_B.size(0) == num_local_experts && ptr_B.size(1) == N &&
+          ptr_B.size(2) * 2 == K,
+      "ptr_B must have shape [num_local_experts, N, K/2]");
+  TORCH_CHECK(
+      ptr_scales.size(0) == num_local_experts && ptr_scales.size(1) == N &&
+          ptr_scales.size(2) == K / 32,
+      "ptr_scales must have shape [num_local_experts, N, K/32]");
+  TORCH_CHECK(
+      ptr_D.size(0) == topk && ptr_D.size(1) == N,
+      "ptr_D must have shape [topk, N]");
+
+  const bfloat16_t* bias_ptr = nullptr;
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(ptr_bias->is_xpu(), "ptr_bias must be an XPU tensor");
+    TORCH_CHECK(
+        ptr_bias->device() == ptr_A.device(),
+        "ptr_bias must be on the same XPU device as ptr_A");
+    TORCH_CHECK(
+        ptr_bias->is_contiguous() && ptr_bias->scalar_type() == at::kBFloat16,
+        "ptr_bias must be contiguous BF16");
+    TORCH_CHECK(
+        ptr_bias->dim() == 2 && ptr_bias->size(0) == num_local_experts &&
+            ptr_bias->size(1) == N,
+        "ptr_bias must have shape [num_local_experts, N]");
+    bias_ptr = reinterpret_cast<const bfloat16_t*>(ptr_bias->data_ptr());
+  }
+
+  const int32_t* expert_map_ptr = nullptr;
+  int32_t expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(expert_map->is_xpu(), "expert_map must be an XPU tensor");
+    TORCH_CHECK(
+        expert_map->device() == ptr_A.device(),
+        "expert_map must be on the same XPU device as ptr_A");
+    TORCH_CHECK(
+        expert_map->dim() == 1 && expert_map->is_contiguous() &&
+            expert_map->scalar_type() == at::kInt,
+        "expert_map must be contiguous int32 [global_num_experts]");
+    TORCH_CHECK(
+        expert_map->numel() <= std::numeric_limits<int32_t>::max(),
+        "expert_map length must fit in int32");
+    expert_map_ptr = static_cast<const int32_t*>(expert_map->data_ptr());
+    expert_map_size = static_cast<int32_t>(expert_map->numel());
+  }
+
+  auto& queue = at::xpu::getCurrentXPUStream(ptr_A.device().index()).queue();
+  auto* a_ptr = reinterpret_cast<const bfloat16_t*>(ptr_A.data_ptr());
+  auto* b_ptr = reinterpret_cast<const uint8_t*>(ptr_B.data_ptr());
+  auto* scale_ptr = reinterpret_cast<const uint8_t*>(ptr_scales.data_ptr());
+  auto* d_ptr = reinterpret_cast<bfloat16_t*>(ptr_D.data_ptr());
+
+  if (topk_ids.scalar_type() == at::kInt) {
+    M1TopkGEMMLaunchByN<int32_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int32_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int32_t>(topk),
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K),
+        broadcast_a);
+  } else {
+    M1TopkGEMMLaunchByN<int64_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int64_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int32_t>(topk),
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K),
+        broadcast_a);
+  }
+  return ptr_D;
+}
+
+at::Tensor cutlass_grouped_gemm_m2_compact_xe2_impl(
+    const at::Tensor& ptr_A,
+    const at::Tensor& ptr_B,
+    const at::Tensor& ptr_scales,
+    const c10::optional<at::Tensor>& ptr_bias,
+    at::Tensor& ptr_D,
+    const at::Tensor& topk_ids,
+    const c10::optional<at::Tensor>& expert_map,
+    int64_t N,
+    int64_t K,
+    int64_t num_local_experts) {
+  TORCH_CHECK(
+      ptr_A.is_xpu() && ptr_B.is_xpu() && ptr_scales.is_xpu() &&
+          ptr_D.is_xpu() && topk_ids.is_xpu(),
+      "all required tensors must be XPU tensors");
+  TORCH_CHECK(
+      ptr_A.device() == ptr_B.device() &&
+          ptr_A.device() == ptr_scales.device() &&
+          ptr_A.device() == ptr_D.device() &&
+          ptr_A.device() == topk_ids.device(),
+      "all required tensors must be on the same XPU device");
+  TORCH_CHECK(
+      ptr_A.is_contiguous() && ptr_B.is_contiguous() &&
+          ptr_scales.is_contiguous() && ptr_D.is_contiguous() &&
+          topk_ids.is_contiguous(),
+      "all required tensors must be contiguous");
+
+  TORCH_CHECK(
+      ptr_A.scalar_type() == at::kBFloat16 &&
+          ptr_D.scalar_type() == at::kBFloat16,
+      "fixed-M2 compact grouped GEMM requires BF16 activations and outputs");
+  TORCH_CHECK(
+      ptr_B.scalar_type() == at::kFloat4_e2m1fn_x2,
+      "fixed-M2 compact grouped GEMM requires packed MXFP4 weights");
+  TORCH_CHECK(
+      ptr_scales.scalar_type() == at::kByte ||
+          ptr_scales.scalar_type() == at::kFloat8_e8m0fnu,
+      "fixed-M2 compact grouped GEMM requires E8M0 scale bytes");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong,
+      "topk_ids must be int32 or int64");
+
+  TORCH_CHECK(
+      topk_ids.dim() == 2 && topk_ids.size(0) == 2 && topk_ids.size(1) == 6,
+      "fixed-M2 compact grouped GEMM requires topk_ids [2, 6]");
+  TORCH_CHECK(
+      ptr_A.dim() == 2 && ptr_A.size(0) == 12 && ptr_A.size(1) == K,
+      "ptr_A must have shape [12, K]");
+  TORCH_CHECK(
+      ptr_D.dim() == 2 && ptr_D.size(0) == 12 && ptr_D.size(1) == N,
+      "ptr_D must have shape [12, N]");
+  TORCH_CHECK(
+      ptr_B.dim() == 3 && ptr_B.size(0) == num_local_experts &&
+          ptr_B.size(1) == N && ptr_B.size(2) * 2 == K,
+      "ptr_B must have shape [num_local_experts, N, K/2]");
+  TORCH_CHECK(
+      ptr_scales.dim() == 3 && ptr_scales.size(0) == num_local_experts &&
+          ptr_scales.size(1) == N && ptr_scales.size(2) == K / 32,
+      "ptr_scales must have shape [num_local_experts, N, K/32]");
+  TORCH_CHECK(
+      N > 0 && K > 0 && N <= std::numeric_limits<int32_t>::max() &&
+          K <= std::numeric_limits<int32_t>::max() && N % 64 == 0 &&
+          K % 32 == 0,
+      "N and K must fit int32; N must be divisible by 64 and K by 32");
+  TORCH_CHECK(
+      num_local_experts > 0 &&
+          num_local_experts <= std::numeric_limits<int32_t>::max(),
+      "num_local_experts must be a positive int32 value");
+
+  const bfloat16_t* bias_ptr = nullptr;
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(
+        ptr_bias->is_xpu() && ptr_bias->device() == ptr_A.device() &&
+            ptr_bias->is_contiguous() &&
+            ptr_bias->scalar_type() == at::kBFloat16 && ptr_bias->dim() == 2 &&
+            ptr_bias->size(0) == num_local_experts && ptr_bias->size(1) == N,
+        "ptr_bias must be contiguous BF16 [num_local_experts, N]");
+    bias_ptr = reinterpret_cast<const bfloat16_t*>(ptr_bias->data_ptr());
+  }
+
+  const int32_t* expert_map_ptr = nullptr;
+  int32_t expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->is_xpu() && expert_map->device() == ptr_A.device() &&
+            expert_map->dim() == 1 && expert_map->is_contiguous() &&
+            expert_map->scalar_type() == at::kInt &&
+            expert_map->numel() <= std::numeric_limits<int32_t>::max(),
+        "expert_map must be contiguous int32 [global_num_experts]");
+    expert_map_ptr = static_cast<const int32_t*>(expert_map->data_ptr());
+    expert_map_size = static_cast<int32_t>(expert_map->numel());
+  }
+
+  auto& queue = at::xpu::getCurrentXPUStream(ptr_A.device().index()).queue();
+  auto* a_ptr = reinterpret_cast<const bfloat16_t*>(ptr_A.data_ptr());
+  auto* b_ptr = reinterpret_cast<const uint8_t*>(ptr_B.data_ptr());
+  auto* scale_ptr = reinterpret_cast<const uint8_t*>(ptr_scales.data_ptr());
+  auto* d_ptr = reinterpret_cast<bfloat16_t*>(ptr_D.data_ptr());
+
+  using policy = w4a16_policy_m_8;
+  if (topk_ids.scalar_type() == at::kInt) {
+    M2CompactGEMMLauncher<policy, int32_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int32_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        6,
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K));
+  } else {
+    M2CompactGEMMLauncher<policy, int64_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int64_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        6,
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K));
+  }
+  return ptr_D;
+}
+}  // namespace MoE
