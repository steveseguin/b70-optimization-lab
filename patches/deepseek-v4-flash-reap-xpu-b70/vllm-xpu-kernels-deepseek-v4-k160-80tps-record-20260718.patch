+#!/usr/bin/env python3
+"""Gate oneCCL ring-final-writeback plus DeepSeek MHC-post fusion on TP4."""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import multiprocessing as mp
+import os
+import statistics
+import traceback
+
+
+WORLD = 4
+HIDDEN = 4096
+HC = 4
+DEFAULT_CCL = (
+    "/mnt/usb-models/llm-runtime/oneccl-deepseek-b70/lib/libccl.so.1.0"
+)
+
+
+def _worker(
+    rank: int,
+    conn,
+    init_method: str,
+    iterations: int,
+    library: str,
+    via_op: bool,
+    graph_replay: bool,
+) -> None:
+    try:
+        os.environ["ZE_AFFINITY_MASK"] = str(rank)
+        os.environ["ONEAPI_DEVICE_SELECTOR"] = "level_zero:*"
+
+        import torch
+        import torch.distributed as dist
+        import vllm_xpu_kernels._xpu_C  # noqa: F401
+
+        torch.xpu.set_device(0)
+        ccl = ctypes.CDLL(library, mode=ctypes.RTLD_GLOBAL)
+        fused = None
+        if not via_op:
+            fused = ccl.ccl_b70_replay_last_bf16_allreduce_mhc_post
+            fused.argtypes = [
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_size_t,
+                ctypes.c_void_p,
+            ]
+            fused.restype = ctypes.c_int
+
+        dist.init_process_group(
+            "xccl", rank=rank, world_size=WORLD, init_method=init_method
+        )
+        initialization = torch.full(
+            (HIDDEN,), rank + 1, dtype=torch.bfloat16, device="xpu"
+        )
+        dist.all_reduce(initialization)
+        torch.xpu.synchronize()
+
+        conn.send(("ready", rank))
+        if conn.recv() != "go":
+            raise RuntimeError("invalid parent start signal")
+
+        exact = True
+        max_abs = 0.0
+        mismatch_count = 0
+        candidate_us: list[float] = []
+        reference_us: list[float] = []
+        return_codes: set[int] = set()
+        graph_changed = None
+        graph_exact = None
+
+        for epoch in range(1, iterations + 1):
+            base = torch.arange(HIDDEN, dtype=torch.float32, device="xpu")
+            partial = (
+                torch.sin(base * (0.00091 * (rank + 1)) + epoch * 0.017)
+                * (rank + 1.25)
+            ).to(torch.bfloat16)
+            residual = torch.stack(
+                [
+                    torch.cos(base * (0.00037 * (i + 1)) + epoch * 0.011)
+                    .mul_(i + 0.75)
+                    .to(torch.bfloat16)
+                    for i in range(HC)
+                ]
+            )
+            post = torch.tensor(
+                [0.25, -0.5, 0.75, 1.125],
+                dtype=torch.float32,
+                device="xpu",
+            ) + epoch * 0.0001
+            comb = (
+                torch.arange(HC * HC, dtype=torch.float32, device="xpu")
+                .reshape(HC, HC)
+                .mul_(0.017)
+                .sub_(0.11)
+                .add_(epoch * 0.00003)
+            )
+
+            reduced = partial.clone()
+            dist.barrier()
+            torch.xpu.synchronize()
+            start = torch.xpu.Event(enable_timing=True)
+            end = torch.xpu.Event(enable_timing=True)
+            start.record()
+            dist.all_reduce(reduced)
+            reference = torch.ops._xpu_C.mhc_post(
+                reduced.unsqueeze(0),
+                residual.unsqueeze(0),
+                post.reshape(1, HC, 1),
+                comb.unsqueeze(0),
+            ).squeeze(0)
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                reference_us.append(start.elapsed_time(end) * 1000.0)
+
