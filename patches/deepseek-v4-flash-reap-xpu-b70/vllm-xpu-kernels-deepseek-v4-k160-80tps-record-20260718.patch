+                rc = 0
+            else:
+                assert fused is not None
+                rc = fused(
+                    partial.data_ptr(),
+                    residual.data_ptr(),
+                    post.data_ptr(),
+                    comb.data_ptr(),
+                    candidate.data_ptr(),
+                    HIDDEN,
+                    None,
+                )
+            return_codes.add(rc)
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                candidate_us.append(start.elapsed_time(end) * 1000.0)
