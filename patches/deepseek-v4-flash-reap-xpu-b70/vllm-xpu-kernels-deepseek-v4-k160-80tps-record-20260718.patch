@@ -0,0 +1,193 @@
+#!/usr/bin/env python3
+"""Four-process correctness/latency probe for the experimental IPC reduction.
+
+This is intentionally a standalone probe rather than a normal pytest: it
+brokers Level Zero allocation file descriptors through SCM_RIGHTS and compares
+the candidate against the installed XCCL all-reduce on four physical B70s.
+"""
+
+from __future__ import annotations
+
+import argparse
+import multiprocessing as mp
+import os
+from multiprocessing.reduction import recv_handle, send_handle
+
+
+WORLD = 4
+HIDDEN = 4096
+CHANNELS = 128
+SLOTS = 3
+WORKSPACE_BYTES = (
+    CHANNELS * SLOTS * HIDDEN * 2 + CHANNELS * SLOTS * WORLD * 4
+)
+
+
+def _worker(rank: int, conn, init_method: str, iterations: int) -> None:
+    os.environ["ZE_AFFINITY_MASK"] = str(rank)
+    os.environ["ONEAPI_DEVICE_SELECTOR"] = "level_zero:*"
+
+    import torch
+    import torch.distributed as dist
+    import vllm_xpu_kernels._xpu_C  # noqa: F401
+
+    torch.xpu.set_device(0)
+    anchor = torch.empty(1, dtype=torch.uint8, device="xpu")
+    workspace = torch.ops._xpu_C.tp4_ipc_allocate_workspace(anchor)
+    assert workspace.numel() == WORKSPACE_BYTES
+    fd, allocation_offset, handle_words = torch.ops._xpu_C.tp4_ipc_export_fd(
+        workspace
+    )
+    conn.send((rank, allocation_offset, os.getpid(), handle_words))
+    send_handle(conn, fd, os.getppid())
+
+    peer_metadata = conn.recv()
+    peer_fds: list[int] = []
+    for peer_rank, peer_offset, peer_handle_words in peer_metadata:
+        peer_fd = recv_handle(conn)
+        torch.ops._xpu_C.tp4_ipc_register_fd(
+            workspace,
+            peer_rank,
+            peer_fd,
+            peer_offset,
+            peer_handle_words,
+        )
+        # The current Level Zero driver requires the imported dma-buf fd to
+        # remain live for the lifetime of the peer mapping.
+        peer_fds.append(peer_fd)
+
+    dist.init_process_group(
+        "xccl", rank=rank, world_size=WORLD, init_method=init_method
+    )
+    conn.send(("ready", rank))
+    assert conn.recv() == "go"
+
+    exact = True
+    max_abs = 0.0
+    candidate_us: list[float] = []
+    reference_us: list[float] = []
+    for epoch in range(1, iterations + 1):
+        # Values deliberately vary by epoch/rank and exercise BF16 rounding.
+        base = torch.arange(HIDDEN, dtype=torch.float32, device="xpu")
+        partial = (
+            torch.sin(base * (0.00091 * (rank + 1)) + epoch * 0.017)
+            * (rank + 1.25)
+        ).to(torch.bfloat16)
+
+        reference = partial.clone()
+        if epoch == 1:
+            print(f"rank={rank} reference_start", flush=True)
+        start = torch.xpu.Event(enable_timing=True)
+        end = torch.xpu.Event(enable_timing=True)
+        start.record()
+        dist.all_reduce(reference)
+        end.record()
+        end.synchronize()
+        if epoch == 1:
+            print(f"rank={rank} reference_done", flush=True)
+        if epoch > 6:
+            reference_us.append(start.elapsed_time(end) * 1000.0)
+
+        candidate = torch.empty_like(partial)
+        if epoch == 1:
+            print(f"rank={rank} candidate_start", flush=True)
+        start = torch.xpu.Event(enable_timing=True)
+        end = torch.xpu.Event(enable_timing=True)
+        start.record()
+        torch.ops._xpu_C.tp4_allreduce_out(
+            partial, workspace, candidate, rank, 0, epoch
+        )
+        end.record()
+        end.synchronize()
+        if epoch == 1:
+            print(f"rank={rank} candidate_done", flush=True)
+        if epoch > 6:
+            candidate_us.append(start.elapsed_time(end) * 1000.0)
+
+        exact = exact and torch.equal(candidate, reference)
+        max_abs = max(
+            max_abs,
+            float((candidate.float() - reference.float()).abs().max().cpu()),
+        )
+
+    import statistics
+
+    conn.send(
+        {
+            "rank": rank,
+            "exact": exact,
+            "max_abs": max_abs,
+            "candidate_us_median": statistics.median(candidate_us),
+            "reference_us_median": statistics.median(reference_us),
+            "candidate_us_min": min(candidate_us),
+            "reference_us_min": min(reference_us),
+        }
+    )
+    dist.destroy_process_group()
+    torch.ops._xpu_C.tp4_ipc_clear(workspace)
+    for peer_fd in peer_fds:
+        os.close(peer_fd)
+    conn.close()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--iterations", type=int, default=40)
+    args = parser.parse_args()
+
+    ctx = mp.get_context("spawn")
+    parent_conns = []
+    children = []
+    port = 29570 + (os.getpid() % 1000)
+    init_method = f"tcp://127.0.0.1:{port}"
+    for rank in range(WORLD):
+        parent_conn, child_conn = ctx.Pipe(duplex=True)
+        proc = ctx.Process(
+            target=_worker,
+            args=(rank, child_conn, init_method, args.iterations),
+        )
+        proc.start()
+        child_conn.close()
+        parent_conns.append(parent_conn)
+        children.append(proc)
+
+    exports = []
+    for conn in parent_conns:
+        rank, offset, child_pid, handle_words = conn.recv()
+        fd = recv_handle(conn)
+        exports.append((rank, offset, child_pid, fd, handle_words))
+
+    for dest_rank, conn in enumerate(parent_conns):
+        peers = [
+            (rank, offset, handle_words)
+            for rank, offset, _, _, handle_words in exports
+            if rank != dest_rank
+        ]
+        conn.send(peers)
+        dest_pid = exports[dest_rank][2]
+        for rank, _, _, fd, _ in exports:
+            if rank != dest_rank:
+                send_handle(conn, fd, dest_pid)
+    for _, _, _, fd, _ in exports:
+        os.close(fd)
+
+    for conn in parent_conns:
+        assert conn.recv()[0] == "ready"
+    for conn in parent_conns:
+        conn.send("go")
+
+    results = [conn.recv() for conn in parent_conns]
+    for proc in children:
+        proc.join(timeout=30)
+        if proc.exitcode != 0:
+            raise SystemExit(f"worker {proc.pid} exited {proc.exitcode}")
+
+    import json
+
+    print(json.dumps({"iterations": args.iterations, "ranks": results}, indent=2))
+    if not all(row["exact"] for row in results):
+        raise SystemExit("candidate is not bitwise-identical to XCCL")
+
+
+if __name__ == "__main__":
+    main()
