+void silu_and_mul_clamp(
+    torch::Tensor& out,
+    torch::Tensor& input,
+    double limit) {
+  TORCH_CHECK(input.device().is_xpu(), "input must be on XPU");
+  TORCH_CHECK(out.device().is_xpu(), "output must be on XPU");
+  TORCH_CHECK(input.device() == out.device(), "input and output device mismatch");
+  TORCH_CHECK(input.scalar_type() == torch::kBFloat16, "input must be BF16");
+  TORCH_CHECK(out.scalar_type() == torch::kBFloat16, "output must be BF16");
+  TORCH_CHECK(input.is_contiguous() && out.is_contiguous(), "tensors contiguous");
+  TORCH_CHECK(limit > 0.0, "limit must be positive");
+  TORCH_CHECK(input.dim() >= 1, "input must have at least one dimension");
+  TORCH_CHECK(input.size(-1) > 0, "input last dimension must be nonzero");
+  TORCH_CHECK(input.size(-1) % 2 == 0, "input last dimension must be even");
+  const int d = input.size(-1) / 2;
+  const int64_t num_tokens = input.numel() / input.size(-1);
+  TORCH_CHECK(out.dim() == input.dim(), "input and output rank mismatch");
+  for (int dim = 0; dim + 1 < input.dim(); ++dim) {
+    TORCH_CHECK(out.size(dim) == input.size(dim), "output shape mismatch");
+  }
+  TORCH_CHECK(out.size(-1) == d, "output last dimension mismatch");
+  if (num_tokens == 0) {
+    return;
+  }
+  using sycl_t = sycl::ext::oneapi::bfloat16;
+  int vec_size = static_cast<int>(sizeof(float) * 4 / sizeof(sycl_t));
+  int64_t tmp_wg =
+      std::min(static_cast<int64_t>(d), static_cast<int64_t>(1024));
+  while (vec_size > 1 && (vec_size >> 1) * tmp_wg >= d) {
+    vec_size >>= 1;
+  }
+  if (d % vec_size != 0) {
+    vec_size = 1;
+  }
+  const int64_t wg_size = std::min(
+      static_cast<int64_t>(d / vec_size), static_cast<int64_t>(1024));
+  auto* out_ptr = reinterpret_cast<sycl_t*>(out.data_ptr());
+  auto* input_ptr = reinterpret_cast<const sycl_t*>(input.data_ptr());
+  const float clamp_limit = static_cast<float>(limit);
+  at::DeviceGuard device_guard(input.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+
+#define LAUNCH_SILU_CLAMP(N)                                             \
+  case N:                                                               \
+    queue.submit([&](sycl::handler& cgh) {                              \
+      cgh.parallel_for(                                                 \
+          sycl::nd_range<1>(num_tokens * wg_size, wg_size),             \
+          vllm::silu_and_mul_clamp_vec_kernel<sycl_t, N>(               \
+              out_ptr, input_ptr, d, clamp_limit));                     \
+    });                                                                 \
+    break;
+
+  switch (vec_size) {
+    LAUNCH_SILU_CLAMP(1)
+    LAUNCH_SILU_CLAMP(2)
+    LAUNCH_SILU_CLAMP(4)
+    LAUNCH_SILU_CLAMP(8)
+    LAUNCH_SILU_CLAMP(16)
+    default:
+      TORCH_CHECK(false, "Unsupported vector size: ", vec_size);
+  }
+#undef LAUNCH_SILU_CLAMP
+}
