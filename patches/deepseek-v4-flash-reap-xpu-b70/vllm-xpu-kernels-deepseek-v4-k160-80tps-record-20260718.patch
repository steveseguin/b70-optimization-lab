+                [0.125, -0.375, 0.625, 1.25],
+                dtype=torch.float32,
+                device="xpu",
+            )
+            graph_comb = (
+                torch.arange(HC * HC, dtype=torch.float32, device="xpu")
+                .reshape(HC, HC)
+                .mul_(0.013)
+                .sub_(0.09)
+            )
+            graph_out = torch.empty_like(graph_residual)
+
+            # Warm the dispatcher/dlsym cache before capture.
+            torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_out(
+                graph_partial,
+                graph_residual,
+                graph_post,
+                graph_comb,
+                graph_out,
+            )
+            torch.xpu.synchronize()
+            dist.barrier()
+            torch.xpu.synchronize()
+
+            graph = torch.xpu.XPUGraph()
+            try:
+                with torch.xpu.graph(graph):
+                    torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_out(
+                        graph_partial,
+                        graph_residual,
+                        graph_post,
+                        graph_comb,
+                        graph_out,
+                    )
+                graph.replay()
+                torch.xpu.synchronize()
+                before = graph_out.clone()
+
+                graph_partial.add_(0.25)
+                graph_residual.add_(0.125)
+                graph_post.add_(0.03125)
+                graph_comb.sub_(0.015625)
+                torch.xpu.synchronize()
+                graph.replay()
+                torch.xpu.synchronize()
+                graph_changed = not torch.equal(before, graph_out)
+
+                reduced = graph_partial.clone()
+                dist.all_reduce(reduced)
+                expected = torch.ops._xpu_C.mhc_post(
+                    reduced.unsqueeze(0),
+                    graph_residual.unsqueeze(0),
+                    graph_post.reshape(1, HC, 1),
+                    graph_comb.unsqueeze(0),
+                ).squeeze(0)
+                torch.xpu.synchronize()
+                graph_exact = torch.equal(graph_out, expected)
+            finally:
+                graph.reset()
+                torch.xpu.synchronize()
+
+        conn.send(
+            {
+                "rank": rank,
+                "exact": exact,
+                "max_abs": max_abs,
+                "mismatch_count": mismatch_count,
+                "return_codes": sorted(return_codes),
+                "graph_changed": graph_changed,
+                "graph_exact": graph_exact,
+                "candidate_us_median": statistics.median(candidate_us),
+                "reference_us_median": statistics.median(reference_us),
+                "candidate_us_min": min(candidate_us),
+                "reference_us_min": min(reference_us),
+            }
+        )
+        dist.destroy_process_group()
+    except BaseException:
+        conn.send({"rank": rank, "error": traceback.format_exc()})
+        raise
+    finally:
+        conn.close()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--iterations", type=int, default=40)
+    parser.add_argument("--library", default=DEFAULT_CCL)
+    parser.add_argument("--via-op", action="store_true")
+    parser.add_argument("--graph-replay", action="store_true")
+    args = parser.parse_args()
+    if args.iterations <= 6:
+        raise SystemExit("--iterations must exceed the six warm-up epochs")
+
+    ctx = mp.get_context("spawn")
+    parent_conns = []
+    children = []
+    port = 30570 + (os.getpid() % 1000)
+    init_method = f"tcp://127.0.0.1:{port}"
+    for rank in range(WORLD):
+        parent_conn, child_conn = ctx.Pipe(duplex=True)
+        proc = ctx.Process(
+            target=_worker,
+            args=(
+                rank,
+                child_conn,
+                init_method,
+                args.iterations,
+                args.library,
+                args.via_op,
+                args.graph_replay,
+            ),
+        )
+        proc.start()
+        child_conn.close()
+        parent_conns.append(parent_conn)
+        children.append(proc)
+
+    try:
+        ready = [conn.recv() for conn in parent_conns]
+        if any(message[0] != "ready" for message in ready):
+            print(json.dumps({"setup": ready}, indent=2))
+            raise SystemExit("worker setup failed")
+        for conn in parent_conns:
+            conn.send("go")
+        results = [conn.recv() for conn in parent_conns]
+        print(
+            json.dumps(
+                {
+                    "iterations": args.iterations,
+                    "library": args.library,
+                    "via_op": args.via_op,
+                    "graph_replay": args.graph_replay,
+                    "ranks": results,
+                },
+                indent=2,
+            )
+        )
