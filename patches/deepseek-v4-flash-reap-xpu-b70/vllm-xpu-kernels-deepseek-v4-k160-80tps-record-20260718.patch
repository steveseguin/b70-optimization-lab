+// Fixed-M=1 grouped GEMM scheduler for decode. Unlike MoEGEMM above, this
+// launch maps workgroups directly to (top-k slot, N tile), avoiding both the
+// rows-per-expert scan and the persistent atomic scheduler. The math is still
+// performed by the existing xe_gemm_4bits mainloop.
+template <
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyD,
+    class TiledMMA,
+    typename TopkId>
+CUTE_DEVICE void M1TopkGEMM(
+    const bfloat16_t* Activations,
+    const uint8_t* Weights,
+    const uint8_t* Scales,
+    const bfloat16_t* Bias,
+    bfloat16_t* Outputs,
+    TiledMMA const& mma,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k,
+    const bool broadcast_a) {
+  auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+  auto wg_tile = mma.tile_mnk();
+  const int32_t wg_tile_n = get<1>(wg_tile);
+  const int32_t n_tiles = (gemm_n + wg_tile_n - 1) / wg_tile_n;
+  const int32_t group_id = item.get_group_linear_id();
+  const int32_t slot = group_id / n_tiles;
+  const int32_t n_coord = group_id - slot * n_tiles;
+
+  if (slot >= topk) return;
+
+  const int64_t global_expert = static_cast<int64_t>(topk_ids[slot]);
+  int32_t local_expert = -1;
+  if (expert_map != nullptr) {
+    if (global_expert < 0 || global_expert >= expert_map_size) return;
+    local_expert = expert_map[global_expert];
+  } else {
+    if (global_expert < 0 || global_expert >= num_local_experts) return;
+    local_expert = static_cast<int32_t>(global_expert);
+  }
+
+  // A -1 expert-map entry denotes a non-local expert. Leave that output slot
+  // untouched so the caller can preserve its normal gather/reduction policy.
+  if (local_expert < 0 || local_expert >= num_local_experts) return;
+
+  constexpr int32_t group_size = 32;
+  const int64_t packed_weight_stride =
+      static_cast<int64_t>(gemm_n) * gemm_k / 2;
+  const int64_t scale_stride =
+      static_cast<int64_t>(gemm_n) * (gemm_k / group_size);
+  const int64_t activation_row = broadcast_a ? 0 : slot;
+
+  auto A_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      const_cast<bfloat16_t*>(Activations) + activation_row * gemm_k,
+      1,
+      gemm_k);
+  auto B_tensor = make_moe_tensor<float_e2m1_t, 'R'>(
+      reinterpret_cast<float_e2m1_t*>(
+          const_cast<uint8_t*>(Weights) +
+          static_cast<int64_t>(local_expert) * packed_weight_stride),
+      gemm_n,
+      gemm_k);
+  auto D_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      Outputs + static_cast<int64_t>(slot) * gemm_n, 1, gemm_n);
+
+  const uint8_t* expert_scales =
+      Scales + static_cast<int64_t>(local_expert) * scale_stride;
+  const bfloat16_t* expert_bias =
+      Bias == nullptr ? nullptr
+                      : Bias + static_cast<int64_t>(local_expert) * gemm_n;
+  auto tile_coord = make_coord(0, n_coord, _, 0);
+
+  xe_gemm_4bits<GmemTiledCopyA, GmemTiledCopyB, GmemTiledCopyD, group_size>(
+      A_tensor,
+      B_tensor,
+      expert_scales,
+      expert_bias,
+      D_tensor,
+      tile_coord,
+      mma);
+}
+
+// Fixed-M=2 grouped GEMM scheduler for speculative verification. The generic
+// persistent scheduler launches a device-wide workgroup pool, scans every
+// local expert, and advances through a global atomic counter. With only two
+// top-k-6 rows, at most twelve route slots exist. Map workgroups directly to
+// the first occurrence of each local expert and its N tile while retaining the
+// generic remapped-A layout. Duplicate/cross-row routes therefore remain one
+// grouped GEMM and keep weight-tile reuse.
+template <
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyD,
+    class TiledMMA,
+    typename TopkId>
+CUTE_DEVICE void M2CompactGEMMRoute(
+    const bfloat16_t* Activations,
+    const uint8_t* Weights,
+    const uint8_t* Scales,
+    const bfloat16_t* Bias,
+    bfloat16_t* Outputs,
+    TiledMMA const& mma,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k,
+    const int32_t route_slot,
+    const int32_t n_coord) {
+  auto wg_tile = mma.tile_mnk();
+  const int32_t wg_tile_m = get<0>(wg_tile);
+  const int32_t route_count = 2 * topk;
+
+  if (route_slot >= route_count) return;
+
+  auto map_local_expert = [&](int32_t slot) {
+    const int64_t global_expert = static_cast<int64_t>(topk_ids[slot]);
+    if (expert_map != nullptr) {
+      if (global_expert < 0 || global_expert >= expert_map_size) return -1;
+      return expert_map[global_expert];
+    }
+    if (global_expert < 0 || global_expert >= num_local_experts) return -1;
+    return static_cast<int32_t>(global_expert);
+  };
+
+  const int32_t local_expert = map_local_expert(route_slot);
+  if (local_expert < 0 || local_expert >= num_local_experts) return;
+
+  // One occurrence owns each grouped M tile. Normal target top-k is unique per
+  // row and therefore needs at most two rows per expert, but this also covers
+  // repeated hash-table experts without silently dropping a ninth row.
+  int32_t same_expert_before = 0;
+  for (int32_t slot = 0; slot < route_slot; ++slot) {
+    if (map_local_expert(slot) == local_expert) ++same_expert_before;
+  }
+  if (same_expert_before % wg_tile_m != 0) return;
+
+  int32_t gemm_m = 0;
+  int32_t pre_rows = 0;
+  for (int32_t slot = 0; slot < route_count; ++slot) {
+    const int32_t mapped = map_local_expert(slot);
+    if (mapped == local_expert) ++gemm_m;
+    if (mapped >= 0 && mapped < local_expert) ++pre_rows;
+  }
+
+  constexpr int32_t group_size = 32;
+  const int64_t packed_weight_stride =
+      static_cast<int64_t>(gemm_n) * gemm_k / 2;
+  const int64_t scale_stride =
+      static_cast<int64_t>(gemm_n) * (gemm_k / group_size);
+
+  auto A_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      const_cast<bfloat16_t*>(Activations) +
+          static_cast<int64_t>(pre_rows) * gemm_k,
+      gemm_m,
+      gemm_k);
+  auto B_tensor = make_moe_tensor<float_e2m1_t, 'R'>(
+      reinterpret_cast<float_e2m1_t*>(
+          const_cast<uint8_t*>(Weights) +
+          static_cast<int64_t>(local_expert) * packed_weight_stride),
+      gemm_n,
+      gemm_k);
+  auto D_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      Outputs + static_cast<int64_t>(pre_rows) * gemm_n, gemm_m, gemm_n);
+
+  const uint8_t* expert_scales =
+      Scales + static_cast<int64_t>(local_expert) * scale_stride;
+  const bfloat16_t* expert_bias =
+      Bias == nullptr ? nullptr
+                      : Bias + static_cast<int64_t>(local_expert) * gemm_n;
+  auto tile_coord = make_coord(same_expert_before / wg_tile_m, n_coord, _, 0);
+
+  xe_gemm_4bits<GmemTiledCopyA, GmemTiledCopyB, GmemTiledCopyD, group_size>(
+      A_tensor,
+      B_tensor,
+      expert_scales,
+      expert_bias,
+      D_tensor,
+      tile_coord,
+      mma);
+}
+
+template <
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyD,
+    class TiledMMA,
+    typename TopkId>
+CUTE_DEVICE void M2CompactGEMM(
+    const bfloat16_t* Activations,
+    const uint8_t* Weights,
+    const uint8_t* Scales,
+    const bfloat16_t* Bias,
+    bfloat16_t* Outputs,
+    TiledMMA const& mma,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k) {
+  auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+  const int32_t wg_tile_n = get<1>(mma.tile_mnk());
+  const int32_t n_tiles = (gemm_n + wg_tile_n - 1) / wg_tile_n;
+  const int32_t group_id = item.get_group_linear_id();
+  const int32_t route_slot = group_id / n_tiles;
+  const int32_t n_coord = group_id - route_slot * n_tiles;
+  M2CompactGEMMRoute<GmemTiledCopyA, GmemTiledCopyB, GmemTiledCopyD>(
+      Activations,
+      Weights,
+      Scales,
+      Bias,
+      Outputs,
+      mma,
+      topk_ids,
+      expert_map,
+      expert_map_size,
+      topk,
+      num_local_experts,
+      gemm_n,
+      gemm_k,
+      route_slot,
+      n_coord);
+}
+
+template <
+    int RouteLanes,
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyD,
+    class TiledMMA,
+    typename TopkId>
+CUTE_DEVICE void M2CompactLoopGEMM(
+    const bfloat16_t* Activations,
+    const uint8_t* Weights,
+    const uint8_t* Scales,
+    const bfloat16_t* Bias,
+    bfloat16_t* Outputs,
+    TiledMMA const& mma,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k) {
+  auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+  const int32_t wg_tile_n = get<1>(mma.tile_mnk());
+  const int32_t n_tiles = (gemm_n + wg_tile_n - 1) / wg_tile_n;
+  const int32_t group_id = item.get_group_linear_id();
+  const int32_t route_lane = group_id / n_tiles;
+  const int32_t n_coord = group_id - route_lane * n_tiles;
+  const int32_t route_count = 2 * topk;
+  for (int32_t route_slot = route_lane; route_slot < route_count;
+       route_slot += RouteLanes) {
+    M2CompactGEMMRoute<GmemTiledCopyA, GmemTiledCopyB, GmemTiledCopyD>(
+        Activations,
+        Weights,
+        Scales,
+        Bias,
+        Outputs,
+        mma,
+        topk_ids,
+        expert_map,
+        expert_map_size,
+        topk,
+        num_local_experts,
+        gemm_n,
+        gemm_k,
+        route_slot,
+        n_coord);
+  }
+}
+
 }  // namespace MoE
