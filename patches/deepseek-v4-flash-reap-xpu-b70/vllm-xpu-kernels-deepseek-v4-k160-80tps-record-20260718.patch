new file mode 100644
index 0000000000000000000000000000000000000000..d12fe7151cff2f4464cb9d51c82e3e37e21be460
--- /dev/null
+++ b/csrc/xpu/sycl/deepseek_wqb_m1_fp8_gemv.cpp
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: Apache-2.0
+// Feasibility-only DeepSeek-V4 WQ_B M=1 block-FP8 x BF16 GEMV.
+
+#include <c10/util/Float8_e4m3fn.h>
+#include <sycl/sycl.hpp>
+#include <torch/all.h>
+
+#include "utils.h"
+
+namespace vllm {
+
+using bf16_t = sycl::ext::oneapi::bfloat16;
+
+template <int OUTPUTS_PER_SG>
+class deepseek_wqb_m1_fp8_gemv_kernel {
+ public:
+  static constexpr int SG_SIZE = 16;
+  static constexpr int SCALE_BLOCK = 128;
+
+  deepseek_wqb_m1_fp8_gemv_kernel(
+      bf16_t* __restrict__ output,
+      const bf16_t* __restrict__ input,
+      const at::Float8_e4m3fn* __restrict__ weight,
+      const float* __restrict__ scales,
+      int64_t n,
+      int64_t k,
+      int64_t scale_n)
+      : output_(output),
+        input_(input),
+        weight_(weight),
+        scales_(scales),
+        n_(n),
+        k_(k),
+        scale_n_(scale_n) {}
+
+  [[sycl::reqd_sub_group_size(SG_SIZE)]]
+  void operator()(sycl::nd_item<1> item) const {
+    const int lane = item.get_local_id(0) & (SG_SIZE - 1);
+    const int sg_in_group = item.get_local_id(0) / SG_SIZE;
+    const int subgroups_per_group = item.get_local_range(0) / SG_SIZE;
+    const int64_t output_base =
+        (static_cast<int64_t>(item.get_group(0)) * subgroups_per_group +
+         sg_in_group) *
+        OUTPUTS_PER_SG;
+
+    float accum[OUTPUTS_PER_SG] = {};
+    auto sg = item.get_sub_group();
+
+    for (int64_t kb = 0; kb < k_; kb += SCALE_BLOCK) {
+      float scale[OUTPUTS_PER_SG];
+#pragma unroll
+      for (int o = 0; o < OUTPUTS_PER_SG; ++o) {
+        const int64_t n_idx = output_base + o;
+        float lane_scale = 0.0f;
+        if (lane == 0 && n_idx < n_) {
+          lane_scale =
+              scales_[(kb / SCALE_BLOCK) * scale_n_ + n_idx / SCALE_BLOCK];
+        }
+        scale[o] = sycl::group_broadcast(sg, lane_scale, 0);
+      }
+
+#pragma unroll
+      for (int ki = 0; ki < SCALE_BLOCK / SG_SIZE; ++ki) {
+        const int64_t k_idx = kb + ki * SG_SIZE + lane;
+        const float x = static_cast<float>(input_[k_idx]);
+#pragma unroll
+        for (int o = 0; o < OUTPUTS_PER_SG; ++o) {
+          const int64_t n_idx = output_base + o;
+          if (n_idx < n_) {
+            const float w = static_cast<float>(weight_[n_idx * k_ + k_idx]);
+            accum[o] = sycl::fma(x, w * scale[o], accum[o]);
+          }
+        }
+      }
+    }
+
+#pragma unroll
+    for (int o = 0; o < OUTPUTS_PER_SG; ++o) {
+      const int64_t n_idx = output_base + o;
+      const float result =
+          sycl::reduce_over_group(sg, accum[o], sycl::plus<float>());
+      if (lane == 0 && n_idx < n_) {
+        output_[n_idx] = static_cast<bf16_t>(result);
+      }
+    }
+  }
+
+ private:
+  bf16_t* __restrict__ output_;
+  const bf16_t* __restrict__ input_;
+  const at::Float8_e4m3fn* __restrict__ weight_;
+  const float* __restrict__ scales_;
+  int64_t n_;
+  int64_t k_;
+  int64_t scale_n_;
+};
+
+template <int OUTPUTS_PER_SG>
+void launch_wqb(
+    sycl::queue& queue,
+    bf16_t* output,
+    const bf16_t* input,
+    const at::Float8_e4m3fn* weight,
+    const float* scales,
+    int64_t n,
+    int64_t k,
+    int64_t local_size) {
+  const int64_t outputs_per_group =
+      (local_size / deepseek_wqb_m1_fp8_gemv_kernel<OUTPUTS_PER_SG>::SG_SIZE) *
+      OUTPUTS_PER_SG;
+  const int64_t groups = (n + outputs_per_group - 1) / outputs_per_group;
+  const sycl::range<1> local(local_size);
+  const sycl::range<1> global(groups * local_size);
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        sycl::nd_range<1>(global, local),
+        deepseek_wqb_m1_fp8_gemv_kernel<OUTPUTS_PER_SG>(
+            output, input, weight, scales, n, k, n / 128));
+  });
+}
+
+}  // namespace vllm
+
+void deepseek_wqb_m1_fp8_gemv_out(
+    torch::Tensor& output,
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    const torch::Tensor& scales,
+    int64_t outputs_per_subgroup,
+    int64_t local_size) {
+  TORCH_CHECK(input.device().is_xpu(), "input must be an XPU tensor");
+  TORCH_CHECK(output.device() == input.device(), "output device mismatch");
+  TORCH_CHECK(weight.device() == input.device(), "weight device mismatch");
+  TORCH_CHECK(scales.device() == input.device(), "scales device mismatch");
+  TORCH_CHECK(input.scalar_type() == at::kBFloat16, "input must be BF16");
+  TORCH_CHECK(output.scalar_type() == at::kBFloat16, "output must be BF16");
+  TORCH_CHECK(
+      weight.scalar_type() == at::kFloat8_e4m3fn,
+      "weight must be float8_e4m3fn");
+  TORCH_CHECK(scales.scalar_type() == at::kFloat, "scales must be FP32");
+  TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+  TORCH_CHECK(output.is_contiguous(), "output must be contiguous");
+  TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous [N,K]");
+  TORCH_CHECK(scales.is_contiguous(), "scales must be contiguous");
+  TORCH_CHECK(input.dim() == 2 && input.size(0) == 1, "input must be [1,K]");
+  TORCH_CHECK(weight.dim() == 2, "weight must be [N,K]");
+  TORCH_CHECK(output.dim() == 2 && output.size(0) == 1, "output must be [1,N]");
+  const int64_t n = weight.size(0);
+  const int64_t k = weight.size(1);
+  TORCH_CHECK(input.size(1) == k, "input K mismatch");
+  TORCH_CHECK(output.size(1) == n, "output N mismatch");
+  TORCH_CHECK(k % 128 == 0 && n % 128 == 0, "N/K must be divisible by 128");
+  TORCH_CHECK(
+      scales.dim() == 2 && scales.size(0) == k / 128 &&
+          scales.size(1) == n / 128,
+      "scales must be [K/128,N/128]");
+  TORCH_CHECK(
+      local_size == 128 || local_size == 256 || local_size == 512,
+      "local_size must be 128, 256, or 512");
+
+  at::DeviceGuard device_guard(input.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  auto* output_ptr = reinterpret_cast<vllm::bf16_t*>(output.data_ptr());
+  const auto* input_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(input.data_ptr());
+  const auto* weight_ptr = weight.data_ptr<at::Float8_e4m3fn>();
+  const auto* scale_ptr = scales.data_ptr<float>();
+
+  switch (outputs_per_subgroup) {
+    case 1:
+      vllm::launch_wqb<1>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    case 2:
+      vllm::launch_wqb<2>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    case 4:
+      vllm::launch_wqb<4>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    case 8:
+      vllm::launch_wqb<8>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    default:
+      TORCH_CHECK(false, "outputs_per_subgroup must be 1, 2, 4, or 8");
+  }
+}
