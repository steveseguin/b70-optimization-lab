+      static_cast<float>(hc_pre_eps),
+      static_cast<float>(hc_sinkhorn_eps),
+      static_cast<float>(hc_post_mult_value),
+      static_cast<int>(sinkhorn_repeat),
+      reinterpret_cast<const bf16*>(x.data_ptr()),
+      reinterpret_cast<const bf16*>(residual.data_ptr()),
+      post_layer_mix.data_ptr<float>(),
+      comb_res_mix.data_ptr<float>(),
+      reinterpret_cast<bf16*>(residual_out.data_ptr()),
+      reinterpret_cast<const bf16*>(norm_weight.data_ptr()),
+      static_cast<float>(norm_eps));
+}
