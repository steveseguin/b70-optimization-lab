         self.aux_hidden_state_layers: tuple[int, ...] = ()
+        # Training capture can defer the stream reduction until after greedy
+        # sampling so feature extraction inserts no kernels into target forward.
+        self.capture_raw_aux_hidden_states = False

     def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
         return self.embed_tokens(input_ids)
@@ -1780,7 +1783,6 @@ class DeepseekV4Model(nn.Module, EagleModelMixin):

         residual, post_mix, res_mix = None, None, None
         aux_hidden_states: list[torch.Tensor] = []
-        final_aux_recon: torch.Tensor | None = None
         layer = None
         for layer_idx, layer in enumerate(
             islice(self.layers, self.start_layer, self.end_layer),
@@ -1802,23 +1804,30 @@ class DeepseekV4Model(nn.Module, EagleModelMixin):
                 post_mix=post_mix,
                 res_mix=res_mix,
             )
-            if (layer_idx + 1) in self.aux_hidden_state_layers:
-                aux_recon = layer.hc_post(
-                    hidden_states, residual, post_mix, res_mix
+            # The fused post/pre at the start of this layer has already
+            # materialized the preceding layer's post-MHC residual.  Reuse it
+            # for auxiliary states instead of inserting a second hc_post,
+            # which can perturb graph execution and near-tie greedy logits.
+            # A one-based boundary N is therefore available after layer N+1
+            # starts, whose zero-based layer_idx is N.
+            if layer_idx in self.aux_hidden_state_layers:
+                assert residual is not None
+                aux_hidden_states.append(
+                    residual
+                    if self.capture_raw_aux_hidden_states
+                    else residual.mean(dim=1)
                 )
-                aux_hidden_states.append(aux_recon.mean(dim=1))
-                final_aux_recon = aux_recon
         # The fused path defers the final hc_post to the next layer's
         # fused_post_pre. After the last layer we must apply it explicitly.
         if layer is not None:
-            if (
-                final_aux_recon is not None
-                and self.end_layer in self.aux_hidden_state_layers
-            ):
-                hidden_states = final_aux_recon
-            else:
-                hidden_states = layer.hc_post(
-                    hidden_states, residual, post_mix, res_mix
+            hidden_states = layer.hc_post(
+                hidden_states, residual, post_mix, res_mix
+            )
+            if self.end_layer in self.aux_hidden_state_layers:
+                aux_hidden_states.append(
+                    hidden_states
+                    if self.capture_raw_aux_hidden_states
+                    else hidden_states.mean(dim=1)
                 )
             DIVERGENCE_RECORDER.record(None, "hc_post", hidden_states=hidden_states)

