diff --git a/tests/models/test_deepseek_v4_eagle_training_capture.py b/tests/models/test_deepseek_v4_eagle_training_capture.py
new file mode 100644
index 000000000..bbd026f1d
--- /dev/null
+++ b/tests/models/test_deepseek_v4_eagle_training_capture.py
@@ -0,0 +1,60 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import json
+
+import pytest
+import torch
+from safetensors import safe_open
+
+from vllm.models.deepseek_v4.xpu.eagle_training_capture import (
+    FEATURE_BOUNDARIES,
+    EagleTrainingCaptureWriter,
+    capture_dir,
+    enabled,
+    request_key,
+)
+
+
+def test_capture_is_default_off(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("VLLM_XPU_EAGLE_TRAINING_CAPTURE_DIR", raising=False)
+    assert not enabled()
+    assert capture_dir() is None
+
+
+def test_writer_preserves_aligned_rows(tmp_path) -> None:
+    writer = EagleTrainingCaptureWriter(tmp_path, shard_rows=2)
+    aux = [torch.randn(2, 4096, dtype=torch.bfloat16) for _ in FEATURE_BOUNDARIES]
+    final_hidden = torch.randn(2, 4096, dtype=torch.bfloat16)
+
+    writer.append(
+        aux_hidden_states=aux,
+        target_final_hidden=final_hidden,
+        input_token_ids=torch.tensor([10, 11]),
+        next_target_token_ids=torch.tensor([11, 12]),
+        position_ids=torch.tensor([100, 101]),
+        request_ids=["eagletrain-a", "eagletrain-a"],
+    )
+
+    shard = tmp_path / "features-000000.safetensors"
+    with safe_open(shard, framework="pt", device="cpu") as tensors:
+        assert tensors.metadata() == {
+            "schema_version": "k160-eagle-training-capture-v1",
+            "feature_boundary_ids": "4,22,43",
+            "feature_reduction": "post_mhc_mean_stream",
+        }
+        assert torch.equal(tensors.get_tensor("features_bf16")[:, 0], aux[0])
+        assert torch.equal(
+            tensors.get_tensor("target_final_hidden_bf16"), final_hidden
+        )
+        assert tensors.get_tensor("next_target_token_id").tolist() == [11, 12]
+        assert tensors.get_tensor("position_id").tolist() == [100, 101]
+        assert tensors.get_tensor("request_key").tolist() == [
+            request_key("eagletrain-a"),
+            request_key("eagletrain-a"),
+        ]
+
+    manifest = json.loads(shard.with_suffix(".json").read_text())
+    assert manifest["rows"] == 2
+    assert manifest["feature_boundary_ids"] == [4, 22, 43]
+    assert len(manifest["sha256"]) == 64
diff --git a/vllm/models/deepseek_v4/xpu/eagle_training_capture.py b/vllm/models/deepseek_v4/xpu/eagle_training_capture.py
new file mode 100644
index 000000000..e41cff2a2
--- /dev/null
+++ b/vllm/models/deepseek_v4/xpu/eagle_training_capture.py
@@ -0,0 +1,205 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import atexit
+import hashlib
+import json
+import os
+import threading
+from pathlib import Path
+
+import torch
+from safetensors.torch import save_file
+
+FEATURE_BOUNDARIES = (4, 22, 43)
+_CAPTURE_DIR_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_DIR"
+_REQUEST_PREFIX_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_REQUEST_PREFIX"
+_SHARD_ROWS_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_SHARD_ROWS"
+_ALL_RANKS_ENV = "VLLM_XPU_EAGLE_TRAINING_CAPTURE_ALL_RANKS"
+
+
+def capture_dir() -> Path | None:
+    value = os.getenv(_CAPTURE_DIR_ENV, "").strip()
+    return Path(value) if value else None
+
+
+def enabled() -> bool:
+    return capture_dir() is not None
+
+
+def request_prefix() -> str:
+    return os.getenv(_REQUEST_PREFIX_ENV, "eagletrain-")
+
+
+def capture_all_ranks() -> bool:
+    return os.getenv(_ALL_RANKS_ENV, "0") == "1"
+
+
+def request_key(request_id: str) -> int:
+    digest = hashlib.sha256(request_id.encode()).digest()
+    return int.from_bytes(digest[:8], "little") & ((1 << 63) - 1)
+
+
+def _sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(8 * 1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+class EagleTrainingCaptureWriter:
+    def __init__(self, output_dir: Path, shard_rows: int):
+        if shard_rows <= 0:
+            raise ValueError("capture shard rows must be positive")
+        output_dir.mkdir(parents=True, exist_ok=True)
+        if next(output_dir.glob("features-*.safetensors"), None) is not None:
+            raise FileExistsError(f"capture directory is not empty: {output_dir}")
+        self.output_dir = output_dir
+        self.shard_rows = shard_rows
+        self._lock = threading.Lock()
+        self._buffers: dict[str, list[torch.Tensor]] = {
+            "features_bf16": [],
+            "target_final_hidden_bf16": [],
+            "input_token_id": [],
+            "next_target_token_id": [],
+            "position_id": [],
+            "request_key": [],
+        }
+        self._rows = 0
+        self._next_shard = 0
+
+    def append(
+        self,
+        *,
+        aux_hidden_states: list[torch.Tensor],
+        target_final_hidden: torch.Tensor,
+        input_token_ids: torch.Tensor,
+        next_target_token_ids: torch.Tensor,
+        position_ids: torch.Tensor,
+        request_ids: list[str],
+    ) -> None:
+        if len(aux_hidden_states) != len(FEATURE_BOUNDARIES):
+            raise ValueError(
+                f"expected {len(FEATURE_BOUNDARIES)} feature taps, "
+                f"got {len(aux_hidden_states)}"
+            )
+        rows = target_final_hidden.shape[0]
+        if target_final_hidden.ndim != 2 or target_final_hidden.shape[1] != 4096:
+            raise ValueError("target final hidden states must have shape [rows, 4096]")
+        expected_shapes = [(rows, target_final_hidden.shape[-1])] * len(
+            FEATURE_BOUNDARIES
+        )
+        if [tuple(t.shape) for t in aux_hidden_states] != expected_shapes:
+            raise ValueError("feature tap shapes do not match final hidden states")
+        if len(request_ids) != rows:
+            raise ValueError("request IDs do not match captured rows")
+
+        features = torch.stack(aux_hidden_states, dim=1)
+        tensors = {
+            "features_bf16": features.detach().to(
+                device="cpu", dtype=torch.bfloat16
+            ),
+            "target_final_hidden_bf16": target_final_hidden.detach().to(
+                device="cpu", dtype=torch.bfloat16
+            ),
+            "input_token_id": input_token_ids.detach()
+            .to(device="cpu", dtype=torch.int32)
+            .reshape(-1),
+            "next_target_token_id": next_target_token_ids.detach()
+            .to(device="cpu", dtype=torch.int32)
+            .reshape(-1),
+            "position_id": position_ids.detach()
+            .to(device="cpu", dtype=torch.int32)
+            .reshape(-1),
+            "request_key": torch.tensor(
+                [request_key(req_id) for req_id in request_ids], dtype=torch.int64
+            ),
+        }
+        if any(tensor.shape[0] != rows for tensor in tensors.values()):
+            raise ValueError("capture fields do not have a common row count")
+
+        with self._lock:
+            for name, tensor in tensors.items():
+                self._buffers[name].append(tensor.contiguous())
+            self._rows += rows
+            if self._rows >= self.shard_rows:
+                self._flush_locked()
+
+    def flush(self) -> None:
+        with self._lock:
+            self._flush_locked()
+
+    def _flush_locked(self) -> None:
+        if not self._rows:
+            return
+        tensors = {
+            name: torch.cat(parts, dim=0)
+            for name, parts in self._buffers.items()
+        }
+        shard_name = f"features-{self._next_shard:06d}.safetensors"
+        final_path = self.output_dir / shard_name
+        temporary_path = final_path.with_suffix(".safetensors.incomplete")
+        save_file(
+            tensors,
+            temporary_path,
+            metadata={
+                "schema_version": "k160-eagle-training-capture-v1",
+                "feature_boundary_ids": ",".join(map(str, FEATURE_BOUNDARIES)),
+                "feature_reduction": "post_mhc_mean_stream",
+            },
+        )
+        temporary_path.replace(final_path)
+        checksum = _sha256(final_path)
+        manifest = {
+            "schema_version": "k160-eagle-training-capture-shard-v1",
+            "shard": shard_name,
+            "sha256": checksum,
+            "rows": self._rows,
+            "feature_boundary_ids": list(FEATURE_BOUNDARIES),
+            "feature_reduction": "post_mhc_mean_stream",
+            "tensors": {
+                name: {
+                    "dtype": str(tensor.dtype),
+                    "shape": list(tensor.shape),
+                }
+                for name, tensor in tensors.items()
+            },
+        }
+        manifest_path = final_path.with_suffix(".json")
+        manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")
+        for parts in self._buffers.values():
+            parts.clear()
+        self._rows = 0
+        self._next_shard += 1
+
+
+_WRITERS: dict[tuple[int, str], EagleTrainingCaptureWriter] = {}
+_WRITER_LOCK = threading.Lock()
+
+
+def _request_split(request_id: str) -> str:
+    split = request_id.split("-", 1)[0]
+    if split not in {"eagletrain", "eagledev", "eaglesmoke"}:
+        raise ValueError(f"unsupported EAGLE capture request namespace: {request_id}")
+    return split
+
+
+def get_writer(rank: int, request_ids: list[str]) -> EagleTrainingCaptureWriter:
+    output_dir = capture_dir()
+    if output_dir is None:
+        raise RuntimeError(f"{_CAPTURE_DIR_ENV} is not set")
+    splits = {_request_split(request_id) for request_id in request_ids}
+    if len(splits) != 1:
+        raise ValueError("a capture batch cannot mix train, DEV, and smoke rows")
+    split = splits.pop()
+    key = (rank, split)
+    with _WRITER_LOCK:
+        if key not in _WRITERS:
+            shard_rows = int(os.getenv(_SHARD_ROWS_ENV, "4096"))
+            writer = EagleTrainingCaptureWriter(
+                output_dir / split / f"rank-{rank:03d}", shard_rows
+            )
+            _WRITERS[key] = writer
+            atexit.register(writer.flush)
+        return _WRITERS[key]
