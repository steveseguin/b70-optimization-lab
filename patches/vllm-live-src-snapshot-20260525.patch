+class XPUBF16Fp8BlockScaledMMLinearKernel(Fp8BlockScaledMMLinearKernel):
+    """BF16 fallback for block-FP8 checkpoints on XPU.
+
+    Intel's current XPU kernel set exposes FP8 weight-only GEMM, but not the
