diff --git a/vllm/utils/xpu_decode_timing.py b/vllm/utils/xpu_decode_timing.py
new file mode 100644
index 000000000..f8f513511
--- /dev/null
+++ b/vllm/utils/xpu_decode_timing.py
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+"""Small opt-in timing helper for local XPU decode diagnostics."""
+
+import os
+import time
+import atexit
+from collections import defaultdict
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+_ENABLED = os.environ.get("VLLM_XPU_DECODE_TIMING", "0") == "1"
+_SYNC = os.environ.get("VLLM_XPU_DECODE_TIMING_SYNC", "0") == "1"
+_RANK_FILTER = os.environ.get("VLLM_XPU_DECODE_TIMING_RANK")
+_SUMMARY = os.environ.get("VLLM_XPU_DECODE_TIMING_SUMMARY", "1") != "0"
+_PRINT_EVERY = max(
+    0, int(os.environ.get("VLLM_XPU_DECODE_TIMING_PRINT_EVERY", "0") or "0")
+)
+_SKIP_FIRST = max(
+    0, int(os.environ.get("VLLM_XPU_DECODE_TIMING_SKIP_FIRST", "0") or "0")
+)
+_STATS: dict[tuple[str, str], list[int]] = defaultdict(lambda: [0, 0, 0, 0])
+_SUMMARY_PRINTED = False
+_ALLREDUCE_LABEL: ContextVar[str | None] = ContextVar(
+    "vllm_xpu_allreduce_label", default=None
+)
+
+
+def _rank_label() -> str:
+    for name in ("LOCAL_RANK", "RANK", "VLLM_LOCAL_RANK", "VLLM_RANK"):
+        value = os.environ.get(name)
+        if value is not None:
+            return value
+    try:
+        import torch.distributed as dist
+
+        if dist.is_available() and dist.is_initialized():
+            return str(dist.get_rank())
+    except Exception:
+        pass
+    return f"pid{os.getpid()}"
+
+
+def _rank_enabled(rank: str) -> bool:
+    return _RANK_FILTER is None or _RANK_FILTER == rank
+
+
+def _sync_xpu() -> None:
+    if not _SYNC:
+        return
+    try:
+        import torch
+
+        if hasattr(torch, "xpu") and torch.xpu.is_available():
+            torch.xpu.synchronize()
+    except Exception:
+        pass
+
+
+def _is_compiling() -> bool:
+    try:
+        import torch
+
+        compiler = getattr(torch, "compiler", None)
+        if compiler is not None and compiler.is_compiling():
+            return True
+        dynamo = getattr(torch, "_dynamo", None)
+        return bool(dynamo is not None and dynamo.is_compiling())
+    except Exception:
+        return False
+
+
+def _print_summary() -> None:
+    global _SUMMARY_PRINTED
+    if not _ENABLED or not _SUMMARY or _SUMMARY_PRINTED or not _STATS:
+        return
+    _SUMMARY_PRINTED = True
+    rows = []
+    for (rank, label), (_seen, count, total_ns, max_ns) in _STATS.items():
+        if count == 0:
+            continue
+        rows.append((total_ns, rank, label, count, max_ns))
+    rows.sort(reverse=True)
+    print("[vllm-xpu-timing-summary] begin", flush=True)
+    for total_ns, rank, label, count, max_ns in rows:
+        avg_ns = total_ns / max(count, 1)
+        print(
+            "[vllm-xpu-timing-summary] "
+            f"rank={rank} label={label} count={count} "
+            f"total_ms={total_ns / 1e6:.6f} "
+            f"avg_ms={avg_ns / 1e6:.6f} "
+            f"max_ms={max_ns / 1e6:.6f}",
+            flush=True,
+        )
+    print("[vllm-xpu-timing-summary] end", flush=True)
+
+
+atexit.register(_print_summary)
+
+
+@contextmanager
+def allreduce_label(label: str | None):
+    if not _ENABLED or not label or _is_compiling():
+        yield
+        return
+    token = _ALLREDUCE_LABEL.set(label)
+    try:
+        yield
+    finally:
+        _ALLREDUCE_LABEL.reset(token)
+
+
+def current_allreduce_label() -> str | None:
+    return _ALLREDUCE_LABEL.get()
+
+
+@contextmanager
+def timed_region(label: str):
+    if not _ENABLED or _is_compiling():
+        yield
+        return
+    rank = _rank_label()
+    if not _rank_enabled(rank):
+        yield
+        return
+    _sync_xpu()
+    start_ns = time.perf_counter_ns()
+    try:
+        yield
+    finally:
+        _sync_xpu()
+        elapsed_ns = time.perf_counter_ns() - start_ns
+        stat = _STATS[(rank, label)]
+        stat[0] += 1
+        if stat[0] <= _SKIP_FIRST:
+            return
+        stat[1] += 1
+        stat[2] += elapsed_ns
+        stat[3] = max(stat[3], elapsed_ns)
+        if _PRINT_EVERY and stat[1] % _PRINT_EVERY == 0:
+            print(
+                "[vllm-xpu-timing] "
+                f"rank={rank} label={label} count={stat[1]} "
+                f"last_ms={elapsed_ns / 1e6:.6f}",
+                flush=True,
+            )
diff --git a/vllm/utils/xpu_finite_trace.py b/vllm/utils/xpu_finite_trace.py
new file mode 100644
index 000000000..2ef77cf36
--- /dev/null
+++ b/vllm/utils/xpu_finite_trace.py
@@ -0,0 +1,150 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in tensor finite-value tracing for XPU correctness diagnostics."""
+
+import json
+import os
+import re
+import time
+from collections import defaultdict
+from pathlib import Path
+from typing import Any
+
+import torch
+
+
+_COUNTS: defaultdict[str, int] = defaultdict(int)
+
+
+def _tag_enabled(tag: str) -> bool:
+    tag_regex = os.environ.get("VLLM_XPU_FINITE_TRACE_TAG_REGEX")
+    return tag_regex is None or re.search(tag_regex, tag) is not None
+
+
+def _dist_info() -> dict[str, int | None]:
+    if not torch.distributed.is_available() or not torch.distributed.is_initialized():
+        return {"rank": None, "world_size": None}
+    try:
+        return {
+            "rank": int(torch.distributed.get_rank()),
+            "world_size": int(torch.distributed.get_world_size()),
+        }
+    except Exception:
+        return {"rank": None, "world_size": None}
+
+
+def trace_tensor(tag: str, tensor: torch.Tensor | None) -> None:
+    """Write compact tensor stats when VLLM_XPU_FINITE_TRACE=1.
+
+    This is intentionally sync-heavy and should only be enabled for tiny
+    correctness probes, not throughput runs.
+    """
+    if os.environ.get("VLLM_XPU_FINITE_TRACE", "0") != "1":
+        return
+
+    if not _tag_enabled(tag):
+        return
+
+    limit = int(os.environ.get("VLLM_XPU_FINITE_TRACE_LIMIT", "8"))
+    if _COUNTS[tag] >= limit:
+        return
+    _COUNTS[tag] += 1
+
+    record: dict[str, Any] = {
+        "time": time.time(),
+        "pid": os.getpid(),
+        "tag": tag,
+        "count": _COUNTS[tag],
+        **_dist_info(),
+    }
+
+    if tensor is None:
+        record["tensor"] = None
+    else:
+        with torch.no_grad():
+            t = tensor.detach()
+            record.update(
+                {
+                    "shape": list(t.shape),
+                    "dtype": str(t.dtype),
+                    "device": str(t.device),
+                    "numel": int(t.numel()),
+                }
+            )
+            if t.numel() == 0:
+                record.update({"finite": 0, "nan": 0, "posinf": 0, "neginf": 0})
+            else:
+                stats_t = t.float() if not t.is_floating_point() else t
+                finite_mask = torch.isfinite(stats_t)
+                nan_mask = torch.isnan(stats_t)
+                posinf_mask = stats_t == float("inf")
+                neginf_mask = stats_t == -float("inf")
+                finite_count = int(finite_mask.sum().item())
+                record.update(
+                    {
+                        "finite": finite_count,
+                        "nan": int(nan_mask.sum().item()),
+                        "posinf": int(posinf_mask.sum().item()),
+                        "neginf": int(neginf_mask.sum().item()),
+                    }
+                )
+                if finite_count:
+                    finite_vals = stats_t[finite_mask].float()
+                    record.update(
+                        {
+                            "min": float(finite_vals.min().item()),
+                            "max": float(finite_vals.max().item()),
+                            "mean": float(finite_vals.mean().item()),
+                        }
+                    )
+
+    line = json.dumps(record, sort_keys=True, allow_nan=False)
+    output_path = os.environ.get("VLLM_XPU_FINITE_TRACE_FILE")
+    if output_path:
+        path = Path(output_path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        with path.open("a", encoding="utf-8") as f:
+            f.write(line + "\n")
+    else:
+        print(f"[xpu-finite-trace] {line}", flush=True)
+
+
+def xpu_finite_trace_op(tensor: torch.Tensor, tag: str) -> None:
+    trace_tensor(tag, tensor)
+
+
+def xpu_finite_trace_op_fake(tensor: torch.Tensor, tag: str) -> None:
+    return
+
+
+_HAS_TRACE_OP = False
+try:
+    from vllm.utils.torch_utils import direct_register_custom_op
+
+    direct_register_custom_op(
+        op_name="xpu_finite_trace",
+        op_func=xpu_finite_trace_op,
+        mutates_args=["tensor"],
+        fake_impl=xpu_finite_trace_op_fake,
+    )
+    _HAS_TRACE_OP = True
+except Exception:
+    _HAS_TRACE_OP = False
+
+
+def trace_tensor_graph(tag: str, tensor: torch.Tensor | None) -> None:
+    if os.environ.get("VLLM_XPU_FINITE_TRACE", "0") != "1":
+        return
+    if (
+        torch.compiler.is_compiling()
+        and os.environ.get("VLLM_XPU_FINITE_TRACE_GRAPH", "0") != "1"
+    ):
+        return
+    if not _tag_enabled(tag):
+        return
+    if tensor is None:
+        trace_tensor(tag, tensor)
+        return
+    if torch.compiler.is_compiling() and _HAS_TRACE_OP:
+        torch.ops.vllm.xpu_finite_trace(tensor, tag)
+    else:
+        trace_tensor(tag, tensor)
