+    def _xpu_cudagraph_clone_output_tensors(self, output: Any) -> Any:
+        if isinstance(output, torch.Tensor):
+            return output.detach().clone()
+        if isinstance(output, tuple):
+            return tuple(self._xpu_cudagraph_clone_output_tensors(v) for v in output)
+        if isinstance(output, list):
+            return [self._xpu_cudagraph_clone_output_tensors(v) for v in output]
+        if isinstance(output, dict):
+            return {
+                key: self._xpu_cudagraph_clone_output_tensors(value)
+                for key, value in output.items()
+            }
+        tensors = getattr(output, "tensors", None)
+        if isinstance(tensors, dict):
+            return {
+                str(key): self._xpu_cudagraph_clone_output_tensors(value)
+                for key, value in tensors.items()
+            }
+        return output
+
+    def _xpu_cudagraph_collect_tensors(
+        self, output: Any, path: str = "$"
+    ) -> list[tuple[str, torch.Tensor]]:
+        if isinstance(output, torch.Tensor):
+            return [(path, output)]
+        if isinstance(output, tuple):
+            tensors: list[tuple[str, torch.Tensor]] = []
+            for idx, value in enumerate(output):
+                tensors.extend(
+                    self._xpu_cudagraph_collect_tensors(value, f"{path}[{idx}]")
+                )
+            return tensors
+        if isinstance(output, list):
+            tensors = []
+            for idx, value in enumerate(output):
+                tensors.extend(
+                    self._xpu_cudagraph_collect_tensors(value, f"{path}[{idx}]")
+                )
+            return tensors
+        if isinstance(output, dict):
+            tensors = []
+            for key, value in output.items():
+                tensors.extend(
+                    self._xpu_cudagraph_collect_tensors(value, f"{path}.{key}")
+                )
+            return tensors
+        output_tensors = getattr(output, "tensors", None)
+        if isinstance(output_tensors, dict):
+            tensors = []
+            for key, value in output_tensors.items():
+                tensors.extend(
+                    self._xpu_cudagraph_collect_tensors(value, f"{path}.{key}")
+                )
+            return tensors
+        return []
+
+    def _xpu_cudagraph_compare_outputs(
+        self, replay_output: Any, direct_output: Any
+    ) -> dict[str, Any]:
+        max_numel = _xpu_cudagraph_int_env(
+            "VLLM_XPU_CUDAGRAPH_COMPARE_DIRECT_MAX_NUMEL", 262144
+        )
+        replay_tensors = self._xpu_cudagraph_collect_tensors(replay_output)
+        direct_tensors = self._xpu_cudagraph_collect_tensors(direct_output)
+        comparisons: list[dict[str, Any]] = []
+        for idx, (replay_item, direct_item) in enumerate(
+            zip(replay_tensors, direct_tensors)
+        ):
+            replay_path, replay_tensor = replay_item
+            direct_path, direct_tensor = direct_item
+            item: dict[str, Any] = {
+                "index": idx,
+                "replay_path": replay_path,
+                "direct_path": direct_path,
+                "replay_shape": list(replay_tensor.shape),
+                "direct_shape": list(direct_tensor.shape),
+                "replay_dtype": str(replay_tensor.dtype),
+                "direct_dtype": str(direct_tensor.dtype),
+                "replay_device": str(replay_tensor.device),
+                "direct_device": str(direct_tensor.device),
+            }
+            if replay_tensor.shape != direct_tensor.shape:
+                item["match"] = False
+                item["reason"] = "shape"
+            elif replay_tensor.numel() > max_numel:
+                item["match"] = None
+                item["reason"] = "numel"
+                item["max_numel"] = max_numel
+            else:
+                try:
+                    replay_float = replay_tensor.detach().float()
+                    direct_float = direct_tensor.detach().float()
+                    diff = (replay_float - direct_float).abs()
+                    finite = torch.isfinite(diff)
+                    finite_count = int(finite.sum().item())
+                    item["finite_diff"] = finite_count
+                    item["nan_diff"] = int(torch.isnan(diff).sum().item())
+                    if finite_count:
+                        finite_diff = diff[finite]
+                        max_abs = float(finite_diff.max().item())
+                        mean_abs = float(finite_diff.mean().item())
+                        item["max_abs"] = max_abs
+                        item["mean_abs"] = mean_abs
+                        item["match"] = max_abs == 0.0
+                    else:
+                        item["match"] = False
+                except Exception as exc:
+                    item["match"] = False
+                    item["reason"] = repr(exc)
+            comparisons.append(item)
+        return {
+            "replay_tensor_count": len(replay_tensors),
+            "direct_tensor_count": len(direct_tensors),
+            "all_match": (
+                len(replay_tensors) == len(direct_tensors)
+                and all(item.get("match") is True for item in comparisons)
+            ),
+            "comparisons": comparisons,
+        }
