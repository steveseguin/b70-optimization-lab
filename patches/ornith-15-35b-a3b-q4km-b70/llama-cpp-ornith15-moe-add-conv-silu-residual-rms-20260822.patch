+           mul_src != nullptr && mul_src->type == GGML_TYPE_F32 && mul_src->ne[0] == 2048 &&
+           ggml_nelements(mul_src) == 2048 && ggml_is_contiguous(mul_src) && ggml_is_contiguous(mul);
+}
