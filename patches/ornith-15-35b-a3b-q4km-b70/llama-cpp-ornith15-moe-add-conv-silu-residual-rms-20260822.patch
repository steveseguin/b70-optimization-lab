+template <bool poison>
+static void kernel_ornith_conv_silu(
+        queue & q,
+        const float * src,
+        const float * weights,
+        float * dst,
+        int d_conv,
+        int d_inner,
+        int src_stride_inner) {
+    constexpr size_t work_group_size = 256;
+    const size_t num_work_groups =
+        (static_cast<size_t>(d_inner) + work_group_size - 1) / work_group_size;
+
+    q.submit([&](handler & h) {
+        h.parallel_for(
+            nd_range<1>(range<1>(num_work_groups * work_group_size), range<1>(work_group_size)),
+            [=](nd_item<1> item) {
+                const size_t channel = item.get_global_id(0);
+                if (channel >= static_cast<size_t>(d_inner)) {
+                    return;
+                }
+                const float * s = src + channel * static_cast<size_t>(src_stride_inner);
+                const float * c = weights + channel * static_cast<size_t>(d_conv);
+                float sumf = 0.0f;
+                for (int tap = 0; tap < d_conv; ++tap) {
+                    sumf += s[tap] * c[tap];
+                }
+                if constexpr (poison) {
+                    sumf += 1000.0f;
+                }
+                dst[channel] = sumf / (1.0f + sycl::exp(-sumf));
+            });
+    });
+}
