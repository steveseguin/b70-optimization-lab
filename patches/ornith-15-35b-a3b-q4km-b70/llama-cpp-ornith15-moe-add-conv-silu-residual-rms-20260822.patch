+static bool ggml_sycl_moe_add_reduce_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_MOE_ADD_REDUCE");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
