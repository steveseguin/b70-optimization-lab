+    }
+    launch_mul_mat_vec_q_moe_glu_reorder<reorder_vec_dot_q_sycl<GGML_TYPE_Q4_K>>(
+        vup_base, vgate_base, vy, ids_dev, dst_base, ncols, nrows,
+        n_experts_used, expert_weight_stride, dst_row_stride,
+        src1_row_stride, glu_op, stream);
+    return true;
+}
