+void ggml_sycl_op_moe_shared_residual_rms_norm_fused(
+        ggml_backend_sycl_context & ctx, ggml_tensor * ffn_add,
+        ggml_tensor * residual_add, ggml_tensor * rms_norm, ggml_tensor * mul_tensor) {
