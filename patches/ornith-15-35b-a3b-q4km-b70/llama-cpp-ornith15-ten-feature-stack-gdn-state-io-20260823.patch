+struct ggml_sycl_ornith_concat_state_direct_match {
+    ggml_tensor * get_rows = nullptr;
+    ggml_tensor * concat   = nullptr;
+    ggml_tensor * cpy      = nullptr;
+    int concat_idx = -1;
+    int cpy_idx    = -1;
+};
