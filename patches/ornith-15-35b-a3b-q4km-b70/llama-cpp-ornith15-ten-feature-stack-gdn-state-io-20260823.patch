+            if (consumer->src[s] == add) {
+                if (consumer != softplus || s != 0) {
+                    return false;
+                }
+                ++add_uses;
+            }
+            if (consumer->src[s] == softplus) {
+                if (consumer != mul) {
+                    return false;
+                }
+                ++softplus_uses;
+            }
+        }
+    }
+    return add_uses == 1 && softplus_uses == 1;
+}
