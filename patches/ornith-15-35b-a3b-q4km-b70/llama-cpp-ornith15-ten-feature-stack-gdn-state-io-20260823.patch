+void ggml_sycl_ornith_conv_silu(
+        ggml_backend_sycl_context & ctx,
+        ggml_tensor * conv,
+        ggml_tensor * silu) {
+    GGML_ASSERT(conv != nullptr && silu != nullptr && conv->src[0] != nullptr && conv->src[1] != nullptr);
+    GGML_ASSERT(conv->op == GGML_OP_SSM_CONV && silu->op == GGML_OP_UNARY);
+    GGML_ASSERT(ggml_get_unary_op(silu) == GGML_UNARY_OP_SILU && silu->src[0] == conv);
+    GGML_ASSERT(conv->type == GGML_TYPE_F32 && silu->type == GGML_TYPE_F32);
+    GGML_ASSERT(conv->ne[0] == 8192 && conv->ne[1] == 1 && conv->ne[2] == 1 && conv->ne[3] == 1);
+    GGML_ASSERT(ggml_are_same_shape(conv, silu) && ggml_is_contiguous(silu));
+    GGML_ASSERT(conv->src[1]->ne[0] == 4 && conv->src[1]->ne[1] == 8192);
+    GGML_ASSERT(conv->src[0]->nb[0] == sizeof(float) && conv->src[0]->nb[1] == 4 * sizeof(float));
+    GGML_ASSERT(conv->src[1]->nb[0] == sizeof(float) && conv->src[1]->nb[1] == 4 * sizeof(float));
+
+    static const bool poison = [] {
+        const char * value = std::getenv("GGML_SYCL_FUSED_ORNITH_CONV_SILU_POISON");
+        return value != nullptr && std::atoi(value) != 0;
+    }();
+    if (poison) {
+        kernel_ornith_conv_silu<true>(*ctx.stream(), static_cast<const float *>(conv->src[0]->data),
+            static_cast<const float *>(conv->src[1]->data), static_cast<float *>(silu->data), 4, 8192, 4);
+    } else {
+        kernel_ornith_conv_silu<false>(*ctx.stream(), static_cast<const float *>(conv->src[0]->data),
+            static_cast<const float *>(conv->src[1]->data), static_cast<float *>(silu->data), 4, 8192, 4);
+    }
+}
