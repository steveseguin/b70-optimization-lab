+            if (sycl_ctx->graph_cache.size() >= (size_t) g_ggml_sycl_graph_cache_size) {
+                cycle_timer.set_path("graph_cache_full");
+                sycl_ctx->graph_cache_full_count++;
+                if (should_log_graph_counter(sycl_ctx->graph_cache_full_count)) {
+                    GGML_LOG_INFO("[SYCL-GRAPH] cache_full device=%d count=%llu cache_entries=%zu\n",
