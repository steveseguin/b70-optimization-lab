+    plan->k_heads = k_heads;
+    memcpy(&plan->q_eps, norms[0]->op_params, sizeof(float));
+    memcpy(&plan->k_eps, norms[1]->op_params, sizeof(float));
+    return plan->q_eps >= 0.0f && plan->k_eps >= 0.0f;
+}
+
+// Match the Qwen delta-net recurrent convolution snapshots. build_conv_state()
+// creates one CPY per rollback slot from a view of the exact CONCAT consumed by
+// SSM_CONV. The writes may precede the convolution in graph order, so plans are
+// constructed before dispatch and the CPYs are suppressed individually.
+static bool ssm_conv_cache_match(
+        const ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph,
+        ggml_tensor * conv, ssm_conv_cache_plan * plan) {
+    if (conv->op != GGML_OP_SSM_CONV || conv->type != GGML_TYPE_F32 || conv->src[0] == nullptr ||
+        conv->src[1] == nullptr || conv->src[0]->op != GGML_OP_CONCAT ||
+        conv->src[0]->type != GGML_TYPE_F32 || conv->src[1]->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(conv->src[0])) {
+        return false;
+    }
+
+    const ggml_tensor * input = conv->src[0];
+    const int64_t d_conv = conv->src[1]->ne[0];
+    const int64_t channels = input->ne[1];
+    const int64_t n_seqs = input->ne[2];
+    const int64_t row_count = (d_conv - 1) * channels;
+    if (d_conv <= 1 || channels <= 0 || n_seqs <= 0 || input->ne[3] != 1 ||
+        input->nb[0] != sizeof(float) || input->nb[1] != input->ne[0] * sizeof(float) ||
+        input->nb[2] != input->ne[0] * channels * sizeof(float)) {
+        return false;
+    }
+
+    constexpr int observable = GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT |
+                               GGML_TENSOR_FLAG_PARAM | GGML_TENSOR_FLAG_LOSS;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * cpy = cgraph->nodes[i];
+        if (cpy->op != GGML_OP_CPY || (cpy->flags & observable) || cpy->src[0] == nullptr ||
+            cpy->src[1] == nullptr) {
+            continue;
+        }
+        const ggml_tensor * src = cpy->src[0];
+        const ggml_tensor * dst = cpy->src[1];
+        if (src->op != GGML_OP_VIEW || src->view_src != input || src->type != GGML_TYPE_F32 ||
+            dst->op != GGML_OP_VIEW || dst->type != GGML_TYPE_F32 ||
+            src->ne[0] != d_conv - 1 || src->ne[1] != channels || src->ne[2] != n_seqs ||
+            ggml_nelements(src) != row_count * n_seqs || dst->ne[0] != row_count ||
+            dst->ne[1] != n_seqs || ggml_nelements(dst) != row_count * n_seqs ||
+            src->nb[0] != sizeof(float) || src->nb[1] != input->nb[1] || src->nb[2] != input->nb[2] ||
+            dst->nb[0] != sizeof(float) || src->view_offs % sizeof(float) != 0) {
+            continue;
+        }
+        const int64_t src_offset = src->view_offs / sizeof(float);
+        if (src_offset < 0 || src_offset + d_conv - 1 > input->ne[0] ||
+            plan->cache.count == GGML_SYCL_SSM_CONV_MAX_CACHE_WRITES) {
+            return false;
+        }
+        const ggml_tensor * tensors[] = { input, src, dst };
+        bool valid_buffers = true;
+        for (const ggml_tensor * tensor : tensors) {
+            valid_buffers &= tensor->data != nullptr && tensor->buffer != nullptr &&
+                tensor->buffer->buft == ggml_backend_sycl_buffer_type(ctx.device) &&
+                !ggml_backend_buffer_is_sycl_split(tensor->buffer);
+        }
+        if (!valid_buffers) {
+            return false;
+        }
+        const int index = plan->cache.count++;
+        plan->cache.writes[index] = {
+            static_cast<float *>(dst->data), static_cast<int64_t>(dst->nb[1] / sizeof(float)), src_offset
+        };
+        plan->cpys[index] = cpy;
+    }
+    plan->conv = conv;
+    return plan->cache.count > 0;
+}
+
+// Diagnostic-only logical-op timer. A barrier is placed immediately before
+// dispatch and immediately after all commands submitted by that graph-loop
+// iteration. Waiting here intentionally serializes logical ops, so these rows
+// are for critical-path attribution only and never for throughput comparison.
+class sycl_op_timer {
+public:
+    sycl_op_timer(ggml_backend_sycl_context * ctx, const ggml_tensor * node, int index) :
+        enabled(g_ggml_sycl_op_timing != 0), queue(ctx->stream()), node(node), index(index) {
+        if (!enabled || !queue->has_property<sycl::property::queue::enable_profiling>()) {
+            enabled = false;
+            return;
+        }
+        begin = queue->ext_oneapi_submit_barrier();
+    }
+
+    ~sycl_op_timer() noexcept {
+        if (!enabled) {
+            return;
+        }
+        try {
+            sycl::event end = queue->ext_oneapi_submit_barrier();
+            end.wait_and_throw();
+            const uint64_t begin_end = begin.get_profiling_info<sycl::info::event_profiling::command_end>();
+            const uint64_t end_start = end.get_profiling_info<sycl::info::event_profiling::command_start>();
+            const double device_us = end_start >= begin_end ? (end_start - begin_end) / 1000.0 : -1.0;
+            GGML_LOG_INFO("[SYCL-OP] index=%d op=%s name=%s ne=%" PRId64 "x%" PRId64 "x%" PRId64
+                          "x%" PRId64 " device_us=%.3f\n",
+                          index, ggml_op_name(node->op), node->name, node->ne[0], node->ne[1],
+                          node->ne[2], node->ne[3], device_us);
+        } catch (const sycl::exception & e) {
+            GGML_LOG_ERROR("[SYCL-OP] index=%d op=%s error=%s\n", index, ggml_op_name(node->op), e.what());
+        }
+    }
+
+private:
+    bool enabled;
+    queue_ptr queue;
+    const ggml_tensor * node;
+    int index;
+    sycl::event begin;
+};
+
+static void ggml_backend_sycl_graph_compute_impl(ggml_backend_sycl_context * sycl_ctx, ggml_cgraph * cgraph) {
+    ggml_sycl_set_main_device(sycl_ctx->device);
+    g_rms_q8_fusion = {};
+    g_swiglu_q8_fusion = {};
+    g_gdn_epilogue_q8_fusion = {};
+    static uint64_t eligible_count = 0;
+    static uint64_t fused_count = 0;
+    static uint64_t rejected_count[static_cast<int>(mmvq_add_reject::metadata) + 1] = {};
+    static bool rejection_detail_logged[static_cast<int>(mmvq_add_reject::metadata) + 1] = {};
+    static uint64_t rms_q8_eligible_count = 0;
+    static uint64_t rms_q8_fused_count = 0;
+    static uint64_t swiglu_q8_fused_count = 0;
+    static uint64_t gdn_raw_gate_fused_count = 0;
+    static uint64_t gdn_epilogue_fused_count = 0;
+    static uint64_t ssm_conv_cache_fused_count = 0;
+    static uint64_t ssm_conv_qk_norm_fused_count = 0;
+    static uint64_t rms_q8_rejected_count[static_cast<int>(mmvq_add_rms_q8_reject::dispatch) + 1] = {};
+    const ggml_tensor * last_fused_add = nullptr;
+    std::vector<gdn_epilogue_match> gdn_epilogue_plans;
+    std::vector<const gdn_epilogue_match *> gdn_epilogue_plan_by_node(cgraph->n_nodes, nullptr);
+    std::vector<uint8_t> gdn_epilogue_skip_node(cgraph->n_nodes, 0);
+    if (g_ggml_sycl_fuse_gdn_epilogue) {
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            if (cgraph->nodes[i]->op != GGML_OP_RMS_NORM) {
+                continue;
+            }
+            gdn_epilogue_match match = {};
+            if (gdn_epilogue_match_graph(*sycl_ctx, cgraph, i, &match)) {
+                gdn_epilogue_plans.push_back(match);
+            }
+        }
+        for (const gdn_epilogue_match & plan : gdn_epilogue_plans) {
+            const int dispatch_index = gdn_epilogue_node_index(cgraph, plan.consumer);
+            if (dispatch_index >= 0) {
+                gdn_epilogue_plan_by_node[dispatch_index] = &plan;
+            }
+            const ggml_tensor * skipped[] = { plan.rms, plan.learned, plan.silu, plan.final_mul };
+            for (const ggml_tensor * tensor : skipped) {
+                const int skip_index = gdn_epilogue_node_index(cgraph, tensor);
+                if (skip_index >= 0) {
+                    gdn_epilogue_skip_node[skip_index] = 1;
+                }
+            }
+            for (int j = 0; j < plan.metadata_count; ++j) {
+                const int skip_index = gdn_epilogue_node_index(cgraph, plan.metadata[j]);
+                if (skip_index >= 0) {
+                    gdn_epilogue_skip_node[skip_index] = 1;
+                }
+            }
+        }
+    }
+    std::vector<gdn_raw_gate_plan> gdn_raw_plans;
+    std::vector<const gdn_raw_gate_plan *> gdn_raw_plan_by_node(cgraph->n_nodes, nullptr);
+    std::vector<uint8_t> gdn_raw_skip_node(cgraph->n_nodes, 0);
+    if (g_ggml_sycl_fuse_gdn_raw_gates) {
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            if (cgraph->nodes[i]->op != GGML_OP_GATED_DELTA_NET) {
+                continue;
+            }
+            gdn_raw_gate_plan plan = {};
+            if (gdn_raw_gate_match(*sycl_ctx, cgraph, cgraph->nodes[i], &plan)) {
+                gdn_raw_plans.push_back(plan);
+            }
+        }
+        for (const gdn_raw_gate_plan & plan : gdn_raw_plans) {
+            const int gdn_index = gdn_node_index(cgraph, plan.gdn);
+            if (gdn_index >= 0) {
+                gdn_raw_plan_by_node[gdn_index] = &plan;
+            }
+            for (const ggml_tensor * skip : plan.skip) {
+                const int skip_index = gdn_node_index(cgraph, skip);
+                if (skip_index >= 0) {
+                    gdn_raw_skip_node[skip_index] = 1;
+                }
+            }
+        }
+    }
+    std::vector<ssm_conv_cache_plan> ssm_conv_cache_plans;
+    std::vector<const ssm_conv_cache_plan *> ssm_conv_cache_plan_by_node(cgraph->n_nodes, nullptr);
+    std::vector<uint8_t> ssm_conv_cache_skip_node(cgraph->n_nodes, 0);
+    if (g_ggml_sycl_fuse_ssm_conv_cache) {
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            if (cgraph->nodes[i]->op != GGML_OP_SSM_CONV) {
+                continue;
+            }
+            ssm_conv_cache_plan plan = {};
+            if (ssm_conv_cache_match(*sycl_ctx, cgraph, cgraph->nodes[i], &plan)) {
+                ssm_conv_cache_plans.push_back(plan);
+            }
+        }
+        for (const ssm_conv_cache_plan & plan : ssm_conv_cache_plans) {
+            const int conv_index = gdn_node_index(cgraph, plan.conv);
+            if (conv_index >= 0) {
+                ssm_conv_cache_plan_by_node[conv_index] = &plan;
+            }
+            for (int write = 0; write < plan.cache.count; ++write) {
+                const int cpy_index = gdn_node_index(cgraph, plan.cpys[write]);
+                if (cpy_index >= 0) {
+                    ssm_conv_cache_skip_node[cpy_index] = 1;
+                }
+            }
+        }
+    }
+    std::vector<ssm_conv_qk_norm_plan> ssm_conv_qk_norm_plans;
+    std::vector<const ssm_conv_qk_norm_plan *> ssm_conv_qk_norm_plan_by_node(cgraph->n_nodes, nullptr);
+    std::vector<uint8_t> ssm_conv_qk_norm_skip_node(cgraph->n_nodes, 0);
+    if (g_ggml_sycl_fuse_ssm_conv_qk_norm) {
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            if (cgraph->nodes[i]->op != GGML_OP_SSM_CONV) {
+                continue;
+            }
+            ssm_conv_qk_norm_plan plan = {};
+            if (ssm_conv_qk_norm_match(*sycl_ctx, cgraph, cgraph->nodes[i], &plan)) {
+                ssm_conv_qk_norm_plans.push_back(plan);
+            }
+        }
+        for (const ssm_conv_qk_norm_plan & plan : ssm_conv_qk_norm_plans) {
+            const int conv_index = gdn_node_index(cgraph, plan.conv);
+            if (conv_index >= 0) {
+                ssm_conv_qk_norm_plan_by_node[conv_index] = &plan;
+            }
+            const ggml_tensor * skipped[] = { plan.silu, plan.q_norm, plan.k_norm };
+            for (const ggml_tensor * tensor : skipped) {
+                const int index = gdn_node_index(cgraph, tensor);
+                if (index >= 0) {
+                    ssm_conv_qk_norm_skip_node[index] = 1;
+                }
+            }
+        }
+    }
+    std::vector<q6_m6_top1_plan> q6_top1_plans;
+    std::vector<const q6_m6_top1_plan *> q6_top1_plan_by_node(cgraph->n_nodes, nullptr);
+    std::vector<uint8_t> q6_top1_skip_node(cgraph->n_nodes, 0);
+    if (ggml_sycl_xe2_q6_m6_top1_enabled()) {
+        q6_top1_plans.reserve(cgraph->n_nodes);
+        for (int i = 0; i < cgraph->n_nodes; ++i) {
+            if (cgraph->nodes[i]->op != GGML_OP_MUL_MAT) {
+                continue;
+            }
+            q6_m6_top1_plan plan = {};
+            if (q6_m6_top1_match(*sycl_ctx, cgraph, cgraph->nodes[i], &plan)) {
+                q6_top1_plans.push_back(plan);
+            }
+        }
+        for (const q6_m6_top1_plan & plan : q6_top1_plans) {
+            const int mul_mat_index = gdn_node_index(cgraph, plan.mul_mat);
+            if (mul_mat_index >= 0) {
+                q6_top1_plan_by_node[mul_mat_index] = &plan;
+            }
+        }
+    }
+
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        ggml_tensor * node = cgraph->nodes[i];
+        if (q6_top1_skip_node[i]) {
+            continue;
+        }
+        if (ggml_is_empty(node) || node->op == GGML_OP_RESHAPE || node->op == GGML_OP_TRANSPOSE || node->op == GGML_OP_VIEW || node->op == GGML_OP_PERMUTE || node->op == GGML_OP_NONE) {
+            continue;
+        }
+        if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        const q6_m6_top1_plan * q6_top1_plan = q6_top1_plan_by_node[i];
+        if (q6_top1_plan && q6_m6_top1_dispatch(*sycl_ctx, *q6_top1_plan)) {
+            const int argmax_index = gdn_node_index(cgraph, q6_top1_plan->argmax);
+            GGML_ASSERT(argmax_index >= 0);
+            q6_top1_skip_node[argmax_index] = 1;
+            continue;
+        }
+        if (i + 1 < cgraph->n_nodes &&
+                ggml_sycl_try_xe2_q4_m6_gate_up(*sycl_ctx, node, cgraph->nodes[i + 1])) {
+            ++i;
+            continue;
+        }
+        sycl_op_timer op_timer(sycl_ctx, node, i);
+        const gdn_raw_gate_plan * raw_gate_plan = gdn_raw_plan_by_node[i];
+        const gdn_epilogue_match * epilogue_plan = gdn_epilogue_plan_by_node[i];
+        const ssm_conv_cache_plan * conv_cache_plan = ssm_conv_cache_plan_by_node[i];
+        const ssm_conv_qk_norm_plan * conv_qk_norm_plan = ssm_conv_qk_norm_plan_by_node[i];
+        if (ssm_conv_cache_skip_node[i]) {
+            continue;
+        }
+        if (ssm_conv_qk_norm_skip_node[i]) {
+            continue;
+        }
+        if (gdn_epilogue_skip_node[i]) {
+            continue;
+        }
+        if (epilogue_plan != nullptr) {
+            g_gdn_epilogue_q8_fusion = {};
+            g_gdn_epilogue_q8_fusion.consumer = epilogue_plan->consumer;
+            g_gdn_epilogue_q8_fusion.input = epilogue_plan->input;
+            g_gdn_epilogue_q8_fusion.weight = epilogue_plan->weight;
+            g_gdn_epilogue_q8_fusion.gate = epilogue_plan->gate;
+            g_gdn_epilogue_q8_fusion.scratch = epilogue_plan->scratch;
+            g_gdn_epilogue_q8_fusion.scratch_bytes = epilogue_plan->scratch_bytes;
+            g_gdn_epilogue_q8_fusion.norm_cols = epilogue_plan->ncols;
+            g_gdn_epilogue_q8_fusion.reorder = epilogue_plan->reorder;
+            g_gdn_epilogue_q8_fusion.eps = epilogue_plan->eps;
+        }
+        if (gdn_raw_skip_node[i]) {
+            continue;
+        }
+        if (raw_gate_plan != nullptr) {
+            ggml_sycl_gated_delta_net_fused_cache fused_cache = {};
+            const int nodes_to_skip = g_ggml_sycl_fuse_gdn_cache ?
+                gdn_cache_match(*sycl_ctx, cgraph, i, &fused_cache) : 0;
+            ggml_sycl_op_gated_delta_net_raw_gates(
+                *sycl_ctx, node, raw_gate_plan->gates, nodes_to_skip > 0 ? &fused_cache : nullptr);
+            ++gdn_raw_gate_fused_count;
+            if (mmvq_add_log_count(gdn_raw_gate_fused_count)) {
+                GGML_LOG_INFO("%s: GDN raw alpha/beta fused=%" PRIu64 "\n",
+                              __func__, gdn_raw_gate_fused_count);
+            }
+            i += nodes_to_skip;
+            continue;
+        }
+        if (g_ggml_sycl_fuse_gdn_cache && node->op == GGML_OP_GATED_DELTA_NET) {
+            ggml_sycl_gated_delta_net_fused_cache fused_cache = {};
+            const int nodes_to_skip = gdn_cache_match(*sycl_ctx, cgraph, i, &fused_cache);
+            if (nodes_to_skip > 0) {
+                ggml_sycl_op_gated_delta_net_fused_cache(*sycl_ctx, node, fused_cache);
+                i += nodes_to_skip;
+                continue;
+            }
+        }
+        if (conv_qk_norm_plan != nullptr) {
+            const ggml_sycl_ssm_conv_cache empty_cache = {};
+            const ggml_sycl_ssm_conv_cache & cache = conv_cache_plan != nullptr ?
+                conv_cache_plan->cache : empty_cache;
+            ggml_sycl_ssm_conv_silu_qk_norm(
+                *sycl_ctx, node, conv_qk_norm_plan->silu, conv_qk_norm_plan->q_norm,
+                conv_qk_norm_plan->k_norm, conv_qk_norm_plan->head_dim,
+                conv_qk_norm_plan->q_heads, conv_qk_norm_plan->k_heads,
+                conv_qk_norm_plan->q_eps, conv_qk_norm_plan->k_eps, cache);
+            ++ssm_conv_qk_norm_fused_count;
+            if (conv_cache_plan != nullptr) {
+                ++ssm_conv_cache_fused_count;
+            }
+            if (mmvq_add_log_count(ssm_conv_qk_norm_fused_count)) {
+                GGML_LOG_INFO("%s: SSM_CONV+SiLU+QK L2 fused=%" PRIu64 " cache_writes=%d\n",
+                              __func__, ssm_conv_qk_norm_fused_count, cache.count);
+            }
+            continue;
+        }
+        if (conv_cache_plan != nullptr) {
+            ggml_tensor * output = node;
+            bool apply_silu = false;
+            if (g_ggml_sycl_fuse_ssm_conv_silu && i + 1 < cgraph->n_nodes) {
+                ggml_tensor * silu = cgraph->nodes[i + 1];
+                if (silu->op == GGML_OP_UNARY && ggml_get_unary_op(silu) == GGML_UNARY_OP_SILU &&
+                    silu->src[0] == node && ggml_node_get_use_count(cgraph, i) == 1 &&
+                    silu->type == GGML_TYPE_F32 && ggml_are_same_shape(node, silu) &&
+                    ggml_is_contiguous(node) && ggml_is_contiguous(silu)) {
+                    output = silu;
+                    apply_silu = true;
+                    ++i;
+                }
+            }
+            ggml_sycl_ssm_conv_fused_cache(*sycl_ctx, node, output, conv_cache_plan->cache, apply_silu);
+            ++ssm_conv_cache_fused_count;
+            if (mmvq_add_log_count(ssm_conv_cache_fused_count)) {
+                GGML_LOG_INFO("%s: SSM_CONV recurrent cache fused=%" PRIu64 " writes=%d silu=%d\n",
+                              __func__, ssm_conv_cache_fused_count, conv_cache_plan->cache.count,
+                              apply_silu ? 1 : 0);
+            }
+            continue;
+        }
+        if (g_ggml_sycl_fuse_ssm_conv_silu && node->op == GGML_OP_SSM_CONV &&
+            i + 1 < cgraph->n_nodes) {
+            ggml_tensor * silu = cgraph->nodes[i + 1];
+            if (silu->op == GGML_OP_UNARY && ggml_get_unary_op(silu) == GGML_UNARY_OP_SILU &&
+                silu->src[0] == node && ggml_node_get_use_count(cgraph, i) == 1 &&
+                node->type == GGML_TYPE_F32 && silu->type == GGML_TYPE_F32 &&
+                ggml_are_same_shape(node, silu) && ggml_is_contiguous(node) && ggml_is_contiguous(silu)) {
+                ggml_sycl_ssm_conv_silu(*sycl_ctx, node, silu);
+                ++i;
+                continue;
+            }
+        }
+        if (g_ggml_sycl_fuse_swiglu_q8 && node->op == GGML_OP_GLU &&
+            ggml_get_glu_op(node) == GGML_GLU_OP_SWIGLU && i + 1 < cgraph->n_nodes) {
+            const ggml_tensor * swiglu_value = node;
+            int down_index = i + 1;
+            while (down_index < cgraph->n_nodes) {
+                ggml_tensor * candidate = cgraph->nodes[down_index];
+                if (swiglu_q8_identity_metadata(candidate, swiglu_value) &&
+                    ggml_node_get_use_count(cgraph, down_index - 1) == 1) {
+                    swiglu_value = candidate;
+                    ++down_index;
+                    continue;
+                }
+                break;
+            }
+            ggml_tensor * down = down_index < cgraph->n_nodes ? cgraph->nodes[down_index] : nullptr;
+            const bool split_sources = node->src[1] != nullptr;
+            const bool source_shape = split_sources ?
+                (node->src[1]->type == GGML_TYPE_F32 && ggml_is_contiguous(node->src[1]) &&
+                 ggml_nelements(node) == ggml_nelements(node->src[0]) &&
+                 ggml_nelements(node) == ggml_nelements(node->src[1])) :
+                (node->src[0]->ne[0] == 2 * node->ne[0] && ggml_nrows(node->src[0]) == ggml_nrows(node));
+            const bool eligible = node->src[0] != nullptr && node->type == GGML_TYPE_F32 &&
+                node->src[0]->type == GGML_TYPE_F32 && ggml_is_contiguous(node) &&
+                ggml_is_contiguous(node->src[0]) && source_shape && node->ne[0] % QK8_1 == 0 &&
+                ggml_node_get_use_count(cgraph, i) == 1 && down != nullptr && down->op == GGML_OP_MUL_MAT &&
+                down->src[1] == swiglu_value && (down->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 &&
+                mmvq_add_would_use_mmvq(*sycl_ctx, down);
+            if (eligible) {
+                g_swiglu_q8_fusion.consumer = down;
+                const int32_t swapped = reinterpret_cast<const int32_t *>(node->op_params)[1];
+                const float * src0 = static_cast<const float *>(node->src[0]->data);
+                g_swiglu_q8_fusion.gate = src0 + (!split_sources && swapped ? node->ne[0] : 0);
+                g_swiglu_q8_fusion.up = split_sources ? static_cast<const float *>(node->src[1]->data) :
+                    src0 + (swapped ? 0 : node->ne[0]);
+                g_swiglu_q8_fusion.input_stride = split_sources ? node->ne[0] : 2 * node->ne[0];
+                i = down_index;
+                node = down;
+            }
+        }
+        if (g_ggml_sycl_fuse_mmvq_add_rms_q8 && node->op == GGML_OP_RMS_NORM) {
+            int first_consumer_index = -1;
+            std::array<ggml_tensor *, 3> consumers = {};
+            int consumer_count = 0;
+            const float * source = nullptr;
+            const float * weight = nullptr;
+            void * scratch = nullptr;
+            size_t scratch_bytes = 0;
+            bool reorder = false;
+            float eps = 0.0f;
+            const mmvq_add_rms_q8_reject reason =
+                mmvq_add_rms_q8_eligible(*sycl_ctx, cgraph, i, last_fused_add, &first_consumer_index,
+                                          &consumers, &consumer_count, &source, &weight, &scratch,
+                                          &scratch_bytes, &reorder, &eps);
+            last_fused_add = nullptr;
+            if (reason == mmvq_add_rms_q8_reject::none) {
+                ++rms_q8_eligible_count;
+                g_rms_q8_fusion = {};
+                std::copy_n(consumers.begin(), consumer_count, g_rms_q8_fusion.consumers);
+                g_rms_q8_fusion.consumer_count = consumer_count;
+                g_rms_q8_fusion.source = source;
+                g_rms_q8_fusion.weight = weight;
+                g_rms_q8_fusion.scratch = scratch;
+                g_rms_q8_fusion.scratch_bytes = scratch_bytes;
+                g_rms_q8_fusion.reorder = reorder;
+                g_rms_q8_fusion.eps = eps;
+                if (mmvq_add_log_count(rms_q8_eligible_count)) {
+                    GGML_LOG_INFO("%s: MMVQ+ADD+RMS+Q8 eligible=%" PRIu64 " consumers=%d\n",
+                                  __func__, rms_q8_eligible_count, consumer_count);
+                }
+                i = first_consumer_index - 1;
+                continue;
+            }
+            const int reason_index = static_cast<int>(reason);
+            ++rms_q8_rejected_count[reason_index];
+            if (mmvq_add_log_count(rms_q8_rejected_count[reason_index])) {
+                GGML_LOG_INFO("%s: MMVQ+ADD+RMS+Q8 rejected=%s count=%" PRIu64 "\n", __func__,
+                              mmvq_add_rms_q8_reject_name(reason), rms_q8_rejected_count[reason_index]);
+            }
+        }
+        if (g_ggml_sycl_fuse_mmvq_add && mmvq_add_candidate(node)) {
+            int add_index = -1;
+            const ggml_tensor * residual = nullptr;
+            const mmvq_add_reject reason = mmvq_add_eligible(*sycl_ctx, cgraph, i, &add_index, &residual);
+            if (reason == mmvq_add_reject::none) {
+                ++eligible_count;
+                const bool fused_rms_q8 = rms_q8_is_current_consumer(node);
+                ggml_sycl_mul_mat_add(*sycl_ctx, node, residual, cgraph->nodes[add_index]);
+                if (swiglu_q8_is_current_consumer(node)) {
+                    GGML_ASSERT(g_swiglu_q8_fusion.quantized);
+                    ++swiglu_q8_fused_count;
+                    if (mmvq_add_log_count(swiglu_q8_fused_count)) {
+                        GGML_LOG_INFO("%s: SWIGLU+Q8 fused=%" PRIu64 " layout=%s via=MMVQ+ADD\n", __func__,
+                                      swiglu_q8_fused_count,
+                                      g_swiglu_q8_fusion.reorder ? "reordered" : "standard");
+                    }
+                    g_swiglu_q8_fusion = {};
+                }
+                if (gdn_epilogue_q8_is_current_consumer(node)) {
+                    GGML_ASSERT(g_gdn_epilogue_q8_fusion.quantized);
+                    ++gdn_epilogue_fused_count;
+                    if (mmvq_add_log_count(gdn_epilogue_fused_count)) {
+                        GGML_LOG_INFO("%s: GDN epilogue+Q8 fused=%" PRIu64 " layout=%s via=MMVQ+ADD\n", __func__,
+                                      gdn_epilogue_fused_count,
+                                      g_gdn_epilogue_q8_fusion.reorder ? "reordered" : "standard");
+                    }
+                    g_gdn_epilogue_q8_fusion = {};
+                }
+                if (fused_rms_q8) {
+                    GGML_ASSERT(g_rms_q8_fusion.quantized);
+                    ++g_rms_q8_fusion.consumer_index;
+                    ++rms_q8_fused_count;
+                    if (mmvq_add_log_count(rms_q8_fused_count)) {
+                        GGML_LOG_INFO("%s: MMVQ+ADD+RMS+Q8 fused=%" PRIu64 " layout=%s via=MMVQ+ADD\n", __func__,
+                                      rms_q8_fused_count,
+                                      g_rms_q8_fusion.reorder ? "reordered" : "standard");
+                    }
+                    if (g_rms_q8_fusion.consumer_index == g_rms_q8_fusion.consumer_count) {
+                        g_rms_q8_fusion = {};
+                    }
+                }
+                last_fused_add = cgraph->nodes[add_index];
+                ++fused_count;
+                if (mmvq_add_log_count(fused_count)) {
+                    GGML_LOG_INFO("%s: MMVQ+ADD eligible=%" PRIu64 " fused=%" PRIu64 "\n",
+                                  __func__, eligible_count, fused_count);
+                }
+                i = add_index;
+                continue;
+            }
+            const int reason_index = static_cast<int>(reason);
+            ++rejected_count[reason_index];
+            if (g_ggml_sycl_debug && !rejection_detail_logged[reason_index]) {
+                rejection_detail_logged[reason_index] = true;
+                mmvq_add_log_rejection_detail(cgraph, i, reason);
+            }
+            if (mmvq_add_log_count(rejected_count[reason_index])) {
+                GGML_LOG_INFO("%s: MMVQ+ADD rejected=%s count=%" PRIu64 "\n", __func__,
+                              mmvq_add_reject_name(reason), rejected_count[reason_index]);
+            }
+        }
+        last_fused_add = nullptr;
+#ifndef NDEBUG
+        assert(node->buffer->buft == ggml_backend_sycl_buffer_type(sycl_ctx->device));
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            if (node->src[j] != nullptr) {
+                assert(node->src[j]->buffer->buft == ggml_backend_sycl_buffer_type(sycl_ctx->device));
+            }
+        }
+#endif
+        const bool fused_rms_q8 = rms_q8_is_current_consumer(node);
+        bool ok = ggml_sycl_compute_forward(*sycl_ctx, node);
+        if (swiglu_q8_is_current_consumer(node)) {
+            GGML_ASSERT(g_swiglu_q8_fusion.quantized);
+            ++swiglu_q8_fused_count;
+            if (mmvq_add_log_count(swiglu_q8_fused_count)) {
+                GGML_LOG_INFO("%s: SWIGLU+Q8 fused=%" PRIu64 " layout=%s via=MUL_MAT\n", __func__,
+                              swiglu_q8_fused_count,
+                              g_swiglu_q8_fusion.reorder ? "reordered" : "standard");
+            }
+            g_swiglu_q8_fusion = {};
+        }
+        if (gdn_epilogue_q8_is_current_consumer(node)) {
+            GGML_ASSERT(g_gdn_epilogue_q8_fusion.quantized);
+            ++gdn_epilogue_fused_count;
+            if (mmvq_add_log_count(gdn_epilogue_fused_count)) {
+                GGML_LOG_INFO("%s: GDN epilogue+Q8 fused=%" PRIu64 " layout=%s via=MUL_MAT\n", __func__,
+                              gdn_epilogue_fused_count,
+                              g_gdn_epilogue_q8_fusion.reorder ? "reordered" : "standard");
+            }
+            g_gdn_epilogue_q8_fusion = {};
+        }
+        if (fused_rms_q8) {
+            GGML_ASSERT(g_rms_q8_fusion.quantized);
+            ++g_rms_q8_fusion.consumer_index;
+            ++rms_q8_fused_count;
+            if (mmvq_add_log_count(rms_q8_fused_count)) {
+                GGML_LOG_INFO("%s: MMVQ+ADD+RMS+Q8 fused=%" PRIu64 " layout=%s via=MUL_MAT\n", __func__,
+                              rms_q8_fused_count,
+                              g_rms_q8_fusion.reorder ? "reordered" : "standard");
+            }
+            if (g_rms_q8_fusion.consumer_index == g_rms_q8_fusion.consumer_count) {
+                g_rms_q8_fusion = {};
+            }
+        }
+        if (!ok) {
+            GGML_LOG_ERROR("%s: error: op not supported %s (%s)\n", __func__, node->name, ggml_op_name(node->op));
+        }
+        GGML_ASSERT(ok);
+    }
+}
