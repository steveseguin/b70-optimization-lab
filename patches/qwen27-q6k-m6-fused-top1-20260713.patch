+            if (int(item.get_local_id(0)) < rows) {
+                const int row = int(item.get_local_id(0));
+                ggml_sycl_q6_top1_pair best{-INFINITY,
+                        int32_t(item.get_group(0)*subgroups_per_wg)};
+                for (int subgroup_id = 0; subgroup_id < subgroups_per_wg; ++subgroup_id) {
+                    const int id = int(item.get_group(0))*subgroups_per_wg + subgroup_id;
+                    const float value = local[subgroup_id*rows + row];
+                    if (id < n && (value > best.value || (value == best.value && id < best.id))) {
+                        best = {value, id};
+                    }
+                }
+                partial[size_t(row)*groups + item.get_group(0)] = best;
+            }
+        });
+    });
+}
+
+static sycl::event ggml_sycl_q6_k_xe2_m6_top1_reduce(
+        sycl::queue & queue, const ggml_sycl_q6_top1_pair * partial,
+        int32_t * result, int groups) {
+    constexpr int rows = 5;
+    constexpr int wg = 256;
+    return queue.submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> local_values(wg, cgh);
+        sycl::local_accessor<int32_t, 1> local_ids(wg, cgh);
+        cgh.parallel_for<ggml_sycl_q6_k_xe2_m6_top1_reduce_kernel>(
+                sycl::nd_range<1>(rows*wg, wg), [=](sycl::nd_item<1> item) {
+            const int row = int(item.get_group(0));
+            const int lane = int(item.get_local_id(0));
+            ggml_sycl_q6_top1_pair best{-INFINITY, INT32_MAX};
+            for (int group = lane; group < groups; group += wg) {
+                const auto candidate = partial[size_t(row)*groups + group];
+                if (candidate.value > best.value ||
+                        (candidate.value == best.value && candidate.id < best.id)) {
+                    best = candidate;
+                }
+            }
+            local_values[lane] = best.value;
+            local_ids[lane] = best.id;
+            item.barrier(sycl::access::fence_space::local_space);
+            for (int step = wg/2; step > 0; step /= 2) {
+                if (lane < step && (local_values[lane + step] > local_values[lane] ||
+                        (local_values[lane + step] == local_values[lane] &&
+                         local_ids[lane + step] < local_ids[lane]))) {
+                    local_values[lane] = local_values[lane + step];
+                    local_ids[lane] = local_ids[lane + step];
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+            }
+            if (lane == 0) {
+                result[row] = local_ids[0];
+            }
+        });
+    });
+}
+
+bool ggml_sycl_mul_mat_q6_k_xe2_m6_top1(
+        ggml_backend_sycl_context & ctx,
+        const void * packed_weights,
+        size_t packed_weights_bytes,
+        const float * src,
+        int32_t * dst,
+        int k,
+        int n,
+        dpct::queue_ptr stream) {
+    if (!packed_weights || !src || !dst || !stream || k <= 0 || n <= 0 ||
+            k%256 != 0 || n%32 != 0) {
+        return false;
+    }
+    const size_t quant_bytes = size_t(k)*n;
+    const size_t scale_bytes = size_t(k/16)*n;
+    const size_t d_bytes = size_t(k/256)*n*sizeof(uint16_t);
+    if (packed_weights_bytes != quant_bytes + scale_bytes + d_bytes) {
+        return false;
+    }
+
+    constexpr int rows = 5;
+    constexpr int subgroups_per_wg = 32;
+    const int groups = (n + subgroups_per_wg - 1)/subgroups_per_wg;
+    const size_t activation_quant_bytes = size_t(rows)*k;
+    const size_t activation_scale_bytes = size_t(rows)*(k/32)*sizeof(sycl::half);
+    const size_t partial_bytes = size_t(rows)*groups*sizeof(ggml_sycl_q6_top1_pair);
+    ggml_sycl_pool_alloc<int8_t> scratch(
+            ctx.pool(ctx.device), activation_quant_bytes + activation_scale_bytes + partial_bytes);
+    if (!scratch.get()) {
+        return false;
+    }
+    int8_t * activation_quants = scratch.get();
+    auto * activation_scales = reinterpret_cast<sycl::half *>(
+            scratch.get() + activation_quant_bytes);
+    auto * partial = reinterpret_cast<ggml_sycl_q6_top1_pair *>(
+            scratch.get() + activation_quant_bytes + activation_scale_bytes);
+
+    const auto * weight_quants = static_cast<const int8_t *>(packed_weights);
+    const auto * weight_scales = weight_quants + quant_bytes;
+    const auto * weight_d = reinterpret_cast<const uint16_t *>(weight_scales + scale_bytes);
+    ggml_sycl_q6_k_xe2_m6_top1_quantize(
+            *stream, src, activation_quants, activation_scales, k);
+    ggml_sycl_q6_k_xe2_m6_top1_dot(
+            *stream, weight_quants, weight_scales, weight_d,
+            activation_quants, activation_scales, partial, k, n);
+    ggml_sycl_q6_k_xe2_m6_top1_reduce(*stream, partial, dst, groups);
+    return true;
+}
+
+struct ggml_sycl_q8_m6_meta {
+    float d;
+    float correction;
+};
+
+static sycl::event ggml_sycl_quantize_q8_xe2_m6_canonical(
+        sycl::queue & queue, const float * src, int8_t * dst, int k) {
+    constexpr int m = 6;
+    constexpr int lanes = WARP_SIZE;
+    constexpr int values_per_lane = QK8_1/WARP_SIZE;
+    static_assert(QK8_1%WARP_SIZE == 0);
+    const int kb = k/32;
+    const size_t soa_bytes = size_t(m)*k + size_t(m)*kb*sizeof(ggml_sycl_q8_m6_meta);
+    int8_t * canonical = dst + soa_bytes;
+    queue.submit([&](sycl::handler & cgh) {
+        cgh.parallel_for<ggml_sycl_q4_0_xe2_m6_canonical_quant_kernel>(
+                sycl::nd_range<1>(m*kb*lanes, lanes), [=](sycl::nd_item<1> item)
+                [[sycl::reqd_sub_group_size(lanes)]] {
+            const int block = item.get_group(0);
+            const int row   = block/kb;
+            const int ki    = block%kb;
+            const int lane  = item.get_local_id(0);
+            float values[values_per_lane];
+            float sum = 0.0f;
+            float amax = 0.0f;
+#pragma unroll
+            for (int j = 0; j < values_per_lane; ++j) {
+                const int element = lane*values_per_lane + j;
+                values[j] = src[size_t(row)*k + ki*32 + element];
+                sum += values[j];
+                amax = sycl::fmax(amax, sycl::fabs(values[j]));
+            }
+            const auto subgroup = item.get_sub_group();
+            amax = sycl::reduce_over_group(subgroup, amax, sycl::maximum<float>());
+            sum = sycl::reduce_over_group(subgroup, sum, sycl::plus<float>());
+            const float quant_d = amax != 0.0f ? amax/127.0f : 1.0f;
+#pragma unroll
+            for (int j = 0; j < values_per_lane; ++j) {
+                const int element = lane*values_per_lane + j;
+                const int q = int(sycl::round(values[j]/quant_d));
+                canonical[size_t(row)*(k + kb*4) + ki*32 + element] = int8_t(q);
+            }
+            if (lane == 0) {
+                auto * ds = reinterpret_cast<sycl::half2 *>(
+                        canonical + size_t(row)*(k + kb*4) + k + ki*4);
+                *ds = sycl::half2(sycl::half(amax != 0.0f ? quant_d : 0.0f), sycl::half(sum));
+            }
+        });
+    });
+    return queue.submit([&](sycl::handler & cgh) {
+        cgh.parallel_for<ggml_sycl_q4_0_xe2_m6_repack_kernel>(
+                sycl::nd_range<1>(m*kb*lanes, lanes), [=](sycl::nd_item<1> item)
+                [[sycl::reqd_sub_group_size(lanes)]] {
+            const int block = item.get_group(0);
+            const int row   = block/kb;
+            const int ki    = block%kb;
+            const int lane  = item.get_local_id(0);
+            int lane_qsum = 0;
+#pragma unroll
+            for (int j = 0; j < values_per_lane; ++j) {
+                const int element = lane*values_per_lane + j;
+                const int q = int(canonical[size_t(row)*(k + kb*4) + ki*32 + element]);
+                dst[(size_t(ki)*m + row)*32 + element] = int8_t(q);
+                lane_qsum += q;
+            }
+            const int qsum = sycl::reduce_over_group(
+                    item.get_sub_group(), lane_qsum, sycl::plus<int>());
+            if (lane == 0) {
+                const auto ds = *reinterpret_cast<const sycl::half2 *>(
+                        canonical + size_t(row)*(k + kb*4) + k + ki*4);
+                const float d = float(ds[0]);
+                const float sum = float(ds[1]);
+                auto * meta = reinterpret_cast<ggml_sycl_q8_m6_meta *>(dst + size_t(k)*m);
+                meta[ki*m + row] = {d, 8.0f*(qsum*d - sum)};
+            }
+        });
+    });
+}
+
+static sycl::event ggml_sycl_quantize_q8_xe2_m6_fast(
+        sycl::queue & queue, const float * src, int8_t * dst, int k) {
+    constexpr int m = 6;
+    constexpr int lanes = WARP_SIZE;
+    constexpr int values_per_lane = QK8_1/WARP_SIZE;
+    const int kb = k/32;
+    return queue.submit([&](sycl::handler & cgh) {
+        cgh.parallel_for<ggml_sycl_q4_0_xe2_m6_fast_quant_kernel>(
+                sycl::nd_range<1>(m*kb*lanes, lanes), [=](sycl::nd_item<1> item)
+                [[sycl::reqd_sub_group_size(lanes)]] {
+            const int block = item.get_group(0);
+            const int row   = block/kb;
+            const int ki    = block%kb;
+            const int lane  = item.get_local_id(0);
+            float values[values_per_lane];
+            float sum = 0.0f;
+            float amax = 0.0f;
+#pragma unroll
+            for (int j = 0; j < values_per_lane; ++j) {
+                const int element = lane*values_per_lane + j;
+                values[j] = src[size_t(row)*k + ki*32 + element];
+                sum += values[j];
+                amax = sycl::fmax(amax, sycl::fabs(values[j]));
+            }
+            const auto subgroup = item.get_sub_group();
+            amax = sycl::reduce_over_group(subgroup, amax, sycl::maximum<float>());
+            sum = sycl::reduce_over_group(subgroup, sum, sycl::plus<float>());
+            const float quant_d = amax != 0.0f ? amax/127.0f : 1.0f;
+            int lane_qsum = 0;
+#pragma unroll
+            for (int j = 0; j < values_per_lane; ++j) {
+                const int element = lane*values_per_lane + j;
+                const int q = int(sycl::round(values[j]/quant_d));
+                dst[(size_t(ki)*m + row)*32 + element] = int8_t(q);
+                lane_qsum += q;
+            }
+            const int qsum = sycl::reduce_over_group(subgroup, lane_qsum, sycl::plus<int>());
+            if (lane == 0) {
+                const float hd = float(sycl::half(amax != 0.0f ? quant_d : 0.0f));
+                const float hs = float(sycl::half(sum));
+                auto * meta = reinterpret_cast<ggml_sycl_q8_m6_meta *>(dst + size_t(k)*m);
+                meta[ki*m + row] = {hd, 8.0f*(qsum*hd - hs)};
+            }
+        });
+    });
+}
+
+static sycl::event ggml_sycl_q4_0_xe2_m6_slm(
+        sycl::queue & queue, const uint8_t * weights, const int8_t * activations,
+        float * dst, int k, int n) {
+    constexpr int m = 6;
+    constexpr int splits = 8;
+    constexpr int joint = 2;
+    constexpr int slm_floats = splits*joint*m*16;
+    const int kb = k/32;
+    const int nt = n/16;
+    const int pairs = (nt + joint - 1)/joint;
+    const size_t quant_bytes = size_t(k)*n/2;
+    const auto * weight_scales = reinterpret_cast<const sycl::half *>(weights + quant_bytes);
+    const auto * activation_meta = reinterpret_cast<const ggml_sycl_q8_m6_meta *>(
+            activations + size_t(k)*m);
+
+    return queue.submit([&](sycl::handler & cgh) {
+        cgh.parallel_for<ggml_sycl_q4_0_xe2_m6_slm_kernel>(
+                sycl::nd_range<2>(sycl::range<2>(pairs, splits), sycl::range<2>(1, splits)),
+                [=](sycl::nd_item<2> item) [[intel::sycl_explicit_simd]] {
+            ggml_sycl_esimd::slm_init<slm_floats*sizeof(float)>();
+            const int pair = int(item.get_group(0));
+            const int split = int(item.get_local_id(1));
+            const int tile0 = pair*joint;
+            ggml_sycl_esimd::simd<float, m*joint*16> accum(0.0f);
+
+            // Match production reordered MMVQ's eight strided K accumulator
+            // groups. Contiguous K chunks pass a loose single-projection
+            // tolerance but drift enough across the full decoder to destroy
+            // speculative acceptance.
+            for (int block = split; block < kb; block += splits) {
+                ggml_sycl_esimd::simd<uint32_t, m*8> av;
+                av.copy_from(reinterpret_cast<const uint32_t *>(activations) + size_t(block)*m*8);
+                for (int j = 0; j < joint; ++j) {
+                    const int tile = tile0 + j;
+                    if (tile >= nt) {
+                        continue;
+                    }
+                    ggml_sycl_esimd::simd<uint32_t, 64> bv;
+                    bv.copy_from(reinterpret_cast<const uint32_t *>(weights) +
+                                 (size_t(block)*nt + tile)*64);
+                    ggml_sycl_esimd::simd<int32_t, m*16> dot =
+                        ggml_sycl_xmx::dpas<8, m, int32_t, uint32_t, uint32_t,
+                            ggml_sycl_xmx::dpas_argument_type::s4,
+                            ggml_sycl_xmx::dpas_argument_type::s8>(bv, av);
+                    ggml_sycl_esimd::simd<sycl::half, 16> wh;
+                    wh.copy_from(weight_scales + size_t(block)*n + tile*16);
+                    const auto wf = ggml_sycl_esimd::convert<float>(wh);
+                    for (int row = 0; row < m; ++row) {
+                        ggml_sycl_esimd::simd<int32_t, 16> di =
+                            dot.template select<16, 1>(row*16);
+                        const auto & meta = activation_meta[block*m + row];
+                        accum.template select<16, 1>((j*m + row)*16) +=
+                            (ggml_sycl_esimd::convert<float>(di)*meta.d + meta.correction)*wf;
+                    }
+                }
+            }
+
+            for (int j = 0; j < joint; ++j) {
+                for (int row = 0; row < m; ++row) {
+                    const uint32_t offset = uint32_t(
+                            (((split*joint + j)*m + row)*16)*sizeof(float));
+                    ggml_sycl_esimd::slm_block_store<float, 16>(
+                            offset, accum.template select<16, 1>((j*m + row)*16));
+                }
+            }
+            ggml_sycl_esimd::barrier();
+            if (split == 0) {
+                for (int j = 0; j < joint; ++j) {
+                    const int tile = tile0 + j;
+                    if (tile >= nt) {
+                        continue;
+                    }
+                    for (int row = 0; row < m; ++row) {
+                        ggml_sycl_esimd::simd<float, 16> sum(0.0f);
+#pragma unroll
+                        for (int partial = 0; partial < splits; ++partial) {
+                            const uint32_t offset = uint32_t(
+                                    (((partial*joint + j)*m + row)*16)*sizeof(float));
+                            sum += ggml_sycl_esimd::slm_block_load<float, 16>(offset);
+                        }
+                        sum.copy_to(dst + size_t(row)*n + tile*16);
+                    }
+                }
+            }
+        });
+    });
+}
+
+static sycl::event ggml_sycl_q4_0_xe2_m6_slm_dual(
+        sycl::queue & queue, const uint8_t * weights_0, const uint8_t * weights_1,
+        const int8_t * activations, float * dst_0, float * dst_1, int k, int n) {
+    constexpr int m = 6;
+    constexpr int splits = 8;
+    constexpr int joint = 2;
+    constexpr int slm_floats = splits*joint*m*16;
+    const int kb = k/32;
+    const int nt = n/16;
+    const int pairs = (nt + joint - 1)/joint;
+    const size_t quant_bytes = size_t(k)*n/2;
+    const auto * activation_meta = reinterpret_cast<const ggml_sycl_q8_m6_meta *>(
+            activations + size_t(k)*m);
+
+    return queue.submit([&](sycl::handler & cgh) {
+        cgh.parallel_for<ggml_sycl_q4_0_xe2_m6_slm_dual_kernel>(
+                sycl::nd_range<2>(sycl::range<2>(2*pairs, splits), sycl::range<2>(1, splits)),
+                [=](sycl::nd_item<2> item) [[intel::sycl_explicit_simd]] {
+            ggml_sycl_esimd::slm_init<slm_floats*sizeof(float)>();
+            const int matrix = int(item.get_group(0))/pairs;
+            const int pair = int(item.get_group(0))%pairs;
+            const int split = int(item.get_local_id(1));
+            const int tile0 = pair*joint;
+            const uint8_t * weights = matrix == 0 ? weights_0 : weights_1;
+            float * dst = matrix == 0 ? dst_0 : dst_1;
+            const auto * weight_scales = reinterpret_cast<const sycl::half *>(weights + quant_bytes);
+            ggml_sycl_esimd::simd<float, m*joint*16> accum(0.0f);
+
+            for (int block = split; block < kb; block += splits) {
+                ggml_sycl_esimd::simd<uint32_t, m*8> av;
+                av.copy_from(reinterpret_cast<const uint32_t *>(activations) + size_t(block)*m*8);
+                for (int j = 0; j < joint; ++j) {
+                    const int tile = tile0 + j;
+                    if (tile >= nt) {
+                        continue;
+                    }
+                    ggml_sycl_esimd::simd<uint32_t, 64> bv;
+                    bv.copy_from(reinterpret_cast<const uint32_t *>(weights) +
+                                 (size_t(block)*nt + tile)*64);
+                    ggml_sycl_esimd::simd<int32_t, m*16> dot =
+                        ggml_sycl_xmx::dpas<8, m, int32_t, uint32_t, uint32_t,
+                            ggml_sycl_xmx::dpas_argument_type::s4,
+                            ggml_sycl_xmx::dpas_argument_type::s8>(bv, av);
+                    ggml_sycl_esimd::simd<sycl::half, 16> wh;
+                    wh.copy_from(weight_scales + size_t(block)*n + tile*16);
+                    const auto wf = ggml_sycl_esimd::convert<float>(wh);
+                    for (int row = 0; row < m; ++row) {
+                        ggml_sycl_esimd::simd<int32_t, 16> di =
+                            dot.template select<16, 1>(row*16);
+                        const auto & meta = activation_meta[block*m + row];
+                        accum.template select<16, 1>((j*m + row)*16) +=
+                            (ggml_sycl_esimd::convert<float>(di)*meta.d + meta.correction)*wf;
+                    }
+                }
+            }
+
+            for (int j = 0; j < joint; ++j) {
+                for (int row = 0; row < m; ++row) {
+                    const uint32_t offset = uint32_t(
+                            (((split*joint + j)*m + row)*16)*sizeof(float));
+                    ggml_sycl_esimd::slm_block_store<float, 16>(
+                            offset, accum.template select<16, 1>((j*m + row)*16));
+                }
+            }
+            ggml_sycl_esimd::barrier();
+            if (split == 0) {
+                for (int j = 0; j < joint; ++j) {
+                    const int tile = tile0 + j;
+                    if (tile >= nt) {
+                        continue;
+                    }
+                    for (int row = 0; row < m; ++row) {
+                        ggml_sycl_esimd::simd<float, 16> sum(0.0f);
+#pragma unroll
+                        for (int partial = 0; partial < splits; ++partial) {
+                            const uint32_t offset = uint32_t(
+                                    (((partial*joint + j)*m + row)*16)*sizeof(float));
+                            sum += ggml_sycl_esimd::slm_block_load<float, 16>(offset);
+                        }
+                        sum.copy_to(dst + size_t(row)*n + tile*16);
+                    }
+                }
+            }
+        });
+    });
+}
