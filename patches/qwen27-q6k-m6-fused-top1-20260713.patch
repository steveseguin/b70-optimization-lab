+#ifdef GGML_SYCL_GRAPH
+static bool should_log_graph_counter(uint64_t count) {
+    return count != 0 && (count & (count - 1)) == 0;
+}
+
+template<typename T>
+static void graph_signature_append(std::vector<uint8_t> & signature, const T & value) {
+    const uint8_t * bytes = reinterpret_cast<const uint8_t *>(&value);
+    signature.insert(signature.end(), bytes, bytes + sizeof(value));
+}
+
+static void graph_signature_append_tensor(std::vector<uint8_t> & signature, const ggml_tensor * tensor) {
+    graph_signature_append(signature, tensor);
+    if (tensor == nullptr) {
+        return;
+    }
+
+    graph_signature_append(signature, tensor->type);
+    graph_signature_append(signature, tensor->buffer);
+    graph_signature_append(signature, tensor->op);
+    graph_signature_append(signature, tensor->flags);
+    graph_signature_append(signature, tensor->view_src);
+    graph_signature_append(signature, tensor->view_offs);
+    graph_signature_append(signature, tensor->data);
+    graph_signature_append(signature, tensor->extra);
+    signature.insert(signature.end(), reinterpret_cast<const uint8_t *>(tensor->op_params),
+                     reinterpret_cast<const uint8_t *>(tensor->op_params) + sizeof(tensor->op_params));
+    for (int dim = 0; dim < GGML_MAX_DIMS; ++dim) {
+        graph_signature_append(signature, tensor->ne[dim]);
+        graph_signature_append(signature, tensor->nb[dim]);
+    }
+    if (tensor->extra != nullptr) {
+        const auto * extra = static_cast<const ggml_tensor_extra_gpu *>(tensor->extra);
+        for (int device = 0; device < GGML_SYCL_MAX_DEVICES; ++device) {
+            graph_signature_append(signature, extra->data_device[device]);
+        }
+        graph_signature_append(signature, extra->optimized_feature.reorder);
+    }
+}
+
+static std::vector<uint8_t> graph_signature(const ggml_cgraph * cgraph) {
+    std::vector<uint8_t> signature;
+    signature.reserve((size_t) cgraph->n_nodes * 256);
+    graph_signature_append(signature, cgraph->n_nodes);
+
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        graph_signature_append_tensor(signature, node);
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            graph_signature_append_tensor(signature, node->src[j]);
+        }
+    }
+
+    return signature;
+}
+
+static bool check_graph_compatibility(ggml_cgraph * cgraph) {
+    if (ggml_sycl_info().device_count > 1) {
+        // A sycl_ex::command_graph object can only be created for a single device
+        GGML_LOG_INFO("%s: disabling SYCL graphs due to multiple devices\n", __func__);
+        return false;
+    }
+
+    for (int i = 0; i < cgraph->n_nodes; i++) {
+        const ggml_op node_op = cgraph->nodes[i]->op;
+        switch (node_op) {
+            default:
+                break;
+            case GGML_OP_CONCAT: {
+                const ggml_tensor * node = cgraph->nodes[i];
+                const int32_t dim = ((const int32_t *) node->op_params)[0];
+
+                // Only the contiguous dim-3 path uses blocking memcpy waits. The
+                // dim-0/1/2 and non-contiguous paths submit capture-safe kernels.
+                if (dim != 3 || !ggml_is_contiguous(node->src[0]) || !ggml_is_contiguous(node->src[1])) {
+                    break;
+                }
+
+                GGML_LOG_INFO("%s: disabling SYCL graphs due to unsupported node type %s dim=%d\n", __func__,
+                              ggml_op_name(node_op), dim);
+                return false;
+            }
+            case GGML_OP_MUL_MAT_ID:
+                // ggml_sycl_mul_mat_id() does a blocking host wait on the sycl queue after
+                // submitting a memcpy operation, but wait() can't be called on a queue that
+                // is recording to a graph.
+                GGML_LOG_INFO("%s: disabling SYCL graphs due to unsupported node type %s\n", __func__,
+                              ggml_op_name(node_op));
+                return false;
+            case GGML_OP_MUL_MAT:
+                // We cannot use graphs with ggml_sycl_mul_mat() when SYCL async memory allocation extensions are not available,
+                // as SYCL malloc / free and host wait calls are not supported when recording to a graph which are all present
+                // in reordering.
+                if (!g_ggml_sycl_use_async_mem_op) {
+                    GGML_LOG_INFO(
+                        "%s: disabling SYCL graphs due to unsupported node type when using a compiler without the "
+                        "oneAPI async memory allocation extension "
+                        "%s\n",
+                        __func__, ggml_op_name(node_op));
+                    return false;
+                }
+        }
+    }
+    return true;
+}
+#endif
