+bool ggml_sycl_mul_mat_q4_0_xe2_m6(
+        ggml_backend_sycl_context & ctx,
+        const void * packed_weights,
+        size_t packed_weights_bytes,
+        const float * src,
+        float * dst,
+        int k,
+        int n,
+        dpct::queue_ptr stream) {
+    if (!packed_weights || !src || !dst || !stream || k <= 0 || n <= 0 ||
+            k%32 != 0 || n%32 != 0) {
+        return false;
+    }
+    const size_t expected_weights = size_t(k)*n/2 + size_t(k/32)*n*sizeof(sycl::half);
+    if (packed_weights_bytes != expected_weights) {
+        return false;
+    }
+    constexpr int m = 6;
+    const size_t soa_bytes = size_t(m)*k + size_t(m)*(k/32)*sizeof(ggml_sycl_q8_m6_meta);
+    const size_t canonical_bytes = k == 17408 ? size_t(m)*(k + (k/32)*4) : 0;
+    const size_t scratch_bytes = soa_bytes + canonical_bytes;
+    ggml_sycl_pool_alloc<int8_t> scratch(ctx.pool(ctx.device), scratch_bytes);
+    const char * compare = std::getenv("GGML_SYCL_XE2_Q4_M6_COMPARE");
+    const bool diagnostic = compare && std::strcmp(compare, "0") != 0;
+    if (diagnostic) {
+        stream->fill(dst, 123.0f, size_t(m)*n).wait();
+    }
+    sycl::event quant_event = k == 17408 ?
+            ggml_sycl_quantize_q8_xe2_m6_canonical(*stream, src, scratch.get(), k) :
+            ggml_sycl_quantize_q8_xe2_m6_fast(*stream, src, scratch.get(), k);
+    if (diagnostic) {
+        quant_event.wait_and_throw();
+        int8_t q_sample[32] = {};
+        ggml_sycl_q8_m6_meta activation_sample = {};
+        uint8_t weight_sample[32] = {};
+        sycl::half scale_sample[32] = {};
+        stream->memcpy(q_sample, scratch.get(), sizeof(q_sample));
+        stream->memcpy(&activation_sample, scratch.get() + size_t(m)*k, sizeof(activation_sample));
+        stream->memcpy(weight_sample, packed_weights, sizeof(weight_sample));
+        stream->memcpy(scale_sample,
+                static_cast<const uint8_t *>(packed_weights) + size_t(k)*n/2,
+                sizeof(scale_sample)).wait();
+        int q_nonzero = 0;
+        int weight_nonzero = 0;
+        int scale_nonzero = 0;
+        for (size_t i = 0; i < 32; ++i) {
+            q_nonzero += q_sample[i] != 0;
+            weight_nonzero += weight_sample[i] != 0;
+            scale_nonzero += float(scale_sample[i]) != 0.0f;
+        }
+        GGML_LOG_INFO(
