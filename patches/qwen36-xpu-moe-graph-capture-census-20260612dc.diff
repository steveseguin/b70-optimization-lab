+def _write_live_abi_record(path: str, record: dict, max_lines: int) -> bool:
+    global _live_abi_writes
+
+    try:
+        line = json.dumps(record, sort_keys=True)
+        with _live_abi_lock:
+            if _live_abi_writes >= max_lines:
+                return False
+            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+            with open(path, "a", encoding="utf-8") as handle:
+                handle.write(line + "\n")
+            _live_abi_writes += 1
+        return True
+    except Exception:
+        return False
+
+
+def _capture_safe_live_abi_record(*,
+                                  call_id,
+                                  diagnostic_context,
+                                  hidden_states,
+                                  w13,
+                                  w13_scales,
+                                  w2,
+                                  w2_scales,
+                                  topk_weights,
+                                  topk_ids,
+                                  output,
+                                  remapped_hidden_states,
+                                  rows_per_expert,
+                                  unpermuted_row_to_permuted_row,
+                                  gemm1_output,
+                                  gemm2_output,
+                                  int8_scratch,
+                                  num_rows,
+                                  hidden_size,
+                                  num_moe_inputs,
+                                  inter_size,
+                                  n_experts_per_token,
+                                  activation,
+                                  num_experts,
+                                  ep_rank,
+                                  ep_size,
+                                  is_int8,
+                                  capture_observation):
+    context = diagnostic_context or {}
+    tensor_map = {
+        "hidden_states": hidden_states,
+        "w13": w13,
+        "w13_scales": w13_scales,
+        "w2": w2,
+        "w2_scales": w2_scales,
+        "topk_weights": topk_weights,
+        "topk_ids": topk_ids,
+        "output": output,
+        "remapped_hidden_states": remapped_hidden_states,
+        "rows_per_expert": rows_per_expert,
+        "unpermuted_row_to_permuted_row": unpermuted_row_to_permuted_row,
+        "gemm1_output": gemm1_output,
+        "gemm2_output": gemm2_output,
+    }
+    if int8_scratch:
+        for name in ("gemm1_a", "gemm1_a_scales", "act_output",
+                     "gemm2_a", "gemm2_a_scales"):
+            tensor_map[name] = int8_scratch.get(name)
+
+    return {
+        "ts": time.time(),
+        "pid": os.getpid(),
+        "rank": os.environ.get("RANK", ""),
+        "local_rank": os.environ.get("LOCAL_RANK", ""),
+        "call": call_id,
+        "layer": str(context.get("layer", "")),
+        "context": context,
+        "stream_capture_active": True,
+        "capture_observation": capture_observation,
+        "shape": {
+            "num_rows": int(num_rows),
+            "hidden_size": int(hidden_size),
+            "topk": int(n_experts_per_token),
+            "num_moe_inputs": int(num_moe_inputs),
+            "inter_size": int(inter_size),
+            "num_experts": int(num_experts),
+            "ep_rank": int(ep_rank),
+            "ep_size": int(ep_size),
+            "activation": str(activation),
+            "is_int8": bool(is_int8),
+        },
+        "tensors": {
+            name: _tensor_meta(tensor)
+            for name, tensor in tensor_map.items()
+        },
+        "reason": (
+            "Stream capture is active; synchronous tensor copies/checksums are "
+            "not safe inside this call. Enable deferred capture samples for a "
+            "post-capture checksum probe."
+        ),
+    }
+
