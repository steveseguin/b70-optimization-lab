+def _schedule_deferred_live_abi_sample(*,
+                                       path,
+                                       max_lines,
+                                       call_id,
+                                       diagnostic_context,
+                                       topk_ids,
+                                       topk_weights,
+                                       output,
+                                       rows_per_expert,
+                                       gemm1_output,
+                                       gemm2_output):
+    global _live_abi_deferred_pending
+
+    max_pending = max(1, _int_env(LIVE_ABI_DEFER_CAPTURE_MAX_PENDING_ENV, 1))
+    with _live_abi_lock:
+        if _live_abi_writes >= max_lines:
+            return
+        if _live_abi_deferred_pending >= max_pending:
+            return
+        _live_abi_deferred_pending += 1
+
+    delay_ms = max(0, _int_env(LIVE_ABI_DEFER_CAPTURE_DELAY_MS_ENV, 50))
+    context = diagnostic_context or {}
+
+    def _worker():
+        global _live_abi_deferred_pending
+        try:
+            if delay_ms:
+                time.sleep(delay_ms / 1000.0)
+            if getattr(getattr(output, "device", None), "type", None) == "xpu":
+                try:
+                    torch.xpu.synchronize()
+                except Exception:
+                    pass
+            record = {
+                "ts": time.time(),
+                "pid": os.getpid(),
+                "rank": os.environ.get("RANK", ""),
+                "local_rank": os.environ.get("LOCAL_RANK", ""),
+                "call": call_id,
+                "layer": str(context.get("layer", "")),
+                "context": context,
+                "stream_capture_active": False,
+                "capture_observation": "deferred_post_capture_sample",
+                "delay_ms": delay_ms,
+                "samples": {
+                    "topk_ids": _tensor_sample(topk_ids, 32),
+                    "topk_weights": _tensor_sample(topk_weights, 32),
+                    "output": _tensor_sample(output, 32),
+                    "rows_per_expert": _tensor_sample(rows_per_expert, 64),
+                },
+                "checksums": {
+                    "output_sample_sum": _tensor_sample_sum(output, 64),
+                    "gemm1_output_sample_sum":
+                    _tensor_sample_sum(gemm1_output, 64),
+                    "gemm2_output_sample_sum":
+                    _tensor_sample_sum(gemm2_output, 64),
+                },
+            }
+            _write_live_abi_record(path, record, max_lines)
+        finally:
+            with _live_abi_lock:
+                _live_abi_deferred_pending = max(
+                    0, _live_abi_deferred_pending - 1)
+
+    thread = threading.Thread(
+        target=_worker,
+        name="xpu-moe-live-abi-deferred-sample",
+        daemon=True,
+    )
+    thread.start()
+
