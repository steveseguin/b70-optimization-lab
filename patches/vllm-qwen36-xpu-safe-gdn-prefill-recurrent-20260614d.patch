+def _xpu_gdn_trace_int_env(name: str, default: int) -> int:
+    try:
+        return int(os.environ.get(name, str(default)) or default)
+    except ValueError:
+        return default
+
+
+def _xpu_gdn_truthy_env(name: str) -> bool:
+    return os.environ.get(name, "").strip().lower() in ("1", "true", "yes", "on")
+
+
+def _xpu_gdn_fallback_modes(value: str) -> set[str]:
+    return {
+        part
+        for part in re.split(r"[\s,;]+", value.strip().lower())
+        if part
+    }
+
+
+def _xpu_gdn_layer_index(layer_name: str) -> int | None:
+    match = re.search(r"(?:^|\.)layers\.(\d+)(?:\.|$)", layer_name)
+    if not match:
+        return None
+    try:
+        return int(match.group(1))
+    except ValueError:
+        return None
+
+
+def _xpu_gdn_layer_list_match(layer_name: str, env_name: str) -> bool:
+    raw_value = os.environ.get(env_name, "").strip()
+    if not raw_value:
+        return False
+
+    layer_idx = _xpu_gdn_layer_index(layer_name)
+    layer_tail = layer_name.rsplit(".", 1)[-1]
+    for raw_part in raw_value.split(","):
+        part = raw_part.strip()
+        if not part:
+            continue
+        if part == layer_name or part == layer_tail:
+            return True
+        if layer_idx is None:
+            continue
+        try:
+            if "-" in part:
+                start_s, end_s = part.split("-", 1)
+                start = int(start_s.strip())
+                end = int(end_s.strip())
+                if start <= layer_idx <= end:
+                    return True
+            elif int(part) == layer_idx:
+                return True
+        except ValueError:
+            continue
+    return False
+
+
+def _xpu_gdn_decode_layer_fallback_enabled(layer_name: str) -> bool:
+    if _xpu_gdn_layer_list_match(
+        layer_name, "VLLM_XPU_GDN_NATIVE_FALLBACK_DECODE_LAYERS"
+    ):
+        return True
+
+    max_layer = _xpu_gdn_trace_int_env(
+        "VLLM_XPU_GDN_NATIVE_FALLBACK_DECODE_MAX_LAYER", -1
+    )
+    layer_idx = _xpu_gdn_layer_index(layer_name)
+    if max_layer >= 0 and layer_idx is not None and layer_idx <= max_layer:
+        return True
+
+    layer_regex = os.environ.get(
+        "VLLM_XPU_GDN_NATIVE_FALLBACK_DECODE_LAYER_REGEX", ""
+    )
+    if layer_regex:
+        try:
+            return re.search(layer_regex, layer_name) is not None
+        except re.error:
+            return False
+    return False
+
+
+def _xpu_gdn_trace_rank() -> int:
+    try:
+        from vllm.distributed import get_tensor_model_parallel_rank
+
+        return int(get_tensor_model_parallel_rank())
+    except Exception:
+        try:
+            return int(os.environ.get("LOCAL_RANK", "0") or "0")
+        except ValueError:
+            return 0
+
