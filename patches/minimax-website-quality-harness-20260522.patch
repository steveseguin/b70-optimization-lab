+def css_declaration_errors(style_text: str) -> list[str]:
+    """Catch malformed declarations that a brace-count check can miss."""
+    errors: list[str] = []
+    css = re.sub(r"/\*.*?\*/", "", style_text, flags=re.DOTALL)
+    block_count = 0
+    for block in re.findall(r"\{([^{}]*)\}", css, flags=re.DOTALL):
+        block_count += 1
+        for raw_decl in block.split(";"):
+            decl = raw_decl.strip()
+            if not decl:
+                continue
+            if decl.startswith("@"):
+                continue
+            if "{" in decl or "}" in decl:
+                errors.append(f"nested_brace_in_declaration:{decl[:80]}")
+                continue
+            if ":" not in decl:
+                errors.append(f"missing_colon:{decl[:80]}")
+                continue
+            prop, value = (part.strip() for part in decl.split(":", 1))
+            if not prop:
+                errors.append(f"empty_property:{decl[:80]}")
+                continue
+            if not re.match(r"^(--)?-?[A-Za-z_][A-Za-z0-9_-]*$", prop):
+                errors.append(f"invalid_property:{prop[:80]}")
+                continue
+            if not value:
+                errors.append(f"empty_value:{prop}")
+    if "{" in css and block_count == 0:
+        errors.append("no_parseable_css_blocks")
+    return errors
+
