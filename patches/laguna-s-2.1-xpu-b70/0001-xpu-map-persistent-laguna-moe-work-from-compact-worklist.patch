@@ -89,6 +89,9 @@ class GemmCuteGrf128DirectSchedulerName;
 template <typename, typename, typename, typename, char, char, class, bool>
 class GemmCuteGrf128DirectOffsetsName;
 
+template <typename, typename, typename, typename, char, char, class, bool>
+class GemmCuteGrf128PersistentWorklistName;
+
 template <typename, class, bool>
 class GemmM1TopkCuteName;
 
@@ -331,6 +334,26 @@ inline bool laguna_int4_decode_direct_offsets() {
   return enabled;
 }
 
+// Preserve the incumbent persistent atomic scheduler while replacing its
+// repeated expert-count scan with a compact global-M-tile worklist.
+inline bool laguna_int4_decode_persistent_worklist() {
+  static const bool enabled = [] {
+    const char* value =
+        std::getenv("VLLM_XPU_LAGUNA_DECODE_PERSISTENT_WORKLIST");
+    if (value == nullptr) return false;
+    if (std::strcmp(value, "0") == 0) return false;
+    if (std::strcmp(value, "1") == 0) return true;
+    TORCH_CHECK(
+        false,
+        "VLLM_XPU_LAGUNA_DECODE_PERSISTENT_WORKLIST must be literal 0 or 1, "
+        "got '",
+        value,
+        "'");
+    return false;
+  }();
+  return enabled;
+}
+
 // Range gate for the INT4 dequantize-scale fusion.
 //
 // The fused form evaluates `x * s + (-136 * s)` where the incumbent evaluates
@@ -476,9 +499,15 @@ void MoEGEMMLauncher(
       use_transposed_scales && laguna_int4_decode_direct_scheduler();
   const bool use_direct_offsets =
       use_transposed_scales && laguna_int4_decode_direct_offsets();
+  const bool use_persistent_worklist =
+      use_transposed_scales && laguna_int4_decode_persistent_worklist();
   TORCH_CHECK(
-      !(use_direct_scheduler && use_direct_offsets),
-      "direct scheduler and direct-offset scheduler are mutually exclusive");
+      static_cast<int>(use_direct_scheduler) +
+              static_cast<int>(use_direct_offsets) +
+              static_cast<int>(use_persistent_worklist) <=
+          1,
+      "direct scheduler, direct-offset scheduler, and persistent worklist "
+      "are mutually exclusive");
 
   using GmemTiledCopyA = typename policy::GmemTiledCopyA;
   using GmemTiledCopyB = typename policy::GmemTiledCopyB;
@@ -626,8 +655,54 @@ void MoEGEMMLauncher(
               true,
               false);
         };
+    auto persistent_worklist_kernel = [=](auto) {
+          MoE::MoEGEMM<
+              GmemTiledCopyA,
+              GmemTiledCopyB,
+              GmemTiledCopyD,
+              layoutA,
+              layoutB,
+              'R',
+              TileMajor,
+              true,
+              true,
+              false,
+              false,
+              true>(
+              activations,
+              weights,
+              scales,
+              bias,
+              outputs,
+              mma,
+              rows_per_expert,
+              num_experts,
+              group_size,
+              gemm_n,
+              gemm_k,
+              atomic_buffer,
+              local_mem,
+              false,
+              true,
+              false);
+        };
     if constexpr (can_use_grf128) {
-      if (use_direct_offsets) {
+      if (use_persistent_worklist) {
+        syclex::properties kernel_props_128{
+            syclex::sub_group_size<16>, intelex::grf_size<128>};
+        cgh.parallel_for<GemmCuteGrf128PersistentWorklistName<
+            ElementA,
+            ElementB,
+            ElementS,
+            ElementD,
+            layoutA,
+            layoutB,
+            policy,
+            TileMajor>>(
+            sycl::nd_range<3>{global * local, local},
+            kernel_props_128,
+            persistent_worklist_kernel);
+      } else if (use_direct_offsets) {
         syclex::properties kernel_props_128{
             syclex::sub_group_size<16>, intelex::grf_size<128>};
         cgh.parallel_for<GemmCuteGrf128DirectOffsetsName<
