Subject: [PATCH] Map persistent Laguna MoE work from a compact worklist

---
 .../grouped_gemm/xe_2/grouped_gemm_xe2.hpp    | 52 +++++++++---
 .../xe_2/grouped_gemm_xe2_interface.hpp       | 81 ++++++++++++++++++-
 2 files changed, 120 insertions(+), 13 deletions(-)

diff --git a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
index a809b26..80a430d 100644
--- a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
+++ b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
@@ -125,6 +125,7 @@ template <
     bool TransposedScales = false,
     bool DirectSchedule = false,
     bool DirectOffsets = false,
+    bool PersistentWorklist = false,
     class TiledMMA,
     typename ElementA,
     typename ElementB,
@@ -156,6 +157,9 @@ CUTE_DEVICE void MoEGEMM(
   static constexpr bool is_B_mxfp4 = (std::is_same_v<ElementB, uint8_t>) &&
                                      (std::is_same_v<ElementS, uint8_t>);
   static constexpr bool is_B_4bits = std::is_same_v<ElementB, uint8_t>;
+  static_assert(
+      !(PersistentWorklist && (DirectSchedule || DirectOffsets)),
+      "persistent worklist is mutually exclusive with direct schedulers");
 
   auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
   auto wg_tile = mma.tile_mnk();
@@ -188,13 +192,36 @@ CUTE_DEVICE void MoEGEMM(
           .get());
 
   for (int i = DirectOffsets ? direct_expert_id : 0; i < num_experts; ++i) {
-    int gemm_m = DirectOffsets
-        ? rows_per_expert[i + 1] - rows_per_expert[i]
-        : rows_per_expert[i];
-    int cumsum_rows_for_experts =
-        DirectOffsets ? rows_per_expert[i + 1] : pre_rows + gemm_m;
-    int cumsum_tiles_for_experts =
-        (gemm_m + wg_tile_m - 1) / wg_tile_m + pre_tiles;
+    int expert_id = i;
+    int gemm_m;
+    int cumsum_rows_for_experts;
+    int cumsum_tiles_for_experts;
+
+    if constexpr (PersistentWorklist) {
+      const int total_m_tiles = rows_per_expert[0];
+      if (group_m_id >= total_m_tiles) return;
+
+      // Compact metadata maps the persistent scheduler's global M-tile id to
+      // the expert-local tile without scanning all preceding experts:
+      //   [total_m_tiles,
+      //    expert_id, packed_row_offset, expert_rows, expert_m_tile, ...]
+      const int entry = 1 + 4 * group_m_id;
+      expert_id = rows_per_expert[entry];
+      pre_rows = rows_per_expert[entry + 1];
+      gemm_m = rows_per_expert[entry + 2];
+      const int expert_m_tile = rows_per_expert[entry + 3];
+      pre_tiles = group_m_id - expert_m_tile;
+      cumsum_rows_for_experts = pre_rows + gemm_m;
+      cumsum_tiles_for_experts = group_m_id + 1;
+    } else {
+      gemm_m = DirectOffsets
+          ? rows_per_expert[i + 1] - rows_per_expert[i]
+          : rows_per_expert[i];
+      cumsum_rows_for_experts =
+          DirectOffsets ? rows_per_expert[i + 1] : pre_rows + gemm_m;
+      cumsum_tiles_for_experts =
+          (gemm_m + wg_tile_m - 1) / wg_tile_m + pre_tiles;
+    }
 
     if constexpr (DirectSchedule) {
       if constexpr (DirectOffsets) {
@@ -216,7 +243,6 @@ CUTE_DEVICE void MoEGEMM(
       continue;
     }
 
-    int expert_id = i;
     int64_t B_offset = static_cast<int64_t>(expert_id) *
                        static_cast<int64_t>(gemm_n) *
                        static_cast<int64_t>(gemm_k);
@@ -351,8 +377,14 @@ CUTE_DEVICE void MoEGEMM(
         group_m_id = (group_id * wg_tile_n) / gemm_n_pad;
       }
     }
-    pre_rows = cumsum_rows_for_experts;
-    pre_tiles = cumsum_tiles_for_experts;
+    if constexpr (PersistentWorklist) {
+      // The atomic scheduler has advanced to a new global M tile. Re-enter
+      // with i == 0 and decode its compact metadata entry.
+      i = -1;
+    } else {
+      pre_rows = cumsum_rows_for_experts;
+      pre_tiles = cumsum_tiles_for_experts;
+    }
   }
 }
 
