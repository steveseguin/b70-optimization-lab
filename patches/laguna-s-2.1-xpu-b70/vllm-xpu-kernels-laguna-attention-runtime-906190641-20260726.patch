+void mhc_post_pre_m1_out(
+    const at::Tensor& x,
+    const at::Tensor& residual,
+    const at::Tensor& post_layer_mix,
+    const at::Tensor& comb_res_mix,
+    const at::Tensor& fn,
+    const at::Tensor& hc_scale,
+    const at::Tensor& hc_base,
+    at::Tensor& residual_out,
+    at::Tensor& next_post_mix,
+    at::Tensor& next_comb_mix,
+    at::Tensor& layer_input,
+    double rms_eps,
+    double hc_pre_eps,
+    double hc_sinkhorn_eps,
+    double hc_post_mult_value,
+    int64_t sinkhorn_repeat) {
+  constexpr const char* op = "mhc_post_pre_m1_out";
+  TORCH_CHECK(
+      x.is_xpu() && residual.is_xpu() && post_layer_mix.is_xpu() &&
+          comb_res_mix.is_xpu() && fn.is_xpu() && hc_scale.is_xpu() &&
+          hc_base.is_xpu() && residual_out.is_xpu() && next_post_mix.is_xpu() &&
+          next_comb_mix.is_xpu() && layer_input.is_xpu(),
+      op,
+      ": tensors must be XPU");
+  TORCH_CHECK(
+      x.scalar_type() == at::kBFloat16 &&
+          residual.scalar_type() == at::kBFloat16 &&
+          residual_out.scalar_type() == at::kBFloat16 &&
+          layer_input.scalar_type() == at::kBFloat16,
+      op,
+      ": x/residual/residual_out/layer_input must be bfloat16");
+  TORCH_CHECK(
+      post_layer_mix.scalar_type() == at::kFloat &&
+          comb_res_mix.scalar_type() == at::kFloat &&
+          fn.scalar_type() == at::kFloat &&
+          hc_scale.scalar_type() == at::kFloat &&
+          hc_base.scalar_type() == at::kFloat &&
+          next_post_mix.scalar_type() == at::kFloat &&
+          next_comb_mix.scalar_type() == at::kFloat,
+      op,
+      ": projection, mix, scale, base, and next-mix tensors must be float32");
+  TORCH_CHECK(
+      x.is_contiguous() && residual.is_contiguous() &&
+          post_layer_mix.is_contiguous() && comb_res_mix.is_contiguous() &&
+          fn.is_contiguous() && hc_scale.is_contiguous() &&
+          hc_base.is_contiguous() && residual_out.is_contiguous() &&
+          next_post_mix.is_contiguous() && next_comb_mix.is_contiguous() &&
+          layer_input.is_contiguous(),
+      op,
+      ": tensors must be contiguous");
+  TORCH_CHECK(
+      x.sizes() == at::IntArrayRef({1, 4096}) &&
+          residual.sizes() == at::IntArrayRef({1, 4, 4096}) &&
+          post_layer_mix.numel() == 4 && comb_res_mix.numel() == 16 &&
+          fn.sizes() == at::IntArrayRef({24, 16384}) && hc_scale.numel() == 3 &&
+          hc_base.numel() == 24 &&
+          residual_out.sizes() == at::IntArrayRef({1, 4, 4096}) &&
+          next_post_mix.numel() == 4 && next_comb_mix.numel() == 16 &&
+          layer_input.sizes() == at::IntArrayRef({1, 4096}),
+      op,
+      ": requires fixed H4096/HC4 M=1 tensors");
+  TORCH_CHECK(sinkhorn_repeat > 0, op, ": sinkhorn_repeat must be positive");
+
+  auto& queue = vllm::xpu::vllmGetQueue();
+  const char* rms_once_env =
+      std::getenv("VLLM_XPU_V4_MHC_REUSE_RMS_REDUCTION");
+  const bool reuse_rms_reduction = rms_once_env != nullptr &&
+      rms_once_env[0] == '1' && rms_once_env[1] == '\0';
+  if (reuse_rms_reduction) {
+    launch_mhc_pre_m1_fused<true, false, 1, true>(
+        queue,
+        nullptr,
+        fn.data_ptr<float>(),
+        hc_scale.data_ptr<float>(),
+        hc_base.data_ptr<float>(),
+        next_post_mix.data_ptr<float>(),
+        next_comb_mix.data_ptr<float>(),
+        reinterpret_cast<bf16*>(layer_input.data_ptr()),
+        static_cast<float>(rms_eps),
+        static_cast<float>(hc_pre_eps),
+        static_cast<float>(hc_sinkhorn_eps),
+        static_cast<float>(hc_post_mult_value),
+        static_cast<int>(sinkhorn_repeat),
+        reinterpret_cast<const bf16*>(x.data_ptr()),
+        reinterpret_cast<const bf16*>(residual.data_ptr()),
+        post_layer_mix.data_ptr<float>(),
+        comb_res_mix.data_ptr<float>(),
+        reinterpret_cast<bf16*>(residual_out.data_ptr()));
+    return;
+  }
+  launch_mhc_pre_m1_fused<true>(
+      queue,
+      nullptr,
+      fn.data_ptr<float>(),
+      hc_scale.data_ptr<float>(),
+      hc_base.data_ptr<float>(),
+      next_post_mix.data_ptr<float>(),
+      next_comb_mix.data_ptr<float>(),
+      reinterpret_cast<bf16*>(layer_input.data_ptr()),
+      static_cast<float>(rms_eps),
+      static_cast<float>(hc_pre_eps),
+      static_cast<float>(hc_sinkhorn_eps),
