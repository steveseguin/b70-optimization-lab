+// Fixed q<=8/top-k route GEMM for Laguna's symmetric INT4 experts. Each
+// [row,slot] route is an independent M=1 lane, so duplicate experts across
+// verifier rows cannot change the M tile or K reduction order.
+template <
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyD,
+    class TiledMMA,
+    typename TopkId,
+    bool RouteInterleave>
+CUTE_DEVICE void M8TopkInt4GEMM(
+    const bfloat16_t* Activations,
+    const uint8_t* Weights,
+    const bfloat16_t* Scales,
+    const bfloat16_t* Bias,
+    bfloat16_t* Outputs,
+    TiledMMA const& mma,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t num_rows,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k,
+    const bool broadcast_route_input,
+    const bool zero_remote_routes) {
+  auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+  auto wg_tile = mma.tile_mnk();
+  const int32_t wg_tile_n = get<1>(wg_tile);
+  const int32_t n_tiles = (gemm_n + wg_tile_n - 1) / wg_tile_n;
+  const int32_t group_id = item.get_group_linear_id();
+  const int32_t route_count = num_rows * topk;
+  // Candidate B changes only workgroup enumeration. Each workgroup still owns
+  // the identical (route, N tile), so INT4 dequantization, K traversal, FP32
+  // accumulation, and the BF16 store remain byte-for-byte unchanged.
+  const int32_t route = RouteInterleave
+      ? group_id - (group_id / route_count) * route_count
+      : group_id / n_tiles;
+  const int32_t n_coord = RouteInterleave
+      ? group_id / route_count
+      : group_id - route * n_tiles;
+  if (route >= route_count) return;
+
+  const int64_t global_expert = static_cast<int64_t>(topk_ids[route]);
+  int32_t local_expert = -1;
+  if (expert_map != nullptr) {
+    if (global_expert < 0 || global_expert >= expert_map_size) return;
+    local_expert = expert_map[global_expert];
+  } else {
+    if (global_expert < 0 || global_expert >= num_local_experts) return;
+    local_expert = static_cast<int32_t>(global_expert);
+  }
+  if (local_expert < 0 || local_expert >= num_local_experts) {
+    if (zero_remote_routes) {
+      const int32_t tile_begin = n_coord * wg_tile_n;
+      const int32_t tile_end = sycl::min(tile_begin + wg_tile_n, gemm_n);
+      const int32_t local_id = static_cast<int32_t>(item.get_local_linear_id());
+      const int32_t local_size =
+          static_cast<int32_t>(item.get_local_range().size());
+      for (int32_t column = tile_begin + local_id; column < tile_end;
+           column += local_size) {
+        Outputs[static_cast<int64_t>(route) * gemm_n + column] = bfloat16_t(0);
+      }
+    }
+    return;
+  }
+
+  constexpr int32_t group_size = 32;
+  const int64_t packed_weight_stride =
+      static_cast<int64_t>(gemm_n) * gemm_k / 2;
+  const int64_t scale_stride =
+      static_cast<int64_t>(gemm_n) * (gemm_k / group_size);
+  const int64_t activation_row =
+      broadcast_route_input ? route / topk : route;
+
+  auto A_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      const_cast<bfloat16_t*>(Activations) + activation_row * gemm_k,
+      1,
+      gemm_k);
+  auto B_tensor = make_moe_tensor<int4_t, 'R'>(
+      reinterpret_cast<int4_t*>(
+          const_cast<uint8_t*>(Weights) +
+          static_cast<int64_t>(local_expert) * packed_weight_stride),
+      gemm_n,
+      gemm_k);
+  auto D_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      Outputs + static_cast<int64_t>(route) * gemm_n, 1, gemm_n);
+
+  const bfloat16_t* expert_scales =
+      Scales + static_cast<int64_t>(local_expert) * scale_stride;
+  const bfloat16_t* expert_bias =
+      Bias == nullptr ? nullptr
+                      : Bias + static_cast<int64_t>(local_expert) * gemm_n;
+  auto tile_coord = make_coord(0, n_coord, _, 0);
+  xe_gemm_4bits<
+      GmemTiledCopyA,
+      GmemTiledCopyB,
+      GmemTiledCopyD,
+      group_size>(
+      A_tensor,
+      B_tensor,
+      expert_scales,
+      expert_bias,
+      D_tensor,
+      tile_coord,
+      mma);
+}
+
+// Laguna fixed-q<=8 W1 transaction. Pair the corresponding gate/up N tiles in
+// one workgroup, retain the ordinary INT4 GEMM's BF16 materialization for both
+// halves, then apply the same BF16 SiLU(gate) * up operation that the standalone
+// activation kernel uses. This removes one device launch without moving either
+// GEMM rounding boundary or changing the W2 input dtype/order.
+template <
+    class GmemTiledCopyA,
+    class GmemTiledCopyB,
+    class GmemTiledCopyD,
+    class TiledMMA,
+    typename TopkId,
+    bool RouteInterleave>
+CUTE_DEVICE void M8TopkInt4W1Silu(
+    const bfloat16_t* Activations,
+    const uint8_t* Weights,
+    const bfloat16_t* Scales,
+    const bfloat16_t* Bias,
+    bfloat16_t* Gemm1Outputs,
+    bfloat16_t* ActOutputs,
+    TiledMMA const& mma,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t num_rows,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k) {
+  auto item = sycl::ext::oneapi::this_work_item::get_nd_item<3>();
+  auto wg_tile = mma.tile_mnk();
+  const int32_t wg_tile_n = get<1>(wg_tile);
+  const int32_t act_n = gemm_n / 2;
+  const int32_t act_n_tiles = act_n / wg_tile_n;
+  const int32_t group_id = item.get_group_linear_id();
+  const int32_t route_count = num_rows * topk;
+  const int32_t route = RouteInterleave
+      ? group_id - (group_id / route_count) * route_count
+      : group_id / act_n_tiles;
+  const int32_t n_coord = RouteInterleave
+      ? group_id / route_count
+      : group_id - route * act_n_tiles;
+  if (route >= route_count) return;
+
+  const int64_t global_expert = static_cast<int64_t>(topk_ids[route]);
+  int32_t local_expert = -1;
+  if (expert_map != nullptr) {
+    if (global_expert < 0 || global_expert >= expert_map_size) return;
+    local_expert = expert_map[global_expert];
+  } else {
+    if (global_expert < 0 || global_expert >= num_local_experts) return;
+    local_expert = static_cast<int32_t>(global_expert);
+  }
+  // Remote routes are not consumed by the paired W2/reduce kernel. Leaving
+  // their persistent scratch untouched is therefore exact and avoids both
+  // the incumbent fill and the slower in-GEMM remote-zero experiment.
+  if (local_expert < 0 || local_expert >= num_local_experts) return;
+
+  constexpr int32_t group_size = 32;
+  const int64_t packed_weight_stride =
+      static_cast<int64_t>(gemm_n) * gemm_k / 2;
+  const int64_t scale_stride =
+      static_cast<int64_t>(gemm_n) * (gemm_k / group_size);
+  const int64_t activation_row = route / topk;
+
+  auto A_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      const_cast<bfloat16_t*>(Activations) + activation_row * gemm_k,
+      1,
+      gemm_k);
+  auto B_tensor = make_moe_tensor<int4_t, 'R'>(
+      reinterpret_cast<int4_t*>(
+          const_cast<uint8_t*>(Weights) +
+          static_cast<int64_t>(local_expert) * packed_weight_stride),
+      gemm_n,
+      gemm_k);
+  auto D_tensor = make_moe_tensor<bfloat16_t, 'R'>(
+      Gemm1Outputs + static_cast<int64_t>(route) * gemm_n, 1, gemm_n);
+
+  const bfloat16_t* expert_scales =
+      Scales + static_cast<int64_t>(local_expert) * scale_stride;
+  const bfloat16_t* expert_bias =
+      Bias == nullptr ? nullptr
+                      : Bias + static_cast<int64_t>(local_expert) * gemm_n;
+
+  auto gate_coord = make_coord(0, n_coord, _, 0);
+  xe_gemm_4bits<
+      GmemTiledCopyA,
+      GmemTiledCopyB,
+      GmemTiledCopyD,
+      group_size>(
+      A_tensor,
+      B_tensor,
+      expert_scales,
+      expert_bias,
+      D_tensor,
+      gate_coord,
+      mma);
+
+  auto up_coord = make_coord(0, n_coord + act_n_tiles, _, 0);
+  xe_gemm_4bits<
+      GmemTiledCopyA,
+      GmemTiledCopyB,
+      GmemTiledCopyD,
+      group_size>(
+      A_tensor,
+      B_tensor,
+      expert_scales,
+      expert_bias,
+      D_tensor,
+      up_coord,
+      mma);
+
+  // The two block stores above are the incumbent BF16 W1 rounding points.
+  // Make them visible to every work-item before reproducing silu_and_mul.
+  item.barrier(sycl::access::fence_space::global_and_local);
+  const int32_t local_id = static_cast<int32_t>(item.get_local_linear_id());
+  const int32_t local_size =
+      static_cast<int32_t>(item.get_local_range().size());
+  const int32_t tile_begin = n_coord * wg_tile_n;
+  const int32_t tile_end = sycl::min(tile_begin + wg_tile_n, act_n);
+  for (int32_t column = tile_begin + local_id; column < tile_end;
+       column += local_size) {
+    const bfloat16_t gate =
+        Gemm1Outputs[static_cast<int64_t>(route) * gemm_n + column];
+    const bfloat16_t up = Gemm1Outputs
+        [static_cast<int64_t>(route) * gemm_n + act_n + column];
+    const bfloat16_t silu = static_cast<bfloat16_t>(
+        static_cast<float>(gate) /
+        (1.0f + sycl::exp(-static_cast<float>(gate))));
+    ActOutputs[static_cast<int64_t>(route) * act_n + column] =
+        static_cast<bfloat16_t>(silu * up);
+  }
+}
