+    )
+    hc_scale = torch.randn((3,), dtype=torch.float32, device=device)
+    hc_base = torch.randn((hc3,), dtype=torch.float32, device=device)
+    norm_weight = torch.randn(
+        (hidden_size,), dtype=torch.bfloat16, device=device
+    )
+    norm_eps = 1e-6
+
+    result = torch.ops._xpu_C.mhc_fused_post_pre_norm(
+        x,
+        residual,
+        post_mix,
+        comb_mix,
+        fn,
+        hc_scale,
+        hc_base,
+        norm_weight,
+        1e-6,
+        1e-3,
+        1e-3,
+        1.0,
+        norm_eps,
+        20,
+    )
+    ref = mhc_fused_post_pre_reference(
+        x,
+        residual,
+        post_mix,
+        comb_mix,
+        fn,
+        hc_scale,
+        hc_base,
+        1e-6,
+        1e-3,
+        1e-3,
+        1.0,
+        20,
+    )
+    raw = ref[3]
+    coeff = torch.rsqrt(
+        raw.float().square().mean(dim=-1, keepdim=True) + norm_eps
+    )
+    ref_normed = (raw.float() * coeff).to(torch.bfloat16) * norm_weight
+
+    torch.testing.assert_close(result[0], ref[0], atol=1e-2, rtol=1e-2)
+    torch.testing.assert_close(result[1], ref[1], atol=5e-3, rtol=5e-3)
+    torch.testing.assert_close(result[2], ref[2], atol=5e-3, rtol=5e-3)
+    torch.testing.assert_close(result[3], ref_normed, atol=2e-2, rtol=2e-2)
