+void tp4_host_pair_init(
+    const at::Tensor& device_anchor,
+    const std::string& name,
+    int64_t rank) {
+  TORCH_CHECK(device_anchor.is_xpu(), "device_anchor must be XPU");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(
+      !name.empty() && name.front() == '/',
+      "shared-memory name must begin with '/'");
+  std::lock_guard<std::mutex> lock(g_host_pair_mutex);
+  if (g_host_pair_state != nullptr) {
+    TORCH_CHECK(
+        g_host_pair_name == name && g_host_pair_rank == rank,
+        "TP4 host-pair state already initialized with a different identity");
+    return;
+  }
+
+  const int fd = shm_open(name.c_str(), O_CREAT | O_RDWR, 0600);
+  TORCH_CHECK(fd >= 0, "shm_open failed for ", name, ": ", std::strerror(errno));
+  TORCH_CHECK(
+      flock(fd, LOCK_EX) == 0,
+      "flock failed for ",
+      name,
+      ": ",
+      std::strerror(errno));
+  struct stat info {};
+  TORCH_CHECK(fstat(fd, &info) == 0, "fstat failed: ", std::strerror(errno));
+  const bool initialize =
+      static_cast<size_t>(info.st_size) != sizeof(TP4HostPairState);
+  if (initialize) {
+    TORCH_CHECK(
+        ftruncate(fd, sizeof(TP4HostPairState)) == 0,
+        "ftruncate failed: ",
+        std::strerror(errno));
+  }
+  void* mapping = mmap(
+      nullptr,
+      sizeof(TP4HostPairState),
+      PROT_READ | PROT_WRITE,
+      MAP_SHARED,
+      fd,
+      0);
+  TORCH_CHECK(mapping != MAP_FAILED, "mmap failed: ", std::strerror(errno));
+  auto* state = static_cast<TP4HostPairState*>(mapping);
+  if (initialize ||
+      state->magic.load(std::memory_order_acquire) != kHostPairMagic) {
+    std::memset(state, 0, sizeof(*state));
+    pthread_barrierattr_t attributes;
+    TORCH_CHECK(pthread_barrierattr_init(&attributes) == 0, "barrierattr init failed");
+    TORCH_CHECK(
+        pthread_barrierattr_setpshared(&attributes, PTHREAD_PROCESS_SHARED) == 0,
+        "process-shared barrier attribute failed");
+    TORCH_CHECK(
+        pthread_barrier_init(&state->barrier, &attributes, kWorld) == 0,
+        "process-shared barrier init failed");
+    pthread_barrierattr_destroy(&attributes);
+    state->magic.store(kHostPairMagic, std::memory_order_release);
+  }
+  TORCH_CHECK(flock(fd, LOCK_UN) == 0, "flock unlock failed");
+  g_host_pair_state = state;
+  g_host_pair_fd = fd;
+  g_host_pair_rank = static_cast<int>(rank);
+  g_host_pair_name = name;
+}
+
+void tp4_host_max_token_from_pair_out(
+    const at::Tensor& local_pair,
+    at::Tensor& out_token,
+    int64_t rank,
+    int64_t epoch) {
+  TORCH_CHECK(
+      local_pair.is_xpu() && out_token.is_xpu(),
+      "tp4_host_max_token_from_pair_out: tensors must be XPU");
+  TORCH_CHECK(
+      local_pair.scalar_type() == at::kFloat && local_pair.is_contiguous() &&
+          local_pair.numel() == 2,
+      "local_pair must be contiguous float32 [2]");
+  TORCH_CHECK(
+      out_token.scalar_type() == at::kLong && out_token.is_contiguous() &&
+          out_token.numel() == 1,
+      "out_token must be contiguous int64 [1]");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(epoch > 0 && epoch <= INT32_MAX, "invalid TP4 epoch");
+
+  TP4HostPairState* state = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(g_host_pair_mutex);
+    TORCH_CHECK(g_host_pair_state != nullptr, "TP4 host-pair state is not initialized");
+    TORCH_CHECK(g_host_pair_rank == rank, "TP4 host-pair rank mismatch");
+    state = g_host_pair_state;
+  }
+  const int slot = static_cast<int>(epoch % kSlots);
+  float host_pair[2];
+  auto& q = vllm::xpu::vllmGetQueue();
+  q.memcpy(host_pair, local_pair.data_ptr<float>(), sizeof(host_pair)).wait();
+  state->pairs[slot][rank][0] = host_pair[0];
+  state->pairs[slot][rank][1] = host_pair[1];
+  std::atomic_thread_fence(std::memory_order_release);
+  const int barrier_result = pthread_barrier_wait(&state->barrier);
+  TORCH_CHECK(
+      barrier_result == 0 || barrier_result == PTHREAD_BARRIER_SERIAL_THREAD,
+      "TP4 process-shared barrier failed");
+  std::atomic_thread_fence(std::memory_order_acquire);
+
+  float best_value = -std::numeric_limits<float>::infinity();
+  int64_t best_token = INT64_MAX;
+  for (int r = 0; r < kWorld; ++r) {
+    const float value = state->pairs[slot][r][0];
+    const int64_t token = static_cast<int64_t>(state->pairs[slot][r][1]);
+    if (value > best_value || (value == best_value && token < best_token)) {
+      best_value = value;
+      best_token = token;
+    }
+  }
+  q.memcpy(out_token.data_ptr<int64_t>(), &best_token, sizeof(best_token)).wait();
+}
