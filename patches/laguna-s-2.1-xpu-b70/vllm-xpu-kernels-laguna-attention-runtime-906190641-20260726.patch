+  at::assert_no_overlap(final, shared);
+
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+  auto& queue = vllm::xpu::vllmGetQueue();
+  vllm::moe::LagunaM8MoeGatherFinalizeDiagnosticLauncher(
+      reinterpret_cast<scalar_t*>(final.data_ptr()),
+      reinterpret_cast<scalar_t*>(routed.data_ptr()),
+      reinterpret_cast<scalar_t*>(scaled.data_ptr()),
+      reinterpret_cast<const scalar_t*>(moe_output.data_ptr()),
+      topk_weights.data_ptr<float>(),
+      reinterpret_cast<const scalar_t*>(shared.data_ptr()),
+      queue);
+  return std::make_tuple(routed, scaled, final);
+}
+
+void moe_gather_direct_m1(
+    torch::Tensor& output,
+    const torch::Tensor& moe_output,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& topk_ids,
+    const c10::optional<torch::Tensor>& expert_map,
+    int64_t num_local_experts) {
+  TORCH_CHECK(output.device().is_xpu(), "output must be on XPU");
+  TORCH_CHECK(output.size(0) == 1, "direct gather requires M=1");
+  TORCH_CHECK(
+      topk_weights.dim() == 2 && topk_weights.size(0) == 1 &&
+          topk_weights.size(1) == 6,
+      "direct gather requires weights [1,6]");
+  TORCH_CHECK(topk_ids.sizes() == topk_weights.sizes(), "topk shape mismatch");
+  TORCH_CHECK(
+      moe_output.dim() == 2 && moe_output.size(0) == 6 &&
+          moe_output.size(1) == output.size(1),
+      "moe_output must be [6,H]");
+  TORCH_CHECK(
+      output.scalar_type() == moe_output.scalar_type(),
+      "output dtype mismatch");
+  TORCH_CHECK(
+      output.scalar_type() == torch::kBFloat16,
+      "direct M1 gather currently supports BF16 only");
+  TORCH_CHECK(
+      topk_weights.scalar_type() == torch::kFloat32,
+      "topk_weights must be FP32");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == torch::kInt32 ||
+          topk_ids.scalar_type() == torch::kInt64,
+      "topk_ids must be int32 or int64");
+  TORCH_CHECK(
+      num_local_experts > 0 && num_local_experts <= INT_MAX,
+      "num_local_experts must be a positive int32 value");
+  TORCH_CHECK(
+      output.is_contiguous() && moe_output.is_contiguous() &&
+          topk_weights.is_contiguous() && topk_ids.is_contiguous(),
+      "direct gather tensors must be contiguous");
+  TORCH_CHECK(
+      moe_output.device() == output.device() &&
+          topk_weights.device() == output.device() &&
+          topk_ids.device() == output.device(),
+      "direct gather tensors must share one XPU device");
+  int expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->device() == output.device(), "expert_map device mismatch");
+    TORCH_CHECK(
+        expert_map->scalar_type() == torch::kInt32, "expert_map must be int32");
+    TORCH_CHECK(expert_map->is_contiguous(), "expert_map must be contiguous");
+    TORCH_CHECK(expert_map->dim() == 1, "expert_map must be one-dimensional");
+    TORCH_CHECK(
+        expert_map->numel() <= INT_MAX, "expert_map length must fit int32");
+    expert_map_size = static_cast<int>(expert_map->numel());
+  }
+
+  const at::DeviceGuard device_guard(output.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+  const int* map_ptr =
+      expert_map.has_value()
+          ? reinterpret_cast<const int*>(expert_map->data_ptr())
+          : nullptr;
+  if (topk_ids.scalar_type() == torch::kInt32) {
+    vllm::moe::MoeGatherDirectM1Launcher<scalar_t, int32_t>(
+        reinterpret_cast<scalar_t*>(output.data_ptr()),
+        reinterpret_cast<const scalar_t*>(moe_output.data_ptr()),
+        reinterpret_cast<const float*>(topk_weights.data_ptr()),
+        reinterpret_cast<const int32_t*>(topk_ids.data_ptr()),
+        map_ptr,
+        expert_map_size,
+        static_cast<int>(num_local_experts),
+        6,
+        output.size(1),
+        queue);
+  } else {
+    vllm::moe::MoeGatherDirectM1Launcher<scalar_t, int64_t>(
+        reinterpret_cast<scalar_t*>(output.data_ptr()),
+        reinterpret_cast<const scalar_t*>(moe_output.data_ptr()),
+        reinterpret_cast<const float*>(topk_weights.data_ptr()),
+        reinterpret_cast<const int64_t*>(topk_ids.data_ptr()),
+        map_ptr,
+        expert_map_size,
+        static_cast<int>(num_local_experts),
+        6,
+        output.size(1),
+        queue);
+  }
+}
+
+void moe_gather_m2_direct(
+    torch::Tensor& output,
+    const torch::Tensor& moe_output,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& topk_ids,
+    const c10::optional<torch::Tensor>& expert_map,
+    int64_t num_local_experts) {
+  TORCH_CHECK(output.is_xpu(), "output must be on XPU");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == 2,
+      "fixed M2 direct gather requires output [2,H]");
+  TORCH_CHECK(
+      topk_weights.dim() == 2 && topk_weights.size(0) == 2 &&
+          topk_weights.size(1) == 6,
+      "fixed M2 direct gather requires weights [2,6]");
+  TORCH_CHECK(topk_ids.sizes() == topk_weights.sizes(), "topk shape mismatch");
+  TORCH_CHECK(
+      moe_output.dim() == 2 && moe_output.size(0) == 12 &&
+          moe_output.size(1) == output.size(1),
+      "moe_output must be [12,H]");
+  TORCH_CHECK(
+      output.scalar_type() == torch::kBFloat16 &&
+          moe_output.scalar_type() == torch::kBFloat16,
+      "fixed M2 direct gather currently supports BF16 only");
+  TORCH_CHECK(
+      topk_weights.scalar_type() == torch::kFloat32,
+      "topk_weights must be FP32");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == torch::kInt32 ||
+          topk_ids.scalar_type() == torch::kInt64,
+      "topk_ids must be int32 or int64");
+  TORCH_CHECK(
+      output.is_contiguous() && moe_output.is_contiguous() &&
+          topk_weights.is_contiguous() && topk_ids.is_contiguous(),
+      "fixed M2 direct gather tensors must be contiguous");
+  TORCH_CHECK(
+      moe_output.device() == output.device() &&
+          topk_weights.device() == output.device() &&
+          topk_ids.device() == output.device(),
+      "fixed M2 direct gather tensors must share one XPU device");
+  TORCH_CHECK(
+      output.size(1) > 0 && output.size(1) <= INT_MAX &&
+          output.size(1) % 8 == 0,
+      "hidden size must be a positive int32 multiple of 8");
+  TORCH_CHECK(
+      num_local_experts > 0 && num_local_experts <= INT_MAX,
+      "num_local_experts must be a positive int32 value");
+
+  const int* expert_map_ptr = nullptr;
+  int expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->is_xpu() && expert_map->device() == output.device() &&
+            expert_map->dim() == 1 && expert_map->is_contiguous() &&
+            expert_map->scalar_type() == torch::kInt32 &&
+            expert_map->numel() <= INT_MAX,
+        "expert_map must be contiguous int32 [global_num_experts]");
+    expert_map_ptr = reinterpret_cast<const int*>(expert_map->data_ptr());
+    expert_map_size = static_cast<int>(expert_map->numel());
+  }
+
+  const at::DeviceGuard device_guard(output.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+  if (topk_ids.scalar_type() == torch::kInt32) {
+    vllm::moe::MoeGatherM2DirectLauncher<scalar_t, int32_t>(
+        reinterpret_cast<scalar_t*>(output.data_ptr()),
+        reinterpret_cast<const scalar_t*>(moe_output.data_ptr()),
+        reinterpret_cast<const float*>(topk_weights.data_ptr()),
+        reinterpret_cast<const int32_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int>(num_local_experts),
+        static_cast<int>(output.size(1)),
+        queue);
+  } else {
+    vllm::moe::MoeGatherM2DirectLauncher<scalar_t, int64_t>(
+        reinterpret_cast<scalar_t*>(output.data_ptr()),
+        reinterpret_cast<const scalar_t*>(moe_output.data_ptr()),
+        reinterpret_cast<const float*>(topk_weights.data_ptr()),
+        reinterpret_cast<const int64_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int>(num_local_experts),
+        static_cast<int>(output.size(1)),
+        queue);
+  }
+}
