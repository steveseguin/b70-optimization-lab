+void dspark_local_bias_argmax_pair_out(
+    const torch::Tensor& base_logits,
+    const torch::Tensor& local_bias,
+    torch::Tensor& output_pair,
+    const int64_t vocab_start) {
+  TORCH_CHECK(base_logits.is_xpu(), "base_logits must be on XPU");
+  TORCH_CHECK(local_bias.is_xpu(), "local_bias must be on XPU");
+  TORCH_CHECK(output_pair.is_xpu(), "output_pair must be on XPU");
+  TORCH_CHECK(
+      base_logits.dtype() == torch::kBFloat16 &&
+          local_bias.dtype() == torch::kBFloat16,
+      "base_logits and local_bias must be bfloat16");
+  TORCH_CHECK(output_pair.dtype() == torch::kFloat32, "output_pair must be float32");
+  TORCH_CHECK(
+      base_logits.dim() == 2 && local_bias.sizes() == base_logits.sizes(),
+      "base_logits and local_bias must have matching [rows, vocab] shapes");
+  TORCH_CHECK(
+      output_pair.dim() == 2 && output_pair.size(0) == base_logits.size(0) &&
+          output_pair.size(1) == 2,
+      "output_pair must have shape [rows, 2]");
+  TORCH_CHECK(base_logits.is_contiguous(), "base_logits must be contiguous");
+  TORCH_CHECK(local_bias.is_contiguous(), "local_bias must be contiguous");
+  TORCH_CHECK(output_pair.is_contiguous(), "output_pair must be contiguous");
+  TORCH_CHECK(vocab_start >= 0, "vocab_start must be non-negative");
+
+  constexpr int64_t local_size = 256;
+  const int64_t rows = base_logits.size(0);
+  const int64_t vocab = base_logits.size(1);
+  const auto* base =
+      reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(base_logits.data_ptr());
+  const auto* bias =
+      reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(local_bias.data_ptr());
+  auto* pairs = output_pair.data_ptr<float>();
+  auto& queue = vllm::xpu::vllmGetQueue();
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<float, 1> values(local_size, cgh);
+    sycl::local_accessor<int32_t, 1> indices(local_size, cgh);
+    cgh.parallel_for(
+        sycl::nd_range<1>(
+            sycl::range<1>(rows * local_size), sycl::range<1>(local_size)),
+        [=](sycl::nd_item<1> item) {
+          const int64_t row = item.get_group(0);
+          const int32_t lane = item.get_local_id(0);
+          float best_value = -std::numeric_limits<float>::infinity();
+          int32_t best_index = std::numeric_limits<int32_t>::max();
+          for (int64_t col = lane; col < vocab; col += local_size) {
+            const int64_t offset = row * vocab + col;
+            const sycl::ext::oneapi::bfloat16 rounded = base[offset] + bias[offset];
+            const float value = static_cast<float>(rounded);
+            if (value > best_value ||
+                (value == best_value && col < best_index)) {
+              best_value = value;
+              best_index = static_cast<int32_t>(col);
+            }
+          }
+          values[lane] = best_value;
+          indices[lane] = best_index;
+          item.barrier(sycl::access::fence_space::local_space);
+          for (int32_t width = local_size / 2; width > 0; width /= 2) {
+            if (lane < width) {
+              const float other_value = values[lane + width];
+              const int32_t other_index = indices[lane + width];
+              if (other_value > values[lane] ||
+                  (other_value == values[lane] && other_index < indices[lane])) {
+                values[lane] = other_value;
+                indices[lane] = other_index;
+              }
+            }
+            item.barrier(sycl::access::fence_space::local_space);
+          }
+          if (lane == 0) {
+            pairs[row * 2] = values[0];
+            pairs[row * 2 + 1] = static_cast<float>(vocab_start + indices[0]);
+          }
+        });
+  });
+}
