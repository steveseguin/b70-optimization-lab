+    assert (
+        "return std::make_tuple(routed, scaled, final);"
+        in DIAGNOSTIC_FUNCTION
+    )
+    assert "_moe_C::laguna_m8_moe_gather_finalize_diagnostic" in INVENTORY
+
+
+def test_diagnostic_and_production_kernels_share_arithmetic_but_not_stores():
+    assert "template <bool StoreDiagnostics>" in GATHER_SOURCE
+    assert "laguna_m8_gather_finalize_arithmetic(" in CANDIDATE_CLASS
+    assert "if constexpr (StoreDiagnostics)" in CANDIDATE_CLASS
+    assert "routed_output[output_idx] = values.routed_bf16;" in CANDIDATE_CLASS
+    assert "scaled_output[output_idx] = values.scaled_bf16;" in CANDIDATE_CLASS
+    assert "LagunaM8MoeGatherFinalize<false>" in GATHER_SOURCE
+    assert "shared, nullptr, nullptr" in GATHER_SOURCE
+    assert "LagunaM8MoeGatherFinalize<true>" in GATHER_SOURCE
+    assert "LagunaM8MoeGatherFinalizeDiagnosticLauncher" in DIAGNOSTIC_FUNCTION
+
+
+def test_diagnostic_binding_guards_and_allocates_exact_outputs():
+    for contract in (
