+]
+
+BINDING_START = BINDINGS.index(
+    '"laguna_m8_moe_gather_finalize(Tensor(a!) output'
+)
+DIAGNOSTIC_BINDING_START = BINDINGS.index(
+    "  // Diagnostic-only companion", BINDING_START
+)
+BINDING_END = DIAGNOSTIC_BINDING_START
+CANDIDATE_BINDING = BINDINGS[BINDING_START:BINDING_END]
+
+DIAGNOSTIC_BINDING_END = BINDINGS.index(
+    'm.def(\n      "moe_gather_direct_m1', DIAGNOSTIC_BINDING_START
+)
+DIAGNOSTIC_BINDING = BINDINGS[
+    DIAGNOSTIC_BINDING_START:DIAGNOSTIC_BINDING_END
+]
+
+HEADER_START = HEADER.index("void laguna_m8_moe_gather_finalize(")
+DIAGNOSTIC_HEADER_START = HEADER.index(
+    "std::tuple<torch::Tensor, torch::Tensor, torch::Tensor>\n"
+    "laguna_m8_moe_gather_finalize_diagnostic("
+)
+HEADER_END = DIAGNOSTIC_HEADER_START
+CANDIDATE_HEADER = HEADER[HEADER_START:HEADER_END]
+
+DIAGNOSTIC_HEADER_END = HEADER.index(
+    "void moe_gather_direct_m1(", DIAGNOSTIC_HEADER_START
+)
+DIAGNOSTIC_HEADER = HEADER[DIAGNOSTIC_HEADER_START:DIAGNOSTIC_HEADER_END]
+
+
+def test_laguna_m8_gather_finalize_is_fixed_to_preregistered_geometry():
+    assert "class LagunaM8MoeGatherFinalize" in CANDIDATE_CLASS
+    for contract in (
+        "static constexpr int NumTokens = 8;",
+        "static constexpr int TopK = 10;",
+        "static constexpr int HiddenSize = 3072;",
+        "static constexpr int GroupWorkItem = 256;",
+        "static constexpr int ElemsPerItem = 8;",
+        "constexpr int LoopCount = (HiddenSize + Stride - 1) / Stride;",
+        "if (hidden_idx < HiddenSize) {",
+    ):
+        assert contract in CANDIDATE_CLASS
+
+    # 3072 columns require two 2048-wide workgroup passes. In the second
+    # pass, local id 127 covers the final eight values, ending at index 3071;
+    # local ids 128..255 must be rejected by the base-index guard.
+    assert (3072 + 2048 - 1) // 2048 == 2
+    assert 2048 + 127 * 8 + 7 == 3071
+    assert 2048 + 128 * 8 >= 3072
+
+
+def test_laguna_m8_gather_finalize_uses_canonical_rows_in_slot_order():
+    slot_loop = CANDIDATE_CLASS.index("for (int k = 0; k < TopK; ++k)")
+    canonical_row = CANDIDATE_CLASS.index(
+        "const int moe_id = token_idx * TopK + k;"
+    )
+    routed_load = CANDIDATE_CLASS.index(
+        "moe_output[moe_id * HiddenSize + hidden_idx + e]"
+    )
+    arithmetic_call = CANDIDATE_CLASS.index(
+        "laguna_m8_gather_finalize_arithmetic("
+    )
+
+    assert slot_loop < canonical_row < routed_load < arithmetic_call
+    assert "routed_bf16" in ARITHMETIC_HELPER
+    assert "scaled_bf16" in ARITHMETIC_HELPER
+    assert "static_cast<float>(routed_bf16) * 2.5f" in ARITHMETIC_HELPER
+    assert "static_cast<float>(scaled_bf16)" in ARITHMETIC_HELPER
+    assert "static_cast<float>(shared_bf16)" in ARITHMETIC_HELPER
+    assert "route_map" not in CANDIDATE_CLASS
+    assert "unpermuted_row_to_permuted_row" not in CANDIDATE_CLASS
+    assert "moe_ids" not in CANDIDATE_CLASS
+
+
+def test_laguna_m8_gather_finalize_schema_has_no_public_route_map():
+    symbol = "laguna_m8_moe_gather_finalize"
+    assert symbol in CANDIDATE_HEADER
+    assert symbol in CANDIDATE_BINDING
+    assert "Tensor topk_weights, Tensor shared" in CANDIDATE_BINDING
+    assert "int num_local_experts" in CANDIDATE_BINDING
