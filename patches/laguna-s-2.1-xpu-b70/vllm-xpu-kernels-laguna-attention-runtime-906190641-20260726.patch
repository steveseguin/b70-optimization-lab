+// SPDX-License-Identifier: Apache-2.0
+// Feasibility-only DeepSeek-V4 M=1 block-FP8 shared-down DPAS kernel.
+
+#include <c10/util/Float8_e4m3fn.h>
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/esimd/memory.hpp>
+#include <torch/all.h>
+
+#include "utils.h"
+
+namespace esimd = sycl::ext::intel::esimd;
+namespace xesimd = sycl::ext::intel::experimental::esimd;
+namespace xmx = sycl::ext::intel::esimd::xmx;
+
+namespace vllm {
+
+using bf16_t = sycl::ext::oneapi::bfloat16;
+using fp16_t = sycl::half;
+
+template <int N>
+SYCL_ESIMD_FUNCTION esimd::simd<fp16_t, N> fp8e4m3_to_half(
+    esimd::simd<uint8_t, N> raw) {
+  esimd::simd<uint32_t, N> val = esimd::convert<uint32_t>(raw);
+  esimd::simd<uint32_t, N> sign = val >> 7;
+  esimd::simd<uint32_t, N> exponent = (val >> 3) & 0xF;
+  esimd::simd<uint32_t, N> mantissa = val & 0x7;
+
+  esimd::simd<uint32_t, N> fp32_bits =
+      (sign << 31) | ((exponent + 120) << 23) | (mantissa << 20);
+  esimd::simd<float, N> subnormal =
+      esimd::convert<float>(mantissa) * (1.0f / 512.0f);
+  esimd::simd<uint32_t, N> subnormal_bits =
+      subnormal.template bit_cast_view<uint32_t>();
+  subnormal_bits = subnormal_bits | (sign << 31);
+  fp32_bits.merge(subnormal_bits, exponent == 0);
+  fp32_bits.merge(sign << 31, (exponent == 0) & (mantissa == 0));
+  return fp32_bits.template bit_cast_view<float>();
+}
+
+SYCL_ESIMD_FUNCTION esimd::simd<fp16_t, 256> fp8e4m3_block_to_vnni(
+    esimd::simd<uint8_t, 256> raw) {
+  esimd::simd<fp16_t, 256> weight = fp8e4m3_to_half<256>(raw);
+  esimd::simd<uint32_t, 128> vnni;
+#pragma unroll
+  for (int pair = 0; pair < 8; ++pair) {
+    esimd::simd<uint16_t, 16> even =
+        weight.template select<16, 1>(2 * pair * 16)
+            .template bit_cast_view<uint16_t>()
+            .read();
+    esimd::simd<uint16_t, 16> odd =
+        weight.template select<16, 1>((2 * pair + 1) * 16)
+            .template bit_cast_view<uint16_t>()
+            .read();
+    vnni.template select<16, 1>(pair * 16) =
+        esimd::convert<uint32_t>(even) |
+        (esimd::convert<uint32_t>(odd) << 16);
+  }
+  return vnni.template bit_cast_view<fp16_t>();
+}
+
+template <int TILES_PER_ITEM>
+class deepseek_shared_down_m1_fp8_dpas_kernel;
+
+template <int TILES_PER_ITEM>
+void launch_shared_down(
+    sycl::queue& queue,
+    bf16_t* output,
+    const uint8_t* activation,
+    const float* activation_scales,
+    const uint8_t* packed_weight,
+    const float* weight_scales,
+    int n,
+    int k) {
+  constexpr int n_tile = 16;
+  constexpr int k_tile = 16;
+  constexpr int scale_block = 128;
+  const int n_tiles = n / n_tile;
+  const int work_items =
+      (n_tiles + TILES_PER_ITEM - 1) / TILES_PER_ITEM;
+  const int scale_n = n / scale_block;
+
+  queue.submit([&](sycl::handler& handler) {
+    handler.parallel_for<deepseek_shared_down_m1_fp8_dpas_kernel<TILES_PER_ITEM>>(
+        sycl::range<1>(work_items),
+        [=](sycl::id<1> index) [[intel::sycl_explicit_simd]] {
+          const int first_tile = int(index[0]) * TILES_PER_ITEM;
+          esimd::simd<float, TILES_PER_ITEM * n_tile> accum(0.0f);
+
+          for (int kb = 0; kb < k; kb += scale_block) {
+            esimd::simd<float, TILES_PER_ITEM * n_tile> block_accum(0.0f);
+#pragma unroll
+            for (int ki = 0; ki < scale_block; ki += k_tile) {
+              auto activation_raw = esimd::block_load<uint8_t, k_tile>(
+                  activation + kb + ki);
+              esimd::simd<fp16_t, k_tile> activation_tile =
+                  fp8e4m3_to_half<k_tile>(activation_raw);
+
+#pragma unroll
+              for (int tile_offset = 0; tile_offset < TILES_PER_ITEM;
+                   ++tile_offset) {
+                const int tile = first_tile + tile_offset;
+                if (tile < n_tiles) {
+                  const int nj = tile * n_tile;
+                  xesimd::config_2d_mem_access<uint8_t, n_tile, k_tile, 1>
+                      payload(
+                          packed_weight,
+                          uint32_t(n - 1),
+                          uint32_t(k - 1),
+                          uint32_t(n - 1),
+                          uint32_t(nj),
+                          uint32_t(kb + ki));
+                  auto raw = xesimd::lsc_load_2d<
+                      uint8_t,
+                      n_tile,
+                      k_tile,
+                      1,
+                      false,
+                      false,
+                      xesimd::cache_hint::cached,
+                      xesimd::cache_hint::cached>(payload);
+                  auto weight_tile = fp8e4m3_block_to_vnni(raw);
+                  esimd::simd<float, n_tile> tile_accum =
+                      block_accum.template select<n_tile, 1>(
+                          tile_offset * n_tile).read();
+                  block_accum.template select<n_tile, 1>(
+                      tile_offset * n_tile) =
+                      xmx::dpas<8, 1, float, float, fp16_t, fp16_t>(
+                          tile_accum, weight_tile, activation_tile);
+                }
+              }
+            }
+
+            const float activation_scale =
+                activation_scales[kb / scale_block];
+#pragma unroll
+            for (int tile_offset = 0; tile_offset < TILES_PER_ITEM;
+                 ++tile_offset) {
+              const int tile = first_tile + tile_offset;
+              if (tile < n_tiles) {
+                const int nj = tile * n_tile;
+                const float scale =
+                    activation_scale *
+                    weight_scales[(kb / scale_block) * scale_n +
+                                  nj / scale_block];
+                accum.template select<n_tile, 1>(tile_offset * n_tile) +=
+                    block_accum.template select<n_tile, 1>(
+                        tile_offset * n_tile) *
+                    scale;
+              }
+            }
+          }
+
+#pragma unroll
+          for (int tile_offset = 0; tile_offset < TILES_PER_ITEM;
+               ++tile_offset) {
+            const int tile = first_tile + tile_offset;
+            if (tile < n_tiles) {
+              esimd::simd<float, n_tile> output_tile =
+                  accum.template select<n_tile, 1>(
+                      tile_offset * n_tile).read();
+              esimd::block_store<bf16_t, n_tile>(
+                  output + tile * n_tile,
+                  esimd::convert<bf16_t>(output_tile));
+            }
+          }
+        });
+  });
+}
+
+}  // namespace vllm
+
+void deepseek_shared_down_m1_fp8_dpas_out(
+    torch::Tensor& output,
+    const torch::Tensor& activation,
+    const torch::Tensor& activation_scales,
+    const torch::Tensor& packed_weight,
+    const torch::Tensor& weight_scales,
+    int64_t tiles_per_item) {
+  TORCH_CHECK(activation.device().is_xpu(), "activation must be on XPU");
+  TORCH_CHECK(output.device() == activation.device(), "output device mismatch");
+  TORCH_CHECK(
+      activation_scales.device() == activation.device(),
+      "activation scale device mismatch");
+  TORCH_CHECK(
+      packed_weight.device() == activation.device(),
+      "packed weight device mismatch");
+  TORCH_CHECK(
+      weight_scales.device() == activation.device(),
+      "weight scale device mismatch");
+  TORCH_CHECK(
+      activation.scalar_type() == at::kFloat8_e4m3fn,
+      "activation must be float8_e4m3fn");
+  TORCH_CHECK(
+      packed_weight.scalar_type() == at::kFloat8_e4m3fn,
+      "packed weight must be float8_e4m3fn");
+  TORCH_CHECK(output.scalar_type() == at::kBFloat16, "output must be BF16");
+  TORCH_CHECK(
+      activation_scales.scalar_type() == at::kFloat,
+      "activation scales must be FP32");
+  TORCH_CHECK(
+      weight_scales.scalar_type() == at::kFloat,
+      "weight scales must be FP32");
+  TORCH_CHECK(
+      activation.is_contiguous() && packed_weight.is_contiguous() &&
+          activation_scales.is_contiguous() && weight_scales.is_contiguous() &&
+          output.is_contiguous(),
+      "all tensors must be contiguous");
+  TORCH_CHECK(
+      activation.dim() == 2 && activation.size(0) == 1,
+      "activation must be [1,K]");
+  TORCH_CHECK(
+      packed_weight.dim() == 2,
+      "packed weight must be the contiguous [K,N] transpose");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == 1,
+      "output must be [1,N]");
+  const int k = int(activation.size(1));
+  const int n = int(packed_weight.size(1));
+  TORCH_CHECK(packed_weight.size(0) == k, "packed weight K mismatch");
+  TORCH_CHECK(output.size(1) == n, "output N mismatch");
+  TORCH_CHECK(k % 128 == 0 && n % 128 == 0, "N/K must be divisible by 128");
+  TORCH_CHECK(
+      activation_scales.numel() == k / 128,
+      "activation scales must contain K/128 values");
+  TORCH_CHECK(
+      weight_scales.dim() == 2 && weight_scales.size(0) == k / 128 &&
+          weight_scales.size(1) == n / 128,
+      "weight scales must be [K/128,N/128]");
+
+  at::DeviceGuard device_guard(activation.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  auto* output_ptr =
+      reinterpret_cast<vllm::bf16_t*>(output.data_ptr());
+  const auto* activation_ptr =
+      reinterpret_cast<const uint8_t*>(activation.data_ptr());
+  const auto* packed_weight_ptr =
+      reinterpret_cast<const uint8_t*>(packed_weight.data_ptr());
+  const auto* activation_scale_ptr = activation_scales.data_ptr<float>();
+  const auto* weight_scale_ptr = weight_scales.data_ptr<float>();
+
+  switch (tiles_per_item) {
+    case 1:
+      vllm::launch_shared_down<1>(
+          queue,
+          output_ptr,
+          activation_ptr,
+          activation_scale_ptr,
+          packed_weight_ptr,
+          weight_scale_ptr,
+          n,
+          k);
+      break;
+    case 2:
+      vllm::launch_shared_down<2>(
+          queue,
+          output_ptr,
+          activation_ptr,
+          activation_scale_ptr,
+          packed_weight_ptr,
+          weight_scale_ptr,
+          n,
+          k);
+      break;
+    case 4:
+      vllm::launch_shared_down<4>(
+          queue,
+          output_ptr,
+          activation_ptr,
+          activation_scale_ptr,
+          packed_weight_ptr,
+          weight_scale_ptr,
+          n,
+          k);
+      break;
+    case 8:
+      vllm::launch_shared_down<8>(
+          queue,
+          output_ptr,
+          activation_ptr,
+          activation_scale_ptr,
+          packed_weight_ptr,
+          weight_scale_ptr,
+          n,
+          k);
+      break;
+    default:
+      TORCH_CHECK(false, "tiles_per_item must be 1, 2, 4, or 8");
+  }
+}
diff --git a/csrc/xpu/sycl/deepseek_wqb_m1_fp8_gemv.cpp b/csrc/xpu/sycl/deepseek_wqb_m1_fp8_gemv.cpp
new file mode 100644
index 0000000..d12fe71
--- /dev/null
+++ b/csrc/xpu/sycl/deepseek_wqb_m1_fp8_gemv.cpp
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: Apache-2.0
+// Feasibility-only DeepSeek-V4 WQ_B M=1 block-FP8 x BF16 GEMV.
+
+#include <c10/util/Float8_e4m3fn.h>
+#include <sycl/sycl.hpp>
+#include <torch/all.h>
+
+#include "utils.h"
+
+namespace vllm {
+
+using bf16_t = sycl::ext::oneapi::bfloat16;
+
+template <int OUTPUTS_PER_SG>
+class deepseek_wqb_m1_fp8_gemv_kernel {
+ public:
+  static constexpr int SG_SIZE = 16;
+  static constexpr int SCALE_BLOCK = 128;
+
+  deepseek_wqb_m1_fp8_gemv_kernel(
+      bf16_t* __restrict__ output,
+      const bf16_t* __restrict__ input,
+      const at::Float8_e4m3fn* __restrict__ weight,
+      const float* __restrict__ scales,
+      int64_t n,
+      int64_t k,
+      int64_t scale_n)
+      : output_(output),
+        input_(input),
+        weight_(weight),
+        scales_(scales),
+        n_(n),
+        k_(k),
+        scale_n_(scale_n) {}
+
+  [[sycl::reqd_sub_group_size(SG_SIZE)]]
+  void operator()(sycl::nd_item<1> item) const {
+    const int lane = item.get_local_id(0) & (SG_SIZE - 1);
+    const int sg_in_group = item.get_local_id(0) / SG_SIZE;
+    const int subgroups_per_group = item.get_local_range(0) / SG_SIZE;
+    const int64_t output_base =
+        (static_cast<int64_t>(item.get_group(0)) * subgroups_per_group +
+         sg_in_group) *
+        OUTPUTS_PER_SG;
+
+    float accum[OUTPUTS_PER_SG] = {};
+    auto sg = item.get_sub_group();
+
+    for (int64_t kb = 0; kb < k_; kb += SCALE_BLOCK) {
+      float scale[OUTPUTS_PER_SG];
+#pragma unroll
+      for (int o = 0; o < OUTPUTS_PER_SG; ++o) {
+        const int64_t n_idx = output_base + o;
+        float lane_scale = 0.0f;
+        if (lane == 0 && n_idx < n_) {
+          lane_scale =
+              scales_[(kb / SCALE_BLOCK) * scale_n_ + n_idx / SCALE_BLOCK];
+        }
+        scale[o] = sycl::group_broadcast(sg, lane_scale, 0);
+      }
+
+#pragma unroll
+      for (int ki = 0; ki < SCALE_BLOCK / SG_SIZE; ++ki) {
+        const int64_t k_idx = kb + ki * SG_SIZE + lane;
+        const float x = static_cast<float>(input_[k_idx]);
+#pragma unroll
+        for (int o = 0; o < OUTPUTS_PER_SG; ++o) {
+          const int64_t n_idx = output_base + o;
+          if (n_idx < n_) {
+            const float w = static_cast<float>(weight_[n_idx * k_ + k_idx]);
+            accum[o] = sycl::fma(x, w * scale[o], accum[o]);
+          }
+        }
+      }
+    }
+
+#pragma unroll
+    for (int o = 0; o < OUTPUTS_PER_SG; ++o) {
+      const int64_t n_idx = output_base + o;
+      const float result =
+          sycl::reduce_over_group(sg, accum[o], sycl::plus<float>());
+      if (lane == 0 && n_idx < n_) {
+        output_[n_idx] = static_cast<bf16_t>(result);
+      }
+    }
+  }
+
+ private:
+  bf16_t* __restrict__ output_;
+  const bf16_t* __restrict__ input_;
+  const at::Float8_e4m3fn* __restrict__ weight_;
+  const float* __restrict__ scales_;
+  int64_t n_;
+  int64_t k_;
+  int64_t scale_n_;
+};
+
+template <int OUTPUTS_PER_SG>
+void launch_wqb(
+    sycl::queue& queue,
+    bf16_t* output,
+    const bf16_t* input,
+    const at::Float8_e4m3fn* weight,
+    const float* scales,
+    int64_t n,
+    int64_t k,
+    int64_t local_size) {
+  const int64_t outputs_per_group =
+      (local_size / deepseek_wqb_m1_fp8_gemv_kernel<OUTPUTS_PER_SG>::SG_SIZE) *
+      OUTPUTS_PER_SG;
+  const int64_t groups = (n + outputs_per_group - 1) / outputs_per_group;
+  const sycl::range<1> local(local_size);
+  const sycl::range<1> global(groups * local_size);
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        sycl::nd_range<1>(global, local),
+        deepseek_wqb_m1_fp8_gemv_kernel<OUTPUTS_PER_SG>(
+            output, input, weight, scales, n, k, n / 128));
+  });
+}
+
+}  // namespace vllm
+
+void deepseek_wqb_m1_fp8_gemv_out(
+    torch::Tensor& output,
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    const torch::Tensor& scales,
+    int64_t outputs_per_subgroup,
+    int64_t local_size) {
+  TORCH_CHECK(input.device().is_xpu(), "input must be an XPU tensor");
+  TORCH_CHECK(output.device() == input.device(), "output device mismatch");
+  TORCH_CHECK(weight.device() == input.device(), "weight device mismatch");
+  TORCH_CHECK(scales.device() == input.device(), "scales device mismatch");
+  TORCH_CHECK(input.scalar_type() == at::kBFloat16, "input must be BF16");
+  TORCH_CHECK(output.scalar_type() == at::kBFloat16, "output must be BF16");
+  TORCH_CHECK(
+      weight.scalar_type() == at::kFloat8_e4m3fn,
+      "weight must be float8_e4m3fn");
+  TORCH_CHECK(scales.scalar_type() == at::kFloat, "scales must be FP32");
+  TORCH_CHECK(input.is_contiguous(), "input must be contiguous");
+  TORCH_CHECK(output.is_contiguous(), "output must be contiguous");
+  TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous [N,K]");
+  TORCH_CHECK(scales.is_contiguous(), "scales must be contiguous");
+  TORCH_CHECK(input.dim() == 2 && input.size(0) == 1, "input must be [1,K]");
+  TORCH_CHECK(weight.dim() == 2, "weight must be [N,K]");
+  TORCH_CHECK(output.dim() == 2 && output.size(0) == 1, "output must be [1,N]");
+  const int64_t n = weight.size(0);
+  const int64_t k = weight.size(1);
+  TORCH_CHECK(input.size(1) == k, "input K mismatch");
+  TORCH_CHECK(output.size(1) == n, "output N mismatch");
+  TORCH_CHECK(k % 128 == 0 && n % 128 == 0, "N/K must be divisible by 128");
+  TORCH_CHECK(
+      scales.dim() == 2 && scales.size(0) == k / 128 &&
+          scales.size(1) == n / 128,
+      "scales must be [K/128,N/128]");
+  TORCH_CHECK(
+      local_size == 128 || local_size == 256 || local_size == 512,
+      "local_size must be 128, 256, or 512");
+
+  at::DeviceGuard device_guard(input.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  auto* output_ptr = reinterpret_cast<vllm::bf16_t*>(output.data_ptr());
+  const auto* input_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(input.data_ptr());
+  const auto* weight_ptr = weight.data_ptr<at::Float8_e4m3fn>();
+  const auto* scale_ptr = scales.data_ptr<float>();
+
+  switch (outputs_per_subgroup) {
+    case 1:
+      vllm::launch_wqb<1>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    case 2:
+      vllm::launch_wqb<2>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    case 4:
+      vllm::launch_wqb<4>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    case 8:
+      vllm::launch_wqb<8>(
+          queue,
+          output_ptr,
+          input_ptr,
+          weight_ptr,
+          scale_ptr,
+          n,
+          k,
+          local_size);
+      break;
+    default:
+      TORCH_CHECK(false, "outputs_per_subgroup must be 1, 2, 4, or 8");
+  }
+}
