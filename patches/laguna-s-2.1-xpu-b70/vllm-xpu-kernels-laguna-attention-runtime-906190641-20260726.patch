+void dspark_tp4_markov7_event_out(
+    const torch::Tensor& base_logits,
+    const torch::Tensor& replicated_w1,
+    const torch::Tensor& local_w2_transposed,
+    const torch::Tensor& anchor_token,
+    const torch::Tensor& workspace,
+    torch::Tensor& persistent_embed,
+    torch::Tensor& persistent_local_bias,
+    torch::Tensor& persistent_local_pair,
+    torch::Tensor& persistent_prev,
+    torch::Tensor& output_tokens,
+    const int64_t rank,
+    const int64_t event_start) {
+  constexpr int64_t steps = 7;
+  constexpr int64_t markov_rank = 256;
+  TORCH_CHECK(
+      base_logits.is_xpu() && replicated_w1.is_xpu() &&
+          local_w2_transposed.is_xpu() && anchor_token.is_xpu() &&
+          workspace.is_xpu(),
+      "DSpark Markov tensors must be on XPU");
+  TORCH_CHECK(
+      persistent_embed.is_xpu() && persistent_local_bias.is_xpu() &&
+          persistent_local_pair.is_xpu() && persistent_prev.is_xpu() &&
+          output_tokens.is_xpu(),
+      "DSpark Markov scratch tensors must be on XPU");
+  TORCH_CHECK(
+      base_logits.scalar_type() == at::kBFloat16 &&
+          replicated_w1.scalar_type() == at::kBFloat16 &&
+          local_w2_transposed.scalar_type() == at::kBFloat16 &&
+          persistent_embed.scalar_type() == at::kBFloat16 &&
+          persistent_local_bias.scalar_type() == at::kBFloat16,
+      "DSpark Markov matrix tensors must be BF16");
+  TORCH_CHECK(
+      (anchor_token.scalar_type() == at::kLong ||
+       anchor_token.scalar_type() == at::kInt) &&
+          persistent_prev.scalar_type() == at::kLong &&
+          output_tokens.scalar_type() == at::kLong,
+      "DSpark anchor must be int32/int64 and outputs must be int64");
+  TORCH_CHECK(
+      persistent_local_pair.scalar_type() == at::kFloat,
+      "DSpark Markov local pair must be float32");
+  TORCH_CHECK(
+      base_logits.dim() == 2 && base_logits.size(0) == steps &&
+          base_logits.is_contiguous(),
+      "base_logits must be contiguous [7,vocab/4]");
+  TORCH_CHECK(
+      replicated_w1.dim() == 2 &&
+          replicated_w1.size(0) == base_logits.size(1) * 4 &&
+          replicated_w1.size(1) == markov_rank && replicated_w1.is_contiguous(),
+      "replicated_w1 must be contiguous [vocab,256]");
+  TORCH_CHECK(
+      local_w2_transposed.dim() == 2 &&
+          local_w2_transposed.size(0) == markov_rank &&
+          local_w2_transposed.size(1) == base_logits.size(1) &&
+          local_w2_transposed.is_contiguous(),
+      "local_w2_transposed must be packed contiguous [256,vocab/4]");
+  const int64_t partition = local_w2_transposed.size(1);
+  TORCH_CHECK(
+      persistent_embed.sizes() == at::IntArrayRef({1, markov_rank}) &&
+          persistent_local_bias.sizes() == at::IntArrayRef({1, partition}) &&
+          persistent_local_pair.sizes() == at::IntArrayRef({1, 2}) &&
+          persistent_prev.numel() == 1 && output_tokens.numel() == steps,
+      "invalid fixed DSpark Markov scratch geometry");
+  TORCH_CHECK(
+      persistent_embed.is_contiguous() && persistent_local_bias.is_contiguous() &&
+          persistent_local_pair.is_contiguous() && persistent_prev.is_contiguous() &&
+          output_tokens.is_contiguous(),
+      "DSpark Markov scratch tensors must be contiguous");
+  TORCH_CHECK(rank >= 0 && rank < 4, "invalid TP4 rank");
+  TORCH_CHECK(event_start >= 0, "invalid event start");
+
+  at::DeviceGuard device_guard(base_logits.device());
+  torch::Tensor prev = anchor_token;
+  for (int64_t step = 0; step < steps; ++step) {
+    deepseek_markov_token_m1_bf16_dpas_out(
+        persistent_local_bias,
+        prev,
+        replicated_w1,
+        local_w2_transposed,
+        2);
+    auto base_local = base_logits.select(0, step).view({1, partition});
+    dspark_local_bias_argmax_pair_out(
+        base_local,
+        persistent_local_bias,
+        persistent_local_pair,
+        rank * partition);
+    auto output_token = output_tokens.narrow(0, step, 1);
+    tp4_ipc_event_max_token_from_pair_out(
+        persistent_local_pair,
+        workspace,
+        output_token,
+        rank,
+        127,
+        event_start + step);
+    prev = output_token;
+  }
+}
+
+void argmax_from_gathered_pairs_out(
+    const torch::Tensor& gathered_pairs,
+    torch::Tensor& output_tokens) {
+  TORCH_CHECK(gathered_pairs.is_xpu(), "gathered_pairs must be on XPU");
+  TORCH_CHECK(output_tokens.is_xpu(), "output_tokens must be on XPU");
+  TORCH_CHECK(gathered_pairs.dtype() == torch::kFloat32, "pairs must be float32");
+  TORCH_CHECK(output_tokens.dtype() == torch::kInt64, "tokens must be int64");
+  TORCH_CHECK(
+      gathered_pairs.dim() == 3 && gathered_pairs.size(2) == 2,
+      "gathered_pairs must have shape [rows, tp_size, 2]");
+  TORCH_CHECK(
+      output_tokens.numel() == gathered_pairs.size(0),
+      "output_tokens must have one element per row");
+  TORCH_CHECK(gathered_pairs.is_contiguous(), "gathered_pairs must be contiguous");
+  TORCH_CHECK(output_tokens.is_contiguous(), "output_tokens must be contiguous");
+
+  const int64_t rows = gathered_pairs.size(0);
+  const int64_t tp_size = gathered_pairs.size(1);
+  const auto* pairs = gathered_pairs.data_ptr<float>();
+  auto* tokens = output_tokens.data_ptr<int64_t>();
+  auto& queue = vllm::xpu::vllmGetQueue();
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(sycl::range<1>(rows), [=](sycl::id<1> item) {
+      const int64_t row = item[0];
+      float best_value = -std::numeric_limits<float>::infinity();
+      int64_t best_token = 0;
+      for (int64_t rank = 0; rank < tp_size; ++rank) {
+        const int64_t offset = (row * tp_size + rank) * 2;
+        const float value = pairs[offset];
+        if (value > best_value) {
+          best_value = value;
+          best_token = static_cast<int64_t>(pairs[offset + 1]);
+        }
+      }
+      tokens[row] = best_token;
+    });
+  });
+}
