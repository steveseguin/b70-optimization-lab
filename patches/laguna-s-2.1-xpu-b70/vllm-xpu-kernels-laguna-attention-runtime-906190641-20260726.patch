new file mode 100644
index 0000000..c12684f
--- /dev/null
+++ b/tests/test_hadamard.py
@@ -0,0 +1,114 @@
+import importlib.util
+import math
+import os
+import sys
+
+import numpy as np
+import pytest
+import torch
+
+if binary := os.environ.get("VLLM_XPU_TEST_CORE_BINARY"):
+    spec = importlib.util.spec_from_file_location("vllm_xpu_kernels._C", binary)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = module
+    spec.loader.exec_module(module)
+else:
+    import vllm_xpu_kernels._C  # noqa: F401 - registers torch.ops._C.*
+
+
+def _normalized_hadamard_numpy(width: int = 128) -> np.ndarray:
+    matrix = np.ones((1, 1), dtype=np.float64)
+    while matrix.shape[0] < width:
+        matrix = np.block([[matrix, matrix], [matrix, -matrix]])
+    return matrix / math.sqrt(width)
+
+
+def _apply_blocks(
+    value: torch.Tensor, *, inplace: bool = False
+) -> torch.Tensor:
+    shape = value.shape
+    blocks = value.reshape(-1, 128)
+    result = torch.ops._C.hadacore_transform(blocks, inplace)
+    return result.reshape(shape)
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("rows", [1, 7, 33])
+def test_hadamard_128_matches_numpy(dtype: torch.dtype, rows: int):
+    generator = torch.Generator(device="cpu").manual_seed(20260721 + rows)
+    value_cpu = torch.randn(
+        (rows, 128), generator=generator, dtype=torch.float32
+    )
+    value = value_cpu.to(dtype=dtype, device="xpu")
+
+    result = _apply_blocks(value)
+    reference_np = value.cpu().float().numpy().astype(np.float64) @ (
+        _normalized_hadamard_numpy().T
+    )
+    reference = torch.from_numpy(reference_np).to(dtype=dtype)
+    actual = result.cpu()
+
+    abs_error = (actual.float() - reference.float()).abs()
+    denom = reference.float().abs().clamp_min(1e-6)
+    exact_fraction = (actual == reference).float().mean().item()
+    max_abs = abs_error.max().item()
+    max_rel = (abs_error / denom).max().item()
+    print(
+        f"dtype={dtype} rows={rows} exact_fraction={exact_fraction:.9f} "
+        f"max_abs={max_abs:.9g} max_rel={max_rel:.9g}"
+    )
+
+    tolerance = 0.03125 if dtype == torch.bfloat16 else 0.00390625
+    assert max_abs <= tolerance
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16])
+def test_hadamard_contract_and_involution(dtype: torch.dtype):
+    generator = torch.Generator(device="cpu").manual_seed(42)
+    original = torch.randn((5, 3, 128), generator=generator).to(dtype).xpu()
+
+    source = original.clone()
+    out_of_place = torch.ops._C.hadacore_transform(source, False)
+    assert source.data_ptr() != out_of_place.data_ptr()
+    assert torch.equal(source, original)
+
+    inplace_source = original.clone()
+    returned = torch.ops._C.hadacore_transform(inplace_source, True)
+    assert returned.data_ptr() == inplace_source.data_ptr()
+    assert torch.equal(returned, out_of_place)
+
+    restored = torch.ops._C.hadacore_transform(out_of_place, False)
+    tolerance = 0.03125 if dtype == torch.bfloat16 else 0.00390625
+    max_error = torch.max(torch.abs(restored.float() - original.float())).item()
+    assert max_error <= tolerance
+
+
+@pytest.mark.parametrize("width", [3072, 6144, 9216, 1024])
+def test_hadamard_tp4_aligned_shards_are_exact(width: int):
+    generator = torch.Generator(device="cpu").manual_seed(1000 + width)
+    value = (
+        torch.randn((7, width), generator=generator).to(torch.bfloat16).xpu()
+    )
+    whole = _apply_blocks(value)
+
+    shard_width = width // 4
+    assert shard_width % 128 == 0
+    shards = [
+        _apply_blocks(value[:, start : start + shard_width].contiguous())
+        for start in range(0, width, shard_width)
+    ]
+    sharded = torch.cat(shards, dim=-1)
+    assert torch.equal(whole, sharded)
+
+
+def test_hadamard_rejects_non_128_domain():
+    value = torch.zeros((4, 32), dtype=torch.bfloat16, device="xpu")
+    with pytest.raises(RuntimeError, match="only width 128"):
+        torch.ops._C.hadacore_transform(value, False)
+
+
+def test_hadamard_empty_rows():
+    value = torch.empty((0, 128), dtype=torch.bfloat16, device="xpu")
+    result = torch.ops._C.hadacore_transform(value, False)
+    assert result.shape == value.shape
diff --git a/tests/test_laguna_m8_gather_finalize_oracle.py b/tests/test_laguna_m8_gather_finalize_oracle.py
new file mode 100644
index 0000000..87d43f0
--- /dev/null
+++ b/tests/test_laguna_m8_gather_finalize_oracle.py
@@ -0,0 +1,348 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU-only arithmetic oracle for Laguna's exact M=8 gather/finalize tail.
+
+This module deliberately does not import the native extension or create an
+XPU tensor.  The two implementations use different row-addressing forms but
+encode the same protected operation sequence:
+
+  fixed slot-0..9 FP32 sum -> BF16 -> FP32 * 2.5 -> BF16
+      -> FP32 shared add -> BF16
+"""
+
+import torch
+
+
+NUM_TOKENS = 8
+TOPK = 10
+HIDDEN_SIZE = 3072
+
+
+def _bits(value: torch.Tensor) -> torch.Tensor:
+    assert value.device.type == "cpu"
+    assert value.dtype == torch.bfloat16
+    return value.contiguous().view(torch.uint16)
+
+
+def _check_inputs(
+    route_rows: torch.Tensor,
+    weights: torch.Tensor,
+    shared: torch.Tensor,
+) -> int:
+    assert route_rows.device.type == "cpu"
+    assert weights.device.type == "cpu"
+    assert shared.device.type == "cpu"
+    assert route_rows.dtype == torch.bfloat16
+    assert weights.dtype == torch.float32
+    assert shared.dtype == torch.bfloat16
+    assert route_rows.ndim == 2
+    assert route_rows.shape[0] == NUM_TOKENS * TOPK
+    hidden_size = route_rows.shape[1]
+    assert weights.shape == (NUM_TOKENS, TOPK)
+    assert shared.shape == (NUM_TOKENS, hidden_size)
+    return hidden_size
+
+
+def _incumbent_oracle(
+    route_rows: torch.Tensor,
+    weights: torch.Tensor,
+    shared: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Model incumbent canonical moe_gather then laguna_m8_scale_add."""
+    hidden_size = _check_inputs(route_rows, weights, shared)
+    accum = torch.zeros((NUM_TOKENS, hidden_size), dtype=torch.float32)
+    token_rows = torch.arange(NUM_TOKENS, dtype=torch.int64) * TOPK
+    for slot in range(TOPK):
+        selected = route_rows.index_select(0, token_rows + slot).float()
+        product = torch.mul(selected, weights[:, slot, None])
+        accum = torch.add(accum, product)
+
+    routed = accum.to(torch.bfloat16)
+    scaled = torch.mul(routed.float(), 2.5).to(torch.bfloat16)
+    final = torch.add(shared.float(), scaled.float()).to(torch.bfloat16)
+    return routed, scaled, final
+
+
+def _candidate_model(
+    route_rows: torch.Tensor,
+    weights: torch.Tensor,
+    shared: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Independently model the fixed candidate's token*10+slot addressing."""
+    hidden_size = _check_inputs(route_rows, weights, shared)
+    canonical = route_rows.reshape(NUM_TOKENS, TOPK, hidden_size)
+    accum = torch.zeros_like(shared, dtype=torch.float32)
+    for slot in range(TOPK):
+        # Keep multiplication and addition as separate FP32 operations.
+        product = canonical[:, slot, :].float() * weights[:, slot].unsqueeze(1)
+        accum = accum + product
+
+    routed_bf16 = accum.to(dtype=torch.bfloat16)
+    scaled_bf16 = (routed_bf16.float() * 2.5).to(dtype=torch.bfloat16)
+    final_bf16 = (shared.float() + scaled_bf16.float()).to(dtype=torch.bfloat16)
+    return routed_bf16, scaled_bf16, final_bf16
+
+
+def _assert_bitwise_triplet(
+    lhs: tuple[torch.Tensor, torch.Tensor, torch.Tensor],
+    rhs: tuple[torch.Tensor, torch.Tensor, torch.Tensor],
+) -> None:
+    for lhs_value, rhs_value in zip(lhs, rhs, strict=True):
+        assert torch.equal(_bits(lhs_value), _bits(rhs_value))
+
+
+def test_full_geometry_mixed_remote_rows_matches_and_preserves_inputs() -> None:
+    generator = torch.Generator(device="cpu").manual_seed(0x1A6_08)
+    route_rows = (
+        torch.randn(
+            (NUM_TOKENS * TOPK, HIDDEN_SIZE),
+            generator=generator,
+            dtype=torch.float32,
+        )
+        * 7.0
+    ).to(torch.bfloat16)
+    weights = torch.randn(
+        (NUM_TOKENS, TOPK),
+        generator=generator,
+        dtype=torch.float32,
+    )
+    shared = (
+        torch.randn(
+            (NUM_TOKENS, HIDDEN_SIZE),
+            generator=generator,
+            dtype=torch.float32,
+        )
+        * 3.0
+    ).to(torch.bfloat16)
+
+    # Remote W2 routes remain in their canonical slots as literal zero rows.
+    # Include slot 0, slot 9, and alternating positions.
+    remote_rows = torch.tensor(
+        sorted(
+            {
+                0,
+                9,
+                10,
+                19,
+                *range(20, 30, 2),
+                *range(31, 40, 2),
+                70,
+                79,
+            }
+        ),
+        dtype=torch.int64,
+    )
+    route_rows.index_fill_(0, remote_rows, 0)
+
+    route_before = route_rows.clone()
+    weights_before = weights.clone()
+    shared_before = shared.clone()
+    _assert_bitwise_triplet(
+        _incumbent_oracle(route_rows, weights, shared),
+        _candidate_model(route_rows, weights, shared),
+    )
+    assert torch.equal(_bits(route_rows), _bits(route_before))
+    assert torch.equal(
+        weights.view(torch.uint32),
+        weights_before.view(torch.uint32),
+    )
+    assert torch.equal(_bits(shared), _bits(shared_before))
+
+
+def test_every_canonical_row_affects_only_its_own_token() -> None:
+    weights = torch.ones((NUM_TOKENS, TOPK), dtype=torch.float32)
+    shared = torch.zeros((NUM_TOKENS, 1), dtype=torch.bfloat16)
+
+    for row in range(NUM_TOKENS * TOPK):
+        route_rows = torch.zeros(
+            (NUM_TOKENS * TOPK, 1),
+            dtype=torch.bfloat16,
+        )
+        route_rows[row, 0] = torch.tensor(1.0, dtype=torch.bfloat16)
+        incumbent = _incumbent_oracle(route_rows, weights, shared)
+        candidate = _candidate_model(route_rows, weights, shared)
+        _assert_bitwise_triplet(incumbent, candidate)
+
+        expected = torch.zeros((NUM_TOKENS, 1), dtype=torch.bfloat16)
+        expected[row // TOPK, 0] = torch.tensor(2.5, dtype=torch.bfloat16)
+        assert torch.equal(_bits(candidate[2]), _bits(expected))
+
+
+def test_all_remote_rows_are_literal_shared_output() -> None:
+    route_rows = torch.zeros(
+        (NUM_TOKENS * TOPK, 31),
+        dtype=torch.bfloat16,
+    )
+    weights = torch.linspace(
+        -2.0,
+        2.0,
+        NUM_TOKENS * TOPK,
+        dtype=torch.float32,
+    ).reshape(NUM_TOKENS, TOPK)
+    shared_bits = torch.tensor(
+        [
+            0x0000,
+            0x8000,
+            0x0001,
+            0x007F,
+            0x0080,
+            0x3F7F,
+            0x3F80,
+            0x7F7F,
+            0x8080,
+            0xBF80,
+            0xFF7F,
+        ],
+        dtype=torch.uint16,
+    )
+    shared = (
+        shared_bits.repeat(
+            (NUM_TOKENS * 31 + shared_bits.numel() - 1) // shared_bits.numel()
+        )[: NUM_TOKENS * 31]
+        .view(torch.bfloat16)
+        .reshape(NUM_TOKENS, 31)
+    )
+
+    incumbent = _incumbent_oracle(route_rows, weights, shared)
+    candidate = _candidate_model(route_rows, weights, shared)
+    _assert_bitwise_triplet(incumbent, candidate)
+    # IEEE addition canonicalizes shared -0 plus the routed +0 to +0.
+    expected = (
+        shared.float() + torch.zeros_like(shared, dtype=torch.float32)
+    ).to(torch.bfloat16)
+    assert torch.equal(_bits(candidate[2]), _bits(expected))
+
+
+def test_protected_rounding_boundaries_and_slot_order_are_observable() -> None:
+    route_rows = torch.zeros(
+        (NUM_TOKENS * TOPK, 1),
+        dtype=torch.bfloat16,
+    )
+    route_rows[:TOPK, 0] = torch.tensor(
+        [
+            2.734375,
+            -25.875,
+            -17.375,
+            8.875,
+            -9.5,
+            -12.625,
+            -0.55078125,
+            -14.1875,
+            8.8125,
+            8.125,
+        ],
+        dtype=torch.bfloat16,
+    )
+    weights = torch.zeros((NUM_TOKENS, TOPK), dtype=torch.float32)
+    weights[0] = torch.tensor(
+        [
+            -0.21851147711277008,
+            2.489952802658081,
+            -0.8930608034133911,
+            1.6719998121261597,
+            -1.0521363019943237,
+            -0.7215145826339722,
+            1.4336113929748535,
+            -0.1225554347038269,
+            0.20898190140724182,
+            0.014477301388978958,
+        ],
+        dtype=torch.float32,
+    )
+    shared = torch.zeros((NUM_TOKENS, 1), dtype=torch.bfloat16)
+    shared[0, 0] = torch.tensor(-3.125, dtype=torch.bfloat16)
+
+    routed, scaled, final = _candidate_model(route_rows, weights, shared)
+    assert int(routed[0, 0].view(torch.int16)) == -16053
+    assert int(scaled[0, 0].view(torch.int16)) == -15874
+    assert int(final[0, 0].view(torch.int16)) == -15860
+    _assert_bitwise_triplet(
+        (routed, scaled, final),
+        _incumbent_oracle(route_rows, weights, shared),
+    )
+
+    accum = torch.zeros((NUM_TOKENS, 1), dtype=torch.float32)
+    canonical = route_rows.reshape(NUM_TOKENS, TOPK, 1)
+    for slot in range(TOPK):
+        accum = accum + canonical[:, slot, :].float() * weights[:, slot, None]
+
+    scaled_before_gather_round = (accum * 2.5).to(torch.bfloat16)
+    collapsed_scale_add = (shared.float() + routed.float() * 2.5).to(
+        torch.bfloat16
+    )
+    reverse_accum = torch.zeros_like(accum)
+    for slot in reversed(range(TOPK)):
+        reverse_accum = (
+            reverse_accum
+            + canonical[:, slot, :].float() * weights[:, slot, None]
+        )
+    reverse_final = (
+        shared.float()
+        + (reverse_accum.to(torch.bfloat16).float() * 2.5)
+        .to(torch.bfloat16)
+        .float()
+    ).to(torch.bfloat16)
+
+    assert not torch.equal(
+        _bits(scaled[0, 0]),
+        _bits(scaled_before_gather_round[0, 0]),
+    )
+    assert not torch.equal(
+        _bits(final[0, 0]),
+        _bits(collapsed_scale_add[0, 0]),
+    )
+    assert not torch.equal(
+        _bits(final[0, 0]),
+        _bits(reverse_final[0, 0]),
+    )
+
+
+def test_fp32_weight_edges_and_nonfinite_outputs_match() -> None:
+    route_rows = torch.ones(
+        (NUM_TOKENS * TOPK, 9),
+        dtype=torch.bfloat16,
+    )
+    route_rows[0, :4] = torch.tensor(
+        [float("inf"), float("-inf"), float("nan"), -0.0],
+        dtype=torch.bfloat16,
+    )
+    zero = torch.tensor(0.0, dtype=torch.float32)
+    one = torch.tensor(1.0, dtype=torch.float32)
+    weights = torch.tensor(
+        [
+            0.0,
+            -0.0,
+            torch.nextafter(zero, one).item(),
+            torch.nextafter(one, zero).item(),
+            1.0,
+            torch.nextafter(one, torch.tensor(2.0)).item(),
+            -0.5,
+            0.25,
+            -1.5,
+            2.0,
+        ],
+        dtype=torch.float32,
+    ).repeat(NUM_TOKENS, 1)
+    shared = torch.zeros((NUM_TOKENS, 9), dtype=torch.bfloat16)
+
+    incumbent = _incumbent_oracle(route_rows, weights, shared)
+    candidate = _candidate_model(route_rows, weights, shared)
+    for incumbent_value, candidate_value in zip(
+        incumbent,
+        candidate,
+        strict=True,
+    ):
+        assert torch.equal(
+            torch.isnan(incumbent_value),
+            torch.isnan(candidate_value),
+        )
+        assert torch.equal(
+            torch.isinf(incumbent_value),
+            torch.isinf(candidate_value),
+        )
+        finite = torch.isfinite(incumbent_value) & torch.isfinite(
+            candidate_value
+        )
+        assert torch.equal(
+            _bits(incumbent_value[finite]),
+            _bits(candidate_value[finite]),
+        )
