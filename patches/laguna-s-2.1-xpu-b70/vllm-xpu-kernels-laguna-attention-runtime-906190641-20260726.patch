+    assert candidate_dispatch in INTERFACE
+    guard_start = INTERFACE.index(candidate_guard)
+    dispatch_start = INTERFACE.index(candidate_dispatch, guard_start + 1)
+    incumbent_start = INTERFACE.index(
+        "torch.ops._moe_C.moe_gather(", dispatch_start
+    )
+    guard_block = INTERFACE[guard_start:dispatch_start]
+    assert "self._laguna_m8_gather_finalize" in guard_block
+    assert "num_rows == 8" in guard_block
+    assert dispatch_start < incumbent_start
