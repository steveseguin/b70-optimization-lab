+          src_sc.size(0) == batch && src_sc.size(1) == m,
+          "Batched src grouped scale expects shape [B, M, gK], got ",
+          src_sc.sizes(),
+          ".");
+      const int64_t src_scale_k = src_sc.size(2);
+      TORCH_CHECK(
+          k % src_scale_k == 0,
+          "Batched src grouped scale count must divide K, got K=",
+          k,
+          " and grouped dim ",
+          src_scale_k,
+          ".");
