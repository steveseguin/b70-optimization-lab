+def test_silu_and_mul_with_clamp_per_block_quant_vs_separate(
+    dtype: torch.dtype,
+    fp8_dtype: torch.dtype,
+    device: str,
+) -> None:
+    seed_everything(0)
+    torch.set_default_device(device)
+    x = torch.randn(1, 1024, dtype=dtype) * 12
+    limit = 10.0
+
+    gate = torch.clamp(x[:, :512], max=limit)
+    up = torch.clamp(x[:, 512:], min=-limit, max=limit)
+    activated = gate * torch.sigmoid(gate) * up
+    separate_out = torch.empty_like(activated, dtype=fp8_dtype)
+    separate_scales = torch.empty((1, 4), dtype=torch.float32, device=device)
+    finfo = torch.finfo(fp8_dtype)
+    ops.per_token_group_fp8_quant(
+        activated,
+        separate_out,
+        separate_scales,
+        group_size=128,
+        fp8_min=finfo.min,
+        fp8_max=finfo.max,
+    )
+
+    fused_out, fused_scales = ops.silu_and_mul_per_block_quant(
+        x,
+        group_size=128,
+        quant_dtype=fp8_dtype,
+        clamp_limit=limit,
+    )
+
+    torch.testing.assert_close(fused_scales, separate_scales, rtol=0, atol=0)
+    torch.testing.assert_close(
+        fused_out.float(), separate_out.float(), rtol=0, atol=0
+    )
