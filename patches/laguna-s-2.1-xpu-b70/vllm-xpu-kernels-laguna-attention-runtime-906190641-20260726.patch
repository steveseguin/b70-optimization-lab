+void remap_hidden_states_m2_direct(
+    const torch::Tensor& hidden_states,
+    torch::Tensor& remapped_hidden_states,
+    torch::Tensor& unpermuted_row_to_permuted_row,
+    const torch::Tensor& topk_ids,
+    const c10::optional<torch::Tensor>& expert_map,
+    int64_t local_experts_num) {
+  TORCH_CHECK(hidden_states.is_xpu(), "hidden_states must be on XPU");
+  TORCH_CHECK(
+      hidden_states.scalar_type() == torch::kBFloat16,
+      "fixed M2 direct remap currently supports BF16 only");
+  TORCH_CHECK(
+      hidden_states.dim() == 2 && hidden_states.size(0) == 2,
+      "fixed M2 direct remap requires hidden_states [2,H]");
+  TORCH_CHECK(
+      remapped_hidden_states.dim() == 2 &&
+          remapped_hidden_states.size(0) == 12 &&
+          remapped_hidden_states.size(1) == hidden_states.size(1),
+      "remapped_hidden_states must be [12,H]");
+  TORCH_CHECK(
+      topk_ids.dim() == 2 && topk_ids.size(0) == 2 && topk_ids.size(1) == 6,
+      "fixed M2 direct remap requires topk_ids [2,6]");
+  TORCH_CHECK(
+      unpermuted_row_to_permuted_row.sizes() == topk_ids.sizes() &&
+          unpermuted_row_to_permuted_row.scalar_type() == torch::kInt32,
+      "unpermuted_row_to_permuted_row must be int32 [2,6]");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == torch::kInt32 ||
+          topk_ids.scalar_type() == torch::kInt64,
+      "topk_ids must be int32 or int64");
+  TORCH_CHECK(
+      hidden_states.is_contiguous() && remapped_hidden_states.is_contiguous() &&
+          unpermuted_row_to_permuted_row.is_contiguous() &&
+          topk_ids.is_contiguous(),
+      "fixed M2 direct remap tensors must be contiguous");
+  TORCH_CHECK(
+      remapped_hidden_states.device() == hidden_states.device() &&
+          unpermuted_row_to_permuted_row.device() == hidden_states.device() &&
+          topk_ids.device() == hidden_states.device(),
+      "fixed M2 direct remap tensors must share one XPU device");
+  TORCH_CHECK(
+      hidden_states.size(1) > 0 && hidden_states.size(1) <= INT_MAX &&
+          hidden_states.size(1) % 8 == 0,
+      "hidden size must be a positive int32 multiple of 8");
+  TORCH_CHECK(
+      local_experts_num > 0 && local_experts_num <= INT_MAX,
+      "local_experts_num must be a positive int32 value");
+
+  const int* expert_map_ptr = nullptr;
+  int expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->is_xpu() &&
+            expert_map->device() == hidden_states.device() &&
+            expert_map->dim() == 1 && expert_map->is_contiguous() &&
+            expert_map->scalar_type() == torch::kInt32 &&
+            expert_map->numel() <= INT_MAX,
+        "expert_map must be contiguous int32 [global_num_experts]");
+    expert_map_ptr = reinterpret_cast<const int*>(expert_map->data_ptr());
+    expert_map_size = static_cast<int>(expert_map->numel());
+  }
+
+  const at::DeviceGuard device_guard(hidden_states.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+  if (topk_ids.scalar_type() == torch::kInt32) {
+    vllm::moe::RemapHiddenStatesM2DirectLauncher<scalar_t, int32_t>(
+        reinterpret_cast<const scalar_t*>(hidden_states.data_ptr()),
+        reinterpret_cast<scalar_t*>(remapped_hidden_states.data_ptr()),
+        reinterpret_cast<int*>(unpermuted_row_to_permuted_row.data_ptr()),
+        reinterpret_cast<const int32_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int>(local_experts_num),
+        static_cast<int>(hidden_states.size(1)),
+        queue);
+  } else {
+    vllm::moe::RemapHiddenStatesM2DirectLauncher<scalar_t, int64_t>(
+        reinterpret_cast<const scalar_t*>(hidden_states.data_ptr()),
+        reinterpret_cast<scalar_t*>(remapped_hidden_states.data_ptr()),
+        reinterpret_cast<int*>(unpermuted_row_to_permuted_row.data_ptr()),
+        reinterpret_cast<const int64_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int>(local_experts_num),
+        static_cast<int>(hidden_states.size(1)),
+        queue);
+  }
+}
+
+void silu_and_mul_clamp_m2_direct(
+    torch::Tensor& output,
+    const torch::Tensor& input,
+    double limit,
+    const torch::Tensor& mapped_rows,
+    int64_t route_lanes) {
+  TORCH_CHECK(input.is_xpu() && output.is_xpu(), "tensors must be on XPU");
+  TORCH_CHECK(input.device() == output.device(), "tensor device mismatch");
+  TORCH_CHECK(
+      input.scalar_type() == torch::kBFloat16 &&
+          output.scalar_type() == torch::kBFloat16,
+      "fixed M2 routed activation currently supports BF16 only");
+  TORCH_CHECK(
+      input.dim() == 2 && input.size(0) == 12 && input.size(1) == 4096,
+      "input must be [12,4096]");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == 12 && output.size(1) == 2048,
+      "output must be [12,2048]");
+  TORCH_CHECK(
+      input.is_contiguous() && output.is_contiguous(),
+      "input and output must be contiguous");
+  TORCH_CHECK(limit > 0.0, "limit must be positive");
+  TORCH_CHECK(
+      mapped_rows.is_xpu() && mapped_rows.device() == input.device() &&
+          mapped_rows.is_contiguous() && mapped_rows.dim() == 2 &&
+          mapped_rows.size(0) == 2 && mapped_rows.size(1) == 6 &&
+          mapped_rows.scalar_type() == torch::kInt32,
+      "mapped_rows must be contiguous int32 [2,6] on the same XPU");
+  TORCH_CHECK(
+      route_lanes == 2 || route_lanes == 4 || route_lanes == 12,
+      "route_lanes must be 2, 4, or 12");
+
+  const at::DeviceGuard device_guard(input.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+  vllm::moe::SiluAndMulClampM2DirectDispatch<scalar_t, int32_t>(
+      reinterpret_cast<scalar_t*>(output.data_ptr()),
+      reinterpret_cast<const scalar_t*>(input.data_ptr()),
+      static_cast<float>(limit),
+      reinterpret_cast<const int*>(mapped_rows.data_ptr()),
+      2048,
+      static_cast<int>(route_lanes),
+      queue);
+}
