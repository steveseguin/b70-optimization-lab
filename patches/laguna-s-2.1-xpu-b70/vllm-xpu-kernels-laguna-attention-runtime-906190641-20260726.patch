+template <class policy, bool TileMajor = false, typename TopkId>
+void M1TopkGEMMLauncher(
+    sycl::queue& stream,
+    const bfloat16_t* activations,
+    const uint8_t* weights,
+    const uint8_t* scales,
+    const bfloat16_t* bias,
+    bfloat16_t* outputs,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k,
+    const bool broadcast_a) {
+  auto op = XE_DPAS_TT<8, float, bfloat16_t>{};
+  using WGTile = typename policy::WGTile;
+  using SGLayout = typename policy::SGLayout;
+  using MMA = typename TiledMMAHelper<
+      MMA_Atom<decltype(op)>,
+      Layout<WGTile>,
+      SGLayout>::TiledMMA;
+  auto mma = MMA{};
+
+  const int max_threads_per_workgroup = size(mma);
+  constexpr int max_threads_per_sm = 512;
+  TORCH_CHECK(
+      max_threads_per_sm % max_threads_per_workgroup == 0,
+      "max_threads_per_sm must be divisible by max_threads_per_workgroup");
+
+  constexpr int32_t wg_tile_n =
+      static_cast<int32_t>(get<1>(typename policy::WGTile{}));
+  TORCH_CHECK(
+      gemm_n % wg_tile_n == 0,
+      "fixed-M1 top-k grouped GEMM requires N to be divisible by the "
+      "selected N tile (",
+      wg_tile_n,
+      ")");
+  const int32_t n_tiles = (gemm_n + wg_tile_n - 1) / wg_tile_n;
+  const int64_t workgroups = static_cast<int64_t>(topk) * n_tiles;
+  sycl::range<3> local(1, 1, max_threads_per_workgroup);
+  sycl::range<3> group_range(1, workgroups, 1);
+
+  namespace syclex = sycl::ext::oneapi::experimental;
+  namespace intelex = sycl::ext::intel::experimental;
+  syclex::properties kernel_props{
+      syclex::sub_group_size<16>, intelex::grf_size<256>};
+
+  using GmemTiledCopyA = typename policy::GmemTiledCopyA;
+  using GmemTiledCopyB = typename policy::GmemTiledCopyB;
+  using GmemTiledCopyD = typename policy::GmemTiledCopyD;
+
+  stream.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for<GemmM1TopkCuteName<TopkId, policy, TileMajor>>(
+        sycl::nd_range<3>{group_range * local, local}, kernel_props, [=](auto) {
+          MoE::M1TopkGEMM<
+              GmemTiledCopyA,
+              GmemTiledCopyB,
+              GmemTiledCopyD,
+              TileMajor>(
+              activations,
+              weights,
+              scales,
+              bias,
+              outputs,
+              mma,
+              topk_ids,
+              expert_map,
+              expert_map_size,
+              topk,
+              num_local_experts,
+              gemm_n,
+              gemm_k,
+              broadcast_a);
+        });
+  });
+}
