+// only valid for Laguna's exact M=8 / TOPK=10 post-W2 tail and preserves
+// MoeGather's slot traversal before the protected BF16 rounding boundaries.
+// StoreDiagnostics is false in production, so the diagnostic stores are not
+// instantiated in that kernel.
+template <bool StoreDiagnostics>
+class LagunaM8MoeGatherFinalize {
+ public:
+  static constexpr int NumTokens = 8;
+  static constexpr int TopK = 10;
+  static constexpr int HiddenSize = 3072;
+  static constexpr int GroupWorkItem = 256;
+  static constexpr int WARP_SIZE = 32;
+  static constexpr int ElemsPerItem = 8;
+  static constexpr int Stride = GroupWorkItem * ElemsPerItem;
+
+  LagunaM8MoeGatherFinalize(
+      LagunaM8BFloat16* output,
+      const LagunaM8BFloat16* moe_output,
+      const float* topk_weights,
+      const LagunaM8BFloat16* shared,
+      LagunaM8BFloat16* routed_output,
+      LagunaM8BFloat16* scaled_output)
+      : output(output),
+        moe_output(moe_output),
+        topk_weights(topk_weights),
+        shared(shared),
+        routed_output(routed_output),
+        scaled_output(scaled_output) {}
+
+  static inline sycl::nd_range<1> get_nd_range() {
+    sycl::range<1> local(GroupWorkItem);
+    sycl::range<1> group(NumTokens);
+    return sycl::nd_range<1>(local * group, local);
+  }
+
+  void operator()
+      [[sycl::reqd_sub_group_size(WARP_SIZE)]] (sycl::nd_item<1> item) const {
+    const int local_id_x = item.get_local_id(0);
+    const int token_idx = item.get_group(0);
+
+    float scores[TopK];
+#pragma unroll
+    for (int i = 0; i < TopK; ++i) {
+      scores[i] = topk_weights[token_idx * TopK + i];
+    }
+
+    constexpr int LoopCount = (HiddenSize + Stride - 1) / Stride;
+#pragma unroll
+    for (int i = 0; i < LoopCount; ++i) {
+      const int hidden_idx = i * Stride + local_id_x * ElemsPerItem;
+      if (hidden_idx < HiddenSize) {
+        float accum[ElemsPerItem];
+#pragma unroll
+        for (int e = 0; e < ElemsPerItem; ++e) {
+          accum[e] = 0.0f;
+        }
+        // Fixed slot 0..9 FP32 accumulation. Remote routes are already
+        // represented by zero-filled W2 rows in this canonical row layout.
+#pragma unroll
+        for (int k = 0; k < TopK; ++k) {
+          const int moe_id = token_idx * TopK + k;
+#pragma unroll
+          for (int e = 0; e < ElemsPerItem; ++e) {
+            accum[e] += static_cast<float>(
+                            moe_output[moe_id * HiddenSize + hidden_idx + e]) *
+                        scores[k];
+          }
+        }
+#pragma unroll
+        for (int e = 0; e < ElemsPerItem; ++e) {
+          const int output_idx = token_idx * HiddenSize + hidden_idx + e;
+          const LagunaM8GatherFinalizeValues values =
+              laguna_m8_gather_finalize_arithmetic(
+                  accum[e], shared[output_idx]);
+          if constexpr (StoreDiagnostics) {
+            routed_output[output_idx] = values.routed_bf16;
+            scaled_output[output_idx] = values.scaled_bf16;
+          }
+          output[output_idx] = values.final_bf16;
+        }
+      }
+    }
+  }
+
+ private:
+  LagunaM8BFloat16* output;
+  const LagunaM8BFloat16* moe_output;
+  const float* topk_weights;
+  const LagunaM8BFloat16* shared;
+  LagunaM8BFloat16* routed_output;
+  LagunaM8BFloat16* scaled_output;
+};
