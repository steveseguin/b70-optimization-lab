+# SPDX-License-Identifier: Apache-2.0
+"""CPU-only source-contract checks for the default-unused Laguna tail."""
+
+import ast
+import subprocess
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+GATHER_SOURCE = (ROOT / "csrc/moe/moe_gather.cpp").read_text()
+HEADER = (ROOT / "csrc/moe/moe_ops.h").read_text()
+BINDINGS = (ROOT / "csrc/moe/torch_bindings.cpp").read_text()
+INVENTORY = (ROOT / "custom-kernels-inventory.md").read_text()
+INTERFACE = (ROOT / "vllm_xpu_kernels/fused_moe_interface.py").read_text()
+BASE_INTERFACE = subprocess.run(
+    [
+        "git",
+        "show",
+        "HEAD:vllm_xpu_kernels/fused_moe_interface.py",
+    ],
+    cwd=ROOT,
+    check=True,
+    capture_output=True,
+    text=True,
+).stdout
+
+CLASS_START = GATHER_SOURCE.index("class LagunaM8MoeGatherFinalize")
+CLASS_END = GATHER_SOURCE.index(
+    "template <typename T, typename IndexT", CLASS_START
+)
+CANDIDATE_CLASS = GATHER_SOURCE[CLASS_START:CLASS_END]
+
+ARITHMETIC_START = GATHER_SOURCE.index(
+    "inline LagunaM8GatherFinalizeValues laguna_m8_gather_finalize_arithmetic("
+)
+ARITHMETIC_END = CLASS_START
+ARITHMETIC_HELPER = GATHER_SOURCE[ARITHMETIC_START:ARITHMETIC_END]
+
+FUNCTION_START = GATHER_SOURCE.index("void laguna_m8_moe_gather_finalize(")
+DIAGNOSTIC_FUNCTION_START = GATHER_SOURCE.index(
+    "std::tuple<torch::Tensor, torch::Tensor, torch::Tensor>\n"
+    "laguna_m8_moe_gather_finalize_diagnostic("
+)
+FUNCTION_END = DIAGNOSTIC_FUNCTION_START
+CANDIDATE_FUNCTION = GATHER_SOURCE[FUNCTION_START:FUNCTION_END]
+
+DIAGNOSTIC_FUNCTION_END = GATHER_SOURCE.index(
+    "void moe_gather_direct_m1(", DIAGNOSTIC_FUNCTION_START
+)
