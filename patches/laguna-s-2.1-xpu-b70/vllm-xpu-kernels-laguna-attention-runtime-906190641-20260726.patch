+at::Tensor rank_order_bf16_sum(const at::Tensor& gathered) {
+  const at::DeviceGuard device_guard(gathered.device());
+  TORCH_CHECK(gathered.is_xpu(), "gathered must be an XPU tensor");
+  TORCH_CHECK(
+      gathered.scalar_type() == at::kBFloat16,
+      "rank-order sum currently supports BF16 only");
+  TORCH_CHECK(
+      gathered.dim() >= 2 && gathered.size(0) == 4,
+      "rank-order sum requires [4,...] TP4 input");
+  TORCH_CHECK(gathered.is_contiguous(), "gathered must be contiguous");
+
+  auto output = at::empty(gathered.sizes().slice(1), gathered.options());
+  const int64_t elements = output.numel();
+  const auto* input_ptr = reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(
+      gathered.data_ptr());
+  auto* output_ptr = reinterpret_cast<sycl::ext::oneapi::bfloat16*>(
+      output.data_ptr());
+  auto& queue =
+      at::xpu::getCurrentXPUStream(gathered.device().index()).queue();
+  queue.parallel_for(sycl::range<1>(elements), [=](sycl::id<1> index) {
+    const int64_t i = index[0];
+    sycl::ext::oneapi::bfloat16 value = input_ptr[i];
+    value = sycl::ext::oneapi::bfloat16(
+        static_cast<float>(value) + static_cast<float>(input_ptr[elements + i]));
+    value = sycl::ext::oneapi::bfloat16(
+        static_cast<float>(value) +
+        static_cast<float>(input_ptr[2 * elements + i]));
+    value = sycl::ext::oneapi::bfloat16(
+        static_cast<float>(value) +
+        static_cast<float>(input_ptr[3 * elements + i]));
+    output_ptr[i] = value;
+  });
+  return output;
+}
+
+bool is_xe2_arch(int64_t device_index = -1) {
+  at::DeviceIndex dev_idx = device_index;
+  return vllm::xpu::is_xe2_arch(dev_idx);
+}
+
+bool is_xe3_arch(int64_t device_index = -1) {
+  at::DeviceIndex dev_idx = device_index;
+  return vllm::xpu::is_xe3_arch(dev_idx);
+}
