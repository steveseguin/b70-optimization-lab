+inline sycl::ext::oneapi::bfloat16
+laguna_m8_silu_bf16(const sycl::ext::oneapi::bfloat16& gate) {
+  using bf16 = sycl::ext::oneapi::bfloat16;
+  bf16 activated = silu_kernel<bf16>(gate);
+
+  // torch.nn.functional.silu has one BF16 midpoint where the generic packed
+  // custom kernel rounds differently.  Preserve Laguna's incumbent
+  // F.silu(gate) * up result exactly: silu(BF16 0x40be / 5.9375) is BF16
+  // 0x40bd / 5.90625 on XPU.
+  if (sycl::bit_cast<uint16_t>(gate) == uint16_t{0x40be}) {
+    activated = sycl::bit_cast<bf16>(uint16_t{0x40bd});
+  }
+  return activated;
+}
+
+template <int VEC_SIZE>
+class laguna_m8_silu_mul_kernel {
+ public:
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+
+  laguna_m8_silu_mul_kernel(
+      scalar_t* __restrict__ out,
+      const scalar_t* __restrict__ gate,
+      const scalar_t* __restrict__ up)
+      : out_(out), gate_(gate), up_(up) {}
+
+  void operator()(sycl::nd_item<1> item) const {
+    using vec_t = vllm::xpu::aligned_vec<scalar_t, VEC_SIZE>;
+    constexpr int kWidth = 256;
+    constexpr int kVectorsPerRow = kWidth / VEC_SIZE;
+    const int64_t row = item.get_group(0);
+    const int64_t vec_idx = item.get_local_linear_id();
+
+    const auto gate_vec =
+        reinterpret_cast<const vec_t*>(gate_)[row * kVectorsPerRow + vec_idx];
+    const auto up_vec =
+        reinterpret_cast<const vec_t*>(up_)[row * kVectorsPerRow + vec_idx];
+    vec_t out_vec;
+#pragma unroll
+    for (int elem = 0; elem < VEC_SIZE; ++elem) {
+      const scalar_t activated = laguna_m8_silu_bf16(gate_vec[elem]);
+      out_vec[elem] = static_cast<scalar_t>(
+          static_cast<float>(activated) * static_cast<float>(up_vec[elem]));
+    }
+    reinterpret_cast<vec_t*>(out_)[row * kVectorsPerRow + vec_idx] = out_vec;
+  }
+
+ private:
+  scalar_t* __restrict__ out_;
+  const scalar_t* __restrict__ gate_;
+  const scalar_t* __restrict__ up_;
+};
+
+template <int VEC_SIZE>
+class laguna_m8_scale_add_kernel {
+ public:
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+
+  laguna_m8_scale_add_kernel(
+      scalar_t* __restrict__ out,
+      const scalar_t* __restrict__ shared,
+      const scalar_t* __restrict__ routed)
+      : out_(out), shared_(shared), routed_(routed) {}
+
+  void operator()(sycl::nd_item<1> item) const {
+    using vec_t = vllm::xpu::aligned_vec<scalar_t, VEC_SIZE>;
+    constexpr int kWidth = 3072;
+    constexpr int kVectorsPerRow = kWidth / VEC_SIZE;
+    const int64_t row = item.get_group(0);
+    const int64_t offset = item.get_local_linear_id();
+    const int64_t step = item.get_local_range(0);
+
+    for (int64_t vec_idx = offset; vec_idx < kVectorsPerRow; vec_idx += step) {
+      const auto shared_vec = reinterpret_cast<const vec_t*>(
+          shared_)[row * kVectorsPerRow + vec_idx];
+      const auto routed_vec = reinterpret_cast<const vec_t*>(
+          routed_)[row * kVectorsPerRow + vec_idx];
+      vec_t out_vec;
+#pragma unroll
+      for (int elem = 0; elem < VEC_SIZE; ++elem) {
+        // Match the two incumbent BF16 stores, not a single FP32 FMA:
+        //   fused_output *= 2.5
+        //   shared_output + fused_output
+        const scalar_t scaled =
+            static_cast<scalar_t>(static_cast<float>(routed_vec[elem]) * 2.5f);
+        out_vec[elem] = static_cast<scalar_t>(
+            static_cast<float>(shared_vec[elem]) + static_cast<float>(scaled));
+      }
+      reinterpret_cast<vec_t*>(out_)[row * kVectorsPerRow + vec_idx] = out_vec;
+    }
+  }
+
+ private:
+  scalar_t* __restrict__ out_;
+  const scalar_t* __restrict__ shared_;
+  const scalar_t* __restrict__ routed_;
+};
+
+template <typename scalar_t, int VEC_SIZE>
+class silu_and_mul_clamp_vec_kernel {
+ public:
+  silu_and_mul_clamp_vec_kernel(
+      scalar_t* __restrict__ out,
+      const scalar_t* __restrict__ input,
+      const int d,
+      const float limit)
+      : out_(out), input_(input), d_(d), limit_(limit) {}
+
+  void operator()(sycl::nd_item<1> item) const {
+    using vec_t = vllm::xpu::aligned_vec<scalar_t, VEC_SIZE>;
+    const int64_t token_idx = item.get_group(0);
+    const int64_t offset = item.get_local_linear_id();
+    const int64_t step = item.get_local_range(0);
+    const int64_t bound = d_ / VEC_SIZE;
+
+    for (int64_t i = offset; i < bound; i += step) {
+      auto gate_vec =
+          reinterpret_cast<const vec_t*>(input_)[token_idx * bound * 2 + i];
+      auto up_vec = reinterpret_cast<const vec_t*>(
+          input_)[token_idx * bound * 2 + i + bound];
+      vec_t out_vec;
+#pragma unroll
+      for (int elem = 0; elem < VEC_SIZE; ++elem) {
+        const float gate_f = static_cast<float>(gate_vec[elem]);
+        const float up_f = static_cast<float>(up_vec[elem]);
+        const scalar_t gate =
+            static_cast<scalar_t>(gate_f > limit_ ? limit_ : gate_f);
+        const scalar_t up = static_cast<scalar_t>(
+            up_f < -limit_ ? -limit_ : (up_f > limit_ ? limit_ : up_f));
+        out_vec[elem] =
+            compute<scalar_t, silu_kernel<scalar_t>, true>(gate, up);
+      }
+      reinterpret_cast<vec_t*>(out_)[token_idx * bound + i] = out_vec;
+    }
+  }
+
+ private:
+  scalar_t* __restrict__ out_;
+  const scalar_t* __restrict__ input_;
+  const int d_;
+  const float limit_;
+};
