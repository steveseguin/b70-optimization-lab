+          out_token.numel() == 1,
+      "tp4_read_max_token_from_pairs_out: out_token must be contiguous int64 [1]");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous() &&
+          static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "tp4_read_max_token_from_pairs_out: workspace is invalid");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(channel >= 0 && channel < kChannels, "invalid TP4 channel");
+  TORCH_CHECK(epoch > 0 && epoch <= INT32_MAX, "invalid TP4 epoch");
+
+  std::array<uint8_t*, kWorld> bases{};
+  {
+    std::lock_guard<std::mutex> lock(g_registry_mutex);
+    for (int r = 0; r < kWorld; ++r) {
+      TORCH_CHECK(
+          r == rank || g_peer_bases[r] != nullptr,
+          "tp4_read_max_token_from_pairs_out: peer registry incomplete for rank ",
+          r);
+      bases[r] = r == rank
+          ? static_cast<uint8_t*>(workspace.data_ptr())
+          : static_cast<uint8_t*>(g_peer_bases[r]);
+    }
+  }
+  const int slot = static_cast<int>(epoch % kSlots);
+  const size_t payload_offset =
+      (static_cast<size_t>(channel) * kSlots + slot) * kHidden * sizeof(bf16);
+  std::array<float*, kWorld> pairs{};
+  for (int r = 0; r < kWorld; ++r) {
+    pairs[r] = reinterpret_cast<float*>(bases[r] + payload_offset);
+  }
+  int64_t* output = out_token.data_ptr<int64_t>();
+  auto& q = vllm::xpu::vllmGetQueue();
+  q.submit([&](sycl::handler& cgh) {
+    cgh.single_task<TP4PairReadKernel>([=]() SYCL_ESIMD_KERNEL {
+      esimd::fence<
+          esimd::memory_kind::global,
+          esimd::fence_flush_op::invalidate,
+          esimd::fence_scope::system>();
+      float best_value = -std::numeric_limits<float>::infinity();
+      int64_t best_token = INT64_MAX;
+#pragma unroll
+      for (int r = 0; r < kWorld; ++r) {
+        const esimd::simd<float, 2> pair =
+            esimd::block_load<float, 2>(pairs[r]);
+        const int64_t token = static_cast<int64_t>(pair[1]);
+        if (pair[0] > best_value ||
+            (pair[0] == best_value && token < best_token)) {
+          best_value = pair[0];
+          best_token = token;
+        }
+      }
+      esimd::simd<int64_t, 1> result = best_token;
+      esimd::block_store<int64_t, 1>(output, result);
+    });
+  });
+}
