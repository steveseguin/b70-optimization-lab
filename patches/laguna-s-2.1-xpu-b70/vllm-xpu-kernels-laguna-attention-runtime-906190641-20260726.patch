+template <typename TopkId>
+void M1TopkGEMMLaunchByN(
+    sycl::queue& stream,
+    const bfloat16_t* activations,
+    const uint8_t* weights,
+    const uint8_t* scales,
+    const bfloat16_t* bias,
+    bfloat16_t* outputs,
+    const TopkId* topk_ids,
+    const int32_t* expert_map,
+    const int32_t expert_map_size,
+    const int32_t topk,
+    const int32_t num_local_experts,
+    const int32_t gemm_n,
+    const int32_t gemm_k,
+    const bool broadcast_a) {
+  const char* tile_major_env = std::getenv("VLLM_XPU_MXFP4_TILE_MAJOR_PREPACK");
+  const bool tile_major =
+      tile_major_env != nullptr && std::strcmp(tile_major_env, "1") == 0;
+  if (tile_major) {
+    M1TopkGEMMLauncher<w4a16_policy_m_8, true>(
+        stream,
+        activations,
+        weights,
+        scales,
+        bias,
+        outputs,
+        topk_ids,
+        expert_map,
+        expert_map_size,
+        topk,
+        num_local_experts,
+        gemm_n,
+        gemm_k,
+        broadcast_a);
+    return;
+  }
+  const char* small_m_n = std::getenv("VLLM_XPU_MXFP4_SMALL_M_N");
+  if (small_m_n != nullptr && std::strcmp(small_m_n, "32") == 0) {
+    M1TopkGEMMLauncher<w4a16_policy_m_8_n_32>(
+        stream,
+        activations,
+        weights,
+        scales,
+        bias,
+        outputs,
+        topk_ids,
+        expert_map,
+        expert_map_size,
+        topk,
+        num_local_experts,
+        gemm_n,
+        gemm_k,
+        broadcast_a);
+  } else if (small_m_n != nullptr && std::strcmp(small_m_n, "128") == 0) {
+    M1TopkGEMMLauncher<w4a16_policy_m_8_n_128>(
+        stream,
+        activations,
+        weights,
+        scales,
+        bias,
+        outputs,
+        topk_ids,
+        expert_map,
+        expert_map_size,
+        topk,
+        num_local_experts,
+        gemm_n,
+        gemm_k,
+        broadcast_a);
+  } else {
+    M1TopkGEMMLauncher<w4a16_policy_m_8>(
+        stream,
+        activations,
+        weights,
+        scales,
+        bias,
+        outputs,
+        topk_ids,
+        expert_map,
+        expert_map_size,
+        topk,
+        num_local_experts,
+        gemm_n,
+        gemm_k,
+        broadcast_a);
+  }
+}
