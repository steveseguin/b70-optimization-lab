diff --git a/csrc/quantization/hadamard/hadamard_transform.cpp b/csrc/quantization/hadamard/hadamard_transform.cpp
new file mode 100644
index 0000000..9c6f48c
--- /dev/null
+++ b/csrc/quantization/hadamard/hadamard_transform.cpp
@@ -0,0 +1,116 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+#include <sycl/sycl.hpp>
+
+#include "dispatch_utils.h"
+#include "utils.h"
+
+namespace vllm {
+
+constexpr int kHadamardWidth = 128;
+constexpr int kSubGroupSize = 32;
+constexpr float kInvSqrt128 = 0.08838834764831844055f;
+
+template <typename scalar_t>
+class hadamard_128_kernel {
+ public:
+  hadamard_128_kernel(
+      const scalar_t* input, scalar_t* output, int64_t num_rows)
+      : input_(input), output_(output), num_rows_(num_rows) {}
+
+  [[sycl::reqd_sub_group_size(kSubGroupSize)]] void operator()(
+      const sycl::nd_item<1>& item) const {
+    const int64_t row = item.get_group(0);
+    const int lane = item.get_local_id(0);
+    if (row >= num_rows_) return;
+
+    const scalar_t* src = input_ + row * kHadamardWidth;
+    scalar_t* dst = output_ + row * kHadamardWidth;
+    float values[4];
+#pragma unroll
+    for (int part = 0; part < 4; ++part) {
+      values[part] = static_cast<float>(src[lane + part * kSubGroupSize]);
+    }
+
+    // The first five Sylvester butterfly stages stay within each subgroup.
+    // Each lane owns the same offset in four consecutive 32-value blocks.
+    const auto subgroup = item.get_sub_group();
+#pragma unroll
+    for (int stride = 1; stride < kSubGroupSize; stride <<= 1) {
+#pragma unroll
+      for (int part = 0; part < 4; ++part) {
+        const float peer =
+            sycl::permute_group_by_xor(subgroup, values[part], stride);
+        values[part] =
+            (lane & stride) == 0 ? values[part] + peer : peer - values[part];
+      }
+    }
+
+    // The final two stages cross the four register-resident 32-value blocks.
+    const float v0 = values[0];
+    const float v1 = values[1];
+    const float v2 = values[2];
+    const float v3 = values[3];
+    const float s01 = v0 + v1;
+    const float d01 = v0 - v1;
+    const float s23 = v2 + v3;
+    const float d23 = v2 - v3;
+    values[0] = s01 + s23;
+    values[1] = d01 + d23;
+    values[2] = s01 - s23;
+    values[3] = d01 - d23;
+
+#pragma unroll
+    for (int part = 0; part < 4; ++part) {
+      dst[lane + part * kSubGroupSize] =
+          static_cast<scalar_t>(values[part] * kInvSqrt128);
+    }
+  }
+
+ private:
+  const scalar_t* input_;
+  scalar_t* output_;
+  int64_t num_rows_;
+};
+
+}  // namespace vllm
+
+torch::Tensor hadacore_transform(torch::Tensor& input, bool inplace) {
+  TORCH_CHECK(input.is_xpu(), "hadacore_transform expects an XPU tensor");
+  TORCH_CHECK(input.dim() >= 1, "hadacore_transform expects at least 1 dimension");
+  TORCH_CHECK(
+      input.size(-1) == vllm::kHadamardWidth,
+      "XPU hadacore_transform supports only width 128, got ",
+      input.size(-1));
+  TORCH_CHECK(
+      input.is_contiguous(), "XPU hadacore_transform expects a contiguous tensor");
+  TORCH_CHECK(
+      input.scalar_type() == torch::kFloat16 ||
+          input.scalar_type() == torch::kBFloat16,
+      "XPU hadacore_transform supports only float16 and bfloat16");
+
+  torch::Tensor output = inplace ? input : torch::empty_like(input);
+  const int64_t num_rows = input.numel() / vllm::kHadamardWidth;
+  if (num_rows == 0) return output;
+
+  at::DeviceGuard device_guard(input.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  const sycl::range<1> local(vllm::kSubGroupSize);
+  const sycl::range<1> global(num_rows * vllm::kSubGroupSize);
+
+  VLLM_DISPATCH_HALF_TYPES(input.scalar_type(), "hadacore_transform_xpu", [&] {
+    using sycl_t = typename vllm::xpu::SyclTypeTrait<scalar_t>::Type;
+    const auto* input_ptr =
+        reinterpret_cast<const sycl_t*>(input.data_ptr<scalar_t>());
+    auto* output_ptr = reinterpret_cast<sycl_t*>(output.data_ptr<scalar_t>());
+    queue.submit([&](sycl::handler& cgh) {
+      cgh.parallel_for(
+          sycl::nd_range<1>(global, local),
+          vllm::hadamard_128_kernel<sycl_t>(
+              input_ptr, output_ptr, num_rows));
+    });
+  });
+
+  return output;
+}
