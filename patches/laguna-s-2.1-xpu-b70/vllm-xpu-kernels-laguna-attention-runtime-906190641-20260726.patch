+    assert "route_map" not in CANDIDATE_BINDING
+    assert "unpermuted_row_to_permuted_row" not in CANDIDATE_HEADER
+    assert "_moe_C::laguna_m8_moe_gather_finalize" in INVENTORY
+    candidate_inventory = INVENTORY.split(
+        "_moe_C::laguna_m8_moe_gather_finalize", 1
+    )[1]
+    assert "route_map" not in candidate_inventory
+
+
+def test_diagnostic_op_returns_boundaries_without_production_schema_change():
+    production_schema = (
