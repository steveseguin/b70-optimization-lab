+    elements = 8 * 256
+    for start in range(0, gate_values.numel(), elements):
+        count = min(elements, gate_values.numel() - start)
+        gate = torch.zeros(elements, dtype=torch.bfloat16, device=device)
+        up = torch.ones(elements, dtype=torch.bfloat16, device=device)
+        gate[:count].copy_(gate_values[start:start + count])
+        up[:count].copy_(up_values[start:start + count])
+        gate = gate.view(8, 256)
+        up = up.view(8, 256)
+        out = torch.empty_like(gate)
+        torch.ops._C.laguna_m8_silu_mul(out, gate, up)
