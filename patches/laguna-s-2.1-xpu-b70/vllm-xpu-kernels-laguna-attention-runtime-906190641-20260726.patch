+void deepseek_m2_biased_topk_norm_out(
+    torch::Tensor& topk_weights,
+    torch::Tensor& topk_indices,
+    const torch::Tensor& scores,
+    const torch::Tensor& bias,
+    double routed_scaling_factor) {
+  TORCH_CHECK(scores.device().is_xpu(), "scores must be an XPU tensor");
+  TORCH_CHECK(topk_weights.device() == scores.device(), "weights device mismatch");
+  TORCH_CHECK(topk_indices.device() == scores.device(), "indices device mismatch");
+  TORCH_CHECK(bias.device() == scores.device(), "bias device mismatch");
+  TORCH_CHECK(scores.scalar_type() == at::kFloat, "scores must be FP32");
+  TORCH_CHECK(bias.scalar_type() == at::kFloat, "bias must be FP32");
+  TORCH_CHECK(topk_weights.scalar_type() == at::kFloat, "weights must be FP32");
+  TORCH_CHECK(
+      topk_indices.scalar_type() == at::kInt ||
+          topk_indices.scalar_type() == at::kLong,
+      "indices must be int32 or int64");
+  TORCH_CHECK(scores.is_contiguous(), "scores must be contiguous");
+  TORCH_CHECK(bias.is_contiguous(), "bias must be contiguous");
+  TORCH_CHECK(topk_weights.is_contiguous(), "weights must be contiguous");
+  TORCH_CHECK(topk_indices.is_contiguous(), "indices must be contiguous");
+  TORCH_CHECK(
+      scores.dim() == 2 &&
+          (scores.size(0) == 2 || scores.size(0) == 8),
+      "scores must be [M,E] with M in {2,8}");
+  TORCH_CHECK(bias.dim() == 1, "bias must be [E]");
+  TORCH_CHECK(bias.numel() == scores.size(1), "bias size mismatch");
+  TORCH_CHECK(
+      topk_weights.dim() == 2 && topk_weights.size(0) == scores.size(0),
+      "weights must be [M,K]");
+  TORCH_CHECK(topk_indices.sizes() == topk_weights.sizes(), "output shape mismatch");
+  const int64_t topk = topk_weights.size(1);
+  TORCH_CHECK(topk >= 1 && topk <= 8, "topk must be in [1,8]");
+  TORCH_CHECK(scores.size(1) <= 256, "experts must be <= 256");
+
+  at::DeviceGuard device_guard(scores.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  if (topk_indices.scalar_type() == at::kInt) {
+    vllm::launch_deepseek_m1_biased_topk<int32_t, true>(
+        queue,
+        topk_weights.data_ptr<float>(),
+        topk_indices.data_ptr<int32_t>(),
+        scores.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        scores.size(0),
+        scores.size(1),
+        topk,
+        static_cast<float>(routed_scaling_factor));
+  } else {
+    vllm::launch_deepseek_m1_biased_topk<int64_t, true>(
+        queue,
+        topk_weights.data_ptr<float>(),
+        topk_indices.data_ptr<int64_t>(),
+        scores.data_ptr<float>(),
+        bias.data_ptr<float>(),
+        scores.size(0),
+        scores.size(1),
+        topk,
+        static_cast<float>(routed_scaling_factor));
+  }
+}
diff --git a/csrc/xpu/sycl/deepseek_markov_m1_bf16_dpas.cpp b/csrc/xpu/sycl/deepseek_markov_m1_bf16_dpas.cpp
new file mode 100644
index 0000000..401324b
--- /dev/null
+++ b/csrc/xpu/sycl/deepseek_markov_m1_bf16_dpas.cpp
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: Apache-2.0
+// Fixed-K Xe2 DPAS kernel for the DSpark Markov W2 projection.
+
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/esimd/memory.hpp>
+#include <torch/all.h>
+
+#include "utils.h"
+
+namespace esimd = sycl::ext::intel::esimd;
+namespace xesimd = sycl::ext::intel::experimental::esimd;
+namespace xmx = sycl::ext::intel::esimd::xmx;
+
+namespace vllm {
+
+using bf16_t = sycl::ext::oneapi::bfloat16;
+
+SYCL_ESIMD_FUNCTION esimd::simd<bf16_t, 256> bf16_block_to_vnni(
+    esimd::simd<bf16_t, 256> raw) {
+  esimd::simd<uint32_t, 128> vnni;
+#pragma unroll
+  for (int pair = 0; pair < 8; ++pair) {
+    esimd::simd<uint16_t, 16> even =
+        raw.template select<16, 1>(2 * pair * 16)
+            .template bit_cast_view<uint16_t>()
+            .read();
+    esimd::simd<uint16_t, 16> odd =
+        raw.template select<16, 1>((2 * pair + 1) * 16)
+            .template bit_cast_view<uint16_t>()
+            .read();
+    vnni.template select<16, 1>(pair * 16) =
+        esimd::convert<uint32_t>(even) |
+        (esimd::convert<uint32_t>(odd) << 16);
+  }
+  return vnni.template bit_cast_view<bf16_t>();
+}
+
+template <int TILES_PER_ITEM>
+class deepseek_markov_m1_bf16_dpas_kernel;
+
+template <int TILES_PER_ITEM, typename TokenT>
+class deepseek_markov_token_m1_bf16_dpas_kernel;
+
+template <int TILES_PER_ITEM>
+void launch_markov_m1_bf16_dpas(
+    sycl::queue& queue,
+    bf16_t* output,
+    const bf16_t* activation,
+    const bf16_t* packed_weight,
+    int n) {
+  constexpr int k = 256;
+  constexpr int n_tile = 16;
+  constexpr int k_tile = 16;
+  const int n_tiles = n / n_tile;
+  const int work_items =
+      (n_tiles + TILES_PER_ITEM - 1) / TILES_PER_ITEM;
+
+  queue.submit([&](sycl::handler& handler) {
+    handler.parallel_for<
+        deepseek_markov_m1_bf16_dpas_kernel<TILES_PER_ITEM>>(
+        sycl::range<1>(work_items),
+        [=](sycl::id<1> index) [[intel::sycl_explicit_simd]] {
+          const int first_tile = int(index[0]) * TILES_PER_ITEM;
+          esimd::simd<float, TILES_PER_ITEM * n_tile> accum(0.0f);
+
+#pragma unroll
+          for (int ki = 0; ki < k; ki += k_tile) {
+            auto activation_tile = esimd::block_load<bf16_t, k_tile>(
+                activation + ki);
+#pragma unroll
+            for (int tile_offset = 0; tile_offset < TILES_PER_ITEM;
+                 ++tile_offset) {
+              const int tile = first_tile + tile_offset;
+              if (tile < n_tiles) {
+                const int nj = tile * n_tile;
+                xesimd::config_2d_mem_access<bf16_t, n_tile, k_tile, 1>
+                    payload(
+                        packed_weight,
+                        uint32_t(n * int(sizeof(bf16_t)) - 1),
+                        uint32_t(k - 1),
+                        uint32_t(n * int(sizeof(bf16_t)) - 1),
+                        uint32_t(nj),
+                        uint32_t(ki));
+                auto raw = xesimd::lsc_load_2d<
+                    bf16_t,
+                    n_tile,
+                    k_tile,
+                    1,
+                    false,
+                    false,
+                    xesimd::cache_hint::cached,
+                    xesimd::cache_hint::cached>(payload);
+                auto weight_tile = bf16_block_to_vnni(raw);
+                esimd::simd<float, n_tile> tile_accum =
+                    accum.template select<n_tile, 1>(
+                        tile_offset * n_tile).read();
+                accum.template select<n_tile, 1>(tile_offset * n_tile) =
+                    xmx::dpas<8, 1, float, float, bf16_t, bf16_t>(
+                        tile_accum, weight_tile, activation_tile);
+              }
+            }
+          }
+
+#pragma unroll
+          for (int tile_offset = 0; tile_offset < TILES_PER_ITEM;
+               ++tile_offset) {
+            const int tile = first_tile + tile_offset;
+            if (tile < n_tiles) {
+              esimd::block_store<bf16_t, n_tile>(
+                  output + tile * n_tile,
+                  esimd::convert<bf16_t>(
+                      accum.template select<n_tile, 1>(
+                          tile_offset * n_tile).read()));
+            }
+          }
+        });
+  });
+}
+
+template <int TILES_PER_ITEM, typename TokenT>
+void launch_markov_token_m1_bf16_dpas(
+    sycl::queue& queue,
+    bf16_t* output,
+    const TokenT* token,
+    const bf16_t* embedding_table,
+    const bf16_t* packed_weight,
+    int n) {
+  constexpr int k = 256;
+  constexpr int n_tile = 16;
+  constexpr int k_tile = 16;
+  const int n_tiles = n / n_tile;
+  const int work_items =
+      (n_tiles + TILES_PER_ITEM - 1) / TILES_PER_ITEM;
+
+  queue.submit([&](sycl::handler& handler) {
+    handler.parallel_for<
+        deepseek_markov_token_m1_bf16_dpas_kernel<TILES_PER_ITEM, TokenT>>(
+        sycl::range<1>(work_items),
+        [=](sycl::id<1> index) [[intel::sycl_explicit_simd]] {
+          const int64_t token_id =
+              static_cast<int64_t>(esimd::block_load<TokenT, 1>(token)[0]);
+          const bf16_t* activation = embedding_table + token_id * k;
+          const int first_tile = int(index[0]) * TILES_PER_ITEM;
+          esimd::simd<float, TILES_PER_ITEM * n_tile> accum(0.0f);
+
+#pragma unroll
+          for (int ki = 0; ki < k; ki += k_tile) {
+            auto activation_tile = esimd::block_load<bf16_t, k_tile>(
+                activation + ki);
+#pragma unroll
+            for (int tile_offset = 0; tile_offset < TILES_PER_ITEM;
+                 ++tile_offset) {
+              const int tile = first_tile + tile_offset;
+              if (tile < n_tiles) {
+                const int nj = tile * n_tile;
+                xesimd::config_2d_mem_access<bf16_t, n_tile, k_tile, 1>
+                    payload(
+                        packed_weight,
+                        uint32_t(n * int(sizeof(bf16_t)) - 1),
+                        uint32_t(k - 1),
+                        uint32_t(n * int(sizeof(bf16_t)) - 1),
+                        uint32_t(nj),
+                        uint32_t(ki));
+                auto raw = xesimd::lsc_load_2d<
+                    bf16_t,
+                    n_tile,
+                    k_tile,
+                    1,
+                    false,
+                    false,
+                    xesimd::cache_hint::cached,
+                    xesimd::cache_hint::cached>(payload);
+                auto weight_tile = bf16_block_to_vnni(raw);
+                esimd::simd<float, n_tile> tile_accum =
+                    accum.template select<n_tile, 1>(
+                        tile_offset * n_tile).read();
+                accum.template select<n_tile, 1>(tile_offset * n_tile) =
+                    xmx::dpas<8, 1, float, float, bf16_t, bf16_t>(
+                        tile_accum, weight_tile, activation_tile);
+              }
+            }
+          }
+
+#pragma unroll
+          for (int tile_offset = 0; tile_offset < TILES_PER_ITEM;
+               ++tile_offset) {
+            const int tile = first_tile + tile_offset;
+            if (tile < n_tiles) {
+              esimd::block_store<bf16_t, n_tile>(
+                  output + tile * n_tile,
+                  esimd::convert<bf16_t>(
+                      accum.template select<n_tile, 1>(
+                          tile_offset * n_tile).read()));
+            }
+          }
+        });
+  });
+}
+
+}  // namespace vllm
+
+void deepseek_markov_m1_bf16_dpas_out(
+    torch::Tensor& output,
+    const torch::Tensor& activation,
+    const torch::Tensor& packed_weight,
+    int64_t tiles_per_item) {
+  TORCH_CHECK(activation.is_xpu(), "activation must be on XPU");
+  TORCH_CHECK(output.device() == activation.device(), "output device mismatch");
+  TORCH_CHECK(
+      packed_weight.device() == activation.device(), "weight device mismatch");
+  TORCH_CHECK(
+      output.scalar_type() == at::kBFloat16 &&
+          activation.scalar_type() == at::kBFloat16 &&
+          packed_weight.scalar_type() == at::kBFloat16,
+      "Markov DPAS tensors must be BF16");
+  TORCH_CHECK(
+      output.is_contiguous() && activation.is_contiguous() &&
+          packed_weight.is_contiguous(),
+      "Markov DPAS tensors must be contiguous");
+  TORCH_CHECK(
+      activation.sizes() == at::IntArrayRef({1, 256}),
+      "activation must be [1,256]");
+  TORCH_CHECK(
+      packed_weight.dim() == 2 && packed_weight.size(0) == 256,
+      "packed weight must be [256,N]");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == 1 &&
+          output.size(1) == packed_weight.size(1),
+      "output must be [1,N]");
+  const int n = int(output.size(1));
+  TORCH_CHECK(n % 16 == 0, "N must be divisible by 16");
+
+  at::DeviceGuard device_guard(activation.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  auto* output_ptr = reinterpret_cast<vllm::bf16_t*>(output.data_ptr());
+  const auto* activation_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(activation.data_ptr());
+  const auto* weight_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(packed_weight.data_ptr());
+  switch (tiles_per_item) {
+    case 1:
+      vllm::launch_markov_m1_bf16_dpas<1>(
+          queue, output_ptr, activation_ptr, weight_ptr, n);
+      break;
+    case 2:
+      vllm::launch_markov_m1_bf16_dpas<2>(
+          queue, output_ptr, activation_ptr, weight_ptr, n);
+      break;
+    case 4:
+      vllm::launch_markov_m1_bf16_dpas<4>(
+          queue, output_ptr, activation_ptr, weight_ptr, n);
+      break;
+    case 8:
+      vllm::launch_markov_m1_bf16_dpas<8>(
+          queue, output_ptr, activation_ptr, weight_ptr, n);
+      break;
+    default:
+      TORCH_CHECK(false, "tiles_per_item must be 1, 2, 4, or 8");
+  }
+}
+
+void deepseek_markov_token_m1_bf16_dpas_out(
+    torch::Tensor& output,
+    const torch::Tensor& token,
+    const torch::Tensor& embedding_table,
+    const torch::Tensor& packed_weight,
+    int64_t tiles_per_item) {
+  TORCH_CHECK(output.is_xpu(), "output must be on XPU");
+  TORCH_CHECK(
+      token.device() == output.device() &&
+          embedding_table.device() == output.device() &&
+          packed_weight.device() == output.device(),
+      "Markov token DPAS device mismatch");
+  TORCH_CHECK(
+      output.scalar_type() == at::kBFloat16 &&
+          embedding_table.scalar_type() == at::kBFloat16 &&
+          packed_weight.scalar_type() == at::kBFloat16 &&
+          (token.scalar_type() == at::kLong ||
+           token.scalar_type() == at::kInt),
+      "invalid Markov token DPAS dtype");
+  TORCH_CHECK(
+      output.is_contiguous() && token.is_contiguous() &&
+          embedding_table.is_contiguous() && packed_weight.is_contiguous(),
+      "Markov token DPAS tensors must be contiguous");
+  TORCH_CHECK(token.numel() == 1, "token must contain one int64");
+  TORCH_CHECK(
+      embedding_table.dim() == 2 && embedding_table.size(1) == 256,
+      "embedding table must be [vocab,256]");
+  TORCH_CHECK(
+      packed_weight.dim() == 2 && packed_weight.size(0) == 256,
+      "packed weight must be [256,N]");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == 1 &&
+          output.size(1) == packed_weight.size(1),
+      "output must be [1,N]");
+  const int n = int(output.size(1));
+  TORCH_CHECK(n % 16 == 0, "N must be divisible by 16");
+
+  at::DeviceGuard device_guard(output.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  auto* output_ptr = reinterpret_cast<vllm::bf16_t*>(output.data_ptr());
+  const auto* embedding_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(embedding_table.data_ptr());
+  const auto* weight_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(packed_weight.data_ptr());
+#define DISPATCH_TOKEN_DPAS(TOKEN_TYPE)                                      \
+  do {                                                                        \
+    const auto* token_ptr = token.data_ptr<TOKEN_TYPE>();                      \
+    switch (tiles_per_item) {                                                  \
+      case 1:                                                                 \
+        vllm::launch_markov_token_m1_bf16_dpas<1, TOKEN_TYPE>(                 \
+            queue, output_ptr, token_ptr, embedding_ptr, weight_ptr, n);       \
+        break;                                                                \
+      case 2:                                                                 \
+        vllm::launch_markov_token_m1_bf16_dpas<2, TOKEN_TYPE>(                 \
+            queue, output_ptr, token_ptr, embedding_ptr, weight_ptr, n);       \
+        break;                                                                \
+      case 4:                                                                 \
+        vllm::launch_markov_token_m1_bf16_dpas<4, TOKEN_TYPE>(                 \
+            queue, output_ptr, token_ptr, embedding_ptr, weight_ptr, n);       \
+        break;                                                                \
+      case 8:                                                                 \
+        vllm::launch_markov_token_m1_bf16_dpas<8, TOKEN_TYPE>(                 \
+            queue, output_ptr, token_ptr, embedding_ptr, weight_ptr, n);       \
+        break;                                                                \
+      default:                                                                \
+        TORCH_CHECK(false, "tiles_per_item must be 1, 2, 4, or 8");           \
+    }                                                                         \
+  } while (false)
+  if (token.scalar_type() == at::kInt) {
+    DISPATCH_TOKEN_DPAS(int32_t);
+  } else {
+    DISPATCH_TOKEN_DPAS(int64_t);
+  }
+#undef DISPATCH_TOKEN_DPAS
+}
diff --git a/csrc/xpu/sycl/deepseek_qnorm_rope_kv_insert.cpp b/csrc/xpu/sycl/deepseek_qnorm_rope_kv_insert.cpp
new file mode 100644
index 0000000..026b884
--- /dev/null
+++ b/csrc/xpu/sycl/deepseek_qnorm_rope_kv_insert.cpp
@@ -0,0 +1,694 @@
+// SPDX-License-Identifier: Apache-2.0
+// Fused DeepSeek-V4 Q-RMSNorm + GPT-J RoPE + KV cache insert.
+// One sub-group (16 lanes) per (token, head_or_kv). Dispatches bf16 or fp8
+// cache format via kv_cache_dtype parameter.
+
+#include <sycl/sycl.hpp>
+#include "utils.h"
+#include <cstdint>
+#include <torch/all.h>
+
+namespace vllm {
+
+using bf16_t = sycl::ext::oneapi::bfloat16;
+
+static constexpr float FP8_MAX = 448.0f;
+
+// Ceil to power-of-2 via IEEE754 bit hack; also returns biased exponent.
+inline float fast_ceil_pow2(float x, uint32_t& out_scale_exp) {
+  uint32_t bits;
+  __builtin_memcpy(&bits, &x, 4);
+  if (bits & 0x7FFFFF) {
+    bits = (bits + 0x800000) & 0xFF800000u;
+  }
+  out_scale_exp = bits >> 23;
+  float result;
+  __builtin_memcpy(&result, &bits, 4);
+  return result;
+}
+
+// Divide by pow2 scale and convert to fp8_e4m3 via integer arithmetic.
+inline uint8_t fused_scale_to_fp8(float val, uint32_t scale_exp) {
+  uint32_t bits;
+  __builtin_memcpy(&bits, &val, 4);
+  uint32_t sign = bits >> 31;
+  uint32_t v_exp = (bits >> 23) & 0xFFu;
+  uint32_t v_mant = bits & 0x7FFFFFu;
+
+  uint32_t mant3 = v_mant >> 20;
+  uint32_t remainder = v_mant & 0xFFFFFu;
+  // Round-to-nearest-even
+  if (remainder > 0x80000u || (remainder == 0x80000u && (mant3 & 1u))) {
+    mant3++;
+  }
+  uint32_t e4m3_exp = v_exp - scale_exp + 7u + (mant3 >> 3);
+  mant3 &= 7u;
+  uint32_t result = (e4m3_exp << 3) | mant3;
+  result = (v_exp + 7u >= scale_exp) ? result : 0u;
+
+  return static_cast<uint8_t>((sign << 7) | (result & 0x7Fu));
+}
+
+template <int HEAD_DIM_, int ROPE_DIM_>
+class qnorm_rope_kv_insert_bf16_kernel {
+ public:
+  static constexpr int HEAD_DIM = HEAD_DIM_;
+  static constexpr int ROPE_DIM = ROPE_DIM_;
+  static constexpr int NOPE_DIM = HEAD_DIM - ROPE_DIM;
+  static constexpr int HALF_ROPE = ROPE_DIM / 2;
+  static constexpr int SG_SIZE = 16;
+  static constexpr int NOPE_ITERS = NOPE_DIM / (4 * SG_SIZE);
+  static constexpr int ROPE_ITERS = HALF_ROPE / SG_SIZE;
+  static_assert(
+      NOPE_DIM % (4 * SG_SIZE) == 0, "NOPE_DIM must be divisible by 4*SG_SIZE");
+  static_assert(
+      HALF_ROPE % SG_SIZE == 0, "ROPE_DIM/2 must be divisible by SG_SIZE");
+
+  qnorm_rope_kv_insert_bf16_kernel(
+      bf16_t* __restrict__ q,
+      const bf16_t* __restrict__ kv,
+      bf16_t* __restrict__ cache,
+      const int64_t* __restrict__ slot_mapping,
+      const int64_t* __restrict__ position_ids,
+      const float* __restrict__ cos_sin_cache,
+      float eps,
+      int64_t num_tokens,
+      int64_t num_heads_q,
+      int64_t block_size,
+      int64_t q_stride_token,
+      int64_t q_stride_head,
+      int64_t kv_stride_token,
+      int64_t cache_stride_block,
+      int64_t cache_stride_pos)
+      : q_(q),
+        kv_(kv),
+        cache_(cache),
+        slot_mapping_(slot_mapping),
+        position_ids_(position_ids),
+        cos_sin_cache_(cos_sin_cache),
+        eps_(eps),
+        num_tokens_(num_tokens),
+        num_heads_q_(num_heads_q),
+        block_size_(block_size),
+        q_stride_token_(q_stride_token),
+        q_stride_head_(q_stride_head),
+        kv_stride_token_(kv_stride_token),
+        cache_stride_block_(cache_stride_block),
+        cache_stride_pos_(cache_stride_pos) {}
+
+  [[sycl::reqd_sub_group_size(SG_SIZE)]]
+  void operator()(sycl::nd_item<3> item) const {
+    const int64_t token_idx = item.get_global_id(0);
+    const int64_t slot_idx = item.get_global_id(1);
+    const int64_t lane = item.get_local_id(2);
+
+    if (token_idx >= num_tokens_) return;
+    const bool is_kv = (slot_idx == num_heads_q_);
+
+    const bf16_t* src;
+    if (is_kv) {
+      src = kv_ + token_idx * kv_stride_token_;
+    } else {
+      src = q_ + token_idx * q_stride_token_ + slot_idx * q_stride_head_;
+    }
+
+    // Load NoPE dims [0, NOPE_DIM) as packed uint64 (4×bf16 per lane).
+    float sum_sq = 0.0f;
+    uint64_t nope_regs[NOPE_ITERS];
+    {
+      const uint64_t* s8 = reinterpret_cast<const uint64_t*>(src);
+#pragma unroll
+      for (int i = 0; i < NOPE_ITERS; ++i) {
+        uint64_t val = s8[lane + i * SG_SIZE];
+        nope_regs[i] = val;
+        if (!is_kv) {
+          const bf16_t* vals = reinterpret_cast<const bf16_t*>(&val);
+#pragma unroll
+          for (int j = 0; j < 4; ++j) {
+            float fv = static_cast<float>(vals[j]);
+            sum_sq += fv * fv;
+          }
+        }
+      }
+    }
+
+    // Load interleaved RoPE pairs [NOPE_DIM, HEAD_DIM).
+    float rope_even[ROPE_ITERS], rope_odd[ROPE_ITERS];
+#pragma unroll
+    for (int pp = 0; pp < ROPE_ITERS; ++pp) {
+      const int p = lane + pp * SG_SIZE;
+      float x_even = static_cast<float>(src[NOPE_DIM + 2 * p]);
+      float x_odd = static_cast<float>(src[NOPE_DIM + 2 * p + 1]);
+      rope_even[pp] = x_even;
+      rope_odd[pp] = x_odd;
+      if (!is_kv) {
+        sum_sq += x_even * x_even + x_odd * x_odd;
+      }
+    }
+
+    // Q: sub-group reduction for RMSNorm.
+    float rrms = 1.0f;
+    if (!is_kv) {
+      auto sg = item.get_sub_group();
+      sum_sq = sycl::reduce_over_group(sg, sum_sq, sycl::plus<float>());
+      rrms = sycl::rsqrt(sum_sq / static_cast<float>(HEAD_DIM) + eps_);
+    }
+
+    const int64_t pos = position_ids_[token_idx];
+    const float* cos_ptr = cos_sin_cache_ + pos * cache_stride_pos_;
+    const float* sin_ptr = cos_ptr + HALF_ROPE;
+
+    if (is_kv) {
+      // KV path: copy NoPE + apply RoPE into paged bf16 cache.
+      int64_t slot_id = slot_mapping_[token_idx];
+      if (slot_id < 0) return;
+      int64_t blk = slot_id / block_size_;
+      int64_t pos_in_blk = slot_id % block_size_;
+      bf16_t* dst = cache_ + blk * cache_stride_block_ + pos_in_blk * HEAD_DIM;
+
+      uint64_t* d8 = reinterpret_cast<uint64_t*>(dst);
+#pragma unroll
+      for (int i = 0; i < NOPE_ITERS; ++i)
+        d8[lane + i * SG_SIZE] = nope_regs[i];
+
+#pragma unroll
+      for (int pp = 0; pp < ROPE_ITERS; ++pp) {
+        const int p = lane + pp * SG_SIZE;
+        float c = cos_ptr[p], s = sin_ptr[p];
+        float new_even = rope_even[pp] * c - rope_odd[pp] * s;
+        float new_odd = rope_even[pp] * s + rope_odd[pp] * c;
+        dst[NOPE_DIM + 2 * p] = static_cast<bf16_t>(new_even);
+        dst[NOPE_DIM + 2 * p + 1] = static_cast<bf16_t>(new_odd);
+      }
+    } else {
+      // Q path: apply RMSNorm + RoPE in-place.
+      bf16_t* dst =
+          q_ + token_idx * q_stride_token_ + slot_idx * q_stride_head_;
+      {
+        uint64_t* d8 = reinterpret_cast<uint64_t*>(dst);
+#pragma unroll
+        for (int i = 0; i < NOPE_ITERS; ++i) {
+          uint64_t val = nope_regs[i];
+          const bf16_t* in_vals = reinterpret_cast<const bf16_t*>(&val);
+          bf16_t out_vals[4];
+#pragma unroll
+          for (int j = 0; j < 4; ++j)
+            out_vals[j] =
+                static_cast<bf16_t>(static_cast<float>(in_vals[j]) * rrms);
+          uint64_t out_packed;
+          __builtin_memcpy(&out_packed, out_vals, sizeof(uint64_t));
+          d8[lane + i * SG_SIZE] = out_packed;
+        }
+      }
+#pragma unroll
+      for (int pp = 0; pp < ROPE_ITERS; ++pp) {
+        const int p = lane + pp * SG_SIZE;
+        float c = cos_ptr[p], s = sin_ptr[p];
+        float x_e = rope_even[pp] * rrms;
+        float x_o = rope_odd[pp] * rrms;
+        float new_even = x_e * c - x_o * s;
+        float new_odd = x_e * s + x_o * c;
+        dst[NOPE_DIM + 2 * p] = static_cast<bf16_t>(new_even);
+        dst[NOPE_DIM + 2 * p + 1] = static_cast<bf16_t>(new_odd);
+      }
+    }
+  }
+
+ private:
+  bf16_t* __restrict__ q_;
+  const bf16_t* __restrict__ kv_;
+  bf16_t* __restrict__ cache_;
+  const int64_t* __restrict__ slot_mapping_;
+  const int64_t* __restrict__ position_ids_;
+  const float* __restrict__ cos_sin_cache_;
+  float eps_;
+  int64_t num_tokens_, num_heads_q_, block_size_;
+  int64_t q_stride_token_, q_stride_head_;
+  int64_t kv_stride_token_;
+  int64_t cache_stride_block_;
+  int64_t cache_stride_pos_;
+};
+
+template <int HEAD_DIM_, int ROPE_DIM_>
+class qnorm_rope_kv_insert_fp8_kernel {
+ public:
+  static constexpr int HEAD_DIM = HEAD_DIM_;
+  static constexpr int ROPE_DIM = ROPE_DIM_;
+  static constexpr int NOPE_DIM = HEAD_DIM - ROPE_DIM;
+  static constexpr int HALF_ROPE = ROPE_DIM / 2;
+  static constexpr int SG_SIZE = 16;
+  static constexpr int QUANT_BLOCK = SG_SIZE * 4;
+  static constexpr int NUM_QUANT_BLOCKS = NOPE_DIM / QUANT_BLOCK;
+  static constexpr int SCALE_BYTES_PER_TOKEN = NUM_QUANT_BLOCKS + 1;
+  static constexpr int TOKEN_DATA_BYTES = NOPE_DIM + ROPE_DIM * 2;
+  static constexpr int NOPE_ITERS = NOPE_DIM / (4 * SG_SIZE);
+  static constexpr int ROPE_ITERS = HALF_ROPE / SG_SIZE;
+  static_assert(
+      NOPE_DIM % (4 * SG_SIZE) == 0, "NOPE_DIM must be divisible by 4*SG_SIZE");
+  static_assert(
+      HALF_ROPE % SG_SIZE == 0, "ROPE_DIM/2 must be divisible by SG_SIZE");
+  static_assert(
+      NOPE_DIM % QUANT_BLOCK == 0, "NOPE_DIM must be divisible by QUANT_BLOCK");
+
+  qnorm_rope_kv_insert_fp8_kernel(
+      bf16_t* __restrict__ q,
+      const bf16_t* __restrict__ kv,
+      uint8_t* __restrict__ cache,
+      const int64_t* __restrict__ slot_mapping,
+      const int64_t* __restrict__ position_ids,
+      const float* __restrict__ cos_sin_cache,
+      float eps,
+      int64_t num_tokens,
+      int64_t num_heads_q,
+      int64_t block_size,
+      int64_t q_stride_token,
+      int64_t q_stride_head,
+      int64_t kv_stride_token,
+      int64_t cache_block_stride,
+      int64_t cache_stride_pos)
+      : q_(q),
+        kv_(kv),
+        cache_(cache),
+        slot_mapping_(slot_mapping),
+        position_ids_(position_ids),
+        cos_sin_cache_(cos_sin_cache),
+        eps_(eps),
+        num_tokens_(num_tokens),
+        num_heads_q_(num_heads_q),
+        block_size_(block_size),
+        q_stride_token_(q_stride_token),
+        q_stride_head_(q_stride_head),
+        kv_stride_token_(kv_stride_token),
+        cache_block_stride_(cache_block_stride),
+        cache_stride_pos_(cache_stride_pos) {}
+
+  [[sycl::reqd_sub_group_size(SG_SIZE)]]
+  void operator()(sycl::nd_item<3> item) const {
+    const int64_t token_idx = item.get_global_id(0);
+    const int64_t slot_idx = item.get_global_id(1);
+    const int64_t lane = item.get_local_id(2);
+
+    if (token_idx >= num_tokens_) return;
+    const bool is_kv = (slot_idx == num_heads_q_);
+
+    const bf16_t* src;
+    if (is_kv) {
+      src = kv_ + token_idx * kv_stride_token_;
+    } else {
+      src = q_ + token_idx * q_stride_token_ + slot_idx * q_stride_head_;
+    }
+
+    // Load NoPE dims [0, NOPE_DIM), keep float copy for fp8 quantization.
+    float sum_sq = 0.0f;
+    float nope_floats[NOPE_ITERS * 4];
+    uint64_t nope_regs[NOPE_ITERS];
+    {
+      const uint64_t* s8 = reinterpret_cast<const uint64_t*>(src);
+#pragma unroll
+      for (int i = 0; i < NOPE_ITERS; ++i) {
+        uint64_t val = s8[lane + i * SG_SIZE];
+        nope_regs[i] = val;
+        const bf16_t* vals = reinterpret_cast<const bf16_t*>(&val);
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          float fv = static_cast<float>(vals[j]);
+          nope_floats[i * 4 + j] = fv;
+          if (!is_kv) {
+            sum_sq += fv * fv;
+          }
+        }
+      }
+    }
+
+    // Load interleaved RoPE pairs [NOPE_DIM, HEAD_DIM).
+    float rope_even[ROPE_ITERS], rope_odd[ROPE_ITERS];
+#pragma unroll
+    for (int pp = 0; pp < ROPE_ITERS; ++pp) {
+      const int p = lane + pp * SG_SIZE;
+      float x_even = static_cast<float>(src[NOPE_DIM + 2 * p]);
+      float x_odd = static_cast<float>(src[NOPE_DIM + 2 * p + 1]);
+      rope_even[pp] = x_even;
+      rope_odd[pp] = x_odd;
+      if (!is_kv) {
+        sum_sq += x_even * x_even + x_odd * x_odd;
+      }
+    }
+
+    auto sg = item.get_sub_group();
+
+    if (is_kv) {
+      // KV path: fp8 block-quantize NoPE + RoPE into paged cache.
+      int64_t slot_id = slot_mapping_[token_idx];
+      if (slot_id < 0) return;
+      int64_t blk = slot_id / block_size_;
+      int64_t pos_in_blk = slot_id % block_size_;
+
+      uint8_t* block_base = cache_ + blk * cache_block_stride_;
+      uint8_t* token_data_ptr = block_base + pos_in_blk * TOKEN_DATA_BYTES;
+      uint8_t* token_scale_ptr =
+          block_base + static_cast<int64_t>(block_size_) * TOKEN_DATA_BYTES +
+          pos_in_blk * SCALE_BYTES_PER_TOKEN;
+
+// Round to bf16 precision before quantization (matches CUDA path).
+#pragma unroll
+      for (int i = 0; i < NOPE_ITERS * 4; ++i) {
+        nope_floats[i] =
+            static_cast<float>(static_cast<bf16_t>(nope_floats[i]));
+      }
+
+// Per-block absmax quantization: scale = ceil_pow2(absmax / FP8_MAX).
+#pragma unroll
+      for (int i = 0; i < NOPE_ITERS; ++i) {
+        float local_max = 0.0f;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          local_max = sycl::fmax(local_max, sycl::fabs(nope_floats[i * 4 + j]));
+        }
+
+        float block_absmax =
+            sycl::reduce_over_group(sg, local_max, sycl::maximum<float>());
+        block_absmax = sycl::fmax(block_absmax, 1e-4f);
+
+        float scale_raw = block_absmax * (1.0f / FP8_MAX);
+        uint32_t scale_exp;
+        fast_ceil_pow2(scale_raw, scale_exp);
+
+        uint32_t packed = 0;
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          packed |=
+              (static_cast<uint32_t>(
+                   fused_scale_to_fp8(nope_floats[i * 4 + j], scale_exp))
+               << (j * 8));
+        }
+
+        int byte_offset = i * QUANT_BLOCK + lane * 4;
+        *reinterpret_cast<uint32_t*>(token_data_ptr + byte_offset) = packed;
+
+        if (lane == 0) {
+          token_scale_ptr[i] = static_cast<uint8_t>(scale_exp);
+        }
+      }
+
+      if (lane == 0) {
+        token_scale_ptr[NUM_QUANT_BLOCKS] = 0;  // padding byte
+      }
+
+      // Apply forward RoPE and store tail as bf16.
+      const int64_t pos = position_ids_[token_idx];
+      const float* cos_ptr = cos_sin_cache_ + pos * cache_stride_pos_;
+      const float* sin_ptr = cos_ptr + HALF_ROPE;
+      bf16_t* rope_dst = reinterpret_cast<bf16_t*>(token_data_ptr + NOPE_DIM);
+
+#pragma unroll
+      for (int pp = 0; pp < ROPE_ITERS; ++pp) {
+        const int p = lane + pp * SG_SIZE;
+        float c = cos_ptr[p], s = sin_ptr[p];
+        float new_even = rope_even[pp] * c - rope_odd[pp] * s;
+        float new_odd = rope_even[pp] * s + rope_odd[pp] * c;
+        rope_dst[2 * p] = static_cast<bf16_t>(new_even);
+        rope_dst[2 * p + 1] = static_cast<bf16_t>(new_odd);
+      }
+    } else {
+      // Q path: sub-group reduction for RMSNorm, then apply in-place.
+      sum_sq = sycl::reduce_over_group(sg, sum_sq, sycl::plus<float>());
+      float rrms = sycl::rsqrt(sum_sq / static_cast<float>(HEAD_DIM) + eps_);
+
+      bf16_t* dst =
+          q_ + token_idx * q_stride_token_ + slot_idx * q_stride_head_;
+      {
+        uint64_t* d8 = reinterpret_cast<uint64_t*>(dst);
+#pragma unroll
+        for (int i = 0; i < NOPE_ITERS; ++i) {
+          uint64_t val = nope_regs[i];
+          const bf16_t* in_vals = reinterpret_cast<const bf16_t*>(&val);
+          bf16_t out_vals[4];
+#pragma unroll
+          for (int j = 0; j < 4; ++j)
+            out_vals[j] =
+                static_cast<bf16_t>(static_cast<float>(in_vals[j]) * rrms);
+          uint64_t out_packed;
+          __builtin_memcpy(&out_packed, out_vals, sizeof(uint64_t));
+          d8[lane + i * SG_SIZE] = out_packed;
+        }
+      }
+      const int64_t pos = position_ids_[token_idx];
+      const float* cos_ptr = cos_sin_cache_ + pos * cache_stride_pos_;
+      const float* sin_ptr = cos_ptr + HALF_ROPE;
+#pragma unroll
+      for (int pp = 0; pp < ROPE_ITERS; ++pp) {
+        const int p = lane + pp * SG_SIZE;
+        float c = cos_ptr[p], s = sin_ptr[p];
+        float x_e = rope_even[pp] * rrms;
+        float x_o = rope_odd[pp] * rrms;
+        float new_even = x_e * c - x_o * s;
+        float new_odd = x_e * s + x_o * c;
+        dst[NOPE_DIM + 2 * p] = static_cast<bf16_t>(new_even);
+        dst[NOPE_DIM + 2 * p + 1] = static_cast<bf16_t>(new_odd);
+      }
+    }
+  }
+
+ private:
+  bf16_t* __restrict__ q_;
+  const bf16_t* __restrict__ kv_;
+  uint8_t* __restrict__ cache_;
+  const int64_t* __restrict__ slot_mapping_;
+  const int64_t* __restrict__ position_ids_;
+  const float* __restrict__ cos_sin_cache_;
+  float eps_;
+  int64_t num_tokens_, num_heads_q_, block_size_;
+  int64_t q_stride_token_, q_stride_head_;
+  int64_t kv_stride_token_;
+  int64_t cache_block_stride_;
+  int64_t cache_stride_pos_;
+};
+
+}  // namespace vllm
+
+using vllm::bf16_t;
+
+void deepseek_qnorm_rope_kv_insert(
+    torch::Tensor& q,
+    const torch::Tensor& kv,
+    torch::Tensor& cache,
+    const torch::Tensor& slot_mapping,
+    const torch::Tensor& position_ids,
+    const torch::Tensor& cos_sin_cache,
+    double eps,
+    int64_t block_size,
+    const std::string& kv_cache_dtype) {
+  const int64_t num_tokens = q.size(0);
+  const int64_t num_heads_q = q.size(1);
+  const int64_t head_dim = q.size(2);
+  const int64_t rope_dim = cos_sin_cache.size(1);
+
+  TORCH_CHECK(
+      kv.size(1) == head_dim,
+      "kv head_dim must match q head_dim (",
+      head_dim,
+      "), got ",
+      kv.size(1));
+  TORCH_CHECK(
+      head_dim == 512 && rope_dim == 64,
+      "deepseek_qnorm_rope_kv_insert: unsupported head_dim=",
+      head_dim,
+      " rope_dim=",
+      rope_dim,
+      ". Supported: head_dim=512, rope_dim=64");
+
+  const int64_t q_stride_token = q.stride(0);
+  const int64_t q_stride_head = q.stride(1);
+  const int64_t kv_stride_token = kv.stride(0);
+  const int64_t cache_stride_pos = cos_sin_cache.stride(0);
+
+  constexpr int SG_SIZE = 16;
+  sycl::range<3> global(num_tokens, num_heads_q + 1, SG_SIZE);
+  sycl::range<3> local(1, 1, SG_SIZE);
+
+  at::DeviceGuard device_guard(q.device());
+  auto& q_xpu = vllm::xpu::vllmGetQueue();
+
+  TORCH_CHECK(
+      kv_cache_dtype == "bf16" || kv_cache_dtype == "fp8_ds_mla",
+      "deepseek_qnorm_rope_kv_insert: unsupported kv_cache_dtype '",
+      kv_cache_dtype,
+      "', expected 'bf16' or 'fp8_ds_mla'");
+
+  auto* q_ptr = reinterpret_cast<bf16_t*>(q.data_ptr());
+  auto* kv_ptr = reinterpret_cast<const bf16_t*>(kv.data_ptr());
+  auto* slot_ptr = slot_mapping.data_ptr<int64_t>();
+  auto* pos_ptr = position_ids.data_ptr<int64_t>();
+  auto* cs_ptr = cos_sin_cache.data_ptr<float>();
+  const int64_t cache_block_stride = cache.stride(0);
+
+  if (kv_cache_dtype == "bf16") {
+    auto* cache_ptr = reinterpret_cast<bf16_t*>(cache.data_ptr());
+    q_xpu.submit([&](sycl::handler& cgh) {
+      cgh.parallel_for(
+          sycl::nd_range<3>(global, local),
+          vllm::qnorm_rope_kv_insert_bf16_kernel<512, 64>(
+              q_ptr,
+              kv_ptr,
+              cache_ptr,
+              slot_ptr,
+              pos_ptr,
+              cs_ptr,
+              static_cast<float>(eps),
+              num_tokens,
+              num_heads_q,
+              block_size,
+              q_stride_token,
+              q_stride_head,
+              kv_stride_token,
+              cache_block_stride,
+              cache_stride_pos));
+    });
+  } else {
+    auto* cache_ptr = reinterpret_cast<uint8_t*>(cache.data_ptr());
+    q_xpu.submit([&](sycl::handler& cgh) {
+      cgh.parallel_for(
+          sycl::nd_range<3>(global, local),
+          vllm::qnorm_rope_kv_insert_fp8_kernel<512, 64>(
+              q_ptr,
+              kv_ptr,
+              cache_ptr,
+              slot_ptr,
+              pos_ptr,
+              cs_ptr,
+              static_cast<float>(eps),
+              num_tokens,
+              num_heads_q,
+              block_size,
+              q_stride_token,
+              q_stride_head,
+              kv_stride_token,
+              cache_block_stride,
+              cache_stride_pos));
+    });
+  }
+}
+
+namespace vllm {
+
+class deepseek_dual_rmsnorm_m1_kernel {
+ public:
+  deepseek_dual_rmsnorm_m1_kernel(
+      bf16_t* q_out,
+      bf16_t* kv_out,
+      const bf16_t* q,
+      const bf16_t* kv,
+      const bf16_t* q_weight,
+      const bf16_t* kv_weight,
+      float eps)
+      : q_out_(q_out),
+        kv_out_(kv_out),
+        q_(q),
+        kv_(kv),
+        q_weight_(q_weight),
+        kv_weight_(kv_weight),
+        eps_(eps) {}
+
+  void operator() [[sycl::reqd_sub_group_size(32)]] (
+      sycl::nd_item<2> item) const {
+    const int task = item.get_group(0);
+    const int thread = item.get_local_id(1);
+    const int size = task == 0 ? 1024 : 512;
+    const bf16_t* input = task == 0 ? q_ : kv_;
+    const bf16_t* weight = task == 0 ? q_weight_ : kv_weight_;
+    bf16_t* output = task == 0 ? q_out_ : kv_out_;
+
+    // Match the current Triton BLOCK_SIZE=1024/num_warps=4 reduction
+    // topology: 128 work-items, eight adjacent BF16 values per work-item,
+    // SG32 reduction, then a four-subgroup work-group reduction. Preserving
+    // that order is required for bitwise-identical BF16 output.
+    const int base = thread * 8;
+    float values[8];
+#pragma unroll
+    for (int offset = 0; offset < 8; ++offset) {
+      const int index = base + offset;
+      values[offset] =
+          index < size ? static_cast<float>(input[index]) : 0.0f;
+    }
+    float sum_sq = values[0] * values[0] + values[1] * values[1];
+#pragma unroll
+    for (int offset = 2; offset < 8; ++offset) {
+      sum_sq += values[offset] * values[offset];
+    }
+    sum_sq = sycl::reduce_over_group(
+        sycl::ext::oneapi::this_work_item::get_work_group<2>(),
+        sum_sq,
+        sycl::plus<float>());
+    const float rrms = sycl::rsqrt(sum_sq / static_cast<float>(size) + eps_);
+
+#pragma unroll
+    for (int offset = 0; offset < 8; ++offset) {
+      const int index = base + offset;
+      if (index < size) {
+        const float scale = static_cast<float>(weight[index]);
+        output[index] = static_cast<bf16_t>(values[offset] * rrms * scale);
+      }
+    }
+  }
+
+ private:
+  bf16_t* q_out_;
+  bf16_t* kv_out_;
+  const bf16_t* q_;
+  const bf16_t* kv_;
+  const bf16_t* q_weight_;
+  const bf16_t* kv_weight_;
+  float eps_;
+};
+
+}  // namespace vllm
+
+void deepseek_dual_rmsnorm_out(
+    torch::Tensor& q_out,
+    torch::Tensor& kv_out,
+    const torch::Tensor& q,
+    const torch::Tensor& kv,
+    const torch::Tensor& q_weight,
+    const torch::Tensor& kv_weight,
+    double eps) {
+  TORCH_CHECK(
+      q.scalar_type() == torch::kBFloat16 &&
+          kv.scalar_type() == torch::kBFloat16 &&
+          q_out.scalar_type() == torch::kBFloat16 &&
+          kv_out.scalar_type() == torch::kBFloat16,
+      "deepseek_dual_rmsnorm_out requires BF16 tensors");
+  TORCH_CHECK(
+      q.is_contiguous() && kv.is_contiguous() && q_out.is_contiguous() &&
+          kv_out.is_contiguous() && q_weight.is_contiguous() &&
+          kv_weight.is_contiguous(),
+      "deepseek_dual_rmsnorm_out requires contiguous tensors");
+  TORCH_CHECK(
+      q.numel() == 1024 && kv.numel() == 512 &&
+          q_weight.numel() == 1024 && kv_weight.numel() == 512 &&
+          q_out.numel() == 1024 && kv_out.numel() == 512,
+      "deepseek_dual_rmsnorm_out supports only M=1 Q1024/KV512");
+
+  const at::DeviceGuard device_guard(q.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  auto* q_out_ptr = reinterpret_cast<vllm::bf16_t*>(q_out.data_ptr());
+  auto* kv_out_ptr = reinterpret_cast<vllm::bf16_t*>(kv_out.data_ptr());
+  auto* q_ptr = reinterpret_cast<const vllm::bf16_t*>(q.data_ptr());
+  auto* kv_ptr = reinterpret_cast<const vllm::bf16_t*>(kv.data_ptr());
+  auto* q_weight_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(q_weight.data_ptr());
+  auto* kv_weight_ptr =
+      reinterpret_cast<const vllm::bf16_t*>(kv_weight.data_ptr());
+
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        sycl::nd_range<2>(sycl::range<2>(2, 128), sycl::range<2>(1, 128)),
+        vllm::deepseek_dual_rmsnorm_m1_kernel(
+            q_out_ptr,
+            kv_out_ptr,
+            q_ptr,
+            kv_ptr,
+            q_weight_ptr,
+            kv_weight_ptr,
+            static_cast<float>(eps)));
+  });
+}
