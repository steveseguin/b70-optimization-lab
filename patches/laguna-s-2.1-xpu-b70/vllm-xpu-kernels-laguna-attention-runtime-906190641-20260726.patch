+# SPDX-License-Identifier: Apache-2.0
+"""CPU-only source-contract checks for Laguna routed-W1 N32."""
+
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+INTERFACE = (
+    ROOT
+    / "csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp"
+).read_text()
+
+FUNCTION_START = INTERFACE.index("at::Tensor laguna_m8_fused_expert_xe2_impl(")
+FUNCTION_END = INTERFACE.index(
+    "at::Tensor cutlass_grouped_gemm_m2_compact_xe2_impl(", FUNCTION_START
+)
+FUNCTION = INTERFACE[FUNCTION_START:FUNCTION_END]
+
+
+def test_laguna_n32_native_contract_is_exact_m8_w1_only():
+    for contract in (
+        "w1_n_tile == 32 || w1_n_tile == 64 || w1_n_tile == 128",
+        "w1_n_tile == 64 || (w1_only && route_interleave && num_rows == 8)",
+        "w1_n_tile == 64 || expert_map.has_value()",
+        "expert_map->scalar_type() == at::kInt && expert_map->numel() == 256",
+        '"Laguna fused expert map must be contiguous int32 [256]"',
+    ):
+        assert contract in FUNCTION
+
+
+def test_laguna_n32_dispatch_changes_only_w1_policy():
+    n32_branch = FUNCTION.index("if (w1_n_tile == 32)")
+    n32_launch = FUNCTION.index(
+        "launch_w1(w4a16_policy_m_8_n_32{});", n32_branch
+    )
+    n128_branch = FUNCTION.index("else if (w1_n_tile == 128)", n32_launch)
+    n64_launch = FUNCTION.index("launch_w1(w4a16_policy_m_8{});", n128_branch)
+    w1_return = FUNCTION.index("if (w1_only) return;", n64_launch)
+    w2_launch = FUNCTION.index(
+        "M8TopkInt4W2ReduceLauncher<w4a16_policy_m_8, id_type>",
+        w1_return,
+    )
+
+    assert n32_branch < n32_launch < n128_branch < n64_launch
+    assert n64_launch < w1_return < w2_launch
+    assert "M8TopkInt4W2ReduceLauncher<w4a16_policy_m_8_n_32" not in FUNCTION
+
+
+def test_laguna_n32_policy_keeps_the_k32_chain():
+    policies = (
+        ROOT / "csrc/xpu/grouped_gemm/xe_2/gemm_xe2_policy.hpp"
+    ).read_text()
+    policy_start = policies.index("class w4a16_policy_m_8_n_32")
+    policy_end = policies.index(
+        "class w4a16_policy_m_8_n_128", policy_start
+    )
+    n32_policy = policies[policy_start:policy_end]
+
+    assert "using WGTile = Shape<_8, _32, _32>;" in n32_policy
+    assert "Layout<Shape<_1, _2, _1>" in n32_policy
