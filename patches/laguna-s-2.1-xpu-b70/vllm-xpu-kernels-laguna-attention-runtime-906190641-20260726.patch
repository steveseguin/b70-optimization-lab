+def _finite_bf16_values() -> torch.Tensor:
+    bits = torch.arange(1 << 16, dtype=torch.int32)
+    finite = bits[(bits & 0x7F80) != 0x7F80]
+    return finite.to(torch.int16).view(torch.bfloat16)
