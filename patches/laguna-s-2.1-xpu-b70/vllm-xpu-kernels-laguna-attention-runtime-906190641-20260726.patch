+// Experimental graph-safe TP4 BF16 all-reduce micro-gate for DeepSeek V4.
+// IPC setup happens once before graph capture; the captured op only submits
+// one fixed-shape kernel on the current PyTorch XPU queue.
+
+#include <ATen/ATen.h>
+#include <ATen/xpu/XPUContext.h>
+#include <c10/xpu/XPUStream.h>
+#include <c10/xpu/XPUFunctions.h>
+#include <torch/all.h>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <limits>
+#include <mutex>
+#include <pthread.h>
+#include <string>
+#include <sys/file.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <vector>
+
+#include <level_zero/ze_api.h>
+#include <sycl/ext/oneapi/backend/level_zero.hpp>
+#include <sycl/ext/oneapi/bfloat16.hpp>
+#include <sycl/ext/intel/esimd.hpp>
+#include <sycl/ext/intel/experimental/esimd/memory.hpp>
+#include <sycl/sycl.hpp>
+
+#include "utils.h"
+
+namespace {
+
+using bf16 = sycl::ext::oneapi::bfloat16;
+namespace esimd = sycl::ext::intel::esimd;
+namespace esimd_exp = sycl::ext::intel::experimental::esimd;
+
+constexpr int kWorld = 4;
+constexpr int kHidden = 4096;
+constexpr int kSlots = 3;
+constexpr int kChannels = 128;
+constexpr size_t kPayloadElems =
+    static_cast<size_t>(kChannels) * kSlots * kHidden;
+constexpr size_t kPayloadBytes = kPayloadElems * sizeof(bf16);
+constexpr size_t kSyncBytes =
+    static_cast<size_t>(kChannels) * kSlots * kWorld * sizeof(uint32_t);
+constexpr size_t kWorkspaceBytes = kPayloadBytes + kSyncBytes;
+
+std::mutex g_registry_mutex;
+std::array<void*, kWorld> g_peer_bases{};
+std::array<void*, kWorld> g_opened_bases{};
+std::array<ze_ipc_mem_handle_t, kWorld> g_exported_handles{};
+std::array<bool, kWorld> g_has_exported_handle{};
+
+std::mutex g_ipc_event_mutex;
+ze_event_pool_handle_t g_local_ipc_event_pool = nullptr;
+ze_event_pool_handle_t g_completion_event_pool = nullptr;
+ze_ipc_event_pool_handle_t g_exported_ipc_event_handle{};
+bool g_has_exported_ipc_event_handle = false;
+std::array<ze_event_pool_handle_t, kWorld> g_peer_ipc_event_pools{};
+std::vector<ze_event_handle_t> g_local_ipc_events;
+std::vector<ze_event_handle_t> g_completion_events;
+std::array<std::vector<ze_event_handle_t>, kWorld> g_peer_ipc_events;
+ze_command_list_handle_t g_ipc_event_command_list = nullptr;
+int64_t g_ipc_event_count = 0;
+
+constexpr uint64_t kHostPairMagic = 0x4257504149523031ULL;
+struct alignas(64) TP4HostPairState {
+  std::atomic<uint64_t> magic;
+  pthread_barrier_t barrier;
+  alignas(64) float pairs[kSlots][kWorld][2];
+};
+
+std::mutex g_host_pair_mutex;
+TP4HostPairState* g_host_pair_state = nullptr;
+int g_host_pair_fd = -1;
+int g_host_pair_rank = -1;
+std::string g_host_pair_name;
+
+void check_ze(ze_result_t result, const char* what) {
+  TORCH_CHECK(
+      result == ZE_RESULT_SUCCESS,
+      what,
+      " failed with Level Zero result ",
+      static_cast<int>(result));
+}
+
+ze_context_handle_t native_context(sycl::queue& q) {
+  return sycl::get_native<sycl::backend::ext_oneapi_level_zero>(q.get_context());
+}
+
+ze_device_handle_t native_device(sycl::queue& q) {
+  return sycl::get_native<sycl::backend::ext_oneapi_level_zero>(q.get_device());
+}
+
+class TP4PublishReadyKernel;
+class TP4ReduceKernel;
+class TP4PairPublishReadyKernel;
+class TP4PairSelectKernel;
+class TP4PairReadKernel;
+class TP4PairEventSelectKernel;
+
+}  // namespace
+
+at::Tensor tp4_ipc_allocate_workspace(const at::Tensor& device_anchor) {
+  TORCH_CHECK(
+      device_anchor.is_xpu(),
+      "tp4_ipc_allocate_workspace: device_anchor must be XPU");
+  auto& q = vllm::xpu::vllmGetQueue(device_anchor.device().index());
+  void* ptr = sycl::malloc_device(kWorkspaceBytes, q);
+  TORCH_CHECK(ptr != nullptr, "tp4_ipc_allocate_workspace: allocation failed");
+  q.memset(ptr, 0, kWorkspaceBytes).wait();
+  const auto context = q.get_context();
+  auto options = at::TensorOptions()
+                     .dtype(at::kByte)
+                     .device(at::Device(at::kXPU, device_anchor.device().index()));
+  return at::from_blob(
+      ptr,
+      {static_cast<int64_t>(kWorkspaceBytes)},
+      [context](void* allocation) { sycl::free(allocation, context); },
+      options);
+}
+
+std::tuple<int64_t, int64_t, std::vector<int64_t>> tp4_ipc_export_fd(
+    const at::Tensor& workspace) {
+  TORCH_CHECK(workspace.is_xpu(), "tp4_ipc_export_fd: workspace must be XPU");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous(),
+      "tp4_ipc_export_fd: workspace must be contiguous uint8");
+  TORCH_CHECK(
+      static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "tp4_ipc_export_fd: workspace requires at least ",
+      kWorkspaceBytes,
+      " bytes");
+
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto context = native_context(q);
+  void* allocation_base = nullptr;
+  size_t allocation_size = 0;
+  check_ze(
+      zeMemGetAddressRange(
+          context, workspace.data_ptr(), &allocation_base, &allocation_size),
+      "zeMemGetAddressRange");
+  const auto offset = static_cast<int64_t>(
+      static_cast<uint8_t*>(workspace.data_ptr()) -
+      static_cast<uint8_t*>(allocation_base));
+  TORCH_CHECK(
+      offset >= 0 && static_cast<size_t>(offset) + kWorkspaceBytes <= allocation_size,
+      "tp4_ipc_export_fd: workspace is outside exported allocation");
+
+  ze_ipc_mem_handle_t handle{};
+  check_ze(zeMemGetIpcHandle(context, allocation_base, &handle), "zeMemGetIpcHandle");
+  // oneCCL's working pidfd exchange duplicates the descriptor embedded in the
+  // Level Zero IPC handle. The experimental descriptor-conversion API can
+  // return a descriptor that opens for ordinary access but does not preserve
+  // the peer-atomic behavior required by the collective.
+  const int fd = *reinterpret_cast<const int*>(handle.data);
+  TORCH_CHECK(fd >= 0, "tp4_ipc_export_fd: invalid embedded descriptor");
+  static_assert(
+      sizeof(ze_ipc_mem_handle_t) % sizeof(int64_t) == 0,
+      "Level Zero IPC handle must be representable as int64 words");
+  std::vector<int64_t> handle_words(
+      sizeof(ze_ipc_mem_handle_t) / sizeof(int64_t));
+  std::memcpy(handle_words.data(), &handle, sizeof(handle));
+
+  {
+    std::lock_guard<std::mutex> lock(g_registry_mutex);
+    bool retained = false;
+    for (int i = 0; i < kWorld; ++i) {
+      if (!g_has_exported_handle[i]) {
+        g_exported_handles[i] = handle;
+        g_has_exported_handle[i] = true;
+        retained = true;
+        break;
+      }
+    }
+    TORCH_CHECK(retained, "tp4_ipc_export_fd: export registry exhausted");
+  }
+  return {static_cast<int64_t>(fd), offset, std::move(handle_words)};
+}
+
+void tp4_ipc_register_fd(
+    const at::Tensor& workspace,
+    int64_t peer_rank,
+    int64_t fd,
+    int64_t allocation_offset,
+    const std::vector<int64_t>& handle_words) {
+  TORCH_CHECK(workspace.is_xpu(), "tp4_ipc_register_fd: workspace must be XPU");
+  TORCH_CHECK(peer_rank >= 0 && peer_rank < kWorld, "invalid TP4 peer rank");
+  TORCH_CHECK(fd >= 0, "invalid IPC file descriptor");
+  TORCH_CHECK(allocation_offset >= 0, "invalid IPC allocation offset");
+  TORCH_CHECK(
+      handle_words.size() * sizeof(int64_t) == sizeof(ze_ipc_mem_handle_t),
+      "invalid Level Zero IPC handle word count");
+
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto context = native_context(q);
+  auto device = native_device(q);
+  ze_ipc_mem_handle_t handle{};
+  // This mirrors oneCCL's pidfd route: rebuild a zero handle around the
+  // descriptor duplicated into the receiving process. The remaining opaque
+  // bytes are exporter-process state and must not be copied across processes.
+  *reinterpret_cast<int*>(handle.data) = static_cast<int>(fd);
+  void* allocation_base = nullptr;
+  check_ze(
+      zeMemOpenIpcHandle(
+          context,
+          device,
+          handle,
+          static_cast<ze_ipc_memory_flags_t>(0),
+          &allocation_base),
+      "zeMemOpenIpcHandle");
+
+  std::lock_guard<std::mutex> lock(g_registry_mutex);
+  TORCH_CHECK(
+      g_opened_bases[peer_rank] == nullptr,
+      "tp4_ipc_register_fd: peer rank already registered");
+  g_opened_bases[peer_rank] = allocation_base;
+  g_peer_bases[peer_rank] =
+      static_cast<uint8_t*>(allocation_base) + allocation_offset;
+}
+
+void tp4_ipc_clear() {
+  auto& q = vllm::xpu::vllmGetQueue();
+  q.wait();
+  auto context = native_context(q);
+  std::lock_guard<std::mutex> lock(g_registry_mutex);
+  for (int i = 0; i < kWorld; ++i) {
+    if (g_opened_bases[i] != nullptr) {
+      check_ze(
+          zeMemCloseIpcHandle(context, g_opened_bases[i]),
+          "zeMemCloseIpcHandle");
+    }
+    g_opened_bases[i] = nullptr;
+    g_peer_bases[i] = nullptr;
+    if (g_has_exported_handle[i]) {
+      check_ze(
+          zeMemPutIpcHandle(context, g_exported_handles[i]),
+          "zeMemPutIpcHandle");
+      g_has_exported_handle[i] = false;
+    }
+  }
+}
+
+std::tuple<int64_t, std::vector<int64_t>> tp4_ipc_event_pool_create(
+    const at::Tensor& device_anchor,
+    int64_t event_count) {
+  TORCH_CHECK(device_anchor.is_xpu(), "device_anchor must be XPU");
+  TORCH_CHECK(event_count > 0 && event_count <= 65536, "invalid event count");
+  auto& q = vllm::xpu::vllmGetQueue(device_anchor.device().index());
+  auto context = native_context(q);
+  auto device = native_device(q);
+
+  std::lock_guard<std::mutex> lock(g_ipc_event_mutex);
+  TORCH_CHECK(
+      g_local_ipc_event_pool == nullptr,
+      "TP4 IPC event pool is already initialized");
+
+  ze_event_pool_desc_t ipc_desc{};
+  ipc_desc.stype = ZE_STRUCTURE_TYPE_EVENT_POOL_DESC;
+  ipc_desc.flags = ZE_EVENT_POOL_FLAG_IPC | ZE_EVENT_POOL_FLAG_HOST_VISIBLE;
+  ipc_desc.count = static_cast<uint32_t>(event_count);
+  check_ze(
+      zeEventPoolCreate(
+          context, &ipc_desc, 0, nullptr, &g_local_ipc_event_pool),
+      "zeEventPoolCreate IPC");
+
+  ze_event_pool_desc_t completion_desc{};
+  completion_desc.stype = ZE_STRUCTURE_TYPE_EVENT_POOL_DESC;
+  completion_desc.flags = ZE_EVENT_POOL_FLAG_HOST_VISIBLE;
+  completion_desc.count = static_cast<uint32_t>(event_count);
+  check_ze(
+      zeEventPoolCreate(
+          context,
+          &completion_desc,
+          1,
+          &device,
+          &g_completion_event_pool),
+      "zeEventPoolCreate completion");
+
+  g_local_ipc_events.reserve(event_count);
+  g_completion_events.reserve(event_count);
+  for (int64_t index = 0; index < event_count; ++index) {
+    ze_event_desc_t desc{};
+    desc.stype = ZE_STRUCTURE_TYPE_EVENT_DESC;
+    desc.index = static_cast<uint32_t>(index);
+    desc.signal = ZE_EVENT_SCOPE_FLAG_DEVICE;
+    desc.wait = ZE_EVENT_SCOPE_FLAG_DEVICE;
+    ze_event_handle_t ready = nullptr;
+    ze_event_handle_t completion = nullptr;
+    check_ze(
+        zeEventCreate(g_local_ipc_event_pool, &desc, &ready),
+        "zeEventCreate IPC");
+    check_ze(
+        zeEventCreate(g_completion_event_pool, &desc, &completion),
+        "zeEventCreate completion");
+    g_local_ipc_events.push_back(ready);
+    g_completion_events.push_back(completion);
+  }
+
+  uint32_t group_count = 0;
+  check_ze(
+      zeDeviceGetCommandQueueGroupProperties(device, &group_count, nullptr),
+      "zeDeviceGetCommandQueueGroupProperties count");
+  std::vector<ze_command_queue_group_properties_t> groups(group_count);
+  for (auto& group : groups) {
+    group.stype = ZE_STRUCTURE_TYPE_COMMAND_QUEUE_GROUP_PROPERTIES;
+  }
+  check_ze(
+      zeDeviceGetCommandQueueGroupProperties(
+          device, &group_count, groups.data()),
+      "zeDeviceGetCommandQueueGroupProperties");
+  uint32_t compute_ordinal = UINT32_MAX;
+  for (uint32_t index = 0; index < group_count; ++index) {
+    if ((groups[index].flags &
+         ZE_COMMAND_QUEUE_GROUP_PROPERTY_FLAG_COMPUTE) != 0) {
+      compute_ordinal = index;
+      break;
+    }
+  }
+  TORCH_CHECK(compute_ordinal != UINT32_MAX, "no Level Zero compute queue");
+  ze_command_queue_desc_t queue_desc{};
+  queue_desc.stype = ZE_STRUCTURE_TYPE_COMMAND_QUEUE_DESC;
+  queue_desc.ordinal = compute_ordinal;
+  queue_desc.index = 0;
+  queue_desc.mode = ZE_COMMAND_QUEUE_MODE_ASYNCHRONOUS;
+  queue_desc.priority = ZE_COMMAND_QUEUE_PRIORITY_NORMAL;
+  check_ze(
+      zeCommandListCreateImmediate(
+          context, device, &queue_desc, &g_ipc_event_command_list),
+      "zeCommandListCreateImmediate");
+
+  check_ze(
+      zeEventPoolGetIpcHandle(
+          g_local_ipc_event_pool, &g_exported_ipc_event_handle),
+      "zeEventPoolGetIpcHandle");
+  const int fd =
+      *reinterpret_cast<const int*>(g_exported_ipc_event_handle.data);
+  TORCH_CHECK(fd >= 0, "invalid IPC event-pool descriptor");
+  static_assert(
+      sizeof(ze_ipc_event_pool_handle_t) % sizeof(int64_t) == 0,
+      "IPC event handle must be representable as int64 words");
+  std::vector<int64_t> words(
+      sizeof(ze_ipc_event_pool_handle_t) / sizeof(int64_t));
+  std::memcpy(
+      words.data(),
+      &g_exported_ipc_event_handle,
+      sizeof(g_exported_ipc_event_handle));
+  g_has_exported_ipc_event_handle = true;
+  g_ipc_event_count = event_count;
+  return {static_cast<int64_t>(fd), std::move(words)};
+}
+
+void tp4_ipc_event_pool_register(
+    const at::Tensor& device_anchor,
+    int64_t peer_rank,
+    int64_t fd,
+    const std::vector<int64_t>& handle_words) {
+  TORCH_CHECK(device_anchor.is_xpu(), "device_anchor must be XPU");
+  TORCH_CHECK(peer_rank >= 0 && peer_rank < kWorld, "invalid peer rank");
+  TORCH_CHECK(fd >= 0, "invalid IPC event-pool descriptor");
+  TORCH_CHECK(
+      handle_words.size() * sizeof(int64_t) ==
+          sizeof(ze_ipc_event_pool_handle_t),
+      "invalid IPC event handle word count");
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto context = native_context(q);
+
+  std::lock_guard<std::mutex> lock(g_ipc_event_mutex);
+  TORCH_CHECK(g_local_ipc_event_pool != nullptr, "local event pool missing");
+  TORCH_CHECK(
+      g_peer_ipc_event_pools[peer_rank] == nullptr,
+      "peer IPC event pool already registered");
+  ze_ipc_event_pool_handle_t handle{};
+  std::memcpy(&handle, handle_words.data(), sizeof(handle));
+  *reinterpret_cast<int*>(handle.data) = static_cast<int>(fd);
+  ze_event_pool_handle_t pool = nullptr;
+  check_ze(
+      zeEventPoolOpenIpcHandle(context, handle, &pool),
+      "zeEventPoolOpenIpcHandle");
+  g_peer_ipc_event_pools[peer_rank] = pool;
+  auto& events = g_peer_ipc_events[peer_rank];
+  events.reserve(g_ipc_event_count);
+  for (int64_t index = 0; index < g_ipc_event_count; ++index) {
+    ze_event_desc_t desc{};
+    desc.stype = ZE_STRUCTURE_TYPE_EVENT_DESC;
+    desc.index = static_cast<uint32_t>(index);
+    desc.signal = ZE_EVENT_SCOPE_FLAG_DEVICE;
+    desc.wait = ZE_EVENT_SCOPE_FLAG_DEVICE;
+    ze_event_handle_t event = nullptr;
+    check_ze(zeEventCreate(pool, &desc, &event), "zeEventCreate imported");
+    events.push_back(event);
+  }
+}
+
+void tp4_ipc_event_clear(const at::Tensor& device_anchor) {
+  TORCH_CHECK(device_anchor.is_xpu(), "device_anchor must be XPU");
+  auto& q = vllm::xpu::vllmGetQueue();
+  q.wait();
+  auto context = native_context(q);
+  std::lock_guard<std::mutex> lock(g_ipc_event_mutex);
+  if (g_ipc_event_command_list != nullptr) {
+    check_ze(
+        zeCommandListHostSynchronize(g_ipc_event_command_list, UINT64_MAX),
+        "zeCommandListHostSynchronize clear");
+    check_ze(
+        zeCommandListDestroy(g_ipc_event_command_list),
+        "zeCommandListDestroy");
+    g_ipc_event_command_list = nullptr;
+  }
+  for (int rank = 0; rank < kWorld; ++rank) {
+    for (auto event : g_peer_ipc_events[rank]) {
+      check_ze(zeEventDestroy(event), "zeEventDestroy imported");
+    }
+    g_peer_ipc_events[rank].clear();
+    if (g_peer_ipc_event_pools[rank] != nullptr) {
+      check_ze(
+          zeEventPoolCloseIpcHandle(g_peer_ipc_event_pools[rank]),
+          "zeEventPoolCloseIpcHandle");
+      g_peer_ipc_event_pools[rank] = nullptr;
+    }
+  }
+  for (auto event : g_completion_events) {
+    check_ze(zeEventDestroy(event), "zeEventDestroy completion");
+  }
+  for (auto event : g_local_ipc_events) {
+    check_ze(zeEventDestroy(event), "zeEventDestroy local");
+  }
+  g_completion_events.clear();
+  g_local_ipc_events.clear();
+  if (g_completion_event_pool != nullptr) {
+    check_ze(
+        zeEventPoolDestroy(g_completion_event_pool),
+        "zeEventPoolDestroy completion");
+    g_completion_event_pool = nullptr;
+  }
+  if (g_local_ipc_event_pool != nullptr) {
+    if (g_has_exported_ipc_event_handle) {
+      const ze_result_t put_result = zeEventPoolPutIpcHandle(
+          context, g_exported_ipc_event_handle);
+      TORCH_CHECK(
+          put_result == ZE_RESULT_SUCCESS ||
+              put_result == ZE_RESULT_ERROR_UNSUPPORTED_FEATURE,
+          "zeEventPoolPutIpcHandle failed with Level Zero result 0x",
+          std::hex,
+          static_cast<uint32_t>(put_result));
+    }
+    check_ze(
+        zeEventPoolDestroy(g_local_ipc_event_pool),
+        "zeEventPoolDestroy local");
+    g_local_ipc_event_pool = nullptr;
+  }
+  g_has_exported_ipc_event_handle = false;
+  g_exported_ipc_event_handle = {};
+  g_ipc_event_count = 0;
+}
+
+void tp4_allreduce_out(
+    const at::Tensor& partial,
+    const at::Tensor& workspace,
+    at::Tensor& out,
+    int64_t rank,
+    int64_t channel,
+    int64_t epoch) {
+  TORCH_CHECK(
+      partial.is_xpu() && workspace.is_xpu() && out.is_xpu(),
+      "tp4_allreduce_out: all tensors must be XPU");
+  TORCH_CHECK(
+      partial.scalar_type() == at::kBFloat16 &&
+          out.scalar_type() == at::kBFloat16,
+      "tp4_allreduce_out: partial/out must be bfloat16");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous(),
+      "tp4_allreduce_out: workspace must be contiguous uint8");
+  TORCH_CHECK(
+      partial.is_contiguous() && out.is_contiguous() &&
+          partial.numel() == kHidden && out.numel() == kHidden,
+      "tp4_allreduce_out: exact contiguous [4096] tensors required");
+  TORCH_CHECK(
+      static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "tp4_allreduce_out: workspace too small");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(channel >= 0 && channel < kChannels, "invalid TP4 channel");
+  TORCH_CHECK(epoch > 0 && epoch <= INT32_MAX, "invalid TP4 epoch");
+
+  std::array<uint8_t*, kWorld> bases{};
+  {
+    std::lock_guard<std::mutex> lock(g_registry_mutex);
+    for (int r = 0; r < kWorld; ++r) {
+      TORCH_CHECK(
+          r == rank || g_peer_bases[r] != nullptr,
+          "tp4_allreduce_out: peer registry incomplete for rank ",
+          r);
+      bases[r] = r == rank
+          ? static_cast<uint8_t*>(workspace.data_ptr())
+          : static_cast<uint8_t*>(g_peer_bases[r]);
+    }
+  }
+
+  const int slot = static_cast<int>(epoch % kSlots);
+  const size_t payload_offset =
+      (static_cast<size_t>(channel) * kSlots + slot) * kHidden * sizeof(bf16);
+  const size_t sync_offset =
+      kPayloadBytes +
+      (static_cast<size_t>(channel) * kSlots + slot) *
+          kWorld * sizeof(uint32_t);
+  std::array<bf16*, kWorld> payloads{};
+  std::array<uint32_t*, kWorld> syncs{};
+  for (int r = 0; r < kWorld; ++r) {
+    payloads[r] = reinterpret_cast<bf16*>(bases[r] + payload_offset);
+    syncs[r] = reinterpret_cast<uint32_t*>(bases[r] + sync_offset);
+  }
+
+  const bf16* input = reinterpret_cast<const bf16*>(partial.data_ptr());
+  bf16* output = reinterpret_cast<bf16*>(out.data_ptr());
+  const int local_rank = static_cast<int>(rank);
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto copy_event = q.memcpy(
+      payloads[local_rank], input, kHidden * sizeof(bf16));
+
+  auto ready_event = q.submit([&](sycl::handler& cgh) {
+    cgh.depends_on(copy_event);
+    cgh.single_task<TP4PublishReadyKernel>([=]() SYCL_ESIMD_KERNEL {
+      esimd::simd<uint32_t, 16> offsets(0, sizeof(uint32_t));
+      esimd::simd_mask<16> pred = 0;
+      pred[1] = 1;
+      esimd::simd<uint32_t, 16> value = 1;
+      esimd::fence<
+          esimd::memory_kind::global,
+          esimd::fence_flush_op::clean,
+          esimd::fence_scope::system>();
+#pragma unroll
+      for (int destination = 0; destination < kWorld; ++destination) {
+        // Notify each destination by incrementing the destination's local
+        // arrival counter. B70 does not reliably expose a locally published
+        // mailbox to peer polling, while oneCCL's working small all-reduce
+        // protocol performs remote atomic adds into the polling rank's local
+        // allocation.
+        esimd_exp::lsc_atomic_update<
+            esimd::atomic_op::add,
+            uint32_t,
+            16,
+            esimd_exp::lsc_data_size::default_size,
+            esimd_exp::cache_hint::none,
+            esimd_exp::cache_hint::none>(
+            syncs[destination], offsets, value, pred);
+      }
+    });
+  });
+
+  q.submit([&](sycl::handler& cgh) {
+    cgh.depends_on(ready_event);
+    cgh.parallel_for<TP4ReduceKernel>(
+        sycl::nd_range<1>(16, 16),
+        [=](sycl::nd_item<1> item) SYCL_ESIMD_KERNEL {
+          esimd::simd<uint32_t, 16> offsets(0, sizeof(uint32_t));
+          esimd::simd_mask<16> pred = 0;
+          pred[1] = 1;
+          esimd::simd<uint32_t, 16> status;
+          uint32_t attempts = 0;
+          do {
+            status = esimd_exp::lsc_atomic_update<
+                esimd::atomic_op::load,
+                uint32_t,
+                16,
+                esimd_exp::lsc_data_size::default_size,
+                esimd_exp::cache_hint::none,
+                esimd_exp::cache_hint::none>(
+                syncs[local_rank], offsets, pred);
+            ++attempts;
+          } while (status[1] != kWorld && attempts < 10000);
+
+          constexpr int kElemsPerThread = kHidden / 16;
+          const int tid = static_cast<int>(item.get_global_linear_id());
+          const int elem_offset = tid * kElemsPerThread;
+          if (status[1] == kWorld) {
+            const int owner = elem_offset / (kHidden / kWorld);
+            esimd::simd<bf16, kElemsPerThread> sum =
+                esimd::block_load<bf16, kElemsPerThread>(
+                    payloads[owner] + elem_offset);
+#pragma unroll
+            for (int step = 1; step < kWorld; ++step) {
+              const int r = (owner + step) % kWorld;
+              sum = esimd::block_load<bf16, kElemsPerThread>(
+                        payloads[r] + elem_offset) +
+                    sum;
+            }
+            esimd::block_store<bf16, kElemsPerThread>(
+                output + elem_offset, sum);
+          } else {
+            const float diagnostic = -1000.0f - static_cast<float>(status[1]);
+            esimd::simd<bf16, kElemsPerThread> failed = diagnostic;
+            esimd::block_store<bf16, kElemsPerThread>(
+                output + elem_offset, failed);
+          }
+          esimd::barrier();
+          if (tid == 0 && status[1] == kWorld) {
+            esimd::simd<uint32_t, 16> zero = 0;
+            esimd_exp::lsc_atomic_update<
+                esimd::atomic_op::store,
+                uint32_t,
+                16,
+                esimd_exp::lsc_data_size::default_size,
+                esimd_exp::cache_hint::none,
+                esimd_exp::cache_hint::none>(
+                syncs[local_rank], offsets, zero, pred);
+          }
+        });
+  });
+}
+
+void tp4_max_token_from_pair_out(
+    const at::Tensor& local_pair,
+    const at::Tensor& workspace,
+    at::Tensor& out_token,
+    int64_t rank,
+    int64_t channel,
+    int64_t epoch) {
+  TORCH_CHECK(
+      local_pair.is_xpu() && workspace.is_xpu() && out_token.is_xpu(),
+      "tp4_max_token_from_pair_out: all tensors must be XPU");
+  TORCH_CHECK(
+      local_pair.scalar_type() == at::kFloat && local_pair.is_contiguous() &&
+          local_pair.numel() == 2,
+      "tp4_max_token_from_pair_out: local_pair must be contiguous float32 [2]");
+  TORCH_CHECK(
+      out_token.scalar_type() == at::kLong && out_token.is_contiguous() &&
+          out_token.numel() == 1,
+      "tp4_max_token_from_pair_out: out_token must be contiguous int64 [1]");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous() &&
+          static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "tp4_max_token_from_pair_out: workspace is invalid");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(channel >= 0 && channel < kChannels, "invalid TP4 channel");
+  TORCH_CHECK(epoch > 0 && epoch <= INT32_MAX, "invalid TP4 epoch");
+
+  std::array<uint8_t*, kWorld> bases{};
+  {
+    std::lock_guard<std::mutex> lock(g_registry_mutex);
+    for (int r = 0; r < kWorld; ++r) {
+      TORCH_CHECK(
+          r == rank || g_peer_bases[r] != nullptr,
+          "tp4_max_token_from_pair_out: peer registry incomplete for rank ",
+          r);
+      bases[r] = r == rank
+          ? static_cast<uint8_t*>(workspace.data_ptr())
+          : static_cast<uint8_t*>(g_peer_bases[r]);
+    }
+  }
+
+  const int slot = static_cast<int>(epoch % kSlots);
+  const size_t payload_offset =
+      (static_cast<size_t>(channel) * kSlots + slot) * kHidden * sizeof(bf16);
+  const size_t sync_offset =
+      kPayloadBytes +
+      (static_cast<size_t>(channel) * kSlots + slot) *
+          kWorld * sizeof(uint32_t);
+  std::array<float*, kWorld> pairs{};
+  std::array<uint32_t*, kWorld> syncs{};
+  for (int r = 0; r < kWorld; ++r) {
+    pairs[r] = reinterpret_cast<float*>(bases[r] + payload_offset);
+    syncs[r] = reinterpret_cast<uint32_t*>(bases[r] + sync_offset);
+  }
+
+  const float* input = local_pair.data_ptr<float>();
+  int64_t* output = out_token.data_ptr<int64_t>();
+  const int local_rank = static_cast<int>(rank);
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto copy_event = q.memcpy(pairs[local_rank], input, 2 * sizeof(float));
+
+  auto ready_event = q.submit([&](sycl::handler& cgh) {
+    cgh.depends_on(copy_event);
+    cgh.single_task<TP4PairPublishReadyKernel>([=]() SYCL_ESIMD_KERNEL {
+      esimd::simd<uint32_t, 16> offsets(0, sizeof(uint32_t));
+      esimd::simd_mask<16> pred = 0;
+      pred[1] = 1;
+      esimd::simd<uint32_t, 16> one = 1;
+      esimd::fence<
+          esimd::memory_kind::global,
+          esimd::fence_flush_op::clean,
+          esimd::fence_scope::system>();
+#pragma unroll
+      for (int destination = 0; destination < kWorld; ++destination) {
+        esimd_exp::lsc_atomic_update<
+            esimd::atomic_op::add,
+            uint32_t,
+            16,
+            esimd_exp::lsc_data_size::default_size,
+            esimd_exp::cache_hint::none,
+            esimd_exp::cache_hint::none>(
+            syncs[destination], offsets, one, pred);
+      }
+    });
+  });
+
+  q.submit([&](sycl::handler& cgh) {
+    cgh.depends_on(ready_event);
+    cgh.single_task<TP4PairSelectKernel>([=]() SYCL_ESIMD_KERNEL {
+      esimd::simd<uint32_t, 16> offsets(0, sizeof(uint32_t));
+      esimd::simd_mask<16> pred = 0;
+      pred[1] = 1;
+      esimd::simd<uint32_t, 16> status;
+      uint32_t attempts = 0;
+      do {
+        status = esimd_exp::lsc_atomic_update<
+            esimd::atomic_op::load,
+            uint32_t,
+            16,
+            esimd_exp::lsc_data_size::default_size,
+            esimd_exp::cache_hint::none,
+            esimd_exp::cache_hint::none>(
+            syncs[local_rank], offsets, pred);
+        ++attempts;
+      } while (status[1] != kWorld && attempts < 10000);
+
+      int64_t winner = -1;
+      if (status[1] == kWorld) {
+        esimd::fence<
+            esimd::memory_kind::global,
+            esimd::fence_flush_op::invalidate,
+            esimd::fence_scope::system>();
+        float best_value = -std::numeric_limits<float>::infinity();
+        int64_t best_token = INT64_MAX;
+#pragma unroll
+        for (int r = 0; r < kWorld; ++r) {
+          const esimd::simd<float, 2> pair =
+              esimd::block_load<float, 2>(pairs[r]);
+          const int64_t token = static_cast<int64_t>(pair[1]);
+          if (pair[0] > best_value ||
+              (pair[0] == best_value && token < best_token)) {
+            best_value = pair[0];
+            best_token = token;
+          }
+        }
+        winner = best_token;
+      }
+      esimd::simd<int64_t, 1> result = winner;
+      esimd::block_store<int64_t, 1>(output, result);
+      if (status[1] == kWorld) {
+        esimd::simd<uint32_t, 16> zero = 0;
+        esimd_exp::lsc_atomic_update<
+            esimd::atomic_op::store,
+            uint32_t,
+            16,
+            esimd_exp::lsc_data_size::default_size,
+            esimd_exp::cache_hint::none,
+            esimd_exp::cache_hint::none>(
+            syncs[local_rank], offsets, zero, pred);
+      }
+    });
+  });
+}
+
+void tp4_ipc_event_max_token_from_pair_out(
+    const at::Tensor& local_pair,
+    const at::Tensor& workspace,
+    at::Tensor& out_token,
+    int64_t rank,
+    int64_t channel,
+    int64_t event_index) {
+  TORCH_CHECK(
+      local_pair.is_xpu() && workspace.is_xpu() && out_token.is_xpu(),
+      "tp4_ipc_event_max_token_from_pair_out: tensors must be XPU");
+  TORCH_CHECK(
+      local_pair.scalar_type() == at::kFloat && local_pair.is_contiguous() &&
+          local_pair.numel() == 2,
+      "local_pair must be contiguous float32 [2]");
+  TORCH_CHECK(
+      out_token.scalar_type() == at::kLong && out_token.is_contiguous() &&
+          out_token.numel() == 1,
+      "out_token must be contiguous int64 [1]");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous() &&
+          static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "workspace is invalid");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(channel >= 0 && channel < kChannels, "invalid channel");
+  TORCH_CHECK(
+      event_index >= 0 && event_index < g_ipc_event_count,
+      "invalid IPC event index");
+
+  std::array<uint8_t*, kWorld> bases{};
+  std::array<ze_event_handle_t, kWorld - 1> peer_events{};
+  ze_event_handle_t local_ready = nullptr;
+  ze_event_handle_t completion = nullptr;
+  ze_command_list_handle_t command_list = nullptr;
+  {
+    std::scoped_lock lock(g_registry_mutex, g_ipc_event_mutex);
+    int peer_index = 0;
+    for (int peer = 0; peer < kWorld; ++peer) {
+      TORCH_CHECK(
+          peer == rank || g_peer_bases[peer] != nullptr,
+          "peer memory registry incomplete for rank ",
+          peer);
+      bases[peer] = peer == rank
+          ? static_cast<uint8_t*>(workspace.data_ptr())
+          : static_cast<uint8_t*>(g_peer_bases[peer]);
+      if (peer != rank) {
+        TORCH_CHECK(
+            static_cast<int64_t>(g_peer_ipc_events[peer].size()) >
+                event_index,
+            "peer event registry incomplete for rank ",
+            peer);
+        peer_events[peer_index++] = g_peer_ipc_events[peer][event_index];
+      }
+    }
+    local_ready = g_local_ipc_events[event_index];
+    completion = g_completion_events[event_index];
+    command_list = g_ipc_event_command_list;
+  }
+
+  const int slot = static_cast<int>(event_index % kSlots);
+  const size_t payload_offset =
+      (static_cast<size_t>(channel) * kSlots + slot) * kHidden * sizeof(bf16);
+  std::array<float*, kWorld> pairs{};
+  for (int peer = 0; peer < kWorld; ++peer) {
+    pairs[peer] = reinterpret_cast<float*>(bases[peer] + payload_offset);
+  }
+
+  auto& q = vllm::xpu::vllmGetQueue();
+  auto write_event = q.memcpy(
+      pairs[rank], local_pair.data_ptr<float>(), 2 * sizeof(float));
+  auto native_write =
+      sycl::get_native<sycl::backend::ext_oneapi_level_zero>(write_event);
+  check_ze(
+      zeCommandListAppendWaitOnEvents(command_list, 1, &native_write),
+      "zeCommandListAppendWaitOnEvents local write");
+  check_ze(
+      zeCommandListAppendSignalEvent(command_list, local_ready),
+      "zeCommandListAppendSignalEvent ready");
+  check_ze(
+      zeCommandListAppendWaitOnEvents(
+          command_list, peer_events.size(), peer_events.data()),
+      "zeCommandListAppendWaitOnEvents peers");
+  check_ze(
+      zeCommandListAppendSignalEvent(command_list, completion),
+      "zeCommandListAppendSignalEvent completion");
+
+  auto completion_event =
+      sycl::make_event<sycl::backend::ext_oneapi_level_zero>(
+          {completion, sycl::ext::oneapi::level_zero::ownership::keep},
+          q.get_context());
+  int64_t* output = out_token.data_ptr<int64_t>();
+  q.submit([&](sycl::handler& cgh) {
+    cgh.depends_on(completion_event);
+    cgh.single_task<TP4PairEventSelectKernel>([=]() SYCL_ESIMD_KERNEL {
+      esimd::fence<
+          esimd::memory_kind::global,
+          esimd::fence_flush_op::invalidate,
+          esimd::fence_scope::system>();
+      float best_value = -std::numeric_limits<float>::infinity();
+      int64_t best_token = INT64_MAX;
+#pragma unroll
+      for (int peer = 0; peer < kWorld; ++peer) {
+        const esimd::simd<float, 2> pair =
+            esimd::block_load<float, 2>(pairs[peer]);
+        const int64_t token = static_cast<int64_t>(pair[1]);
+        if (pair[0] > best_value ||
+            (pair[0] == best_value && token < best_token)) {
+          best_value = pair[0];
+          best_token = token;
+        }
+      }
+      esimd::simd<int64_t, 1> result = best_token;
+      esimd::block_store<int64_t, 1>(output, result);
+    });
+  });
+}
