+        ptr_B.size(0) == num_local_experts && ptr_B.size(1) == N &&
+            ptr_B.size(2) == packed_last,
+        "tile-major ptr_B must have shape [num_local_experts, N, 17*K/32]");
+    TORCH_CHECK(
+        ptr_scales.sizes() == ptr_B.sizes() &&
+            ptr_scales.data_ptr() == ptr_B.data_ptr(),
+        "tile-major ptr_scales must alias the combined ptr_B record storage");
+  } else {
+    TORCH_CHECK(
+        ptr_B.size(0) == num_local_experts && ptr_B.size(1) == N &&
+            ptr_B.size(2) * 2 == K,
+        "ptr_B must have shape [num_local_experts, N, K/2]");
+    TORCH_CHECK(
+        ptr_scales.size(0) == num_local_experts && ptr_scales.size(1) == N &&
+            ptr_scales.size(2) == K / 32,
+        "ptr_scales must have shape [num_local_experts, N, K/32]");
+  }
+  TORCH_CHECK(
+      ptr_D.size(0) == topk && ptr_D.size(1) == N,
+      "ptr_D must have shape [topk, N]");
+
+  const bfloat16_t* bias_ptr = nullptr;
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(ptr_bias->is_xpu(), "ptr_bias must be an XPU tensor");
+    TORCH_CHECK(
+        ptr_bias->device() == ptr_A.device(),
+        "ptr_bias must be on the same XPU device as ptr_A");
+    TORCH_CHECK(
+        ptr_bias->is_contiguous() && ptr_bias->scalar_type() == at::kBFloat16,
+        "ptr_bias must be contiguous BF16");
+    TORCH_CHECK(
+        ptr_bias->dim() == 2 && ptr_bias->size(0) == num_local_experts &&
+            ptr_bias->size(1) == N,
+        "ptr_bias must have shape [num_local_experts, N]");
+    bias_ptr = reinterpret_cast<const bfloat16_t*>(ptr_bias->data_ptr());
+  }
+
+  const int32_t* expert_map_ptr = nullptr;
+  int32_t expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(expert_map->is_xpu(), "expert_map must be an XPU tensor");
+    TORCH_CHECK(
+        expert_map->device() == ptr_A.device(),
+        "expert_map must be on the same XPU device as ptr_A");
+    TORCH_CHECK(
+        expert_map->dim() == 1 && expert_map->is_contiguous() &&
+            expert_map->scalar_type() == at::kInt,
+        "expert_map must be contiguous int32 [global_num_experts]");
+    TORCH_CHECK(
+        expert_map->numel() <= std::numeric_limits<int32_t>::max(),
+        "expert_map length must fit in int32");
+    expert_map_ptr = static_cast<const int32_t*>(expert_map->data_ptr());
+    expert_map_size = static_cast<int32_t>(expert_map->numel());
+  }
+
+  auto& queue = at::xpu::getCurrentXPUStream(ptr_A.device().index()).queue();
+  auto* a_ptr = reinterpret_cast<const bfloat16_t*>(ptr_A.data_ptr());
+  auto* b_ptr = reinterpret_cast<const uint8_t*>(ptr_B.data_ptr());
+  auto* scale_ptr = reinterpret_cast<const uint8_t*>(ptr_scales.data_ptr());
+  auto* d_ptr = reinterpret_cast<bfloat16_t*>(ptr_D.data_ptr());
+
+  if (topk_ids.scalar_type() == at::kInt) {
+    M1TopkGEMMLaunchByN<int32_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int32_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int32_t>(topk),
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K),
+        broadcast_a);
+  } else {
+    M1TopkGEMMLaunchByN<int64_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int64_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int32_t>(topk),
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K),
+        broadcast_a);
+  }
+  return ptr_D;
+}
+
+at::Tensor cutlass_grouped_gemm_m8_topk_int4_xe2_impl(
+    const at::Tensor& ptr_A,
+    const at::Tensor& ptr_B,
+    const at::Tensor& ptr_scales,
+    const c10::optional<at::Tensor>& ptr_bias,
+    at::Tensor& ptr_D,
+    const at::Tensor& topk_ids,
+    const c10::optional<at::Tensor>& expert_map,
+    int64_t N,
+    int64_t K,
+    int64_t num_local_experts,
+    bool broadcast_route_input,
+    bool zero_remote_routes,
+    bool route_interleave) {
+  TORCH_CHECK(
+      ptr_A.is_xpu() && ptr_B.is_xpu() && ptr_scales.is_xpu() &&
+          ptr_D.is_xpu() && topk_ids.is_xpu(),
+      "fixed-M8 INT4 route tensors must be XPU tensors");
+  TORCH_CHECK(
+      ptr_A.device() == ptr_B.device() &&
+          ptr_A.device() == ptr_scales.device() &&
+          ptr_A.device() == ptr_D.device() &&
+          ptr_A.device() == topk_ids.device(),
+      "fixed-M8 INT4 route tensors must share one device");
+  TORCH_CHECK(
+      ptr_A.is_contiguous() && ptr_B.is_contiguous() &&
+          ptr_scales.is_contiguous() && ptr_D.is_contiguous() &&
+          topk_ids.is_contiguous(),
+      "fixed-M8 INT4 route tensors must be contiguous");
+  TORCH_CHECK(
+      ptr_A.scalar_type() == at::kBFloat16 &&
+          ptr_scales.scalar_type() == at::kBFloat16 &&
+          ptr_D.scalar_type() == at::kBFloat16,
+      "fixed-M8 INT4 routes require BF16 activations/scales/output");
+  TORCH_CHECK(
+      ptr_B.scalar_type() == at::kChar,
+      "fixed-M8 INT4 routes require packed signed INT4 byte storage");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong,
+      "topk_ids must be int32 or int64");
+  const bool mwide = laguna_mwide_fixed_route_enabled();
+  TORCH_CHECK(
+      topk_ids.dim() == 2 && topk_ids.size(0) >= 1 &&
+          (topk_ids.size(0) <= 8 || (mwide && topk_ids.size(0) == 12)) &&
+          topk_ids.size(1) == 10,
+      "fixed-route Laguna contract is [1..8,10], or [12,10] under the "
+      "exact width-12 selector");
+  const int64_t num_rows = topk_ids.size(0);
+  const int64_t topk = topk_ids.size(1);
+  const int64_t route_count = num_rows * topk;
+  TORCH_CHECK(
+      ptr_A.dim() == 2 && ptr_A.size(1) == K &&
+          ptr_A.size(0) == (broadcast_route_input ? num_rows : route_count),
+      "fixed-M8 ptr_A shape does not match route mode");
+  TORCH_CHECK(
+      ptr_B.dim() == 3 && ptr_B.size(0) == num_local_experts &&
+          ptr_B.size(1) == N && ptr_B.size(2) * 2 == K,
+      "fixed-M8 ptr_B must be [local_experts,N,K/2]");
+  TORCH_CHECK(
+      ptr_scales.dim() == 3 && ptr_scales.size(0) == num_local_experts &&
+          ptr_scales.size(1) == N && ptr_scales.size(2) == K / 32,
+      "fixed-M8 scales must be [local_experts,N,K/32]");
+  TORCH_CHECK(
+      ptr_D.dim() == 2 && ptr_D.size(0) == route_count && ptr_D.size(1) == N,
+      "fixed-M8 ptr_D must be [rows*10,N]");
+  TORCH_CHECK(K % 32 == 0 && N % 8 == 0, "invalid Laguna INT4 GEMM shape");
+
+  const bfloat16_t* bias_ptr = nullptr;
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(
+        ptr_bias->is_xpu() && ptr_bias->device() == ptr_A.device() &&
+            ptr_bias->is_contiguous() &&
+            ptr_bias->scalar_type() == at::kBFloat16 && ptr_bias->dim() == 2 &&
+            ptr_bias->size(0) == num_local_experts && ptr_bias->size(1) == N,
+        "fixed-M8 bias must be contiguous BF16 [local_experts,N]");
+    bias_ptr = reinterpret_cast<const bfloat16_t*>(ptr_bias->data_ptr());
+  }
+  const int32_t* expert_map_ptr = nullptr;
+  int32_t expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->is_xpu() && expert_map->device() == ptr_A.device() &&
+            expert_map->dim() == 1 && expert_map->is_contiguous() &&
+            expert_map->scalar_type() == at::kInt,
+        "expert_map must be contiguous int32 on the same XPU");
+    expert_map_ptr = static_cast<const int32_t*>(expert_map->data_ptr());
+    expert_map_size = static_cast<int32_t>(expert_map->numel());
+  }
+
+  auto& queue = at::xpu::getCurrentXPUStream(ptr_A.device().index()).queue();
+  auto launch = [&](auto id_tag, auto interleave_tag) {
+    using id_type = decltype(id_tag);
+    constexpr bool interleave = decltype(interleave_tag)::value;
+    M8TopkInt4GEMMLauncher<w4a16_policy_m_8, id_type, interleave>(
+        queue,
+        reinterpret_cast<const bfloat16_t*>(ptr_A.data_ptr()),
+        reinterpret_cast<const uint8_t*>(ptr_B.data_ptr()),
+        reinterpret_cast<const bfloat16_t*>(ptr_scales.data_ptr()),
+        bias_ptr,
+        reinterpret_cast<bfloat16_t*>(ptr_D.data_ptr()),
+        static_cast<const id_type*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int32_t>(num_rows),
+        static_cast<int32_t>(topk),
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K),
+        broadcast_route_input,
+        zero_remote_routes);
+  };
+  if (topk_ids.scalar_type() == at::kInt) {
+    if (route_interleave) {
+      launch(int32_t{}, std::true_type{});
+    } else {
+      launch(int32_t{}, std::false_type{});
+    }
+  } else {
+    if (route_interleave) {
+      launch(int64_t{}, std::true_type{});
+    } else {
+      launch(int64_t{}, std::false_type{});
+    }
+  }
+  return ptr_D;
+}
+
+at::Tensor laguna_m8_fused_expert_xe2_impl(
+    const at::Tensor& hidden_states,
+    const at::Tensor& w13,
+    const at::Tensor& w13_scales,
+    const c10::optional<at::Tensor>& w13_bias,
+    const at::Tensor& w2,
+    const at::Tensor& w2_scales,
+    const c10::optional<at::Tensor>& w2_bias,
+    at::Tensor& gemm1_scratch,
+    at::Tensor& act_scratch,
+    at::Tensor& gemm2_scratch,
+    at::Tensor& output,
+    const at::Tensor& topk_weights,
+    const at::Tensor& topk_ids,
+    const c10::optional<at::Tensor>& expert_map,
+    int64_t num_local_experts,
+    bool w1_only,
+    bool route_interleave,
+    int64_t w1_n_tile) {
+  constexpr int64_t hidden_size = 3072;
+  constexpr int64_t intermediate_size = 1024;
+  constexpr int64_t topk = 10;
+  TORCH_CHECK(
+      num_local_experts == 64, "Laguna fused expert requires 64 local experts");
+  TORCH_CHECK(
+      !route_interleave || w1_only,
+      "Laguna route interleave is only valid for fused-W1/route-W2 mode");
+  TORCH_CHECK(
+      w1_n_tile == 32 || w1_n_tile == 64 || w1_n_tile == 128,
+      "Laguna fused expert W1 N tile must be 32, 64, or 128");
+  TORCH_CHECK(
+      hidden_states.is_xpu() && w13.is_xpu() && w13_scales.is_xpu() &&
+          w2.is_xpu() && w2_scales.is_xpu() && gemm1_scratch.is_xpu() &&
+          act_scratch.is_xpu() && gemm2_scratch.is_xpu() && output.is_xpu() &&
+          topk_weights.is_xpu() && topk_ids.is_xpu(),
+      "Laguna fused expert tensors must be XPU tensors");
+  const auto device = hidden_states.device();
+  TORCH_CHECK(
+      w13.device() == device && w13_scales.device() == device &&
+          w2.device() == device && w2_scales.device() == device &&
+          gemm1_scratch.device() == device && act_scratch.device() == device &&
+          gemm2_scratch.device() == device && output.device() == device &&
+          topk_weights.device() == device && topk_ids.device() == device,
+      "Laguna fused expert tensors must share one XPU device");
+  TORCH_CHECK(
+      hidden_states.is_contiguous() && w13.is_contiguous() &&
+          w13_scales.is_contiguous() && w2.is_contiguous() &&
+          w2_scales.is_contiguous() && gemm1_scratch.is_contiguous() &&
+          act_scratch.is_contiguous() && gemm2_scratch.is_contiguous() &&
+          output.is_contiguous() && topk_weights.is_contiguous() &&
+          topk_ids.is_contiguous(),
+      "Laguna fused expert tensors must be contiguous");
+  TORCH_CHECK(
+      hidden_states.scalar_type() == at::kBFloat16 &&
+          w13_scales.scalar_type() == at::kBFloat16 &&
+          w2_scales.scalar_type() == at::kBFloat16 &&
+          gemm1_scratch.scalar_type() == at::kBFloat16 &&
+          act_scratch.scalar_type() == at::kBFloat16 &&
+          gemm2_scratch.scalar_type() == at::kBFloat16 &&
+          output.scalar_type() == at::kBFloat16,
+      "Laguna fused expert activations/scales/scratch/output must be BF16");
+  TORCH_CHECK(
+      w13.scalar_type() == at::kChar && w2.scalar_type() == at::kChar,
+      "Laguna fused expert weights must use packed signed INT4 bytes");
+  TORCH_CHECK(
+      topk_weights.scalar_type() == at::kFloat,
+      "Laguna fused expert router weights must be FP32");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong,
+      "Laguna fused expert IDs must be int32 or int64");
+  const bool mwide = laguna_mwide_fixed_route_enabled();
+  TORCH_CHECK(
+      hidden_states.dim() == 2 && hidden_states.size(0) >= 1 &&
+          (hidden_states.size(0) <= 8 ||
+           (mwide && hidden_states.size(0) == 12)) &&
+          hidden_states.size(1) == hidden_size,
+      "Laguna fused expert hidden states must be [1..8,3072], or "
+      "[12,3072] under the exact width-12 selector");
+  const int64_t num_rows = hidden_states.size(0);
+  TORCH_CHECK(
+      w1_n_tile == 64 || (w1_only && route_interleave && num_rows == 8),
+      "Laguna fused expert non-N64 W1 requires M=8 W1-only route interleave");
+  TORCH_CHECK(
+      w1_n_tile == 64 || expert_map.has_value(),
+      "Laguna fused expert non-N64 W1 requires an EP4 expert map");
+  const int64_t route_count = num_rows * topk;
+  TORCH_CHECK(
+      topk_weights.sizes() == at::IntArrayRef({num_rows, topk}) &&
+          topk_ids.sizes() == at::IntArrayRef({num_rows, topk}),
+      "Laguna fused expert router tensors must be [M,10]");
+  TORCH_CHECK(
+      w13.sizes() == at::IntArrayRef(
+                         {num_local_experts,
+                          2 * intermediate_size,
+                          hidden_size / 2}) &&
+          w13_scales.sizes() ==
+              at::IntArrayRef(
+                  {num_local_experts, 2 * intermediate_size, hidden_size / 32}),
+      "Laguna fused expert W13 contract mismatch");
+  TORCH_CHECK(
+      w2.sizes() ==
+              at::IntArrayRef(
+                  {num_local_experts, hidden_size, intermediate_size / 2}) &&
+          w2_scales.sizes() ==
+              at::IntArrayRef(
+                  {num_local_experts, hidden_size, intermediate_size / 32}),
+      "Laguna fused expert W2 contract mismatch");
+  TORCH_CHECK(
+      gemm1_scratch.sizes() ==
+              at::IntArrayRef({route_count, 2 * intermediate_size}) &&
+          act_scratch.sizes() ==
+              at::IntArrayRef({route_count, intermediate_size}) &&
+          gemm2_scratch.sizes() ==
+              at::IntArrayRef({route_count, hidden_size}) &&
+          output.sizes() == at::IntArrayRef({num_rows, hidden_size}),
+      "Laguna fused expert scratch/output contract mismatch");
+
+  auto check_bias = [&](const c10::optional<at::Tensor>& bias,
+                        int64_t width,
+                        const char* name) {
+    if (!bias.has_value()) return;
+    TORCH_CHECK(
+        bias->is_xpu() && bias->device() == device && bias->is_contiguous() &&
+            bias->scalar_type() == at::kBFloat16 &&
+            bias->sizes() == at::IntArrayRef({num_local_experts, width}),
+        name,
+        " must be BF16 [64,N] on the same XPU");
+  };
+  check_bias(w13_bias, 2 * intermediate_size, "W13 bias");
+  check_bias(w2_bias, hidden_size, "W2 bias");
+
+  const int32_t* expert_map_ptr = nullptr;
+  int32_t expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->is_xpu() && expert_map->device() == device &&
+            expert_map->is_contiguous() && expert_map->dim() == 1 &&
+            expert_map->scalar_type() == at::kInt && expert_map->numel() == 256,
+        "Laguna fused expert map must be contiguous int32 [256]");
+    expert_map_ptr = static_cast<const int32_t*>(expert_map->data_ptr());
+    expert_map_size = 256;
+  }
+  const bfloat16_t* w13_bias_ptr =
+      w13_bias.has_value()
+          ? reinterpret_cast<const bfloat16_t*>(w13_bias->data_ptr())
+          : nullptr;
+  const bfloat16_t* w2_bias_ptr =
+      w2_bias.has_value()
+          ? reinterpret_cast<const bfloat16_t*>(w2_bias->data_ptr())
+          : nullptr;
+  auto& queue = at::xpu::getCurrentXPUStream(device.index()).queue();
+  auto launch = [&](auto id_tag, auto interleave_tag) {
+    using id_type = decltype(id_tag);
+    constexpr bool interleave = decltype(interleave_tag)::value;
+    auto launch_w1 = [&](auto policy_tag) {
+      using policy = decltype(policy_tag);
+      M8TopkInt4W1SiluLauncher<policy, id_type, interleave>(
+          queue,
+          reinterpret_cast<const bfloat16_t*>(hidden_states.data_ptr()),
+          reinterpret_cast<const uint8_t*>(w13.data_ptr()),
+          reinterpret_cast<const bfloat16_t*>(w13_scales.data_ptr()),
+          w13_bias_ptr,
+          reinterpret_cast<bfloat16_t*>(gemm1_scratch.data_ptr()),
+          reinterpret_cast<bfloat16_t*>(act_scratch.data_ptr()),
+          static_cast<const id_type*>(topk_ids.data_ptr()),
+          expert_map_ptr,
+          expert_map_size,
+          static_cast<int32_t>(num_rows),
+          static_cast<int32_t>(topk),
+          static_cast<int32_t>(num_local_experts),
+          static_cast<int32_t>(2 * intermediate_size),
+          static_cast<int32_t>(hidden_size));
+    };
+    if (w1_n_tile == 32) {
+      launch_w1(w4a16_policy_m_8_n_32{});
+    } else if (w1_n_tile == 128) {
+      launch_w1(w4a16_policy_m_8_n_128{});
+    } else {
+      launch_w1(w4a16_policy_m_8{});
+    }
+    if (w1_only) return;
+    M8TopkInt4W2ReduceLauncher<w4a16_policy_m_8, id_type>(
+        queue,
+        reinterpret_cast<const bfloat16_t*>(act_scratch.data_ptr()),
+        reinterpret_cast<const uint8_t*>(w2.data_ptr()),
+        reinterpret_cast<const bfloat16_t*>(w2_scales.data_ptr()),
+        w2_bias_ptr,
+        reinterpret_cast<bfloat16_t*>(gemm2_scratch.data_ptr()),
+        reinterpret_cast<bfloat16_t*>(output.data_ptr()),
+        static_cast<const float*>(topk_weights.data_ptr()),
+        static_cast<const id_type*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        static_cast<int32_t>(num_rows),
+        static_cast<int32_t>(topk),
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(hidden_size),
+        static_cast<int32_t>(intermediate_size));
+  };
+  if (topk_ids.scalar_type() == at::kInt) {
+    if (route_interleave) {
+      launch(int32_t{}, std::true_type{});
+    } else {
+      launch(int32_t{}, std::false_type{});
+    }
+  } else {
+    if (route_interleave) {
+      launch(int64_t{}, std::true_type{});
+    } else {
+      launch(int64_t{}, std::false_type{});
+    }
+  }
+  return output;
+}
+
+at::Tensor cutlass_grouped_gemm_m2_compact_xe2_impl(
+    const at::Tensor& ptr_A,
+    const at::Tensor& ptr_B,
+    const at::Tensor& ptr_scales,
+    const c10::optional<at::Tensor>& ptr_bias,
+    at::Tensor& ptr_D,
+    const at::Tensor& topk_ids,
+    const c10::optional<at::Tensor>& expert_map,
+    int64_t N,
+    int64_t K,
+    int64_t num_local_experts) {
+  TORCH_CHECK(
+      ptr_A.is_xpu() && ptr_B.is_xpu() && ptr_scales.is_xpu() &&
+          ptr_D.is_xpu() && topk_ids.is_xpu(),
+      "all required tensors must be XPU tensors");
+  TORCH_CHECK(
+      ptr_A.device() == ptr_B.device() &&
+          ptr_A.device() == ptr_scales.device() &&
+          ptr_A.device() == ptr_D.device() &&
+          ptr_A.device() == topk_ids.device(),
+      "all required tensors must be on the same XPU device");
+  TORCH_CHECK(
+      ptr_A.is_contiguous() && ptr_B.is_contiguous() &&
+          ptr_scales.is_contiguous() && ptr_D.is_contiguous() &&
+          topk_ids.is_contiguous(),
+      "all required tensors must be contiguous");
+
+  TORCH_CHECK(
+      ptr_A.scalar_type() == at::kBFloat16 &&
+          ptr_D.scalar_type() == at::kBFloat16,
+      "fixed-M2 compact grouped GEMM requires BF16 activations and outputs");
+  TORCH_CHECK(
+      ptr_B.scalar_type() == at::kFloat4_e2m1fn_x2,
+      "fixed-M2 compact grouped GEMM requires packed MXFP4 weights");
+  TORCH_CHECK(
+      ptr_scales.scalar_type() == at::kByte ||
+          ptr_scales.scalar_type() == at::kFloat8_e8m0fnu,
+      "fixed-M2 compact grouped GEMM requires E8M0 scale bytes");
+  TORCH_CHECK(
+      topk_ids.scalar_type() == at::kInt || topk_ids.scalar_type() == at::kLong,
+      "topk_ids must be int32 or int64");
+
+  TORCH_CHECK(
+      topk_ids.dim() == 2 && topk_ids.size(0) == 2 && topk_ids.size(1) == 6,
+      "fixed-M2 compact grouped GEMM requires topk_ids [2, 6]");
+  TORCH_CHECK(
+      ptr_A.dim() == 2 && ptr_A.size(0) == 12 && ptr_A.size(1) == K,
+      "ptr_A must have shape [12, K]");
+  TORCH_CHECK(
+      ptr_D.dim() == 2 && ptr_D.size(0) == 12 && ptr_D.size(1) == N,
+      "ptr_D must have shape [12, N]");
+  TORCH_CHECK(
+      ptr_B.dim() == 3 && ptr_B.size(0) == num_local_experts &&
+          ptr_B.size(1) == N && ptr_B.size(2) * 2 == K,
+      "ptr_B must have shape [num_local_experts, N, K/2]");
+  TORCH_CHECK(
+      ptr_scales.dim() == 3 && ptr_scales.size(0) == num_local_experts &&
+          ptr_scales.size(1) == N && ptr_scales.size(2) == K / 32,
+      "ptr_scales must have shape [num_local_experts, N, K/32]");
+  TORCH_CHECK(
+      N > 0 && K > 0 && N <= std::numeric_limits<int32_t>::max() &&
+          K <= std::numeric_limits<int32_t>::max() && N % 64 == 0 &&
+          K % 32 == 0,
+      "N and K must fit int32; N must be divisible by 64 and K by 32");
+  TORCH_CHECK(
+      num_local_experts > 0 &&
+          num_local_experts <= std::numeric_limits<int32_t>::max(),
+      "num_local_experts must be a positive int32 value");
+
+  const bfloat16_t* bias_ptr = nullptr;
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(
+        ptr_bias->is_xpu() && ptr_bias->device() == ptr_A.device() &&
+            ptr_bias->is_contiguous() &&
+            ptr_bias->scalar_type() == at::kBFloat16 && ptr_bias->dim() == 2 &&
+            ptr_bias->size(0) == num_local_experts && ptr_bias->size(1) == N,
+        "ptr_bias must be contiguous BF16 [num_local_experts, N]");
+    bias_ptr = reinterpret_cast<const bfloat16_t*>(ptr_bias->data_ptr());
+  }
+
+  const int32_t* expert_map_ptr = nullptr;
+  int32_t expert_map_size = 0;
+  if (expert_map.has_value()) {
+    TORCH_CHECK(
+        expert_map->is_xpu() && expert_map->device() == ptr_A.device() &&
+            expert_map->dim() == 1 && expert_map->is_contiguous() &&
+            expert_map->scalar_type() == at::kInt &&
+            expert_map->numel() <= std::numeric_limits<int32_t>::max(),
+        "expert_map must be contiguous int32 [global_num_experts]");
+    expert_map_ptr = static_cast<const int32_t*>(expert_map->data_ptr());
+    expert_map_size = static_cast<int32_t>(expert_map->numel());
+  }
+
+  auto& queue = at::xpu::getCurrentXPUStream(ptr_A.device().index()).queue();
+  auto* a_ptr = reinterpret_cast<const bfloat16_t*>(ptr_A.data_ptr());
+  auto* b_ptr = reinterpret_cast<const uint8_t*>(ptr_B.data_ptr());
+  auto* scale_ptr = reinterpret_cast<const uint8_t*>(ptr_scales.data_ptr());
+  auto* d_ptr = reinterpret_cast<bfloat16_t*>(ptr_D.data_ptr());
+
+  using policy = w4a16_policy_m_8;
+  if (topk_ids.scalar_type() == at::kInt) {
+    M2CompactGEMMLauncher<policy, int32_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int32_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        6,
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K));
+  } else {
+    M2CompactGEMMLauncher<policy, int64_t>(
+        queue,
+        a_ptr,
+        b_ptr,
+        scale_ptr,
+        bias_ptr,
+        d_ptr,
+        static_cast<const int64_t*>(topk_ids.data_ptr()),
+        expert_map_ptr,
+        expert_map_size,
+        6,
+        static_cast<int32_t>(num_local_experts),
+        static_cast<int32_t>(N),
+        static_cast<int32_t>(K));
+  }
+  return ptr_D;
+}
+}  // namespace MoE
