+            ),
+        )
+        proc.start()
+        child.close()
+        conns.append(parent)
+        children.append(proc)
+    try:
+        ready = [conn.recv() for conn in conns]
+        if any(row[0] != "ready" for row in ready):
+            raise SystemExit(f"worker setup failed: {ready}")
+        for conn in conns:
+            conn.send("go")
+        results = [conn.recv() for conn in conns]
+        print(
+            json.dumps(
+                {
+                    "iterations": args.iterations,
+                    "library": args.library,
+                    "graph_skipped": args.skip_graph,
+                    "fused_reference": args.fused_reference,
+                    "graph_boundaries": args.graph_boundaries,
+                    "graph_recurrent": args.graph_recurrent,
+                    "graph_final_post": args.graph_final_post,
+                    "graph_initial_allreduce": args.graph_initial_allreduce,
+                    "graph_layer_alias": args.graph_layer_alias,
+                    "graph_replays": args.graph_replays,
+                    "graph_skew_elements": args.graph_skew_elements,
+                    "graph_dependent_partials": args.graph_dependent_partials,
+                    "ranks": results,
+                },
+                indent=2,
+            )
+        )
+        if any("error" in row for row in results):
+            raise SystemExit("candidate worker failed")
+        if not all(all(row[key]) for row in results for key in ("exact", "graph_changed", "graph_exact")):
+            raise SystemExit("post-pre fusion gate failed")
+        if args.graph_final_post and not all(
+            row["final_post_changed"] and row["final_post_exact"] for row in results
+        ):
+            raise SystemExit("final post fusion graph gate failed")
+        if args.graph_initial_allreduce and not all(
+            row["initial_allreduce_changed"] and row["initial_allreduce_exact"]
+            for row in results
+        ):
+            raise SystemExit("initial all-reduce graph gate failed")
+    finally:
+        for proc in children:
+            proc.join(timeout=5)
+            if proc.is_alive():
+                proc.terminate()
+                proc.join(timeout=5)
+    failed = [proc for proc in children if proc.exitcode != 0]
+    if failed:
+        raise SystemExit("workers failed: " + ", ".join(f"{p.pid}:{p.exitcode}" for p in failed))
+
+
+if __name__ == "__main__":
+    main()
