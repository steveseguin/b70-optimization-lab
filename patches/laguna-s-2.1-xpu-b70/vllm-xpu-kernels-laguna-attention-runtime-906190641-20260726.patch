+namespace vllm {
+
+// Laguna S 2.1 exact verifier contract. The incumbent head-dim-128 RMSNorm
+// kernel assigns eight adjacent BF16 elements to each of 16 lanes, accumulates
+// those eight squares serially, and then uses a 16-lane shift reduction. Keep
+// that tree verbatim. The two explicit scalar_t assignments below preserve the
+// incumbent BF16 round after x*rrms and after the BF16 weight multiply. RoPE
+// then consumes those BF16 values and the existing BF16 cache, just as the
+// standalone NeoX kernel does.
+template <typename scalar_t>
+class laguna_m8_qk_norm_rope_kernel {
+ public:
+  static constexpr int HEAD_DIM = 128;
+  static constexpr int VEC_SIZE = 8;
+  static constexpr int LANES_PER_HEAD = HEAD_DIM / VEC_SIZE;
+  static constexpr int HEADS_PER_WG = 16;
+  static constexpr int WG_SIZE = HEADS_PER_WG * LANES_PER_HEAD;
+
+  laguna_m8_qk_norm_rope_kernel(
+      scalar_t* __restrict__ q_out_,
+      scalar_t* __restrict__ k_out_,
+      const scalar_t* __restrict__ q_,
+      const scalar_t* __restrict__ k_,
+      const int64_t q_input_stride_,
+      const int64_t k_input_stride_,
+      const int num_q_heads_,
+      const int num_k_heads_,
+      const scalar_t* __restrict__ q_weight_,
+      const scalar_t* __restrict__ k_weight_,
+      const scalar_t* __restrict__ cos_sin_cache_,
+      const int rotary_dim_,
+      const int64_t* __restrict__ position_ids_,
+      const float eps_,
+      sycl::local_accessor<float, 1> s_variance_)
+      : q_out(q_out_),
+        k_out(k_out_),
+        q(q_),
+        k(k_),
+        q_input_stride(q_input_stride_),
+        k_input_stride(k_input_stride_),
+        num_q_heads(num_q_heads_),
+        num_k_heads(num_k_heads_),
+        q_weight(q_weight_),
+        k_weight(k_weight_),
+        cos_sin_cache(cos_sin_cache_),
+        rotary_dim(rotary_dim_),
+        position_ids(position_ids_),
+        eps(eps_),
+        s_variance(s_variance_) {}
+
+  void operator() [[sycl::reqd_sub_group_size(32)]] (
+      const sycl::nd_item<1>& item) const {
+    const int local_id = item.get_local_linear_id();
+    const int head_in_wg = local_id / LANES_PER_HEAD;
+    const int lane_in_head = local_id % LANES_PER_HEAD;
+    const int global_head =
+        item.get_group_linear_id() * HEADS_PER_WG + head_in_wg;
+    const int q_rows = 8 * num_q_heads;
+    const bool is_q = global_head < q_rows;
+    const int typed_head = is_q ? global_head : global_head - q_rows;
+    const int typed_heads = is_q ? num_q_heads : num_k_heads;
+    const int token_idx = typed_head / typed_heads;
+    const int head_idx = typed_head % typed_heads;
+
+    const scalar_t* input = is_q ? q : k;
+    scalar_t* output = is_q ? q_out : k_out;
+    const int64_t input_stride = is_q ? q_input_stride : k_input_stride;
+    const scalar_t* weight = is_q ? q_weight : k_weight;
+    const scalar_t* input_row =
+        input + token_idx * input_stride + head_idx * HEAD_DIM;
+    scalar_t* output_row =
+        output + (token_idx * typed_heads + head_idx) * HEAD_DIM;
+
+    using vec_t = vec_n_t<scalar_t, VEC_SIZE>;
+    const vec_t input_vec =
+        reinterpret_cast<const vec_t*>(input_row)[lane_in_head];
+    float variance = 0.0f;
+#pragma unroll
+    for (int i = 0; i < VEC_SIZE; ++i) {
+      const float x = static_cast<float>(input_vec.val[i]);
+      variance += x * x;
+    }
+
+    auto sg = item.get_sub_group();
+    const int row_lane_offset = sg.get_local_linear_id() % LANES_PER_HEAD;
+    for (int offset = LANES_PER_HEAD / 2; offset > 0; offset >>= 1) {
+      const float other = sycl::shift_group_left(sg, variance, offset);
+      if (row_lane_offset < offset) variance += other;
+    }
+
+    float* s_variance_ptr =
+        s_variance.template get_multi_ptr<sycl::access::decorated::no>().get();
+    if (row_lane_offset == 0) {
+      s_variance_ptr[head_in_wg] =
+          sycl::rsqrt(variance / static_cast<float>(HEAD_DIM) + eps);
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+
+    const vec_t weight_vec =
+        reinterpret_cast<const vec_t*>(weight)[lane_in_head];
+    vec_t normed;
+    const float rrms = s_variance_ptr[head_in_wg];
+#pragma unroll
+    for (int i = 0; i < VEC_SIZE; ++i) {
+      const float x = static_cast<float>(input_vec.val[i]);
+      const scalar_t scaled = static_cast<scalar_t>(x * rrms);
+      normed.val[i] = scaled * weight_vec.val[i];
+    }
+    reinterpret_cast<vec_t*>(output_row)[lane_in_head] = normed;
+
+    // The standalone RoPE launch begins only after both RMSNorm launches have
+    // completed. A global-memory work-group barrier supplies the same visible
+    // BF16 boundary before any lane rereads its normalized pair.
+    item.barrier(sycl::access::fence_space::global_and_local);
+
+    const int embed_dim = rotary_dim / 2;
+    const scalar_t* cache_ptr =
+        cos_sin_cache + position_ids[token_idx] * rotary_dim;
+    const scalar_t* cos_ptr = cache_ptr;
+    const scalar_t* sin_ptr = cache_ptr + embed_dim;
+    for (int rot_offset = lane_in_head; rot_offset < embed_dim;
+         rot_offset += LANES_PER_HEAD) {
+      const int x_index = rot_offset;
+      const int y_index = embed_dim + rot_offset;
+      const scalar_t cos = cos_ptr[x_index];
+      const scalar_t sin = sin_ptr[x_index];
+      const scalar_t x = output_row[x_index];
+      const scalar_t y = output_row[y_index];
+      output_row[x_index] = x * cos - y * sin;
+      output_row[y_index] = y * cos + x * sin;
+    }
+  }
+
+ private:
+  scalar_t* __restrict__ q_out;
+  scalar_t* __restrict__ k_out;
+  const scalar_t* __restrict__ q;
+  const scalar_t* __restrict__ k;
+  const int64_t q_input_stride;
+  const int64_t k_input_stride;
+  const int num_q_heads;
+  const int num_k_heads;
+  const scalar_t* __restrict__ q_weight;
+  const scalar_t* __restrict__ k_weight;
+  const scalar_t* __restrict__ cos_sin_cache;
+  const int rotary_dim;
+  const int64_t* __restrict__ position_ids;
+  const float eps;
+  sycl::local_accessor<float, 1> s_variance;
+};
+
+template <typename scalar_t>
+void launch_laguna_m8_qk_norm_rope(
+    torch::Tensor& q_out,
+    torch::Tensor& k_out,
+    torch::Tensor& q,
+    torch::Tensor& k,
+    torch::Tensor& q_weight,
+    torch::Tensor& k_weight,
+    torch::Tensor& cos_sin_cache,
+    torch::Tensor& position_ids,
+    float eps) {
+  using sycl_t = typename vllm::xpu::SyclTypeTrait<scalar_t>::Type;
+  constexpr int HEADS_PER_WG = 16;
+  constexpr int WG_SIZE = 256;
+  const int num_q_heads = q.size(1) / 128;
+  const int num_k_heads = k.size(1) / 128;
+  const int total_heads = 8 * (num_q_heads + num_k_heads);
+  const int num_groups = total_heads / HEADS_PER_WG;
+
+  auto& queue = vllm::xpu::vllmGetQueue();
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<float, 1> s_variance(
+        sycl::range<1>(HEADS_PER_WG), cgh);
+    cgh.parallel_for(
+        sycl::nd_range<1>(num_groups * WG_SIZE, WG_SIZE),
+        laguna_m8_qk_norm_rope_kernel<sycl_t>(
+            reinterpret_cast<sycl_t*>(q_out.data_ptr<scalar_t>()),
+            reinterpret_cast<sycl_t*>(k_out.data_ptr<scalar_t>()),
+            reinterpret_cast<const sycl_t*>(q.data_ptr<scalar_t>()),
+            reinterpret_cast<const sycl_t*>(k.data_ptr<scalar_t>()),
+            q.stride(0),
+            k.stride(0),
+            num_q_heads,
+            num_k_heads,
+            reinterpret_cast<const sycl_t*>(q_weight.data_ptr<scalar_t>()),
+            reinterpret_cast<const sycl_t*>(k_weight.data_ptr<scalar_t>()),
+            reinterpret_cast<const sycl_t*>(
+                cos_sin_cache.data_ptr<scalar_t>()),
+            cos_sin_cache.size(1),
+            position_ids.data_ptr<int64_t>(),
+            eps,
+            s_variance));
+  });
+}
+
+}  // namespace vllm
+
+void laguna_m8_qk_norm_rope_out(
+    torch::Tensor& q_out,
+    torch::Tensor& k_out,
+    torch::Tensor& q,
+    torch::Tensor& k,
+    torch::Tensor& q_weight,
+    torch::Tensor& k_weight,
+    torch::Tensor& cos_sin_cache,
+    torch::Tensor& position_ids,
+    double eps) {
+  const at::DeviceGuard device_guard(q.device());
+  CHECK_DEVICE(q_out);
+  CHECK_DEVICE(k_out);
+  CHECK_DEVICE(q);
+  CHECK_DEVICE(k);
+  CHECK_DEVICE(q_weight);
+  CHECK_DEVICE(k_weight);
+  CHECK_DEVICE(cos_sin_cache);
+  CHECK_DEVICE(position_ids);
+  CHECK_CONTIGUOUS(q_out);
+  CHECK_CONTIGUOUS(k_out);
+  CHECK_CONTIGUOUS(q_weight);
+  CHECK_CONTIGUOUS(k_weight);
+  CHECK_CONTIGUOUS(cos_sin_cache);
+  CHECK_CONTIGUOUS(position_ids);
+
+  TORCH_CHECK(
+      q.scalar_type() == torch::kBFloat16 &&
+          k.scalar_type() == torch::kBFloat16 &&
+          q_out.scalar_type() == torch::kBFloat16 &&
+          k_out.scalar_type() == torch::kBFloat16 &&
+          q_weight.scalar_type() == torch::kBFloat16 &&
+          k_weight.scalar_type() == torch::kBFloat16 &&
+          cos_sin_cache.scalar_type() == torch::kBFloat16,
+      "Laguna exact QKNorm+RoPE requires BF16 tensors");
+  TORCH_CHECK(
+      position_ids.scalar_type() == torch::kInt64,
+      "Laguna exact QKNorm+RoPE positions must be int64");
+  TORCH_CHECK(
+      q.dim() == 2 && k.dim() == 2 && q_out.dim() == 2 && k_out.dim() == 2,
+      "Laguna exact QKNorm+RoPE tensors must be rank 2");
+  TORCH_CHECK(
+      q.size(0) == 8 && k.size(0) == 8 && q_out.sizes() == q.sizes() &&
+          k_out.sizes() == k.sizes(),
+      "Laguna exact QKNorm+RoPE requires M=8 matching outputs");
+  TORCH_CHECK(
+      q.stride(1) == 1 && k.stride(1) == 1,
+      "Laguna exact QKNorm+RoPE requires contiguous head dimensions");
+  TORCH_CHECK(
+      (q.size(1) == 1536 || q.size(1) == 2304) && k.size(1) == 256,
+      "Laguna exact QKNorm+RoPE supports only TP4 full/sliding QK shapes");
+  TORCH_CHECK(
+      q_weight.numel() == 128 && k_weight.numel() == 128,
+      "Laguna exact QKNorm+RoPE requires head_dim=128 weights");
+  TORCH_CHECK(
+      (cos_sin_cache.size(1) == 64 || cos_sin_cache.size(1) == 128) &&
+          position_ids.numel() == 8,
+      "Laguna exact QKNorm+RoPE requires NeoX rotary_dim 64 or 128");
+  TORCH_CHECK(
+      q.device() == k.device() && q.device() == q_out.device() &&
+          q.device() == k_out.device() && q.device() == q_weight.device() &&
+          q.device() == k_weight.device() &&
+          q.device() == cos_sin_cache.device() &&
+          q.device() == position_ids.device(),
+      "Laguna exact QKNorm+RoPE tensors must share one XPU device");
+
+  vllm::launch_laguna_m8_qk_norm_rope<at::BFloat16>(
+      q_out,
+      k_out,
+      q,
+      k,
+      q_weight,
+      k_weight,
+      cos_sin_cache,
+      position_ids,
+      static_cast<float>(eps));
+}
