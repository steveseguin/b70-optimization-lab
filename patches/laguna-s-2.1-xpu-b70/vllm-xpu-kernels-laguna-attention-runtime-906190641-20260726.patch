+def test_candidate_does_not_change_w1_or_route_parallel_w2_calls():
+    def selected_calls(source: str) -> list[str]:
+        calls = []
+        for node in ast.walk(ast.parse(source)):
+            if not isinstance(node, ast.Call):
+                continue
+            function = ast.unparse(node.func)
+            if function in {
+                "torch.ops._xpu_C.laguna_m8_fused_expert_interface",
+                (
+                    "torch.ops._xpu_C."
+                    "cutlass_grouped_gemm_m8_topk_int4_interface"
+                ),
+            }:
+                calls.append(ast.dump(node, include_attributes=False))
+        return calls
+
+    assert selected_calls(INTERFACE) == selected_calls(BASE_INTERFACE)
+
+
+def test_generic_xpu_fused_moe_entry_and_reference_path_are_unchanged():
+    def selected_methods(source: str) -> dict[str, str]:
+        tree = ast.parse(source)
+        xpu_class = next(
+            node
+            for node in tree.body
+            if isinstance(node, ast.ClassDef) and node.name == "XpuFusedMoe"
+        )
+        return {
+            node.name: ast.dump(node, include_attributes=False)
+            for node in xpu_class.body
+            if isinstance(node, ast.FunctionDef)
+            and node.name in {"apply", "_apply_ref"}
+        }
+
+    assert selected_methods(INTERFACE) == selected_methods(BASE_INTERFACE)
