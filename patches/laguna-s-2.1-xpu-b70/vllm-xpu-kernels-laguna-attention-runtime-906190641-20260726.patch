+void tp4_publish_pair_out(
+    const at::Tensor& local_pair,
+    const at::Tensor& workspace,
+    int64_t rank,
+    int64_t channel,
+    int64_t epoch) {
+  TORCH_CHECK(
+      local_pair.is_xpu() && workspace.is_xpu(),
+      "tp4_publish_pair_out: tensors must be XPU");
+  TORCH_CHECK(
+      local_pair.scalar_type() == at::kFloat && local_pair.is_contiguous() &&
+          local_pair.numel() == 2,
+      "tp4_publish_pair_out: local_pair must be contiguous float32 [2]");
+  TORCH_CHECK(
+      workspace.scalar_type() == at::kByte && workspace.is_contiguous() &&
+          static_cast<size_t>(workspace.numel()) >= kWorkspaceBytes,
+      "tp4_publish_pair_out: workspace is invalid");
+  TORCH_CHECK(rank >= 0 && rank < kWorld, "invalid TP4 rank");
+  TORCH_CHECK(channel >= 0 && channel < kChannels, "invalid TP4 channel");
+  TORCH_CHECK(epoch > 0 && epoch <= INT32_MAX, "invalid TP4 epoch");
+
+  const int slot = static_cast<int>(epoch % kSlots);
+  const size_t payload_offset =
+      (static_cast<size_t>(channel) * kSlots + slot) * kHidden * sizeof(bf16);
+  auto* destination = reinterpret_cast<float*>(
+      static_cast<uint8_t*>(workspace.data_ptr()) + payload_offset);
+  auto& q = vllm::xpu::vllmGetQueue();
+  q.memcpy(destination, local_pair.data_ptr<float>(), 2 * sizeof(float));
+}
