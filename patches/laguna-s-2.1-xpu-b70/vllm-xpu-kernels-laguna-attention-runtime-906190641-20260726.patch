+#!/usr/bin/env python3
+"""Gate oneCCL ring-final-writeback plus DeepSeek MHC-post fusion on TP4."""
+
+from __future__ import annotations
+
+import argparse
+import ctypes
+import json
+import multiprocessing as mp
+import os
+import statistics
+import traceback
+
+
+WORLD = 4
+HIDDEN = 4096
+HC = 4
+DEFAULT_CCL = (
+    "/mnt/usb-models/llm-runtime/oneccl-deepseek-b70/lib/libccl.so.1.0"
+)
+
+
+def _worker(
+    rank: int,
+    conn,
+    init_method: str,
+    iterations: int,
+    library: str,
+    via_op: bool,
+    graph_replay: bool,
+) -> None:
+    try:
+        os.environ["ZE_AFFINITY_MASK"] = str(rank)
+        os.environ["ONEAPI_DEVICE_SELECTOR"] = "level_zero:*"
+
+        import torch
+        import torch.distributed as dist
+        import vllm_xpu_kernels._xpu_C  # noqa: F401
+
+        torch.xpu.set_device(0)
+        ccl = ctypes.CDLL(library, mode=ctypes.RTLD_GLOBAL)
+        fused = None
+        if not via_op:
+            fused = ccl.ccl_b70_replay_last_bf16_allreduce_mhc_post
+            fused.argtypes = [
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_void_p,
+                ctypes.c_size_t,
+                ctypes.c_void_p,
+            ]
+            fused.restype = ctypes.c_int
+
+        dist.init_process_group(
+            "xccl", rank=rank, world_size=WORLD, init_method=init_method
+        )
+        initialization = torch.full(
+            (HIDDEN,), rank + 1, dtype=torch.bfloat16, device="xpu"
+        )
+        dist.all_reduce(initialization)
+        torch.xpu.synchronize()
+
+        conn.send(("ready", rank))
+        if conn.recv() != "go":
+            raise RuntimeError("invalid parent start signal")
+
+        exact = True
+        max_abs = 0.0
+        mismatch_count = 0
+        candidate_us: list[float] = []
+        reference_us: list[float] = []
+        return_codes: set[int] = set()
+        graph_changed = None
+        graph_exact = None
+
+        for epoch in range(1, iterations + 1):
+            base = torch.arange(HIDDEN, dtype=torch.float32, device="xpu")
+            partial = (
+                torch.sin(base * (0.00091 * (rank + 1)) + epoch * 0.017)
+                * (rank + 1.25)
+            ).to(torch.bfloat16)
+            residual = torch.stack(
+                [
+                    torch.cos(base * (0.00037 * (i + 1)) + epoch * 0.011)
+                    .mul_(i + 0.75)
+                    .to(torch.bfloat16)
+                    for i in range(HC)
+                ]
+            )
+            post = torch.tensor(
+                [0.25, -0.5, 0.75, 1.125],
+                dtype=torch.float32,
+                device="xpu",
+            ) + epoch * 0.0001
+            comb = (
+                torch.arange(HC * HC, dtype=torch.float32, device="xpu")
+                .reshape(HC, HC)
+                .mul_(0.017)
+                .sub_(0.11)
+                .add_(epoch * 0.00003)
+            )
+
+            reduced = partial.clone()
+            dist.barrier()
+            torch.xpu.synchronize()
+            start = torch.xpu.Event(enable_timing=True)
+            end = torch.xpu.Event(enable_timing=True)
+            start.record()
+            dist.all_reduce(reduced)
+            reference = torch.ops._xpu_C.mhc_post(
+                reduced.unsqueeze(0),
+                residual.unsqueeze(0),
+                post.reshape(1, HC, 1),
+                comb.unsqueeze(0),
+            ).squeeze(0)
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                reference_us.append(start.elapsed_time(end) * 1000.0)
+
+            candidate = torch.empty_like(residual)
+            dist.barrier()
+            torch.xpu.synchronize()
+            start = torch.xpu.Event(enable_timing=True)
+            end = torch.xpu.Event(enable_timing=True)
+            start.record()
+            if via_op:
+                torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_out(
+                    partial, residual, post, comb, candidate
+                )
+                rc = 0
+            else:
+                assert fused is not None
+                rc = fused(
+                    partial.data_ptr(),
+                    residual.data_ptr(),
+                    post.data_ptr(),
+                    comb.data_ptr(),
+                    candidate.data_ptr(),
+                    HIDDEN,
+                    None,
+                )
+            return_codes.add(rc)
+            end.record()
+            end.synchronize()
+            if epoch > 6:
+                candidate_us.append(start.elapsed_time(end) * 1000.0)
+
+            equal = torch.equal(candidate, reference)
+            exact = exact and equal
+            delta = (candidate.float() - reference.float()).abs()
+            max_abs = max(max_abs, float(delta.max().cpu()))
+            mismatch_count += int((candidate != reference).sum().cpu())
+
+        if graph_replay:
+            if not via_op:
+                raise RuntimeError("--graph-replay requires --via-op")
+            base = torch.arange(HIDDEN, dtype=torch.float32, device="xpu")
+            graph_partial = (
+                torch.sin(base * (0.00113 * (rank + 1)) + 0.37)
+                * (rank + 1.5)
+            ).to(torch.bfloat16)
+            graph_residual = torch.stack(
+                [
+                    torch.cos(base * (0.00029 * (i + 1)) + 0.19)
+                    .mul_(i + 0.5)
+                    .to(torch.bfloat16)
+                    for i in range(HC)
+                ]
+            )
+            graph_post = torch.tensor(
+                [0.125, -0.375, 0.625, 1.25],
+                dtype=torch.float32,
+                device="xpu",
+            )
+            graph_comb = (
+                torch.arange(HC * HC, dtype=torch.float32, device="xpu")
+                .reshape(HC, HC)
+                .mul_(0.013)
+                .sub_(0.09)
+            )
+            graph_out = torch.empty_like(graph_residual)
+
+            # Warm the dispatcher/dlsym cache before capture.
+            torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_out(
+                graph_partial,
+                graph_residual,
+                graph_post,
+                graph_comb,
+                graph_out,
+            )
+            torch.xpu.synchronize()
+            dist.barrier()
+            torch.xpu.synchronize()
+
+            graph = torch.xpu.XPUGraph()
+            try:
+                with torch.xpu.graph(graph):
+                    torch.ops._xpu_C.tp4_oneccl_allreduce_mhc_post_out(
+                        graph_partial,
+                        graph_residual,
+                        graph_post,
+                        graph_comb,
+                        graph_out,
+                    )
+                graph.replay()
+                torch.xpu.synchronize()
+                before = graph_out.clone()
+
+                graph_partial.add_(0.25)
+                graph_residual.add_(0.125)
+                graph_post.add_(0.03125)
+                graph_comb.sub_(0.015625)
+                torch.xpu.synchronize()
+                graph.replay()
+                torch.xpu.synchronize()
+                graph_changed = not torch.equal(before, graph_out)
+
+                reduced = graph_partial.clone()
+                dist.all_reduce(reduced)
+                expected = torch.ops._xpu_C.mhc_post(
+                    reduced.unsqueeze(0),
+                    graph_residual.unsqueeze(0),
+                    graph_post.reshape(1, HC, 1),
+                    graph_comb.unsqueeze(0),
+                ).squeeze(0)
+                torch.xpu.synchronize()
+                graph_exact = torch.equal(graph_out, expected)
+            finally:
+                graph.reset()
+                torch.xpu.synchronize()
+
+        conn.send(
+            {
+                "rank": rank,
+                "exact": exact,
+                "max_abs": max_abs,
+                "mismatch_count": mismatch_count,
+                "return_codes": sorted(return_codes),
+                "graph_changed": graph_changed,
+                "graph_exact": graph_exact,
+                "candidate_us_median": statistics.median(candidate_us),
+                "reference_us_median": statistics.median(reference_us),
+                "candidate_us_min": min(candidate_us),
+                "reference_us_min": min(reference_us),
+            }
+        )
+        dist.destroy_process_group()
+    except BaseException:
+        conn.send({"rank": rank, "error": traceback.format_exc()})
+        raise
+    finally:
+        conn.close()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--iterations", type=int, default=40)
+    parser.add_argument("--library", default=DEFAULT_CCL)
+    parser.add_argument("--via-op", action="store_true")
+    parser.add_argument("--graph-replay", action="store_true")
+    args = parser.parse_args()
+    if args.iterations <= 6:
+        raise SystemExit("--iterations must exceed the six warm-up epochs")
+
+    ctx = mp.get_context("spawn")
+    parent_conns = []
+    children = []
+    port = 30570 + (os.getpid() % 1000)
+    init_method = f"tcp://127.0.0.1:{port}"
+    for rank in range(WORLD):
+        parent_conn, child_conn = ctx.Pipe(duplex=True)
+        proc = ctx.Process(
+            target=_worker,
+            args=(
+                rank,
+                child_conn,
+                init_method,
+                args.iterations,
+                args.library,
+                args.via_op,
+                args.graph_replay,
+            ),
+        )
+        proc.start()
+        child_conn.close()
+        parent_conns.append(parent_conn)
+        children.append(proc)
+
+    try:
+        ready = [conn.recv() for conn in parent_conns]
+        if any(message[0] != "ready" for message in ready):
+            print(json.dumps({"setup": ready}, indent=2))
+            raise SystemExit("worker setup failed")
+        for conn in parent_conns:
+            conn.send("go")
+        results = [conn.recv() for conn in parent_conns]
+        print(
+            json.dumps(
+                {
+                    "iterations": args.iterations,
+                    "library": args.library,
+                    "via_op": args.via_op,
+                    "graph_replay": args.graph_replay,
+                    "ranks": results,
+                },
+                indent=2,
+            )
+        )
+        if any("error" in row for row in results):
+            raise SystemExit("candidate worker failed")
+        if not all(row["exact"] for row in results):
+            raise SystemExit("fused candidate is not bitwise-identical")
+        if not all(row["return_codes"] == [0] for row in results):
+            raise SystemExit("fused hook returned a nonzero status")
+        if args.graph_replay and not all(
+            row["graph_changed"] and row["graph_exact"] for row in results
+        ):
+            raise SystemExit("graph replay changed-input exactness failed")
+    finally:
+        for proc in children:
+            proc.join(timeout=5)
+            if proc.is_alive():
+                proc.terminate()
+                proc.join(timeout=5)
+
+    failed = [proc for proc in children if proc.exitcode != 0]
+    if failed:
+        raise SystemExit(
+            "workers failed: "
+            + ", ".join(f"{proc.pid}:{proc.exitcode}" for proc in failed)
+        )
+
+
+if __name__ == "__main__":
+    main()
