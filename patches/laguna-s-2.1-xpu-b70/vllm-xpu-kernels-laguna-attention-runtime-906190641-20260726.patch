+    pos2 = torch.arange(num_tokens, dtype=torch.int64, device=DEVICE) + 100
+
+    out1 = torch.ops._xpu_C.deepseek_inv_rope_bf16(
+        o, pos1, cos_sin_cache,
+        n_groups, heads_per_group, NOPE_DIM, ROPE_DIM)
