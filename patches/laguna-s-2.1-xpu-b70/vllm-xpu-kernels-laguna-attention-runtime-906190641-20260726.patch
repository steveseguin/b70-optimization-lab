+#!/usr/bin/env python3
+"""Four-process Level Zero IPC binary-event transport probe.
+
+This is a standalone micro-gate, not a normal pytest.  Each process owns one
+physical B70 and one IPC/host-visible event pool.  The parent brokers the pool
+file descriptors through SCM_RIGHTS, following tp4_ipc_allreduce_probe.py.
+
+Every worker builds one regular Level Zero command list containing, for each
+epoch, a device signal of its local event followed by device waits on the four
+rank events.  Rank 3 can intentionally delay submission: completion on ranks
+0-2 must then be delayed too.  This checks the transport needed by a cached
+M7 Markov command list without adding a production op or using oneCCL.
+
+The default uses one-shot events.  It intentionally does not reset/reuse an
+event: safe slot retirement is a separate gate and must not be inferred from
+this test.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ctypes as C
+import ctypes.util
+import json
+import multiprocessing as mp
+import os
+import statistics
+import time
+from multiprocessing.reduction import recv_handle, send_handle
+
+
+WORLD = 4
+ZE_MAX_IPC_HANDLE_SIZE = 64
+
+ZE_RESULT_SUCCESS = 0
+ZE_RESULT_ERROR_UNSUPPORTED_FEATURE = 0x78000003
+ZE_INIT_FLAG_GPU_ONLY = 1
+
+ZE_STRUCTURE_TYPE_COMMAND_QUEUE_GROUP_PROPERTIES = 0x6
+ZE_STRUCTURE_TYPE_CONTEXT_DESC = 0xD
+ZE_STRUCTURE_TYPE_COMMAND_QUEUE_DESC = 0xE
+ZE_STRUCTURE_TYPE_COMMAND_LIST_DESC = 0xF
+ZE_STRUCTURE_TYPE_EVENT_POOL_DESC = 0x10
+ZE_STRUCTURE_TYPE_EVENT_DESC = 0x11
+
+ZE_COMMAND_QUEUE_GROUP_PROPERTY_FLAG_COMPUTE = 1 << 0
+ZE_COMMAND_QUEUE_MODE_ASYNCHRONOUS = 2
+ZE_COMMAND_QUEUE_PRIORITY_NORMAL = 0
+ZE_COMMAND_LIST_FLAG_IN_ORDER = 1 << 3
+
+ZE_EVENT_POOL_FLAG_HOST_VISIBLE = 1 << 0
+ZE_EVENT_POOL_FLAG_IPC = 1 << 1
+ZE_EVENT_SCOPE_FLAG_DEVICE = 1 << 1
+
+
+class ZeContextDesc(C.Structure):
+    _fields_ = [
+        ("stype", C.c_uint32),
+        ("pNext", C.c_void_p),
+        ("flags", C.c_uint32),
+    ]
+
+
+class ZeCommandQueueGroupProperties(C.Structure):
+    _fields_ = [
+        ("stype", C.c_uint32),
+        ("pNext", C.c_void_p),
+        ("flags", C.c_uint32),
+        ("maxMemoryFillPatternSize", C.c_size_t),
+        ("numQueues", C.c_uint32),
+    ]
+
+
+class ZeCommandQueueDesc(C.Structure):
+    _fields_ = [
+        ("stype", C.c_uint32),
+        ("pNext", C.c_void_p),
+        ("ordinal", C.c_uint32),
+        ("index", C.c_uint32),
+        ("flags", C.c_uint32),
+        ("mode", C.c_uint32),
+        ("priority", C.c_uint32),
+    ]
+
+
+class ZeCommandListDesc(C.Structure):
+    _fields_ = [
+        ("stype", C.c_uint32),
+        ("pNext", C.c_void_p),
+        ("commandQueueGroupOrdinal", C.c_uint32),
+        ("flags", C.c_uint32),
+    ]
+
+
+class ZeEventPoolDesc(C.Structure):
+    _fields_ = [
+        ("stype", C.c_uint32),
+        ("pNext", C.c_void_p),
+        ("flags", C.c_uint32),
+        ("count", C.c_uint32),
+    ]
+
+
+class ZeEventDesc(C.Structure):
+    _fields_ = [
+        ("stype", C.c_uint32),
+        ("pNext", C.c_void_p),
+        ("index", C.c_uint32),
+        ("signal", C.c_uint32),
+        ("wait", C.c_uint32),
+    ]
+
+
+class ZeIpcEventPoolHandle(C.Structure):
+    _fields_ = [("data", C.c_ubyte * ZE_MAX_IPC_HANDLE_SIZE)]
+
+
+def _load_level_zero():
+    path = ctypes.util.find_library("ze_loader") or "libze_loader.so.1"
+    ze = C.CDLL(path)
+
+    handle_p = C.POINTER(C.c_void_p)
+    ze.zeInit.argtypes = [C.c_uint32]
+    ze.zeInit.restype = C.c_uint32
+    ze.zeDriverGet.argtypes = [C.POINTER(C.c_uint32), handle_p]
+    ze.zeDriverGet.restype = C.c_uint32
+    ze.zeDeviceGet.argtypes = [C.c_void_p, C.POINTER(C.c_uint32), handle_p]
+    ze.zeDeviceGet.restype = C.c_uint32
+    ze.zeDeviceGetCommandQueueGroupProperties.argtypes = [
+        C.c_void_p,
+        C.POINTER(C.c_uint32),
+        C.POINTER(ZeCommandQueueGroupProperties),
+    ]
+    ze.zeDeviceGetCommandQueueGroupProperties.restype = C.c_uint32
+
+    ze.zeContextCreate.argtypes = [
+        C.c_void_p,
+        C.POINTER(ZeContextDesc),
+        handle_p,
+    ]
+    ze.zeContextCreate.restype = C.c_uint32
+    ze.zeContextDestroy.argtypes = [C.c_void_p]
+    ze.zeContextDestroy.restype = C.c_uint32
+
+    ze.zeCommandQueueCreate.argtypes = [
+        C.c_void_p,
+        C.c_void_p,
+        C.POINTER(ZeCommandQueueDesc),
+        handle_p,
+    ]
+    ze.zeCommandQueueCreate.restype = C.c_uint32
+    ze.zeCommandQueueExecuteCommandLists.argtypes = [
+        C.c_void_p,
+        C.c_uint32,
+        handle_p,
+        C.c_void_p,
+    ]
+    ze.zeCommandQueueExecuteCommandLists.restype = C.c_uint32
+    ze.zeCommandQueueSynchronize.argtypes = [C.c_void_p, C.c_uint64]
+    ze.zeCommandQueueSynchronize.restype = C.c_uint32
+    ze.zeCommandQueueDestroy.argtypes = [C.c_void_p]
+    ze.zeCommandQueueDestroy.restype = C.c_uint32
+
+    ze.zeCommandListCreate.argtypes = [
+        C.c_void_p,
+        C.c_void_p,
+        C.POINTER(ZeCommandListDesc),
+        handle_p,
+    ]
+    ze.zeCommandListCreate.restype = C.c_uint32
+    ze.zeCommandListAppendSignalEvent.argtypes = [C.c_void_p, C.c_void_p]
+    ze.zeCommandListAppendSignalEvent.restype = C.c_uint32
+    ze.zeCommandListAppendWaitOnEvents.argtypes = [
+        C.c_void_p,
+        C.c_uint32,
+        handle_p,
+    ]
+    ze.zeCommandListAppendWaitOnEvents.restype = C.c_uint32
+    ze.zeCommandListClose.argtypes = [C.c_void_p]
+    ze.zeCommandListClose.restype = C.c_uint32
+    ze.zeCommandListDestroy.argtypes = [C.c_void_p]
+    ze.zeCommandListDestroy.restype = C.c_uint32
+
+    ze.zeEventPoolCreate.argtypes = [
+        C.c_void_p,
+        C.POINTER(ZeEventPoolDesc),
+        C.c_uint32,
+        handle_p,
+        handle_p,
+    ]
+    ze.zeEventPoolCreate.restype = C.c_uint32
+    ze.zeEventPoolDestroy.argtypes = [C.c_void_p]
+    ze.zeEventPoolDestroy.restype = C.c_uint32
+    ze.zeEventPoolGetIpcHandle.argtypes = [
+        C.c_void_p,
+        C.POINTER(ZeIpcEventPoolHandle),
+    ]
+    ze.zeEventPoolGetIpcHandle.restype = C.c_uint32
+    ze.zeEventPoolPutIpcHandle.argtypes = [C.c_void_p, ZeIpcEventPoolHandle]
+    ze.zeEventPoolPutIpcHandle.restype = C.c_uint32
+    ze.zeEventPoolOpenIpcHandle.argtypes = [
+        C.c_void_p,
+        ZeIpcEventPoolHandle,
+        handle_p,
+    ]
+    ze.zeEventPoolOpenIpcHandle.restype = C.c_uint32
+    ze.zeEventPoolCloseIpcHandle.argtypes = [C.c_void_p]
+    ze.zeEventPoolCloseIpcHandle.restype = C.c_uint32
+
+    ze.zeEventCreate.argtypes = [
+        C.c_void_p,
+        C.POINTER(ZeEventDesc),
+        handle_p,
+    ]
+    ze.zeEventCreate.restype = C.c_uint32
+    ze.zeEventQueryStatus.argtypes = [C.c_void_p]
+    ze.zeEventQueryStatus.restype = C.c_uint32
+    ze.zeEventDestroy.argtypes = [C.c_void_p]
+    ze.zeEventDestroy.restype = C.c_uint32
+    return ze, path
+
+
+def _check(result: int, what: str) -> None:
+    if result != ZE_RESULT_SUCCESS:
+        raise RuntimeError(
+            f"{what} failed with Level Zero result 0x{result:08x}"
+        )
+
+
+def _enumerate_handles(getter, owner=None) -> list[int]:
+    count = C.c_uint32()
+    if owner is None:
+        _check(getter(C.byref(count), None), getter.__name__)
+    else:
+        _check(getter(owner, C.byref(count), None), getter.__name__)
+    handles = (C.c_void_p * count.value)()
+    if owner is None:
+        _check(getter(C.byref(count), handles), getter.__name__)
+    else:
+        _check(getter(owner, C.byref(count), handles), getter.__name__)
+    return [int(handle) for handle in handles]
+
+
+def _compute_ordinal(ze, device: int) -> int:
+    count = C.c_uint32()
+    _check(
+        ze.zeDeviceGetCommandQueueGroupProperties(
+            device, C.byref(count), None
+        ),
+        "zeDeviceGetCommandQueueGroupProperties(count)",
+    )
+    props = (ZeCommandQueueGroupProperties * count.value)()
+    for prop in props:
+        prop.stype = ZE_STRUCTURE_TYPE_COMMAND_QUEUE_GROUP_PROPERTIES
+    _check(
+        ze.zeDeviceGetCommandQueueGroupProperties(
+            device, C.byref(count), props
+        ),
+        "zeDeviceGetCommandQueueGroupProperties(data)",
+    )
+    for ordinal, prop in enumerate(props):
+        if (
+            prop.flags & ZE_COMMAND_QUEUE_GROUP_PROPERTY_FLAG_COMPUTE
+            and prop.numQueues > 0
+        ):
+            return ordinal
+    raise RuntimeError("device has no compute command queue group")
+
+
+def _event_from_pool(ze, pool: int, index: int) -> int:
+    desc = ZeEventDesc(
+        stype=ZE_STRUCTURE_TYPE_EVENT_DESC,
+        pNext=None,
+        index=index,
+        signal=ZE_EVENT_SCOPE_FLAG_DEVICE,
+        wait=ZE_EVENT_SCOPE_FLAG_DEVICE,
+    )
+    event = C.c_void_p()
+    _check(
+        ze.zeEventCreate(pool, C.byref(desc), C.byref(event)),
+        "zeEventCreate",
+    )
+    return int(event.value)
+
+
+def _handle_with_fd(fd: int, exported_bytes: bytes) -> ZeIpcEventPoolHandle:
+    # Preserve the driver's opaque event-pool metadata, but replace its
+    # process-local descriptor with the SCM_RIGHTS duplicate.  Current oneCCL
+    # can reconstruct some IPC handles from an otherwise zero blob; using the
+    # exported bytes is the general Level Zero contract and is required by the
+    # B70 event-pool handle returned by this driver.
+    if len(exported_bytes) != ZE_MAX_IPC_HANDLE_SIZE:
+        raise RuntimeError("invalid exported IPC event-pool handle size")
+    handle = ZeIpcEventPoolHandle()
+    C.memmove(C.byref(handle), exported_bytes, ZE_MAX_IPC_HANDLE_SIZE)
+    C.cast(C.byref(handle), C.POINTER(C.c_int)).contents.value = fd
+    return handle
+
+
+def _worker(
+    rank: int,
+    conn,
+    iterations: int,
+    stagger_rank: int,
+    stagger_ms: float,
+    timeout_ms: int,
+) -> None:
+    # Direct Level Zero enumeration is used so rank maps unambiguously to the
+    # four physical devices; no PyTorch/oneCCL context is involved.
+    os.environ["ZE_ENABLE_PCI_ID_DEVICE_ORDER"] = "1"
+    ze, loader_path = _load_level_zero()
+    _check(ze.zeInit(ZE_INIT_FLAG_GPU_ONLY), "zeInit")
+    drivers = _enumerate_handles(ze.zeDriverGet)
+    if not drivers:
+        raise RuntimeError("no Level Zero drivers")
+    devices = _enumerate_handles(ze.zeDeviceGet, drivers[0])
+    if len(devices) < WORLD:
+        raise RuntimeError(
+            f"need {WORLD} Level Zero devices, found {len(devices)}"
+        )
+    device = devices[rank]
+    ordinal = _compute_ordinal(ze, device)
+
+    context_desc = ZeContextDesc(
+        stype=ZE_STRUCTURE_TYPE_CONTEXT_DESC, pNext=None, flags=0
+    )
+    context = C.c_void_p()
+    _check(
+        ze.zeContextCreate(drivers[0], C.byref(context_desc), C.byref(context)),
+        "zeContextCreate",
+    )
+
+    pool_desc = ZeEventPoolDesc(
+        stype=ZE_STRUCTURE_TYPE_EVENT_POOL_DESC,
+        pNext=None,
+        flags=ZE_EVENT_POOL_FLAG_HOST_VISIBLE | ZE_EVENT_POOL_FLAG_IPC,
+        count=iterations,
+    )
+    local_pool = C.c_void_p()
+    # Match oneCCL's working IPC-event-pool creation exactly: make the pool
+    # visible to every device in the Level Zero driver context.  Restricting
+    # this pool to the exporting device makes OpenIpcHandle fail on a peer B70.
+    _check(
+        ze.zeEventPoolCreate(
+            context,
+            C.byref(pool_desc),
+            0,
+            None,
+            C.byref(local_pool),
+        ),
+        "zeEventPoolCreate",
+    )
+    export_handle = ZeIpcEventPoolHandle()
+    _check(
+        ze.zeEventPoolGetIpcHandle(local_pool, C.byref(export_handle)),
+        "zeEventPoolGetIpcHandle",
+    )
+    export_fd = C.cast(
+        C.byref(export_handle), C.POINTER(C.c_int)
+    ).contents.value
+    if export_fd < 0:
+        raise RuntimeError(f"invalid exported event-pool fd {export_fd}")
+    conn.send((rank, os.getpid(), bytes(export_handle.data)))
+    send_handle(conn, export_fd, os.getppid())
+
+    peer_metadata = conn.recv()
+    pools: dict[int, int] = {rank: int(local_pool.value)}
+    imported_pools: list[int] = []
+    peer_fds: list[int] = []
+    for peer_rank, peer_handle_bytes in peer_metadata:
+        peer_fd = recv_handle(conn)
+        peer_fds.append(peer_fd)
+        imported_pool = C.c_void_p()
+        _check(
+            ze.zeEventPoolOpenIpcHandle(
+                context,
+                _handle_with_fd(peer_fd, peer_handle_bytes),
+                C.byref(imported_pool),
+            ),
+            f"zeEventPoolOpenIpcHandle(rank={peer_rank})",
+        )
+        pools[peer_rank] = int(imported_pool.value)
+        imported_pools.append(int(imported_pool.value))
+
+    events: dict[int, list[int]] = {
+        owner: [
+            _event_from_pool(ze, pools[owner], epoch)
+            for epoch in range(iterations)
+        ]
+        for owner in range(WORLD)
+    }
+
+    queue_desc = ZeCommandQueueDesc(
+        stype=ZE_STRUCTURE_TYPE_COMMAND_QUEUE_DESC,
+        pNext=None,
+        ordinal=ordinal,
+        index=0,
+        flags=0,
+        mode=ZE_COMMAND_QUEUE_MODE_ASYNCHRONOUS,
+        priority=ZE_COMMAND_QUEUE_PRIORITY_NORMAL,
+    )
+    queue = C.c_void_p()
+    _check(
+        ze.zeCommandQueueCreate(
+            context, device, C.byref(queue_desc), C.byref(queue)
+        ),
+        "zeCommandQueueCreate",
+    )
+    list_desc = ZeCommandListDesc(
+        stype=ZE_STRUCTURE_TYPE_COMMAND_LIST_DESC,
+        pNext=None,
+        commandQueueGroupOrdinal=ordinal,
+        flags=ZE_COMMAND_LIST_FLAG_IN_ORDER,
+    )
+    command_list = C.c_void_p()
+    _check(
+        ze.zeCommandListCreate(
+            context, device, C.byref(list_desc), C.byref(command_list)
+        ),
+        "zeCommandListCreate",
+    )
+    for epoch in range(iterations):
+        _check(
+            ze.zeCommandListAppendSignalEvent(
+                command_list, events[rank][epoch]
+            ),
+            f"zeCommandListAppendSignalEvent(epoch={epoch})",
+        )
+        wait_events = (C.c_void_p * WORLD)(
+            *(events[owner][epoch] for owner in range(WORLD))
+        )
+        _check(
+            ze.zeCommandListAppendWaitOnEvents(
+                command_list, WORLD, wait_events
+            ),
+            f"zeCommandListAppendWaitOnEvents(epoch={epoch})",
+        )
+    _check(ze.zeCommandListClose(command_list), "zeCommandListClose")
+
+    conn.send(("ready", rank))
+    if conn.recv() != "go":
+        raise RuntimeError("unexpected parent command")
+    start = time.perf_counter()
+    if rank == stagger_rank and stagger_ms > 0:
+        time.sleep(stagger_ms / 1000.0)
+    command_lists = (C.c_void_p * 1)(int(command_list.value))
+    _check(
+        ze.zeCommandQueueExecuteCommandLists(queue, 1, command_lists, None),
+        "zeCommandQueueExecuteCommandLists",
+    )
+    _check(
+        ze.zeCommandQueueSynchronize(queue, timeout_ms * 1_000_000),
+        "zeCommandQueueSynchronize",
+    )
+    elapsed_ms = (time.perf_counter() - start) * 1000.0
+
+    unsignaled = []
+    for owner in range(WORLD):
+        for epoch, event in enumerate(events[owner]):
+            status = ze.zeEventQueryStatus(event)
+            if status != ZE_RESULT_SUCCESS:
+                unsignaled.append(
+                    {"owner": owner, "epoch": epoch, "status": status}
+                )
+    conn.send(
+        {
+            "rank": rank,
+            "loader": loader_path,
+            "enumerated_devices": len(devices),
+            "compute_ordinal": ordinal,
+            "iterations": iterations,
+            "elapsed_ms": elapsed_ms,
+            "queried_events": WORLD * iterations,
+            "unsignaled": unsignaled,
+        }
+    )
+
+    # Do not let an early-finishing rank retire its exported pool while another
+    # device may still reference it.
+    if conn.recv() != "cleanup":
+        raise RuntimeError("unexpected cleanup command")
+
+    _check(ze.zeCommandListDestroy(command_list), "zeCommandListDestroy")
+    _check(ze.zeCommandQueueDestroy(queue), "zeCommandQueueDestroy")
+    for owner_events in events.values():
+        for event in owner_events:
+            _check(ze.zeEventDestroy(event), "zeEventDestroy")
+    for pool in imported_pools:
+        _check(ze.zeEventPoolCloseIpcHandle(pool), "zeEventPoolCloseIpcHandle")
+    # This loader exports the newer PutIpcHandle entry point, while the B70
+    # driver reports UNSUPPORTED_FEATURE.  That is the legacy contract used by
+    # the installed oneCCL too: destroying the exporting pool retires it.
+    put_result = ze.zeEventPoolPutIpcHandle(context, export_handle)
+    if put_result not in (
+        ZE_RESULT_SUCCESS,
+        ZE_RESULT_ERROR_UNSUPPORTED_FEATURE,
+    ):
+        _check(put_result, "zeEventPoolPutIpcHandle")
+    _check(ze.zeEventPoolDestroy(local_pool), "zeEventPoolDestroy")
+    _check(ze.zeContextDestroy(context), "zeContextDestroy")
+    for peer_fd in peer_fds:
+        # Current B70 Level Zero closes the brokered descriptor as part of
+        # EventPoolCloseIpcHandle.  Tolerate that ownership transfer while
+        # still closing it ourselves on implementations that retain the fd.
+        try:
+            os.close(peer_fd)
+        except OSError as error:
+            if error.errno != 9:  # EBADF: already consumed by Level Zero.
+                raise
+    conn.close()
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--iterations", type=int, default=80)
+    parser.add_argument("--stagger-rank", type=int, default=3)
+    parser.add_argument("--stagger-ms", type=float, default=200.0)
+    parser.add_argument("--timeout-ms", type=int, default=10_000)
+    args = parser.parse_args()
+    if args.iterations <= 0:
+        parser.error("--iterations must be positive")
+    if not 0 <= args.stagger_rank < WORLD:
+        parser.error(f"--stagger-rank must be in [0, {WORLD})")
+
+    ctx = mp.get_context("spawn")
+    parent_conns = []
+    children = []
+    for rank in range(WORLD):
+        parent_conn, child_conn = ctx.Pipe(duplex=True)
+        proc = ctx.Process(
+            target=_worker,
+            args=(
+                rank,
+                child_conn,
+                args.iterations,
+                args.stagger_rank,
+                args.stagger_ms,
+                args.timeout_ms,
+            ),
+        )
+        proc.start()
+        child_conn.close()
+        parent_conns.append(parent_conn)
+        children.append(proc)
+
+    exports = []
+    for conn in parent_conns:
+        rank, child_pid, handle_bytes = conn.recv()
+        fd = recv_handle(conn)
+        exports.append((rank, child_pid, fd, handle_bytes))
+
+    for destination_rank, conn in enumerate(parent_conns):
+        peer_metadata = [
+            (rank, handle_bytes)
+            for rank, _, _, handle_bytes in exports
+            if rank != destination_rank
+        ]
+        conn.send(peer_metadata)
+        destination_pid = exports[destination_rank][1]
+        for rank, _, fd, _ in exports:
+            if rank != destination_rank:
+                send_handle(conn, fd, destination_pid)
+    for _, _, fd, _ in exports:
+        os.close(fd)
+
+    for conn in parent_conns:
+        message = conn.recv()
+        if message[0] != "ready":
+            raise RuntimeError(f"unexpected worker message {message!r}")
+    for conn in parent_conns:
+        conn.send("go")
+
+    results = [conn.recv() for conn in parent_conns]
+    transport_ok = all(not row["unsignaled"] for row in results)
+    waiters = [
+        row["elapsed_ms"]
+        for row in results
+        if row["rank"] != args.stagger_rank
+    ]
+    # Use half the requested stagger as a deliberately loose process-jitter
+    # threshold.  Event status is the correctness criterion; this timing check
+    # proves non-staggered queue completion was coupled to the delayed signal.
+    stagger_observed = (
+        args.stagger_ms <= 0
+        or min(waiters) >= args.stagger_ms * 0.5
+    )
+    summary = {
+        "transport_ok": transport_ok,
+        "stagger_observed": stagger_observed,
+        "one_shot_events": True,
+        "iterations": args.iterations,
+        "stagger_rank": args.stagger_rank,
+        "stagger_ms": args.stagger_ms,
+        "non_staggered_elapsed_ms_min": min(waiters),
+        "non_staggered_elapsed_ms_median": statistics.median(waiters),
+        "ranks": sorted(results, key=lambda row: row["rank"]),
+    }
+    print(json.dumps(summary, indent=2), flush=True)
+
+    for conn in parent_conns:
+        conn.send("cleanup")
+    for proc in children:
+        proc.join(timeout=15)
+        if proc.exitcode != 0:
+            raise SystemExit(f"worker {proc.pid} exited {proc.exitcode}")
+    if not transport_ok:
+        raise SystemExit("one or more imported events remained unsignaled")
+    if not stagger_observed:
+        raise SystemExit(
+            "non-staggered queues did not observe the delayed rank"
+        )
+
+
+if __name__ == "__main__":
+    main()
