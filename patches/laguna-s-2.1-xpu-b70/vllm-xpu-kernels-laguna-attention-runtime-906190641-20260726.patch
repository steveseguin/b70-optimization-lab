+inline LagunaM8GatherFinalizeValues laguna_m8_gather_finalize_arithmetic(
+    const float accum, const LagunaM8BFloat16 shared_bf16) {
+  const LagunaM8BFloat16 routed_bf16 = static_cast<LagunaM8BFloat16>(accum);
+  const LagunaM8BFloat16 scaled_bf16 =
+      static_cast<LagunaM8BFloat16>(static_cast<float>(routed_bf16) * 2.5f);
+  const LagunaM8BFloat16 final_bf16 = static_cast<LagunaM8BFloat16>(
+      static_cast<float>(shared_bf16) + static_cast<float>(scaled_bf16));
+  return {routed_bf16, scaled_bf16, final_bf16};
