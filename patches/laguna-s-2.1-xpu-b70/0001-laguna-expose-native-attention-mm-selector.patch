From f306c0027ab46f1a84a4f328ffe3e843ccd2db0a Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Fri, 7 Aug 2026 09:55:03 -0400
Subject: [PATCH] laguna: expose the native-MM attention selector to the runner

`VLLM_XPU_LAGUNA_M8_BF16_ATTN_MM` was pinned to 0 with no way to raise it, which
was reasonable while the selector could not fire: its width gate was gated to 8
and this campaign runs a width-12 verifier. Now that the gate tracks the
configured exact width, the selector controls 96 stride-zero BMMs per decode
step and needs to be reachable to be measured. Default stays 0.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 .../tools/run_laguna_long_context_baseline.sh                   | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/experiments/laguna-s-2.1-xpu-b70/tools/run_laguna_long_context_baseline.sh b/experiments/laguna-s-2.1-xpu-b70/tools/run_laguna_long_context_baseline.sh
index 82272ccfb..519e44a9c 100755
--- a/experiments/laguna-s-2.1-xpu-b70/tools/run_laguna_long_context_baseline.sh
+++ b/experiments/laguna-s-2.1-xpu-b70/tools/run_laguna_long_context_baseline.sh
@@ -459,7 +459,7 @@ if [[ "$role" == candidate ]]; then
     VLLM_XPU_LAGUNA_M8_CAPTURE_ATTENTION_GRAPHS=0
     VLLM_XPU_LAGUNA_M8_INLINE_ATTENTION_GRAPHS="${LAGUNA_INLINE_ATTN:-0}"
     VLLM_XPU_LAGUNA_M8_INLINE_GATHERS=0
-    VLLM_XPU_LAGUNA_M8_BF16_ATTN_MM=0
+    VLLM_XPU_LAGUNA_M8_BF16_ATTN_MM="${LAGUNA_ATTN_MM:-0}"
     VLLM_XPU_LAGUNA_M8_W1_N_TILE=64
     VLLM_XPU_LAGUNA_M12_ATTENTION_GATE=0
     VLLM_XPU_LAGUNA_REPLICATED_EMBEDDING=0
