 .../grouped_gemm/xe_2/grouped_gemm_xe2.hpp    |  16 +--
 .../xe_2/grouped_gemm_xe2_interface.hpp       | 101 +++++++++++++++---
 4 files changed, 99 insertions(+), 29 deletions(-)

diff --git a/cmake/utils.cmake b/cmake/utils.cmake
index ba4bb67..cd93116 100644
--- a/cmake/utils.cmake
+++ b/cmake/utils.cmake
@@ -549,7 +549,7 @@ endfunction()
 #
 function(add_xe2_kernel_library LIBRARY_NAME)
   cmake_parse_arguments(
-    PARSE_ARGV 1 ARG "INCLUDE_CMAKE_SOURCE_DIR" # Boolean options
+    PARSE_ARGV 1 ARG "AUTO_GRF;INCLUDE_CMAKE_SOURCE_DIR" # Boolean options
     "DESTINATION" # Single value keywords
     "" # Multi-value keywords
   )
@@ -602,10 +602,15 @@ function(add_xe2_kernel_library LIBRARY_NAME)
   # Set link options for XE2 devices
   set(XE2_GPU_LINK_FLAGS ${SYCL_DEVICE_LINK_FLAGS})
   if(XE2_AOT_DEVICES)
+    if(ARG_AUTO_GRF)
+      set(XE2_GRF_OPTION "-cl-intel-enable-auto-large-GRF-mode")
+    else()
+      set(XE2_GRF_OPTION "-cl-intel-256-GRF-per-thread")
+    endif()
     list(
       APPEND
       XE2_GPU_LINK_FLAGS
-      "-device ${XE2_AOT_DEVICES} -internal_options -cl-intel-256-GRF-per-thread"
+      "-device ${XE2_AOT_DEVICES} -internal_options ${XE2_GRF_OPTION}"
     )
   endif()
   target_link_options(${LIBRARY_NAME} PRIVATE ${XE2_GPU_LINK_FLAGS})
