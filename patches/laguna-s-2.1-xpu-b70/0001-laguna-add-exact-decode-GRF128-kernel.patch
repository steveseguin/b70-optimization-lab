+++ b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp
@@ -74,6 +74,9 @@ using namespace cute;
 template <typename, typename, typename, typename, char, char, class, bool>
 class GemmCuteName;
 
+template <typename, typename, typename, typename, char, char, class, bool>
+class GemmCuteGrf128Name;
+
 template <typename, class, bool>
 class GemmM1TopkCuteName;
 
@@ -203,7 +206,13 @@ inline bool laguna_int4_dequant_mad() {
     const char* value = std::getenv("VLLM_XPU_LAGUNA_DEQUANT_MAD");
     if (value == nullptr) return false;
     if (std::strcmp(value, "0") == 0) return false;
-    if (std::strcmp(value, "1") == 0) return true;
+    if (std::strcmp(value, "1") == 0) {
+      TORCH_CHECK(
+          laguna_int4_scale_vec(),
+          "VLLM_XPU_LAGUNA_DEQUANT_MAD=1 requires "
