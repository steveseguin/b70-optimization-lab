+      return true;
+    }
     TORCH_CHECK(
         false,
         "VLLM_XPU_LAGUNA_DEQUANT_MAD must be literal 0 or 1, got '",
@@ -214,6 +223,25 @@ inline bool laguna_int4_dequant_mad() {
   return mad;
 }
 
+// Select a separately named 128-GRF generic decode kernel. The host dispatch
+// below further constrains this to the exact BF16 group-32 width-12 route;
+// every non-qualifying call retains the historical 256-GRF kernel.
+inline bool laguna_int4_decode_grf128() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("VLLM_XPU_LAGUNA_DECODE_GRF128");
+    if (value == nullptr) return false;
+    if (std::strcmp(value, "0") == 0) return false;
+    if (std::strcmp(value, "1") == 0) return true;
+    TORCH_CHECK(
+        false,
+        "VLLM_XPU_LAGUNA_DECODE_GRF128 must be literal 0 or 1, got '",
+        value,
+        "'");
+    return false;
+  }();
+  return enabled;
+}
+
 // Range gate for the INT4 dequantize-scale fusion.
 //
 // The fused form evaluates `x * s + (-136 * s)` where the incumbent evaluates
@@ -299,6 +327,7 @@ void MoEGEMMLauncher(
     ElementD* outputs,
     const int gemm_n,
     const int gemm_k,
+    const int total_m,
     const int* rows_per_expert,
     const int num_experts,
     const int group_size,
@@ -335,25 +364,26 @@ void MoEGEMMLauncher(
   namespace syclex = sycl::ext::oneapi::experimental;
   namespace intelex = sycl::ext::intel::experimental;
 
-  syclex::properties kernel_props{
+  syclex::properties kernel_props_256{
       syclex::sub_group_size<16>, intelex::grf_size<256>};
 
+  constexpr bool can_use_grf128 =
+      layoutA == 'R' && layoutB == 'C' && !TileMajor &&
+      std::is_same_v<ElementA_non_CV, bfloat16_t> &&
+      std::is_same_v<ElementB, uint8_t> &&
+      std::is_same_v<ElementS, bfloat16_t> &&
+      std::is_same_v<policy, w4a16_policy_m_8>;
+  const bool use_grf128 =
+      can_use_grf128 && laguna_int4_decode_grf128() && total_m == 120 &&
+      group_size == 32 && scale_vec && !scale_mad && !scale_fold;
+
   using GmemTiledCopyA = typename policy::GmemTiledCopyA;
   using GmemTiledCopyB = typename policy::GmemTiledCopyB;
   using GmemTiledCopyD = typename policy::GmemTiledCopyD;
 
   stream.submit([&](sycl::handler& cgh) {
     sycl::local_accessor<int32_t, 1> local_mem(sycl::range<1>(1), cgh);
-    cgh.parallel_for<GemmCuteName<
-        ElementA,
-        ElementB,
-        ElementS,
-        ElementD,
-        layoutA,
-        layoutB,
-        policy,
-        TileMajor>>(
-        sycl::nd_range<3>{global * local, local}, kernel_props, [=](auto) {
+    auto kernel = [=](auto) {
           MoE::MoEGEMM<
               GmemTiledCopyA,
               GmemTiledCopyB,
@@ -378,7 +408,51 @@ void MoEGEMMLauncher(
               scale_fold,
               scale_vec,
               scale_mad);
-        });
+        };
+    if constexpr (can_use_grf128) {
+      if (use_grf128) {
+        syclex::properties kernel_props_128{
+            syclex::sub_group_size<16>, intelex::grf_size<128>};
+        cgh.parallel_for<GemmCuteGrf128Name<
+            ElementA,
+            ElementB,
+            ElementS,
+            ElementD,
+            layoutA,
+            layoutB,
+            policy,
+            TileMajor>>(
+            sycl::nd_range<3>{global * local, local},
+            kernel_props_128,
+            kernel);
+      } else {
+        cgh.parallel_for<GemmCuteName<
+            ElementA,
+            ElementB,
+            ElementS,
+            ElementD,
+            layoutA,
+            layoutB,
+            policy,
+            TileMajor>>(
+            sycl::nd_range<3>{global * local, local},
+            kernel_props_256,
+            kernel);
+      }
+    } else {
+      cgh.parallel_for<GemmCuteName<
+          ElementA,
+          ElementB,
+          ElementS,
+          ElementD,
+          layoutA,
+          layoutB,
+          policy,
+          TileMajor>>(
+          sycl::nd_range<3>{global * local, local},
+          kernel_props_256,
+          kernel);
+    }
   });
 }
 
