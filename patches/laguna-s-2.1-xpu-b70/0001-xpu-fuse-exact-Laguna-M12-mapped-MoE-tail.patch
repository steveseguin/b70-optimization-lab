diff --git a/csrc/moe/moe_gather.cpp b/csrc/moe/moe_gather.cpp
index 3425c3c..8a349a2 100644
--- a/csrc/moe/moe_gather.cpp
+++ b/csrc/moe/moe_gather.cpp
@@ -421,6 +421,88 @@ class MoeGatherM2Direct {
   const int hidden_size;
 };
 
+// Exact M12 counterpart for the current expert-grouped decode path. Unlike
+// the older canonical-row M8 specialization, this kernel consumes the same
+// permutation map as MoeGather and therefore preserves its -1 skip and fixed
+// slot traversal before using the audited three-BF16-boundary helper above.
+class LagunaM12MappedGatherScaleAdd {
+ public:
+  static constexpr int NumTokens = 12;
+  static constexpr int TopK = 10;
+  static constexpr int HiddenSize = 3072;
+  static constexpr int GroupWorkItem = 256;
+  static constexpr int WARP_SIZE = 32;
+  static constexpr int ElemsPerItem = 8;
+  static constexpr int Stride = GroupWorkItem * ElemsPerItem;
+
+  LagunaM12MappedGatherScaleAdd(
+      LagunaM8BFloat16* output,
+      const LagunaM8BFloat16* moe_output,
+      const float* topk_weights,
+      const int* unpermuted_row_to_permuted_row,
+      const LagunaM8BFloat16* shared)
+      : output(output),
+        moe_output(moe_output),
+        topk_weights(topk_weights),
+        unpermuted_row_to_permuted_row(unpermuted_row_to_permuted_row),
+        shared(shared) {}
+
+  static inline sycl::nd_range<1> get_nd_range() {
+    sycl::range<1> local(GroupWorkItem);
+    sycl::range<1> group(NumTokens);
+    return sycl::nd_range<1>(local * group, local);
+  }
+
+  void operator()
+      [[sycl::reqd_sub_group_size(WARP_SIZE)]] (sycl::nd_item<1> item) const {
+    const int token_idx = item.get_group(0);
+    const int local_id_x = item.get_local_id(0);
+
+    int moe_ids[TopK];
+    float scores[TopK];
+#pragma unroll
+    for (int i = 0; i < TopK; ++i) {
+      const int slot = token_idx * TopK + i;
+      moe_ids[i] = unpermuted_row_to_permuted_row[slot];
+      scores[i] = topk_weights[slot];
+    }
+
+    constexpr int LoopCount = (HiddenSize + Stride - 1) / Stride;
+#pragma unroll
+    for (int i = 0; i < LoopCount; ++i) {
+      const int hidden_idx = i * Stride + local_id_x * ElemsPerItem;
+      if (hidden_idx < HiddenSize) {
+        float accum[ElemsPerItem] = {};
+#pragma unroll
+        for (int k = 0; k < TopK; ++k) {
+          if (moe_ids[k] == -1) continue;
+#pragma unroll
+          for (int e = 0; e < ElemsPerItem; ++e) {
+            accum[e] +=
+                static_cast<float>(
+                    moe_output[moe_ids[k] * HiddenSize + hidden_idx + e]) *
+                scores[k];
+          }
+        }
+#pragma unroll
+        for (int e = 0; e < ElemsPerItem; ++e) {
+          const int output_idx = token_idx * HiddenSize + hidden_idx + e;
+          output[output_idx] =
+              laguna_m8_gather_finalize_arithmetic(accum[e], shared[output_idx])
+                  .final_bf16;
+        }
+      }
+    }
+  }
+
+ private:
+  LagunaM8BFloat16* output;
+  const LagunaM8BFloat16* moe_output;
+  const float* topk_weights;
+  const int* unpermuted_row_to_permuted_row;
+  const LagunaM8BFloat16* shared;
+};
+
 template <typename T>
 void MoeGatherLauncher(
     T* output,
@@ -514,6 +596,25 @@ void LagunaM8MoeGatherFinalizeDiagnosticLauncher(
   });
 }
 
+void LagunaM12MappedGatherScaleAddLauncher(
+    LagunaM8BFloat16* output,
+    const LagunaM8BFloat16* moe_output,
+    const float* topk_weights,
+    const int* unpermuted_row_to_permuted_row,
+    const LagunaM8BFloat16* shared,
+    sycl::queue& queue) {
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        LagunaM12MappedGatherScaleAdd::get_nd_range(),
+        LagunaM12MappedGatherScaleAdd{
+            output,
+            moe_output,
+            topk_weights,
+            unpermuted_row_to_permuted_row,
+            shared});
+  });
+}
+
 template <typename T, typename IndexT>
 void MoeGatherDirectM1Launcher(
     T* output,
@@ -719,6 +820,101 @@ void laguna_m8_moe_gather_finalize(
       queue);
 }
 
+void laguna_m12_mapped_gather_scale_add(
+    torch::Tensor& output,
+    const torch::Tensor& moe_output,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    const torch::Tensor& shared,
+    int64_t num_local_experts) {
+  constexpr int kNumTokens = 12;
+  constexpr int kTopK = 10;
+  constexpr int kHiddenSize = 3072;
+  constexpr int kMoeRows = kNumTokens * kTopK;
+  constexpr int kNumLocalExperts = 64;
+
+  TORCH_CHECK(output.is_xpu(), "output must be on XPU");
+  TORCH_CHECK(moe_output.is_xpu(), "moe_output must be on XPU");
+  TORCH_CHECK(topk_weights.is_xpu(), "topk_weights must be on XPU");
+  TORCH_CHECK(
+      unpermuted_row_to_permuted_row.is_xpu(),
+      "unpermuted_row_to_permuted_row must be on XPU");
+  TORCH_CHECK(shared.is_xpu(), "shared must be on XPU");
+  TORCH_CHECK(
+      moe_output.device() == output.device() &&
+          topk_weights.device() == output.device() &&
+          unpermuted_row_to_permuted_row.device() == output.device() &&
+          shared.device() == output.device(),
+      "Laguna M12 gather/scale/add tensors must share one XPU device");
+  TORCH_CHECK(
+      output.scalar_type() == torch::kBFloat16 &&
+          moe_output.scalar_type() == torch::kBFloat16 &&
+          shared.scalar_type() == torch::kBFloat16,
+      "output, moe_output, and shared must be BF16");
+  TORCH_CHECK(
+      topk_weights.scalar_type() == torch::kFloat32,
+      "topk_weights must be FP32");
+  TORCH_CHECK(
+      unpermuted_row_to_permuted_row.scalar_type() == torch::kInt32,
+      "unpermuted_row_to_permuted_row must be int32");
+  TORCH_CHECK(
+      output.is_contiguous() && moe_output.is_contiguous() &&
+          topk_weights.is_contiguous() &&
+          unpermuted_row_to_permuted_row.is_contiguous() &&
+          shared.is_contiguous(),
+      "Laguna M12 gather/scale/add tensors must be contiguous");
+  TORCH_CHECK(
+      output.dim() == 2 && output.size(0) == kNumTokens &&
+          output.size(1) == kHiddenSize,
+      "output must have exact shape [12,3072]");
+  TORCH_CHECK(
+      moe_output.dim() == 2 && moe_output.size(0) == kMoeRows &&
+          moe_output.size(1) == kHiddenSize,
+      "moe_output must have exact shape [120,3072]");
+  TORCH_CHECK(
+      topk_weights.dim() == 2 && topk_weights.size(0) == kNumTokens &&
+          topk_weights.size(1) == kTopK,
+      "topk_weights must have exact shape [12,10]");
+  TORCH_CHECK(
+      unpermuted_row_to_permuted_row.dim() == 2 &&
+          unpermuted_row_to_permuted_row.size(0) == kNumTokens &&
+          unpermuted_row_to_permuted_row.size(1) == kTopK,
+      "unpermuted_row_to_permuted_row must have exact shape [12,10]");
+  TORCH_CHECK(
+      shared.dim() == 2 && shared.size(0) == kNumTokens &&
+          shared.size(1) == kHiddenSize,
+      "shared must have exact shape [12,3072]");
+  TORCH_CHECK(
+      num_local_experts == kNumLocalExperts,
+      "Laguna M12 gather/scale/add requires exactly 64 local experts");
+  TORCH_CHECK(
+      reinterpret_cast<uintptr_t>(output.data_ptr()) % 16 == 0 &&
+          reinterpret_cast<uintptr_t>(moe_output.data_ptr()) % 16 == 0 &&
+          reinterpret_cast<uintptr_t>(topk_weights.data_ptr()) % 16 == 0 &&
+          reinterpret_cast<uintptr_t>(
+              unpermuted_row_to_permuted_row.data_ptr()) %
+                  16 ==
+              0 &&
+          reinterpret_cast<uintptr_t>(shared.data_ptr()) % 16 == 0,
+      "Laguna M12 gather/scale/add pointers must be 16-byte aligned");
+  at::assert_no_internal_overlap(output);
+  at::assert_no_overlap(output, moe_output);
+  at::assert_no_overlap(output, topk_weights);
+  at::assert_no_overlap(output, unpermuted_row_to_permuted_row);
+  at::assert_no_overlap(output, shared);
+
+  using scalar_t = sycl::ext::oneapi::bfloat16;
+  const at::DeviceGuard device_guard(output.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  vllm::moe::LagunaM12MappedGatherScaleAddLauncher(
+      reinterpret_cast<scalar_t*>(output.data_ptr()),
+      reinterpret_cast<const scalar_t*>(moe_output.data_ptr()),
+      topk_weights.data_ptr<float>(),
+      unpermuted_row_to_permuted_row.data_ptr<int>(),
+      reinterpret_cast<const scalar_t*>(shared.data_ptr()),
+      queue);
+}
