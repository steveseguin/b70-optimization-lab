+# SPDX-License-Identifier: Apache-2.0
+"""CPU-only contract checks for the default-unused exact M12 MoE tail."""
+
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SOURCE = (ROOT / "csrc/moe/moe_gather.cpp").read_text()
+HEADER = (ROOT / "csrc/moe/moe_ops.h").read_text()
+BINDINGS = (ROOT / "csrc/moe/torch_bindings.cpp").read_text()
+
+CLASS_START = SOURCE.index("class LagunaM12MappedGatherScaleAdd")
+CLASS_END = SOURCE.index("template <typename T, typename IndexT", CLASS_START)
+CANDIDATE = SOURCE[CLASS_START:CLASS_END]
+FUNCTION_START = SOURCE.index("void laguna_m12_mapped_gather_scale_add(")
+FUNCTION_END = SOURCE.index(
+    "std::tuple<torch::Tensor, torch::Tensor, torch::Tensor>", FUNCTION_START
+)
+FUNCTION = SOURCE[FUNCTION_START:FUNCTION_END]
+
+
+def test_exact_fixed_geometry_and_mapped_slot_order() -> None:
+    for contract in (
+        "static constexpr int NumTokens = 12;",
+        "static constexpr int TopK = 10;",
+        "static constexpr int HiddenSize = 3072;",
+        "static constexpr int GroupWorkItem = 256;",
+        "static constexpr int ElemsPerItem = 8;",
+        "moe_ids[i] = unpermuted_row_to_permuted_row[slot];",
+        "scores[i] = topk_weights[slot];",
+        "for (int k = 0; k < TopK; ++k)",
+        "if (moe_ids[k] == -1) continue;",
+        "laguna_m8_gather_finalize_arithmetic(",
+        ".final_bf16;",
+    ):
+        assert contract in CANDIDATE
+
+
+def test_binding_fails_closed_on_full_contract() -> None:
+    for contract in (
+        '"output must have exact shape [12,3072]"',
+        '"moe_output must have exact shape [120,3072]"',
+        '"topk_weights must have exact shape [12,10]"',
+        '"unpermuted_row_to_permuted_row must have exact shape [12,10]"',
+        '"shared must have exact shape [12,3072]"',
+        "topk_weights.scalar_type() == torch::kFloat32",
+        "unpermuted_row_to_permuted_row.scalar_type() == torch::kInt32",
+        "num_local_experts == kNumLocalExperts",
+        "at::assert_no_overlap(output, moe_output);",
+        "at::assert_no_overlap(output, topk_weights);",
+        "at::assert_no_overlap(output, unpermuted_row_to_permuted_row);",
+        "at::assert_no_overlap(output, shared);",
+    ):
+        assert contract in FUNCTION
+
+
+def test_schema_is_explicit_and_declared_once() -> None:
+    symbol = "laguna_m12_mapped_gather_scale_add"
+    assert HEADER.count(symbol) == 1
+    assert BINDINGS.count(f'"{symbol}') == 2
+    assert "Tensor(a!) output" in BINDINGS
+    assert "Tensor unpermuted_row_to_permuted_row" in BINDINGS
+
+
+def test_existing_m8_candidate_and_generic_gather_remain_present() -> None:
+    assert "class LagunaM8MoeGatherFinalize" in SOURCE
+    assert "class MoeGather" in SOURCE
+    assert "void moe_gather(" in SOURCE
