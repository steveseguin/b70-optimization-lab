@@ -186,13 +187,20 @@ CUTE_DEVICE void MoEGEMM(
       slm_mem_const.template get_multi_ptr<sycl::access::decorated::no>()
           .get());
 
-  for (int i = 0; i < num_experts; ++i) {
-    int gemm_m = rows_per_expert[i];
-    int cumsum_rows_for_experts = pre_rows + gemm_m;
+  for (int i = DirectOffsets ? direct_expert_id : 0; i < num_experts; ++i) {
+    int gemm_m = DirectOffsets
+        ? rows_per_expert[i + 1] - rows_per_expert[i]
+        : rows_per_expert[i];
+    int cumsum_rows_for_experts =
+        DirectOffsets ? rows_per_expert[i + 1] : pre_rows + gemm_m;
     int cumsum_tiles_for_experts =
         (gemm_m + wg_tile_m - 1) / wg_tile_m + pre_tiles;
 
     if constexpr (DirectSchedule) {
+      if constexpr (DirectOffsets) {
+        pre_rows = rows_per_expert[i];
+        pre_tiles = 0;
+      }
       if (i < direct_expert_id) {
         pre_rows = cumsum_rows_for_experts;
         pre_tiles = cumsum_tiles_for_experts;
diff --git a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp
