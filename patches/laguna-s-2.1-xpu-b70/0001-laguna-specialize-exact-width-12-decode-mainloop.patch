   return enabled;
 }
 
+// Select a separately named compile-time-specialized version of the verified
+// width-12 GRF128 kernel. Host dispatch below requires the exact group-32,
+// vectorized, non-folded, non-MAD route before this can reach device code.
+inline bool laguna_int4_decode_exact_specialized() {
+  static const bool enabled = [] {
+    const char* value =
+        std::getenv("VLLM_XPU_LAGUNA_DECODE_EXACT_SPECIALIZED");
+    if (value == nullptr) return false;
+    if (std::strcmp(value, "0") == 0) return false;
+    if (std::strcmp(value, "1") == 0) return true;
+    TORCH_CHECK(
+        false,
+        "VLLM_XPU_LAGUNA_DECODE_EXACT_SPECIALIZED must be literal 0 or 1, "
+        "got '",
+        value,
+        "'");
+    return false;
+  }();
+  return enabled;
+}
+
 // Range gate for the INT4 dequantize-scale fusion.
