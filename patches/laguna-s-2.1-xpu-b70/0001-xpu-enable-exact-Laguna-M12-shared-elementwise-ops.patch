+def test_laguna_m12_shared_elementwise_record_contract(monkeypatch) -> None:
+    config, vllm_config = _record_contract()
+    vllm_config.model_config.enforce_eager = False
+    vllm_config.speculative_config.num_speculative_tokens = 11
+    vllm_config.compilation_config.cudagraph_mode = CUDAGraphMode.PIECEWISE
+    vllm_config.compilation_config.cudagraph_capture_sizes = [12]
+    vllm_config.compilation_config.max_cudagraph_capture_size = 12
+    monkeypatch.setattr(laguna.current_platform, "is_xpu", lambda: True)
+    _set_graph_environment(monkeypatch)
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_EXACT_MAX_M", "12")
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M12_SHARED_ELEMENTWISE", "1")
+
+    assert not laguna._laguna_m8_shared_elementwise_contract_violations(
+        config,
+        vllm_config,
+        enable_eplb=False,
+        num_redundant_experts=0,
+    )
+
+    vllm_config.speculative_config.num_speculative_tokens = 7
+    violations = laguna._laguna_m8_shared_elementwise_contract_violations(
+        config,
+        vllm_config,
+        enable_eplb=False,
+        num_redundant_experts=0,
+    )
+    assert "speculation is not DFlash depth 11" in violations
+
+
