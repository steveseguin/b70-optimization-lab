     )


+@pytest.mark.skipif(not torch.xpu.is_available(), reason="XPU is required")
+def test_laguna_m12_shared_elementwise_dispatches_both_ops(monkeypatch) -> None:
+    activation_calls = []
+    scale_add_calls = []
+
+    def fake_silu_mul(out, gate, up):
+        activation_calls.append((out, gate, up))
+        out.copy_(F.silu(gate) * up)
+
+    def fake_scale_add(out, shared, routed):
+        scale_add_calls.append((out, shared, routed))
+        scaled = routed.clone()
+        scaled.mul_(2.5)
+        out.copy_(shared + scaled)
+
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M12_SHARED_ELEMENTWISE", "1")
+    monkeypatch.setattr(laguna, "_xpu_is_exact_decode_or_verifier_rows", lambda _: True)
+    monkeypatch.setattr(
+        moe_runner, "_xpu_is_exact_decode_or_verifier_rows", lambda _: True
+    )
+    monkeypatch.setattr(laguna.ops, "laguna_m12_silu_mul", fake_silu_mul)
+    monkeypatch.setattr(moe_runner.ops, "laguna_m12_scale_add", fake_scale_add)
+
+    gate = torch.randn(12, 256, dtype=torch.bfloat16, device="xpu")
+    up = torch.randn_like(gate)
+    activated = laguna._laguna_m8_shared_silu_mul(gate, up, enabled=True)
+    assert len(activation_calls) == 1
+    assert torch.equal(
+        activated.cpu().view(torch.int16),
+        (F.silu(gate) * up).cpu().view(torch.int16),
+    )
+
+    runner = SimpleNamespace(
+        use_laguna_m8_shared_elementwise=True,
+        routed_scaling_factor=2.5,
+        routed_output_transform=None,
+    )
+    shared = torch.randn(12, 3072, dtype=torch.bfloat16, device="xpu")
+    routed = torch.randn_like(shared)
+    combined = moe_runner.MoERunner._maybe_laguna_m8_scale_add(runner, shared, routed)
+    assert combined is not None
+    assert len(scale_add_calls) == 1
+    scaled = routed.clone()
+    scaled.mul_(2.5)
+    assert torch.equal(
+        combined.cpu().view(torch.int16),
+        (shared + scaled).cpu().view(torch.int16),
+    )
+
