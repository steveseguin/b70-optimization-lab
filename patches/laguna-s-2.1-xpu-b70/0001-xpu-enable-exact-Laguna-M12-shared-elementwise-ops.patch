+def test_laguna_m12_shared_elementwise_keeps_other_widths_incumbent(
+    monkeypatch,
+) -> None:
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M12_SHARED_ELEMENTWISE", "1")
+    monkeypatch.setattr(
+        laguna,
+        "_xpu_is_exact_decode_or_verifier_rows",
+        lambda _: True,
+    )
+    monkeypatch.setattr(
+        moe_runner,
+        "_xpu_is_exact_decode_or_verifier_rows",
+        lambda _: True,
+    )
+    for rows in (1, 8, 11):
+        gate = torch.randn(rows, 256, dtype=torch.bfloat16)
+        up = torch.randn_like(gate)
+        expected = F.silu(gate) * up
+        actual = laguna._laguna_m8_shared_silu_mul(gate, up, enabled=True)
+        assert torch.equal(actual.view(torch.int16), expected.view(torch.int16))
+
+        runner = SimpleNamespace(
+            use_laguna_m8_shared_elementwise=True,
+            routed_scaling_factor=2.5,
+            routed_output_transform=None,
+        )
+        shared = torch.randn(rows, 3072, dtype=torch.bfloat16)
+        routed = torch.randn_like(shared)
+        assert (
+            moe_runner.MoERunner._maybe_laguna_m8_scale_add(runner, shared, routed)
+            is None
+        )
+
