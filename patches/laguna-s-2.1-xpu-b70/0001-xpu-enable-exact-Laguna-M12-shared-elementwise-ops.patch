+@pytest.mark.skipif(not torch.xpu.is_available(), reason="XPU is required")
+@pytest.mark.parametrize("compiled", [False, True])
+def test_laguna_m12_shared_elementwise_fails_closed(
+    monkeypatch,
+    compiled: bool,
+) -> None:
+    def missing(*_args):
+        raise AttributeError("missing test symbol")
+
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M12_SHARED_ELEMENTWISE", "1")
+    monkeypatch.setattr(laguna, "_xpu_is_exact_decode_or_verifier_rows", lambda _: True)
+    monkeypatch.setattr(
+        moe_runner, "_xpu_is_exact_decode_or_verifier_rows", lambda _: True
+    )
+    monkeypatch.setattr(torch.compiler, "is_compiling", lambda: compiled)
+    monkeypatch.setattr(laguna.ops, "laguna_m12_silu_mul", missing)
+    monkeypatch.setattr(moe_runner.ops, "laguna_m12_scale_add", missing)
+    expected = "eager-only" if compiled else "_C::laguna_m12"
+
+    gate = torch.empty(12, 256, dtype=torch.bfloat16, device="xpu")
+    up = torch.empty_like(gate)
+    with pytest.raises(RuntimeError, match=expected):
+        laguna._laguna_m8_shared_silu_mul(gate, up, enabled=True)
+
+    runner = SimpleNamespace(
+        use_laguna_m8_shared_elementwise=True,
+        routed_scaling_factor=2.5,
+        routed_output_transform=None,
+    )
+    shared = torch.empty(12, 3072, dtype=torch.bfloat16, device="xpu")
+    routed = torch.empty_like(shared)
+    with pytest.raises(RuntimeError, match=expected):
+        moe_runner.MoERunner._maybe_laguna_m8_scale_add(runner, shared, routed)
