+
+    out, _, _ = triton_bf16_mla_sparse_interface(q, kv, indices, 576**-0.5, d_v=512)
+    reference, _, _, _ = reference_mla_sparse_prefill(
+        q, kv, indices, 576**-0.5, d_v=512
+    )
+
+    assert torch.isfinite(out).all()
+    torch.testing.assert_close(out[0], reference[0], atol=1e-2, rtol=1e-2)
+    torch.testing.assert_close(out[1], torch.zeros_like(out[1]))
+
