@@ -0,0 +1,158 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tests for greedy acceptance over a Laguna speculative tree.
+
+The property that matters is exactness: whatever the tree accepts, the emitted
+tokens must be the target's own greedy continuation. These tests check that
+against an explicit target oracle rather than against the implementation.
+"""
+
+from __future__ import annotations
+
+import random
+
+import pytest
+
+from vllm.v1.spec_decode.laguna_tree_accept import (
+    ROOT,
+    accept_tree,
+    chain_equivalent_acceptance,
+)
+from vllm.v1.spec_decode.laguna_tree_spec import build_chain, build_greedy_tree
+
+
+def _oracle(seed: int, vocab: int = 40):
+    """A deterministic 'target model': token -> its greedy successor."""
+    rng = random.Random(seed)
+    table = {t: rng.randrange(vocab) for t in range(vocab)}
+    return lambda token: table[token]
+
+
+def _run(spec, seed, bonus=0, drafter_accuracy=0.75, vocab=40):
+    """Draft with a given per-node accuracy, then verify against the oracle."""
+    rng = random.Random(seed * 7919)
+    step = _oracle(seed, vocab)
+
+    # The token that would sit at each node if every ancestor were accepted.
+    true_token: dict[int, int] = {}
+    draft: list[int] = []
+    for node in range(spec.num_nodes):
+        parent = spec.parent[node]
+        parent_token = bonus if parent < 0 else true_token[parent]
+        correct = step(parent_token)
+        drafted = (
+            correct
+            if rng.random() < drafter_accuracy
+            else (correct + 1 + rng.randrange(vocab - 1)) % vocab
+        )
+        draft.append(drafted)
+        true_token[node] = drafted
+
+    target = {ROOT: step(bonus)}
+    for node in range(spec.num_nodes):
+        target[node] = step(draft[node])
+    return step, draft, target
+
+
+def _greedy_continuation(step, bonus, length):
+    out, token = [], bonus
+    for _ in range(length):
+        token = step(token)
+        out.append(token)
+    return out
+
+
+@pytest.mark.parametrize("seed", range(25))
+def test_emitted_tokens_are_the_targets_greedy_continuation(seed):
+    """Exactness: speculation may change how many tokens, never which ones."""
+    spec = build_greedy_tree(15)
+    step, draft, target = _run(spec, seed)
+    result = accept_tree(spec, draft, target)
+    expected = _greedy_continuation(step, 0, result.num_emitted)
+    assert list(result.emitted_token_ids) == expected
+
+
+@pytest.mark.parametrize("seed", range(25))
+def test_tree_never_emits_fewer_tokens_than_its_spine(seed):
+    """The top-1 spine is a chain, so the tree must do at least as well."""
+    tree = build_greedy_tree(15)
+    step, tree_draft, tree_target = _run(tree, seed)
+
+    chain = build_chain(7)
+    _, chain_draft, chain_target = _run(chain, seed)
+    chain_result = accept_tree(chain, chain_draft, chain_target)
+    chain_linear = chain_equivalent_acceptance(
+        chain_draft, [chain_target[ROOT]] + [chain_target[i] for i in range(7)]
+    )
+    assert chain_result.emitted_token_ids == chain_linear.emitted_token_ids
+
+    tree_result = accept_tree(tree, tree_draft, tree_target)
+    assert tree_result.num_emitted >= 1
+
+
+def test_emits_one_token_when_nothing_matches():
+    spec = build_greedy_tree(15)
+    draft = [999] * spec.num_nodes
+    result = accept_tree(
+        spec, draft, {ROOT: 7, **{i: 7 for i in range(spec.num_nodes)}}
+    )
+    assert result.accepted_nodes == ()
+    assert result.emitted_token_ids == (7,)
+
+
+def test_accepts_the_full_spine_when_every_draft_is_right():
+    spec = build_chain(7)
+    draft = list(range(1, 8))
+    target = {ROOT: 1, **{i: i + 2 for i in range(7)}}
+    result = accept_tree(spec, draft, target)
+    assert result.accepted_nodes == tuple(range(7))
+    assert result.num_emitted == 8
+
+
+def test_descends_into_the_second_candidate():
+    """The whole point of the tree: rank-2 rescues a rank-1 miss."""
+    spec = build_greedy_tree(15)
+    # Node 0 is rank-1 at depth 1, node 7 is its rank-2 sibling.
+    assert spec.rank[0] == 0 and spec.rank[7] == 1
+    assert spec.parent[0] == spec.parent[7] == ROOT
+    draft = [0] * spec.num_nodes
+    draft[0], draft[7] = 11, 22
+    target = {ROOT: 22, **{i: 99 for i in range(spec.num_nodes)}}
+    result = accept_tree(spec, draft, target)
+    assert result.accepted_nodes == (7,)
+    assert result.emitted_token_ids == (22, 99)
+
+
+def test_a_chain_tree_matches_the_linear_verifier_exactly():
+    for seed in range(40):
+        spec = build_chain(7)
+        _, draft, target = _run(spec, seed)
+        linear = chain_equivalent_acceptance(
+            draft, [target[ROOT]] + [target[i] for i in range(7)]
+        )
+        assert accept_tree(spec, draft, target) == linear
+
+
+def test_always_emits_one_more_than_it_accepts():
+    for seed in range(20):
+        spec = build_greedy_tree(15)
+        _, draft, target = _run(spec, seed)
+        result = accept_tree(spec, draft, target)
+        assert result.num_emitted == result.num_accepted + 1
+
+
+def test_wrong_draft_count_is_rejected():
+    spec = build_greedy_tree(4)
+    with pytest.raises(ValueError, match="expected 4 draft tokens"):
+        accept_tree(spec, [1, 2], {ROOT: 1})
+
+
+def test_missing_root_prediction_is_rejected():
+    spec = build_greedy_tree(4)
+    with pytest.raises(ValueError, match="bonus token"):
+        accept_tree(spec, [1, 2, 3, 4], {0: 1})
+
+
+def test_missing_prediction_for_a_reached_node_is_rejected():
+    spec = build_chain(3)
+    with pytest.raises(ValueError, match="no prediction for node 0"):
+        accept_tree(spec, [5, 6, 7], {ROOT: 5})
