+class _FakeNorm(nn.Module):
+    def __init__(self) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(
+            torch.empty(3072, dtype=torch.bfloat16),
+            requires_grad=False,
+        )
+        self.variance_epsilon = 1e-6
+
