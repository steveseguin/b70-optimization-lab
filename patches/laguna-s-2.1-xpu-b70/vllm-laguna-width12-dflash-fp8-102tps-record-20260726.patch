+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+import torch
+
+from vllm.utils.torch_utils import canonicalize_singleton_dim_strides
+from vllm.v1.attention.backends.flash_attn import (
+    FlashAttentionImpl,
+    FlashAttentionMetadata,
+    FlashAttentionMetadataBuilder,
+    XPUExactSpecDecodeMetadata,
+    _build_xpu_exact_spec_decode_metadata,
+    _select_xpu_exact_spec_decode_metadata,
+    _xpu_begin_laguna_kv_view_profile,
+    _xpu_end_laguna_kv_view_profile,
+    _xpu_kv_cache_tensor_signature,
+    _XPUPersistentKVCacheViews,
+)
+
+
+def _metadata(q_width: int, seq_len: int = 41) -> FlashAttentionMetadata:
+    query_start_loc = torch.tensor([0, q_width], dtype=torch.int32)
+    seq_lens = torch.tensor([seq_len], dtype=torch.int32)
+    block_table = torch.tensor([[7, 11, 13]], dtype=torch.int32)
+    exact = _build_xpu_exact_spec_decode_metadata(
+        num_actual_tokens=q_width,
+        max_query_len=q_width,
+        query_start_loc=query_start_loc,
+        seq_lens=seq_lens,
+        block_table=block_table,
+        use_cascade=False,
+    )
+    return FlashAttentionMetadata(
+        num_actual_tokens=q_width,
+        max_query_len=q_width,
+        query_start_loc=query_start_loc,
+        max_seq_len=seq_len,
+        seq_lens=seq_lens,
+        block_table=block_table,
+        slot_mapping=torch.arange(q_width, dtype=torch.int64),
+        use_cascade=False,
+        common_prefix_len=0,
+        cu_prefix_query_lens=None,
+        prefix_kv_lens=None,
+        suffix_kv_lens=None,
+        xpu_exact_spec_decode=exact,
+    )
+
+
+def _persistent_builder() -> FlashAttentionMetadataBuilder:
+    builder = object.__new__(FlashAttentionMetadataBuilder)
+    builder._xpu_exact_spec_cu_seqlens_q = None
+    builder._xpu_exact_spec_seqused_k = None
+    builder._xpu_exact_spec_block_table = None
+    builder._xpu_exact_spec_k_offsets = None
+    builder._xpu_exact_spec_metadata_by_width = None
+    builder._xpu_exact_spec_base_signatures = None
+    builder._xpu_exact_spec_offset_signatures = None
+    builder._xpu_exact_spec_metadata_signatures = None
+    builder._xpu_exact_spec_metadata_ids = None
+    return builder
+
+
+def _build_persistent(
+    builder: FlashAttentionMetadataBuilder,
+    metadata: FlashAttentionMetadata,
+):
+    return builder._build_persistent_xpu_exact_spec_decode_metadata(
+        num_actual_tokens=metadata.num_actual_tokens,
+        max_query_len=metadata.max_query_len,
+        query_start_loc=metadata.query_start_loc,
+        seq_lens=metadata.seq_lens,
+        block_table=metadata.block_table,
+        use_cascade=metadata.use_cascade,
+    )
+
+
+def _tensor_signature(tensor: torch.Tensor):
+    return (
+        tensor.data_ptr(),
+        tensor.storage_offset(),
+        tuple(tensor.shape),
+        tuple(tensor.stride()),
+        tensor.dtype,
+        tensor.device,
+    )
+
+
+def _kv_view_manager(*, device_type: str = "cpu"):
+    return _XPUPersistentKVCacheViews(
+        head_size=128,
+        num_kv_heads=2,
+        dtype=torch.bfloat16,
+        device_type=device_type,
+    )
+
+
+def _flash_attention_impl_for_kv_views(manager):
+    impl = object.__new__(FlashAttentionImpl)
+    impl.head_size = 128
+    impl._xpu_persistent_kv_cache_views = manager
+    return impl
+
+
+def test_xpu_persistent_kv_views_flag_off_preserves_incumbent_path():
+    kv_cache = torch.randn(4, 2, 1, 256, dtype=torch.bfloat16)
+    impl = _flash_attention_impl_for_kv_views(None)
+
+    first_forward = impl._get_kv_cache_views_for_forward(kv_cache)
+    second_forward = impl._get_kv_cache_views_for_forward(kv_cache)
+    first_update = impl._get_kv_cache_views_for_update(kv_cache)
+    second_update = impl._get_kv_cache_views_for_update(kv_cache)
+    incumbent_raw = tuple(kv_cache.transpose(1, 2).split(128, dim=-1))
+    incumbent_canonical = tuple(
+        canonicalize_singleton_dim_strides(view) for view in incumbent_raw
+    )
+
+    assert impl._xpu_persistent_kv_cache_views is None
+    assert all(
+        _xpu_kv_cache_tensor_signature(actual)
+        == _xpu_kv_cache_tensor_signature(expected)
+        for actual, expected in zip(first_forward, incumbent_canonical)
+    )
+    assert all(
+        _xpu_kv_cache_tensor_signature(actual)
+        == _xpu_kv_cache_tensor_signature(expected)
+        for actual, expected in zip(first_update, incumbent_raw)
+    )
+    assert all(
+        first is not second for first, second in zip(first_forward, second_forward)
+    )
+    assert all(
+        first is not second for first, second in zip(first_update, second_update)
+    )
+
+
+def test_xpu_persistent_kv_view_profile_distinguishes_control_and_hits():
+    kv_cache = torch.randn(4, 2, 1, 256, dtype=torch.bfloat16)
+    control = _flash_attention_impl_for_kv_views(None)
+    manager = _kv_view_manager()
+    persistent = _flash_attention_impl_for_kv_views(manager)
+    manager.get(kv_cache, canonical=True)
+
+    _xpu_begin_laguna_kv_view_profile()
+    control._get_kv_cache_views_for_forward(kv_cache)
+    control._get_kv_cache_views_for_update(kv_cache)
+    control_profile = _xpu_end_laguna_kv_view_profile()
+
+    _xpu_begin_laguna_kv_view_profile()
+    persistent._get_kv_cache_views_for_forward(kv_cache)
+    persistent._get_kv_cache_views_for_update(kv_cache)
