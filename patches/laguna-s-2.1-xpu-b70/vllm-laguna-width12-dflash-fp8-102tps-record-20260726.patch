+    *,
+    layer_idx: int,
+    stage: str,
+    positions: torch.Tensor,
+    **tensors: torch.Tensor,
+) -> None:
+    """Dump one target forward for q-width exactness diagnosis.
+
+    This is deliberately environment-gated and synchronous. It is a diagnostic
+    hook, not a performance path. DFlash layers do not call it.
+    """
+    trace_dir = os.environ.get("VLLM_LAGUNA_TARGET_TRACE_DIR")
+    if not trace_dir or positions.numel() == 0:
+        return
+    trace_position = int(os.environ.get("VLLM_LAGUNA_TARGET_TRACE_POSITION", "-1"))
+    if int(positions.reshape(-1)[0].item()) != trace_position:
+        return
+    trace_layer = int(os.environ.get("VLLM_LAGUNA_TARGET_TRACE_LAYER", "-1"))
+    if trace_layer >= 0 and layer_idx != trace_layer:
+        return
+    rank = get_tensor_model_parallel_rank()
+    trace_rank = int(os.environ.get("VLLM_LAGUNA_TARGET_TRACE_RANK", "0"))
+    if rank != trace_rank:
+        return
+
+    # Avoid dumping the 8192-token initialization/profile pass. Diagnostic
+    # traces are intended for real cold prompts and decode verifier chunks.
+    if positions.numel() > 512:
+        return
