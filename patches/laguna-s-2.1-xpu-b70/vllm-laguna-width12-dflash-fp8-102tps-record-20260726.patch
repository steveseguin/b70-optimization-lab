+                or stat.S_IMODE(root_metadata.st_mode) != 0o700
+                or root_metadata.st_dev != config["root_device"]
+                or root_metadata.st_ino != config["root_inode"]
+            ):
+                raise RuntimeError("unsafe Laguna XPU event-profile root")
+            if output.parent != config["root"] or output.name != (
+                f"rank{config['rank']}.json"
+            ):
+                raise RuntimeError("invalid Laguna XPU event-profile output")
+            descriptor = os.open(
+                output.name,
+                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
+                0o600,
+                dir_fd=root_descriptor,
+            )
+            try:
+                offset = 0
+                while offset < len(raw):
+                    written = os.write(descriptor, raw[offset:])
+                    if written <= 0:
+                        raise RuntimeError("short Laguna XPU event-profile write")
+                    offset += written
+                os.fsync(descriptor)
+            finally:
+                os.close(descriptor)
+            os.fsync(root_descriptor)
+        finally:
+            os.close(root_descriptor)
+        self._complete_laguna_event_profile(config)
+        self._laguna_replay_event_profile_complete = True
+        logger.info("Wrote audited Laguna XPU event profile to %s", output)
+
+    def _resume_laguna_replay_trace_once(self) -> None:
+        """Resume an opt-in PTI session immediately before the first replay.
+
+        This diagnostic hook is intentionally outside normal configuration.
+        It lets a one-generation component trace exclude Laguna's lazy graph
+        capture without adding a warm-up or second request. All TP ranks first
+        rendezvous while PTI is paused; rank zero resumes the shared session;
+        a second rendezvous prevents another rank from entering replay before
+        tracing is live. The traced second barrier is declared by the
+        diagnostic protocol and must not be treated as model work.
+        """
+        if self.__dict__.get("_laguna_replay_trace_resumed", False):
+            return
+        import hashlib
+        import stat
+        import subprocess
+
+        import regex as re
+
+        session = os.environ.get("VLLM_XPU_LAGUNA_REPLAY_TRACE_SESSION")
+        unitrace_path = os.environ.get("VLLM_XPU_LAGUNA_REPLAY_TRACE_UNITRACE")
+        expected_sha = os.environ.get("VLLM_XPU_LAGUNA_REPLAY_TRACE_UNITRACE_SHA256")
+        if session is None and unitrace_path is None and expected_sha is None:
+            return
+        if (
+            not envs.VLLM_XPU_LAGUNA_M8_BREAKABLE_GRAPH
+            or not re.fullmatch(r"LagunaReplay[A-Za-z0-9]{32,48}", session or "")
+            or not unitrace_path
+            or not re.fullmatch(r"[0-9a-f]{64}", expected_sha or "")
+        ):
+            raise RuntimeError("invalid Laguna replay-trace diagnostic contract")
+        assert session is not None
+
+        from vllm.distributed.parallel_state import get_tp_group
+
+        device_group = get_tp_group().device_group
+        torch.distributed.barrier(group=device_group)
+        rank = torch.distributed.get_rank(group=device_group)
+        if rank == 0:
+            descriptor = os.open(
+                unitrace_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
+            )
+            try:
+                before = os.fstat(descriptor)
+                digest = hashlib.sha256()
+                offset = 0
+                while offset < before.st_size:
+                    block = os.pread(
+                        descriptor, min(1024 * 1024, before.st_size - offset), offset
+                    )
+                    if not block:
+                        raise RuntimeError("short retained unitrace read")
+                    digest.update(block)
+                    offset += len(block)
+                if (
+                    not stat.S_ISREG(before.st_mode)
+                    or digest.hexdigest() != expected_sha
+                ):
+                    raise RuntimeError("Laguna replay-trace unitrace identity drift")
+                process = subprocess.run(
+                    [
+                        f"/proc/self/fd/{descriptor}",
+                        "--resume",
+                        session,
+                    ],
+                    stdin=subprocess.DEVNULL,
+                    capture_output=True,
+                    pass_fds=(descriptor,),
+                    timeout=30,
+                    check=False,
+                )
+                after = os.fstat(descriptor)
+                if (
+                    before.st_dev,
+                    before.st_ino,
+                    before.st_size,
+                    before.st_mtime_ns,
+                    before.st_mode,
+                ) != (
+                    after.st_dev,
+                    after.st_ino,
+                    after.st_size,
+                    after.st_mtime_ns,
+                    after.st_mode,
+                ):
+                    raise RuntimeError(
+                        "Laguna replay-trace unitrace changed across resume"
+                    )
+            finally:
+                os.close(descriptor)
+            expected = f"[INFO] Session {session} is resumed\n".encode()
+            if (
+                process.returncode != 0
+                or process.stdout != b""
+                or re.fullmatch(
+                    re.escape(expected)
+                    + rb"\[INFO\] Log is stored in unitrace\.[1-9][0-9]*\n",
+                    process.stderr,
+                )
+                is None
+            ):
+                raise RuntimeError("Laguna replay-trace resume acknowledgement missing")
+            logger.info("Resumed audited Laguna PTI session at first graph replay")
+        torch.distributed.barrier(group=device_group)
+        self._laguna_replay_trace_resumed = True
+
+    def _validate_capture_counts(self, capture: BreakableCUDAGraphCapture) -> None:
+        if self.expected_num_graphs is None:
+            return
+        actual = (capture.num_graphs, capture.num_eager_breaks)
+        expected = (self.expected_num_graphs, self.expected_num_eager_breaks)
+        if actual != expected:
+            raise RuntimeError(
+                "Breakable graph topology changed: "
+                f"saw graphs/eager={actual}, expected {expected}"
+            )
