+def _laguna_m8_shared_silu_mul(
+    gate: torch.Tensor,
+    up: torch.Tensor,
+    *,
+    enabled: bool,
+) -> torch.Tensor:
+    """Use the exact M=8 shared-expert op, otherwise preserve incumbent math."""
+    candidate_call = (
+        enabled
+        and gate.dim() == 2
+        and gate.shape[0] == 8
+        and _xpu_is_exact_decode_or_verifier_rows(8)
+    )
+    if not candidate_call:
+        return F.silu(gate) * up
+
+    if torch.compiler.is_compiling():
+        raise RuntimeError("Laguna M8 shared SiLU/mul is an eager-only exact-record op")
+
+    contract_ok = (
+        gate.shape == (8, 256)
+        and up.shape == (8, 256)
+        and gate.dtype == torch.bfloat16
+        and up.dtype == torch.bfloat16
+        and gate.device.type == "xpu"
+        and up.device == gate.device
+        and gate.is_contiguous()
+        and up.is_contiguous()
+    )
+    if not contract_ok:
+        raise RuntimeError(
+            "Laguna M8 shared SiLU/mul dispatch diverged from the exact "
+            "BF16 [8, 256] verifier contract"
+        )
+
+    output = torch.empty_like(gate)
+    try:
+        ops.laguna_m8_silu_mul(output, gate, up)
+    except AttributeError as error:
+        raise RuntimeError(
+            "Laguna M8 shared elementwise requires a rebuilt XPU kernel "
+            "extension with _C::laguna_m8_silu_mul"
+        ) from error
+    return output
+
