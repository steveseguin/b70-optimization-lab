index 000000000..21cc074f4
--- /dev/null
+++ b/tests/v1/spec_decode/test_laguna_tree_metadata.py
@@ -0,0 +1,126 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tests for Laguna tree verifier metadata.
+
+The decisive test simulates a KV cache, applies the plan's copies and writes,
+then reads each row back through its own block table and ``seqused_k`` and
+checks it sees exactly the shared context followed by its own ancestor path --
+and, critically, none of a sibling's tokens.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from vllm.v1.spec_decode.laguna_tree_metadata import (
+    build_tree_verifier_plan,
+    private_blocks_per_row,
+    resolve_row_context,
+)
+from vllm.v1.spec_decode.laguna_tree_spec import build_chain, build_greedy_tree
+
+BLOCK_SIZE = 64
+
+
+def _plan(spec, ctx_len, block_size=BLOCK_SIZE):
+    n_shared = ctx_len // block_size + 1
+    shared = list(range(100, 100 + n_shared + 1))
+    per_row = private_blocks_per_row(block_size, spec.max_depth)
+    private = list(range(500, 500 + spec.num_nodes * per_row))
+    return build_tree_verifier_plan(spec, ctx_len, block_size, shared, private), shared
+
+
+def _simulate(spec, ctx_len, block_size=BLOCK_SIZE):
+    """Fill a KV cache per the plan and read every row back through it."""
+    plan, shared = _plan(spec, ctx_len, block_size)
+    cache: dict[int, str] = {}
+
+    # Shared context: token c lives at logical position c.
+    for position in range(ctx_len):
+        block = shared[position // block_size]
+        cache[block * block_size + position % block_size] = f"ctx{position}"
+
+    for src, dst in zip(plan.copy_src_slot, plan.copy_dst_slot):
+        cache[dst] = cache[src]
+    for row_writes in plan.write_slot:
+        for node, slot in row_writes:
+            cache[slot] = f"node{node}"
+
+    return plan, [
+        [cache.get(s) for s in resolve_row_context(plan, row, block_size)]
+        for row in range(spec.num_nodes)
+    ]
+
+
+@pytest.mark.parametrize("ctx_len", [0, 1, 63, 64, 65, 127, 128, 200, 4095])
+def test_each_row_reads_exactly_its_own_path(ctx_len):
+    spec = build_greedy_tree(15)
+    plan, rows = _simulate(spec, ctx_len)
+    for row, seen in enumerate(rows):
+        expected = [f"ctx{c}" for c in range(ctx_len)]
+        expected += [f"node{n}" for n in spec.ancestors(row)]
+        assert seen == expected, f"row {row} at ctx_len={ctx_len}"
+        assert len(seen) == plan.seqused_k[row]
+
+
+def test_siblings_do_not_leak_into_each_other():
+    """The reason a shared block table cannot express a tree."""
+    spec = build_greedy_tree(15)
+    _, rows = _simulate(spec, 100)
+    # Nodes 0 and 7 are both depth-1 and are siblings under the bonus token.
+    assert spec.depth[0] == spec.depth[7] == 1
+    assert spec.parent[0] == spec.parent[7] == -1
+    assert "node7" not in rows[0]
+    assert "node0" not in rows[7]
+
+
+def test_a_chain_spec_reproduces_the_staircase():
+    """A tree plan applied to a chain must match the record's seqused_k."""
+    spec = build_chain(7)
+    plan, _ = _plan(spec, 200)
+    assert plan.seqused_k == tuple(200 + d for d in range(1, 8))
+
+
+def test_every_node_is_written_once_per_descendant_row():
+    spec = build_greedy_tree(15)
+    plan, _ = _plan(spec, 100)
+    for row, writes in enumerate(plan.write_slot):
+        assert [node for node, _ in writes] == spec.ancestors(row)
+        assert len({slot for _, slot in writes}) == len(writes)
+
+
+def test_block_aligned_context_needs_no_tail_copy():
+    spec = build_greedy_tree(15)
+    plan, _ = _plan(spec, 2 * BLOCK_SIZE)
+    assert plan.copy_src_slot == ()
+    assert plan.copy_dst_slot == ()
+
+
+def test_unaligned_context_copies_exactly_the_tail_per_row():
+    spec = build_greedy_tree(15)
+    ctx_len = 2 * BLOCK_SIZE + 5
+    plan, _ = _plan(spec, ctx_len)
+    assert len(plan.copy_src_slot) == 5 * spec.num_nodes
+
+
+@pytest.mark.parametrize(
+    "block_size,max_depth,expected",
+    [(64, 15, 2), (64, 1, 1), (16, 15, 2), (16, 16, 2), (8, 15, 3), (128, 15, 2)],
+)
+def test_private_block_count_covers_the_worst_case_tail(
+    block_size, max_depth, expected
+):
+    assert private_blocks_per_row(block_size, max_depth) == expected
+    # The worst case is a full tail plus the deepest path.
+    assert (block_size - 1) + max_depth <= expected * block_size
+
+
+def test_insufficient_private_blocks_is_rejected():
+    spec = build_greedy_tree(15)
+    with pytest.raises(ValueError, match="private blocks"):
+        build_tree_verifier_plan(spec, 100, BLOCK_SIZE, list(range(100, 110)), [500])
+
+
+def test_insufficient_shared_blocks_is_rejected():
+    spec = build_greedy_tree(4)
+    with pytest.raises(ValueError, match="shared blocks"):
+        build_tree_verifier_plan(spec, 500, BLOCK_SIZE, [100], list(range(500, 600)))
