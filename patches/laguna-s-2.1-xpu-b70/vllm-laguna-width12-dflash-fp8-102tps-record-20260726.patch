+)
+from vllm.model_executor.layers.quantization.compressed_tensors.transform.utils import (  # noqa: E501
+    TransformTuple,
+)
+
+
+def _transform(head_dim: int | None, location: TransformLocation) -> TransformTuple:
+    return TransformTuple(
+        "R1",
+        SimpleNamespace(head_dim=head_dim),
+        SimpleNamespace(location=location),
+    )
+
+
+@pytest.mark.parametrize("width", [768, 1536, 2304, 256, 3072])
+def test_tp4_h128_aligned_widths(width: int):
