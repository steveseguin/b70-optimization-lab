+    *,
+    positions: torch.Tensor,
+    input_ids: torch.Tensor | None,
+    inputs_embeds: torch.Tensor | None,
+) -> None:
+    """Dump target inputs before embedding for cross-request diagnosis."""
+    trace_dir = os.environ.get("VLLM_LAGUNA_TARGET_TRACE_DIR")
+    if (
+        not trace_dir
+        or os.environ.get("VLLM_LAGUNA_TARGET_TRACE_INPUTS") != "1"
+        or positions.numel() == 0
+    ):
+        return
+    trace_position = int(os.environ.get("VLLM_LAGUNA_TARGET_TRACE_POSITION", "-1"))
+    if int(positions.reshape(-1)[0].item()) != trace_position:
+        return
+    rank = get_tensor_model_parallel_rank()
+    trace_rank = int(os.environ.get("VLLM_LAGUNA_TARGET_TRACE_RANK", "0"))
+    if rank != trace_rank or positions.numel() > 512:
+        return
+
+    output_dir = Path(trace_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    query_width = positions.numel()
+    payload = {
+        "tp_rank": rank,
+        "positions": positions.detach().cpu(),
+        "input_ids": None if input_ids is None else input_ids.detach().cpu(),
+        "inputs_embeds": (
+            None if inputs_embeds is None else inputs_embeds.detach().cpu()
+        ),
+    }
+    torch.save(payload, output_dir / f"target-input-q{query_width}-rank{rank}.pt")
