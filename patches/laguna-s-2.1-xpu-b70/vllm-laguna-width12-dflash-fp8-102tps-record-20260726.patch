+# SPDX-License-Identifier: Apache-2.0
+
+import pytest
+import torch
+
+from vllm.compilation.laguna_m8_collectives import LagunaM8CollectiveState
+
+
+class _Group:
+    device_group = object()
+
+
+def test_laguna_m8_runner_buffers_have_fixed_order_and_addresses(monkeypatch):
+    import vllm.compilation.laguna_m8_collectives as collectives
+
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+
+    def all_gather(output, local, group):
+        del group
+        output.copy_(local.expand_as(output))
+
+    def all_reduce(output, group):
+        del group
+        output.add_(1)
+
+    monkeypatch.setattr(collectives.dist, "all_gather_into_tensor", all_gather)
+    monkeypatch.setattr(collectives.dist, "all_reduce", all_reduce)
+
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    local = torch.ones((1, 8, 3072), dtype=torch.bfloat16)
+    addresses = [buffer.data_ptr() for buffer in state.gathers]
+    assert len(addresses) == 96
+    state.reset_for_eligible_forward()
+    reduced = state.all_reduce(local.squeeze(0))
+    assert reduced.data_ptr() == state.embedding_reduce.data_ptr()
+    assert torch.equal(reduced, local.squeeze(0) + 1)
+    for expected, address in enumerate(addresses):
+        output = state.all_gather(local, dim=0)
+        assert output.data_ptr() == address
+        assert torch.equal(output, local.expand_as(output))
+        assert state._next_gather == expected + 1
+    state.finish_eligible_forward()
+
+
+def test_laguna_m8_runner_buffers_fail_closed_on_geometry():
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    with pytest.raises(RuntimeError, match=r"fixed \[1,8,3072\]"):
+        state.all_gather(torch.empty((1, 7, 3072), dtype=torch.bfloat16), dim=0)
+    with pytest.raises(RuntimeError, match=r"fixed \[8,3072\]"):
+        state.all_reduce(torch.empty((8, 3072), dtype=torch.float32))
+    with pytest.raises(RuntimeError, match="before embedding all-reduce"):
+        state.all_gather(torch.empty((1, 8, 3072), dtype=torch.bfloat16), dim=0)
+
+
+def test_laguna_m8_runner_buffers_fail_closed_on_order_and_count(monkeypatch):
+    import vllm.compilation.laguna_m8_collectives as collectives
+
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_gather_into_tensor",
+        lambda output, local, group: output.copy_(local.expand_as(output)),
+    )
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_reduce",
+        lambda output, group: None,
+    )
+
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    local = torch.ones((1, 8, 3072), dtype=torch.bfloat16)
+
+    with pytest.raises(RuntimeError, match="omitted its embedding all-reduce"):
+        state.finish_eligible_forward()
+
+    state.all_reduce(local.squeeze(0))
+    with pytest.raises(RuntimeError, match="required first order"):
+        state.all_reduce(local.squeeze(0))
+    with pytest.raises(RuntimeError, match="eager collective count"):
+        state.finish_eligible_forward()
+
+    for _ in range(96):
+        state.all_gather(local, dim=0)
+    with pytest.raises(RuntimeError, match="exceeded its 96"):
+        state.all_gather(local, dim=0)
+    state.finish_eligible_forward()
+
+
+def test_laguna_m8_runner_buffers_accept_replay_counters(monkeypatch):
+    import vllm.compilation.laguna_m8_collectives as collectives
+
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_gather_into_tensor",
+        lambda output, local, group: None,
+    )
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_reduce",
+        lambda output, group: None,
+    )
+
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    local = torch.ones((1, 8, 3072), dtype=torch.bfloat16)
+    state.reset_for_eligible_forward()
+
+    # Replay invokes only the captured eager callbacks. The Python model does
+    # not revisit all_reduce/all_gather, so the gather cursor remains zero.
+    state._run_reduce(local.squeeze(0), state.embedding_reduce)
+    for index, output in enumerate(state.gathers):
+        state._run_gather(local, output, index)
+    state.finish_eligible_forward()
