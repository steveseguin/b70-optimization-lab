new file mode 100644
index 000000000..49dec6ead
--- /dev/null
+++ b/tests/models/test_laguna_dflash_context_kv_workspace.py
@@ -0,0 +1,683 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+from torch import nn
+
+from vllm import envs
+from vllm.model_executor.models import laguna_dflash
+from vllm.model_executor.models.laguna_dflash import DFlashLagunaModel
+
+
+@pytest.fixture(autouse=True)
+def _keep_tests_off_xpu(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(laguna_dflash, "_xpu_stream_is_capturing", lambda: False)
+    monkeypatch.setattr(laguna_dflash.ops, "rms_norm", _fake_rms_norm)
+
+
+def _fake_rms_norm(
+    out: torch.Tensor,
+    inputs: torch.Tensor,
+    weight: torch.Tensor,
+    epsilon: float,
+) -> None:
+    normalized = (
+        inputs.float()
+        * torch.rsqrt(inputs.float().pow(2).mean(dim=-1, keepdim=True) + epsilon)
+    ).to(inputs.dtype)
+    if weight.ndim == 2:
+        weight = weight.view(
+            weight.shape[0],
+            *(1 for _ in range(inputs.ndim - 2)),
+            weight.shape[1],
+        )
+    out.copy_((normalized * weight.to(inputs.dtype)).to(inputs.dtype))
+
+
+def _make_model(*, enabled: bool, has_bias: bool = True) -> DFlashLagunaModel:
+    model = DFlashLagunaModel.__new__(DFlashLagunaModel)
+    nn.Module.__init__(model)
+    model.config = SimpleNamespace(hidden_size=16)
+    model._rms_norm_eps = 1e-6
+    model._context_kv_workspace_enabled = enabled
+    model._context_kv_workspaces = {}
+    model._context_kv_projected_k_key = None
+
+    generator = torch.Generator().manual_seed(7)
+    model._kv_weights = torch.randn(2, 8, 16, dtype=torch.bfloat16, generator=generator)
+    model._kv_biases = (
+        torch.randn(2, 8, dtype=torch.bfloat16, generator=generator)
+        if has_bias
+        else None
+    )
+    model._input_layernorm_weights = torch.randn(
+        2, 16, dtype=torch.bfloat16, generator=generator
+    )
+    model._k_norm_weights = torch.randn(2, 4, dtype=torch.bfloat16, generator=generator)
+    weights = [
+        model._kv_weights,
+        model._input_layernorm_weights,
+        model._k_norm_weights,
+    ]
+    if model._kv_biases is not None:
+        weights.append(model._kv_biases)
+    model._context_kv_weight_signatures = (
+        tuple(laguna_dflash._tensor_signature(tensor) for tensor in weights)
+        if enabled
+        else None
+    )
+    return model
+
+
+def _project(
+    model: DFlashLagunaModel,
+    context_states: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    all_k, all_v = model._project_context_kv(
+        context_states,
+        context_states.shape[0],
+        num_layers=2,
+        num_kv_heads=1,
+        head_dim=4,
+    )
+    return all_k, all_v, model._normalize_context_k(all_k)
+
+
+def _assert_raw_equal(actual: torch.Tensor, expected: torch.Tensor) -> None:
+    assert actual.shape == expected.shape
+    assert actual.stride() == expected.stride()
+    assert torch.equal(actual.view(torch.int16), expected.view(torch.int16))
+
+
+@pytest.mark.parametrize("num_ctx", [1, 3, 8, 9, 12])
+@pytest.mark.parametrize("has_bias", [False, True])
+def test_context_kv_workspace_is_exact_and_reused(
+    num_ctx: int,
+    has_bias: bool,
+) -> None:
+    control = _make_model(enabled=False, has_bias=has_bias)
+    candidate = _make_model(enabled=True, has_bias=has_bias)
+    generator = torch.Generator().manual_seed(11 + num_ctx)
+
+    identities = None
+    for _ in range(2):
+        context_states = torch.randn(
+            num_ctx, 16, dtype=torch.bfloat16, generator=generator
+        )
+        expected = _project(control, context_states)
+        actual = _project(candidate, context_states)
+        for actual_tensor, expected_tensor in zip(actual, expected):
+            _assert_raw_equal(actual_tensor, expected_tensor)
+
+        workspace = next(iter(candidate._context_kv_workspaces.values()))
+        tensors = (
+            workspace.normed_context_states,
+            workspace.all_kv_flat,
+            workspace.all_kv,
+            workspace.all_k_normed,
+        )
+        current = (
+            tuple(id(tensor) for tensor in tensors),
+            tuple(tensor.data_ptr() for tensor in tensors),
+        )
+        identities = current if identities is None else identities
+        assert current == identities
+        workspace.validate()
+
+
+@pytest.mark.parametrize("num_ctx", [0, 13])
+def test_context_kv_workspace_keeps_ineligible_width_on_incumbent_path(
+    num_ctx: int,
+) -> None:
+    control = _make_model(enabled=False)
+    candidate = _make_model(enabled=True)
+    _project(candidate, torch.randn(3, 16, dtype=torch.bfloat16))
+    existing = dict(candidate._context_kv_workspaces)
+    context_states = torch.randn(num_ctx, 16, dtype=torch.bfloat16)
+
+    for actual, expected in zip(
+        _project(candidate, context_states),
+        _project(control, context_states),
+    ):
+        _assert_raw_equal(actual, expected)
+    assert candidate._context_kv_workspaces == existing
+
+
+@pytest.mark.parametrize(
+    "attribute",
+    ["normed_context_states", "all_kv_flat", "all_kv", "all_k_normed"],
+)
+def test_context_kv_workspace_rejects_tensor_identity_drift(attribute: str) -> None:
+    candidate = _make_model(enabled=True)
+    context_states = torch.randn(12, 16, dtype=torch.bfloat16)
+    _project(candidate, context_states)
+    workspace = next(iter(candidate._context_kv_workspaces.values()))
+    setattr(workspace, attribute, getattr(workspace, attribute).clone())
+
+    with pytest.raises(RuntimeError, match="workspace identity drifted"):
+        _project(candidate, context_states)
+
+
+def test_context_kv_workspace_rejects_weight_and_handoff_drift() -> None:
+    candidate = _make_model(enabled=True)
+    context_states = torch.randn(12, 16, dtype=torch.bfloat16)
+    all_k, _ = candidate._project_context_kv(
+        context_states,
+        12,
+        num_layers=2,
+        num_kv_heads=1,
+        head_dim=4,
+    )
+    with pytest.raises(RuntimeError, match="projected K identity drifted"):
+        candidate._normalize_context_k(all_k.clone())
+
+    candidate._kv_weights = candidate._kv_weights.clone()
+    with pytest.raises(RuntimeError, match="weight identity drifted"):
+        _project(candidate, context_states)
+
+
+def test_context_kv_workspace_rejects_input_alias() -> None:
+    candidate = _make_model(enabled=True)
+    context_states = torch.randn(12, 16, dtype=torch.bfloat16)
+    _project(candidate, context_states)
+    workspace = next(iter(candidate._context_kv_workspaces.values()))
+    workspace.normed_context_states = context_states.unsqueeze(0).expand(2, -1, -1)
+    workspace.signatures = tuple(
+        laguna_dflash._tensor_signature(tensor)
+        for tensor in (
+            workspace.normed_context_states,
+            workspace.all_kv_flat,
+            workspace.all_kv,
+            workspace.all_k_normed,
+        )
+    )
+
+    with pytest.raises(RuntimeError, match="aliases inputs or weights"):
+        _project(candidate, context_states)
+
+
+def test_context_kv_workspace_rejects_stream_capture(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(laguna_dflash, "_xpu_stream_is_capturing", lambda: True)
+    candidate = _make_model(enabled=True)
+    with pytest.raises(RuntimeError, match="forbidden during capture"):
+        _project(candidate, torch.randn(12, 16, dtype=torch.bfloat16))
+    assert candidate._context_kv_workspaces == {}
