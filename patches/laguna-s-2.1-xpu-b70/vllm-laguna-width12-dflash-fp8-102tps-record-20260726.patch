+    communicator.device_group = None
+    communicator.world_size = 2
+    communicator.rank_in_group = 0
+    input_ = torch.arange(6).reshape(2, 3)
+    calls = []
+
+    def fake_all_gather_into_tensor(output, source, **_kwargs) -> None:
+        calls.append((output.shape, source.shape))
+        output[: source.shape[0]].copy_(source)
+        output[source.shape[0] :].copy_(source + 10)
