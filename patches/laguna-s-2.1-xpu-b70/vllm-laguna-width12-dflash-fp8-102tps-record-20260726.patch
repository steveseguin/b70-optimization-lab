+    if not isinstance(getattr(layer, "quant_method", None), UnquantizedLinearMethod):
+        raise RuntimeError(f"Laguna DFlash FP8 expected unquantized {label}")
+    if getattr(layer, "bias", None) is not None:
+        raise RuntimeError(f"Laguna DFlash FP8 expected bias-free {label}")
+    quantized_t, scale = _quantize_laguna_dflash_weight(
+        layer.weight,
+        expected_shape=expected_shape,
+        label=label,
+    )
+    replace_parameter(layer, "weight", quantized_t)
+    replace_parameter(layer, "weight_scale", scale)
+    layer.quant_method = _LagunaDFlashFP8LinearMethod()
+    layer._xpu_laguna_dflash_fp8 = True
