+def _xpu_apply_batched_m1_method(
+    layer: "LinearBase",
+    method: "LinearMethodBase",
+    rows: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> torch.Tensor:
+    """Apply one linear method without changing each row's M=1 arithmetic."""
+    apply_batched_m1 = getattr(method, "apply_batched_m1", None)
+    if apply_batched_m1 is not None:
+        return apply_batched_m1(layer, rows, bias)
+    if isinstance(method, UnquantizedLinearMethod):
+        if (
+            envs.VLLM_XPU_LAGUNA_M8_BF16_ATTN_MM
+            and envs.VLLM_XPU_EXACT_SPEC_ATTN
+            and getattr(layer, "xpu_laguna_m8_bf16_attn_mm", False)
+            and rows.shape[0] == 8
+            and _xpu_is_exact_decode_or_verifier_rows(rows.shape[0])
+            and rows.dtype == torch.bfloat16
+            and layer.weight.dtype == torch.bfloat16
+            and (rows.shape[1], layer.weight.shape[0])
+            in {(3072, 2048), (3072, 2816), (1536, 3072), (2304, 3072)}
