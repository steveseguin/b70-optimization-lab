+
+
+def test_tp_rejects_misaligned_input_shard():
+    transforms = {0: _transform(128, TransformLocation.INPUT)}
+    with pytest.raises(NotImplementedError, match="not block aligned"):
+        validate_tp_transform_alignment(transforms, 32, [32], tp_size=4)
+
+
+def test_tp_rejects_misaligned_output_partition():
+    transforms = {1: _transform(128, TransformLocation.OUTPUT)}
+    with pytest.raises(NotImplementedError, match="partition 1"):
+        validate_tp_transform_alignment(transforms, 768, [128, 96], tp_size=4)
