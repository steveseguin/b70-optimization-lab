+        assert metadata.reqs_to_recv["req"].pp_size == 2
+
+        params.pop("pp_size")
+        metadata.add_new_req_to_recv("req-default", ([0],), params)
+        assert metadata.reqs_to_recv["req-default"].pp_size == 1
