index 000000000..d20288c3a
--- /dev/null
+++ b/tools/laguna_weightless_fixture.py
@@ -0,0 +1,237 @@
+"""Build the Laguna S 2.1 INT4 TP/EP module graph on the meta device.
+
+Run with:
+  torchrun --standalone --nproc-per-node=4 \
+    tools/laguna_weightless_fixture.py --model /path/to/int4 \
+    --dflash /path/to/dflash
+"""
+
+import argparse
+import json
+import os
+
+import torch
+
+from vllm.config import (
+    CacheConfig,
+    ModelConfig,
+    ParallelConfig,
+    VllmConfig,
+    set_current_vllm_config,
+)
+from vllm.distributed import (
+    cleanup_dist_env_and_memory,
+    init_distributed_environment,
+    initialize_model_parallel,
+)
+from vllm.model_executor.model_loader.utils import initialize_model
+from vllm.tokenizers.registry import get_tokenizer
+from vllm.utils.torch_utils import set_default_torch_dtype
+
+
+def _parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--model", required=True)
+    parser.add_argument("--dflash")
+    parser.add_argument("--tp-size", type=int, default=4)
+    return parser.parse_args()
+
+
+def _model_config(path: str) -> ModelConfig:
+    return ModelConfig(
+        model=path,
+        tokenizer=path,
+        dtype="bfloat16",
+        skip_tokenizer_init=True,
+        max_model_len=8192,
+        enforce_eager=True,
+    )
+
+
+def main() -> None:
+    args = _parse_args()
+    rank = int(os.environ.get("RANK", "0"))
+    local_rank = int(os.environ.get("LOCAL_RANK", rank))
+    world_size = int(os.environ.get("WORLD_SIZE", "1"))
+    assert world_size == args.tp_size
+
+    tokenizer = get_tokenizer(
+        args.model,
+        local_files_only=True,
+        trust_remote_code=True,
+    )
+    assert len(tokenizer) == 100352
+    tokenizer_probe = "Laguna tokenizer integrity probe: code, math, and UTF-8 ✓"
+    tokenizer_ids = tokenizer.encode(tokenizer_probe, add_special_tokens=False)
+    assert tokenizer.decode(tokenizer_ids) == tokenizer_probe
+    assert tokenizer.apply_chat_template(
+        [{"role": "user", "content": tokenizer_probe}],
+        tokenize=False,
+        add_generation_prompt=True,
+    )
+
+    model_config = _model_config(args.model)
+    parallel_config = ParallelConfig(
+        tensor_parallel_size=args.tp_size,
+        enable_expert_parallel=True,
+    )
+    vllm_config = VllmConfig(
+        model_config=model_config,
+        cache_config=CacheConfig(block_size=16),
+        parallel_config=parallel_config,
+    )
+
+    with set_current_vllm_config(vllm_config):
+        init_distributed_environment(
+            world_size=world_size,
+            rank=rank,
+            distributed_init_method="env://",
+            local_rank=local_rank,
+            backend="gloo",
+        )
+        initialize_model_parallel(
+            tensor_model_parallel_size=args.tp_size,
+            pipeline_model_parallel_size=1,
+        )
+        # ExpertMapManager formats concrete map values for a debug string
+        # during construction.  Bypass only that formatter because Tensor.item
+        # is intentionally unavailable on meta; EP ownership itself is still
+        # constructed and asserted below.
+        from vllm.model_executor.layers.fused_moe.expert_map_manager import (
+            ExpertMapManager,
+        )
+
+        ExpertMapManager.get_compressed_map_string = lambda self: "<meta>"
+        with set_default_torch_dtype(model_config.dtype), torch.device("meta"):
+            model = initialize_model(vllm_config)
+
+    config = model_config.hf_config
+    layers = list(model.model.layers)
+    assert len(layers) == 48
+    assert {str(parameter.device) for parameter in model.parameters()} == {"meta"}
+    assert config.hidden_size == 3072
+    assert config.vocab_size == 100352
+    assert config.num_experts == 256
+    assert config.num_experts_per_tok == 10
+    assert config.shared_expert_intermediate_size == 1024
+    assert config.moe_routed_scaling_factor == 2.5
+    assert config.gating == "per-head"
+
+    full_indices = [
+        index
+        for index, kind in enumerate(config.layer_types)
+        if kind == "full_attention"
+    ]
+    sliding_indices = [
+        index
+        for index, kind in enumerate(config.layer_types)
+        if kind == "sliding_attention"
+    ]
+    assert full_indices == list(range(0, 48, 4))
+    assert len(sliding_indices) == 36
+
+    for index, layer in enumerate(layers):
+        attention = layer.self_attn
+        is_full = index in full_indices
+        total_q_heads = 48 if is_full else 72
+        assert attention.total_num_heads == total_q_heads
+        assert attention.num_heads == total_q_heads // args.tp_size
+        assert attention.total_num_kv_heads == 8
+        assert attention.num_kv_heads == 8 // args.tp_size
+        assert attention.head_dim == 128
+        assert attention.gate_per_head
+        assert attention.g_proj is not None
+        assert attention.g_proj.output_size == total_q_heads
+        assert (
+            attention.g_proj.output_size_per_partition
+            == total_q_heads // args.tp_size
+        )
+        assert attention.sliding_window == (None if is_full else 512)
+
+        if is_full:
+            assert type(attention.rotary_emb).__name__ == "YaRNScalingRotaryEmbedding"
+            assert attention.rotary_emb.base == 500000.0
+            assert attention.rotary_emb.rotary_dim == 64
+            assert attention.rotary_emb.scaling_factor == 32.0
+        else:
+            assert type(attention.rotary_emb).__name__ == "RotaryEmbedding"
+            assert attention.rotary_emb.base == 10000.0
+            assert attention.rotary_emb.rotary_dim == 128
+
+        if index == 0:
+            assert type(layer.mlp).__name__ == "LagunaMLP"
+        else:
+            assert type(layer.mlp).__name__ == "LagunaMoE"
+            assert layer.mlp.num_experts == 256
+            assert layer.mlp.top_k == 10
+            assert layer.mlp.n_shared_experts == 1
+            assert layer.mlp.shared_expert is not None
+            assert layer.mlp.routed_scaling_factor == 2.5
+            assert layer.mlp.n_local_physical_experts == 256 // args.tp_size
+
+    quant = config.quantization_config
+    weight_scheme = quant["config_groups"]["group_0"]["weights"]
+    transform_scheme = quant["transform_config"]["config_groups"]["R1"]
+    assert quant["quant_method"] == "compressed-tensors"
+    assert weight_scheme["num_bits"] == 4
+    assert weight_scheme["group_size"] == 32
+    assert weight_scheme["symmetric"] is True
+    assert transform_scheme["type"] == "hadamard"
+    assert transform_scheme["head_dim"] == 128
+
+    hadamard_modules = sum(
+        type(module).__name__ == "HadamardTransform" for module in model.modules()
+    )
+    # The official INT4 metadata contains only offline weight_input/
+    # weight_output rotations, so no runtime transform module is expected.
+    assert hadamard_modules == 0
+
+    dflash_summary = None
+    if args.dflash:
+        draft_config = _model_config(args.dflash).hf_config
+        assert draft_config.architectures == ["DFlashLagunaForCausalLM"]
+        assert draft_config.num_hidden_layers == 6
+        assert draft_config.layer_types == ["sliding_attention"] * 6
+        assert draft_config.num_attention_heads == 72
+        assert draft_config.num_key_value_heads == 8
+        assert draft_config.dflash_config["target_layer_ids"] == [1, 10, 19, 29, 38, 47]
+        assert draft_config.eagle_aux_hidden_state_layer_ids == [2, 11, 20, 30, 39, 48]
+        assert draft_config.dflash_config["block_size"] == 16
+        assert draft_config.dflash_config["mask_token_id"] == 12
+        dflash_summary = {
+            "layers": 6,
+            "target_layer_ids": draft_config.dflash_config["target_layer_ids"],
+        }
+
+    if rank == 0:
+        print(
+            json.dumps(
+                {
+                    "status": "PASS",
+                    "device": "meta",
+                    "tp_size": args.tp_size,
+                    "ep_size": args.tp_size,
+                    "layers": len(layers),
+                    "full_layers": len(full_indices),
+                    "sliding_layers": len(sliding_indices),
+                    "moe_layers": 47,
+                    "local_experts": 256 // args.tp_size,
+                    "runtime_hadamard_modules": hadamard_modules,
+                    "tokenizer": {
+                        "class": type(tokenizer).__name__,
+                        "vocab_size": len(tokenizer),
+                        "roundtrip": True,
+                        "chat_template": True,
+                    },
+                    "dflash": dflash_summary,
+                },
+                sort_keys=True,
+            )
+        )
+
+    del model
+    cleanup_dist_env_and_memory()
+
+
+if __name__ == "__main__":
+    main()
