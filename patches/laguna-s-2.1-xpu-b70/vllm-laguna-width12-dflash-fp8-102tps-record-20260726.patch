new file mode 100644
index 000000000..b08ff0ff2
--- /dev/null
+++ b/tests/v1/spec_decode/test_laguna_tree_end_to_end.py
@@ -0,0 +1,142 @@
+# SPDX-License-Identifier: Apache-2.0
+"""End-to-end simulation of the Laguna tree path on CPU.
+
+The three tree modules are unit-tested separately; this composes them into one
+cycle -- topology, then verifier metadata, then a simulated target reading each
+row through its own block table, then acceptance -- and checks the whole
+pipeline emits the target's greedy continuation.
+
+The point is to catch interface mismatches between the modules before any
+hardware time is spent on them. The "target" here reads a row's *actual*
+attended context out of a simulated KV cache, so a metadata bug that let a row
+see a sibling's token would change its prediction and fail the exactness
+assertion rather than passing silently.
+"""
+
+from __future__ import annotations
+
+import random
+
+import pytest
+
+from vllm.v1.spec_decode.laguna_tree_accept import ROOT, accept_tree
+from vllm.v1.spec_decode.laguna_tree_metadata import (
+    build_tree_verifier_plan,
+    private_blocks_per_row,
+    resolve_row_context,
+)
+from vllm.v1.spec_decode.laguna_tree_spec import build_greedy_tree, node_token_ids
+
+BLOCK_SIZE = 64
+VOCAB = 64
+
+
+def _successor(seed: int):
+    rng = random.Random(seed)
+    table = {t: rng.randrange(VOCAB) for t in range(VOCAB)}
+    return lambda token: table[token]
+
+
+def _simulate_cycle(seed: int, ctx_len: int, num_nodes: int, drafter_skill: float):
+    """One full speculative cycle, exercising every tree module."""
+    step = _successor(seed)
+    rng = random.Random(seed * 104729)
+    spec = build_greedy_tree(num_nodes)
+
+    # --- verifier metadata -------------------------------------------------
+    n_shared = ctx_len // BLOCK_SIZE + 1
+    shared = list(range(10, 10 + n_shared + 1))
+    per_row = private_blocks_per_row(BLOCK_SIZE, spec.max_depth)
+    private = list(range(900, 900 + spec.num_nodes * per_row))
+    plan = build_tree_verifier_plan(spec, ctx_len, BLOCK_SIZE, shared, private)
+
+    # --- drafter: one masked forward, top-2 per position -------------------
+    # Path-independent by construction, which is what DFlash actually does.
+    bonus = rng.randrange(VOCAB)
+    spine, token = [], bonus
+    for _ in range(spec.max_depth):
+        token = step(token)
+        spine.append(token)
+    topk = []
+    for depth in range(spec.max_depth):
+        correct = spine[depth]
+        top1 = (
+            correct
+            if rng.random() < drafter_skill
+            else (correct + 1 + rng.randrange(VOCAB - 1)) % VOCAB
+        )
+        top2 = (top1 + 1 + rng.randrange(VOCAB - 1)) % VOCAB
+        if top1 != correct and rng.random() < 0.5:
+            top2 = correct  # rank-2 sometimes carries the right token
+        topk.append([top1, top2])
+    draft = node_token_ids(spec, topk)
+
+    # --- KV cache: shared context, then the plan's copies and writes --------
+    cache: dict[int, object] = {}
+    for position in range(ctx_len):
+        cache[shared[position // BLOCK_SIZE] * BLOCK_SIZE + position % BLOCK_SIZE] = (
+            "ctx",
+            position,
+        )
+    for src, dst in zip(plan.copy_src_slot, plan.copy_dst_slot):
+        cache[dst] = cache[src]
+    for row_writes in plan.write_slot:
+        for node, slot in row_writes:
+            cache[slot] = ("tok", draft[node])
+
+    # --- target: predict from what each row genuinely attends to -----------
+    target = {ROOT: step(bonus)}
+    for row in range(spec.num_nodes):
+        slots = resolve_row_context(plan, row, BLOCK_SIZE)
+        assert len(slots) == plan.seqused_k[row]
+        attended = [cache[s] for s in slots]
+        last_kind, last_value = attended[-1]
+        assert last_kind == "tok", "a row's final attended slot must be its own token"
+        target[row] = step(last_value)
+
+    return spec, draft, target, step, bonus
+
+
+@pytest.mark.parametrize("seed", range(30))
+@pytest.mark.parametrize("ctx_len", [37, 64, 129])
+def test_full_cycle_emits_the_targets_greedy_continuation(seed, ctx_len):
+    spec, draft, target, step, bonus = _simulate_cycle(seed, ctx_len, 15, 0.75)
+    result = accept_tree(spec, draft, target)
+
+    expected, token = [], bonus
+    for _ in range(result.num_emitted):
+        token = step(token)
+        expected.append(token)
+    assert list(result.emitted_token_ids) == expected
+
+
+@pytest.mark.parametrize("seed", range(30))
+def test_a_perfect_drafter_accepts_the_whole_spine(seed):
+    spec, draft, target, _, _ = _simulate_cycle(seed, 100, 15, 1.0)
+    result = accept_tree(spec, draft, target)
+    # With every top-1 correct the walk should ride the spine to its full depth.
+    spine_depth = max(
+        spec.depth[i]
+        for i in range(spec.num_nodes)
+        if all(spec.rank[a] == 0 for a in spec.ancestors(i))
+    )
+    assert result.num_accepted == spine_depth
+
+
+@pytest.mark.parametrize("seed", range(20))
+def test_tree_accepts_at_least_as_much_as_its_spine_alone(seed):
+    """Rows spent on rank-2 must never cost accepted length."""
+    spec, draft, target, _, _ = _simulate_cycle(seed, 80, 15, 0.6)
+    tree_result = accept_tree(spec, draft, target)
+
+    spine = [
+        i
+        for i in range(spec.num_nodes)
+        if all(spec.rank[a] == 0 for a in spec.ancestors(i))
+    ]
+    accepted_on_spine = 0
+    for node in spine:
+        parent = spec.parent[node]
+        if target[parent] == draft[node] and accepted_on_spine == spec.depth[node] - 1:
+            accepted_on_spine += 1
+    assert tree_result.num_accepted >= accepted_on_spine
