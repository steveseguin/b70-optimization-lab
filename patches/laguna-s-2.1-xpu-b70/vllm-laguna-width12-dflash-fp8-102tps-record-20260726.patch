--- /dev/null
+++ b/vllm/compilation/laguna_m8_evidence.py
@@ -0,0 +1,489 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fail-closed raw-byte evidence for the Laguna M=8 diagnostic arms."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import stat
+import time
+from contextlib import suppress
+from pathlib import Path
+from typing import Any
+
+import torch
+
+from vllm.forward_context import get_forward_context, is_forward_context_available
+
+_NVME_EVIDENCE_ROOT = Path("/mnt/fast-ai")
+_VALID_ARMS = frozenset({"incumbent-eager", "segmented-eager", "segmented-graph"})
+EVIDENCE_MARKER = "LAGUNA_M8_RAW_EVIDENCE_V2"
+
+
+def laguna_m8_evidence_enabled() -> bool:
+    """Return whether the opt-in evidence recorder is armed."""
+    return os.environ.get("VLLM_XPU_LAGUNA_M8_EVIDENCE", "0") == "1"
+
+
+def laguna_m8_evidence_arm() -> str | None:
+    """Return the requested diagnostic arm, rejecting invalid opt-ins."""
+    if not laguna_m8_evidence_enabled():
+        return None
+    arm = os.environ.get("VLLM_XPU_LAGUNA_M8_EVIDENCE_ARM")
+    if arm not in _VALID_ARMS:
+        raise RuntimeError(
+            "Laguna M8 evidence requires VLLM_XPU_LAGUNA_M8_EVIDENCE_ARM "
+            f"to be one of {sorted(_VALID_ARMS)}, got {arm!r}"
+        )
+    return arm
+
+
+def active_laguna_m8_evidence_recorder() -> LagunaM8EvidenceRecorder | None:
+    """Return the evidence recorder installed on the active target forward."""
+    if not is_forward_context_available():
+        return None
+    recorder = get_forward_context().additional_kwargs.get(
+        "xpu_laguna_m8_evidence_recorder"
+    )
+    if recorder is not None and not isinstance(recorder, LagunaM8EvidenceRecorder):
+        raise RuntimeError("Laguna M8 evidence recorder has an invalid active value")
+    return recorder
+
+
+class LagunaM8EvidenceRecorder:
+    """Write private, raw-byte evidence for one target M=8 model forward.
+
+    This recorder is intentionally synchronous: evidence mode is a diagnostic
+    gate, never a performance mode. Every emitted file is atomically replaced
+    within a newly-created private run directory; any filesystem or tensor-copy
+    failure propagates to the serving request.
+    """
+
+    _sequence = 0
+
+    def __init__(self, root: str, arm: str, rank: int) -> None:
+        if arm not in _VALID_ARMS:
+            raise RuntimeError(f"Unsupported Laguna M8 evidence arm: {arm!r}")
+        evidence_root = Path(root).expanduser().resolve()
+        nvme_root = _NVME_EVIDENCE_ROOT.resolve()
+        try:
+            evidence_root.relative_to(nvme_root)
+        except ValueError as exc:
+            raise RuntimeError(
+                "Laguna M8 evidence root must be on internal NVMe under "
+                f"{nvme_root}, got {evidence_root}"
+            ) from exc
+        if evidence_root == nvme_root or not evidence_root.is_dir():
+            raise RuntimeError(
+                "Laguna M8 evidence root must be a pre-created private directory "
+                f"under {nvme_root}, got {evidence_root}"
+            )
+        evidence_stat = evidence_root.stat()
+        nvme_stat = nvme_root.stat()
+        if (
+            evidence_stat.st_dev != nvme_stat.st_dev
+            or evidence_stat.st_uid != os.getuid()
+            or stat.S_IMODE(evidence_stat.st_mode) & 0o077
+        ):
+            raise RuntimeError(
+                "Laguna M8 evidence root must be owner-private on the same "
+                "internal NVMe filesystem as /mnt/fast-ai"
+            )
+
+        type(self)._sequence += 1
+        self.arm = arm
+        self.rank = rank
+        self._event_index = 0
+        self._phase = "uninitialized"
+        self._logical_event_key: dict[str, Any] | None = None
+        self._topology_index = 0
+        self._events: list[dict[str, Any]] = []
+        self.run_dir = evidence_root / (
+            f"rank{rank:02d}-pid{os.getpid()}-evidence{self._sequence:04d}"
+        )
+        try:
+            self.run_dir.mkdir(mode=0o700)
+            (self.run_dir / "events").mkdir(mode=0o700)
+        except OSError as exc:
+            raise RuntimeError(
+                f"Could not create private Laguna M8 evidence directory {self.run_dir}"
+            ) from exc
+        self._write_manifest()
+
+    @classmethod
+    def from_env(cls, rank: int) -> LagunaM8EvidenceRecorder | None:
+        arm = laguna_m8_evidence_arm()
+        if arm is None:
+            return None
+        root = os.environ.get("VLLM_XPU_LAGUNA_M8_EVIDENCE_ROOT")
+        if not root:
+            raise RuntimeError(
+                "Laguna M8 evidence requires VLLM_XPU_LAGUNA_M8_EVIDENCE_ROOT"
+            )
+        return cls(root, arm, rank)
+
+    @staticmethod
+    def _tensor_bytes(tensor: torch.Tensor) -> bytes:
+        # A graph-owned output may be reused by a later replay. Clone before
+        # the blocking D2H copy so evidence always belongs to this event.
+        value = tensor.detach().clone()
+        if not value.is_contiguous():
+            value = value.contiguous()
+        return value.view(torch.uint8).cpu().numpy().tobytes()
+
+    @classmethod
+    def _tensor_signature(cls, tensor: torch.Tensor) -> dict[str, Any]:
+        raw = cls._tensor_bytes(tensor)
+        return {
+            "dtype": str(tensor.dtype),
+            "shape": list(tensor.shape),
+            "stride": list(tensor.stride()),
+            "device": str(tensor.device),
+            "nbytes": len(raw),
+            "sha256": hashlib.sha256(raw).hexdigest(),
+        }
+
+    @classmethod
+    def _input_signatures(cls, inputs: dict[str, Any]) -> dict[str, Any]:
+        result: dict[str, Any] = {}
+        for key in sorted(inputs):
+            value = inputs[key]
+            if isinstance(value, torch.Tensor):
+                result[key] = cls._tensor_signature(value)
+            elif value is None or isinstance(value, (bool, int, float, str)):
+                result[key] = value
+            else:
+                raise RuntimeError(
+                    "Laguna M8 evidence input signature is not canonical for "
+                    f"{key}: {type(value)!r}"
+                )
+        return result
+
+    def set_phase(self, phase: str) -> None:
+        if phase not in {"incumbent-eager", "segmented-eager", "capture", "replay"}:
+            raise RuntimeError(f"Invalid Laguna M8 evidence phase: {phase!r}")
+        self._phase = phase
+        self._topology_index = 0
+        self.record_metadata("phase", {"phase": phase})
+
+    def set_logical_event_key(self, key: dict[str, Any]) -> None:
+        required = {
+            "attention_slot_mapping_signatures",
+            "candidate_ids",
+            "positions",
+            "rank",
+            "request_generation_epoch",
+            "seq_query_metadata",
+            "target_ordinal",
+        }
+        if set(key) != required or key["rank"] != self.rank:
+            raise RuntimeError("Laguna M8 evidence logical event key is incomplete")
+        if (
+            not isinstance(key["candidate_ids"], list)
+            or not isinstance(key["positions"], list)
+            or len(key["candidate_ids"]) != 8
+            or len(key["positions"]) != 8
+        ):
+            raise RuntimeError("Laguna M8 evidence logical event key is not M=8")
+        slot_signatures = key["attention_slot_mapping_signatures"]
+        required_signature = {
+            "device",
+            "dtype",
+            "nbytes",
+            "sha256",
+            "shape",
+            "stride",
+        }
+        if (
+            not isinstance(slot_signatures, list)
+            or len(slot_signatures) != 48
+            or any(
+                not isinstance(signature, dict)
+                or set(signature) != required_signature
+                or signature["dtype"] != "torch.int64"
+                or signature["shape"] != [8]
+                or signature["stride"] != [1]
+                or signature["nbytes"] != 64
+                or signature["device"] != f"xpu:{self.rank}"
+                or not isinstance(signature["sha256"], str)
+                or len(signature["sha256"]) != 64
+                or any(
+                    character not in "0123456789abcdef"
+                    for character in signature["sha256"]
+                )
+                for signature in slot_signatures
+            )
+        ):
+            raise RuntimeError(
+                "Laguna M8 evidence logical event key lacks exact per-layer slots"
+            )
+        self._logical_event_key = key
+        self.record_metadata("logical_event_key", key)
+
+    @classmethod
+    def attention_slot_mapping_signatures(
+        cls, slot_mappings: Any, *, expected_device: str
+    ) -> list[dict[str, Any]]:
+        target_names = [f"model.layers.{layer}.self_attn.attn" for layer in range(48)]
+        draft_names = [
+            f"model.layers.{layer}.self_attn.attn" for layer in range(48, 54)
+        ]
+        expected_names = target_names + draft_names
+        if not isinstance(slot_mappings, dict) or set(slot_mappings) != set(
+            expected_names
+        ):
+            raise RuntimeError(
+                "Laguna M8 evidence requires exactly 48 target and 6 DFlash "
+                "attention slot mappings"
+            )
+        signatures_by_tensor: dict[int, dict[str, Any]] = {}
+        target_result: list[dict[str, Any]] = []
+        for layer_index, layer_name in enumerate(expected_names):
+            slot_mapping = slot_mappings[layer_name]
+            if (
+                not isinstance(slot_mapping, torch.Tensor)
+                or slot_mapping.dtype != torch.int64
+                or list(slot_mapping.shape) != [8]
+                or list(slot_mapping.stride()) != [1]
+                or str(slot_mapping.device) != expected_device
+            ):
+                raise RuntimeError(
+                    "Laguna M8 evidence requires each target or DFlash attention slot "
+                    "mapping to be a contiguous eight-row int64 tensor on "
+                    "the expected device"
+                )
+            signature = signatures_by_tensor.get(id(slot_mapping))
+            if signature is None:
+                signature = cls._tensor_signature(slot_mapping)
+                signatures_by_tensor[id(slot_mapping)] = signature
+            if layer_index < len(target_names):
+                target_result.append(dict(signature))
+        return target_result
+
+    def record_boundary(self, label: str) -> None:
+        if self._phase == "incumbent-eager":
+            raise RuntimeError("Incumbent eager arm must not emit segmented boundaries")
+        expected = self._expected_boundary(self._topology_index)
+        if label != expected:
+            raise RuntimeError(
+                "Laguna M8 evidence boundary order changed: "
+                f"saw {label}, expected {expected} at {self._topology_index}"
+            )
+        self._topology_index += 1
+        self.record_metadata(
+            "boundary", {"boundary": label, "ordinal": self._topology_index - 1}
+        )
+
+    def finish_topology(self, collective_count: int) -> None:
+        if self._topology_index != 145 or collective_count != 97:
+            raise RuntimeError(
+                "Laguna M8 evidence topology is incomplete: "
+                f"boundaries={self._topology_index}, collectives={collective_count}"
+            )
+        self.record_metadata(
+            "full_topology",
+            {
+                "boundary_count": self._topology_index,
+                "collective_count": collective_count,
+            },
+        )
+
+    @staticmethod
+    def attention_layer_index(layer_name: str) -> int:
+        match = re.search(r"(?:^|\.)layers\.(\d+)(?:\.|$)", layer_name)
+        if match is None:
+            raise RuntimeError(
+                f"Could not derive Laguna attention layer from {layer_name!r}"
+            )
+        layer = int(match.group(1))
+        if not 0 <= layer < 48:
+            raise RuntimeError(f"Laguna attention layer is outside [0, 47]: {layer}")
+        return layer
+
+    @staticmethod
+    def _expected_boundary(index: int) -> str:
+        if index == 0:
+            return "embedding_reduce"
+        if not 1 <= index < 145:
+            return "<end>"
+        layer, within_layer = divmod(index - 1, 3)
+        if within_layer == 0:
+            return f"attention:{layer}"
+        return f"gather:{2 * layer + within_layer - 1}"
+
+    def record_metadata(self, label: str, metadata: dict[str, Any]) -> None:
+        self._record(label, metadata, None)
+
+    def record_tensor(
+        self,
+        label: str,
+        output: torch.Tensor,
+        *,
+        inputs: dict[str, Any],
+        metadata: dict[str, Any] | None = None,
+    ) -> None:
+        raw = self._tensor_bytes(output)
+        details: dict[str, Any] = {
+            "output": self._tensor_signature_from_raw(output, raw),
+            "input_signatures": self._input_signatures(inputs),
+        }
+        if metadata:
+            details.update(metadata)
+        self._record(label, details, raw)
+
+    @staticmethod
+    def _tensor_signature_from_raw(tensor: torch.Tensor, raw: bytes) -> dict[str, Any]:
+        return {
+            "dtype": str(tensor.dtype),
+            "shape": list(tensor.shape),
+            "stride": list(tensor.stride()),
+            "device": str(tensor.device),
+            "nbytes": len(raw),
+            "sha256": hashlib.sha256(raw).hexdigest(),
+        }
+
+    def record_collective(
+        self,
+        label: str,
+        local: torch.Tensor,
+        output: torch.Tensor,
+        index: int | None,
+    ) -> None:
+        self.record_tensor(
+            label,
+            output,
+            inputs={"local_input": local},
+            metadata={"collective_index": index},
+        )
+
+    def record_hidden(
+        self,
+        hidden_states: torch.Tensor,
+        *,
+        input_ids: torch.Tensor | None,
+        positions: torch.Tensor | None,
+    ) -> None:
+        self.record_tensor(
+            "target_hidden_before_logits",
+            hidden_states,
+            inputs={
+                "input_ids": input_ids,
+                "positions": positions,
+            },
+        )
+
+    def record_sampled_token_ids(self, token_ids: torch.Tensor) -> None:
+        self.record_tensor("sampled_token_ids_after_logits", token_ids, inputs={})
+
+    def record_spec_acceptance(
+        self, sampled_token_ids: torch.Tensor, draft_token_ids: torch.Tensor
+    ) -> None:
+        sampled = sampled_token_ids.detach().cpu().tolist()
+        drafts = draft_token_ids.detach().cpu().flatten().tolist()
+        if len(sampled) != 1 or len(sampled[0]) != 8 or len(drafts) != 7:
+            raise RuntimeError("Laguna M8 evidence expected one 7-draft M=8 row")
+        emitted = [token for token in sampled[0] if token != -1]
+        accepted = 0
+        for proposed, emitted_token in zip(drafts, emitted, strict=False):
+            if proposed != emitted_token:
+                break
+            accepted += 1
+        self.record_sampled_token_ids(sampled_token_ids)
+        self.record_metadata(
+            "spec_acceptance_before_bookkeeping",
+            {
+                "accepted_draft_count": accepted,
+                "emitted_ids_before_bookkeeping": emitted,
+                "first_rejected_draft_index": None if accepted == 7 else accepted,
+                "proposed_draft_ids": drafts,
+            },
+        )
+
+    def record_attention_inputs(
+        self,
+        layer_name: str,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        slot_mapping: torch.Tensor,
+    ) -> int:
+        layer = self.attention_layer_index(layer_name)
+        if self.arm != "incumbent-eager":
+            self.record_boundary(f"attention:{layer}")
+        inputs = {"slot_mapping": slot_mapping}
+        self.record_tensor(f"attention_{layer:02d}_query", query, inputs=inputs)
+        self.record_tensor(f"attention_{layer:02d}_key", key, inputs=inputs)
+        self.record_tensor(f"attention_{layer:02d}_value", value, inputs=inputs)
+        return layer
+
+    def record_attention_output(
+        self, layer: int, output: torch.Tensor, slot_mapping: torch.Tensor
+    ) -> None:
+        self.record_tensor(
+            f"attention_{layer:02d}_output",
+            output,
+            inputs={"slot_mapping": slot_mapping},
+        )
+
+    def _record(self, label: str, details: dict[str, Any], raw: bytes | None) -> None:
+        event_index = self._event_index
+        self._event_index += 1
+        stem = f"{event_index:05d}-{label}"
+        event: dict[str, Any] = {
+            "event_index": event_index,
+            "label": label,
+            "phase": self._phase,
+            "rank": self.rank,
+            "details": details,
+        }
+        if self._logical_event_key is not None:
+            event["logical_event_key"] = self._logical_event_key
+        if raw is not None:
+            raw_name = f"events/{stem}.bin"
+            self._atomic_write(self.run_dir / raw_name, raw)
+            event["raw_file"] = raw_name
+        self._atomic_write(
+            self.run_dir / f"events/{stem}.json",
+            json.dumps(event, sort_keys=True, separators=(",", ":")).encode(),
+        )
+        self._events.append(event)
+        self._write_manifest()
+
+    def _write_manifest(self) -> None:
+        manifest = {
+            "arm": self.arm,
+            "event_count": len(self._events),
+            "events": self._events,
+            "format": "laguna-m8-raw-evidence-v2",
+            "marker": EVIDENCE_MARKER,
+            "rank": self.rank,
+        }
+        self._atomic_write(
+            self.run_dir / "manifest.json",
+            json.dumps(manifest, sort_keys=True, separators=(",", ":")).encode(),
+        )
+
+    @staticmethod
+    def _atomic_write(path: Path, content: bytes) -> None:
+        temporary = path.with_name(f".{path.name}.tmp-{os.getpid()}-{time.time_ns()}")
+        try:
+            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+            with os.fdopen(fd, "wb") as handle:
+                handle.write(content)
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(temporary, path)
+            directory_fd = os.open(path.parent, os.O_RDONLY)
+            try:
+                os.fsync(directory_fd)
+            finally:
+                os.close(directory_fd)
+        except OSError as exc:
+            with suppress(OSError):
+                temporary.unlink(missing_ok=True)
+            raise RuntimeError(
+                f"Atomic Laguna M8 evidence write failed for {path}"
+            ) from exc
