+# SPDX-License-Identifier: Apache-2.0
+
+import torch
+
+from vllm.model_executor.kernels.linear.scaled_mm.BlockScaledMMLinearKernel import (
+    Fp8BlockScaledMMLinearKernel,
+)
+from vllm.model_executor.kernels.linear.scaled_mm.xpu import (
+    XPUFp8BlockScaledMMKernel,
+)
+
+
+class _BlockFp8Layer(torch.nn.Module):
+    def __init__(self, prefix: str, scale: torch.Tensor) -> None:
+        super().__init__()
+        self.prefix = prefix
+        self.weight_scale_inv = torch.nn.Parameter(scale, requires_grad=False)
+
+
+def test_xpu_block_fp8_scale_prepack_is_idempotent(monkeypatch):
+    monkeypatch.setattr(
+        Fp8BlockScaledMMLinearKernel,
+        "process_weights_after_loading",
+        lambda self, layer: None,
+    )
+    kernel = object.__new__(XPUFp8BlockScaledMMKernel)
+    original = torch.arange(6, dtype=torch.float32).view(2, 3)
+    layer = _BlockFp8Layer("model.layers.0.self_attn.wq_b", original.clone())
+
+    kernel.process_weights_after_loading(layer)
+    first = layer.weight_scale_inv.clone()
+    kernel.process_weights_after_loading(layer)
+
+    torch.testing.assert_close(first, original.t().contiguous())
+    torch.testing.assert_close(layer.weight_scale_inv, first)
+    assert layer._already_called_process_weights_after_loading is True
+    assert layer._xpu_fp8_block_scale_prepacked is True
+
+
+def test_xpu_block_fp8_scale_prepack_preserves_wo_a_layout(monkeypatch):
+    monkeypatch.setattr(
+        Fp8BlockScaledMMLinearKernel,
+        "process_weights_after_loading",
+        lambda self, layer: None,
+    )
+    kernel = object.__new__(XPUFp8BlockScaledMMKernel)
+    original = torch.arange(6, dtype=torch.float32).view(2, 3)
+    layer = _BlockFp8Layer("model.layers.0.self_attn.wo_a", original.clone())
+    layer.is_bmm = True
+
+    kernel.process_weights_after_loading(layer)
+
+    torch.testing.assert_close(layer.weight_scale_inv, original)
+    assert layer._already_called_process_weights_after_loading is True
+    assert layer._xpu_fp8_block_scale_prepacked is False
+
+
+def test_xpu_block_fp8_scale_prepack_reprocesses_after_reload(monkeypatch):
+    monkeypatch.setattr(
+        Fp8BlockScaledMMLinearKernel,
+        "process_weights_after_loading",
+        lambda self, layer: None,
+    )
+    kernel = object.__new__(XPUFp8BlockScaledMMKernel)
+    original = torch.arange(6, dtype=torch.float32).view(2, 3)
+    layer = _BlockFp8Layer("model.layers.0.self_attn.wq_b", original.clone())
+
+    kernel.process_weights_after_loading(layer)
+    delattr(layer, "_already_called_process_weights_after_loading")
+    layer.weight_scale_inv = torch.nn.Parameter(original.clone(), requires_grad=False)
+    kernel.process_weights_after_loading(layer)
+
+    torch.testing.assert_close(layer.weight_scale_inv, original.t().contiguous())
+    assert layer._already_called_process_weights_after_loading is True
+    assert layer._xpu_fp8_block_scale_prepacked is True
