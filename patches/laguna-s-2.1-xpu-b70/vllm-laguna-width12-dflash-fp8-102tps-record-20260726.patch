+def _xpu_exact_rms_norm_out(
+    tensor: torch.Tensor,
+    weight: torch.Tensor,
+    output: torch.Tensor,
+    epsilon: float,
+) -> None:
+    # Keep the eager FP32 reduction tree opaque to Inductor.  Inlining this
+    # expression lets the compiled graph choose a different reduction and is
+    # already enough to change Laguna's greedy token stream.
+    normalized = tensor.float()
+    variance = normalized.pow(2).mean(dim=-1, keepdim=True)
+    normalized = normalized * torch.rsqrt(variance + epsilon)
+    normalized = normalized.to(weight.dtype) * weight
+    output.copy_(normalized.to(tensor.dtype))
+
+
+def _xpu_exact_rms_norm_out_fake(
+    tensor: torch.Tensor,
+    weight: torch.Tensor,
+    output: torch.Tensor,
+    epsilon: float,
+) -> None:
+    return
+
+
+direct_register_custom_op(
+    op_name="xpu_exact_rms_norm_out",
+    op_func=_xpu_exact_rms_norm_out,
+    mutates_args=["output"],
+    fake_impl=_xpu_exact_rms_norm_out_fake,
+)
+
+
