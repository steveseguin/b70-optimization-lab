+def _make_aux_model(monkeypatch: pytest.MonkeyPatch) -> DFlashLagunaModel:
+    monkeypatch.setattr(laguna_dflash, "_is_xpu_tensor", lambda tensor: True)
+    model = DFlashLagunaModel.__new__(DFlashLagunaModel)
+    nn.Module.__init__(model)
+    model.config = SimpleNamespace(rms_norm_eps=1e-6)
+    model.num_aux_slices = 6
+    model.aux_hidden_norms = nn.ModuleList([_FakeNorm() for _ in range(6)])
+    model.hidden_norm = _FakeNorm()
+    generator = torch.Generator().manual_seed(17)
+    for norm in model.aux_hidden_norms:
+        norm.weight.data.copy_(
+            torch.randn(3072, dtype=torch.bfloat16, generator=generator)
+        )
+    model.hidden_norm.weight.data.copy_(
+        torch.randn(3072, dtype=torch.bfloat16, generator=generator)
+    )
+    model.fc = _FakeAuxFC()
+    model._dflash_fp8_enabled = True
+    model._aux_workspaces = {}
+    model._aux_weight_signatures = None
+    model._prepare_aux_combine()
+    return model
+
+
+def _reference_aux_combine(
+    model: DFlashLagunaModel,
+    hidden_state_slices: list[torch.Tensor],
+) -> torch.Tensor:
+    normalized = []
+    for hidden_states, norm in zip(hidden_state_slices, model.aux_hidden_norms):
+        output = torch.empty_like(hidden_states)
+        _fake_rms_norm(
+            output,
+            hidden_states,
+            norm.weight,
+            norm.variance_epsilon,
+        )
+        normalized.append(output)
+    projected = model.fc(torch.cat(normalized, dim=-1))
+    output = torch.empty_like(projected)
+    _fake_rms_norm(
+        output,
+        projected,
+        model.hidden_norm.weight,
+        model.hidden_norm.variance_epsilon,
+    )
+    return output
+
