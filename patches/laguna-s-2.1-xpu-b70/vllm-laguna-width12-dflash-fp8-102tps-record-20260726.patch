+# SPDX-License-Identifier: Apache-2.0
+"""Focused correctness coverage for the XPU FP8 DeepSeek-V4 WO_A path."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.models.deepseek_v4.xpu.xpu_sparse import _xpu_fp8_wo_a
+
+
+pytestmark = pytest.mark.skipif(not torch.xpu.is_available(), reason="XPU required")
+
+
+def _ue8m0_block_quant(weight: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    n, k = weight.shape
+    blocks = weight.float().view(n // 128, 128, k // 128, 128)
+    amax = blocks.abs().amax(dim=(1, 3)).clamp_min(1.0e-10)
+    scales = torch.exp2(torch.ceil(torch.log2(amax / 448.0)))
+    quant = (
+        (blocks / scales[:, None, :, None])
+        .clamp(-448.0, 448.0)
+        .to(torch.float8_e4m3fn)
+        .view(n, k)
+    )
+    return quant, scales.to(torch.float8_e8m0fnu)
+
+
+@pytest.mark.parametrize("num_tokens", [1, 4])
+def test_xpu_fp8_wo_a_matches_dequantized_reference(num_tokens: int) -> None:
+    torch.manual_seed(17)
+    device = torch.device("xpu")
+    groups, heads_per_group = 2, 2
+    head_dim, nope_dim, rope_dim = 512, 448, 64
+    rank = 128
+    num_heads = groups * heads_per_group
+    hidden_dim = heads_per_group * head_dim
+
+    o = torch.randn(
+        num_tokens, num_heads, head_dim, dtype=torch.bfloat16, device=device
+    )
+    positions = torch.arange(num_tokens, dtype=torch.int64, device=device)
+    cos_sin = torch.randn(32, rope_dim, dtype=torch.float32, device=device)
+    weight_ref = torch.randn(
+        groups * rank, hidden_dim, dtype=torch.bfloat16, device=device
+    ) / 16
+    weight, scales = _ue8m0_block_quant(weight_ref)
+    wo_a = SimpleNamespace(weight=weight, weight_scale_inv=scales)
+
+    actual = _xpu_fp8_wo_a(
+        o,
+        positions,
+        cos_sin,
+        groups,
+        rank,
+        nope_dim,
+        rope_dim,
+        wo_a,
+    )
+
+    o_fp8, o_scales = torch.ops._xpu_C.deepseek_inv_rope_fp8_quant(
+        o,
+        positions,
+        cos_sin,
+        groups,
+        heads_per_group,
+        nope_dim,
+        rope_dim,
+    )
+    o_dequant = (
+        o_fp8.float().view(groups, num_tokens, hidden_dim // 128, 128)
+        * o_scales.float()[..., None]
+    ).view(groups, num_tokens, hidden_dim)
+    w_dequant = (
+        weight.float().view(groups, rank // 128, 128, hidden_dim // 128, 128)
+        * scales.float().view(groups, rank // 128, hidden_dim // 128)[
+            :, :, None, :, None
+        ]
+    ).view(groups, rank, hidden_dim)
+    reference = torch.bmm(o_dequant, w_dequant.transpose(1, 2))
+    reference = reference.permute(1, 0, 2).reshape(num_tokens, -1).to(torch.bfloat16)
+
+    torch.testing.assert_close(actual, reference, atol=0.125, rtol=0.03)
+    # Cached views must be reused so command-graph addresses remain fixed.
+    cached = wo_a._dsv4_xpu_fp8_bmm
+    _xpu_fp8_wo_a(
+        o,
+        positions,
+        cos_sin,
+        groups,
+        rank,
+        nope_dim,
+        rope_dim,
+        wo_a,
+    )
+    assert wo_a._dsv4_xpu_fp8_bmm is cached
+
+
+def test_xpu_fp8_wo_a_graph_replay_uses_new_inputs() -> None:
+    torch.manual_seed(23)
+    device = torch.device("xpu")
+    groups, heads_per_group = 2, 2
+    head_dim, nope_dim, rope_dim, rank = 512, 448, 64, 128
+    hidden_dim = heads_per_group * head_dim
+    cos_sin = torch.randn(32, rope_dim, dtype=torch.float32, device=device)
+    weight_ref = torch.randn(
+        groups * rank, hidden_dim, dtype=torch.bfloat16, device=device
+    ) / 16
+    weight, scales = _ue8m0_block_quant(weight_ref)
+    wo_a = SimpleNamespace(weight=weight, weight_scale_inv=scales)
+    static_o = torch.randn(
+        1, groups * heads_per_group, head_dim, dtype=torch.bfloat16, device=device
+    )
+    static_positions = torch.zeros(1, dtype=torch.int64, device=device)
+
+    # Populate cached views before capture so replay uses fixed addresses.
+    _xpu_fp8_wo_a(
+        static_o,
+        static_positions,
+        cos_sin,
+        groups,
+        rank,
+        nope_dim,
+        rope_dim,
+        wo_a,
+    )
+    torch.xpu.synchronize()
+    graph = torch.xpu.XPUGraph()
+    with torch.xpu.graph(graph):
+        captured = _xpu_fp8_wo_a(
+            static_o,
+            static_positions,
+            cos_sin,
+            groups,
+            rank,
+            nope_dim,
+            rope_dim,
+            wo_a,
+        )
+
+    replacement = torch.randn_like(static_o)
+    static_o.copy_(replacement)
+    static_positions.fill_(3)
+    graph.replay()
+    torch.xpu.synchronize()
+    expected = _xpu_fp8_wo_a(
+        replacement,
+        static_positions,
+        cos_sin,
+        groups,
+        rank,
+        nope_dim,
+        rope_dim,
+        wo_a,
+    )
+    torch.testing.assert_close(captured, expected, atol=0.125, rtol=0.03)
