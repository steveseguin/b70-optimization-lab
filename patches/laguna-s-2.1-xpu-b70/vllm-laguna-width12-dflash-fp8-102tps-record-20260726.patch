+        else:
+            weight_t = layer.weight.t().unsqueeze(0).expand(rows.shape[0], -1, -1)
+            output = torch.bmm(rows.unsqueeze(1), weight_t).squeeze(1)
+        if bias is not None:
+            output.add_(bias)
+        return output
+    scheme = getattr(layer, "scheme", None)
+    apply_batched_m1 = getattr(scheme, "apply_weights_batched_m1", None)
+    if apply_batched_m1 is None:
+        raise RuntimeError(
+            f"no exact batched-M1 XPU path for {type(method).__name__}"
+        )
+    return apply_batched_m1(layer, rows, bias)
