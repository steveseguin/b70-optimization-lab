+    # wider persistent buffers and therefore are not row-contiguous.
+    topk_backing = torch.full((num_tokens, 128), -1, dtype=torch.int32, device=device)
+    topk_indices = topk_backing[:, :topk_width]
+    topk_indices.copy_(
