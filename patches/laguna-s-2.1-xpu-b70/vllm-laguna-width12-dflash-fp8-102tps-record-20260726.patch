+
+def test_linear_attention_full_graph_metadata_uses_stable_decode_buffers():
+    vllm_config = create_vllm_config(
+        hf_config_override={
+            "architectures": ["BailingMoeV2_5ForCausalLM"],
+            "model_type": "bailing_hybrid",
+        }
