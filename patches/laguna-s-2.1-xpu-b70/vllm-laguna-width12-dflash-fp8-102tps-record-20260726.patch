+    )
+    swa_backing = torch.full((num_tokens, 128), -1, dtype=torch.int32, device=device)
+    swa_indices = swa_backing[:, :swa_width]
+    swa_indices.copy_(torch.tensor([[3, 8], [-1, 4]], dtype=torch.int32, device=device))
