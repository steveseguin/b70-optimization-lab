+    assert events == ["metadata", "sync"]
+    assert fake_get_mla_metadata_v1_mock.call_count == 1
+
+    events.clear()
+
+    builder.build(common_prefix_len=0, common_attn_metadata=common_metadata)
+
+    assert events == []
+    assert fake_get_mla_metadata_v1_mock.call_count == 1
