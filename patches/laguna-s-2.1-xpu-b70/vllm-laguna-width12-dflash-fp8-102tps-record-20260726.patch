+def test_attention_slot_mapping_signatures_are_layer_ordered():
+    from vllm.compilation.laguna_m8_evidence import LagunaM8EvidenceRecorder
+
+    mappings = {
+        f"model.layers.{layer}.self_attn.attn": torch.full(
+            (8,), layer, dtype=torch.int64
+        )
+        for layer in reversed(range(54))
+    }
+
+    signatures = LagunaM8EvidenceRecorder.attention_slot_mapping_signatures(
+        mappings, expected_device="cpu"
+    )
+
+    assert len(signatures) == 48
+    for layer, signature in enumerate(signatures):
+        expected = torch.full((8,), layer, dtype=torch.int64)
+        assert (
+            signature["sha256"]
+            == LagunaM8EvidenceRecorder._tensor_signature(expected)["sha256"]
+        )
+
+
+@pytest.mark.parametrize(
+    "mutation",
+    [
+        "missing_target",
+        "missing_draft",
+        "extra",
+        "dtype",
+        "draft_dtype",
+        "draft_shape",
+        "draft_stride",
+        "draft_device",
+        "draft_non_tensor",
+        "shape",
+        "stride",
+    ],
+)
+def test_attention_slot_mapping_signatures_reject_drift(mutation):
+    from vllm.compilation.laguna_m8_evidence import LagunaM8EvidenceRecorder
+
+    mappings = {
+        f"model.layers.{layer}.self_attn.attn": torch.arange(8) for layer in range(54)
+    }
+    if mutation == "missing_target":
+        mappings.pop("model.layers.47.self_attn.attn")
+    elif mutation == "missing_draft":
+        mappings.pop("model.layers.53.self_attn.attn")
+    elif mutation == "extra":
+        mappings["model.layers.54.self_attn.attn"] = torch.arange(8)
+    elif mutation == "dtype":
+        mappings["model.layers.7.self_attn.attn"] = torch.arange(8, dtype=torch.int32)
+    elif mutation == "draft_dtype":
+        mappings["model.layers.50.self_attn.attn"] = torch.arange(8, dtype=torch.int32)
+    elif mutation == "draft_shape":
+        mappings["model.layers.50.self_attn.attn"] = torch.arange(7)
+    elif mutation == "draft_stride":
+        mappings["model.layers.50.self_attn.attn"] = torch.arange(16)[::2]
+    elif mutation == "draft_device":
+        mappings["model.layers.50.self_attn.attn"] = torch.empty(
+            8, dtype=torch.int64, device="meta"
+        )
+    elif mutation == "draft_non_tensor":
+        mappings["model.layers.50.self_attn.attn"] = list(range(8))
+    elif mutation == "shape":
+        mappings["model.layers.7.self_attn.attn"] = torch.arange(7)
+    else:
+        mappings["model.layers.7.self_attn.attn"] = torch.arange(16)[::2]
+
+    with pytest.raises(RuntimeError, match="attention slot mapping"):
+        LagunaM8EvidenceRecorder.attention_slot_mapping_signatures(
+            mappings, expected_device="cpu"
+        )
+
