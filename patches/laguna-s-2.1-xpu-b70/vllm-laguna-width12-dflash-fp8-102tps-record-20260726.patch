new file mode 100644
index 000000000..7a372d078
--- /dev/null
+++ b/vllm/v1/spec_decode/laguna_tree_accept.py
@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Greedy acceptance over a Laguna speculative tree.
+
+Verification is a walk, not a scan. In a chain the accepted length is the
+longest matching prefix, so a linear compare suffices. In a tree the target's
+next token selects *which* child to descend into, and the walk stops at the
+first depth where no drafted child carries that token.
+
+The emitted sequence is the target's own greedy continuation either way: a node
+is only accepted when its drafted token equals what the target produced at its
+parent, and the walk always ends by emitting the target's token at the last
+accepted node. Speculation changes how many tokens come out per cycle, never
+which ones.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from vllm.v1.spec_decode.laguna_tree_spec import LagunaTreeSpec
+
+# The walk starts from the bonus token rather than from a drafted node.
+ROOT = -1
+
+
+@dataclass(frozen=True)
+class LagunaTreeAcceptance:
+    """Outcome of verifying one tree.
+
+    Attributes:
+        accepted_nodes: Row indices accepted, deepest last.
+        emitted_token_ids: Tokens to emit this cycle, in order. Always one
+            longer than ``accepted_nodes``.
+    """
+
+    accepted_nodes: tuple[int, ...]
+    emitted_token_ids: tuple[int, ...]
+
+    @property
+    def num_accepted(self) -> int:
+        return len(self.accepted_nodes)
+
+    @property
+    def num_emitted(self) -> int:
+        return len(self.emitted_token_ids)
+
+
+def accept_tree(
+    spec: LagunaTreeSpec,
+    draft_token_ids: list[int],
+    target_token_ids: dict[int, int],
+) -> LagunaTreeAcceptance:
+    """Walk the tree against the target's greedy predictions.
+
+    Args:
+        spec: The tree, breadth-first ordered.
+        draft_token_ids: ``draft_token_ids[i]`` is the token the drafter placed
+            at node ``i``.
+        target_token_ids: The target's greedy next token keyed by the row that
+            produced it, plus ``ROOT`` for the bonus token's row.
+
+    Returns:
+        The accepted path and the tokens to emit.
+
+    Raises:
+        ValueError: If the drafted tokens do not cover the tree, or the target
+            did not produce a prediction for a node the walk reached.
+    """
+    if len(draft_token_ids) != spec.num_nodes:
+        raise ValueError(
+            f"expected {spec.num_nodes} draft tokens, got {len(draft_token_ids)}"
+        )
+    if ROOT not in target_token_ids:
+        raise ValueError("target must predict from the bonus token's row")
+
+    children: dict[int, list[int]] = {}
+    for node, parent in enumerate(spec.parent):
+        children.setdefault(parent, []).append(node)
+
+    accepted: list[int] = []
+    emitted: list[int] = []
+    current = ROOT
+    while True:
+        if current not in target_token_ids:
+            raise ValueError(f"target produced no prediction for node {current}")
+        wanted = target_token_ids[current]
+        # The drafted candidates at this depth are the current node's children.
+        # At most one can match, since a parent's children carry distinct
+        # tokens; taking the first match is therefore unambiguous.
+        match = next(
+            (c for c in children.get(current, []) if draft_token_ids[c] == wanted),
+            None,
+        )
+        if match is None:
+            # Nothing drafted here matched, so the target's token is the last
+            # one this cycle emits.
+            emitted.append(wanted)
+            return LagunaTreeAcceptance(tuple(accepted), tuple(emitted))
+        accepted.append(match)
+        emitted.append(wanted)
+        current = match
+
+
+def chain_equivalent_acceptance(
+    draft_token_ids: list[int],
+    target_token_ids: list[int],
+) -> LagunaTreeAcceptance:
+    """The record's linear acceptance, for differential testing.
+
+    ``target_token_ids[i]`` is the target's prediction following draft token
+    ``i - 1``, with index 0 following the bonus token.
+    """
+    if len(target_token_ids) != len(draft_token_ids) + 1:
+        raise ValueError("target predictions must be one longer than the drafts")
+    accepted: list[int] = []
+    emitted: list[int] = []
+    for i, drafted in enumerate(draft_token_ids):
+        emitted.append(target_token_ids[i])
+        if target_token_ids[i] != drafted:
+            return LagunaTreeAcceptance(tuple(accepted), tuple(emitted))
+        accepted.append(i)
+    emitted.append(target_token_ids[-1])
+    return LagunaTreeAcceptance(tuple(accepted), tuple(emitted))
