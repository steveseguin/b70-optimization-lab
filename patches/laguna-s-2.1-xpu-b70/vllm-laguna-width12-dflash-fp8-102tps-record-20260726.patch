@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tests for the default-off Laguna DFlash cycle attribution recorder."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from vllm.v1.spec_decode.laguna_cycle_attribution import (
+    _EXPECTED_SPECULATIVE_TOKENS,
+    _MARKS_PER_CYCLE,
+    LagunaCycleAttribution,
+)
+
+
+def _labels() -> list[str]:
+    return [
+        "cycle_begin",
+        "ctxkv_begin",
+        "ctxkv_end",
+        "draft_forward_end",
+        "cycle_end",
+    ]
+
+
+def _drive_cycle(recorder: LagunaCycleAttribution) -> None:
+    recorder.begin_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+    for label in _labels()[1:-1]:
+        recorder.mark(label)
+    recorder.end_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+
+
+def test_disabled_by_default(monkeypatch):
+    monkeypatch.delenv("VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_ROOT", raising=False)
+    assert LagunaCycleAttribution.from_env(0) is None
+
+
+def test_relative_root_is_rejected(monkeypatch):
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_ROOT", "relative/path")
+    with pytest.raises(RuntimeError, match="must be absolute"):
+        LagunaCycleAttribution.from_env(0)
+
+
+@pytest.mark.parametrize("value", ["0", "4097", "abc", "-1"])
+def test_device_cycle_budget_drift_is_rejected(monkeypatch, tmp_path, value):
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_ROOT", str(tmp_path))
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_DEVICE_CYCLES", value)
+    with pytest.raises(RuntimeError, match="device-cycle count drift"):
+        LagunaCycleAttribution.from_env(0)
+
+
+def test_off_contract_depth_records_nothing(tmp_path):
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
+    # A depth other than the frozen 7 must be ignored, not guessed at.
+    recorder.begin_cycle(5)
+    recorder.mark("cycle_begin")
+    recorder.end_cycle(5)
+    output = Path(recorder.finalize())
+    payload = json.loads(output.read_text())
+    assert payload["host_cycles"] == []
+
+
+def test_mark_order_drift_fails_closed(tmp_path):
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
+    recorder.begin_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+    with pytest.raises(RuntimeError, match="mark order drift"):
+        recorder.mark("draft_forward_end")
+
+
+def test_unclosed_cycle_is_abandoned_not_recorded(tmp_path):
+    """propose() has short-circuit returns, so an open cycle is a real path."""
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
+    recorder.begin_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+    recorder.mark("ctxkv_begin")
+    # A second begin abandons the first rather than raising.
+    _drive_cycle(recorder)
+    payload = json.loads(Path(recorder.finalize()).read_text())
+    assert payload["abandoned_cycles"] == 1
+    assert len(payload["host_cycles"]) == 1
+
+
+def test_finalize_abandons_open_cycle(tmp_path):
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
+    _drive_cycle(recorder)
+    recorder.begin_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+    payload = json.loads(Path(recorder.finalize()).read_text())
+    assert payload["abandoned_cycles"] == 1
+    assert len(payload["host_cycles"]) == 1
+
+
+def test_host_cycles_recorded_without_device_events(tmp_path):
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=2, device_cycles=0)
+    for _ in range(3):
+        _drive_cycle(recorder)
+    output = Path(recorder.finalize())
+    payload = json.loads(output.read_text())
+
+    assert payload["schema"] == "laguna-cycle-attribution-v1"
+    assert payload["diagnostic_only"] is True
+    assert payload["not_benchmark_or_submission_evidence"] is True
+    assert payload["rank"] == 2
+    assert payload["marks_per_cycle"] == _MARKS_PER_CYCLE
+    assert len(payload["host_cycles"]) == 3
+    assert payload["device_intervals"] == []
+    for index, row in enumerate(payload["host_cycles"]):
+        assert row["cycle"] == index
+        assert row["num_proposals"] == _EXPECTED_SPECULATIVE_TOKENS
+        assert row["host_duration_ns"] >= 0
+
+
+def test_interval_names_cover_every_mark_gap():
+    from vllm.v1.spec_decode.laguna_cycle_attribution import _INTERVAL_NAMES
+
+    assert len(_INTERVAL_NAMES) == _MARKS_PER_CYCLE - 1
+    assert _INTERVAL_NAMES[0] == "pre_ctxkv"
+    assert _INTERVAL_NAMES[1] == "ctxkv"
+    assert _INTERVAL_NAMES[2] == "draft_forward"
+    assert _INTERVAL_NAMES[-1] == "post_draft"
+
+
+def test_payload_is_write_once_and_read_only(tmp_path):
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
+    _drive_cycle(recorder)
+    output = Path(recorder.finalize())
+    assert output.stat().st_mode & 0o777 == 0o400
+    with pytest.raises(RuntimeError, match="already complete"):
+        recorder.finalize()
+
+
+def test_payload_survives_without_finalize(tmp_path):
+    """Workers are killed rather than exited, so a periodic flush must land."""
+    from vllm.v1.spec_decode.laguna_cycle_attribution import _FLUSH_EVERY_CYCLES
+
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=1, device_cycles=0)
+    for _ in range(_FLUSH_EVERY_CYCLES):
+        _drive_cycle(recorder)
+    # No finalize call: the flush alone must have written a usable payload.
+    payload = json.loads((tmp_path / "cycle-attribution-rank1.json").read_text())
+    assert len(payload["host_cycles"]) == _FLUSH_EVERY_CYCLES
