+def test_attention_slot_mapping_signatures_hash_shared_tensors_once(monkeypatch):
+    from vllm.compilation.laguna_m8_evidence import LagunaM8EvidenceRecorder
+
+    shared = torch.arange(8)
+    mappings = {f"model.layers.{layer}.self_attn.attn": shared for layer in range(54)}
+    original = LagunaM8EvidenceRecorder._tensor_signature.__func__
+    hashed: list[torch.Tensor] = []
+
+    def counting_signature(cls, tensor):
+        hashed.append(tensor)
+        return original(cls, tensor)
+
+    monkeypatch.setattr(
+        LagunaM8EvidenceRecorder,
+        "_tensor_signature",
+        classmethod(counting_signature),
+    )
+
+    signatures = LagunaM8EvidenceRecorder.attention_slot_mapping_signatures(
+        mappings, expected_device="cpu"
+    )
+
+    assert hashed == [shared]
+    assert len(signatures) == 48
+    assert all(signature == signatures[0] for signature in signatures)
+    assert len({id(signature) for signature in signatures}) == 48
+
