diff --git a/vllm/compilation/laguna_m8_collectives.py b/vllm/compilation/laguna_m8_collectives.py
new file mode 100644
index 000000000..55221f6c6
--- /dev/null
+++ b/vllm/compilation/laguna_m8_collectives.py
@@ -0,0 +1,268 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Fail-closed eager collective boundaries for Laguna's captured M=8 target.
+
+This deliberately is not a general XPU collective facility.  The one supported
+transaction has a fixed TP4, BF16, M=8 geometry.  Its buffers live on the
+GPUModelRunner, rather than on individual layers, so all collective outputs
+have stable addresses before the first graph capture.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+import torch
+import torch.distributed as dist
+
+from vllm.distributed.parallel_state import get_tp_group
+from vllm.forward_context import get_forward_context, is_forward_context_available
+from vllm.utils.torch_utils import weak_ref_tensor
+
+# Laguna's record config has 48 attention O projections, one layer-0 dense
+# MLP down projection (`mlp_only_layers=[0]`), and 47 MoE final combines.
+_MODEL_GATHER_COUNT = 96
+_HIDDEN_SIZE = 3072
+def _laguna_rows() -> int:
+    """Verifier width for the pinned collective buffers.
+
+    Defaults to the approved record width of 8. The buffers and contracts are
+    shape-generic in structure; the constant is the proved contract width.
+    """
+    from vllm import envs
+
+    return envs.VLLM_XPU_LAGUNA_EXACT_MAX_M
+
+
+_ROWS = _laguna_rows()
+_TP = 4
+_EXPECTED_MODEL_EAGER_COLLECTIVES = _MODEL_GATHER_COUNT + 1
+
+
+class LagunaM8CollectiveState:
+    """Runner-owned fixed-address buffers for one target verifier forward."""
+
+    def __init__(self, device: torch.device) -> None:
+        self.device = device
+        # Slot order is deterministic within a forward, so slot i always sees
+        # the same shape. Allocating per slot on first use keeps the fixed
+        # address, non-aliasing, and fixed-order guarantees while allowing a
+        # verifier forward to mix widths -- a wider verifier does not share its
+        # row count with every collective in the transaction.
+        # Preallocate eagerly at construction. Allocating inside the forward
+        # deadlocked four-rank startup after XCCL topology recognition.
+        self.gathers: list[torch.Tensor | None] = [
+            torch.empty((_TP, _ROWS, _HIDDEN_SIZE), dtype=torch.bfloat16, device=device)
+            for _ in range(_MODEL_GATHER_COUNT)
+        ]
+        # At the proved record width the count is the audited constant and is
+        # asserted outright. At any other width it is learned on the first
+        # eligible forward, but a large deviation from the record topology is
+        # a regression -- per-row serialization inflates it -- so it fails
+        # rather than being normalized.
+        self._expected_gathers: int | None = (
+            _MODEL_GATHER_COUNT if _ROWS == 8 else None
+        )
+        self.embedding_reduce: torch.Tensor | None = torch.empty(
+            (_ROWS, _HIDDEN_SIZE), dtype=torch.bfloat16, device=device
+        )
+        self._next_gather = 0
+        self._executed = 0
+        self._first_reduce_seen = False
+
+    def reset_for_eligible_forward(self) -> None:
+        self._next_gather = 0
+        self._executed = 0
+        self._first_reduce_seen = False
+
+    def finish_eligible_forward(self) -> None:
+        if self._expected_gathers is None:
+            if self._next_gather > _MODEL_GATHER_COUNT * 3 // 2:
+                raise RuntimeError(
+                    "Laguna M8 collective topology exploded: saw "
+                    f"{self._next_gather} gathers against the audited "
+                    f"{_MODEL_GATHER_COUNT}; per-row serialization is the "
+                    "usual cause and must be fixed, not accepted"
+                )
+            self._expected_gathers = self._next_gather
+        if self._next_gather not in (0, self._expected_gathers):
+            raise RuntimeError(
+                "Laguna M8 collective capture/replay changed gather order: "
+                f"saw {self._next_gather}, expected 0 (replay) or "
+                f"{self._expected_gathers}"
+            )
+        if not self._first_reduce_seen:
+            raise RuntimeError(
+                "Laguna M8 model forward omitted its embedding all-reduce"
+            )
+        expected_executed = (self._expected_gathers or 0) + 1
+        if self._executed != expected_executed:
+            raise RuntimeError(
+                "Laguna M8 collective capture/replay changed eager collective "
+                f"count: saw {self._executed}, expected {expected_executed}"
+            )
+        from vllm.compilation.laguna_m8_evidence import (
+            active_laguna_m8_evidence_recorder,
+        )
+
+        if (evidence := active_laguna_m8_evidence_recorder()) is not None:
+            evidence.finish_topology(self._executed)
+
+    def _check_local(self, local: torch.Tensor) -> None:
+        if (
+            len(local.shape) != 3
+            or local.shape[0] != 1
+            or local.shape[2] != _HIDDEN_SIZE
+            or local.dtype != torch.bfloat16
+            or local.device != self.device
+            or not local.is_contiguous()
+        ):
+            raise RuntimeError(
+                f"Laguna M8 collective input drifted from its "
+                f"[1,*,{_HIDDEN_SIZE}] BF16 contiguous contract: got "
+                f"{tuple(local.shape)} {local.dtype}"
+            )
+
+    def all_gather(self, local: torch.Tensor, dim: int) -> torch.Tensor:
+        if dim not in (0, -3):
+            raise RuntimeError("Laguna M8 graph supports only dim=0 all-gather")
+        self._check_local(local)
+        if not self._first_reduce_seen:
+            raise RuntimeError("Laguna M8 gather occurred before embedding all-reduce")
+        if (
+            self._expected_gathers is not None
+            and self._next_gather >= self._expected_gathers
+        ):
+            raise RuntimeError(
+                f"Laguna M8 graph exceeded its learned "
+                f"{self._expected_gathers} BF16 all-gather slots"
+            )
+        index = self._next_gather
+        expected = (_TP, local.shape[1], _HIDDEN_SIZE)
+        output = self.gathers[index]
+        if output is None or tuple(output.shape) != expected:
+            raise RuntimeError(
+                f"Laguna M8 gather slot {index} changed shape: "
+                f"{tuple(output.shape)} -> {expected}"
+            )
+        self._next_gather += 1
+        if output.data_ptr() == local.data_ptr():
+            raise RuntimeError("Laguna M8 all-gather output aliases its input")
+
+        return _eager_break_or_run(self._run_gather, local, output, index)
+
+    def all_reduce(self, local: torch.Tensor) -> torch.Tensor:
+        if (
+            len(local.shape) != 2
+            or local.shape[1] != _HIDDEN_SIZE
+            or local.dtype != torch.bfloat16
+            or local.device != self.device
+            or not local.is_contiguous()
+            or (
+                self.embedding_reduce is not None
+                and self.embedding_reduce.data_ptr() == local.data_ptr()
+            )
+        ):
+            raise RuntimeError(
+                f"Laguna M8 embedding all-reduce drifted from fixed "
+                f"[*,{_HIDDEN_SIZE}] BF16 non-aliasing contract: got "
+                f"{tuple(local.shape)}"
+            )
+        if self._first_reduce_seen or self._next_gather:
+            raise RuntimeError(
+                "Laguna M8 embedding all-reduce changed its required first order"
+            )
+        self._first_reduce_seen = True
+
+        if tuple(self.embedding_reduce.shape) != (local.shape[0], _HIDDEN_SIZE):
+            raise RuntimeError(
+                f"Laguna M8 embedding reduce changed shape: "
+                f"{tuple(self.embedding_reduce.shape)} -> "
+                f"{(local.shape[0], _HIDDEN_SIZE)}"
+            )
+        return _eager_break_or_run(self._run_reduce, local, self.embedding_reduce)
+
+    def _run_gather(
+        self, local: torch.Tensor, output: torch.Tensor, index: int
+    ) -> torch.Tensor:
+        dist.all_gather_into_tensor(output, local, group=get_tp_group().device_group)
+        from vllm.compilation.laguna_m8_evidence import (
+            active_laguna_m8_evidence_recorder,
+        )
+
+        if (evidence := active_laguna_m8_evidence_recorder()) is not None:
+            evidence.record_boundary(f"gather:{index}")
+            evidence.record_collective("all_gather", local, output, index)
+        self._executed += 1
+        return output
+
+    def _run_reduce(self, local: torch.Tensor, output: torch.Tensor) -> torch.Tensor:
+        self._first_reduce_seen = True
+        output.copy_(local)
+        dist.all_reduce(output, group=get_tp_group().device_group)
+        from vllm.compilation.laguna_m8_evidence import (
+            active_laguna_m8_evidence_recorder,
+        )
+
+        if (evidence := active_laguna_m8_evidence_recorder()) is not None:
+            evidence.record_boundary("embedding_reduce")
+            evidence.record_collective("embedding_all_reduce", local, output, None)
+        self._executed += 1
+        return output
+
+
+def _eager_break_or_run(
+    run: Callable[..., torch.Tensor],
+    local: torch.Tensor,
+    output: torch.Tensor,
+    index: int | None = None,
+) -> torch.Tensor:
+    # Import lazily: breakable_cudagraph imports distributed graph-pool helpers.
+    from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+    capture = BreakableCUDAGraphCapture.current()
+    if capture is None or not capture._capturing:
+        return run(local, output) if index is None else run(local, output, index)
+    weak_local = weak_ref_tensor(local)
+    weak_output = weak_ref_tensor(output)
+    state = _require_active_state()
+    # Bind the state method, not the original local tensor, so replay uses the
+    # fixed graph-pool address without keeping its capture-time handle alive.
+    if index is not None:
+        return capture.add_eager(
+            lambda: state._run_gather(weak_local, weak_output, index),
+            kind="collective",
+        )
+    return capture.add_eager(
+        lambda: state._run_reduce(weak_local, weak_output),
+        kind="collective",
+    )
+
+
+def _require_active_state() -> LagunaM8CollectiveState:
+    if not is_forward_context_available():
+        raise RuntimeError("Laguna M8 collective invoked without forward context")
+    context = get_forward_context()
+    state = context.additional_kwargs.get("xpu_laguna_m8_collective_state")
+    if context.additional_kwargs.get(
+        "xpu_laguna_m8_collective_transaction_eligible"
+    ) is not True or not isinstance(state, LagunaM8CollectiveState):
+        raise RuntimeError(
+            "Laguna M8 collective invoked outside its guarded transaction"
+        )
+    return state
+
+
+def active_laguna_m8_collective_state() -> LagunaM8CollectiveState | None:
+    if not is_forward_context_available():
+        return None
+    context = get_forward_context()
+    if (
+        context.additional_kwargs.get("xpu_laguna_m8_collective_transaction_eligible")
+        is not True
+    ):
+        return None
+    state = context.additional_kwargs.get("xpu_laguna_m8_collective_state")
+    if not isinstance(state, LagunaM8CollectiveState):
+        raise RuntimeError("Laguna M8 eligible forward is missing collective state")
+    return state
