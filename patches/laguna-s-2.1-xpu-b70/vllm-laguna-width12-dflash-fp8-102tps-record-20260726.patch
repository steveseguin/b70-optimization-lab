index 000000000..ece0b4013
--- /dev/null
+++ b/vllm/v1/spec_decode/laguna_tree_metadata.py
@@ -0,0 +1,159 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Verifier metadata for a Laguna speculative tree.
+
+The exact rewrite already builds ``seqused_k`` as a per-row context length and
+``block_table`` as a per-row ``(q_width, num_blocks)`` tensor; the chain simply
+fills every row identically. A tree fills them per row instead, so it needs no
+new attention kernel and no tree-mask argument.
+
+The one thing a chain gets for free is that a node's ancestors are a *prefix* of
+the draft tokens, which is exactly what truncating ``seqused_k`` selects. A tree
+node's ancestors are not a prefix -- sibling paths interleave -- and a block
+table selects whole blocks, so siblings sharing a KV block cannot be masked
+apart. This module resolves that by giving each row private blocks holding,
+contiguously, the block-aligned tail of the shared context followed by that
+row's own ancestor path.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from vllm.v1.spec_decode.laguna_tree_spec import LagunaTreeSpec
+
+
+@dataclass(frozen=True)
+class LagunaTreeVerifierPlan:
+    """Row-wise attention metadata plus the KV copies that make it valid.
+
+    Attributes:
+        seqused_k: Per-row context length, ``ctx_len + depth(row)``.
+        block_table: Per-row block ids: the shared aligned prefix followed by
+            that row's private blocks.
+        copy_src_slot: Flat KV slot indices to read when priming private
+            blocks with the shared context tail.
+        copy_dst_slot: Flat KV slot indices those reads land in.
+        write_slot: ``write_slot[i][j]`` is where node ``j``'s own key/value
+            must be written so that row ``i`` can see it. A node is written once
+            per descendant row, which is what replaces a chain's single
+            slot_mapping entry.
+        blocks_per_row: Private blocks reserved per row.
+    """
+
+    seqused_k: tuple[int, ...]
+    block_table: tuple[tuple[int, ...], ...]
+    copy_src_slot: tuple[int, ...]
+    copy_dst_slot: tuple[int, ...]
+    write_slot: tuple[tuple[tuple[int, int], ...], ...]
+    blocks_per_row: int
+
+
+def private_blocks_per_row(block_size: int, max_depth: int) -> int:
+    """Private blocks a row needs to hold the context tail plus its path.
+
+    The tail can be up to ``block_size - 1`` tokens, so the worst case is
+    ``block_size - 1 + max_depth`` slots.
+    """
+    if block_size < 1:
+        raise ValueError("block_size must be positive")
+    if max_depth < 0:
+        raise ValueError("max_depth must be non-negative")
+    worst_case = (block_size - 1) + max_depth
+    return max(1, -(-worst_case // block_size))
+
+
+def build_tree_verifier_plan(
+    spec: LagunaTreeSpec,
+    ctx_len: int,
+    block_size: int,
+    shared_block_ids: list[int],
+    private_block_ids: list[int],
+) -> LagunaTreeVerifierPlan:
+    """Lay out per-row attention metadata for a tree.
+
+    Args:
+        spec: The tree, breadth-first ordered.
+        ctx_len: KV tokens every row shares, including the bonus token.
+        block_size: KV cache block size in tokens.
+        shared_block_ids: Block ids backing the shared context, in order.
+        private_block_ids: Free block ids to carve up, at least
+            ``spec.num_nodes * private_blocks_per_row(...)`` of them.
+
+    Returns:
+        The plan. Slot indices are flat: ``block_id * block_size + offset``.
+    """
+    if ctx_len < 0:
+        raise ValueError("ctx_len must be non-negative")
+    if block_size < 1:
+        raise ValueError("block_size must be positive")
+
+    aligned = (ctx_len // block_size) * block_size
+    tail = ctx_len - aligned
+    n_shared = aligned // block_size
+    if len(shared_block_ids) < n_shared:
+        raise ValueError(
+            f"need {n_shared} shared blocks for {ctx_len} context tokens, "
+            f"got {len(shared_block_ids)}"
+        )
+    per_row = private_blocks_per_row(block_size, spec.max_depth)
+    required = spec.num_nodes * per_row
+    if len(private_block_ids) < required:
+        raise ValueError(
+            f"need {required} private blocks ({per_row} per row for "
+            f"{spec.num_nodes} rows), got {len(private_block_ids)}"
+        )
+
+    seqused_k: list[int] = []
+    block_table: list[tuple[int, ...]] = []
+    copy_src: list[int] = []
+    copy_dst: list[int] = []
+    write_slot: list[tuple[tuple[int, int], ...]] = []
+
+    for row in range(spec.num_nodes):
+        mine = private_block_ids[row * per_row : (row + 1) * per_row]
+        row_blocks = tuple(shared_block_ids[:n_shared]) + tuple(mine)
+        block_table.append(row_blocks)
+        seqused_k.append(ctx_len + spec.depth[row])
+
+        # Prime this row's private blocks with the shared context tail, so the
+        # row's own path can continue contiguously from position ctx_len.
+        for offset in range(tail):
+            src_block = shared_block_ids[aligned // block_size]
+            copy_src.append(src_block * block_size + offset)
+            copy_dst.append(mine[0] * block_size + offset)
+
+        # Every ancestor, and the node itself, occupies one slot after the tail.
+        writes: list[tuple[int, int]] = []
+        for position, node in enumerate(spec.ancestors(row)):
+            flat = tail + position
+            writes.append(
+                (node, mine[flat // block_size] * block_size + flat % block_size)
+            )
+        write_slot.append(tuple(writes))
+
+    return LagunaTreeVerifierPlan(
+        seqused_k=tuple(seqused_k),
+        block_table=tuple(block_table),
+        copy_src_slot=tuple(copy_src),
+        copy_dst_slot=tuple(copy_dst),
+        write_slot=tuple(write_slot),
+        blocks_per_row=per_row,
+    )
+
+
+def resolve_row_context(
+    plan: LagunaTreeVerifierPlan,
+    row: int,
+    block_size: int,
+) -> list[int]:
+    """Flat KV slots row ``row`` actually attends to, in order.
+
+    This is the read side of the contract the plan promises, expressed
+    independently of it so a test can check one against the other.
+    """
+    slots: list[int] = []
+    for position in range(plan.seqused_k[row]):
+        block = plan.block_table[row][position // block_size]
+        slots.append(block * block_size + position % block_size)
+    return slots
