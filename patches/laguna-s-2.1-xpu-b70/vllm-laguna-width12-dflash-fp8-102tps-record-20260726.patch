+    if (
+        tuple(weight.shape) != expected_shape
+        or weight.dtype != torch.bfloat16
+        or not _is_xpu_tensor(weight)
+        or not weight.is_contiguous()
+        or weight.requires_grad
+    ):
+        raise RuntimeError(
+            f"Laguna DFlash FP8 source contract drifted for {label}: "
+            f"shape={tuple(weight.shape)} dtype={weight.dtype} "
+            f"device={weight.device} contiguous={weight.is_contiguous()} "
+            f"requires_grad={weight.requires_grad}"
+        )
+    quantized, scale = ops.scaled_fp8_quant(
+        weight,
+        use_per_token_if_dynamic=True,
+    )
+    quantized_t = quantized.t().contiguous()
+    scale = scale.reshape(-1).float().contiguous()
+    if (
+        quantized.dtype != torch.float8_e4m3fn
+        or tuple(quantized_t.shape) != (expected_shape[1], expected_shape[0])
+        or not quantized_t.is_contiguous()
+        or tuple(scale.shape) != (expected_shape[0],)
+        or scale.dtype != torch.float32
+        or not scale.is_contiguous()
+        or not torch.isfinite(scale).all().item()
+        or not (scale > 0).all().item()
+    ):
+        raise RuntimeError(f"Laguna DFlash FP8 quantizer contract drifted for {label}")
