@@ -0,0 +1,133 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tests for the static Laguna speculative tree topology."""
+
+from __future__ import annotations
+
+import pytest
+
+from vllm.v1.spec_decode.laguna_tree_spec import (
+    DEFAULT_RANK_PROBS,
+    LagunaTreeSpec,
+    build_chain,
+    build_greedy_tree,
+)
+
+
+def test_budget_is_spent_exactly():
+    for n in (0, 1, 7, 11, 15):
+        assert build_greedy_tree(n).num_nodes == n
+
+
+def test_parents_precede_children():
+    spec = build_greedy_tree(15)
+    for i, p in enumerate(spec.parent):
+        assert p < i
+        assert spec.depth[i] == (1 if p < 0 else spec.depth[p] + 1)
+
+
+def test_path_probability_is_the_product_along_its_path():
+    spec = build_greedy_tree(15)
+    for i in range(spec.num_nodes):
+        expected = 1.0
+        for node in spec.ancestors(i):
+            expected *= DEFAULT_RANK_PROBS[spec.rank[node]]
+        assert spec.path_prob[i] == pytest.approx(expected, rel=1e-9)
+
+
+def test_nodes_are_taken_in_decreasing_probability():
+    """Greedy is only optimal if it never passes over a better admissible node."""
+    spec = build_greedy_tree(15)
+    probs = list(spec.path_prob)
+    assert probs == sorted(probs, reverse=True)
+
+
+def test_greedy_beats_a_chain_of_the_same_budget():
+    """The whole justification for the tree: same rows, more expected tokens."""
+    for n in (11, 15):
+        tree = build_greedy_tree(n).expected_emitted_tokens()
+        chain = build_chain(n).expected_emitted_tokens()
+        assert tree > chain
+
+
+def test_full_binary_tree_is_worse_than_the_record_chain():
+    """Guards the shape choice: depth-capped branching spends the budget badly.
+
+    A full binary tree needs 2^d nodes at depth d, so a 15-node budget reaches
+    only depth 3 and scores below the 7-deep chain it would replace.
+    """
+    capped = build_greedy_tree(15, max_depth=3).expected_emitted_tokens()
+    assert capped < build_chain(7).expected_emitted_tokens()
+
+
+def test_a_single_rank_degenerates_to_the_chain():
+    spec = build_greedy_tree(7, rank_probs=(DEFAULT_RANK_PROBS[0],))
+    assert spec.is_chain()
+    assert spec.depth == tuple(range(1, 8))
+    assert spec.expected_emitted_tokens() == pytest.approx(
+        build_chain(7).expected_emitted_tokens()
+    )
+
+
+def test_expected_emitted_counts_the_bonus_token():
+    assert build_greedy_tree(0).expected_emitted_tokens() == pytest.approx(1.0)
+
+
+def test_max_depth_is_respected():
+    assert build_greedy_tree(15, max_depth=4).max_depth <= 4
+
+
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {"num_nodes": -1},
+        {"num_nodes": 4, "rank_probs": ()},
+        {"num_nodes": 4, "rank_probs": (0.5, 0.0)},
+        {"num_nodes": 4, "rank_probs": (0.2, 0.7)},
+        {"num_nodes": 4, "rank_probs": (0.7, 0.6)},
+        {"num_nodes": 4, "max_depth": 0},
+    ],
+)
+def test_invalid_inputs_are_rejected(kwargs):
+    with pytest.raises(ValueError):
+        build_greedy_tree(**kwargs)
+
+
+def test_spec_rejects_inconsistent_depth():
+    with pytest.raises(ValueError, match="disagrees with its parent chain"):
+        LagunaTreeSpec(parent=(-1, 0), depth=(1, 3), rank=(0, 0), path_prob=(0.5, 0.2))
+
+
+def test_spec_rejects_forward_reference():
+    with pytest.raises(ValueError, match="topologically ordered"):
+        LagunaTreeSpec(parent=(1, -1), depth=(2, 1), rank=(0, 0), path_prob=(0.2, 0.5))
+
+
+def test_node_tokens_follow_depth_and_rank():
+    from vllm.v1.spec_decode.laguna_tree_spec import node_token_ids
+
+    spec = build_greedy_tree(15)
+    topk = [[100 + d * 10 + r for r in range(2)] for d in range(spec.max_depth)]
+    tokens = node_token_ids(spec, topk)
+    for node, token in enumerate(tokens):
+        assert token == topk[spec.depth[node] - 1][spec.rank[node]]
+
+
+def test_same_depth_and_rank_share_a_token_under_different_parents():
+    """A parallel drafter cannot condition on the path, and this pins that."""
+    from vllm.v1.spec_decode.laguna_tree_spec import node_token_ids
+
+    spec = build_greedy_tree(15)
+    topk = [[100 + d * 10 + r for r in range(2)] for d in range(spec.max_depth)]
+    tokens = node_token_ids(spec, topk)
+    # Nodes 1 and 10 are both depth 2 rank 0, under different parents.
+    assert (spec.depth[1], spec.rank[1]) == (spec.depth[10], spec.rank[10]) == (2, 0)
+    assert spec.parent[1] != spec.parent[10]
+    assert tokens[1] == tokens[10]
+
+
+def test_insufficient_drafter_candidates_are_rejected():
+    from vllm.v1.spec_decode.laguna_tree_spec import node_token_ids
+
+    spec = build_greedy_tree(15)
+    with pytest.raises(ValueError, match="drafter's candidates do not cover"):
+        node_token_ids(spec, [[1, 2]])
