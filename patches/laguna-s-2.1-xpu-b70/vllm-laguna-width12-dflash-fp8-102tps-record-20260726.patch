+    compressed_cache = torch.zeros(
+        (num_blocks, block_size, 584), dtype=torch.uint8, device=device
+    )
+    swa_cache = torch.zeros_like(compressed_cache)
+    slots = torch.arange(num_rows, dtype=torch.int64, device=device)
+    quantize_and_insert_k_cache(
+        compressed_values, compressed_cache.view(num_blocks, -1), slots, block_size
+    )
+    quantize_and_insert_k_cache(
+        swa_values, swa_cache.view(num_blocks, -1), slots, block_size
+    )
+
+    # Match production's short logical views into wider persistent buffers.
+    compressed_backing = torch.full(
+        (num_tokens, 128), -1, dtype=torch.int32, device=device
+    )
+    compressed_indices = compressed_backing[:, :3]
+    compressed_indices.copy_(
+        torch.tensor([[1, 7, 5], [10, 3, 8]], dtype=torch.int32, device=device)
+    )
+    swa_backing = torch.full((num_tokens, 128), -1, dtype=torch.int32, device=device)
+    swa_indices = swa_backing[:, :4]
+    swa_indices.copy_(
+        torch.tensor([[2, 9, 4, 6], [11, 0, 5, 7]], dtype=torch.int32, device=device)
+    )
+    compressed_lens = torch.tensor([2, 3], dtype=torch.int32, device=device)
+    swa_lens = torch.tensor([3, 2], dtype=torch.int32, device=device)
+    q = torch.randn((num_tokens, num_heads, 512), dtype=torch.bfloat16, device=device)
+    attn_sink = torch.linspace(-1.0, 1.0, num_heads, dtype=torch.float32, device=device)
+    out = torch.empty_like(q)
+
+    def reference() -> torch.Tensor:
+        workspace = torch.empty(
+            (num_tokens, 7, 512), dtype=torch.bfloat16, device=device
+        )
+        dequant_gather_slots_into_workspace(
+            workspace,
+            compressed_cache,
+            compressed_indices,
+            block_size,
+            out_slot_offset=0,
+        )
+        dequant_gather_slots_into_workspace(
+            workspace,
+            swa_cache,
+            swa_indices,
+            block_size,
+            out_slot_offset=3,
+        )
+        packed = _pack_workspace_indices(num_tokens, 3, 4, compressed_lens, swa_lens)
+        ref, _, lse = triton_bf16_mla_sparse_interface(
+            q,
+            workspace.view(-1, 1, 512),
+            packed.unsqueeze(1),
+            512**-0.5,
+            d_v=512,
+            block_dpe=0,
+        )
+        return (ref * torch.sigmoid(lse - attn_sink.unsqueeze(0)).unsqueeze(-1)).to(
+            ref.dtype
+        )
+
+    direct_fp8_sparse_attention(
+        q,
+        compressed_cache,
+        compressed_indices,
+        compressed_lens,
+        swa_cache,
+        swa_indices,
+        swa_lens,
+        attn_sink,
+        512**-0.5,
+        out,
+    )
+    expected = reference()
+    torch.testing.assert_close(out, expected, atol=3e-2, rtol=3e-2)
+
+    split_out = torch.empty_like(q)
+    split_fp8_sparse_attention(
+        q,
+        compressed_cache,
+        compressed_indices,
+        compressed_lens,
+        swa_cache,
+        swa_indices,
+        swa_lens,
+        attn_sink,
+        512**-0.5,
+        split_out,
+    )
+    torch.testing.assert_close(split_out, expected, atol=3e-2, rtol=3e-2)
+
+    tuned_split_out = torch.empty_like(q)
+    split_fp8_sparse_attention(
+        q,
+        compressed_cache,
+        compressed_indices,
+        compressed_lens,
+        swa_cache,
+        swa_indices,
+        swa_lens,
+        attn_sink,
+        512**-0.5,
+        tuned_split_out,
+        block_h=4,
+        qk_num_warps=16,
+        pv_num_warps=4,
+    )
+    torch.testing.assert_close(tuned_split_out, split_out, atol=0, rtol=0)
+
+    graph = torch.xpu.XPUGraph()
+    with torch.xpu.graph(graph):
+        split_fp8_sparse_attention(
+            q,
+            compressed_cache,
+            compressed_indices,
+            compressed_lens,
+            swa_cache,
+            swa_indices,
+            swa_lens,
+            attn_sink,
+            512**-0.5,
+            split_out,
+        )
+    q.copy_(torch.randn_like(q))
+    compressed_indices.copy_(
+        torch.tensor([[4, 0, 6], [2, 9, 1]], dtype=torch.int32, device=device)
+    )
+    swa_indices.copy_(
+        torch.tensor([[8, 3, 10, 1], [7, 5, 0, 11]], dtype=torch.int32, device=device)
+    )
+    compressed_lens.copy_(torch.tensor([3, 1], dtype=torch.int32, device=device))
+    swa_lens.copy_(torch.tensor([2, 4], dtype=torch.int32, device=device))
+    graph.replay()
+    torch.xpu.synchronize()
+    expected = reference()
+    torch.testing.assert_close(split_out, expected, atol=3e-2, rtol=3e-2)
+    graph.reset()
+    torch.xpu.synchronize()
+
+    swa_only_lens = torch.tensor([0, 2], dtype=torch.int32, device=device)
+    swa_only_out = torch.empty_like(q)
+    direct_fp8_sparse_attention(
+        q,
+        None,
+        None,
+        None,
+        swa_cache,
+        swa_indices,
+        swa_only_lens,
+        attn_sink,
+        512**-0.5,
+        swa_only_out,
+    )
+    assert torch.isfinite(swa_only_out).all()
+    torch.testing.assert_close(swa_only_out[0], torch.zeros_like(swa_only_out[0]))
+
+    swa_workspace = torch.empty(
+        (num_tokens, 4, 512), dtype=torch.bfloat16, device=device
+    )
+    dequant_gather_slots_into_workspace(
+        swa_workspace, swa_cache, swa_indices, block_size, out_slot_offset=0
+    )
+    swa_packed = _pack_workspace_indices(num_tokens, 0, 4, None, swa_only_lens)
+    swa_ref, _, swa_lse = triton_bf16_mla_sparse_interface(
+        q,
+        swa_workspace.view(-1, 1, 512),
+        swa_packed.unsqueeze(1),
+        512**-0.5,
+        d_v=512,
+        block_dpe=0,
+    )
+    swa_ref = (
+        swa_ref * torch.sigmoid(swa_lse - attn_sink.unsqueeze(0)).unsqueeze(-1)
+    ).to(swa_ref.dtype)
+    torch.testing.assert_close(swa_only_out[1], swa_ref[1], atol=3e-2, rtol=3e-2)
+    split_fp8_sparse_attention(
+        q,
+        None,
+        None,
+        None,
+        swa_cache,
+        swa_indices,
+        swa_only_lens,
+        attn_sink,
+        512**-0.5,
+        split_out,
+    )
+    assert torch.isfinite(split_out).all()
+    torch.testing.assert_close(split_out[0], torch.zeros_like(split_out[0]))
+    torch.testing.assert_close(split_out[1], swa_ref[1], atol=3e-2, rtol=3e-2)
+
+    # Cross the BLOCK_K=16 boundary and ensure active invalid slots are
+    # excluded identically by the one-stage and split kernels.
+    long_backing = torch.full((num_tokens, 32), -1, dtype=torch.int32, device=device)
+    long_indices = long_backing[:, :20]
+    repeated = torch.arange(20, dtype=torch.int32, device=device) % num_rows
+    long_indices.copy_(repeated.unsqueeze(0).expand(num_tokens, -1))
+    long_indices[0, 5] = -1
+    long_indices[1, 3] = num_rows + 7
+    long_lens = torch.tensor([20, 17], dtype=torch.int32, device=device)
+    direct_fp8_sparse_attention(
+        q,
+        None,
+        None,
+        None,
+        swa_cache,
+        long_indices,
+        long_lens,
+        attn_sink,
+        512**-0.5,
+        swa_only_out,
+    )
+    split_fp8_sparse_attention(
+        q,
+        None,
+        None,
+        None,
+        swa_cache,
+        long_indices,
+        long_lens,
+        attn_sink,
+        512**-0.5,
+        split_out,
+    )
+    torch.testing.assert_close(split_out, swa_only_out, atol=3e-2, rtol=3e-2)
+
+    long_indices.fill_(-1)
+    no_sink = torch.full_like(attn_sink, -float("inf"))
+    direct_fp8_sparse_attention(
+        q,
+        None,
+        None,
+        None,
+        swa_cache,
+        long_indices,
+        long_lens,
+        no_sink,
+        512**-0.5,
+        swa_only_out,
+    )
+    split_fp8_sparse_attention(
+        q,
+        None,
+        None,
+        None,
+        swa_cache,
+        long_indices,
+        long_lens,
+        no_sink,
+        512**-0.5,
+        split_out,
+    )
+    assert torch.isfinite(split_out).all()
+    torch.testing.assert_close(split_out, torch.zeros_like(split_out))
+    torch.testing.assert_close(split_out, swa_only_out)
+
+
+@pytest.mark.skipif(not torch.xpu.is_available(), reason="XPU is required")
+def test_bf16_triton_sparse_mla_masked_chunks():
+    device = torch.device("xpu")
