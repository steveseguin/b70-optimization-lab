+    monkeypatch.setattr(
+        xpu_communicator,
+        "_dpep_global_cpu_barrier",
+        lambda: barriers.append(True),
+    )
+
+    output = communicator.reduce_scatterv(input_, dim=0, sizes=[1, 1])
+
+    assert calls == ["device-group"]
+    assert synchronizations == [True]
+    assert barriers == [True]
+    torch.testing.assert_close(output, input_[:1] + 10)
