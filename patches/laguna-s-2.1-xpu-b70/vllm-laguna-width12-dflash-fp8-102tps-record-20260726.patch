+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Unit tests for the opt-in Laguna M=8 evidence recorder."""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+
+def test_evidence_recorder_writes_raw_output_and_canonical_inputs(
+    monkeypatch, tmp_path
+):
+    import vllm.compilation.laguna_m8_evidence as evidence
+
+    monkeypatch.setattr(evidence, "_NVME_EVIDENCE_ROOT", tmp_path)
+    root = tmp_path / "private-run"
+    root.mkdir()
+    root.chmod(0o700)
+    recorder = evidence.LagunaM8EvidenceRecorder(str(root), "segmented-eager", rank=2)
+    recorder.set_phase("segmented-eager")
+    output = torch.tensor([[1, 2]], dtype=torch.int32)
+    input_ids = torch.tensor([[7, 8]], dtype=torch.int64)
+    recorder.record_tensor(
+        "target_hidden_before_logits", output, inputs={"input_ids": input_ids}
+    )
+
+    manifest = json.loads((recorder.run_dir / "manifest.json").read_text())
+    assert manifest["marker"] == evidence.EVIDENCE_MARKER
+    event = manifest["events"][-1]
+    assert event["details"]["output"]["sha256"]
+    assert event["details"]["input_signatures"]["input_ids"]["shape"] == [1, 2]
+    assert (recorder.run_dir / event["raw_file"]).read_bytes() == (
+        output.view(torch.uint8).numpy().tobytes()
+    )
+
