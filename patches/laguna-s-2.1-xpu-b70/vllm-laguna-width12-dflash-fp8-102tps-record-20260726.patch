+def _xpu_rank_order_all_reduce(input_: torch.Tensor) -> torch.Tensor:
+    """Deterministic TP sum using rank-ordered local additions.
+
+    XCCL's all-reduce can select different reduction trees between otherwise
+    identical calls. Laguna has sufficiently narrow logit margins that a
+    one-ULP BF16 change can alter greedy decoding. All-gather only transports
+    each rank's local result; summing rank 0, 1, ... in a fixed order makes the
+    target teacher stable and gives q=1 and speculative verification the same
+    reduction arithmetic.
+    """
+    tp_size = get_tensor_model_parallel_world_size()
+    gathered = tensor_model_parallel_all_gather(input_.unsqueeze(0), dim=0)
+    if tp_size == 4 and hasattr(torch.ops._xpu_C, "rank_order_bf16_sum"):
+        return torch.ops._xpu_C.rank_order_bf16_sum(gathered.contiguous())
+    output = gathered[0].clone()
+    for rank in range(1, tp_size):
+        output.add_(gathered[rank])
+    return output
+
+
+def xpu_laguna_exact_max_m() -> int:
+    """Widest verifier batch the exact M=1-lane path may accept.
+
+    Defaults to 8, which is the approved record width. The stride-zero BMM
+    that preserves per-row arithmetic is M-generic, so this cap is a contract
+    boundary rather than a kernel limit; widening it must be re-proved exact.
+    """
+    value = envs.VLLM_XPU_LAGUNA_EXACT_MAX_M
+    if not 1 <= value <= 16:
+        raise RuntimeError("VLLM_XPU_LAGUNA_EXACT_MAX_M must be within 1..16")
+    return value
+
+
+def _xpu_is_exact_decode_or_verifier_rows(num_rows: int) -> bool:
+    """True for target M=1 decode or an explicitly marked verifier pass."""
+    if num_rows == 1:
