diff --git a/vllm/v1/spec_decode/laguna_cycle_attribution.py b/vllm/v1/spec_decode/laguna_cycle_attribution.py
new file mode 100644
index 000000000..84dc57a07
--- /dev/null
+++ b/vllm/v1/spec_decode/laguna_cycle_attribution.py
@@ -0,0 +1,297 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Default-off cycle attribution for the Laguna DFlash speculative loop.
+
+The existing replay event profile in ``breakable_cudagraph`` measures the M=8
+target replay exhaustively and the DFlash draft not at all. This module adds
+the missing half: per-cycle host wall time for every cycle, and bounded
+current-stream device intervals around the context-KV precompute and the
+single masked parallel draft forward.
+
+It is diagnostic instrumentation. It records timing only; it changes no tensor,
+arithmetic, kernel argument, graph, collective, or boundary order. With the
+selector unset it allocates nothing and every call site is a single ``is None``
+test.
+"""
+
+from __future__ import annotations
+
+import atexit
+import contextlib
+import json
+import os
+import stat
+import time
+from typing import Any
+
+import torch
+
+_ROOT_ENV = "VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_ROOT"
+_DEVICE_CYCLES_ENV = "VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_DEVICE_CYCLES"
+_EXPECTED_SPECULATIVE_TOKENS = 7
+
+# DFlash is a parallel drafter: all speculative tokens come from a single
+# masked forward, so a cycle is cycle_begin, ctxkv_begin, ctxkv_end,
+# draft_forward_end, cycle_end.
+_MARKS_PER_CYCLE = 5
+_DEFAULT_DEVICE_CYCLES = 256
+_FLUSH_EVERY_CYCLES = 32
+_TOPK_PROBE_ENV = "VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_TOPK_PROBE"
+
+_LABELS: tuple[str, ...] = (
+    "cycle_begin",
+    "ctxkv_begin",
+    "ctxkv_end",
+    "draft_forward_end",
+    "cycle_end",
+)
+
+_INTERVAL_NAMES: tuple[str, ...] = (
+    "pre_ctxkv",
+    "ctxkv",
+    "draft_forward",
+    "post_draft",
+)
+
+
+class LagunaCycleAttribution:
+    """One-shot, rank-local attribution recorder for the DFlash draft cycle."""
+
+    def __init__(self, root: str, rank: int, device_cycles: int) -> None:
+        self._root = root
+        self._rank = rank
+        self._device_cycles = device_cycles
+        self._complete = False
+
+        # Host timing for every cycle; device events for a bounded prefix.
+        self._host_cycles: list[dict[str, int]] = []
+        self._events: list[Any] = []
+        self._stream_identity: dict[str, Any] | None = None
+
+        self._cycle_index = -1
+        self._armed = False
+        self._mark_index = 0
+        self._cycle_host_begin_ns = 0
+        self._events_at_cycle_start = 0
+        self._abandoned = 0
+        self._topk_probe: list[dict[str, int]] = []
+
+        # The recorder spans a whole generation rather than a single replay, so
+        # the payload is written at interpreter shutdown. A failure there must
+        # leave no artifact rather than a partial one.
+        atexit.register(self._finalize_at_exit)
+
+    def _finalize_at_exit(self) -> None:
+        if self._complete or not self._host_cycles:
+            return
+        # Diagnostic only: a shutdown failure must leave no artifact rather
+        # than a partial one, and must never disturb interpreter teardown.
+        with contextlib.suppress(BaseException):
+            self.finalize()
+
+    @classmethod
+    def from_env(cls, rank: int) -> LagunaCycleAttribution | None:
+        root = os.environ.get(_ROOT_ENV)
+        if not root:
+            return None
+        if not os.path.isabs(root):
+            raise RuntimeError("Laguna cycle attribution root must be absolute")
+        raw = os.environ.get(_DEVICE_CYCLES_ENV)
+        if raw is None:
+            device_cycles = _DEFAULT_DEVICE_CYCLES
+        else:
+            if not raw.isdigit():
+                raise RuntimeError("Laguna cycle attribution device-cycle count drift")
+            device_cycles = int(raw)
+            if device_cycles < 1 or device_cycles > 4096:
+                raise RuntimeError("Laguna cycle attribution device-cycle count drift")
+        return cls(root=root, rank=int(rank), device_cycles=device_cycles)
+
+    # -- lifecycle ---------------------------------------------------------
+
+    def _stream_snapshot(self) -> dict[str, Any]:
+        stream = torch.xpu.current_stream()
+        try:
+            return {
+                "device_type": str(stream.device_type),
+                "device_index": int(stream.device_index),
+                "stream_id": int(stream.stream_id),
+            }
+        except (AttributeError, TypeError, ValueError) as exc:
+            raise RuntimeError("XPU stream identity is unavailable") from exc
+
+    def wants_topk_probe(self) -> bool:
+        return self._armed and os.environ.get(_TOPK_PROBE_ENV) == "1"
+
+    def _device_active(self) -> bool:
+        return self._armed and self._cycle_index < self._device_cycles
+
+    def _abandon_open_cycle(self) -> None:
+        """Discard a cycle that exited before ``end_cycle``.
+
+        ``propose`` has short-circuit returns that never reach the final
+        statement, so an open cycle is a legitimate control path rather than a
+        contract breach. Its partial marks are dropped so that the recorded
+        data stays whole, and the count is reported.
+        """
+        del self._events[self._events_at_cycle_start :]
+        self._abandoned += 1
+        self._armed = False
+
+    def begin_cycle(self, num_speculative_tokens: int) -> None:
+        if self._complete:
+            raise RuntimeError("Laguna cycle attribution is already complete")
+        if self._armed:
+            self._abandon_open_cycle()
+        if num_speculative_tokens != _EXPECTED_SPECULATIVE_TOKENS:
+            # Depth drift is out of contract; record nothing rather than guess.
+            return
+        self._cycle_index += 1
+        self._armed = True
+        self._mark_index = 0
+        self._events_at_cycle_start = len(self._events)
+        identity = self._stream_snapshot()
+        if self._stream_identity is None:
+            self._stream_identity = identity
+        elif identity != self._stream_identity:
+            raise RuntimeError("Laguna cycle attribution stream drift")
+        self._cycle_host_begin_ns = time.perf_counter_ns()
+        self.mark("cycle_begin")
+
+    def mark(self, label: str) -> None:
+        if not self._armed:
+            return
+        expected = _LABELS[self._mark_index]
+        if label != expected:
+            raise RuntimeError(
+                f"Laguna cycle attribution mark order drift: {label} != {expected}"
+            )
+        if self._device_active():
+            event = torch.xpu.Event(enable_timing=True)
+            event.record(torch.xpu.current_stream())
+            self._events.append(event)
+        self._mark_index += 1
+
+    def record_topk_probe(
+        self,
+        top1: int,
+        top2: int,
+        entry_next_token_id: int,
+        entry_num_rejected: int,
+    ) -> None:
+        """Record position-0 draft top-2 against the target's realised token.
+
+        ``entry_*`` describe the state on entry to this cycle, so they report
+        the outcome of the *previous* cycle. Joined offline.
+        """
+        if not self._armed:
+            return
+        self._topk_probe.append(
+            {
+                "cycle": self._cycle_index,
+                "top1": int(top1),
+                "top2": int(top2),
+                "entry_next_token_id": int(entry_next_token_id),
+                "entry_num_rejected": int(entry_num_rejected),
+            }
+        )
+
+    def end_cycle(self, num_proposals: int) -> None:
+        if not self._armed:
+            return
+        self.mark("cycle_end")
+        if self._mark_index != _MARKS_PER_CYCLE:
+            raise RuntimeError("Laguna cycle attribution mark count drift")
+        host_end_ns = time.perf_counter_ns()
+        self._host_cycles.append(
+            {
+                "cycle": self._cycle_index,
+                "host_duration_ns": host_end_ns - self._cycle_host_begin_ns,
+                "num_proposals": int(num_proposals),
+            }
+        )
+        self._armed = False
+        if len(self._host_cycles) % _FLUSH_EVERY_CYCLES == 0:
+            self._flush()
+
+    # -- output ------------------------------------------------------------
+
+    def _device_intervals(self) -> list[dict[str, Any]]:
+        """Intervals for fully completed event blocks only.
+
+        Never synchronizes: a sync would perturb the very timing being
+        measured. Blocks whose events have not retired yet are skipped and
+        picked up by a later flush.
+        """
+        if not self._events:
+            return []
+        if len(self._events) % _MARKS_PER_CYCLE != 0:
+            raise RuntimeError("Laguna cycle attribution event count drift")
+        intervals: list[dict[str, Any]] = []
+        for cycle in range(len(self._events) // _MARKS_PER_CYCLE):
+            base = cycle * _MARKS_PER_CYCLE
+            marks = self._events[base : base + _MARKS_PER_CYCLE]
+            if not all(event.query() for event in marks):
+                continue
+            for offset, name in enumerate(_INTERVAL_NAMES):
+                start, end = marks[offset], marks[offset + 1]
+                elapsed_ms = start.elapsed_time(end)
+                if not isinstance(elapsed_ms, (float, int)) or elapsed_ms < 0:
+                    raise RuntimeError("invalid Laguna cycle attribution duration")
+                intervals.append(
+                    {
+                        "cycle": cycle,
+                        "interval": name,
+                        "duration_ns": int(round(elapsed_ms * 1_000_000)),
+                    }
+                )
+        return intervals
+
+    def _output_path(self) -> str:
+        return os.path.join(self._root, f"cycle-attribution-rank{self._rank}.json")
+
+    def _flush(self) -> str:
+        """Atomically replace the payload. Safe to call repeatedly."""
+        payload = self._payload()
+        os.makedirs(self._root, mode=0o700, exist_ok=True)
+        output = self._output_path()
+        temporary = f"{output}.tmp"
+        descriptor = os.open(
+            temporary,
+            os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0),
+            0o600,
+        )
+        with os.fdopen(descriptor, "w") as handle:
+            json.dump(payload, handle, indent=2, sort_keys=True)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, output)
+        return output
+
+    def finalize(self) -> str:
+        if self._complete:
+            raise RuntimeError("Laguna cycle attribution is already complete")
+        if self._armed:
+            self._abandon_open_cycle()
+        output = self._flush()
+        os.chmod(output, stat.S_IRUSR)
+        self._complete = True
+        return output
+
+    def _payload(self) -> dict[str, Any]:
+        payload = {
+            "schema": "laguna-cycle-attribution-v1",
+            "status": "complete",
+            "diagnostic_only": True,
+            "not_benchmark_or_submission_evidence": True,
+            "rank": self._rank,
+            "num_speculative_tokens": _EXPECTED_SPECULATIVE_TOKENS,
+            "marks_per_cycle": _MARKS_PER_CYCLE,
+            "interval_names": list(_INTERVAL_NAMES),
+            "stream_identity": self._stream_identity,
+            "device_cycle_budget": self._device_cycles,
+            "abandoned_cycles": self._abandoned,
+            "topk_probe": self._topk_probe,
+            "host_cycles": self._host_cycles,
+            "device_intervals": self._device_intervals(),
+        }
+        return payload
