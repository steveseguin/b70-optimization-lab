--- /dev/null
+++ b/vllm/v1/spec_decode/laguna_tree_spec.py
@@ -0,0 +1,221 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Static speculative tree topology for the Laguna exact verifier.
+
+The verifier's exact rewrite re-expresses a q-row verification chunk as q
+independent one-token sequences, so a tree node costs exactly one row. What
+shape those rows take is a budget allocation problem, and this module solves it
+once, offline.
+
+Why the topology is static rather than chosen per step: the breakable graph is
+captured against an audited segment count, so a topology that varied with the
+drafter's confidence would change the captured shape and break the audit. DFlash
+also makes a static shape the natural choice -- it drafts every position from a
+single masked forward, so its distribution at a position does not depend on the
+token chosen at the previous one, and the useful branching structure is a
+property of the model rather than of the current step.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+# Measured over 2,131 record-configuration cycles: the target's greedy token is
+# the drafter's first choice 72.2% of the time and within its first two 84.2%.
+# Conditioned the way the chain's acceptance is, that is a 0.756 rank-1 rate and
+# a 0.126 increment for rank 2.
+DEFAULT_RANK_PROBS: tuple[float, ...] = (0.756, 0.126)
+
+
+@dataclass(frozen=True)
+class LagunaTreeSpec:
+    """A verification tree flattened into verifier rows.
+
+    Rows are in breadth-first order by construction, so a node always appears
+    after its parent. That ordering is what lets acceptance walk the tree in a
+    single forward pass over the rows.
+
+    Attributes:
+        parent: ``parent[i]`` is the row index of node ``i``'s parent, or -1 for
+            a depth-1 node whose parent is the bonus token.
+        depth: ``depth[i]`` is the node's distance from the bonus token, 1-based.
+        rank: ``rank[i]`` is which drafter candidate this node takes at its
+            position, 0 for the top-1 token and 1 for the second.
+        path_prob: ``path_prob[i]`` is the probability the target's greedy
+            continuation reaches and matches this node.
+    """
+
+    parent: tuple[int, ...]
+    depth: tuple[int, ...]
+    rank: tuple[int, ...]
+    path_prob: tuple[float, ...]
+
+    def __post_init__(self) -> None:
+        n = len(self.parent)
+        if not (len(self.depth) == len(self.rank) == len(self.path_prob) == n):
+            raise ValueError("Laguna tree spec fields must be the same length")
+        for i, p in enumerate(self.parent):
+            if p >= i:
+                raise ValueError(
+                    "Laguna tree spec must be topologically ordered: node "
+                    f"{i} has parent {p}"
+                )
+            expected_depth = 1 if p < 0 else self.depth[p] + 1
+            if self.depth[i] != expected_depth:
+                raise ValueError(
+                    f"Laguna tree spec depth {self.depth[i]} at node {i} "
+                    f"disagrees with its parent chain ({expected_depth})"
+                )
+
+    @property
+    def num_nodes(self) -> int:
+        return len(self.parent)
+
+    @property
+    def max_depth(self) -> int:
+        return max(self.depth) if self.depth else 0
+
+    def is_chain(self) -> bool:
+        """True when the tree degenerates to the record's linear chain."""
+        return all(r == 0 for r in self.rank)
+
+    def expected_emitted_tokens(self) -> float:
+        """Expected tokens emitted per cycle, including the bonus token.
+
+        The target's greedy continuation matches at most one node at each depth
+        and those events are disjoint, so the expected accepted length is just
+        the sum of the node path probabilities.
+        """
+        return 1.0 + sum(self.path_prob)
+
+    def ancestors(self, node: int) -> list[int]:
+        """Row indices from the shallowest ancestor down to ``node`` itself."""
+        chain: list[int] = []
+        while node >= 0:
+            chain.append(node)
+            node = self.parent[node]
+        chain.reverse()
+        return chain
+
+
+def build_greedy_tree(
+    num_nodes: int,
+    rank_probs: tuple[float, ...] = DEFAULT_RANK_PROBS,
+    max_depth: int | None = None,
+) -> LagunaTreeSpec:
+    """Spend a fixed node budget on the highest-probability paths.
+
+    Greedy is optimal here. Expected accepted length is the sum of the included
+    nodes' path probabilities, a node can only be included after its parent, and
+    a child's probability never exceeds its parent's -- so repeatedly taking the
+    highest-probability admissible node maximises the sum.
+
+    This is why the shape matters: a full binary tree needs 2^d nodes at depth d,
+    so a 15-node budget buys only depth 3 and scores *below* the 7-deep chain it
+    would replace. Greedy instead lays most of the budget along the top-1 spine
+    and branches only near the root, where a second candidate is still worth
+    more than another node of depth.
+
+    Args:
+        num_nodes: Verifier rows available for draft tokens, i.e. ``M - 1``.
+        rank_probs: Per-position acceptance for each drafter candidate rank,
+            highest first.
+        max_depth: Optional cap on tree depth. ``None`` leaves it unbounded.
+
+    Returns:
+        The tree, breadth-first ordered so parents precede children.
+    """
+    if num_nodes < 0:
+        raise ValueError("num_nodes must be non-negative")
+    if not rank_probs or any(p <= 0.0 for p in rank_probs):
+        raise ValueError("rank_probs must be non-empty and positive")
+    if list(rank_probs) != sorted(rank_probs, reverse=True):
+        raise ValueError("rank_probs must be ordered highest first")
+    if sum(rank_probs) > 1.0:
+        raise ValueError("rank_probs must not sum above 1")
+    if max_depth is not None and max_depth < 1:
+        raise ValueError("max_depth must be positive when set")
+
+    # Frontier entries are candidate nodes not yet taken, keyed by path
+    # probability. Taking one admits its own children as new candidates.
+    # (-prob sorts descending; parent index breaks ties deterministically.)
+    frontier: list[tuple[float, int, int, int]] = [
+        (-rank_probs[r], -1, 1, r) for r in range(len(rank_probs))
+    ]
+    parent: list[int] = []
+    depth: list[int] = []
+    rank: list[int] = []
+    path_prob: list[float] = []
+
+    while len(parent) < num_nodes and frontier:
+        frontier.sort()
+        neg_prob, node_parent, node_depth, node_rank = frontier.pop(0)
+        index = len(parent)
+        parent.append(node_parent)
+        depth.append(node_depth)
+        rank.append(node_rank)
+        path_prob.append(-neg_prob)
+
+        if max_depth is not None and node_depth >= max_depth:
+            continue
+        for child_rank, child_p in enumerate(rank_probs):
+            frontier.append((neg_prob * child_p, index, node_depth + 1, child_rank))
+
+    return LagunaTreeSpec(
+        parent=tuple(parent),
+        depth=tuple(depth),
+        rank=tuple(rank),
+        path_prob=tuple(path_prob),
+    )
+
+
+def build_chain(
+    num_nodes: int, rank_prob: float = DEFAULT_RANK_PROBS[0]
+) -> LagunaTreeSpec:
+    """The record's linear chain, expressed as a tree for direct comparison."""
+    if num_nodes < 0:
+        raise ValueError("num_nodes must be non-negative")
+    return LagunaTreeSpec(
+        parent=tuple(range(-1, num_nodes - 1)),
+        depth=tuple(range(1, num_nodes + 1)),
+        rank=(0,) * num_nodes,
+        path_prob=tuple(rank_prob ** (d + 1) for d in range(num_nodes)),
+    )
+
+
+def node_token_ids(
+    spec: LagunaTreeSpec,
+    topk_token_ids: list[list[int]],
+) -> list[int]:
+    """Map the drafter's per-position candidates onto tree nodes.
+
+    DFlash drafts every position from one masked forward, so its distribution at
+    a position is a marginal over paths rather than a continuation of the token
+    chosen before it. A node therefore takes the candidate at its own depth and
+    rank, and two nodes at the same depth and rank receive the same token even
+    under different parents.
+
+    That is a genuine limitation, not a modelling convenience: a node whose
+    ancestry departs from the top-1 spine is drafted from a distribution that
+    assumed the spine, so its acceptance is lower than its depth and rank alone
+    imply. It bounds how much a tree can win over DFlash specifically, and it is
+    why deep off-spine branches are not worth their rows.
+
+    Args:
+        spec: The tree.
+        topk_token_ids: ``topk_token_ids[d][r]`` is the drafter's rank-``r``
+            candidate for depth ``d + 1``.
+
+    Returns:
+        One token id per node, indexed by row.
+    """
+    tokens: list[int] = []
+    for node in range(spec.num_nodes):
+        depth, rank = spec.depth[node] - 1, spec.rank[node]
+        if depth >= len(topk_token_ids) or rank >= len(topk_token_ids[depth]):
+            raise ValueError(
+                f"node {node} needs depth {depth + 1} rank {rank + 1}, "
+                "which the drafter's candidates do not cover"
+            )
+        tokens.append(topk_token_ids[depth][rank])
+    return tokens
