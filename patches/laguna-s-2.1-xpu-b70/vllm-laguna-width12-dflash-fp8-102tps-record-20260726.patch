+def test_logical_event_key_has_no_singular_slot_mapping(monkeypatch, tmp_path):
+    import vllm.compilation.laguna_m8_evidence as evidence
+
+    monkeypatch.setattr(evidence, "_NVME_EVIDENCE_ROOT", tmp_path)
+    root = tmp_path / "private-run"
+    root.mkdir(mode=0o700)
+    recorder = evidence.LagunaM8EvidenceRecorder(str(root), "incumbent-eager", rank=0)
+    slot_signatures = [
+        {
+            "device": "xpu:0",
+            "dtype": "torch.int64",
+            "nbytes": 64,
+            "sha256": f"{layer:064x}",
+            "shape": [8],
+            "stride": [1],
+        }
+        for layer in range(48)
+    ]
+    logical_key = {
+        "attention_slot_mapping_signatures": slot_signatures,
+        "candidate_ids": list(range(8)),
+        "positions": list(range(8)),
+        "rank": 0,
+        "request_generation_epoch": 34,
+        "seq_query_metadata": {
+            "num_reqs": 1,
+            "num_tokens_padded": 8,
+            "num_tokens_unpadded": 8,
+            "query_len": 8,
+        },
+        "target_ordinal": 1,
+    }
+
+    recorder.set_logical_event_key(logical_key)
+
+    manifest = json.loads((recorder.run_dir / "manifest.json").read_text())
+    assert manifest["events"][-1]["details"] == logical_key
+
+    with pytest.raises(RuntimeError, match="logical event key is incomplete"):
+        recorder.set_logical_event_key({**logical_key, "slot_mapping_sha256": "0" * 64})
+    for field, value in (
+        ("device", "xpu:1"),
+        ("sha256", "not-a-digest"),
+        ("stride", [2]),
+    ):
+        invalid_signatures = [dict(signature) for signature in slot_signatures]
+        invalid_signatures[7][field] = value
+        with pytest.raises(RuntimeError, match="lacks exact per-layer slots"):
+            recorder.set_logical_event_key(
+                {
+                    **logical_key,
+                    "attention_slot_mapping_signatures": invalid_signatures,
+                }
+            )
+
