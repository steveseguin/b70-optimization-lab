--- /dev/null
+++ b/vllm/models/deepseek_v4/xpu/divergence_capture.py
@@ -0,0 +1,261 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Low-perturbation tensor capture for DeepSeek V4 XPU diagnostics.
+
+The recorder is disabled unless ``VLLM_XPU_V4_DIVERGENCE_CAPTURE_DIR`` is
+set.  While its arm file exists, calls only enqueue device-to-device clones.
+Removing the arm file makes the next model forward flush the queued tensors to
+disk before that (unmeasured) forward starts.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from dataclasses import dataclass
+from datetime import datetime, timezone
+from pathlib import Path
+
+import torch
+
+CAPTURE_DIR = os.environ.get("VLLM_XPU_V4_DIVERGENCE_CAPTURE_DIR", "")
+ARM_FILE = os.environ.get(
+    "VLLM_XPU_V4_DIVERGENCE_ARM_FILE", "/tmp/deepseek-v4-divergence-capture.arm"
+)
+WARMUP_FILE = os.environ.get("VLLM_XPU_V4_DIVERGENCE_WARMUP_FILE", "")
+CAPTURE_STAGES = {
+    value.strip()
+    for value in os.environ.get("VLLM_XPU_V4_DIVERGENCE_STAGES", "layer_out").split(",")
+    if value.strip()
+}
+CAPTURE_MODE = os.environ.get("VLLM_XPU_V4_DIVERGENCE_MODE", "hash")
+MAX_RECORDS = int(os.environ.get("VLLM_XPU_V4_DIVERGENCE_MAX_RECORDS", "2048"))
+
+
+def _parse_layers(value: str) -> set[int] | None:
+    value = value.strip()
+    if not value or value == "all":
+        return None
+    layers: set[int] = set()
+    for part in value.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            first, last = part.split("-", 1)
+            layers.update(range(int(first), int(last) + 1))
+        else:
+            layers.add(int(part))
+    return layers
+
+
+CAPTURE_LAYERS = _parse_layers(os.environ.get("VLLM_XPU_V4_DIVERGENCE_LAYERS", "all"))
+
+
+@dataclass
+class _Record:
+    forward: int
+    layer: int | None
+    stage: str
+    name: str
+    tensor: torch.Tensor
+    metadata: dict[str, object]
+    clone_at_enqueue: bool = True
+
+
+def _tensor_metadata(tensor: torch.Tensor) -> dict[str, object]:
+    storage = tensor.untyped_storage()
+    return {
+        "data_ptr": tensor.data_ptr(),
+        "storage_data_ptr": storage.data_ptr(),
+        "storage_nbytes": storage.nbytes(),
+        "storage_offset": tensor.storage_offset(),
+        "stride": list(tensor.stride()),
+        "device": str(tensor.device),
+        "requires_grad": tensor.requires_grad,
+    }
+
+
+def gather_logical_cache_rows(cache: torch.Tensor, slots: torch.Tensor) -> torch.Tensor:
+    """Gather flattened logical rows without requiring contiguous storage."""
+    if cache.ndim < 3:
+        raise ValueError(
+            f"expected cache with at least 3 dimensions, got {cache.shape}"
+        )
+    block_size = cache.shape[1]
+    flat_slots = slots.to(torch.int64).reshape(-1)
+    blocks = flat_slots // block_size
+    offsets = flat_slots % block_size
+    rows = cache[blocks, offsets]
+    return rows.reshape(*slots.shape, -1)
+
+
+class DivergenceRecorder:
+    def __init__(self) -> None:
+        self.enabled = bool(CAPTURE_DIR)
+        self._was_armed = False
+        self._warming = False
+        self._active_forward: int | None = None
+        self._next_forward = 0
+        self._records: list[_Record] = []
+        self._static_keys: set[tuple[int | None, str, str]] = set()
+        self._capture_positions = {
+            int(value.strip())
+            for value in os.environ.get("VLLM_XPU_V4_DIVERGENCE_POSITIONS", "").split(
+                ","
+            )
+            if value.strip()
+        }
+
+    def begin_forward(self, input_ids: torch.Tensor, positions: torch.Tensor) -> None:
+        if not self.enabled:
+            return
+        armed = Path(ARM_FILE).exists()
+        warming = bool(WARMUP_FILE) and Path(WARMUP_FILE).exists()
+        if not armed and not warming:
+            if self._was_armed and self._records:
+                self.flush()
+            self._was_armed = False
+            self._warming = False
+            self._active_forward = None
+            return
+
+        # This filter is diagnostic-only and default-off. Singleton decode
+        # forwards are the only eligible geometry; prefills are rejected by
+        # shape without a device-to-host position read. The packet validator
+        # checks that the saved values are exactly the configured anchors.
+        if self._capture_positions and positions.numel() != 1:
+            self._warming = False
+            self._active_forward = None
+            return
+
+        self._was_armed = armed
+        self._warming = warming and not armed
+        self._active_forward = self._next_forward
+        self._next_forward += 1
+        self._enqueue(None, "forward_input", "input_ids", input_ids)
+        self._enqueue(None, "forward_input", "positions", positions)
+
+    def wants_layer(self, layer: int) -> bool:
+        return CAPTURE_LAYERS is None or layer in CAPTURE_LAYERS
+
+    def is_active(self, layer: int | None, stage: str) -> bool:
+        """Return whether capture bookkeeping is needed for this call."""
+        return (
+            self.enabled
+            and self._active_forward is not None
+            and stage in CAPTURE_STAGES
+            and (layer is None or self.wants_layer(layer))
+        )
+
+    def record(
+        self,
+        layer: int | None,
+        stage: str,
+        **tensors: torch.Tensor | None,
+    ) -> None:
+        if not self.is_active(layer, stage):
+            return
+        for name, tensor in tensors.items():
+            if tensor is not None:
+                self._enqueue(layer, stage, name, tensor)
+
+    def record_static(
+        self,
+        layer: int | None,
+        stage: str,
+        **tensors: torch.Tensor | None,
+    ) -> None:
+        """Record immutable bindings once without cloning multi-GB weights.
+
+        References remain owned by the live oracle model until flush.  Full
+        mode copies them to CPU one at a time while the service is still up.
+        """
+        if not self.is_active(layer, stage):
+            return
+        if self._warming:
+            # Static references require no kernel work, and warmup must not
+            # consume the keys needed by the subsequent real capture.
+            return
+        for name, tensor in tensors.items():
+            key = (layer, stage, name)
+            if tensor is None or key in self._static_keys:
+                continue
+            self._static_keys.add(key)
+            self._enqueue(layer, stage, name, tensor, clone=False)
+
+    def _enqueue(
+        self,
+        layer: int | None,
+        stage: str,
+        name: str,
+        tensor: torch.Tensor,
+        *,
+        clone: bool = True,
+    ) -> None:
+        if self._active_forward is None or len(self._records) >= MAX_RECORDS:
+            return
+        # No host read, reduction, synchronization, or file I/O while armed.
+        snapshot = tensor.detach().contiguous().clone() if clone else tensor.detach()
+        if self._warming:
+            # Exercise capture-only materialization kernels without retaining
+            # a packet or consuming immutable-binding state.  In-order queue
+            # execution makes the completed warmup request the fence before
+            # the driver is allowed to create ARM_FILE.
+            return
+        self._records.append(
+            _Record(
+                self._active_forward,
+                layer,
+                stage,
+                name,
+                snapshot,
+                _tensor_metadata(tensor),
+                clone,
+            )
+        )
+
+    def flush(self) -> None:
+        output_dir = Path(CAPTURE_DIR)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        if torch.distributed.is_available() and torch.distributed.is_initialized():
+            rank = torch.distributed.get_rank()
+        else:
+            rank = int(os.environ.get("RANK", "0"))
+        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
+        stem = f"rank{rank}-pid{os.getpid()}-{stamp}"
+        manifest_path = output_dir / f"{stem}.jsonl"
+
+        with manifest_path.open("w", encoding="utf-8") as manifest:
+            for ordinal, record in enumerate(self._records):
+                cpu = record.tensor.detach().cpu().contiguous()
+                raw = cpu.view(torch.uint8).numpy().tobytes()
+                row = {
+                    "rank": rank,
+                    "forward": record.forward,
+                    "layer": record.layer,
+                    "stage": record.stage,
+                    "tensor_name": record.name,
+                    "shape": list(cpu.shape),
+                    "dtype": str(cpu.dtype),
+                    "raw_sha256": hashlib.sha256(raw).hexdigest(),
+                    "binding": record.metadata,
+                    "reference_binding": not record.clone_at_enqueue,
+                    "immutable_binding": (record.stage == "attn_static_binding"),
+                }
+                if CAPTURE_MODE == "full":
+                    tensor_name = (
+                        f"{stem}-f{record.forward:04d}-r{ordinal:05d}-"
+                        f"l{record.layer if record.layer is not None else 'na'}-"
+                        f"{record.stage}-{record.name}.pt"
+                    )
+                    torch.save(cpu, output_dir / tensor_name)
+                    row["tensor_path"] = tensor_name
+                manifest.write(json.dumps(row, sort_keys=True) + "\n")
+
+        self._records.clear()
+        self._static_keys.clear()
+        self._active_forward = None
+
+
+RECORDER = DivergenceRecorder()
