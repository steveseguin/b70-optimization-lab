+    output_dir.mkdir(parents=True, exist_ok=True)
+    query_width = positions.numel()
+    payload = {
+        "layer_idx": layer_idx,
+        "stage": stage,
+        "tp_rank": rank,
+        "positions": positions.detach().cpu(),
+        **{name: tensor.detach().cpu() for name, tensor in tensors.items()},
+    }
+    torch.save(
+        payload,
+        output_dir
+        / f"layer{layer_idx:02d}-{stage}-q{query_width}-rank{rank}.pt",
+    )
+
+
