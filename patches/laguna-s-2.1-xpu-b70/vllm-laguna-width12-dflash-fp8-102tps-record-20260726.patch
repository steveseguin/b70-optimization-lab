+    assert torch.equal(x, torch.full((8,), 7.0, device="cuda"))
+    assert cap.num_graphs == 2
+    assert cap.num_eager_breaks == 1
+
+    x.fill_(10.0)
+    cap.replay()
+    torch.accelerator.synchronize()
+    assert torch.equal(x, torch.full((8,), 27.0, device="cuda"))
