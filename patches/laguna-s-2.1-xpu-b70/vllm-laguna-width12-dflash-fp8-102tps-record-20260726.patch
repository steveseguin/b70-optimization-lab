+        w.transfer_topo = MagicMock()
+        w.transfer_topo.register_remote_engine.side_effect = _StopAfterSlice()
+
+        meta = NixlAgentMetadata(
+            engine_id="p-engine",
+            agent_metadata=b"agent",
+            kv_caches_base_addr=[10, 11, 12, 13],  # full 4-layer model
+            device_id=0,
