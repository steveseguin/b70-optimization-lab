+@pytest.mark.parametrize("rows", [1, 12])
+def test_dflash_aux_workspace_is_raw_exact_and_reused(
+    monkeypatch: pytest.MonkeyPatch,
+    rows: int,
+) -> None:
+    model = _make_aux_model(monkeypatch)
+    generator = torch.Generator().manual_seed(29 + rows)
+    identities = None
+
+    for _ in range(2):
+        slices = [
+            torch.randn(
+                rows,
+                3072,
+                dtype=torch.bfloat16,
+                generator=generator,
+            )
+            for _ in range(6)
+        ]
+        expected = _reference_aux_combine(model, slices)
+        actual = model.combine_hidden_state_slices(slices)
+        _assert_raw_equal(actual, expected)
+
+        workspace = next(iter(model._aux_workspaces.values()))
+        tensors = (
+            workspace.concatenated,
+            workspace.normalized_base,
+            workspace.normalized,
+            workspace.output,
+        )
+        current = (
+            tuple(id(tensor) for tensor in tensors),
+            tuple(tensor.data_ptr() for tensor in tensors),
+        )
+        identities = current if identities is None else identities
+        assert current == identities
+        workspace.validate()
+
+
+def test_dflash_aux_workspace_rejects_identity_drift(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    model = _make_aux_model(monkeypatch)
+    slices = [torch.randn(12, 3072, dtype=torch.bfloat16) for _ in range(6)]
+    model.combine_hidden_state_slices(slices)
+    workspace = next(iter(model._aux_workspaces.values()))
+    workspace.normalized = workspace.normalized.clone()
+
+    with pytest.raises(RuntimeError, match="workspace identity drifted"):
+        model.combine_hidden_state_slices(slices)
