+def test_evidence_recorder_rejects_nested_foreign_mount(monkeypatch, tmp_path):
+    import vllm.compilation.laguna_m8_evidence as evidence
+
+    monkeypatch.setattr(evidence, "_NVME_EVIDENCE_ROOT", tmp_path)
+    root = tmp_path / "foreign-mount"
+    root.mkdir(mode=0o700)
+    original_stat = evidence.Path.stat
+
+    def fake_stat(path, *, follow_symlinks=True):
+        result = original_stat(path, follow_symlinks=follow_symlinks)
+        if path == root:
+            return SimpleNamespace(
+                st_dev=result.st_dev + 1,
+                st_uid=result.st_uid,
+                st_mode=result.st_mode,
+            )
+        return result
+
+    monkeypatch.setattr(evidence.Path, "stat", fake_stat)
+    with pytest.raises(RuntimeError, match="same internal NVMe filesystem"):
+        evidence.LagunaM8EvidenceRecorder(str(root), "incumbent-eager", rank=0)
