diff --git a/tests/v1/spec_decode/test_laguna_cycle_attribution.py b/tests/v1/spec_decode/test_laguna_cycle_attribution.py
index 3b34f05c4..85c4c7d72 100644
--- a/tests/v1/spec_decode/test_laguna_cycle_attribution.py
+++ b/tests/v1/spec_decode/test_laguna_cycle_attribution.py
@@ -53,10 +53,11 @@ def test_device_cycle_budget_drift_is_rejected(monkeypatch, tmp_path, value):
 
 def test_off_contract_depth_records_nothing(tmp_path):
     recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
-    # A depth other than the frozen 7 must be ignored, not guessed at.
-    recorder.begin_cycle(5)
+    # A depth other than the configured exact width must be ignored, not guessed.
+    off_contract_depth = _EXPECTED_SPECULATIVE_TOKENS + 1
+    recorder.begin_cycle(off_contract_depth)
     recorder.mark("cycle_begin")
-    recorder.end_cycle(5)
+    recorder.end_cycle(off_contract_depth)
     output = Path(recorder.finalize())
     payload = json.loads(output.read_text())
     assert payload["host_cycles"] == []
@@ -120,6 +121,67 @@ def test_interval_names_cover_every_mark_gap():
     assert _INTERVAL_NAMES[-1] == "post_draft"
 
 
+def test_topk_probe_records_two_positions_and_request_boundary(tmp_path):
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
+    recorder.begin_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+    recorder.record_topk_probe(
+        positions=[
+            {
+                "position": 0,
+                "top1": 10,
+                "top2": 11,
+                "top1_logit": 3.5,
+                "top2_logit": 2.25,
+            },
+            {
+                "position": 1,
+                "top1": 20,
+                "top2": 21,
+                "top1_logit": 1.0,
+                "top2_logit": 0.75,
+            },
+        ],
+        entry_next_token_id=7,
+        entry_num_rejected=0,
+        entry_has_previous_outcome=False,
+    )
+    for label in _labels()[1:-1]:
+        recorder.mark(label)
+    recorder.end_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+    payload = json.loads(Path(recorder.finalize()).read_text())
+    row = payload["topk_probe"][0]
+    assert row["entry_has_previous_outcome"] is False
+    assert row["positions"][0]["margin"] == pytest.approx(1.25)
+    assert row["positions"][1]["top2"] == 21
+
+
+def test_topk_probe_rejects_position_or_logit_order_drift(tmp_path):
+    recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
+    recorder.begin_cycle(_EXPECTED_SPECULATIVE_TOKENS)
+    with pytest.raises(RuntimeError, match="position order drift"):
+        recorder.record_topk_probe(
+            positions=[
+                {
+                    "position": 1,
+                    "top1": 10,
+                    "top2": 11,
+                    "top1_logit": 3.5,
+                    "top2_logit": 2.25,
+                },
+                {
+                    "position": 0,
+                    "top1": 20,
+                    "top2": 21,
+                    "top1_logit": 1.0,
+                    "top2_logit": 0.75,
+                },
+            ],
+            entry_next_token_id=7,
+            entry_num_rejected=0,
+            entry_has_previous_outcome=False,
+        )
+
+
 def test_payload_is_write_once_and_read_only(tmp_path):
     recorder = LagunaCycleAttribution(str(tmp_path), rank=0, device_cycles=0)
     _drive_cycle(recorder)
diff --git a/vllm/v1/spec_decode/laguna_cycle_attribution.py b/vllm/v1/spec_decode/laguna_cycle_attribution.py
index 84dc57a07..ecaeb100e 100644
--- a/vllm/v1/spec_decode/laguna_cycle_attribution.py
+++ b/vllm/v1/spec_decode/laguna_cycle_attribution.py
@@ -27,7 +27,9 @@ import torch
 
 _ROOT_ENV = "VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_ROOT"
 _DEVICE_CYCLES_ENV = "VLLM_XPU_LAGUNA_CYCLE_ATTRIBUTION_DEVICE_CYCLES"
-_EXPECTED_SPECULATIVE_TOKENS = 7
+_EXPECTED_SPECULATIVE_TOKENS = int(
+    os.environ.get("VLLM_XPU_LAGUNA_EXACT_MAX_M", "8")
+) - 1
 
 # DFlash is a parallel drafter: all speculative tokens come from a single
 # masked forward, so a cycle is cycle_begin, ctxkv_begin, ctxkv_end,
@@ -73,7 +75,7 @@ class LagunaCycleAttribution:
         self._cycle_host_begin_ns = 0
         self._events_at_cycle_start = 0
         self._abandoned = 0
-        self._topk_probe: list[dict[str, int]] = []
+        self._topk_probe: list[dict[str, Any]] = []
 
         # The recorder spans a whole generation rather than a single replay, so
         # the payload is written at interpreter shutdown. A failure there must
@@ -173,25 +175,47 @@ class LagunaCycleAttribution:
 
     def record_topk_probe(
         self,
-        top1: int,
-        top2: int,
+        positions: list[dict[str, int | float]],
         entry_next_token_id: int,
         entry_num_rejected: int,
+        entry_has_previous_outcome: bool,
     ) -> None:
-        """Record position-0 draft top-2 against the target's realised token.
+        """Record draft top-2 evidence against the target's realised token.
 
         ``entry_*`` describe the state on entry to this cycle, so they report
-        the outcome of the *previous* cycle. Joined offline.
+        the outcome of the *previous* cycle. ``entry_has_previous_outcome`` is
+        false on the first draft cycle of each request and prevents an offline
+        join from crossing request boundaries.
         """
         if not self._armed:
             return
+        if len(positions) != 2:
+            raise RuntimeError("Laguna confidence probe must record two positions")
+        normalized_positions: list[dict[str, int | float]] = []
+        for expected_position, row in enumerate(positions):
+            if int(row["position"]) != expected_position:
+                raise RuntimeError("Laguna confidence probe position order drift")
+            top1_logit = float(row["top1_logit"])
+            top2_logit = float(row["top2_logit"])
+            if top1_logit < top2_logit:
+                raise RuntimeError("Laguna confidence probe top-k order drift")
+            normalized_positions.append(
+                {
+                    "position": expected_position,
+                    "top1": int(row["top1"]),
+                    "top2": int(row["top2"]),
+                    "top1_logit": top1_logit,
+                    "top2_logit": top2_logit,
+                    "margin": top1_logit - top2_logit,
+                }
+            )
         self._topk_probe.append(
             {
                 "cycle": self._cycle_index,
-                "top1": int(top1),
-                "top2": int(top2),
+                "positions": normalized_positions,
                 "entry_next_token_id": int(entry_next_token_id),
                 "entry_num_rejected": int(entry_num_rejected),
+                "entry_has_previous_outcome": bool(entry_has_previous_outcome),
             }
         )
 
