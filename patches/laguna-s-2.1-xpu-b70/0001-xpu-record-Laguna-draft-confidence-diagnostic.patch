                         entry_num_rejected=(
                             0
                             if num_rejected_tokens_gpu is None
                             else int(num_rejected_tokens_gpu.reshape(-1)[0])
                         ),
+                        entry_has_previous_outcome=(
+                            num_rejected_tokens_gpu is not None
