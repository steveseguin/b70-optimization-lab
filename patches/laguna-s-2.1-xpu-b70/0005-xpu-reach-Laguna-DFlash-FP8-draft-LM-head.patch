+def _make_draft_with_shared_lm_head(target: nn.Module) -> nn.Module:
+    draft = laguna_dflash.DFlashLagunaForCausalLM.__new__(
+        laguna_dflash.DFlashLagunaForCausalLM
+    )
+    nn.Module.__init__(draft)
+    draft.model = SimpleNamespace(_dflash_fp8_enabled=True)
+    draft.lm_head = target
+    return draft
+
+
+def _make_bare_proposer(draft: nn.Module) -> SpecDecodeBaseProposer:
+    proposer = SpecDecodeBaseProposer.__new__(SpecDecodeBaseProposer)
+    proposer.model = draft
+    return proposer
+
+
+def test_active_proposer_fp8_lm_head_selector_off_is_inert(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(envs, "VLLM_XPU_LAGUNA_DFLASH_FP8_LM_HEAD", False)
+    target = _FakeLMHead(torch.zeros(4, 8, dtype=torch.bfloat16))
+    draft = _make_draft_with_shared_lm_head(target)
+
+    _make_bare_proposer(draft)._maybe_prepare_laguna_dflash_fp8_lm_head(
+        SimpleNamespace(lm_head=target)
+    )
+
+    assert draft.lm_head is target
+
+
+def test_active_proposer_prepares_independent_fp8_draft_lm_head(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(envs, "VLLM_XPU_LAGUNA_DFLASH_FP8_W8A16", True)
+    monkeypatch.setattr(envs, "VLLM_XPU_LAGUNA_DFLASH_FP8_LM_HEAD", True)
+    monkeypatch.setattr(laguna_dflash, "_is_xpu_tensor", lambda tensor: True)
+    monkeypatch.setattr(laguna_dflash, "_LAGUNA_DFLASH_FP8_LM_HEAD_SHAPE", (4, 8))
+    monkeypatch.setattr(
+        laguna_dflash.ops,
+        "scaled_fp8_quant",
+        _fake_scaled_fp8_quant,
+    )
+    target = _FakeLMHead(
+        torch.randn(
+            4, 8, dtype=torch.bfloat16, generator=torch.Generator().manual_seed(19)
+        )
+    )
+    target_copy = target.weight.detach().clone()
+    draft = _make_draft_with_shared_lm_head(target)
+
+    _make_bare_proposer(draft)._maybe_prepare_laguna_dflash_fp8_lm_head(
+        SimpleNamespace(lm_head=target)
+    )
+
+    assert torch.equal(target.weight, target_copy)
+    assert draft.lm_head is not target
+    assert draft.lm_head._xpu_laguna_dflash_fp8 is True
+
+
+@pytest.mark.parametrize("failure", ["broad_selector", "wrong_type", "missing_hook"])
+def test_active_proposer_fp8_lm_head_fails_closed(
+    monkeypatch: pytest.MonkeyPatch,
+    failure: str,
+) -> None:
+    monkeypatch.setattr(
+        envs,
+        "VLLM_XPU_LAGUNA_DFLASH_FP8_W8A16",
+        failure != "broad_selector",
+    )
+    monkeypatch.setattr(envs, "VLLM_XPU_LAGUNA_DFLASH_FP8_LM_HEAD", True)
+    target = _FakeLMHead(torch.zeros(4, 8, dtype=torch.bfloat16))
+    draft = _make_draft_with_shared_lm_head(target)
+    if failure == "wrong_type":
+        draft = SimpleNamespace(lm_head=target)
+    elif failure == "missing_hook":
+        draft.prepare_draft_lm_head = None
+
+    with pytest.raises(RuntimeError):
+        _make_bare_proposer(draft)._maybe_prepare_laguna_dflash_fp8_lm_head(
+            SimpleNamespace(lm_head=target)
+        )
+
+
 class _FakeAuxFC(nn.Module):
     def forward(self, inputs: torch.Tensor) -> torch.Tensor:
         return inputs.view(inputs.shape[0], 6, 3072).sum(dim=1)
