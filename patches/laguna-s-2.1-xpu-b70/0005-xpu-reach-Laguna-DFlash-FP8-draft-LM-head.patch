diff --git a/vllm/v1/spec_decode/llm_base_proposer.py b/vllm/v1/spec_decode/llm_base_proposer.py
index 4b7ebfcce..5b7a1b6c6 100644
--- a/vllm/v1/spec_decode/llm_base_proposer.py
+++ b/vllm/v1/spec_decode/llm_base_proposer.py
@@ -1537,6 +1537,7 @@ class SpecDecodeBaseProposer:
 
         self._maybe_share_embeddings(target_language_model)
         self._maybe_share_lm_head(target_language_model)
+        self._maybe_prepare_laguna_dflash_fp8_lm_head(target_language_model)
 
         if (
             self.parallel_drafting
@@ -1752,6 +1753,45 @@ class SpecDecodeBaseProposer:
                 "(communication: O(2*tp_size) vs O(vocab_size))."
             )
 
+    def _maybe_prepare_laguna_dflash_fp8_lm_head(
+        self,
+        target_language_model: nn.Module,
+    ) -> None:
+        if not envs.VLLM_XPU_LAGUNA_DFLASH_FP8_LM_HEAD:
+            return
+        if not envs.VLLM_XPU_LAGUNA_DFLASH_FP8_W8A16:
+            raise RuntimeError(
+                "Laguna DFlash FP8 LM head requires the FP8 W8A16 draft contract"
+            )
+        if not isinstance(self.model, DFlashLagunaForCausalLM):
+            raise RuntimeError(
+                "Laguna DFlash FP8 LM-head selector reached the wrong draft type: "
+                f"{type(self.model).__name__}"
+            )
+        target_lm_head = getattr(target_language_model, "lm_head", None)
+        if target_lm_head is None or self.model.lm_head is not target_lm_head:
+            raise RuntimeError(
+                "Laguna DFlash FP8 LM head requires the shared target LM head"
+            )
+        prepare = getattr(self.model, "prepare_draft_lm_head", None)
+        if not callable(prepare):
+            raise RuntimeError("Laguna DFlash FP8 LM-head preparation hook is missing")
+        prepare(target_lm_head)
+        draft_lm_head = self.model.lm_head
+        if not getattr(draft_lm_head, "_xpu_laguna_dflash_fp8", False):
+            raise RuntimeError("Laguna DFlash FP8 LM-head preparation did not engage")
+        if draft_lm_head is target_lm_head:
+            raise RuntimeError("Laguna DFlash draft and target LM heads still alias")
+        logger.info(
+            "Engaged Laguna DFlash FP8 draft LM head through active proposer: "
+            "proposer=%s draft=%s target=%s draft_weight=%s target_weight=%s",
+            type(self).__name__,
+            type(self.model).__name__,
+            type(target_lm_head).__name__,
+            tuple(draft_lm_head.weight.shape),
+            tuple(target_lm_head.weight.shape),
+        )
+
     @torch.inference_mode()
     def dummy_run(
         self,
