 @pytest.fixture(autouse=True)
@@ -558,6 +559,7 @@ class _FakeLMHead(nn.Module):
 def test_dflash_fp8_draft_lm_head_does_not_mutate_target(
     monkeypatch: pytest.MonkeyPatch,
 ) -> None:
+    monkeypatch.setattr(envs, "VLLM_XPU_LAGUNA_DFLASH_FP8_LM_HEAD", True)
     monkeypatch.setattr(laguna_dflash, "_is_xpu_tensor", lambda tensor: True)
     monkeypatch.setattr(
         laguna_dflash,
@@ -593,6 +595,89 @@ def test_dflash_fp8_draft_lm_head_does_not_mutate_target(
