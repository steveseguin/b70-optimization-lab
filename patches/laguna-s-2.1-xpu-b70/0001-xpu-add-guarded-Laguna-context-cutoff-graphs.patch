+def test_laguna_dflash_context_cutoff_clears_finished_id_for_reuse(monkeypatch):
+    _set_laguna_env(monkeypatch, context_cutoff=8192)
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.speculative_config = SimpleNamespace(use_dflash=lambda: True)
+    runner.input_batch = SimpleNamespace(
+        num_reqs=1,
+        req_ids=["reused"],
+        num_tokens_no_spec=np.array([8192], dtype=np.int32),
+    )
+
+    assert runner._laguna_dflash_context_cutoff_reached() == (True, 8192)
+    runner._laguna_forget_dflash_context_cutoff("reused")
+    runner.input_batch.num_tokens_no_spec[0] = 128
+    assert runner._laguna_dflash_context_cutoff_reached() == (False, 128)
+
