+def test_laguna_context_cutoff_preallocates_stable_m1_and_m12_buffers(
+    monkeypatch,
+):
+    import vllm.compilation.laguna_m8_collectives as collectives
+    from vllm import envs
+
+    monkeypatch.setattr(envs, "VLLM_XPU_LAGUNA_EXACT_MAX_M", 12)
+    monkeypatch.setattr(envs, "VLLM_XPU_LAGUNA_DFLASH_CONTEXT_CUTOFF", 8192)
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_gather_into_tensor",
+        lambda output, local, group: output.copy_(local.expand_as(output)),
+    )
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_reduce",
+        lambda output, group: None,
+    )
+
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    assert state._supported_rows == (1, 12)
+    assert state.gathers is state._gathers_by_rows[12]
+    assert state.embedding_reduce is state._embedding_reduce_by_rows[12]
+    m1_gather_address = state._gathers_by_rows[1][0].data_ptr()
+    m12_gather_address = state._gathers_by_rows[12][0].data_ptr()
+    assert m1_gather_address != m12_gather_address
+
+    for rows, expected_address in ((1, m1_gather_address), (12, m12_gather_address)):
+        local = torch.ones((1, rows, 3072), dtype=torch.bfloat16)
+        state.reset_for_eligible_forward()
+        state.all_reduce(local.squeeze(0))
+        for index in range(96):
+            output = state.all_gather(local, dim=0)
+            if index == 0:
+                assert output.data_ptr() == expected_address
+        state.finish_eligible_forward()
+
+        state.reset_for_eligible_forward()
+        state._run_reduce(local.squeeze(0), state._embedding_reduce_by_rows[rows])
+        for index, output in enumerate(state._gathers_by_rows[rows]):
+            state._run_gather(local, output, index)
+        state.finish_eligible_forward()
+
+    state.reset_for_eligible_forward()
+    with pytest.raises(RuntimeError, match="fixed supported rows"):
+        state.all_reduce(torch.ones((2, 3072), dtype=torch.bfloat16))
+
+    # The first capture is audited too; it cannot redefine a truncated M1
+    # topology as the learned contract.
+    state.reset_for_eligible_forward()
+    local = torch.ones((1, 1, 3072), dtype=torch.bfloat16)
+    state.all_reduce(local.squeeze(0))
+    for _ in range(95):
+        state.all_gather(local, dim=0)
+    with pytest.raises(RuntimeError, match="changed gather order"):
+        state.finish_eligible_forward()
