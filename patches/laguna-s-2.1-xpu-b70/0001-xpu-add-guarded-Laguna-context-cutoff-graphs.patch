+def test_laguna_dflash_context_cutoff_boundary(monkeypatch):
+    _set_laguna_env(monkeypatch, context_cutoff=8192)
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.speculative_config = SimpleNamespace(use_dflash=lambda: True)
+    runner.input_batch = SimpleNamespace(
+        num_reqs=1,
+        req_ids=["req_0"],
+        num_tokens_no_spec=np.array([8191], dtype=np.int32),
+    )
+
+    assert runner._laguna_dflash_context_cutoff_reached() == (False, 8191)
+    runner.input_batch.num_tokens_no_spec[0] = 8192
+    assert runner._laguna_dflash_context_cutoff_reached() == (True, 8192)
+
+    # A sync-KV/output correction can shrink visible state. The drafter must
+    # remain disabled because its KV cache has not advanced since the cutoff.
+    runner.input_batch.num_tokens_no_spec[0] = 8190
+    assert runner._laguna_dflash_context_cutoff_reached() == (True, 8190)
+
+    # The latch is request-local rather than process-global.
+    runner.input_batch.req_ids[0] = "req_1"
+    assert runner._laguna_dflash_context_cutoff_reached() == (False, 8190)
+
+
+def test_laguna_dflash_context_cutoff_defers_only_boundary_cycle(monkeypatch):
+    _set_laguna_env(monkeypatch, context_cutoff=8192)
+    runner = GPUModelRunner.__new__(GPUModelRunner)
+    runner.speculative_config = SimpleNamespace(use_dflash=lambda: True)
+    runner.input_batch = SimpleNamespace(
+        num_reqs=1,
+        req_ids=["req_0"],
+        num_tokens_no_spec=np.array([8179], dtype=np.int32),
+    )
+
+    assert runner._laguna_dflash_cutoff_before_bookkeeping(12) == (False, False)
+    runner.input_batch.num_tokens_no_spec[0] = 8180
+    assert runner._laguna_dflash_cutoff_before_bookkeeping(12) == (False, True)
+
+    # Conservative deferral need not become a transition when acceptance is
+    # short. The padded DFlash retry after bookkeeping must retain GPU inputs.
+    runner.input_batch.num_tokens_no_spec[0] = 8181
+    assert runner._laguna_dflash_context_cutoff_reached() == (False, 8181)
+    gpu_ids = torch.tensor([[1]], dtype=torch.int32)
+    cpu_ids = [[1]]
+    assert (
+        runner._laguna_post_bookkeeping_draft_inputs(True, gpu_ids, cpu_ids)
+        is gpu_ids
+    )
+    assert (
+        runner._laguna_post_bookkeeping_draft_inputs(False, gpu_ids, cpu_ids)
+        is cpu_ids
+    )
+
+    # Once bookkeeping commits the crossing cycle, the request is latched.
+    runner.input_batch.num_tokens_no_spec[0] = 8192
+    assert runner._laguna_dflash_cutoff_before_bookkeeping(12) == (True, False)
+
