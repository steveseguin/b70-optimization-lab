     // makes one K group's N scales strided. A load-time transpose stores
     // [K/GroupSize,N], so the identical BF16 values are contiguous here.
     bool TransposedScales = false,
+    // Lossless decode-only BF16 scale records. Each 32-scale record stores
+    // the 32 low bytes, eight packed two-bit high-byte deltas, and one common
+    // high-byte base. The original BF16 word is reconstructed before the
+    // existing multiply.
+    bool LosslessPackedScales = false,
     class ATensor,
     class BTensor,
     class DTensor,
@@ -712,6 +717,11 @@ CUTE_DEVICE void xe_gemm_4bits(
   static_assert(
       !TransposedScales || (!TileMajor && group_size == 32),
       "transposed INT4 scales require non-tile-major group32");
+  static_assert(
+      !LosslessPackedScales ||
+          (TransposedScales && !TileMajor && group_size == 32 &&
+           is_same_v<ElementS, bfloat16_t>),
+      "lossless packed scales require transposed BF16 group32 scales");
 
   static constexpr auto SG_M = tile_m / ATOM_M;  // BLK_M / ATOM_M;
   static constexpr auto SG_N = tile_n / ATOM_N;  // BLK_N / ATOM_N;
@@ -727,6 +737,44 @@ CUTE_DEVICE void xe_gemm_4bits(
   int group_num = get<1>(A.shape()) / group_size;
   int x_idx = sg_local_id / channel_num;
 
+  static constexpr int packed_scale_block = 32;
+  static constexpr int packed_scale_record_bytes = 41;
+  auto load_lossless_scale = [&](int group_idx, int global_n) {
+    const int record_idx =
+        group_idx * (shape<0>(B) / packed_scale_block) +
+        global_n / packed_scale_block;
+    const int within = global_n % packed_scale_block;
+    const uint8_t* record = reinterpret_cast<const uint8_t*>(Scales) +
+        record_idx * packed_scale_record_bytes;
+    const uint16_t low = record[within];
+    const uint8_t packed_delta = record[32 + within / 4];
+    const uint16_t high = static_cast<uint16_t>(
+        record[40] + ((packed_delta >> (2 * (within % 4))) & 0x3));
+    return static_cast<float>(bfloat16_t::bitcast(low | (high << 8)));
+  };
+
+  auto prefetch_lossless_scale_record = [&](int group_idx) {
+    const int global_n = n_tile_start + n_sg_start;
+    const int record_idx =
+        group_idx * (shape<0>(B) / packed_scale_block) +
+        global_n / packed_scale_block;
+    const uint8_t* record = reinterpret_cast<const uint8_t*>(Scales) +
+        record_idx * packed_scale_record_bytes;
+    auto record_tensor = make_tensor(
+        make_gmem_ptr(const_cast<uint8_t*>(record)),
+        make_layout(
+            make_shape(Int<1>{}, Int<64>{}),
+            make_stride(Int<64>{}, Int<1>{})));
+    auto record_prefetch = make_block_2d_prefetch<1>(
+        make_shape(Int<1>{}, Int<64>{}), record_tensor);
+    auto record_prefetch_slice = record_prefetch.get_slice(sg_local_id);
+    auto record_identity =
+        make_identity_tensor(make_shape(Int<1>{}, Int<64>{}));
+    auto record_partition =
+        record_prefetch_slice.partition_S(record_identity);
+    prefetch(record_prefetch, record_partition(_, 0, 0));
+  };
+
   using scaleStoreType = conditional_t<is_same_v<TA, half_t>, half_t, float>;
   scaleStoreType scales[thr_N * channel_num];
 
