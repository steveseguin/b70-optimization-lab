                 scale = Scales
                     [group_idx * shape<0>(B) + n_tile_start + n_sg_start +
                      sg_local_n];
@@ -1019,7 +1079,11 @@ CUTE_DEVICE void xe_gemm_4bits(
       }
 
       if ((group_idx + prefetch_dist) * group_size < shape<1>(A)) {
-        if constexpr (TransposedScales) {
