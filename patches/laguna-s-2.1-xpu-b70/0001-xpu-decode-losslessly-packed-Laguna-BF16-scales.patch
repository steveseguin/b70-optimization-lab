+inline bool laguna_int4_decode_lossless_packed_scales() {
+  static const bool enabled = [] {
+    const char* value =
+        std::getenv("VLLM_XPU_LAGUNA_DECODE_LOSSLESS_PACKED_SCALES");
+    if (value == nullptr) return false;
+    if (std::strcmp(value, "0") == 0) return false;
+    if (std::strcmp(value, "1") == 0) return true;
+    TORCH_CHECK(
+        false,
+        "VLLM_XPU_LAGUNA_DECODE_LOSSLESS_PACKED_SCALES must be literal 0 or "
+        "1, got '",
+        value,
+        "'");
+    return false;
+  }();
+  return enabled;
+}
