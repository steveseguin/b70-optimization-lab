             )
             if input_ids is not None:
                 _copy_laguna_parity(
-                    self._parity_input_id, input_ids.reshape(-1)[-1]
+                    self._parity_input_id,
+                    input_ids.reshape(-1)[_LAGUNA_PARITY_ROW],
                 )
         if get_pp_group().is_first_rank:
             if inputs_embeds is not None:
@@ -1556,7 +1569,7 @@ class LagunaModel(nn.Module, EagleModelMixin):
             if self._parity_enabled:
                 _copy_laguna_parity(
                     self._parity_embedding,
-                    hidden_states.reshape(-1, hidden_states.shape[-1])[-1]
+                    _laguna_parity_row(hidden_states),
                 )
             residual = None
         else:
@@ -1596,11 +1609,11 @@ class LagunaModel(nn.Module, EagleModelMixin):
         if self._parity_enabled:
             _copy_laguna_parity(
                 self._parity_final_norm,
-                hidden_states.reshape(-1, hidden_states.shape[-1])[-1]
+                _laguna_parity_row(hidden_states),
             )
             _copy_laguna_parity(
                 self._parity_final_residual,
-                final_residual.reshape(-1, final_residual.shape[-1])[-1]
+                _laguna_parity_row(final_residual),
             )
         if len(aux_hidden_states) > 0:
             return hidden_states, aux_hidden_states
@@ -1831,6 +1844,7 @@ class LagunaForCausalLM(nn.Module, SupportsPP, SupportsLoRA, SupportsEagle3):
     ) -> None:
         if (
             not envs.VLLM_XPU_LAGUNA_PARITY_PROBE
+            or not self.model._parity_enabled
             or self._parity_dumped
             or not _LAGUNA_PARITY_TRIGGER.exists()
         ):
@@ -1867,8 +1881,13 @@ class LagunaForCausalLM(nn.Module, SupportsPP, SupportsLoRA, SupportsEagle3):
             "tp_rank": get_tensor_model_parallel_rank(),
             "input_id": self.model._parity_input_id.detach().cpu().clone(),
             "position": self.model._parity_position.detach().cpu().clone(),
-            "hidden_states": hidden_states.detach().cpu().clone(),
-            "logits": None if logits is None else logits.detach().cpu().clone(),
+            "parity_row": _LAGUNA_PARITY_ROW,
+            "hidden_states": _laguna_parity_row(hidden_states).detach().cpu().clone(),
+            "logits": (
+                None
+                if logits is None
+                else _laguna_parity_row(logits).detach().cpu().clone()
+            ),
             "buffers": {
                 name: tensor.detach().cpu().clone()
                 for name, tensor in self.model.named_buffers()
