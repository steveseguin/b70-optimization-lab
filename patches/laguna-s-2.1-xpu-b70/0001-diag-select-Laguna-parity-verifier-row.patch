Subject: [PATCH] diag: select Laguna parity verifier row

---
 vllm/model_executor/layers/linear.py | 16 ++++++----
 vllm/model_executor/models/laguna.py | 45 ++++++++++++++++++++--------
 2 files changed, 43 insertions(+), 18 deletions(-)

diff --git a/vllm/model_executor/layers/linear.py b/vllm/model_executor/layers/linear.py
index 0100d83db..90f80494c 100644
--- a/vllm/model_executor/layers/linear.py
+++ b/vllm/model_executor/layers/linear.py
@@ -47,6 +47,14 @@ from vllm.utils.torch_utils import direct_register_custom_op
 
 logger = init_logger(__name__)
 
+_LAGUNA_PARITY_ROW = int(os.environ.get("VLLM_XPU_LAGUNA_PARITY_ROW", "-1"))
+if _LAGUNA_PARITY_ROW not in (-1, 0):
+    raise RuntimeError("VLLM_XPU_LAGUNA_PARITY_ROW must be -1 or 0")
+
+
+def _laguna_parity_row(tensor: torch.Tensor) -> torch.Tensor:
+    return tensor.reshape(-1, tensor.shape[-1])[_LAGUNA_PARITY_ROW]
+
 
 def _xpu_exact_batched_m1_bmm_out(
     rows: torch.Tensor, weight: torch.Tensor, output: torch.Tensor
@@ -1869,7 +1877,7 @@ class RowParallelLinear(LinearBase):
         if parity_probe:
             torch.ops.vllm.laguna_parity_copy(
                 self._parity_input,
-                input_parallel.reshape(-1, input_parallel.shape[-1])[-1]
+                _laguna_parity_row(input_parallel),
             )
 
         # Matrix multiply.
@@ -1902,9 +1910,7 @@ class RowParallelLinear(LinearBase):
                 if parity_probe:
                     torch.ops.vllm.laguna_parity_copy(
                         self._parity_local,
-                        output_parallel.reshape(
-                            -1, output_parallel.shape[-1]
-                        )[-1]
+                        _laguna_parity_row(output_parallel),
                     )
                 output = output_parallel
                 if self.reduce_results and self.tp_size > 1:
@@ -1933,7 +1939,7 @@ class RowParallelLinear(LinearBase):
         if parity_probe:
             torch.ops.vllm.laguna_parity_copy(
                 self._parity_output,
-                output.reshape(-1, output.shape[-1])[-1]
+                _laguna_parity_row(output),
             )
 
         if not self.return_bias:
diff --git a/vllm/model_executor/models/laguna.py b/vllm/model_executor/models/laguna.py
index c490a2276..042b7898d 100644
--- a/vllm/model_executor/models/laguna.py
+++ b/vllm/model_executor/models/laguna.py
