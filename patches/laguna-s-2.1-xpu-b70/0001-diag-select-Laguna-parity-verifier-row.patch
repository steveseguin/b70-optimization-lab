 _LAGUNA_PARITY_TRIGGER = _LAGUNA_ARTIFACT_ROOT / "parity-trigger.json"
+_LAGUNA_PARITY_ROW = int(os.environ.get("VLLM_XPU_LAGUNA_PARITY_ROW", "-1"))
+if _LAGUNA_PARITY_ROW not in (-1, 0):
+    raise RuntimeError("VLLM_XPU_LAGUNA_PARITY_ROW must be -1 or 0")
+
+
+def _laguna_parity_row(tensor: torch.Tensor) -> torch.Tensor:
+    return tensor.reshape(-1, tensor.shape[-1])[_LAGUNA_PARITY_ROW]
 
 
 def _laguna_m8_shared_elementwise_graph_contract(
@@ -1081,7 +1091,7 @@ class LagunaAttention(nn.Module):
         if self._parity_enabled:
             _copy_laguna_parity(
                 getattr(self, f"_parity_{stage}"),
-                tensor.reshape(-1, tensor.shape[-1])[-1]
+                _laguna_parity_row(tensor),
             )
 
     def _parity_stage_output(
@@ -1117,7 +1127,7 @@ class LagunaAttention(nn.Module):
         fused_m8_qknorm_rope = (
             envs.VLLM_XPU_LAGUNA_M8_QKNORM_ROPE
             and not self.is_dflash_layer
-            and not self._parity_enabled
+            and not self._parity_return_stage
             and not torch.compiler.is_compiling()
             and hidden_states.shape[0] in (8, 12)
             and _xpu_is_exact_decode_or_verifier_rows(hidden_states.shape[0])
@@ -1374,7 +1384,7 @@ class LagunaDecoderLayer(nn.Module):
         if self._parity_enabled:
             _copy_laguna_parity(
                 getattr(self, f"_parity_{stage}"),
-                tensor.reshape(-1, tensor.shape[-1])[-1]
+                _laguna_parity_row(tensor),
             )
 
     def forward(
@@ -1510,7 +1520,9 @@ class LagunaModel(nn.Module, EagleModelMixin):
         self.make_empty_intermediate_tensors = make_empty_intermediate_tensors_factory(
             ["hidden_states", "residual"], config.hidden_size
         )
-        self._parity_enabled = envs.VLLM_XPU_LAGUNA_PARITY_PROBE
+        self._parity_enabled = (
+            envs.VLLM_XPU_LAGUNA_PARITY_PROBE and config.num_hidden_layers == 48
+        )
         if self._parity_enabled:
             for stage in ("embedding", "final_norm", "final_residual"):
                 self.register_buffer(
@@ -1542,11 +1554,12 @@ class LagunaModel(nn.Module, EagleModelMixin):
         )
         if self._parity_enabled:
             _copy_laguna_parity(
-                self._parity_position, positions.reshape(-1)[-1]
