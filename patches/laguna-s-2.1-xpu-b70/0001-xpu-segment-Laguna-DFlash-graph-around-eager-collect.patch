diff --git a/tests/v1/cudagraph/test_laguna_dflash_collectives.py b/tests/v1/cudagraph/test_laguna_dflash_collectives.py
new file mode 100644
index 000000000..8aa2aed41
--- /dev/null
+++ b/tests/v1/cudagraph/test_laguna_dflash_collectives.py
@@ -0,0 +1,86 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import pytest
+import torch
+
+from vllm.compilation.laguna_dflash_collectives import (
+    LagunaDFlashCollectiveState,
+)
+
+
+class _Group:
+    device_group = object()
+
+
+def _patch_collective(monkeypatch: pytest.MonkeyPatch) -> None:
+    import vllm.compilation.laguna_dflash_collectives as collectives
+
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_reduce",
+        lambda output, group: output.add_(1),
+    )
+
+
+def test_dflash_collective_slots_are_fixed_and_ordered(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _patch_collective(monkeypatch)
+    state = LagunaDFlashCollectiveState(torch.device("cpu"))
+    local = torch.ones((12, 3072), dtype=torch.bfloat16)
+    addresses = [output.data_ptr() for output in state.reduces]
+    assert len(addresses) == len(set(addresses)) == 12
+
+    state.reset_for_forward()
+    for index, address in enumerate(addresses):
+        output = state.all_reduce(local)
+        assert output.data_ptr() == address
+        assert torch.equal(output, local + 1)
+        assert state._next_reduce == index + 1
+    state.finish_forward()
+
+
+def test_dflash_collective_contract_fails_closed(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _patch_collective(monkeypatch)
+    state = LagunaDFlashCollectiveState(torch.device("cpu"))
+    with pytest.raises(RuntimeError, match="collective input drifted"):
+        state.all_reduce(torch.empty((11, 3072), dtype=torch.bfloat16))
+    with pytest.raises(RuntimeError, match="collective input drifted"):
+        state.all_reduce(torch.empty((12, 3072), dtype=torch.float32))
+    with pytest.raises(RuntimeError, match="eager collective count"):
+        state.finish_forward()
+
+    local = torch.ones((12, 3072), dtype=torch.bfloat16)
+    for _ in range(12):
+        state.all_reduce(local)
+    with pytest.raises(RuntimeError, match="exceeded its 12"):
+        state.all_reduce(local)
+
+
+def test_dflash_collective_replay_accounting(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _patch_collective(monkeypatch)
+    state = LagunaDFlashCollectiveState(torch.device("cpu"))
+    local = torch.ones((12, 3072), dtype=torch.bfloat16)
+    state.reset_for_forward()
+
+    # Replay calls the recorded eager closures without walking Python model
+    # code, so the slot cursor remains zero while all reductions execute.
+    for index, output in enumerate(state.reduces):
+        state._run_reduce(local, output, index)
+    state.finish_forward()
+
+
+def test_dflash_collective_detects_replay_output_substitution(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _patch_collective(monkeypatch)
+    state = LagunaDFlashCollectiveState(torch.device("cpu"))
+    local = torch.ones((12, 3072), dtype=torch.bfloat16)
+    replacement = torch.empty_like(state.reduces[0])
+    with pytest.raises(RuntimeError, match="output identity drifted"):
+        state._run_reduce(local, replacement, 0)
