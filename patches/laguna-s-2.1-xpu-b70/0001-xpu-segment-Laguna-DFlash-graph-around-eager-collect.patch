diff --git a/vllm/compilation/laguna_dflash_collectives.py b/vllm/compilation/laguna_dflash_collectives.py
new file mode 100644
index 000000000..b9a3fb709
--- /dev/null
+++ b/vllm/compilation/laguna_dflash_collectives.py
@@ -0,0 +1,155 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Eager TP boundaries for Laguna's segmented DFlash graph.
+
+The rejected whole-drafter graph did not give DFlash collectives explicit
+eager boundaries. This state mirrors the proven target-graph rule on a much
+narrower contract: twelve ordered BF16 all-reduces, each [12, 3072], with a
+dedicated fixed-address output allocated before capture.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+import torch
+import torch.distributed as dist
+
+from vllm.distributed.parallel_state import get_tp_group
+from vllm.forward_context import get_forward_context, is_forward_context_available
+from vllm.utils.torch_utils import weak_ref_tensor
+
+_ROWS = 12
+_HIDDEN_SIZE = 3072
+_REDUCE_COUNT = 12
+
+
+class LagunaDFlashCollectiveState:
+    """Fixed-address outputs for one width-12 DFlash forward."""
+
+    def __init__(self, device: torch.device) -> None:
+        self.device = device
+        self.reduces = [
+            torch.empty(
+                (_ROWS, _HIDDEN_SIZE),
+                dtype=torch.bfloat16,
+                device=device,
+            )
+            for _ in range(_REDUCE_COUNT)
+        ]
+        self._next_reduce = 0
+        self._executed = 0
+
+    def reset_for_forward(self) -> None:
+        self._next_reduce = 0
+        self._executed = 0
+
+    def finish_forward(self) -> None:
+        # Capture walks the Python model and claims all twelve slots. Replay
+        # invokes the recorded eager callables directly, so no slot claims are
+        # observed. Both states are intentional; every eager callable must
+        # still execute.
+        if self._next_reduce not in (0, _REDUCE_COUNT):
+            raise RuntimeError(
+                "Laguna DFlash segmented graph changed collective order: "
+                f"saw {self._next_reduce}, expected 0 (replay) or "
+                f"{_REDUCE_COUNT} (capture)"
+            )
+        if self._executed != _REDUCE_COUNT:
+            raise RuntimeError(
+                "Laguna DFlash segmented graph changed eager collective count: "
+                f"saw {self._executed}, expected {_REDUCE_COUNT}"
+            )
+
+    def all_reduce(self, local: torch.Tensor) -> torch.Tensor:
+        expected = (_ROWS, _HIDDEN_SIZE)
+        if (
+            tuple(local.shape) != expected
+            or local.dtype != torch.bfloat16
+            or local.device != self.device
+            or not local.is_contiguous()
+        ):
+            raise RuntimeError(
+                "Laguna DFlash collective input drifted from its "
+                f"{expected} BF16 contiguous contract: got "
+                f"{tuple(local.shape)} {local.dtype} {local.device}"
+            )
+        if self._next_reduce >= _REDUCE_COUNT:
+            raise RuntimeError(
+                f"Laguna DFlash graph exceeded its {_REDUCE_COUNT} all-reduce slots"
+            )
+        index = self._next_reduce
+        output = self.reduces[index]
+        self._next_reduce += 1
+        if output.data_ptr() == local.data_ptr():
+            raise RuntimeError(
+                f"Laguna DFlash all-reduce slot {index} aliases its input"
+            )
+        return _eager_break_or_run(self._run_reduce, local, output, index)
+
+    def _run_reduce(
+        self,
+        local: torch.Tensor,
+        output: torch.Tensor,
+        index: int,
+    ) -> torch.Tensor:
+        expected = self.reduces[index]
+        if (
+            output.data_ptr() != expected.data_ptr()
+            or output.storage_offset() != expected.storage_offset()
+            or tuple(output.shape) != tuple(expected.shape)
+            or tuple(output.stride()) != tuple(expected.stride())
+            or output.dtype != expected.dtype
+            or output.device != expected.device
+        ):
+            raise RuntimeError(
+                f"Laguna DFlash all-reduce slot {index} output identity drifted"
+            )
+        output.copy_(local)
+        dist.all_reduce(output, group=get_tp_group().device_group)
+        self._executed += 1
+        return output
+
+
+def _eager_break_or_run(
+    run: Callable[[torch.Tensor, torch.Tensor, int], torch.Tensor],
+    local: torch.Tensor,
+    output: torch.Tensor,
+    index: int,
+) -> torch.Tensor:
+    from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+    capture = BreakableCUDAGraphCapture.current()
+    if capture is None or not capture._capturing:
+        return run(local, output, index)
+    weak_local = weak_ref_tensor(local)
+    weak_output = weak_ref_tensor(output)
+    state = _require_active_state()
+    return capture.add_eager(
+        lambda: state._run_reduce(weak_local, weak_output, index),
+        kind="collective",
+    )
+
+
+def _require_active_state() -> LagunaDFlashCollectiveState:
+    state = active_laguna_dflash_collective_state()
+    if state is None:
+        raise RuntimeError(
+            "Laguna DFlash collective invoked outside its guarded transaction"
+        )
+    return state
+
+
+def active_laguna_dflash_collective_state() -> LagunaDFlashCollectiveState | None:
+    if not is_forward_context_available():
+        return None
+    context = get_forward_context()
+    if (
+        context.additional_kwargs.get("xpu_laguna_dflash_segmented_graph_eligible")
+        is not True
+    ):
+        return None
+    state = context.additional_kwargs.get("xpu_laguna_dflash_collective_state")
+    if not isinstance(state, LagunaDFlashCollectiveState):
+        raise RuntimeError("Laguna DFlash eligible forward is missing collective state")
+    return state
