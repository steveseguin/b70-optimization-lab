+        CUTLASS_PRAGMA_UNROLL
+        for (int i = 0; i < tSrS.size(); ++i) {
+          int packed_q = get<0>(cS_thread(i));
+          int temporal_delta = packed_q < 6 ? 1 : 0;
+          int col_abs = get<1>(cS_thread(i));
+          int col_idx = get<1>(cS_thread(i)) - full_tile_offset;
+          int decode_row = -temporal_delta;
+          bool tail_mask = col_abs >= seq_len - temporal_delta;
+          bool left_mask = false;
+          bool right_mask = false;
+          if constexpr (LocalMask) {
+            left_mask = col_idx < decode_row - params.window_size_left;
+            right_mask = col_idx > decode_row + params.window_size_right;
+          }
+          if (tail_mask || left_mask || right_mask) {
+            tSrS(i) = ElementS(-INFINITY);
+          }
+        }
+      } else if constexpr (LocalMask) {
+        // Ordinary decode uses one KV position for all packed GQA heads.
         int decode_row = seq_len - 1 - full_tile_offset;
         Tensor cPgP = make_identity_tensor(make_shape(seq_len, seq_len));
         Tensor gP = local_tile(
