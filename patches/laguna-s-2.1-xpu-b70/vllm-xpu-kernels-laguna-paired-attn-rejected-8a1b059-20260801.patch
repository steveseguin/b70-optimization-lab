Subject: [PATCH 1/5] xpu: make paged decode scratch graph-recordable

Signed-off-by: Codex Agent <codex-agent@users.noreply.github.com>
---
 csrc/xpu/attn/xe_2/paged_decode.hpp | 91 ++++++++++++++++++++---------
 1 file changed, 63 insertions(+), 28 deletions(-)

diff --git a/csrc/xpu/attn/xe_2/paged_decode.hpp b/csrc/xpu/attn/xe_2/paged_decode.hpp
index d31702b..957c2a3 100644
--- a/csrc/xpu/attn/xe_2/paged_decode.hpp
+++ b/csrc/xpu/attn/xe_2/paged_decode.hpp
@@ -408,49 +408,84 @@ struct DecodeKernelLauncher {
     dim3 const block = FMHAKernel::get_block_shape();
     dim3 const grid = FMHAKernel::get_grid_shape(params);
 
+    static_assert(cute::intel::sg_size == 16);
+    using SharedStorage = typename FMHAKernel::SharedStorage;
+    static_assert(sizeof(SharedStorage) == FMHAKernel::SharedStorageSize);
+
     // cute::print("Launching FMHAKernel with grid: "); cute::print("%d x %d x
     // %d ", grid.x, grid.y, grid.z); cute::print("and block: ");
     // cute::print("%d x %d x %d\n", block.x, block.y, block.z);
 
-    // configure smem size and carveout
-    int smem_size = FMHAKernel::SharedStorageSize;
-
     const auto sycl_block = compat::dim3(block.x, block.y, block.z);
     const auto sycl_grid = compat::dim3(grid.x, grid.y, grid.z);
-
-    // Launch parameters depend on whether SYCL compiler supports work-group
-    // scratch memory extension
-    compat::experimental::launch_properties launch_props{
-        syclex::work_group_scratch_size(smem_size),
-    };
-    compat::experimental::kernel_properties kernel_props{
-        syclex::sub_group_size<cute::intel::sg_size>, intelex::grf_size<256>};
-    compat::experimental::launch_policy policy{
-        sycl_grid, sycl_block, launch_props, kernel_props};
-    compat::experimental::launch<cutlass::device_kernel<FMHAKernel>>(
-        policy, queue, params);
+    const sycl::range<3> local_range = sycl_block;
+    const sycl::range<3> global_range = sycl_grid * sycl_block;
+
+    syclex::properties kernel_props{
+        syclex::sub_group_size<16>, intelex::grf_size<256>};
+    queue.submit([&](sycl::handler& cgh) {
+      // Handler-owned local memory is represented explicitly in a command
+      // graph. The dynamic work_group_scratch_size property is not.
+      sycl::local_accessor<SharedStorage, 1> scratch{sycl::range<1>(1), cgh};
+      struct KernelFunctor {
+        decltype(kernel_props) properties;
+        sycl::local_accessor<SharedStorage, 1> scratch;
+        typename FMHAKernel::Params params;
+
+        auto get(syclex::properties_tag) const { return properties; }
+
+        void operator()(sycl::nd_item<3>) const {
+          auto* scratch_ptr = reinterpret_cast<char*>(
+              scratch
+                  .template get_multi_ptr<sycl::access::decorated::no>()
+                  .get());
+          FMHAKernel{}(params, scratch_ptr);
+        }
+      };
+      cgh.parallel_for<FMHAKernel>(
+          sycl::nd_range<3>{global_range, local_range},
+          KernelFunctor{kernel_props, scratch, params});
+    });
 
     // event.wait();
 
     if (need_reduce) {
       dim3 const reduce_grid =
           ReductionSplitKernel::get_grid_shape(reduce_params);
-      int reduce_smem_size = ReductionSplitKernel::SharedStorageSize;
+      using ReduceSharedStorage =
+          typename ReductionSplitKernel::SharedStorage;
+      static_assert(
+          sizeof(ReduceSharedStorage) ==
+          ReductionSplitKernel::SharedStorageSize);
+
       const auto reduce_sycl_block = compat::dim3(block.x, block.y, block.z);
       const auto reduce_sycl_grid =
           compat::dim3(reduce_grid.x, reduce_grid.y, reduce_grid.z);
-      compat::experimental::launch_properties launch_props_reduce{
-          syclex::work_group_scratch_size(reduce_smem_size),
-      };
-      compat::experimental::launch_policy reduce_policy{
-          reduce_sycl_grid,
-          reduce_sycl_block,
-          launch_props_reduce,
-          kernel_props};
-
-      compat::experimental::launch<
-          cutlass::device_kernel<ReductionSplitKernel>>(
-          reduce_policy, queue, reduce_params);
+      const sycl::range<3> reduce_local_range = reduce_sycl_block;
+      const sycl::range<3> reduce_global_range =
+          reduce_sycl_grid * reduce_sycl_block;
+      queue.submit([&](sycl::handler& cgh) {
+        sycl::local_accessor<ReduceSharedStorage, 1> scratch{
+            sycl::range<1>(1), cgh};
+        struct ReduceKernelFunctor {
+          decltype(kernel_props) properties;
+          sycl::local_accessor<ReduceSharedStorage, 1> scratch;
+          typename ReductionSplitKernel::Params params;
+
+          auto get(syclex::properties_tag) const { return properties; }
+
+          void operator()(sycl::nd_item<3>) const {
+            auto* scratch_ptr = reinterpret_cast<char*>(
+                scratch
+                    .template get_multi_ptr<sycl::access::decorated::no>()
+                    .get());
+            ReductionSplitKernel{}(params, scratch_ptr);
+          }
+        };
+        cgh.parallel_for<ReductionSplitKernel>(
+            sycl::nd_range<3>{reduce_global_range, reduce_local_range},
+            ReduceKernelFunctor{kernel_props, scratch, reduce_params});
+      });
       // reduce_event.wait();
     }
   }
-- 
