+            or transposed_gemm2_wei_scales is None
+        ):
+            raise RuntimeError(
+                "width-12 transposed-scale route has no persistent scales"
+            )
+        return (
+            transposed_gemm1_wei_scales,
+            transposed_gemm2_wei_scales,
+        )
