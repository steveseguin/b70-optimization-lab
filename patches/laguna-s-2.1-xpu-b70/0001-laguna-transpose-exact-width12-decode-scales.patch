+def _get_laguna_decode_transposed_scales() -> bool:
+    # Keep the Python model-layout selector byte-for-byte aligned with the
+    # C++ kernel selector.  Permissive spellings are deliberately rejected:
+    # a typo must not leave the model and kernel interpreting the same scale
+    # storage differently.
+    value = os.environ.get(LAGUNA_DECODE_TRANSPOSED_SCALES_ENV, "0")
+    if value == "0":
+        return False
+    if value == "1":
+        return True
+    raise RuntimeError(
+        f"{LAGUNA_DECODE_TRANSPOSED_SCALES_ENV} must be literal 0 or 1, "
+        f"got {value!r}"
+    )
+
