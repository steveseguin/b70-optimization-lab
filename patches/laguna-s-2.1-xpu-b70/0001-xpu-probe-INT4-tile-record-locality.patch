From 7af3f622d9bf0850661d69045fab18a188ca83f4 Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Sat, 1 Aug 2026 06:14:58 -0400
Subject: [PATCH] xpu: probe INT4 tile-record locality

---
 csrc/xpu/grouped_gemm/xe_2/gemm_xe2.hpp       | 56 ++++++++++---------
 .../grouped_gemm/xe_2/grouped_gemm_xe2.hpp    |  8 +--
 .../xe_2/grouped_gemm_xe2_interface.hpp       | 53 +++++++++++++-----
 3 files changed, 73 insertions(+), 44 deletions(-)

diff --git a/csrc/xpu/grouped_gemm/xe_2/gemm_xe2.hpp b/csrc/xpu/grouped_gemm/xe_2/gemm_xe2.hpp
index 30c7118..9d1766c 100644
--- a/csrc/xpu/grouped_gemm/xe_2/gemm_xe2.hpp
+++ b/csrc/xpu/grouped_gemm/xe_2/gemm_xe2.hpp
@@ -708,7 +708,7 @@ CUTE_DEVICE void xe_gemm_4bits(
 
   static_assert(
       !TileMajor || (tile_n == 64 && tile_k == 32 && group_size == 32),
-      "tile-major MXFP4 staging requires an N64/K32/group32 policy");
+      "tile-major 4-bit staging requires an N64/K32/group32 policy");
   static_assert(
       !TransposedScales || (!TileMajor && group_size == 32),
       "transposed INT4 scales require non-tile-major group32");
@@ -820,6 +820,10 @@ CUTE_DEVICE void xe_gemm_4bits(
   }
 
   using ElementB = typename BTensor::element_type;
+  static constexpr int32_t tile_record_weight_bytes = tile_n * tile_k / 2;
+  static constexpr int32_t tile_record_scale_bytes = tile_n * sizeof(ElementS);
+  static constexpr int32_t tile_record_bytes =
+      tile_record_weight_bytes + tile_record_scale_bytes;
   static constexpr bool is_B_fp8_type =
       std::is_same_v<ElementB, cutlass::float_e5m2_t> ||
       std::is_same_v<ElementB, cutlass::float_e4m3_t>;
@@ -828,12 +832,11 @@ CUTE_DEVICE void xe_gemm_4bits(
   for (; k_tile_prefetch < prefetch_dist; k_tile_prefetch++) {
     prefetch(prefetch_a, pAgA(_, _, _, k_tile_prefetch));
     if constexpr (TileMajor) {
-      constexpr int32_t weight_bytes = 64 * 32 / 2;
-      constexpr int32_t record_bytes = weight_bytes + 64;
       const uint8_t* record =
-          tile_records + (wg_n * group_num + k_tile_prefetch) * record_bytes;
+          tile_records +
+          (wg_n * group_num + k_tile_prefetch) * tile_record_bytes;
       auto packed_B = make_tensor(
-          make_gmem_ptr(reinterpret_cast<float_e2m1_t*>(
+          make_gmem_ptr(reinterpret_cast<ElementB*>(
               const_cast<uint8_t*>(record))),
           make_layout(
               make_shape(Int<64>{}, Int<32>{}),
@@ -872,12 +875,10 @@ CUTE_DEVICE void xe_gemm_4bits(
         const ElementS* scale_base;
         int scale_stride;
         if constexpr (TileMajor) {
-          constexpr int32_t weight_bytes = 64 * 32 / 2;
-          constexpr int32_t record_bytes = weight_bytes + 64;
           scale_base = reinterpret_cast<const ElementS*>(
               tile_records +
-              (wg_n * group_num + k_tile_prefetch) * record_bytes +
-              weight_bytes + n_sg_start);
+              (wg_n * group_num + k_tile_prefetch) * tile_record_bytes +
+              tile_record_weight_bytes) + n_sg_start;
           scale_stride = 1;
         } else {
           scale_base = Scales +
@@ -904,12 +905,10 @@ CUTE_DEVICE void xe_gemm_4bits(
 
     copy(copy_a, tAgA(_, _, _, k_tile), tArA);
     if constexpr (TileMajor) {
-      constexpr int32_t weight_bytes = 64 * 32 / 2;
-      constexpr int32_t record_bytes = weight_bytes + 64;
       const uint8_t* record =
-          tile_records + (wg_n * group_num + k_tile) * record_bytes;
+          tile_records + (wg_n * group_num + k_tile) * tile_record_bytes;
       auto packed_B = make_tensor(
-          make_gmem_ptr(reinterpret_cast<float_e2m1_t*>(
+          make_gmem_ptr(reinterpret_cast<ElementB*>(
               const_cast<uint8_t*>(record))),
           make_layout(
               make_shape(Int<64>{}, Int<32>{}),
@@ -938,8 +937,13 @@ CUTE_DEVICE void xe_gemm_4bits(
         for (int sn = 0; sn < acc_N; ++sn) {
           int sg_local_n = sn * sg_local_range + sg_local_id;
           float scale = 0.0f;
-          if constexpr (std::is_same_v<TB, int4_t>) {
-            if constexpr (TransposedScales) {
+            if constexpr (std::is_same_v<TB, int4_t>) {
+            if constexpr (TileMajor) {
+              scale = reinterpret_cast<const ElementS*>(
+                  tile_records +
+                  (wg_n * group_num + group_idx) * tile_record_bytes +
+                  tile_record_weight_bytes)[n_sg_start + sg_local_n];
+            } else if constexpr (TransposedScales) {
               scale = static_cast<float>(
                   Scales
                       [group_idx * shape<0>(B) + n_tile_start + n_sg_start +
@@ -977,8 +981,13 @@ CUTE_DEVICE void xe_gemm_4bits(
             int real_idx = x_idx + c * (sg_local_range / channel_num);
             int sg_local_n = n * sg_local_range + real_idx;
             scaleStoreType scale;
-            if constexpr (std::is_same_v<TB, int4_t>) {
-              if constexpr (TransposedScales) {
+          if constexpr (std::is_same_v<TB, int4_t>) {
+              if constexpr (TileMajor) {
+                scale = reinterpret_cast<const ElementS*>(
+                    tile_records +
+                    (wg_n * group_num + group_idx) * tile_record_bytes +
+                    tile_record_weight_bytes)[n_sg_start + sg_local_n];
+              } else if constexpr (TransposedScales) {
                 scale = Scales
                     [group_idx * shape<0>(B) + n_tile_start + n_sg_start +
                      sg_local_n];
@@ -1038,12 +1047,11 @@ CUTE_DEVICE void xe_gemm_4bits(
           const ElementS* scale_base;
           int scale_stride;
           if constexpr (TileMajor) {
-            constexpr int32_t weight_bytes = 64 * 32 / 2;
-            constexpr int32_t record_bytes = weight_bytes + 64;
             scale_base = reinterpret_cast<const ElementS*>(
                 tile_records +
-                (wg_n * group_num + group_idx + prefetch_dist) * record_bytes +
-                weight_bytes + n_sg_start);
+                (wg_n * group_num + group_idx + prefetch_dist) *
+                    tile_record_bytes +
+                tile_record_weight_bytes) + n_sg_start;
             scale_stride = 1;
           } else {
             scale_base = Scales +
@@ -1069,13 +1077,11 @@ CUTE_DEVICE void xe_gemm_4bits(
     if (k_tile_prefetch < k_tile_count) {
       prefetch(prefetch_a, pAgA(_, _, _, k_tile_prefetch));
       if constexpr (TileMajor) {
-        constexpr int32_t weight_bytes = 64 * 32 / 2;
-        constexpr int32_t record_bytes = weight_bytes + 64;
         const uint8_t* record =
             tile_records +
-            (wg_n * group_num + k_tile_prefetch) * record_bytes;
+            (wg_n * group_num + k_tile_prefetch) * tile_record_bytes;
         auto packed_B = make_tensor(
-            make_gmem_ptr(reinterpret_cast<float_e2m1_t*>(
+            make_gmem_ptr(reinterpret_cast<ElementB*>(
                 const_cast<uint8_t*>(record))),
             make_layout(
                 make_shape(Int<64>{}, Int<32>{}),
diff --git a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
index 72f2c25..7a53a4b 100644
--- a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
+++ b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2.hpp
@@ -202,9 +202,9 @@ CUTE_DEVICE void MoEGEMM(
       B_offset /= 2;
     }
     if constexpr (TileMajor) {
-      static_assert(is_B_mxfp4, "tile-major layout is MXFP4-only");
+      static_assert(is_B_4bits, "tile-major layout requires 4-bit weights");
       B_offset = static_cast<int64_t>(expert_id) * gemm_n *
-                 (gemm_k / 32) * 17;
+                 (gemm_k / 32) * (16 + sizeof(ElementS));
     }
     ElementA* ptr_A_curr_batch =
         const_cast<ElementA*>(Activations) + pre_rows * gemm_k;
@@ -220,8 +220,8 @@ CUTE_DEVICE void MoEGEMM(
             const_cast<ElementS*>(Scales) + B_offset * 2 / group_size;
       }
       if constexpr (TileMajor) {
-        ptr_Scales_curr_batch =
-            const_cast<ElementS*>(Scales) + B_offset;
+        ptr_Scales_curr_batch = reinterpret_cast<ElementS*>(
+            const_cast<ElementB*>(Weights) + B_offset);
       }
     }
     ElementBI* ptr_Bias_curr_batch = nullptr;
diff --git a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp
index 445f689..c1d1787 100644
--- a/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp
+++ b/csrc/xpu/grouped_gemm/xe_2/grouped_gemm_xe2_interface.hpp
@@ -413,7 +413,7 @@ void MoEGEMMLauncher(
       syclex::sub_group_size<16>, intelex::grf_size<256>};
 
   constexpr bool can_use_grf128 =
-      layoutA == 'R' && layoutB == 'C' && !TileMajor &&
+      layoutA == 'R' && layoutB == 'C' &&
       std::is_same_v<ElementA_non_CV, bfloat16_t> &&
       std::is_same_v<ElementB, uint8_t> &&
       std::is_same_v<ElementS, bfloat16_t> &&
@@ -424,7 +424,7 @@ void MoEGEMMLauncher(
   const bool use_exact_specialized =
       use_grf128 && laguna_int4_decode_exact_specialized();
   const bool use_transposed_scales =
-      use_grf128 && laguna_int4_decode_transposed_scales();
+      use_grf128 && !TileMajor && laguna_int4_decode_transposed_scales();
 
   using GmemTiledCopyA = typename policy::GmemTiledCopyA;
   using GmemTiledCopyB = typename policy::GmemTiledCopyB;
@@ -467,7 +467,7 @@ void MoEGEMMLauncher(
               layoutB,
               'R',
               TileMajor,
-              true>(
+              !TileMajor>(
               activations,
               weights,
               scales,
@@ -494,8 +494,8 @@ void MoEGEMMLauncher(
               layoutB,
               'R',
               TileMajor,
-              true,
-              true>(
+              !TileMajor,
+              !TileMajor>(
               activations,
               weights,
               scales,
@@ -1128,11 +1128,22 @@ at::Tensor cutlass_grouped_gemm_xe2_impl(
   bool is_B_mxfp4 =
       (B_dtype == at::kFloat4_e2m1fn_x2) && ptr_scales.has_value();
   const char* tile_major_env = std::getenv("VLLM_XPU_MXFP4_TILE_MAJOR_PREPACK");
-  const bool tile_major =
+  const bool mxfp4_tile_major =
       tile_major_env != nullptr && std::strcmp(tile_major_env, "1") == 0;
+  const char* int4_tile_record_env =
+      std::getenv("VLLM_XPU_LAGUNA_INT4_TILE_RECORD");
+  const bool int4_tile_record = int4_tile_record_env != nullptr &&
+      std::strcmp(int4_tile_record_env, "1") == 0;
+  const bool tile_major = mxfp4_tile_major || int4_tile_record;
   TORCH_CHECK(
-      !tile_major || is_B_mxfp4,
+      !mxfp4_tile_major || is_B_mxfp4,
       "VLLM_XPU_MXFP4_TILE_MAJOR_PREPACK=1 is valid only for MXFP4 weights");
+  TORCH_CHECK(
+      !int4_tile_record || is_B_int4,
+      "VLLM_XPU_LAGUNA_INT4_TILE_RECORD=1 is valid only for INT4 weights");
+  TORCH_CHECK(
+      !(mxfp4_tile_major && int4_tile_record),
+      "MXFP4 and INT4 tile-record selectors are mutually exclusive");
 
   TORCH_CHECK(N % 8 == 0, "N must be divisible by 8");
 
@@ -1219,14 +1230,26 @@ at::Tensor cutlass_grouped_gemm_xe2_impl(
         "ptr_scales.size(0) of int4 must match num_experts");
     bool transposed_scale_layout = false;
     if (tile_major) {
-      const int64_t packed_last = (K / 32) * 17;
+      const int64_t record_bytes_per_n =
+          is_B_int4 ? 18 : 17;
+      const int64_t packed_last = (K / 32) * record_bytes_per_n;
       TORCH_CHECK(
           ptr_B.size(1) == N && ptr_B.size(2) == packed_last,
-          "tile-major ptr_B must have shape [num_experts, N, 17*K/32]");
-      TORCH_CHECK(
-          ptr_scales->sizes() == ptr_B.sizes() &&
-              ptr_scales->data_ptr() == ptr_B.data_ptr(),
-          "tile-major scales must alias combined weight record storage");
+          "tile-major ptr_B has the wrong packed-record shape");
+      if (is_B_int4) {
+        TORCH_CHECK(
+            ptr_scales->dtype() == at::kBFloat16 &&
+                ptr_scales->size(1) == N &&
+                ptr_scales->size(2) == packed_last / 2 &&
+                ptr_scales->data_ptr() == ptr_B.data_ptr(),
+            "INT4 tile-record scales must be a BF16 view of the combined "
+            "weight record storage");
+      } else {
+        TORCH_CHECK(
+            ptr_scales->sizes() == ptr_B.sizes() &&
+                ptr_scales->data_ptr() == ptr_B.data_ptr(),
+            "MXFP4 tile-major scales must alias combined record storage");
+      }
       group_size = 32;
     } else {
       transposed_scale_layout =
@@ -1272,11 +1295,11 @@ at::Tensor cutlass_grouped_gemm_xe2_impl(
     if (A_dtype == at::kBFloat16) {                                 \
       using scalar_t = bfloat16_t;                                  \
       MoEGEMMLauncherCallER(                                        \
-          'R', 'C', policy, false, scalar_t, uint8_t, scalar_t);    \
+          'R', 'C', policy, TileMajor, scalar_t, uint8_t, scalar_t); \
     } else if (A_dtype == at::kHalf) {                              \
       using scalar_t = half_t;                                      \
       MoEGEMMLauncherCallER(                                        \
-          'R', 'C', policy, false, scalar_t, uint8_t, scalar_t);    \
+          'R', 'C', policy, TileMajor, scalar_t, uint8_t, scalar_t); \
     }                                                               \
   } else if (is_B_mxfp4) {                                          \
     if (A_dtype == at::kBFloat16) {                                 \
