diff --git a/tests/test_laguna_int4_affine_tile_record_static.py b/tests/test_laguna_int4_affine_tile_record_static.py
new file mode 100644
index 0000000..f3b5745
--- /dev/null
+++ b/tests/test_laguna_int4_affine_tile_record_static.py
@@ -0,0 +1,71 @@
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[1]
+GEMM = (ROOT / "csrc/xpu/grouped_gemm/xe_2/gemm_xe2.hpp").read_text()
+
+
+def _xe_gemm_4bits() -> str:
+    start = GEMM.index("CUTE_DEVICE void xe_gemm_4bits(")
+    return GEMM[start:]
+
+
+def _affine_setup() -> str:
+    function = _xe_gemm_4bits()
+    start = function.index("// A tile record is logically [N64, K32, K-group].")
+    end = function.index("using scaleStoreType", start)
+    return function[start:end]
+
+
+def _k_traversal() -> str:
+    function = _xe_gemm_4bits()
+    start = function.index("CUTE_UNROLL\n  for (; k_tile_prefetch")
+    end = function.index("if (Bias != nullptr)", start)
+    return function[start:end]
+
+
+def test_affine_int4_route_is_separate_from_mxfp4_tile_major() -> None:
+    setup = _affine_setup()
+    assert "TileMajor && is_same_v<ElementB, int4_t>" in setup
+    assert "if constexpr (affine_tile_records)" in setup
+
+
+def test_weight_record_uses_one_rank3_affine_view_and_payload() -> None:
+    setup = _affine_setup()
+    assert "make_shape(Int<tile_n>{}, Int<tile_k>{}, group_num)" in setup
+    assert "Int<tile_k>{}, Int<1>{}, Int<tile_record_stride>{}" in setup
+    assert setup.count("auto tile_record_B = make_tensor") == 1
+    copy_build = "get_block_2d_copy_B<GmemTiledCopyB>(mma, tile_record_B)"
+    assert setup.count(copy_build) == 1
+    assert setup.count("make_block_2d_prefetch(tile_record_copy_b)") == 1
+
+
+def test_scale_record_uses_one_rank2_affine_view_and_payload() -> None:
+    setup = _affine_setup()
+    assert "make_shape(Int<tile_n>{}, group_num)" in setup
+    assert "make_stride(Int<1>{}, Int<tile_record_scale_stride>{})" in setup
+    assert setup.count("auto tile_record_S = make_tensor") == 1
+    assert setup.count("make_block_2d_prefetch<4>(") == 1
+
+
+def test_affine_hot_path_uses_coordinates_without_rebuilding_views() -> None:
+    traversal = _k_traversal()
+    affine_blocks = "\n".join(
+        block.split("} else if constexpr (TileMajor)", 1)[0]
+        for block in traversal.split("if constexpr (affine_tile_records)")[1:]
+    )
+    assert "tile_record_pBgB(_, _, _, 0, k_tile_prefetch)" in affine_blocks
+    assert "tile_record_tBgB(_, _, _, 0, k_tile)" in affine_blocks
+    assert "tile_record_pSgS(_, 0, 0, k_tile_prefetch)" in affine_blocks
+    assert "tile_record_S(n_sg_start + sg_local_n, group_idx)" in traversal
+    assert (
+        "if constexpr (affine_tile_records) {\n      const uint8_t* record"
+        not in traversal
+    )
+
+
+def test_mxfp4_fallback_retains_dynamic_tile_major_construction() -> None:
+    traversal = _k_traversal()
+    assert traversal.count("else if constexpr (TileMajor)") >= 3
+    assert traversal.count("auto packed_B = make_tensor") == 3
+    assert "std::is_same_v<TB, float_e2m1_t>" in traversal
