+def test_laguna_m8_inline_gathers_keep_embedding_reduce_eager(monkeypatch):
+    import vllm.compilation.laguna_m8_collectives as collectives
+    from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_INLINE_GATHERS", "1")
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+    monkeypatch.setattr(collectives, "weak_ref_tensor", lambda tensor: tensor)
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_gather_into_tensor",
+        lambda output, local, group: output.copy_(local.expand_as(output)),
+    )
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_reduce",
+        lambda output, group: output.add_(1),
+    )
+
+    eager_kinds = []
+
+    class _Capture:
+        _capturing = True
+
+        def add_eager(self, callback, *, kind):
+            eager_kinds.append(kind)
+            return callback()
+
+    capture = _Capture()
+    monkeypatch.setattr(
+        BreakableCUDAGraphCapture,
+        "current",
+        classmethod(lambda cls: capture),
+    )
+
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    monkeypatch.setattr(collectives, "_require_active_state", lambda: state)
+    local = torch.ones((1, 8, 3072), dtype=torch.bfloat16)
+
+    # Capture: the embedding all-reduce is the only eager callback. All 96
+    # gathers execute directly while the surrounding graph is recording.
+    state.reset_for_eligible_forward()
+    state.all_reduce(local.squeeze(0))
+    for _ in range(96):
+        state.all_gather(local, dim=0)
+    assert eager_kinds == ["collective"]
+    state.finish_eligible_forward()
+
+    # Replay: the model body does not re-enter Python, while the embedding
+    # callback does. This is the only accepted zero-cursor inline state.
+    state.reset_for_eligible_forward()
+    state._run_reduce(local.squeeze(0), state.embedding_reduce)
+    state.finish_eligible_forward()
+
+
+def test_laguna_m8_inline_gathers_flag_off_keeps_gather_eager(monkeypatch):
+    import vllm.compilation.laguna_m8_collectives as collectives
+    from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_INLINE_GATHERS", "0")
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+    monkeypatch.setattr(collectives, "weak_ref_tensor", lambda tensor: tensor)
+    monkeypatch.setattr(
+        collectives.dist,
+        "all_gather_into_tensor",
+        lambda output, local, group: output.copy_(local.expand_as(output)),
+    )
+    monkeypatch.setattr(collectives.dist, "all_reduce", lambda output, group: None)
+
+    eager_kinds = []
+
+    class _Capture:
+        _capturing = True
+
+        def add_eager(self, callback, *, kind):
+            eager_kinds.append(kind)
+            return callback()
+
+    monkeypatch.setattr(
+        BreakableCUDAGraphCapture,
+        "current",
+        classmethod(lambda cls: _Capture()),
+    )
+
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    monkeypatch.setattr(collectives, "_require_active_state", lambda: state)
+    local = torch.ones((1, 8, 3072), dtype=torch.bfloat16)
+    state.reset_for_eligible_forward()
+    state.all_reduce(local.squeeze(0))
+    state.all_gather(local, dim=0)
+
+    assert eager_kinds == ["collective", "collective"]
+
+
+def test_laguna_m8_inline_gathers_reject_partial_capture(monkeypatch):
+    monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_INLINE_GATHERS", "1")
+    state = LagunaM8CollectiveState(torch.device("cpu"))
+    state._first_reduce_seen = True
+    state._next_gather = 95
+    state._executed = 95
+
+    with pytest.raises(RuntimeError, match="changed gather order"):
+        state.finish_eligible_forward()
