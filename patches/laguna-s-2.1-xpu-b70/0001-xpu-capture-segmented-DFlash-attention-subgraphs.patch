+++ b/vllm/v1/worker/gpu_model_runner.py
@@ -4120,6 +4120,14 @@ class GPUModelRunner(
         )
 
     def _validate_laguna_m8_breakable_graph_config(self) -> None:
+        if (
+            envs.VLLM_XPU_LAGUNA_DFLASH_CAPTURE_ATTENTION_GRAPHS
+            and not envs.VLLM_XPU_LAGUNA_DFLASH_SEGMENTED_GRAPH
+        ):
+            raise ValueError(
+                "Laguna DFlash attention subgraphs require the segmented "
+                "DFlash graph contract"
+            )
         if envs.VLLM_XPU_LAGUNA_DFLASH_SEGMENTED_GRAPH:
             segmented_invalid = {
                 "legacy_draft_graph": envs.VLLM_XPU_LAGUNA_DRAFT_BREAKABLE_GRAPH,
@@ -4223,6 +4231,24 @@ class GPUModelRunner(
                 f"runtime-capture contract: {invalid}"
             )
 
+    def _laguna_dflash_graph_wrapper_kwargs(self) -> dict[str, Any]:
+        segmented = envs.VLLM_XPU_LAGUNA_DFLASH_SEGMENTED_GRAPH
+        return {
+            "capture_filter": (
+                self._laguna_dflash_segmented_graph_capture_filter
+                if segmented
+                else None
+            ),
+            "keep_output_alive": segmented,
+            "enforce_static_inputs": True,
+            "materialize_capture_segments": segmented,
+            "capture_attention_graphs": (
+                segmented and envs.VLLM_XPU_LAGUNA_DFLASH_CAPTURE_ATTENTION_GRAPHS
+            ),
+            "expected_num_graphs": 20 if segmented else None,
+            "expected_num_eager_breaks": 19 if segmented else None,
+        }
+
     def _validate_laguna_m8_evidence_config(self) -> None:
         arm = self.laguna_m8_evidence_arm
         if arm is None:
@@ -6254,22 +6280,7 @@ class GPUModelRunner(
                 drafter.model = BreakableCUDAGraphWrapper(
                     drafter.model,
                     self.vllm_config,
