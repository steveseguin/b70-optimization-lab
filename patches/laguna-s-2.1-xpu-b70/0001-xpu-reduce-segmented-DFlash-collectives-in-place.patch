 5 files changed, 192 insertions(+), 17 deletions(-)

diff --git a/tests/v1/cudagraph/test_laguna_dflash_collectives.py b/tests/v1/cudagraph/test_laguna_dflash_collectives.py
index 60dda9cec..7e3146899 100644
--- a/tests/v1/cudagraph/test_laguna_dflash_collectives.py
+++ b/tests/v1/cudagraph/test_laguna_dflash_collectives.py
@@ -21,6 +21,7 @@ def _patch_collective(monkeypatch: pytest.MonkeyPatch) -> None:
         "all_reduce",
         lambda output, group: output.add_(1),
     )
+    monkeypatch.setattr(collectives, "weak_ref_tensor", lambda tensor: tensor)
 
 
 def test_dflash_collective_slots_are_fixed_and_ordered(
@@ -84,3 +85,91 @@ def test_dflash_collective_detects_replay_output_substitution(
     replacement = torch.empty_like(state.reduces[0])
     with pytest.raises(RuntimeError, match="output identity drifted"):
         state._run_reduce(local, replacement, 0)
+
+
+class _Capture:
+    _capturing = True
+
+    def add_eager(self, fn, *, kind):
+        assert kind == "collective"
+        return fn()
+
+
+def _activate_capture(
+    monkeypatch: pytest.MonkeyPatch,
+    state: LagunaDFlashCollectiveState,
+) -> None:
+    import vllm.compilation.laguna_dflash_collectives as collectives
+    from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+    capture = _Capture()
+    monkeypatch.setattr(
+        BreakableCUDAGraphCapture,
+        "current",
+        classmethod(lambda cls: capture),
+    )
+    monkeypatch.setattr(
+        collectives,
+        "active_laguna_dflash_collective_state",
+        lambda: state,
+    )
+
+
+def test_dflash_inplace_collective_binds_and_owns_capture_tensor(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _patch_collective(monkeypatch)
+    state = LagunaDFlashCollectiveState(
+        torch.device("cpu"),
+        inplace_collectives=True,
+    )
+    _activate_capture(monkeypatch, state)
+    assert all(output is None for output in state.reduces)
+    locals_ = [
+        torch.full((12, 3072), index + 1, dtype=torch.bfloat16)
+        for index in range(13)
+    ]
+    for index, local in enumerate(locals_):
+        output = state.all_reduce(local)
+        assert output is local
+        assert state.reduces[index] is local
+        assert torch.equal(output, torch.full_like(output, index + 2))
+    addresses = {
+        output.data_ptr() for output in state.reduces if output is not None
+    }
+    assert len(addresses) == 13
+    state.finish_forward()
+    state.reset_for_forward()
+    for index, local in enumerate(locals_):
+        assert state._run_reduce(local, local, index) is local
+    state.finish_forward()
+
+
+def test_dflash_inplace_collective_rejects_binding_outside_capture(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _patch_collective(monkeypatch)
+    state = LagunaDFlashCollectiveState(
+        torch.device("cpu"),
+        inplace_collectives=True,
+    )
+    local = torch.ones((12, 3072), dtype=torch.bfloat16)
+    with pytest.raises(RuntimeError, match="only during graph capture"):
+        state.all_reduce(local)
+
+
+def test_dflash_inplace_collective_rejects_slot_replacement(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    _patch_collective(monkeypatch)
+    state = LagunaDFlashCollectiveState(
+        torch.device("cpu"),
+        inplace_collectives=True,
+    )
+    _activate_capture(monkeypatch, state)
+    local = torch.ones((12, 3072), dtype=torch.bfloat16)
+    state.all_reduce(local)
+    state.reset_for_forward()
+    replacement = torch.ones_like(local)
+    with pytest.raises(RuntimeError, match="input identity drifted"):
+        state.all_reduce(replacement)
