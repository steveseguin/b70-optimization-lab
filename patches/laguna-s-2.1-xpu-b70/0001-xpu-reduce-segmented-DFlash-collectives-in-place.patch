 def test_laguna_m8_prebuilt_exact_metadata_accepts_exact_contract(monkeypatch):
     monkeypatch.setenv("VLLM_XPU_LAGUNA_M8_BREAKABLE_GRAPH", "1")
     monkeypatch.setenv(
diff --git a/vllm/compilation/laguna_dflash_collectives.py b/vllm/compilation/laguna_dflash_collectives.py
index e7ce550ce..af8278a22 100644
--- a/vllm/compilation/laguna_dflash_collectives.py
+++ b/vllm/compilation/laguna_dflash_collectives.py
@@ -4,15 +4,17 @@
 
 The rejected whole-drafter graph did not give DFlash collectives explicit
 eager boundaries. This state mirrors the proven target-graph rule on a much
-narrower contract: thirteen ordered BF16 all-reduces, each [12, 3072], with a
-dedicated fixed-address output allocated before capture. The shared
-vocabulary-parallel embedding contributes one reduction before the two
-reductions in each of the six DFlash decoder layers.
+narrower contract: thirteen ordered BF16 all-reduces, each [12, 3072]. The
+default allocates a dedicated fixed-address output before capture; the guarded
+in-place candidate instead retains and validates the captured segment output.
+The shared vocabulary-parallel embedding contributes one reduction before the
+two reductions in each of the six DFlash decoder layers.
 """
 
 from __future__ import annotations
 
 from collections.abc import Callable
+from typing import cast
 
 import torch
 import torch.distributed as dist
@@ -29,16 +31,28 @@ _REDUCE_COUNT = 13
 class LagunaDFlashCollectiveState:
     """Fixed-address outputs for one width-12 DFlash forward."""
 
-    def __init__(self, device: torch.device) -> None:
+    def __init__(
+        self,
+        device: torch.device,
+        *,
+        inplace_collectives: bool = False,
+    ) -> None:
         self.device = device
-        self.reduces = [
-            torch.empty(
-                (_ROWS, _HIDDEN_SIZE),
-                dtype=torch.bfloat16,
-                device=device,
-            )
-            for _ in range(_REDUCE_COUNT)
-        ]
+        self.inplace_collectives = inplace_collectives
+        self.reduces: list[torch.Tensor | None]
+        if inplace_collectives:
+            # Capture binds these slots to the graph-produced boundary tensors.
+            # Strong ownership keeps their addresses alive for every replay.
+            self.reduces = [None] * _REDUCE_COUNT
+        else:
+            self.reduces = [
+                torch.empty(
+                    (_ROWS, _HIDDEN_SIZE),
+                    dtype=torch.bfloat16,
+                    device=device,
+                )
+                for _ in range(_REDUCE_COUNT)
+            ]
         self._next_reduce = 0
         self._executed = 0
 
@@ -81,14 +95,48 @@ class LagunaDFlashCollectiveState:
                 f"Laguna DFlash graph exceeded its {_REDUCE_COUNT} all-reduce slots"
             )
         index = self._next_reduce
-        output = self.reduces[index]
+        output = self._output_for_slot(local, index)
         self._next_reduce += 1
-        if output.data_ptr() == local.data_ptr():
+        if not self.inplace_collectives and output.data_ptr() == local.data_ptr():
             raise RuntimeError(
                 f"Laguna DFlash all-reduce slot {index} aliases its input"
             )
         return _eager_break_or_run(self._run_reduce, local, output, index)
 
+    @staticmethod
+    def _tensor_signature(tensor: torch.Tensor) -> tuple[object, ...]:
+        return (
+            tensor.data_ptr(),
+            tensor.storage_offset(),
+            tuple(tensor.shape),
+            tuple(tensor.stride()),
+            tensor.dtype,
+            tensor.device,
+        )
+
+    def _output_for_slot(self, local: torch.Tensor, index: int) -> torch.Tensor:
+        output = self.reduces[index]
+        if not self.inplace_collectives:
+            return cast(torch.Tensor, output)
+        if output is None:
+            from vllm.compilation.breakable_cudagraph import (
+                BreakableCUDAGraphCapture,
+            )
+
+            capture = BreakableCUDAGraphCapture.current()
+            if capture is None or not capture._capturing:
+                raise RuntimeError(
+                    "Laguna DFlash in-place collective slot binding is allowed "
+                    "only during graph capture"
+                )
+            self.reduces[index] = local
+            return local
+        if self._tensor_signature(local) != self._tensor_signature(output):
+            raise RuntimeError(
+                f"Laguna DFlash in-place collective slot {index} input identity drifted"
+            )
+        return output
+
     def _run_reduce(
         self,
         local: torch.Tensor,
@@ -96,6 +144,10 @@ class LagunaDFlashCollectiveState:
         index: int,
     ) -> torch.Tensor:
         expected = self.reduces[index]
+        if expected is None:
+            raise RuntimeError(
+                f"Laguna DFlash all-reduce slot {index} was not bound during capture"
+            )
         if (
             output.data_ptr() != expected.data_ptr()
             or output.storage_offset() != expected.storage_offset()
@@ -107,7 +159,14 @@ class LagunaDFlashCollectiveState:
             raise RuntimeError(
                 f"Laguna DFlash all-reduce slot {index} output identity drifted"
             )
-        output.copy_(local)
+        if self.inplace_collectives:
+            if self._tensor_signature(local) != self._tensor_signature(output):
+                raise RuntimeError(
+                    f"Laguna DFlash in-place collective slot {index} input "
+                    "identity drifted during replay"
+                )
+        else:
+            output.copy_(local)
         dist.all_reduce(output, group=get_tp_group().device_group)
         self._executed += 1
         return output
