diff --git a/tests/v1/cudagraph/test_laguna_dflash_collectives.py b/tests/v1/cudagraph/test_laguna_dflash_collectives.py
index 60dda9cec..d6a89452e 100644
--- a/tests/v1/cudagraph/test_laguna_dflash_collectives.py
+++ b/tests/v1/cudagraph/test_laguna_dflash_collectives.py
@@ -21,6 +21,7 @@ def _patch_collective(monkeypatch: pytest.MonkeyPatch) -> None:
         "all_reduce",
         lambda output, group: output.add_(1),
     )
+    monkeypatch.setattr(collectives, "weak_ref_tensor", lambda tensor: tensor)
 
 
 def test_dflash_collective_slots_are_fixed_and_ordered(
@@ -84,3 +85,57 @@ def test_dflash_collective_detects_replay_output_substitution(
     replacement = torch.empty_like(state.reduces[0])
     with pytest.raises(RuntimeError, match="output identity drifted"):
         state._run_reduce(local, replacement, 0)
+
+
+class _Capture:
+    _capturing = True
+
+    def add_eager(self, fn, *, kind):
+        assert kind == "collective"
+        return fn()
+
+
+def test_dflash_captured_copy_prepares_fixed_output_before_reduce(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    import vllm.compilation.laguna_dflash_collectives as collectives
+    from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphCapture
+
+    events = []
+
+    def reduce(output, group):
+        assert group is _Group.device_group
+        assert torch.equal(output, torch.full_like(output, 3))
+        events.append("reduce")
+        output.add_(1)
+
+    monkeypatch.setattr(collectives, "get_tp_group", lambda: _Group())
+    monkeypatch.setattr(collectives.dist, "all_reduce", reduce)
+    monkeypatch.setattr(collectives, "weak_ref_tensor", lambda tensor: tensor)
+    capture = _Capture()
+    monkeypatch.setattr(
+        BreakableCUDAGraphCapture,
+        "current",
+        classmethod(lambda cls: capture),
+    )
+    state = LagunaDFlashCollectiveState(
+        torch.device("cpu"),
+        capture_collective_copies=True,
+    )
+    monkeypatch.setattr(
+        collectives,
+        "active_laguna_dflash_collective_state",
+        lambda: state,
+    )
+    local = torch.full((12, 3072), 3, dtype=torch.bfloat16)
+    output = state.all_reduce(local)
+    assert events == ["reduce"]
+    assert output is state.reduces[0]
+    assert output.data_ptr() != local.data_ptr()
+    assert torch.equal(output, torch.full_like(output, 4))
+
+    state.reset_for_forward()
+    output.fill_(3)
+    state._run_copied_reduce(output, 0)
+    assert state._next_reduce == 0
+    assert state._executed == 1
