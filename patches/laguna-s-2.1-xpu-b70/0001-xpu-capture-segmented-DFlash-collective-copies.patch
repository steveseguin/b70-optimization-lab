diff --git a/vllm/compilation/laguna_dflash_collectives.py b/vllm/compilation/laguna_dflash_collectives.py
index e7ce550ce..f17a998cc 100644
--- a/vllm/compilation/laguna_dflash_collectives.py
+++ b/vllm/compilation/laguna_dflash_collectives.py
@@ -29,8 +29,14 @@ _REDUCE_COUNT = 13
 class LagunaDFlashCollectiveState:
     """Fixed-address outputs for one width-12 DFlash forward."""
 
-    def __init__(self, device: torch.device) -> None:
+    def __init__(
+        self,
+        device: torch.device,
+        *,
+        capture_collective_copies: bool = False,
+    ) -> None:
         self.device = device
+        self.capture_collective_copies = capture_collective_copies
         self.reduces = [
             torch.empty(
                 (_ROWS, _HIDDEN_SIZE),
@@ -95,6 +101,11 @@ class LagunaDFlashCollectiveState:
         output: torch.Tensor,
         index: int,
     ) -> torch.Tensor:
+        self._check_output(output, index)
+        output.copy_(local)
+        return self._run_copied_reduce(output, index)
+
+    def _check_output(self, output: torch.Tensor, index: int) -> None:
         expected = self.reduces[index]
         if (
             output.data_ptr() != expected.data_ptr()
@@ -107,7 +118,13 @@ class LagunaDFlashCollectiveState:
             raise RuntimeError(
                 f"Laguna DFlash all-reduce slot {index} output identity drifted"
             )
-        output.copy_(local)
+
+    def _run_copied_reduce(
+        self,
+        output: torch.Tensor,
+        index: int,
+    ) -> torch.Tensor:
+        self._check_output(output, index)
         dist.all_reduce(output, group=get_tp_group().device_group)
         self._executed += 1
         return output
@@ -124,9 +141,19 @@ def _eager_break_or_run(
     capture = BreakableCUDAGraphCapture.current()
     if capture is None or not capture._capturing:
         return run(local, output, index)
-    weak_local = weak_ref_tensor(local)
     weak_output = weak_ref_tensor(output)
     state = _require_active_state()
+    if state.capture_collective_copies:
+        # This executes while the preceding compute segment is still open, so
+        # the copy is recorded at its tail. add_eager then materializes that
+        # segment before the unchanged all-reduce consumes the fixed output.
+        state._check_output(output, index)
+        output.copy_(local)
+        return capture.add_eager(
+            lambda: state._run_copied_reduce(weak_output, index),
+            kind="collective",
+        )
+    weak_local = weak_ref_tensor(local)
     return capture.add_eager(
         lambda: state._run_reduce(weak_local, weak_output, index),
         kind="collective",
