+    def _cow_worker_tensor_slice(
+        self,
+        tensor: torch.Tensor | None,
+        start: int,
+        end: int,
+        limit: int = 64,
+    ) -> dict[str, Any] | None:
+        if tensor is None:
+            return None
+        try:
+            start = max(0, int(start))
+            end = max(start, int(end))
+            captured_end = min(end, start + int(limit))
+            detached = tensor[start:captured_end].detach()
+            flat = detached.reshape(-1)
+            return {
+                "start": start,
+                "end": end,
+                "captured_end": captured_end,
+                "shape": list(detached.shape),
+                "dtype": str(detached.dtype),
+                "device": str(detached.device),
+                "head": flat.to("cpu").tolist(),
+            }
+        except Exception as exc:
+            return {"error": repr(exc), "start": start, "end": end}
+
