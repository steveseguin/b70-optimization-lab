+    ctx.stream()->memcpy(projection.data(), plan.projection->data, projection.size()*sizeof(float));
+    ctx.stream()->memcpy(residual.data(), plan.residual->data, residual.size()*sizeof(float));
+    ctx.stream()->memcpy(add.data(), plan.add->data, add.size()*sizeof(float)).wait();
