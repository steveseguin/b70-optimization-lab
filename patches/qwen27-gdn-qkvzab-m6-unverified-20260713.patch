+            weight->ne[0] != 6144 || weight->ne[1] != 5120 ||
+            input->type != GGML_TYPE_F32 || input->ne[0] != 6144 || input->ne[1] != 6 ||
+            projection->type != GGML_TYPE_F32 || projection->ne[0] != 5120 ||
+            projection->ne[1] != 6 || !ggml_is_contiguous(input) ||
+            !ggml_is_contiguous(projection)) {
