+         << "\nresidual_nb=" << plan.residual->nb[0] << ',' << plan.residual->nb[1]
+         << "\nadd_nb=" << plan.add->nb[0] << ',' << plan.add->nb[1] << '\n';
+    GGML_LOG_INFO("SYCL captured GDN output M6 fixture dir=%s layer=%d status=%s\n",
+                  dir, plan.layer, ok && meta ? "ok" : "write-failed");
+}
