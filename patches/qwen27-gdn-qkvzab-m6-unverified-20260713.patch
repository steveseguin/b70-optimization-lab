+static bool gdn_qkvzab_dispatch(
+        ggml_backend_sycl_context & ctx, const gdn_qkvzab_plan & plan) {
+    auto * qkv_extra = static_cast<ggml_tensor_extra_gpu *>(plan.qkv->src[0]->extra);
+    auto * z_extra = static_cast<ggml_tensor_extra_gpu *>(plan.z->src[0]->extra);
+    if (!qkv_extra || !z_extra ||
+            !ggml_sycl_mul_mat_q4_0_xe2_m6_gdn_qkvzab_gate(
+                ctx, qkv_extra->xe2_q4_m6_pack[ctx.device],
+                qkv_extra->xe2_q4_m6_pack_bytes[ctx.device],
+                z_extra->xe2_q4_m6_pack[ctx.device],
+                z_extra->xe2_q4_m6_pack_bytes[ctx.device],
+                static_cast<const float *>(plan.alpha->src[0]->data),
+                static_cast<const float *>(plan.beta->src[0]->data),
+                static_cast<const float *>(plan.dt->data),
+                static_cast<const float *>(plan.a->data),
+                static_cast<const float *>(plan.qkv->src[1]->data),
+                static_cast<float *>(plan.qkv->data), static_cast<float *>(plan.z->data),
+                static_cast<float *>(const_cast<ggml_tensor *>(plan.gate)->data),
+                static_cast<float *>(plan.beta->data), ctx.stream())) {
+        return false;
+    }
+    static std::atomic<uint64_t> count{0};
+    const uint64_t value = count.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (value == 1 || (value & (value - 1)) == 0) {
+        GGML_LOG_INFO("SYCL Xe2 GDN QKVZAB gate fused dispatch count=%" PRIu64 "\n", value);
+    }
+    return true;
+}
