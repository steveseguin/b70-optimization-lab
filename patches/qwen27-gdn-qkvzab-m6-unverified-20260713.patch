+    meta << "magic=Q27Q5GDNM6FIXTURE\nversion=1\nlayer=" << plan.layer
+         << "\nweight_name=" << plan.weight->name
+         << "\nweight_type=" << ggml_type_name(plan.weight->type)
+         << "\nweight_ne=" << plan.weight->ne[0] << ',' << plan.weight->ne[1] << ','
+         << plan.weight->ne[2] << ',' << plan.weight->ne[3]
+         << "\ninput_name=" << plan.input->name
