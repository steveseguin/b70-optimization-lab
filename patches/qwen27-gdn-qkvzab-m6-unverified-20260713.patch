+        std::ofstream file(std::string(dir) + "/" + name, std::ios::binary | std::ios::trunc);
+        file.write(reinterpret_cast<const char *>(values.data()),
+                   std::streamsize(values.size()*sizeof(float)));
+        return bool(file);
