+def _load_mtp_fc_int4_buffers() -> dict[str, torch.Tensor]:
+    rank = get_tensor_model_parallel_rank()
+    if rank not in _MTP_FC_INT4_PACKED_PT_SHA:
+        raise RuntimeError(f"mtp.fc INT4: no frozen buffers for TP rank {rank}")
+    path = os.path.join(_MTP_FC_INT4_DIR, f"rank{rank}", "packed.pt")
+    if not os.path.isfile(path):
+        raise RuntimeError(f"mtp.fc INT4: missing packed buffers: {path}")
+    with open(path, "rb") as handle:
+        actual = hashlib.sha256(handle.read()).hexdigest()
+    if actual != _MTP_FC_INT4_PACKED_PT_SHA[rank]:
+        raise RuntimeError(
+            f"mtp.fc INT4: buffer sha mismatch rank {rank}: {actual}"
+        )
+    return torch.load(path, map_location="cpu")
+
 
