+
+bool dflash_target_trace::begin(llama_seq_id seq,const std::vector<llama_token>&prompt){
+    if(!pimpl||pimpl->failed)return false;
+    try{if(seq!=0||prompt.empty()||pimpl->begun||pimpl->provisional.size()!=prompt.size())throw std::runtime_error("prefill/prompt length mismatch");
