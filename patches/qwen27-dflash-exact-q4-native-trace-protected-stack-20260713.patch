+static bool dflash_write_lmhead_fixture(
+        const std::string & path,
+        const dflash_lmhead_fixture_header & header,
+        const std::vector<float> & activations) {
+    const std::string tmp = path + ".tmp." + std::to_string((long long) getpid());
+    FILE * file = std::fopen(tmp.c_str(), "wb");
+    if (file == nullptr) {
+        SPC_ERR("cannot open DFlash LM-head fixture %s: %s\n", tmp.c_str(), std::strerror(errno));
+        return false;
+    }
+
+    const bool wrote_header = std::fwrite(&header, sizeof(header), 1, file) == 1;
+    const bool wrote_data = wrote_header &&
+            std::fwrite(activations.data(), sizeof(float), activations.size(), file) == activations.size();
+    const bool flushed = wrote_data && std::fflush(file) == 0;
+    const bool closed = std::fclose(file) == 0;
+    if (!wrote_data || !flushed || !closed) {
+        SPC_ERR("failed writing DFlash LM-head fixture %s\n", tmp.c_str());
+        std::remove(tmp.c_str());
+        return false;
+    }
+    if (std::rename(tmp.c_str(), path.c_str()) != 0) {
+        SPC_ERR("cannot publish DFlash LM-head fixture %s: %s\n", path.c_str(), std::strerror(errno));
+        std::remove(tmp.c_str());
+        return false;
+    }
+    return true;
+}
