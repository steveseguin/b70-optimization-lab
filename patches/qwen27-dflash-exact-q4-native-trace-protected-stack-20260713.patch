+struct dflash_target_trace_config {
+    std::string capture_dir;
+    std::string target_model_sha256;
+    std::string draft_model_sha256;
+    std::string runtime_commit;
+    std::string runtime_dirty_patch_sha256;
+    std::vector<int32_t> target_layer_ids;
+    uint32_t n_seq = 0;
+    int32_t n_max = -1;
+    int32_t n_min = -1;
+    float p_min = -1.0f;
+    int32_t hidden_size = 0;
+    bool draft_cache_f16 = false;
+    int32_t parallel = 0;
+    int32_t ctx_checkpoints = -1;
+    int32_t reasoning = -1;
+};
+
+class dflash_target_trace {
+public:
+    static std::unique_ptr<dflash_target_trace> create(const dflash_target_trace_config & config);
+    ~dflash_target_trace();
+
+    dflash_target_trace(const dflash_target_trace &) = delete;
+    dflash_target_trace & operator=(const dflash_target_trace &) = delete;
+
+    // Features are row-major [n_rows, 5, 5120] F32. Conversion is synchronous.
+    bool process(llama_seq_id seq_id, const llama_token * tokens, const llama_pos * positions,
+            const float * features, int32_t n_rows);
+    bool begin(llama_seq_id seq_id, const std::vector<llama_token> & prompt);
+    void end(llama_seq_id seq_id, bool complete);
+
+    bool active() const;
+    const std::string & error() const;
+
+private:
+    struct impl;
+    explicit dflash_target_trace(std::unique_ptr<impl> pimpl);
+    std::unique_ptr<impl> pimpl;
+};
