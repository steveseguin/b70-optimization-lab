+at::Tensor cutlass_grouped_gemm_w8a8_int8_xe2_impl(
+    at::Tensor& ptr_A,
+    at::Tensor& ptr_A_scales,
+    at::Tensor& ptr_B,
+    at::Tensor& ptr_B_scales,
+    const c10::optional<at::Tensor>& ptr_bias,
+    at::Tensor& ptr_D,
+    at::Tensor& rows_per_expert,
+    int64_t N,
+    int64_t K,
+    int64_t num_experts) {
+  auto& dpcpp_queue =
+      at::xpu::getCurrentXPUStream(ptr_A.device().index()).queue();
+  auto A_dtype = ptr_A.dtype();
+  auto B_dtype = ptr_B.dtype();
+  auto D_dtype = ptr_D.dtype();
+
+  TORCH_CHECK(N % 32 == 0, "N must be divisible by 32");
+  TORCH_CHECK(A_dtype == at::kChar, "ptr_A must be int8");
+  TORCH_CHECK(B_dtype == at::kChar, "ptr_B must be int8");
+  TORCH_CHECK(
+      D_dtype == at::kBFloat16 || D_dtype == at::kHalf,
+      "ptr_D must be bfloat16 or float16");
+  TORCH_CHECK(ptr_A_scales.dtype() == at::kFloat, "ptr_A_scales must be float");
+  TORCH_CHECK(ptr_B_scales.dtype() == at::kFloat, "ptr_B_scales must be float");
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(ptr_bias->dtype() == at::kFloat, "ptr_bias must be float");
+  }
+
+  TORCH_CHECK(ptr_A.dim() == 2, "ptr_A must be 2D [Total_M, K]");
+  TORCH_CHECK(ptr_B.dim() == 3, "ptr_B must be 3D [num_experts, K, N]");
+  TORCH_CHECK(ptr_D.dim() == 2, "ptr_D must be 2D [Total_M, N]");
+  TORCH_CHECK(
+      ptr_A_scales.dim() == 1 ||
+          (ptr_A_scales.dim() == 2 && ptr_A_scales.size(1) == 1),
+      "ptr_A_scales must be 1D [Total_M] or 2D [Total_M, 1]");
+  TORCH_CHECK(
+      ptr_B_scales.dim() == 2,
+      "ptr_B_scales must be 2D [num_experts, N]");
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(ptr_bias->dim() == 2, "ptr_bias must be 2D [num_experts, N]");
+  }
+
+  TORCH_CHECK(ptr_A.is_contiguous(), "ptr_A must be contiguous");
+  TORCH_CHECK(ptr_A_scales.is_contiguous(), "ptr_A_scales must be contiguous");
+  TORCH_CHECK(ptr_B.is_contiguous(), "ptr_B must be contiguous");
+  TORCH_CHECK(ptr_B_scales.is_contiguous(), "ptr_B_scales must be contiguous");
+  TORCH_CHECK(ptr_D.is_contiguous(), "ptr_D must be contiguous");
+  TORCH_CHECK(rows_per_expert.is_contiguous(), "rows_per_expert must be contiguous");
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(ptr_bias->is_contiguous(), "ptr_bias must be contiguous");
+  }
+
+  int A_total_M = ptr_A.size(0);
+  int A_K = ptr_A.size(1);
+  int B_E = ptr_B.size(0);
+  int B_K = ptr_B.size(1);
+  int B_N = ptr_B.size(2);
+  int D_total_M = ptr_D.size(0);
+  int D_N = ptr_D.size(1);
+  int A_avg_M = A_total_M / num_experts;
+  int group_size = -1;
+
+  TORCH_CHECK(B_E == num_experts, "ptr_B.size(0) must match num_experts");
+  TORCH_CHECK(A_total_M == D_total_M, "ptr_A.size(0) must match ptr_D.size(0)");
+  TORCH_CHECK(A_K == B_K && B_K == K, "ptr_A.size(1) must match ptr_B.size(1)");
+  TORCH_CHECK(B_N == D_N && D_N == N, "ptr_B.size(2) must match ptr_D.size(1)");
+  TORCH_CHECK(
+      ptr_A_scales.size(0) == A_total_M,
+      "ptr_A_scales.size(0) must match ptr_A.size(0)");
+  TORCH_CHECK(
+      ptr_B_scales.size(0) == num_experts,
+      "ptr_B_scales.size(0) must match num_experts");
+  TORCH_CHECK(
+      ptr_B_scales.size(1) == N, "ptr_B_scales.size(1) must match N");
+  if (ptr_bias.has_value()) {
+    TORCH_CHECK(
+        ptr_bias->size(0) == num_experts,
+        "ptr_bias.size(0) must match num_experts");
+    TORCH_CHECK(ptr_bias->size(1) == N, "ptr_bias.size(1) must match N");
+  }
+
+  at::Tensor atomic_buffer =
+      at::empty({static_cast<long>(1)}, ptr_A.options().dtype(at::kInt));
+
+#define W8A8MoEGEMMLauncherCallER(Policy, ElementD)                         \
+  MoEGEMMLauncher<'R', 'R', Policy>(                                         \
+      dpcpp_queue,                                                           \
+      reinterpret_cast<int8_t*>(ptr_A.data_ptr()),                           \
+      reinterpret_cast<int8_t*>(ptr_B.data_ptr()),                           \
+      reinterpret_cast<float*>(ptr_B_scales.data_ptr()),                     \
+      reinterpret_cast<float*>(ptr_A_scales.data_ptr()),                     \
+      ptr_bias.has_value() ? reinterpret_cast<float*>(ptr_bias->data_ptr())  \
+                           : static_cast<float*>(nullptr),                  \
+      reinterpret_cast<ElementD*>(ptr_D.data_ptr()),                         \
+      N,                                                                     \
+      K,                                                                     \
+      reinterpret_cast<int*>(rows_per_expert.data_ptr()),                    \
+      num_experts,                                                           \
+      group_size,                                                            \
+      static_cast<int*>(atomic_buffer.data_ptr()));
+
+#define W8A8LauncherCallER(policy)             \
+  if (D_dtype == at::kBFloat16) {              \
+    using out_t = bfloat16_t;                  \
+    W8A8MoEGEMMLauncherCallER(policy, out_t);  \
+  } else if (D_dtype == at::kHalf) {           \
+    using out_t = half_t;                      \
+    W8A8MoEGEMMLauncherCallER(policy, out_t);  \
+  }
+
+  const int policy_override = get_w8a8_grouped_gemm_policy_override();
+  if (policy_override == 16) {
+    using policy = w8a16_policy_m_16;
+    W8A8LauncherCallER(policy);
+  } else if (policy_override == 32) {
+    using policy = w8a16_policy_m_32;
+    W8A8LauncherCallER(policy);
+  } else if (policy_override == 128) {
+    using policy = w8a8_policy;
+    W8A8LauncherCallER(policy);
+  } else {
+    if (A_avg_M <= 8) {
+      using policy = w8a16_policy_m_16;
+      W8A8LauncherCallER(policy);
+    } else if (A_avg_M <= 32) {
+      using policy = w8a16_policy_m_32;
+      W8A8LauncherCallER(policy);
+    } else {
+      using policy = w8a8_policy;
+      W8A8LauncherCallER(policy);
+    }
+  }
+#undef W8A8LauncherCallER
+#undef W8A8MoEGEMMLauncherCallER
+
+  return ptr_D;
+}
