+def _maybe_probe_replay_digest(*,
+                               topk_ids,
+                               rows_per_expert,
+                               output,
+                               is_int8: bool,
+                               diagnostic_context=None):
+    global _replay_digest_warned
+
+    if not is_int8:
+        return None
+    if not _is_env_enabled(REPLAY_DIGEST_ENV):
+        return None
+    if not _rank_allowed(REPLAY_DIGEST_RANK_ENV):
+        return None
+    if not _layer_matches(REPLAY_DIGEST_LAYER_REGEX_ENV, diagnostic_context):
+        return None
+    if not hasattr(torch.ops._xpu_C, "qwen36_moe_replay_digest_probe"):
+        if not _replay_digest_warned:
+            _replay_digest_warned = True
+            try:
+                print("[xpu_moe_replay_digest] op is unavailable")
+            except Exception:
+                pass
+        return None
+
+    max_records = max(1, _int_env(REPLAY_DIGEST_MAX_RECORDS_ENV, 4096))
+    max_topk = max(0, _int_env(REPLAY_DIGEST_MAX_TOPK_ENV, 64))
+    max_output_bytes = max(
+        0, _int_env(REPLAY_DIGEST_MAX_OUTPUT_BYTES_ENV, 512))
+    key = (str(output.device), int(max_records))
+    state = _replay_digest_state.get(key)
+
+    if state is None:
+        if _stream_capture_active():
+            return None
+        try:
+            with _replay_digest_lock:
+                state = _replay_digest_state.get(key)
+                if state is None:
+                    state = {
+                        "ring": torch.zeros((max_records, 16),
+                                            dtype=torch.int64,
+                                            device=output.device),
+                        "counter": torch.zeros((1, ),
+                                               dtype=torch.int64,
+                                               device=output.device),
+                    }
+                    _replay_digest_state[key] = state
+        except Exception as exc:
+            if not _replay_digest_warned:
+                _replay_digest_warned = True
+                try:
+                    print(f"[xpu_moe_replay_digest] init failed: {exc!r}")
+                except Exception:
+                    pass
+            return None
+
+    try:
+        return torch.ops._xpu_C.qwen36_moe_replay_digest_probe(
+            topk_ids, rows_per_expert, output, state["ring"],
+            state["counter"], _layer_index_from_context(diagnostic_context),
+            max_records, max_topk, max_output_bytes)
+    except Exception as exc:
+        if not _replay_digest_warned:
+            _replay_digest_warned = True
+            try:
+                print(f"[xpu_moe_replay_digest] disabled after {exc!r}")
+            except Exception:
+                pass
+        return None
