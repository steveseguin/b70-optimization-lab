+    }
+    if (params.penalty_repeat != 1.0f || params.penalty_freq != 0.0f ||
+            params.penalty_present != 0.0f || params.dry_multiplier != 0.0f ||
+            params.xtc_probability != 0.0f) {
+        return false;
+    }
+
+    return true;
+}
