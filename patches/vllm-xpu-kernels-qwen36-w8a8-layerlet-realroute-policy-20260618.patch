+template <typename scalar_t>
+void qwen36_single_token_prologue_quant1_out_impl(
+    const scalar_t* hidden_states,
+    const int64_t* topk_ids,
+    int64_t* expert_first_token_offset,
+    int* unpermuted_row_to_permuted_row,
+    int8_t* gemm1_a,
+    float* gemm1_a_scales,
+    int64_t hidden_size,
+    int64_t topk,
+    int64_t num_experts) {
+  constexpr int kBlockSize = 256;
+  auto& queue = vllm::xpu::vllmGetQueue();
+  sycl::range<1> local(kBlockSize);
+  sycl::range<1> global(kBlockSize);
+
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<float, 1> local_max(local, cgh);
+    sycl::local_accessor<int, 1> local_permuted(sycl::range<1>(topk), cgh);
+    cgh.parallel_for(
+        sycl::nd_range<1>(global, local),
+        [=](sycl::nd_item<1> item)
+            [[sycl::reqd_sub_group_size(16)]] {
+              const int local_id = item.get_local_id(0);
+              const int local_range = item.get_local_range(0);
+
+              for (int64_t expert = local_id; expert <= num_experts;
+                   expert += local_range) {
+                int count = 0;
+                for (int k = 0; k < topk; ++k) {
+                  if (topk_ids[k] < expert) {
+                    count += 1;
+                  }
+                }
+                expert_first_token_offset[expert] = count;
+              }
+
+              for (int row_id = local_id; row_id < topk;
+                   row_id += local_range) {
+                const int64_t selected_expert = topk_ids[row_id];
+                int less = 0;
+                int prior_equal = 0;
+                for (int k = 0; k < topk; ++k) {
+                  const int64_t other = topk_ids[k];
+                  if (other < selected_expert) {
+                    less += 1;
+                  }
+                  if (k < row_id && other == selected_expert) {
+                    prior_equal += 1;
+                  }
+                }
+                const int permuted_row = less + prior_equal;
+                local_permuted[row_id] = permuted_row;
+                unpermuted_row_to_permuted_row[row_id] = permuted_row;
+              }
+
+              float thread_max = 0.0f;
+              for (int64_t col = local_id; col < hidden_size;
+                   col += local_range) {
+                const float value = qwen36_to_float(hidden_states[col]);
+                thread_max = sycl::fmax(thread_max, sycl::fabs(value));
+              }
+
+              local_max[local_id] = thread_max;
+              item.barrier(sycl::access::fence_space::local_space);
+
+              for (int stride = local_range / 2; stride > 0; stride >>= 1) {
+                if (local_id < stride) {
+                  local_max[local_id] =
+                      sycl::fmax(local_max[local_id],
+                                 local_max[local_id + stride]);
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+              }
+
+              const float absmax = sycl::fmax(local_max[0], 1.0e-10f);
+              const float scale = absmax / 127.0f;
+              const float inv_scale = 127.0f / absmax;
+
+              for (int row_id = local_id; row_id < topk;
+                   row_id += local_range) {
+                gemm1_a_scales[local_permuted[row_id]] = scale;
+              }
+
+              for (int64_t col = local_id; col < hidden_size;
+                   col += local_range) {
+                float value = qwen36_to_float(hidden_states[col]) * inv_scale;
+                value = sycl::round(value);
+                value = sycl::fmin(127.0f, sycl::fmax(-127.0f, value));
+                const int8_t qvalue = static_cast<int8_t>(value);
+                for (int row_id = 0; row_id < topk; ++row_id) {
+                  gemm1_a[local_permuted[row_id] * hidden_size + col] =
+                      qvalue;
+                }
+              }
+            });
+  });
+}
+
+bool qwen36_can_use_single_token_prologue_quant1(
+    const torch::Tensor& hidden_states,
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& expert_first_token_offset,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    const torch::Tensor& gemm1_a,
+    const torch::Tensor& gemm1_a_scales,
+    int64_t hidden_size,
+    int64_t num_experts) {
+  return hidden_states.size(0) == 1 && hidden_states.size(1) == hidden_size &&
+         topk_ids.size(0) == 1 && topk_ids.size(1) == 8 &&
+         topk_weights.size(0) == 1 && topk_weights.size(1) == 8 &&
+         expert_first_token_offset.dim() == 1 &&
+         expert_first_token_offset.numel() >= num_experts + 1 &&
+         unpermuted_row_to_permuted_row.dim() == 1 &&
+         unpermuted_row_to_permuted_row.numel() >= 8 &&
+         gemm1_a.dim() == 2 && gemm1_a.size(0) >= 8 &&
+         gemm1_a.size(1) == hidden_size &&
+         gemm1_a_scales.numel() >= 8;
+}
+
+bool qwen36_fused_q1_enabled() {
+  const char* value = std::getenv("VLLM_XPU_MOE_W8A8_FUSED_Q1");
+  return value && value[0] != '\0' && value[0] != '0' && value[0] != 'f' &&
+         value[0] != 'F';
+}
+
+bool qwen36_fast_gather_enabled() {
+  const char* value = std::getenv("VLLM_XPU_MOE_W8A8_FAST_GATHER");
+  return value && value[0] != '\0' && value[0] != '0' && value[0] != 'f' &&
+         value[0] != 'F';
+}
+
+void qwen36_single_token_prologue_quant1_out(
+    const torch::Tensor& hidden_states,
+    const torch::Tensor& topk_ids,
+    torch::Tensor& expert_first_token_offset,
+    torch::Tensor& unpermuted_row_to_permuted_row,
+    torch::Tensor& gemm1_a,
+    torch::Tensor& gemm1_a_scales,
+    int64_t hidden_size,
+    int64_t num_experts) {
+  TORCH_CHECK(
+      hidden_states.scalar_type() == torch::kBFloat16 ||
+          hidden_states.scalar_type() == torch::kFloat16 ||
+          hidden_states.scalar_type() == torch::kFloat32,
+      "qwen36 fused prologue+quant1 only supports bf16, fp16, and fp32 hidden_states");
+  require_dtype(gemm1_a, "gemm1_a", torch::kInt8);
+  require_dtype(gemm1_a_scales, "gemm1_a_scales", torch::kFloat32);
+
+  if (hidden_states.scalar_type() == torch::kBFloat16) {
+    qwen36_single_token_prologue_quant1_out_impl(
+        reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(
+            hidden_states.data_ptr()),
+        topk_ids.data_ptr<int64_t>(),
+        expert_first_token_offset.data_ptr<int64_t>(),
+        unpermuted_row_to_permuted_row.data_ptr<int>(),
+        gemm1_a.data_ptr<int8_t>(),
+        gemm1_a_scales.data_ptr<float>(),
+        hidden_size,
+        8,
+        num_experts);
+  } else if (hidden_states.scalar_type() == torch::kFloat16) {
+    qwen36_single_token_prologue_quant1_out_impl(
+        reinterpret_cast<const sycl::half*>(hidden_states.data_ptr()),
+        topk_ids.data_ptr<int64_t>(),
+        expert_first_token_offset.data_ptr<int64_t>(),
+        unpermuted_row_to_permuted_row.data_ptr<int>(),
+        gemm1_a.data_ptr<int8_t>(),
+        gemm1_a_scales.data_ptr<float>(),
+        hidden_size,
+        8,
+        num_experts);
+  } else {
+    qwen36_single_token_prologue_quant1_out_impl(
+        hidden_states.data_ptr<float>(),
+        topk_ids.data_ptr<int64_t>(),
+        expert_first_token_offset.data_ptr<int64_t>(),
+        unpermuted_row_to_permuted_row.data_ptr<int>(),
+        gemm1_a.data_ptr<int8_t>(),
+        gemm1_a_scales.data_ptr<float>(),
+        hidden_size,
+        8,
+        num_experts);
+  }
+}
+
+template <typename scalar_t>
+void qwen36_single_token_gather_topk8_out_impl(
+    scalar_t* output,
+    const scalar_t* moe_output,
+    const float* topk_weights,
+    const int* unpermuted_row_to_permuted_row,
+    int64_t hidden_size) {
+  constexpr int kBlockSize = 256;
+  constexpr int kElemsPerItem = 8;
+  constexpr int kTopK = 8;
+  constexpr int kStride = kBlockSize * kElemsPerItem;
+  auto& queue = vllm::xpu::vllmGetQueue();
+  sycl::range<1> local(kBlockSize);
+  sycl::range<1> global(kBlockSize);
+
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        sycl::nd_range<1>(global, local),
+        [=](sycl::nd_item<1> item)
+            [[sycl::reqd_sub_group_size(16)]] {
+              const int local_id = item.get_local_id(0);
+              int moe_ids[kTopK];
+              float scores[kTopK];
+#pragma unroll
+              for (int k = 0; k < kTopK; ++k) {
+                moe_ids[k] = unpermuted_row_to_permuted_row[k];
+                scores[k] = topk_weights[k];
+              }
+
+              for (int64_t hidden_idx = local_id * kElemsPerItem;
+                   hidden_idx < hidden_size;
+                   hidden_idx += kStride) {
+                float accum[kElemsPerItem];
+#pragma unroll
+                for (int e = 0; e < kElemsPerItem; ++e) {
+                  accum[e] = 0.0f;
+                }
+#pragma unroll
+                for (int k = 0; k < kTopK; ++k) {
+                  const int row = moe_ids[k];
+#pragma unroll
+                  for (int e = 0; e < kElemsPerItem; ++e) {
+                    accum[e] += qwen36_to_float(
+                                    moe_output[row * hidden_size + hidden_idx +
+                                               e]) *
+                                scores[k];
+                  }
+                }
+#pragma unroll
+                for (int e = 0; e < kElemsPerItem; ++e) {
+                  output[hidden_idx + e] = accum[e];
+                }
+              }
+            });
+  });
+}
+
+bool qwen36_can_use_single_token_fast_gather(
+    const torch::Tensor& output,
+    const torch::Tensor& gemm2_output,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    int64_t hidden_size) {
+  return output.dim() == 2 && output.size(0) == 1 &&
+         output.size(1) == hidden_size && hidden_size % 8 == 0 &&
+         gemm2_output.dim() == 2 && gemm2_output.size(0) >= 8 &&
+         gemm2_output.size(1) == hidden_size && topk_weights.dim() == 2 &&
+         topk_weights.size(0) == 1 && topk_weights.size(1) == 8 &&
+         unpermuted_row_to_permuted_row.dim() == 1 &&
+         unpermuted_row_to_permuted_row.numel() >= 8;
+}
