+      gemm1_a_scales,
+      w13,
+      w13_scales,
+      w13_bias,
+      gemm1_output,
+      gemm2_a,
+      gemm2_a_scales,
+      w2,
+      w2_scales,
+      w2_bias,
+      gemm2_output,
+      expert_first_token_offset,
+      2 * inter_size,
+      hidden_size,
+      hidden_size,
+      inter_size,
+      num_experts);
+
+  if (qwen36_fast_gather_enabled() &&
+      qwen36_can_use_single_token_fast_gather(
+          output,
+          gemm2_output,
+          topk_weights,
+          unpermuted_row_to_permuted_row,
+          hidden_size)) {
+    qwen36_single_token_gather_topk8_out(
+        output,
+        gemm2_output,
+        topk_weights,
+        unpermuted_row_to_permuted_row,
+        hidden_size);
+  } else {
+    moe_gather(
+        output, gemm2_output, topk_weights, unpermuted_row_to_permuted_row,
+        num_experts);
+  }
+  return output;
+}
