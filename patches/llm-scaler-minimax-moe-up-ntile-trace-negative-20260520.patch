 static inline sycl::event submit_kernel(
     std::function<void(sycl::handler&)> kernel,
     const torch::Device& device,
     const char* desc) {
     sycl::queue& queue = c10::xpu::getCurrentXPUStream(device.index()).queue();
-    return queue.submit(kernel);
+    sycl::event event = queue.submit(kernel);
+    static const bool trace_kernels =
+        std::getenv("LLM_SCALER_MOE_TRACE_KERNELS") != nullptr;
+    if (trace_kernels) {
+        auto start = std::chrono::steady_clock::now();
+        event.wait();
+        auto end = std::chrono::steady_clock::now();
+        double ms = std::chrono::duration<double, std::milli>(end - start).count();
+        std::fprintf(stderr,
+                     "[llm-scaler][moe-kernel] device=%d kernel=\"%s\" wait_ms=%.6f\n",
+                     static_cast<int>(device.index()), desc, ms);
+    }
+    return event;
 }
+
+static int forced_ws_up_ntile() {
+    static const int value = []() {
+        const char* env = std::getenv("VLLM_XPU_MOE_WS_UP_NTILE");
+        if (env == nullptr || env[0] == '\0') {
+            return 0;
+        }
+        int parsed = std::atoi(env);
+        switch (parsed) {
+        case 1:
+        case 2:
+        case 3:
+        case 4:
+        case 6:
+        case 8:
+            return parsed;
+        default:
+            return 0;
+        }
+    }();
+    return value;
+}
 
