+    def _use_xpu_bool_sdpa(self, metadata: TreeAttentionMetadata) -> bool:
+        """Use XPU's fast masked SDPA for the single-request DDTree lane.
+
+        XPU flash SDPA currently misapplies additive float masks but honors
+        boolean keep masks exactly. Keep the path tightly gated until broader
+        batch, ALiBi, sliding-window, and quantized-cache cases are covered.
+        """
+
+        return (
+            os.environ.get("VLLM_XPU_TREE_ATTN_BOOL_SDPA", "0").strip().lower()
+            in ("1", "true", "yes", "on")
+            and metadata.query_start_loc.shape[0] == 2
+            and metadata.num_prefills == 0
+            and metadata.tree_attn_bias is not None
+            and metadata.xpu_sdpa_keep_mask is not None
+            and self.alibi_slopes is None
+            and self.sliding_window == (-1, -1)
+            and self.logits_soft_cap == 0
+            and self.kv_cache_dtype in ("auto", "bfloat16", "float16")
+        )
+
+    def _forward_xpu_bool_sdpa(
+        self,
+        query: torch.Tensor,
+        key_cache: torch.Tensor,
+        value_cache: torch.Tensor,
+        metadata: TreeAttentionMetadata,
+        output: torch.Tensor,
+    ) -> None:
+        query_len = metadata.max_query_len
+        seq_len = metadata.max_seq_len
+        context_len = seq_len - query_len
+        if query_len <= 0 or context_len < 0:
+            raise ValueError(
+                f"Invalid XPU tree attention lengths: {query_len=}, {seq_len=}"
+            )
+
+        block_size = key_cache.shape[1]
+        num_blocks = (seq_len + block_size - 1) // block_size
+        block_ids = metadata.block_table[0, :num_blocks]
+        keys = key_cache.index_select(0, block_ids).reshape(
+            -1, self.num_kv_heads, self.head_size
+        )[:seq_len]
+        values = value_cache.index_select(0, block_ids).reshape(
+            -1, self.num_kv_heads, self.head_size
+        )[:seq_len]
+
+        keep_mask = metadata.xpu_sdpa_keep_mask
+        assert keep_mask is not None
+        q = query[:query_len].permute(1, 0, 2).unsqueeze(0)
+        k = keys.permute(1, 0, 2).unsqueeze(0)
+        v = values.permute(1, 0, 2).unsqueeze(0)
+        result = F.scaled_dot_product_attention(
+            q,
+            k,
+            v,
+            attn_mask=keep_mask,
+            dropout_p=0.0,
+            is_causal=False,
+            scale=self.scale,
+            enable_gqa=self.num_heads != self.num_kv_heads,
+        )
+        output[:query_len].view(query_len, self.num_heads, self.head_size).copy_(
+            result.squeeze(0).permute(1, 0, 2)
+        )
+
