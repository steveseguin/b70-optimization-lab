+def _tensor_checksum_f32(tensor):
+    if tensor is None:
+        return None
+    try:
+        return float(
+            tensor.detach().float().sum().to("cpu",
+                                             non_blocking=False).item())
+    except Exception as exc:
+        return {"error": repr(exc)}
+
+
+def _tensor_max_abs_diff_f32(left, right):
+    if left is None or right is None:
+        return None
+    try:
+        diff = (left.detach().float() - right.detach().float()).abs().max()
+        return float(diff.to("cpu", non_blocking=False).item())
+    except Exception as exc:
+        return {"error": repr(exc)}
+
