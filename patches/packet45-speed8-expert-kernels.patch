+   if(scenario==0)r[1]=r[0];
+   if(scenario==1)r[0]={0,1,3};
+   if(scenario==2)r[0]={0,0,0};
+   if(scenario==3)r[0]={f.b.experts,0,4};
+   if(scenario==4)r[0]={0,3,2};
+   if(scenario==5){r[0]={f.b.experts,0,4};*const_cast<uint32_t*>(f.b.active)=0;}
+   if(scenario==6){r[0]={f.b.experts,0,4};*f.b.error=7;}
+   if(arm)p39::host_gemv<T,K,E,true,1,B>(f.b);else p39::host_gemv<T,K,E,true,1>(f.b);
+   if(!arm)old=f.snapshot();else require(old==f.snapshot(),"body changed routing/sticky bytes");
+  }++checks;
+ }
