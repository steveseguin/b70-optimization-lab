+  f.reset();q.copy(const_cast<uint16_t*>(f.b.x),&x,2);
+  p39::validate<T,K,E>(f.b);p39::host_gemv<T,K,E,true,1>(f.b);auto old=f.snapshot();
+  f.reset();q.copy(const_cast<uint16_t*>(f.b.x),&x,2);
+  p39::host_gemv<T,K,E,true,1,B>(f.b);require(old==f.snapshot(),"body changed full-state bytes");++checks;
+  f.b.y[3]^=1;require(old!=f.snapshot(),"negative output control was invisible");++checks;
+ }
