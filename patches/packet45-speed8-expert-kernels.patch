+ static constexpr bool binding_only=false;
+ template<class T>T* alloc(size_t n){return static_cast<T*>(::operator new(n*sizeof(T)));}
+ void free(void*p){::operator delete(p);}
+ void copy(void*d,const void*s,size_t n){std::memcpy(d,s,n);}
+ void wait(){}
+};
+void require(bool b,const char*msg){if(!b)throw std::runtime_error(msg);}
