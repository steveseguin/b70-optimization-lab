+def _make_onednn_grouped_offsets(rows_per_expert):
+    offsets = torch.empty_like(rows_per_expert)
+    if offsets.numel() == 0:
+        return offsets
+    cumsum = torch.cumsum(rows_per_expert,
+                          dim=0,
+                          dtype=rows_per_expert.dtype)
+    offsets[0].zero_()
+    if offsets.numel() > 1:
+        offsets[1:].copy_(cumsum[:-1])
+    return offsets
+
+
+def _make_w8a8_grouped_gemm_offsets(rows_per_expert):
+    offsets = torch.empty((rows_per_expert.numel() + 1, ),
+                          dtype=torch.int64,
+                          device=rows_per_expert.device)
+    if offsets.numel() == 0:
+        return offsets
+    offsets[0].zero_()
+    if rows_per_expert.numel() > 0:
+        offsets[1:].copy_(torch.cumsum(rows_per_expert.to(torch.int64),
+                                       dim=0))
+    return offsets
+
+
