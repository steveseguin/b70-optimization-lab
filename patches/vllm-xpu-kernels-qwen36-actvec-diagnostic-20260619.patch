+inline int forced_act_and_mul_vec_size() {
+  static const int forced = []() {
+    const char* value = std::getenv("VLLM_XPU_ACT_AND_MUL_VEC_SIZE");
+    if (value == nullptr || value[0] == '\0') {
+      return 0;
+    }
+    const int parsed = std::atoi(value);
+    if (parsed == 1 || parsed == 2 || parsed == 4 || parsed == 8 ||
+        parsed == 16) {
+      return parsed;
+    }
+    return 0;
+  }();
+  return forced;
+}
+
+inline int select_act_and_mul_vec_size(const int d, const int scalar_size) {
+  const int forced = forced_act_and_mul_vec_size();
+  if (forced > 0 && d % forced == 0) {
+    return forced;
+  }
+
+  int vec_size = static_cast<int>(sizeof(float) * 4 / scalar_size);
+  int64_t tmp_wg =
+      std::min(static_cast<int64_t>(d), static_cast<int64_t>(1024));
+  while (vec_size > 1 && (vec_size >> 1) * tmp_wg >= d) {
+    vec_size = vec_size >> 1;
+  }
+  if (d % vec_size != 0) {
+    vec_size = 1;
+  }
+  return vec_size;
+}
+
