 static bool ggml_backend_sycl_device_supports_op(ggml_backend_dev_t dev, const ggml_tensor * op) {
+    // split buffers can only be used with GGML_OP_MUL_MAT (matrix weights
+    // sharded by rows across devices); reject every other consumer so the
+    // weight-buft selector never places norms/embeddings there
+    if (op->op != GGML_OP_MUL_MAT) {
+        for (int i = 0; i < GGML_MAX_SRC; i++) {
+            if (op->src[i] && op->src[i]->buffer &&
+                op->src[i]->buffer->buft->iface.get_name == ggml_backend_sycl_split_buffer_type_get_name) {
+                return false;
+            }
+        }
+    }
     bool res = do_ggml_backend_sycl_device_supports_op(dev, op);
     GGML_SYCL_DEBUG("[SYCL] call %s op->op=%s op->type=%s -> %s\n", __func__, ggml_op_name(op->op),
                     ggml_type_name(op->type), res ? "true" : "false");
@@ -6084,6 +6104,11 @@ static bool ggml_backend_sycl_device_supports_op(ggml_backend_dev_t dev, const g
 }
 
 static bool ggml_backend_sycl_device_supports_buft(ggml_backend_dev_t dev, ggml_backend_buffer_type_t buft) {
+    if (buft->iface.get_name == ggml_backend_sycl_split_buffer_type_get_name) {
+        // split tensors are handled by the multi-device mul_mat path on the
+        // main device's backend
+        return true;
+    }
     if (buft->iface.get_name != ggml_backend_sycl_buffer_type_get_name) {
         return false;
     }
