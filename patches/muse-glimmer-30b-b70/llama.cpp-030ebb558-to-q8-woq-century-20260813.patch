+
+struct server_ddtree_heap_item {
+    double weight = -INFINITY;
+    std::vector<int32_t> ranks;
+    int32_t parent = -1;
+    int32_t depth = 1;
+    int32_t rank = 0;
+};
+
+struct server_ddtree_heap_less {
+    bool operator()(const server_ddtree_heap_item & a, const server_ddtree_heap_item & b) const {
+        if (a.weight != b.weight) {
+            return a.weight < b.weight;
+        }
+        if (a.ranks != b.ranks) {
+            return a.ranks > b.ranks;
+        }
+        if (a.parent != b.parent) {
+            return a.parent > b.parent;
+        }
+        if (a.depth != b.depth) {
+            return a.depth > b.depth;
+        }
+        return a.rank > b.rank;
+    }
+};
+
+// Mirrors scripts/analyze-muse-ddtree-prefix-trace.py.  The virtual root has
+// index -1; returned nodes are in target-batch order after the anchor row.
+static bool server_ddtree_build_budget15(
+        const common_speculative_candidate_rows & candidates,
+        std::vector<server_ddtree_node> & nodes,
+        std::vector<llama_seq_id> & leaf_seq_ids) {
+    constexpr int32_t budget = 15;
+    if (candidates.size() != budget) {
+        return false;
+    }
+    for (const auto & row : candidates) {
+        if (row.size() < budget) {
+            return false;
+        }
+    }
+
+    auto logp = [&](int32_t depth, int32_t rank) {
+        const float p = candidates[depth][rank].p;
+        return p > 0.0f ? std::log((double) p) : -INFINITY;
+    };
+
+    std::priority_queue<server_ddtree_heap_item,
+            std::vector<server_ddtree_heap_item>, server_ddtree_heap_less> heap;
+    heap.push({ logp(0, 0), { 0 }, -1, 1, 0 });
+
+    nodes.clear();
+    nodes.reserve(budget);
+    while (!heap.empty() && (int32_t) nodes.size() < budget) {
+        auto item = heap.top();
+        heap.pop();
+
+        const int32_t current = nodes.size();
+        nodes.push_back({
+            candidates[item.depth - 1][item.rank].id,
+            item.parent,
+            item.depth,
+            item.ranks,
+            {},
+            0,
+        });
+        if (item.parent >= 0) {
+            nodes[item.parent].n_children++;
+        }
+
+        if (item.rank + 1 < budget) {
+            const double old_weight = logp(item.depth - 1, item.rank);
+            const double new_weight = logp(item.depth - 1, item.rank + 1);
+            auto sibling_ranks = item.ranks;
+            sibling_ranks.back()++;
+            const double sibling_weight = std::isfinite(old_weight)
+                ? item.weight - old_weight + new_weight : new_weight;
+            heap.push({ sibling_weight, std::move(sibling_ranks), item.parent, item.depth, item.rank + 1 });
+        }
+
+        if (item.depth < budget) {
+            auto child_ranks = item.ranks;
+            child_ranks.push_back(0);
+            heap.push({ item.weight + logp(item.depth, 0), std::move(child_ranks), current, item.depth + 1, 0 });
+        }
+    }
+
+    leaf_seq_ids.clear();
+    for (int32_t i = 0; i < (int32_t) nodes.size(); ++i) {
+        if (nodes[i].n_children != 0) {
+            continue;
+        }
+        const llama_seq_id seq_id = 1 + leaf_seq_ids.size();
+        leaf_seq_ids.push_back(seq_id);
+        for (int32_t node = i; node >= 0; node = nodes[node].parent) {
+            nodes[node].seq_ids.push_back(seq_id);
+        }
+    }
+    return nodes.size() == budget && !leaf_seq_ids.empty() && leaf_seq_ids.size() <= budget;
+}
