+    // dst = other * sigmoid(x); shapes validated in ggml_sycl_can_fuse
+    const ggml_tensor * x_t     = sig_node->src[0];
+    const ggml_tensor * other_t = (mul_node->src[0] == sig_node) ? mul_node->src[1] : mul_node->src[0];
+
+    const float * x     = static_cast<const float *>(x_t->data);
+    const float * other = static_cast<const float *>(other_t->data);
+    float *       dst   = static_cast<float *>(mul_node->data);
+
+    const int64_t n = ggml_nelements(mul_node);
+    dpct::queue_ptr stream = ctx.stream();
+    stream->parallel_for(sycl::range<1>(n), [=](sycl::id<1> i) {
+        dst[i] = other[i] * op_sigmoid(x[i]);
+    });
