+struct ggml_sycl_device_timeline_state {
+    ggml_sycl_device_timeline_state(
+            int device, const void * context, uint64_t sample_every, std::shared_ptr<std::mutex> submission_mutex) :
+        device(device), context(context), sample_every(sample_every), submission_mutex(std::move(submission_mutex)) {}
+
+    int          device;
+    const void * context;
+    uint64_t     sample_every;
+    std::shared_ptr<std::mutex> submission_mutex;
+    std::mutex   mutex;
+    bool         scope_open = false;
+    std::optional<sycl::event> last_dnnl_completion;
+    std::deque<ggml_sycl_device_timeline_pending> pending;
+    std::unordered_map<std::string, ggml_sycl_device_timeline_stat> stats;
+    uint64_t completed          = 0;
+    uint64_t dropped            = 0;
+    uint64_t invalid            = 0;
+    uint64_t dnnl_events        = 0;
+    uint64_t seen                = 0;
+    uint64_t skipped             = 0;
+    uint64_t next_report        = GGML_SYCL_DEVICE_TIMELINE_REPORT_EVERY;
+    uint64_t reports            = 0;
+    uint64_t overflow_warnings  = 0;
+    uint64_t tag_errors         = 0;
+};
+
+namespace {
+
+static void ggml_sycl_device_timeline_report_locked(
+        ggml_sycl_device_timeline_state & state, bool final_report) {
+    if ((!final_report && state.stats.empty()) ||
+        (!final_report && state.reports >= GGML_SYCL_DEVICE_TIMELINE_MAX_REPORTS)) {
+        return;
+    }
+
+    std::vector<std::pair<uint64_t, std::string>> rows;
+    rows.reserve(state.stats.size());
+    for (const auto & kv : state.stats) {
+        rows.emplace_back(kv.second.total_ns, kv.first);
+    }
+    std::sort(rows.rbegin(), rows.rend());
+
+    fprintf(stderr,
+            "[sycl-device-timeline] %sdevice=%d ctx=%p completed=%" PRIu64
+            " pending=%zu skipped=%" PRIu64 " dropped=%" PRIu64 " invalid=%" PRIu64
+            " dnnl-events=%" PRIu64
+            " (tag pre-end/post-start device intervals; diagnostic, includes queue gaps and profiling perturbation)\n",
+            final_report ? "final " : "", state.device, state.context, state.completed,
+            state.pending.size(), state.skipped, state.dropped, state.invalid, state.dnnl_events);
+    for (size_t i = 0; i < rows.size() && i < GGML_SYCL_DEVICE_TIMELINE_REPORT_ROWS; ++i) {
+        const auto stat = state.stats.find(rows[i].second);
+        GGML_ASSERT(stat != state.stats.end());
+        const double total_us = (double) stat->second.total_ns / 1000.0;
+        const double avg_us   = total_us / (double) stat->second.count;
+        fprintf(stderr, "[sycl-device-timeline]   %12.3f us total  %10.3f us avg  %8" PRIu64 "  %s\n",
+                total_us, avg_us, stat->second.count, rows[i].second.c_str());
+    }
+    state.reports++;
+}
+
+static void ggml_sycl_device_timeline_poll_locked(
+        ggml_sycl_device_timeline_state & state, size_t max_samples) noexcept {
+    size_t polled = 0;
+    while (!state.pending.empty() && polled < max_samples) {
+        auto & sample = state.pending.front();
+        try {
+            const auto status = sample.after.get_info<sycl::info::event::command_execution_status>();
+            if (status != sycl::info::event_command_status::complete) {
+                break;
+            }
+
+            // dnnl::sycl_interop::execute submits to the same incumbent in-order
+            // queue. A completed post tag must therefore follow its completion
+            // event; retain and check that event to detect an interop ordering
+            // regression rather than silently attributing an early interval.
+            if (sample.dnnl_completion.has_value() &&
+                sample.dnnl_completion->get_info<sycl::info::event::command_execution_status>() !=
+                    sycl::info::event_command_status::complete) {
+                state.invalid++;
+                state.pending.pop_front();
+                ++polled;
+                continue;
+            }
+
+            const uint64_t begin_ns = sample.before.get_profiling_info<sycl::info::event_profiling::command_end>();
+            const uint64_t end_ns   = sample.after.get_profiling_info<sycl::info::event_profiling::command_start>();
+            if (end_ns < begin_ns) {
+                state.invalid++;
+            } else {
+                std::string key = std::move(sample.key);
+                if (state.stats.find(key) == state.stats.end() &&
+                    state.stats.size() >= GGML_SYCL_DEVICE_TIMELINE_MAX_KEYS - 1) {
+                    key = "OTHER";
+                }
+                auto & stat = state.stats[key];
+                stat.total_ns += end_ns - begin_ns;
+                stat.count++;
+                state.completed++;
+            }
+        } catch (...) {
+            state.invalid++;
+        }
+        state.pending.pop_front();
+        ++polled;
+    }
+
+    if (state.completed >= state.next_report) {
+        try {
+            ggml_sycl_device_timeline_report_locked(state, false);
+        } catch (...) {
+            state.invalid++;
+        }
+        do {
+            state.next_report += GGML_SYCL_DEVICE_TIMELINE_REPORT_EVERY;
+        } while (state.completed >= state.next_report);
+    }
+}
+
+class ggml_sycl_device_timeline_scope {
+public:
+    ggml_sycl_device_timeline_scope(ggml_backend_sycl_context & context, std::string key) noexcept :
+        context_(&context), key_(std::move(key)) {
+        if (!context_->device_timeline_active()) {
+            return;
+        }
+
+        submission_lock_ = std::unique_lock<std::mutex>(*context_->device_timeline->submission_mutex);
+        {
+            auto & state = *context_->device_timeline;
+            std::lock_guard<std::mutex> lock(state.mutex);
+            ggml_sycl_device_timeline_poll_locked(state, 64);
+            const uint64_t sample_index = state.seen++;
+            if (sample_index % state.sample_every != 0) {
+                state.skipped++;
+                return;
+            }
+            if (state.pending.size() >= GGML_SYCL_DEVICE_TIMELINE_MAX_PENDING) {
+                state.dropped++;
+                if (state.overflow_warnings < 3) {
+                    GGML_LOG_WARN("[sycl-device-timeline] device=%d ctx=%p pending cap=%zu reached; "
+                                  "skipping tag submission without waiting\n",
+                            state.device, state.context, GGML_SYCL_DEVICE_TIMELINE_MAX_PENDING);
+                    state.overflow_warnings++;
+                }
+                return;
+            }
+        }
+
+        try {
+            before_ = sycl::ext::oneapi::experimental::submit_profiling_tag(*context_->stream());
+            active_ = true;
+            auto & state = *context_->device_timeline;
+            std::lock_guard<std::mutex> lock(state.mutex);
+            state.scope_open = true;
+            state.last_dnnl_completion.reset();
+        } catch (...) {
+            auto & state = *context_->device_timeline;
+            std::lock_guard<std::mutex> lock(state.mutex);
+            if (state.tag_errors++ == 0) {
+                GGML_LOG_WARN("[sycl-device-timeline] device=%d ctx=%p failed to submit a profiling tag; sample dropped\n",
+                        state.device, state.context);
+            }
+        }
+    }
+
+    ~ggml_sycl_device_timeline_scope() noexcept {
+        if (!active_) {
+            return;
+        }
+
+        std::optional<sycl::event> after;
+        try {
+            after = sycl::ext::oneapi::experimental::submit_profiling_tag(*context_->stream());
+        } catch (...) {
+            // Keep the profiling path non-fatal and bounded even if the
+            // experimental extension fails after the real operation submitted.
+        }
+
+        auto & state = *context_->device_timeline;
+        std::lock_guard<std::mutex> lock(state.mutex);
+        state.scope_open = false;
+        auto dnnl_completion = std::move(state.last_dnnl_completion);
+        state.last_dnnl_completion.reset();
+
+        ggml_sycl_device_timeline_poll_locked(state, 64);
+        if (!after.has_value()) {
+            state.tag_errors++;
+            state.invalid++;
+            return;
+        }
+        if (state.pending.size() >= GGML_SYCL_DEVICE_TIMELINE_MAX_PENDING) {
+            state.dropped++;
+            if (state.overflow_warnings < 3) {
+                GGML_LOG_WARN("[sycl-device-timeline] device=%d ctx=%p pending cap=%zu reached; dropping samples without waiting\n",
+                        state.device, state.context, GGML_SYCL_DEVICE_TIMELINE_MAX_PENDING);
+                state.overflow_warnings++;
+            }
+            return;
+        }
+        state.pending.push_back({std::move(key_), std::move(before_), std::move(*after),
+                                 std::move(dnnl_completion)});
+    }
+
+private:
+    ggml_backend_sycl_context * context_ = nullptr;
+    std::string key_;
+    std::unique_lock<std::mutex> submission_lock_;
+    sycl::event before_;
+    bool active_ = false;
+};
+
+static std::string ggml_sycl_device_timeline_key(const ggml_tensor * node) {
+    std::string key = ggml_op_name(node->op);
+    if (node->op == GGML_OP_MUL_MAT && node->src[0] != nullptr && node->src[1] != nullptr) {
+        key += std::string(":") + ggml_type_name(node->src[0]->type) + ":b" +
+               std::to_string(node->src[1]->ne[1]);
+    } else if (node->op == GGML_OP_UNARY) {
+        key += std::string(":") + ggml_unary_op_name(ggml_get_unary_op(node));
+    }
+    return key;
+}
+
+} // namespace
+
+ggml_backend_sycl_context::ggml_backend_sycl_context(int device) :
+    device(device), name(GGML_SYCL_NAME + std::to_string(device)) {
+    opt_feature = ggml_sycl_info().devices[device].opt_feature;
+    const int timeline_env = ggml_sycl_get_env("GGML_SYCL_DEVICE_TIMELINE", 0);
+    if (timeline_env <= 0) {
+        return;
+    }
+
+    const queue_ptr queue = stream();
+    if (!queue->get_device().has(sycl::aspect::ext_oneapi_queue_profiling_tag)) {
+        GGML_LOG_WARN("[sycl-device-timeline] device=%d ctx=%p does not expose ext_oneapi_queue_profiling_tag; disabled\n",
+                device, (void *) this);
+        return;
+    }
+
+    const uint64_t sample_every = (uint64_t) timeline_env;
+    device_timeline = std::make_unique<ggml_sycl_device_timeline_state>(
+        device, this, sample_every, ggml_sycl_device_timeline_queue_lock(queue));
+    GGML_LOG_INFO("[sycl-device-timeline] enabled device=%d ctx=%p on incumbent in-order queue=%p; "
+                  "sampling one in every %" PRIu64 " logical ops with at most %zu retained samples\n",
+            device, (void *) this, (void *) queue, sample_every, GGML_SYCL_DEVICE_TIMELINE_MAX_PENDING);
+#ifdef GGML_SYCL_GRAPH
+    if (g_ggml_sycl_enable_graph) {
+        GGML_LOG_INFO("[sycl-device-timeline] device=%d ctx=%p forcing eager submissions while profiling; "
+                      "individual operations inside replayed command graphs are not observable\n",
+                device, (void *) this);
+    }
+#endif
+}
+
+ggml_backend_sycl_context::~ggml_backend_sycl_context() {
+#if GGML_SYCL_DNNL
+    if (q8_0_woq_hits != 0 || q8_0_woq_rejects != 0) {
+        GGML_LOG_INFO("[SYCL Q8_0 WOQ] device=%d ctx=%p summary: hits=%" PRIu64
+                      " rejects=%" PRIu64 " cached_primitives=%zu\n",
+                      device, (void *) this, q8_0_woq_hits, q8_0_woq_rejects,
+                      q8_0_woq_cache.size());
+    }
+#endif
+    if (device_timeline == nullptr) {
+        return;
+    }
+    try {
+        std::lock_guard<std::mutex> lock(device_timeline->mutex);
+        ggml_sycl_device_timeline_poll_locked(*device_timeline, device_timeline->pending.size());
+        ggml_sycl_device_timeline_report_locked(*device_timeline, true);
+    } catch (...) {
+        // Reporting must not make backend destruction fail.
+    }
+}
+
+bool ggml_backend_sycl_context::device_timeline_active() const noexcept {
+    return device_timeline != nullptr;
+}
+
+void ggml_backend_sycl_context::device_timeline_note_dnnl_event(sycl::event event) noexcept {
+    if (device_timeline == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(device_timeline->mutex);
+    if (device_timeline->scope_open) {
+        device_timeline->last_dnnl_completion = std::move(event);
+        device_timeline->dnnl_events++;
+    }
+}
