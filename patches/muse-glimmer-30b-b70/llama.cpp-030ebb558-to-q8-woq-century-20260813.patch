+    /* .free              = */ llama_sampler_batched_top_k_free,
+    /* .backend_init      = */ llama_sampler_batched_top_k_backend_init,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ llama_sampler_batched_top_k_backend_apply,
