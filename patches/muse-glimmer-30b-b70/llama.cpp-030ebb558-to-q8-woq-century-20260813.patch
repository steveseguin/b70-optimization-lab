+                            #pragma unroll
+                            for (int j = 0; j < 16; ++j) {
+                                if (j < N) acc[j] += wv * (float) x_tile[j * TILE_K + kk];
+                            }
+                        }
+                    }
+                    it.barrier(sycl::access::fence_space::local_space);
+                }
+
+                if (m < M) {
+                    auto sg = it.get_sub_group();
+                    #pragma unroll
+                    for (int j = 0; j < 16; ++j) {
+                        if (j < N) {
+                            const float r = sycl::reduce_over_group(sg, acc[j], sycl::plus<float>());
+                            if (lane == 0) y[j * y_stride + m] = r;
+                        }
+                    }
+                }
+            });
+    });
+}
+
+static bool ggml_sycl_can_mul_mat_bf16_direct(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    static const int enabled = ggml_sycl_get_env("GGML_SYCL_BF16_DIRECT", 0);
+    return enabled &&
+           src0->type == GGML_TYPE_BF16 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+           ggml_is_contiguous(src0) && ggml_is_contiguous(src1) && ggml_is_contiguous(dst) &&
+           src0->ne[0] == src1->ne[0] && dst->ne[0] == src0->ne[1] && dst->ne[1] == src1->ne[1] &&
+           src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 &&
+           dst->ne[2] == 1 && dst->ne[3] == 1 &&
+           src1->ne[1] >= 2 && src1->ne[1] <= 16 &&
+           !ggml_backend_buffer_is_sycl_split(src0->buffer);
+}
+
+// Lean oneMKL path for the same BF16 decode/verify shapes. This preserves the
+// incumbent F32 -> BF16 activation rounding and BF16 x BF16 -> F32 GEMM, but
+// avoids routing a local tensor through ggml_sycl_op_mul_mat's split-device
+// setup and rebuilding a oneDNN primitive for every projection.
+static void ggml_sycl_mul_mat_bf16_mkl(ggml_backend_sycl_context & ctx,
+                                       const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    using bf16_t = sycl::ext::oneapi::bfloat16;
+
+    const int64_t k = src0->ne[0];
+    const int64_t m = src0->ne[1];
+    const int64_t n = src1->ne[1];
+
+    const auto * w = static_cast<const bf16_t *>(src0->data);
+    const auto * x = static_cast<const float *>(src1->data);
+    auto *       y = static_cast<float *>(dst->data);
+
+    dpct::queue_ptr stream = ctx.stream();
+    ggml_sycl_pool_alloc<bf16_t> x_bf16(ctx.pool(), n*k);
+    const to_bf16_sycl_t to_bf16 = ggml_get_to_bf16_sycl(src1->type, dst);
+    GGML_ASSERT(to_bf16 != nullptr);
+    to_bf16(x, x_bf16.get(), n*k, stream);
+
+    const float alpha = 1.0f;
+    const float beta  = 0.0f;
+    SYCL_CHECK(CHECK_TRY_ERROR(oneapi::mkl::blas::column_major::gemm(
+        *stream, oneapi::mkl::transpose::trans, oneapi::mkl::transpose::nontrans,
+        m, n, k, alpha, w, k, x_bf16.get(), k, beta, y, dst->nb[1] / sizeof(float))));
+}
+
+static bool ggml_sycl_can_mul_mat_bf16_mkl(const ggml_tensor * src0, const ggml_tensor * src1,
+                                            const ggml_tensor * dst) {
+    static const int enabled = ggml_sycl_get_env("GGML_SYCL_BF16_MKL", 0);
+    return enabled &&
+           src0->type == GGML_TYPE_BF16 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+           ggml_is_contiguous(src0) && ggml_is_contiguous(src1) && ggml_is_contiguous(dst) &&
+           src0->ne[0] == src1->ne[0] && dst->ne[0] == src0->ne[1] && dst->ne[1] == src1->ne[1] &&
+           src0->ne[2] == 1 && src0->ne[3] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1 &&
+           dst->ne[2] == 1 && dst->ne[3] == 1 &&
+           // N=1 is faster on the incumbent path and defines the byte-stable
+           // target identity. Restrict this experiment to batched verification.
+           src1->ne[1] >= 2 && src1->ne[1] <= 16 &&
+           !ggml_backend_buffer_is_sycl_split(src0->buffer);
+}
+
+#if GGML_SYCL_DNNL && defined(GGML_SYCL_HAS_BF16)
+enum class ggml_sycl_bf16_batch2_kind {
+    FFN,
+    ATTN_Q_GATE,
+    ATTN_K_V,
+};
+
+struct ggml_sycl_bf16_batch2_plan {
+    ggml_sycl_bf16_batch2_kind kind;
+    const ggml_tensor * weights;
+    const ggml_tensor * activation;
+    ggml_tensor * output;
+    int64_t m;
+    int64_t n;
+    int64_t k;
+    dnnl_dim_t weight_batch_stride;
+    dnnl_dim_t output_batch_stride;
+};
+
+static bool ggml_sycl_dense_2d(const ggml_tensor * tensor) {
+    if (tensor == nullptr || tensor->data == nullptr || tensor->buffer == nullptr ||
+        tensor->ne[2] != 1 || tensor->ne[3] != 1 || !ggml_is_contiguous(tensor)) {
+        return false;
+    }
+
+    const size_t type_size = ggml_type_size(tensor->type);
+    return tensor->nb[0] == type_size &&
+           tensor->nb[1] == tensor->nb[0] * (size_t) tensor->ne[0] &&
+           tensor->nb[2] == tensor->nb[1] * (size_t) tensor->ne[1] &&
+           tensor->nb[3] == tensor->nb[2] * (size_t) tensor->ne[2];
+}
+
+static bool ggml_sycl_tensor_range_in_buffer(const ggml_tensor * tensor) {
+    if (tensor == nullptr || tensor->buffer == nullptr || tensor->data == nullptr) {
+        return false;
+    }
+
+    const uintptr_t base = (uintptr_t) ggml_backend_buffer_get_base(tensor->buffer);
+    const uintptr_t data = (uintptr_t) tensor->data;
+    const size_t buffer_size = ggml_backend_buffer_get_size(tensor->buffer);
+    const size_t tensor_size = ggml_nbytes(tensor);
+
+    if (data < base) {
+        return false;
+    }
+    const uintptr_t offset_u = data - base;
+    if (offset_u > buffer_size) {
+        return false;
+    }
+    const size_t offset = (size_t) offset_u;
+    return tensor_size <= buffer_size - offset;
+}
+
+static const char * ggml_sycl_projection_suffix(const ggml_tensor * tensor, const char * prefix) {
+    const char * name = tensor->name;
+    const size_t prefix_len = std::strlen(prefix);
+    if (std::strncmp(name, prefix, prefix_len) != 0 || name[prefix_len] == '\0') {
+        return nullptr;
+    }
+
+    const char * suffix = name + prefix_len;
+    for (const char * p = suffix; *p != '\0'; ++p) {
+        if (*p < '0' || *p > '9') {
+            return nullptr;
+        }
+    }
+    return suffix;
+}
+
+static std::optional<ggml_sycl_bf16_batch2_kind> ggml_sycl_batch2_kind(
+        const ggml_tensor * first, const ggml_tensor * second) {
+    const char * first_gate  = ggml_sycl_projection_suffix(first,  "ffn_gate-");
+    const char * first_up    = ggml_sycl_projection_suffix(first,  "ffn_up-");
+    const char * second_gate = ggml_sycl_projection_suffix(second, "ffn_gate-");
+    const char * second_up   = ggml_sycl_projection_suffix(second, "ffn_up-");
+    const char * first_layer  = first_gate  ? first_gate  : first_up;
+    const char * second_layer = second_gate ? second_gate : second_up;
+    if (g_ggml_sycl_dnnl_ffn_batch2 && first_layer != nullptr && second_layer != nullptr &&
+        (first_gate == nullptr) != (second_gate == nullptr) && std::strcmp(first_layer, second_layer) == 0) {
+        return ggml_sycl_bf16_batch2_kind::FFN;
+    }
+
+    if (!g_ggml_sycl_dnnl_attn_batch2) {
+        return std::nullopt;
+    }
+
+    const char * first_q     = ggml_sycl_projection_suffix(first,  "Qcur-");
+    const char * first_k     = ggml_sycl_projection_suffix(first,  "Kcur-");
+    const char * second_gate_attn = ggml_sycl_projection_suffix(second, "attn_gate_proj-");
+    const char * second_v    = ggml_sycl_projection_suffix(second, "Vcur-");
+    if (first_q != nullptr && second_gate_attn != nullptr && std::strcmp(first_q, second_gate_attn) == 0) {
+        return ggml_sycl_bf16_batch2_kind::ATTN_Q_GATE;
+    }
+    if (first_k != nullptr && second_v != nullptr && std::strcmp(first_k, second_v) == 0) {
+        return ggml_sycl_bf16_batch2_kind::ATTN_K_V;
+    }
+    return std::nullopt;
+}
+
+static std::optional<ggml_sycl_bf16_batch2_plan> ggml_sycl_plan_mul_mat_bf16_batch2(
+        ggml_tensor * first, ggml_tensor * second, const char ** rejection = nullptr) {
+    const auto reject = [&](const char * reason) -> std::optional<ggml_sycl_bf16_batch2_plan> {
+        if (rejection != nullptr) {
+            *rejection = reason;
+        }
+        return std::nullopt;
+    };
+
+    if ((!g_ggml_sycl_dnnl_ffn_batch2 && !g_ggml_sycl_dnnl_attn_batch2) || !g_ggml_sycl_enable_dnn ||
+        first == nullptr || second == nullptr ||
+        first->op != GGML_OP_MUL_MAT || second->op != GGML_OP_MUL_MAT) {
+        return reject("disabled-or-op");
+    }
+
+    const auto kind = ggml_sycl_batch2_kind(first, second);
+    if (!kind) {
+        return reject("pair-kind");
+    }
+
+    const ggml_tensor * w0 = first->src[0];
+    const ggml_tensor * w1 = second->src[0];
+    const ggml_tensor * x0 = first->src[1];
+    const ggml_tensor * x1 = second->src[1];
+    if (w0 == nullptr || w1 == nullptr || x0 == nullptr || x1 == nullptr) {
+        return reject("missing-source");
+    }
+    if (w0->type != GGML_TYPE_BF16 || w1->type != GGML_TYPE_BF16 ||
+        x0->type != GGML_TYPE_F32 || x1->type != GGML_TYPE_F32 ||
+        first->type != GGML_TYPE_F32 || second->type != GGML_TYPE_F32) {
+        return reject("type");
+    }
+    if (x0->data != x1->data || x0->buffer == nullptr || x0->buffer != x1->buffer) {
+        return reject("activation-identity");
+    }
+    if (w0->buffer == nullptr || w0->buffer != w1->buffer) {
+        return reject("weight-buffer");
+    }
+    if (first->buffer == nullptr || first->buffer != second->buffer) {
+        return reject("output-buffer");
+    }
+    if (x0->ne[1] < 2 || x0->ne[1] > 16) {
+        return reject("batch");
+    }
+    if (std::memcmp(first->op_params, second->op_params, GGML_MAX_OP_PARAMS) != 0) {
+        return reject("op-params");
+    }
+
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (w0->ne[d] != w1->ne[d] || w0->nb[d] != w1->nb[d] ||
+            x0->ne[d] != x1->ne[d] || x0->nb[d] != x1->nb[d] ||
+            first->ne[d] != second->ne[d] || first->nb[d] != second->nb[d]) {
+            return reject("shape-or-stride");
+        }
+    }
+
+    if (!ggml_sycl_dense_2d(w0) || !ggml_sycl_dense_2d(w1) ||
+        !ggml_sycl_dense_2d(x0) || !ggml_sycl_dense_2d(x1) ||
+        !ggml_sycl_dense_2d(first) || !ggml_sycl_dense_2d(second)) {
+        return reject("dense-2d");
+    }
+    if (!ggml_sycl_tensor_range_in_buffer(w0) || !ggml_sycl_tensor_range_in_buffer(w1) ||
+        !ggml_sycl_tensor_range_in_buffer(x0) || !ggml_sycl_tensor_range_in_buffer(x1) ||
+        !ggml_sycl_tensor_range_in_buffer(first) || !ggml_sycl_tensor_range_in_buffer(second)) {
+        return reject("buffer-range");
+    }
+    if (ggml_backend_buffer_is_sycl_split(w0->buffer)) {
+        return reject("split-buffer");
+    }
+    if (w0->ne[0] != x0->ne[0] || first->ne[0] != w0->ne[1] || first->ne[1] != x0->ne[1]) {
+        return reject("matmul-shape");
+    }
+
+    const uintptr_t w0_addr = (uintptr_t) w0->data;
+    const uintptr_t w1_addr = (uintptr_t) w1->data;
+    const uintptr_t c0_addr = (uintptr_t) first->data;
+    const uintptr_t c1_addr = (uintptr_t) second->data;
+    if (w0_addr == w1_addr) {
+        return reject("weight-alias");
+    }
+    if (c0_addr == c1_addr) {
+        return reject("output-alias");
+    }
+    if ((w0_addr < w1_addr) != (c0_addr < c1_addr)) {
+        return reject("batch-order");
+    }
+
+    const bool first_is_base = w0_addr < w1_addr;
+    const uintptr_t weight_delta = first_is_base ? w1_addr - w0_addr : w0_addr - w1_addr;
+    const uintptr_t output_delta = first_is_base ? c1_addr - c0_addr : c0_addr - c1_addr;
+    const size_t weight_type_size = ggml_type_size(w0->type);
+    const size_t output_type_size = ggml_type_size(first->type);
+    if (weight_delta % weight_type_size != 0 || output_delta % output_type_size != 0) {
+        return reject("batch-stride-alignment");
+    }
+
+    const uint64_t weight_stride = weight_delta / weight_type_size;
+    const uint64_t output_stride = output_delta / output_type_size;
+    const uint64_t weight_elements = (uint64_t) w0->ne[0] * (uint64_t) w0->ne[1];
+    const uint64_t output_elements = (uint64_t) first->ne[0] * (uint64_t) first->ne[1];
+    if (weight_stride < weight_elements || output_stride < output_elements ||
+        weight_stride > (uint64_t) std::numeric_limits<dnnl_dim_t>::max() ||
+        output_stride > (uint64_t) std::numeric_limits<dnnl_dim_t>::max()) {
+        return reject("batch-stride-span");
+    }
+
+    return ggml_sycl_bf16_batch2_plan {
+        /* .kind                = */ *kind,
+        /* .weights             = */ first_is_base ? w0 : w1,
+        /* .activation          = */ x0,
+        /* .output              = */ first_is_base ? first : second,
+        /* .m                   = */ w0->ne[1],
+        /* .n                   = */ x0->ne[1],
+        /* .k                   = */ w0->ne[0],
+        /* .weight_batch_stride = */ (dnnl_dim_t) weight_stride,
+        /* .output_batch_stride = */ (dnnl_dim_t) output_stride,
+    };
+}
+
+static void ggml_sycl_mul_mat_bf16_batch2(ggml_backend_sycl_context & ctx,
+                                           const ggml_sycl_bf16_batch2_plan & plan) {
+    using bf16_t = sycl::ext::oneapi::bfloat16;
+
+    static std::atomic<bool> first_hit_ffn { false };
+    static std::atomic<bool> first_hit_attn_q_gate { false };
+    static std::atomic<bool> first_hit_attn_k_v { false };
+    std::atomic<bool> * first_hit;
+    const char * marker;
+    switch (plan.kind) {
+        case ggml_sycl_bf16_batch2_kind::FFN:
+            first_hit = &first_hit_ffn;
+            marker = "GGML_SYCL_DNNL_FFN_BATCH2";
+            break;
+        case ggml_sycl_bf16_batch2_kind::ATTN_Q_GATE:
+            first_hit = &first_hit_attn_q_gate;
+            marker = "GGML_SYCL_DNNL_ATTN_BATCH2 Q_GATE";
+            break;
+        case ggml_sycl_bf16_batch2_kind::ATTN_K_V:
+            first_hit = &first_hit_attn_k_v;
+            marker = "GGML_SYCL_DNNL_ATTN_BATCH2 K_V";
+            break;
+    }
+    bool expected = false;
+    if (first_hit->compare_exchange_strong(expected, true)) {
+        GGML_LOG_INFO("[SYCL] %s first hit: weight=%s output=%s m=%" PRId64
+                      " n=%" PRId64 " k=%" PRId64 " weight_stride=%lld output_stride=%lld\n",
+                      marker, plan.weights->name, plan.output->name, plan.m, plan.n, plan.k,
+                      (long long) plan.weight_batch_stride, (long long) plan.output_batch_stride);
+    }
+
+    dpct::queue_ptr stream = ctx.stream();
+    ggml_sycl_pool_alloc<bf16_t> activation_bf16(ctx.pool(), plan.n * plan.k);
+    const to_bf16_sycl_t to_bf16 = ggml_get_to_bf16_sycl(plan.activation->type, plan.output);
+    GGML_ASSERT(to_bf16 != nullptr);
+    to_bf16(static_cast<const float *>(plan.activation->data), activation_bf16.get(), plan.n * plan.k, stream);
+
+    DnnlGemmWrapper::gemm(ctx, plan.m, plan.n, plan.k,
+                          plan.weights->data, DnnlGemmWrapper::to_dt<bf16_t>(),
+                          1, plan.k, plan.weight_batch_stride,
+                          activation_bf16.get(), DnnlGemmWrapper::to_dt<bf16_t>(),
+                          1, plan.k, plan.n * plan.k,
+                          plan.output->data, DnnlGemmWrapper::to_dt<float>(), stream,
+                          2, 1, plan.output_batch_stride);
+}
+
+struct ggml_sycl_bf16_batch2_candidate {
+    ggml_sycl_bf16_batch2_plan plan;
+    int second_index;
+};
+
+static bool ggml_sycl_tensor_ranges_overlap(const ggml_tensor * first, const ggml_tensor * second) {
+    if (first == nullptr || second == nullptr || first->data == nullptr || second->data == nullptr) {
+        return false;
+    }
+
+    const uintptr_t first_begin = (uintptr_t) first->data;
+    const uintptr_t second_begin = (uintptr_t) second->data;
+    const size_t first_size = ggml_nbytes(first);
+    const size_t second_size = ggml_nbytes(second);
+    if (first_size == 0 || second_size == 0 ||
+        first_size > UINTPTR_MAX - first_begin || second_size > UINTPTR_MAX - second_begin) {
+        return true;
+    }
+    return first_begin < second_begin + second_size && second_begin < first_begin + first_size;
+}
+
+static bool ggml_sycl_batch2_output_safe_before(
+        const ggml_cgraph * cgraph, int first_index, int second_index, const ggml_tensor ** overlap) {
+    const ggml_tensor * first = cgraph->nodes[first_index];
+    const ggml_tensor * second = cgraph->nodes[second_index];
+    for (const ggml_tensor * tensor : { first->src[0], first->src[1], second->src[0], second->src[1] }) {
+        if (ggml_sycl_tensor_ranges_overlap(second, tensor)) {
+            *overlap = tensor;
+            return false;
+        }
+    }
+
+    for (int i = first_index + 1; i < second_index; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        if (ggml_sycl_tensor_ranges_overlap(second, node)) {
+            *overlap = node;
+            return false;
+        }
+        for (int src = 0; src < GGML_MAX_SRC; ++src) {
+            if (ggml_sycl_tensor_ranges_overlap(second, node->src[src])) {
+                *overlap = node->src[src];
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static void ggml_sycl_log_attn_batch2_rejection(
+        const ggml_tensor * first, const ggml_tensor * second, const char * reason, const ggml_tensor * overlap) {
+    static const int debug = ggml_sycl_get_env("GGML_SYCL_DNNL_ATTN_BATCH2_DEBUG", 0);
+    static std::atomic<int> count { 0 };
+    if (!debug || count.fetch_add(1) >= 16) {
+        return;
+    }
+
+    GGML_LOG_INFO("[SYCL] GGML_SYCL_DNNL_ATTN_BATCH2 reject %s: first=%s second=%s first_out=%p second_out=%p"
+                  " first_weight=%p second_weight=%p overlap=%s overlap_data=%p\n",
+                  reason, first->name, second->name, first->data, second->data,
+                  first->src[0]->data, second->src[0]->data,
+                  overlap != nullptr ? overlap->name : "none", overlap != nullptr ? overlap->data : nullptr);
+}
+
+static std::optional<ggml_sycl_bf16_batch2_candidate> ggml_sycl_find_attn_batch2(
+        ggml_cgraph * cgraph, int first_index) {
+    if (!g_ggml_sycl_dnnl_attn_batch2) {
+        return std::nullopt;
+    }
+
+    ggml_tensor * first = cgraph->nodes[first_index];
+    if (ggml_sycl_projection_suffix(first, "Qcur-") == nullptr &&
+        ggml_sycl_projection_suffix(first, "Kcur-") == nullptr) {
+        return std::nullopt;
+    }
+
+    for (int second_index = first_index + 1; second_index < cgraph->n_nodes; ++second_index) {
+        ggml_tensor * second = cgraph->nodes[second_index];
+        const auto kind = ggml_sycl_batch2_kind(first, second);
+        if (!kind || *kind == ggml_sycl_bf16_batch2_kind::FFN) {
+            continue;
+        }
+
+        const char * rejection = nullptr;
+        const auto plan = ggml_sycl_plan_mul_mat_bf16_batch2(first, second, &rejection);
+        if (!plan) {
+            ggml_sycl_log_attn_batch2_rejection(first, second, rejection, nullptr);
+            return std::nullopt;
+        }
+        if ((second->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            ggml_sycl_log_attn_batch2_rejection(first, second, "not-compute", nullptr);
+            return std::nullopt;
+        }
+
+        const ggml_tensor * overlap = nullptr;
+        if (!ggml_sycl_batch2_output_safe_before(cgraph, first_index, second_index, &overlap)) {
+            ggml_sycl_log_attn_batch2_rejection(first, second, "intervening-overlap", overlap);
+            return std::nullopt;
+        }
+        return ggml_sycl_bf16_batch2_candidate { *plan, second_index };
+    }
+    return std::nullopt;
+}
+
+static bool ggml_sycl_can_mul_mat_bf16_pair(const ggml_tensor * first, const ggml_tensor * second) {
+    static const int enabled = ggml_sycl_get_env("GGML_SYCL_BF16_PAIR", 0);
+    if (!enabled || !g_ggml_sycl_enable_dnn || first->op != GGML_OP_MUL_MAT ||
+        second->op != GGML_OP_MUL_MAT) {
+        return false;
+    }
+
+    const ggml_tensor * w0 = first->src[0];
+    const ggml_tensor * w1 = second->src[0];
+    const ggml_tensor * x0 = first->src[1];
+    const ggml_tensor * x1 = second->src[1];
+    if (w0 == nullptr || w1 == nullptr || x0 == nullptr || x1 == nullptr ||
