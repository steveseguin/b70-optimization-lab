+#!/usr/bin/env python3
+
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import gguf
+
+from conversion import ModelBase, get_model_class
+from conversion.muse_glimmer import MuseGlimmerDSparkModel
+
+
+class TestMuseGlimmerDSparkModel(unittest.TestCase):
+    def test_public_checkpoint_config_normalization(self):
+        hparams = {
+            "architectures": ["DSparkDraftModel"],
+            "aux_hidden_state_layer_ids": [2, 14, 26, 38, 50],
+            "block_size": 15,
+            "speculators_config": {
+                "verifier": {"architectures": ["MuseGlimmerForConditionalGeneration"]},
+            },
+            "transformer_layer_config": {
+                "hidden_size": 6656,
+                "num_hidden_layers": 5,
+                "sliding_window": 2048,
+            },
+        }
+
+        normalized = MuseGlimmerDSparkModel.normalize_hparams(hparams)
+
+        self.assertEqual(normalized["target_layer_ids"], [1, 13, 25, 37, 49])
+        self.assertEqual(normalized["num_hidden_layers"], 5)
+        self.assertEqual(normalized["hidden_size"], 6656)
+        self.assertEqual(normalized["block_size"], 15)
+
+    def test_nested_config_is_normalized_before_text_model_setup(self):
+        hparams = {
+            "architectures": ["DSparkDraftModel"],
+            "aux_hidden_state_layer_ids": [2, 14, 26, 38, 50],
+            "block_size": 15,
+            "speculators_config": {
+                "verifier": {"architectures": ["MuseGlimmerForConditionalGeneration"]},
+            },
+            "transformer_layer_config": {
+                "hidden_size": 6656,
+                "num_hidden_layers": 5,
+                "sliding_window": 2048,
+            },
+        }
+
+        with patch.object(ModelBase, "index_tensors", return_value={}):
+            model = MuseGlimmerDSparkModel(
+                Path("unused"),
+                gguf.LlamaFileType.MOSTLY_BF16,
+                Path("unused.gguf"),
+                hparams=hparams,
+            )
+
+        self.assertEqual(model.block_count, 5)
+        self.assertEqual(model.hparams["target_layer_ids"], [1, 13, 25, 37, 49])
+
+    def test_architecture_registration_and_tensor_names(self):
+        self.assertIs(get_model_class("DSparkDraftModel"), MuseGlimmerDSparkModel)
+
+        tensor_map = gguf.get_tensor_name_map(gguf.MODEL_ARCH.DFLASH, 5)
+        cases = {
+            "model.fc.weight": "fc.weight",
+            "model.hidden_norm.weight": "enc.output_norm.weight",
+            "model.norm.weight": "output_norm.weight",
+            "model.layers.0.self_attn.q_proj.weight": "blk.0.attn_q.weight",
+            "model.markov_head.markov_w1.weight": "markov_w1.weight",
+            "model.markov_head.markov_w2.weight": "markov_w2.weight",
+            "model.confidence_head.proj.weight": "conf_proj.weight",
+            "model.confidence_head.proj.bias": "conf_proj.bias",
+        }
+
+        for source_name, expected_name in cases.items():
+            with self.subTest(source_name=source_name):
+                self.assertEqual(tensor_map.get_name(source_name, try_suffixes=(".weight", ".bias")), expected_name)
+
+
+if __name__ == "__main__":
+    unittest.main()
