+constexpr size_t   GGML_SYCL_DEVICE_TIMELINE_MAX_PENDING = 512;
+constexpr size_t   GGML_SYCL_DEVICE_TIMELINE_MAX_KEYS    = 128;
+constexpr size_t   GGML_SYCL_DEVICE_TIMELINE_REPORT_ROWS = 16;
+constexpr uint64_t GGML_SYCL_DEVICE_TIMELINE_REPORT_EVERY = 4096;
+constexpr uint64_t GGML_SYCL_DEVICE_TIMELINE_MAX_REPORTS  = 32;
+
+struct ggml_sycl_device_timeline_pending {
+    std::string                key;
+    sycl::event                before;
+    sycl::event                after;
+    std::optional<sycl::event> dnnl_completion;
+};
+
+struct ggml_sycl_device_timeline_stat {
+    uint64_t total_ns = 0;
+    uint64_t count    = 0;
+};
+
+static std::mutex ggml_sycl_device_timeline_queue_mutex;
+static std::unordered_map<queue_ptr, std::weak_ptr<std::mutex>> ggml_sycl_device_timeline_queue_locks;
+
+static std::shared_ptr<std::mutex> ggml_sycl_device_timeline_queue_lock(queue_ptr queue) {
+    std::lock_guard<std::mutex> lock(ggml_sycl_device_timeline_queue_mutex);
+    for (auto it = ggml_sycl_device_timeline_queue_locks.begin();
+         it != ggml_sycl_device_timeline_queue_locks.end();) {
+        if (it->second.expired()) {
+            it = ggml_sycl_device_timeline_queue_locks.erase(it);
+        } else {
+            ++it;
+        }
+    }
+    auto & weak = ggml_sycl_device_timeline_queue_locks[queue];
+    auto shared = weak.lock();
+    if (shared == nullptr) {
+        shared = std::make_shared<std::mutex>();
+        weak = shared;
+    }
+    return shared;
+}
