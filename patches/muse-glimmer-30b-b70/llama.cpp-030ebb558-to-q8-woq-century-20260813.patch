+// batched top-k export (experimental DFlash path)
+
+struct llama_sampler_batched_top_k : public llama_sampler_backend {
+    const int32_t k;
+};
+
+static const char * llama_sampler_batched_top_k_name(const struct llama_sampler * smpl) {
+    auto * sctx = (llama_sampler_batched_top_k *) smpl->ctx;
+    return sctx->get_name();
+}
+
+static void llama_sampler_batched_top_k_apply(
+        struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * sctx = (llama_sampler_batched_top_k *) smpl->ctx;
+    llama_sampler_top_k_impl(cur_p, sctx->k);
+    llama_sampler_softmax_impl(cur_p, true);
+    cur_p->selected = cur_p->size > 0 ? 0 : -1;
+}
+
+static struct llama_sampler * llama_sampler_batched_top_k_clone(const struct llama_sampler * smpl) {
+    const auto * sctx = (const llama_sampler_batched_top_k *) smpl->ctx;
+    return llama_sampler_init_batched_top_k(sctx->k);
+}
+
+static void llama_sampler_batched_top_k_free(struct llama_sampler * smpl) {
+    delete (llama_sampler_batched_top_k *) smpl->ctx;
+}
+
+static bool llama_sampler_batched_top_k_backend_init(
+        struct llama_sampler       * smpl,
+        ggml_backend_buffer_type_t   buft,
+        uint32_t                     n_outputs_max_per_seq) {
+    auto * sctx = (llama_sampler_batched_top_k *) smpl->ctx;
+    GGML_UNUSED(n_outputs_max_per_seq);
+    const bool res = llama_sampler_backend_support(smpl, buft);
+    sctx->init(res);
+    return res;
+}
+
+static void llama_sampler_batched_top_k_backend_apply(
+        struct llama_sampler      * smpl,
+        struct ggml_context       * ctx,
+        struct ggml_cgraph        * gf,
+        struct llama_sampler_data * data) {
+    auto * sctx = (llama_sampler_batched_top_k *) smpl->ctx;
+    GGML_ASSERT(data->logits != nullptr && data->logits->ne[2] == 1 && data->logits->ne[3] == 1);
+
+    // This sampler is deliberately terminal and is installed as the only
+    // sampler in the DFlash backend chain.  The generic backend-support probe
+    // nevertheless supplies an identity candidate tensor to every sampler.
+    // The output below is a fresh set of global token ids, so that probe input
+    // is intentionally replaced just as the terminal greedy sampler replaces
+    // its incoming logits/candidates state.
+
+    const int64_t n_vocab = data->logits->ne[0];
+    const int64_t n_rows  = data->logits->ne[1];
+    ggml_tensor * candidates = ggml_top_k(ctx, data->logits, sctx->k);
+    ggml_set_name(candidates, "batched_top_k_candidates");
+
+    ggml_tensor * logits_3d = ggml_reshape_3d(ctx, data->logits, 1, n_vocab, n_rows);
+    ggml_tensor * values_3d = ggml_get_rows(ctx, logits_3d, candidates);
+    ggml_tensor * values = ggml_reshape_2d(ctx, values_3d, sctx->k, n_rows);
+    ggml_set_name(values, "batched_top_k_logits");
+
+    ggml_tensor * probs = ggml_soft_max(ctx, values);
+    ggml_set_name(probs, "batched_top_k_probs");
+
+    ggml_tensor * sampled = ggml_view_2d(
+        ctx, candidates, 1, n_rows, candidates->nb[1], 0);
+    ggml_set_name(sampled, "batched_top_k_sampled");
+
+    data->candidates = candidates;
+    data->logits     = values;
+    data->probs      = probs;
+    data->sampled    = sampled;
+
+    GGML_UNUSED(gf);
+}
+
+static struct llama_sampler_i llama_sampler_batched_top_k_i = {
