+            } else {
+                entry.primitive.execute(stream, args);
+            }
+            return;
+        }
+
+        entry.a_mem.set_data_handle(const_cast<void *>(a));
+        entry.b_mem.set_data_handle(const_cast<void *>(b));
+        entry.c_mem.set_data_handle(c);
+        entry.scratchpad_mem.set_data_handle(ctx.get_scratchpad_ptr(entry.scratchpad_md, q));
+        if (ctx.device_timeline_active()) {
+            auto completion = dnnl::sycl_interop::execute(entry.primitive, stream, entry.args);
+            ctx.device_timeline_note_dnnl_event(std::move(completion));
+        } else {
+            entry.primitive.execute(stream, entry.args);
+        }
     }
 
