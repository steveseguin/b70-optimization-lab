+static void ggml_sycl_q8_0_woq_reject(
+        ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+        const ggml_tensor * src1, const char * reason) {
+    ++ctx.q8_0_woq_rejects;
+    if (ctx.q8_0_woq_rejects <= 16) {
+        GGML_LOG_WARN("[SYCL Q8_0 WOQ] device=%d ctx=%p reject # %" PRIu64
+                      ": weight=%s k=%" PRId64 " o=%" PRId64 " n=%" PRId64
+                      " reason=%s\n",
+                      ctx.device, (void *) &ctx, ctx.q8_0_woq_rejects,
+                      src0->name, src0->ne[0], src0->ne[1], src1->ne[1], reason);
+    }
+}
+
+static ggml_backend_sycl_context::q8_0_woq_cache_entry *
+ggml_sycl_q8_0_woq_get_cache(
+        ggml_backend_sycl_context & ctx, const queue_ptr & queue,
+        int64_t k, int64_t o, int64_t n, std::string & reject_reason) {
+    char key_buffer[128];
+    std::snprintf(key_buffer, sizeof(key_buffer), "%p:%" PRId64 ":%" PRId64 ":%" PRId64,
+                  (void *) queue, k, o, n);
+    const std::string key(key_buffer);
+    auto cached = ctx.q8_0_woq_cache.find(key);
+    if (cached != ctx.q8_0_woq_cache.end()) {
+        if (!cached->second) {
+            reject_reason = "oneDNN descriptor was previously rejected";
+            return nullptr;
+        }
+        return cached->second.get();
+    }
+
+    try {
+        using dt = dnnl::memory::data_type;
+        using tag = dnnl::memory::format_tag;
+        const dnnl::engine engine = ctx.engine_dnnl(queue);
+        const dnnl::memory::desc src_md({n, k}, dt::bf16, tag::ab);
+        // ggml's reordered qs prefix is physical [O,K]. Expose it as logical
+        // oneDNN weights [K,O] without copying by using strides [1,K].
+        const dnnl::memory::desc weights_md({k, o}, dt::s8, {1, k});
+        const dnnl::memory::desc dst_md({n, o}, dt::f32, tag::ab);
+        const dnnl::memory::desc scales_md({k / QK8_0, o}, dt::f16, tag::ab);
+
+        dnnl::primitive_attr attr;
+        attr.set_scratchpad_mode(dnnl::scratchpad_mode::user);
+        attr.set_scales(DNNL_ARG_WEIGHTS, 3, {QK8_0, 1}, dt::f16);
+        attr.set_fpmath_mode(dnnl::fpmath_mode::bf16, true);
+        const dnnl::matmul::primitive_desc pd(engine, src_md, weights_md, dst_md, attr);
+        const std::string impl = pd.impl_info_str();
+        const dnnl::memory::desc queried_scales_md = pd.query_md(
+            dnnl::query::exec_arg_md, DNNL_ARG_ATTR_SCALES | DNNL_ARG_WEIGHTS);
+        if (pd.src_desc() != src_md) {
+            reject_reason = "oneDNN changed the direct BF16 source descriptor";
+        } else if (pd.dst_desc() != dst_md) {
+            reject_reason = "oneDNN changed the direct F32 destination descriptor";
+        } else if (pd.src_desc().get_size() != (size_t) n * k * sizeof(sycl::ext::oneapi::bfloat16)) {
+            reject_reason = "oneDNN source descriptor size mismatch";
+        } else if (pd.dst_desc().get_size() != (size_t) n * o * sizeof(float)) {
+            reject_reason = "oneDNN destination descriptor size mismatch";
+        } else if (scales_md.get_size() !=
+                   (size_t) (k / QK8_0) * o * sizeof(sycl::half)) {
+            reject_reason = "oneDNN scale descriptor size mismatch";
+        } else if (pd.weights_desc() != weights_md) {
+            reject_reason = "oneDNN did not retain direct-strided weights";
+        } else if (!queried_scales_md.is_zero() && queried_scales_md != scales_md) {
+            reject_reason = "oneDNN scale execution descriptor mismatch";
+        } else if (impl.find("ref") != std::string::npos) {
+            reject_reason = "oneDNN selected a reference implementation";
+        }
+        if (!reject_reason.empty()) {
+            ctx.q8_0_woq_cache.emplace(key, nullptr);
+            return nullptr;
+        }
+
+        auto entry = std::make_unique<ggml_backend_sycl_context::q8_0_woq_cache_entry>(
+            src_md, pd.weights_desc(), pd.dst_desc(), scales_md,
+            pd.scratchpad_desc(), dnnl::matmul(pd), impl);
+        auto inserted = ctx.q8_0_woq_cache.emplace(key, std::move(entry));
+        return inserted.first->second.get();
+    } catch (const dnnl::error & error) {
+        reject_reason = std::string("oneDNN descriptor creation failed: ") + error.what();
+        ctx.q8_0_woq_cache.emplace(key, nullptr);
+        return nullptr;
+    }
+}
+
+static sycl::half * ggml_sycl_q8_0_woq_get_scale_sidecar(
+        ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+        std::string & reject_reason) {
+    auto * buffer_ctx = static_cast<ggml_backend_sycl_buffer_context *>(src0->buffer->context);
+    const queue_ptr queue = ctx.stream();
+    if (queue != buffer_ctx->stream) {
+        reject_reason = "compute queue differs from the weight buffer queue";
+        return nullptr;
+    }
+    if (!queue->has_property<sycl::property::queue::in_order>() ||
+        !buffer_ctx->stream->has_property<sycl::property::queue::in_order>()) {
+        reject_reason = "incumbent compute and weight queues must be in-order";
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(buffer_ctx->q8_0_woq_mutex);
+    auto cached = buffer_ctx->q8_0_woq_scale_sidecars.find(src0->data);
+    if (cached != buffer_ctx->q8_0_woq_scale_sidecars.end()) {
+        return static_cast<sycl::half *>(cached->second);
+    }
+
+    auto * extra = static_cast<ggml_tensor_extra_gpu *>(src0->extra);
+    if (!extra) {
+        reject_reason = "tensor has no reorder metadata";
+        return nullptr;
+    }
+    if (!extra->optimized_feature.reorder) {
+        if (!reorder_qw(src0, queue)) {
+            reject_reason = "incumbent Q8_0 reorder failed";
+            return nullptr;
+        }
+        extra->optimized_feature.reorder = true;
+    }
+
+    const int64_t k = src0->ne[0];
+    const int64_t o = src0->ne[1];
+    const int64_t groups = k / QK8_0;
+    const size_t scale_elements = (size_t) groups * o;
+    sycl::half * sidecar = nullptr;
+    try {
+        sidecar = static_cast<sycl::half *>(
+            ggml_sycl_malloc_device(scale_elements * sizeof(sycl::half), *queue));
+    } catch (const sycl::exception & error) {
+        reject_reason = std::string("scale sidecar allocation failed: ") + error.what();
+        return nullptr;
+    }
+    if (!sidecar) {
+        reject_reason = "scale sidecar allocation returned null";
+        return nullptr;
+    }
+
+    // The incumbent reordered tail is [O,K/32]. Preserve it for generic
+    // DMMV/MMVQ/F32 fallback and materialize only one transposed F16 sidecar.
+    const sycl::half * owner_major = reinterpret_cast<const sycl::half *>(
+        static_cast<const int8_t *>(src0->data) + (size_t) k * o);
+    try {
+        queue->parallel_for(sycl::range<1>(scale_elements), [=](sycl::id<1> index) {
+            const size_t linear = index[0];
+            const int64_t group = linear / o;
+            const int64_t output = linear - (size_t) group * o;
+            sidecar[linear] = owner_major[(size_t) output * groups + group];
+        });
+    } catch (const sycl::exception & error) {
+        ggml_sycl_free_device(sidecar, *queue);
+        reject_reason = std::string("scale sidecar transpose submission failed: ") + error.what();
+        return nullptr;
+    }
+    buffer_ctx->q8_0_woq_scale_sidecars.emplace(src0->data, sidecar);
+    return sidecar;
+}
+
+static bool ggml_sycl_try_mul_mat_q8_0_woq_bf16(
+        ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+        const ggml_tensor * src1, ggml_tensor * dst, bool split) {
+    if (!g_ggml_sycl_q8_0_woq_bf16) {
+        return false;
+    }
+    const muse_q8_0_projection projection = muse_q8_0_projection_from_name(src0->name);
+    if (projection == muse_q8_0_projection::NONE) {
+        return false;
+    }
+
+    const int64_t k = src0->ne[0];
+    const int64_t o = src0->ne[1];
+    const int64_t n = src1->ne[1];
+    const bool fixed16 = g_ggml_sycl_q8_0_woq_fixed16 && n >= 1 && n <= 16;
+    const int64_t execution_n = fixed16 ? 16 : n;
+    const char * reject_reason = nullptr;
+    if (split || src0->buffer == nullptr || !ggml_backend_buffer_is_sycl(src0->buffer)) {
+        reject_reason = "weight is not a local unsplit SYCL tensor";
+    } else if (src0->view_src != nullptr || src0->data == nullptr) {
+        reject_reason = "weight must own non-null storage";
+    } else if (!g_ggml_sycl_enable_dnn) {
+        reject_reason = "oneDNN is disabled";
+    } else if (!g_ggml_sycl_enable_optimize || !ctx.opt_feature.reorder) {
+        reject_reason = "incumbent Q8 reorder is unavailable";
+    } else if (src0->type != GGML_TYPE_Q8_0 || src1->type != GGML_TYPE_F32 ||
+               dst->type != GGML_TYPE_F32) {
+        reject_reason = "requires Q8_0/F32/F32";
+    } else if (src0->ne[2] != 1 || src0->ne[3] != 1 ||
+               src1->ne[2] != 1 || src1->ne[3] != 1 ||
+               dst->ne[2] != 1 || dst->ne[3] != 1) {
+        reject_reason = "requires rank-2 tensors";
+    } else if (!ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) ||
+               !ggml_is_contiguous(dst)) {
+        reject_reason = "requires contiguous tensors";
+    } else if (k % QK8_0 != 0 || src1->ne[0] != k || dst->ne[0] != o ||
+               dst->ne[1] != n) {
+        reject_reason = "matrix dimensions or Q8 group alignment mismatch";
+    } else if (ggml_nbytes(src0) !=
+               (size_t) k * o + sizeof(sycl::half) * (size_t) (k / QK8_0) * o) {
+        reject_reason = "Q8_0 storage size is incompatible with dense-qs plus scale tail";
+    } else if (n < 1 || n > 16) {
+        reject_reason = "initial proof is decode/verifier-only (N <= 16)";
+    } else if (!muse_q8_0_projection_shape_matches(projection, k, o)) {
+        reject_reason = "projection name/local TP4 shape mismatch";
+    } else if (dst->op_params[0] != GGML_PREC_DEFAULT) {
+        reject_reason = "non-default precision requested";
+    }
+    if (reject_reason) {
+        ggml_sycl_q8_0_woq_reject(ctx, src0, src1, reject_reason);
+        return false;
+    }
+
+    const queue_ptr queue = ctx.stream();
+    std::string dynamic_reject;
+    auto * entry = ggml_sycl_q8_0_woq_get_cache(ctx, queue, k, o, execution_n, dynamic_reject);
+    if (!entry) {
+        ggml_sycl_q8_0_woq_reject(ctx, src0, src1, dynamic_reject.c_str());
+        return false;
+    }
+    sycl::half * scales = ggml_sycl_q8_0_woq_get_scale_sidecar(ctx, src0, dynamic_reject);
+    if (!scales) {
+        ggml_sycl_q8_0_woq_reject(ctx, src0, src1, dynamic_reject.c_str());
+        return false;
+    }
+
+    using bf16_t = sycl::ext::oneapi::bfloat16;
+    const size_t valid_src_elements = (size_t) n * k;
+    const size_t execution_src_elements = (size_t) execution_n * k;
+    ggml_sycl_pool_alloc<bf16_t> temporary_src(ctx.pool());
+    ggml_sycl_pool_alloc<float> padded_dst(ctx.pool());
+    const dnnl::engine engine = ctx.engine_dnnl(queue);
+    const dnnl::stream stream = ctx.stream_dnnl(queue);
+    // The VMM pool is strictly LIFO. Materialize persistent oneDNN scratch
+    // before the graph-scoped conversion/destination temporaries, then make
+    // padded_dst the final allocation so its stack destructor can release it
+    // before any cached conversion entry at the graph boundary.
+    const dnnl::memory scratchpad_mem = ctx.get_scratchpad_mem(entry->scratchpad_md, engine, queue);
+    bf16_t * src_bf16 = nullptr;
+    const auto submit_conversion = [&](bf16_t * converted) {
+        const to_bf16_sycl_t to_bf16 = ggml_get_to_bf16_sycl(src1->type, dst);
+        GGML_ASSERT(to_bf16 != nullptr);
+        to_bf16(src1->data, converted, valid_src_elements, queue);
+        if (fixed16 && execution_src_elements > valid_src_elements) {
+            queue->memset(converted + valid_src_elements, 0,
+                          (execution_src_elements - valid_src_elements) * sizeof(bf16_t));
+        }
+    };
+    static const int conversion_cache =
