+enum class muse_q8_0_projection {
+    NONE,
+    ATTN_Q_OR_GATE,
+    ATTN_OUTPUT,
+    FFN_UP_OR_GATE,
+    FFN_DOWN,
+};
+
+static muse_q8_0_projection muse_q8_0_projection_from_name(const char * name) {
+    if (std::strncmp(name, "blk.", 4) != 0) {
+        return muse_q8_0_projection::NONE;
+    }
+    char * end = nullptr;
+    const long block = std::strtol(name + 4, &end, 10);
+    if (end == name + 4 || block < 0 || block >= 52) {
+        return muse_q8_0_projection::NONE;
+    }
+    if (std::strcmp(end, ".attn_q.weight") == 0 ||
+        std::strcmp(end, ".attn_gate.weight") == 0) {
+        return muse_q8_0_projection::ATTN_Q_OR_GATE;
+    }
+    if (std::strcmp(end, ".attn_output.weight") == 0) {
+        return muse_q8_0_projection::ATTN_OUTPUT;
+    }
+    if (std::strcmp(end, ".ffn_up.weight") == 0 ||
+        std::strcmp(end, ".ffn_gate.weight") == 0) {
+        return muse_q8_0_projection::FFN_UP_OR_GATE;
+    }
+    if (std::strcmp(end, ".ffn_down.weight") == 0) {
+        return muse_q8_0_projection::FFN_DOWN;
+    }
+    return muse_q8_0_projection::NONE;
+}
+
+static bool muse_q8_0_projection_shape_matches(
+        muse_q8_0_projection projection, int64_t k, int64_t o) {
+    switch (projection) {
+        case muse_q8_0_projection::ATTN_Q_OR_GATE:
+            return k == 6656 && o == 2048;
+        case muse_q8_0_projection::ATTN_OUTPUT:
+            return k == 2048 && o == 6656;
+        case muse_q8_0_projection::FFN_UP_OR_GATE:
+            return k == 6656 && o == 4992;
+        case muse_q8_0_projection::FFN_DOWN:
+            return k == 4992 && o == 6656;
+        case muse_q8_0_projection::NONE:
+            return false;
+    }
+    return false;
+}
