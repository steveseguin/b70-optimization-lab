+def _parse_dense_prepack_mode(name: str) -> str:
+    mode = os.getenv(name, "").strip().lower()
+    if mode not in {"", "contiguous", "padded64"}:
+        raise ValueError(f"{name} must be empty, contiguous, or padded64")
+    return mode
+
+
+_DENSE_PREPACK_MODES = {
+    (4096, 512): _parse_dense_prepack_mode(
+        "VLLM_XPU_V4_SHARED_DOWN_FP8_PREPACK"
+    ),
+    (8192, 1024): _parse_dense_prepack_mode(
+        "VLLM_XPU_V4_WQB_W8A16_PREPACK"
+    ),
+    (1024, 4096): _parse_dense_prepack_mode(
+        "VLLM_XPU_V4_SHARED_GATE_UP_W8A16_PREPACK"
+    ),
+}
+
+
+def _prepack_block_fp8_weight(weight_nk: torch.Tensor, mode: str) -> torch.Tensor:
+    """Materialize a stable oneDNN [K,N] weight layout without changing bytes."""
+    weight_kn = weight_nk.t()
+    if mode == "contiguous":
+        return weight_kn.contiguous()
+    if mode == "padded64":
+        k, n = weight_kn.shape
+        storage = torch.empty(
+            (k, n + 64), dtype=weight_kn.dtype, device=weight_kn.device
+        )
+        packed = storage[:, :n]
+        packed.copy_(weight_kn)
+        return packed
+    raise AssertionError(f"unexpected block-FP8 prepack mode: {mode}")
+
