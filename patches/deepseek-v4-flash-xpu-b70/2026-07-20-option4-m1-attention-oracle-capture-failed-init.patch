+def _paged_fp8_raw_rows(
+    cache: torch.Tensor, slots: torch.Tensor, block_size: int
+) -> torch.Tensor:
+    """Gather DS-MLA FP8 payload+scale bytes for declared physical slots."""
+    assert cache.dtype == torch.uint8
+    flat_slots = slots.to(torch.int64).reshape(-1)
+    total_slots = cache.shape[0] * block_size
+    safe_slots = flat_slots.clamp(0, max(total_slots - 1, 0))
+    blocks = safe_slots // block_size
+    offsets = safe_slots % block_size
+    cache_2d = cache.view(cache.shape[0], -1)
+    data_indices = offsets[:, None] * 576 + torch.arange(
+        576, device=slots.device
+    )
+    scale_indices = block_size * 576 + offsets[:, None] * 8 + torch.arange(
+        8, device=slots.device
+    )
+    rows = torch.cat(
+        [
+            cache_2d[blocks[:, None], data_indices],
+            cache_2d[blocks[:, None], scale_indices],
+        ],
+        dim=1,
+    )
+    valid = (flat_slots >= 0) & (flat_slots < total_slots)
+    return torch.where(valid[:, None], rows, torch.zeros_like(rows))
+
+
+def _slot_with_guards(slots: torch.Tensor, total_slots: int) -> torch.Tensor:
+    flat = slots.to(torch.int64).reshape(-1)
+    return torch.stack(
+        [
+            (flat - 1).clamp(0, total_slots - 1),
+            flat.clamp(0, total_slots - 1),
+            (flat + 1).clamp(0, total_slots - 1),
+        ],
+        dim=1,
+    )
+
+
