+            recorder.record_static(
+                layer,
+                "kv_storage_binding",
+                compressed_kv_storage=kv_cache.reshape(-1)[:0],
+            )
+            recorder.record(
+                layer,
+                "compressed_kv_before",
+                slots=compressed_slots,
+                guarded_slots=compressed_guard_slots,
+                raw=compressed_raw_before,
+            )
+
