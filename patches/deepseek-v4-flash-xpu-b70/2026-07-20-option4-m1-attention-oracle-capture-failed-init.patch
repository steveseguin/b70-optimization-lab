+            def capture_raw(slots: torch.Tensor) -> torch.Tensor:
+                flat = slots.reshape(-1)
+                blocks = flat // k_cache_metadata.block_size
+                row_offsets = flat % k_cache_metadata.block_size
+                cache_2d = kv_cache.view(kv_cache.shape[0], -1)
+                data_indices = row_offsets[:, None] * 576 + torch.arange(
+                    576, device=kv_cache.device
+                )
+                scale_indices = (
+                    k_cache_metadata.block_size * 576
+                    + row_offsets[:, None] * 8
+                    + torch.arange(8, device=kv_cache.device)
+                )
+                return torch.cat(
+                    [
+                        cache_2d[blocks[:, None], data_indices],
+                        cache_2d[blocks[:, None], scale_indices],
+                    ],
+                    dim=1,
+                )
+
