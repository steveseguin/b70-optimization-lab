+            offsets = compressed_positions % k_cache_metadata.block_size
+            physical_blocks = k_cache_metadata.block_table[
+                req_indices, logical_blocks
+            ].to(torch.int64)
+            compressed_slots = physical_blocks * k_cache_metadata.block_size + offsets
+            total_compressed_slots = kv_cache.shape[0] * k_cache_metadata.block_size
+            compressed_guard_slots = torch.stack(
+                [
+                    (compressed_slots - 1).clamp(0, total_compressed_slots - 1),
+                    compressed_slots.clamp(0, total_compressed_slots - 1),
