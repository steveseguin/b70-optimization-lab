+def gather_logical_cache_rows(cache: torch.Tensor, slots: torch.Tensor) -> torch.Tensor:
+    """Gather flattened logical rows without requiring contiguous storage."""
+    if cache.ndim < 3:
+        raise ValueError(
+            f"expected cache with at least 3 dimensions, got {cache.shape}"
+        )
+    block_size = cache.shape[1]
+    flat_slots = slots.to(torch.int64).reshape(-1)
+    blocks = flat_slots // block_size
+    offsets = flat_slots % block_size
+    rows = cache[blocks, offsets]
+    return rows.reshape(*slots.shape, -1)
+
