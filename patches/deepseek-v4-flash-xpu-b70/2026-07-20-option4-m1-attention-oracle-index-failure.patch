index 000000000..4b81aa454
--- /dev/null
+++ b/tests/models/deepseek_v4/test_divergence_capture.py
@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: Apache-2.0
+
+import torch
+
+from vllm.models.deepseek_v4.xpu import divergence_capture
+
+
+def test_gather_logical_cache_rows_handles_noncontiguous_cache() -> None:
+    storage = torch.arange(2 * 5 * 3 * 2).reshape(2, 5, 3, 2)
+    cache = storage[:, :, :, 1]
+    slots = torch.tensor([[0, 1, 4], [5, 8, 9]])
+
+    assert not cache.is_contiguous()
+    expected = torch.stack(
+        [cache[slot // 5, slot % 5].reshape(-1) for slot in slots.reshape(-1)]
+    ).reshape(*slots.shape, -1)
+
+    actual = divergence_capture.gather_logical_cache_rows(cache, slots)
+
+    assert torch.equal(actual, expected)
+
+
+def test_recorder_is_inactive_without_armed_forward(monkeypatch) -> None:
+    monkeypatch.setattr(divergence_capture, "CAPTURE_STAGES", {"state"})
+    monkeypatch.setattr(divergence_capture, "CAPTURE_LAYERS", {3})
+    recorder = divergence_capture.DivergenceRecorder()
+    recorder.enabled = True
+
+    assert not recorder.is_active(3, "state")
+
+    recorder._active_forward = 0
+    assert recorder.is_active(3, "state")
+    assert not recorder.is_active(2, "state")
+    assert not recorder.is_active(3, "other")
