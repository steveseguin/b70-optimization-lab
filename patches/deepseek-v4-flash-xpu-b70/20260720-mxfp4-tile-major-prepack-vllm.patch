+_XPU_MXFP4_TILE_MAJOR_PREPACK_ENV = "VLLM_XPU_MXFP4_TILE_MAJOR_PREPACK"
+
+
+def _xpu_mxfp4_tile_major_prepack(
+    weight: torch.Tensor,
+    scales: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Pack K32xN64 weight tiles with one 64-byte E8M0 sidecar.
+
+    Each immutable 1088-byte record is laid out as 1024 untouched MXFP4
+    bytes followed by the corresponding 64 untouched E8M0 scale bytes.  The
+    two returned tensors alias that one allocation; the enlarged final
+    dimension is an explicit, fail-closed marker for the native reader.
+    """
+    if weight.dtype != torch.float4_e2m1fn_x2:
+        raise ValueError("XPU tile-major prepack requires packed MXFP4 weights")
+    if scales.dtype not in (torch.uint8, torch.float8_e8m0fnu):
+        raise ValueError("XPU tile-major prepack requires raw E8M0 scale bytes")
+    if weight.ndim != 3 or scales.ndim != 3:
+        raise ValueError("XPU tile-major prepack requires 3D weight/scale tensors")
+
+    experts, n, packed_k = weight.shape
+    k = packed_k * 2
+    groups = k // 32
+    if n % 64 != 0 or k % 32 != 0:
+        raise ValueError("XPU tile-major prepack requires N%64==0 and K%32==0")
+    if tuple(scales.shape) != (experts, n, groups):
+        raise ValueError(
+            "XPU tile-major scale shape must be [experts, N, K/32], got "
+            f"{tuple(scales.shape)}"
+        )
+
+    weight_tiles = (
+        weight.view(torch.uint8)
+        .reshape(experts, n // 64, 64, groups, 16)
+        .permute(0, 1, 3, 2, 4)
+        .reshape(experts, n // 64, groups, 1024)
+    )
+    scale_tiles = (
+        scales.view(torch.uint8)
+        .reshape(experts, n // 64, 64, groups)
+        .permute(0, 1, 3, 2)
+        .reshape(experts, n // 64, groups, 64)
+    )
+    records = torch.cat((weight_tiles, scale_tiles), dim=-1).contiguous()
+    combined = records.reshape(experts, n, groups * 17)
+    return combined.view(torch.float4_e2m1fn_x2), combined
+
