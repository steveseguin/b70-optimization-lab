+template <typename scalar_t>
+void qwen36_single_token_gemm2_gather_topk8_out_impl(
+    scalar_t* output,
+    const int8_t* gemm2_a,
+    const float* gemm2_a_scales,
+    const int8_t* w2,
+    const float* w2_scales,
+    const float* w2_bias,
+    const int64_t* topk_ids,
+    const float* topk_weights,
+    const int* unpermuted_row_to_permuted_row,
+    int64_t hidden_size,
+    int64_t inter_size,
+    int64_t topk) {
+  constexpr int kBlockSize = 256;
+  auto& queue = vllm::xpu::vllmGetQueue();
+  sycl::range<1> local(kBlockSize);
+  sycl::range<1> global(hidden_size * kBlockSize);
+
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<int32_t, 1> partial(local, cgh);
+    cgh.parallel_for<
+        Qwen36SingleTokenGemm2GatherTopK8Kernel<scalar_t>>(
+        sycl::nd_range<1>(global, local),
+        [=](sycl::nd_item<1> item)
+            [[sycl::reqd_sub_group_size(16)]] {
+              const int64_t col = item.get_group(0);
+              const int local_id = item.get_local_id(0);
+              const int local_range = item.get_local_range(0);
+              float accum = 0.0f;
+
+              for (int k = 0; k < topk; ++k) {
+                const int row = unpermuted_row_to_permuted_row[k];
+                const int64_t expert = topk_ids[k];
+                int32_t thread_sum = 0;
+                for (int64_t kk = local_id; kk < inter_size;
+                     kk += local_range) {
+                  const int32_t a =
+                      static_cast<int32_t>(gemm2_a[row * inter_size + kk]);
+                  const int32_t b = static_cast<int32_t>(
+                      w2[(expert * inter_size + kk) * hidden_size + col]);
+                  thread_sum += a * b;
+                }
+
+                partial[local_id] = thread_sum;
+                item.barrier(sycl::access::fence_space::local_space);
+
+                for (int stride = local_range / 2; stride > 0; stride >>= 1) {
+                  if (local_id < stride) {
+                    partial[local_id] += partial[local_id + stride];
+                  }
+                  item.barrier(sycl::access::fence_space::local_space);
+                }
+
+                if (local_id == 0) {
+                  float value = static_cast<float>(partial[0]) *
+                      gemm2_a_scales[row] *
+                      w2_scales[expert * hidden_size + col];
+                  if (w2_bias != nullptr) {
+                    value += w2_bias[expert * hidden_size + col];
+                  }
+
+                  // Match the accepted exact path: GEMM2 first materializes a
+                  // BF16/FP16 row; gather then converts that row back to float.
+                  const scalar_t intermediate = static_cast<scalar_t>(value);
+                  accum += qwen36_to_float(intermediate) * topk_weights[k];
+                }
+
+                item.barrier(sycl::access::fence_space::local_space);
+              }
+
+              if (local_id == 0) {
+                output[col] = static_cast<scalar_t>(accum);
+              }
+            });
+  });
+}
+
+bool qwen36_can_use_single_token_direct_gemm2_gather(
+    const torch::Tensor& output,
+    const torch::Tensor& gemm2_a,
+    const torch::Tensor& gemm2_a_scales,
+    const torch::Tensor& w2,
+    const torch::Tensor& w2_scales,
+    const c10::optional<at::Tensor>& w2_bias,
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    int64_t hidden_size,
+    int64_t inter_size,
+    int64_t num_experts) {
+  const bool bias_ok = !w2_bias.has_value() ||
+      (w2_bias.value().defined() && w2_bias.value().dim() == 2 &&
+       w2_bias.value().size(0) == num_experts &&
+       w2_bias.value().size(1) == hidden_size &&
+       w2_bias.value().scalar_type() == torch::kFloat32);
+  return output.dim() == 2 && output.size(0) == 1 &&
+         output.size(1) == hidden_size &&
+         (output.scalar_type() == torch::kBFloat16 ||
+          output.scalar_type() == torch::kFloat16) &&
+         gemm2_a.dim() == 2 && gemm2_a.size(0) >= 8 &&
+         gemm2_a.size(1) == inter_size &&
+         gemm2_a.scalar_type() == torch::kInt8 &&
+         gemm2_a_scales.numel() >= 8 &&
+         gemm2_a_scales.scalar_type() == torch::kFloat32 &&
+         w2.dim() == 3 && w2.size(0) == num_experts &&
+         w2.size(1) == inter_size && w2.size(2) == hidden_size &&
+         w2.scalar_type() == torch::kInt8 &&
+         w2_scales.dim() == 2 && w2_scales.size(0) == num_experts &&
+         w2_scales.size(1) == hidden_size &&
+         w2_scales.scalar_type() == torch::kFloat32 && bias_ok &&
+         topk_ids.dim() == 2 && topk_ids.size(0) == 1 &&
+         topk_ids.size(1) == 8 &&
+         topk_ids.scalar_type() == torch::kInt64 &&
+         topk_weights.dim() == 2 && topk_weights.size(0) == 1 &&
+         topk_weights.size(1) == 8 &&
