+bool qwen36_can_use_single_token_route_gemm1(
+    const torch::Tensor& gemm1_a,
+    const torch::Tensor& gemm1_a_scales,
+    const torch::Tensor& w13,
+    const torch::Tensor& w13_scales,
+    const c10::optional<at::Tensor>& w13_bias,
+    const torch::Tensor& gemm1_output,
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    int64_t hidden_size,
+    int64_t inter_size,
+    int64_t num_experts) {
+  const int64_t gemm1_n = 2 * inter_size;
+  const bool bias_ok = !w13_bias.has_value() ||
+      (w13_bias.value().defined() && w13_bias.value().dim() == 2 &&
+       w13_bias.value().size(0) == num_experts &&
+       w13_bias.value().size(1) == gemm1_n &&
+       w13_bias.value().scalar_type() == torch::kFloat32);
+  return gemm1_a.dim() == 2 && gemm1_a.size(0) >= 8 &&
+         gemm1_a.size(1) == hidden_size &&
+         gemm1_a.scalar_type() == torch::kInt8 &&
+         gemm1_a_scales.numel() >= 8 &&
+         gemm1_a_scales.scalar_type() == torch::kFloat32 &&
+         w13.dim() == 3 && w13.size(0) == num_experts &&
+         w13.size(1) == hidden_size && w13.size(2) == gemm1_n &&
+         w13.scalar_type() == torch::kInt8 &&
+         w13_scales.dim() == 2 && w13_scales.size(0) == num_experts &&
+         w13_scales.size(1) == gemm1_n &&
+         w13_scales.scalar_type() == torch::kFloat32 && bias_ok &&
+         gemm1_output.dim() == 2 && gemm1_output.size(0) >= 8 &&
+         gemm1_output.size(1) == gemm1_n &&
+         (gemm1_output.scalar_type() == torch::kBFloat16 ||
+          gemm1_output.scalar_type() == torch::kFloat16) &&
+         topk_ids.dim() == 2 && topk_ids.size(0) == 1 &&
+         topk_ids.size(1) == 8 &&
+         topk_ids.scalar_type() == torch::kInt64 &&
+         unpermuted_row_to_permuted_row.dim() == 1 &&
+         unpermuted_row_to_permuted_row.numel() >= 8 &&
+         unpermuted_row_to_permuted_row.scalar_type() == torch::kInt32;
