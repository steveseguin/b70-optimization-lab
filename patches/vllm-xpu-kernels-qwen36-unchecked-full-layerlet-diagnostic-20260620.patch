+torch::Tensor qwen36_topk_ids_to_active_expert_ids_int32_out(
+    torch::Tensor topk_ids,
+    torch::Tensor active_expert_ids,
+    int64_t topk) {
+  require_xpu_contiguous(topk_ids, "topk_ids");
+  require_xpu_contiguous(active_expert_ids, "active_expert_ids");
+  require_same_device(topk_ids, active_expert_ids, "active_expert_ids");
+  require_dtype(topk_ids, "topk_ids", at::ScalarType::Long);
+  require_dtype(active_expert_ids, "active_expert_ids", at::ScalarType::Int);
+  TORCH_CHECK(topk >= 0, "topk must be non-negative");
+  TORCH_CHECK(topk <= 64, "topk helper supports at most 64 experts");
+  TORCH_CHECK(topk_ids.numel() >= topk, "topk_ids must cover topk");
+  TORCH_CHECK(
+      active_expert_ids.numel() >= topk,
+      "active_expert_ids must cover topk");
+
+  const int64_t* topk_ptr = topk_ids.data_ptr<int64_t>();
+  int32_t* active_ptr = active_expert_ids.data_ptr<int32_t>();
+  auto& queue = vllm::xpu::vllmGetQueue();
+
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.single_task<Qwen36TopkIdsToActiveExpertsInt32Kernel>([=]() {
+      int32_t values[64];
+      for (int64_t i = 0; i < topk; ++i) {
+        values[i] = static_cast<int32_t>(topk_ptr[i]);
+      }
+      for (int64_t i = 1; i < topk; ++i) {
+        const int32_t value = values[i];
+        int64_t j = i - 1;
+        while (j >= 0 && values[j] > value) {
+          values[j + 1] = values[j];
+          --j;
+        }
+        values[j + 1] = value;
+      }
+      for (int64_t i = 0; i < topk; ++i) {
+        active_ptr[i] = values[i];
+      }
+    });
+  });
+
+  return active_expert_ids;
+}
