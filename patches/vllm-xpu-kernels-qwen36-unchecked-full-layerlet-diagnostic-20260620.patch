+template <typename scalar_t>
+void qwen36_shared_expert_gate_mul_out_impl(
+    const scalar_t* hidden_states,
+    const scalar_t* expert_gate_w,
+    const scalar_t* down_out,
+    scalar_t* output,
+    int64_t rows,
+    int64_t hidden_size) {
+  constexpr int kBlockSize = 256;
+  auto& queue = vllm::xpu::vllmGetQueue();
+  sycl::range<1> local(kBlockSize);
+  sycl::range<1> global(rows * kBlockSize);
+
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<float, 1> partial(local, cgh);
+    cgh.parallel_for<Qwen36SharedExpertGateMulKernel<scalar_t>>(
+        sycl::nd_range<1>(global, local),
+        [=](sycl::nd_item<1> item)
+            [[sycl::reqd_sub_group_size(16)]] {
+              const int64_t row = item.get_group(0);
+              const int local_id = item.get_local_id(0);
+              const int local_range = item.get_local_range(0);
+
+              float thread_sum = 0.0f;
+              for (int64_t col = local_id; col < hidden_size;
+                   col += local_range) {
+                thread_sum +=
+                    qwen36_to_float(hidden_states[row * hidden_size + col]) *
+                    qwen36_to_float(expert_gate_w[col]);
+              }
+
+              partial[local_id] = thread_sum;
+              item.barrier(sycl::access::fence_space::local_space);
+
+              for (int stride = local_range / 2; stride > 0; stride >>= 1) {
+                if (local_id < stride) {
+                  partial[local_id] += partial[local_id + stride];
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+              }
+
+              const scalar_t gate_t = static_cast<scalar_t>(partial[0]);
+              const float gate_f = qwen36_to_float(gate_t);
+              const scalar_t sigmoid_t = static_cast<scalar_t>(
+                  1.0f / (1.0f + sycl::exp(-gate_f)));
+              const float sigmoid_f = qwen36_to_float(sigmoid_t);
+
+              for (int64_t col = local_id; col < hidden_size;
+                   col += local_range) {
+                const float value =
+                    sigmoid_f *
+                    qwen36_to_float(down_out[row * hidden_size + col]);
+                output[row * hidden_size + col] =
+                    static_cast<scalar_t>(value);
+              }
+            });
+  });
+}
+
+void qwen36_shared_expert_gate_mul_out(
+    const torch::Tensor& hidden_states,
+    const torch::Tensor& expert_gate_w,
+    const torch::Tensor& down_out,
+    torch::Tensor& output) {
+  require_xpu_contiguous(hidden_states, "hidden_states");
+  require_xpu_contiguous(expert_gate_w, "expert_gate_w");
+  require_xpu_contiguous(down_out, "down_out");
+  require_xpu_contiguous(output, "output");
+  require_same_device(hidden_states, expert_gate_w, "expert_gate_w");
+  require_same_device(hidden_states, down_out, "down_out");
+  require_same_device(hidden_states, output, "output");
+  require_dtype(expert_gate_w, "expert_gate_w", hidden_states.scalar_type());
+  require_dtype(down_out, "down_out", hidden_states.scalar_type());
+  require_dtype(output, "output", hidden_states.scalar_type());
+
+  TORCH_CHECK(hidden_states.dim() == 2, "hidden_states must be [rows, hidden]");
+  TORCH_CHECK(down_out.sizes() == hidden_states.sizes(),
+              "down_out shape must match hidden_states");
+  TORCH_CHECK(output.sizes() == hidden_states.sizes(),
+              "output shape must match hidden_states");
+  TORCH_CHECK(expert_gate_w.dim() == 2,
+              "expert_gate_w must be [hidden, 1] or [1, hidden]");
+  const int64_t rows = hidden_states.size(0);
+  const int64_t hidden = hidden_states.size(1);
+  TORCH_CHECK(
+      (expert_gate_w.size(0) == hidden && expert_gate_w.size(1) == 1) ||
+          (expert_gate_w.size(0) == 1 && expert_gate_w.size(1) == hidden),
+      "expert_gate_w shape mismatch: expected [",
+      hidden,
+      ", 1] or [1, ",
+      hidden,
+      "]");
+  TORCH_CHECK(
+      hidden_states.scalar_type() == torch::kBFloat16 ||
+          hidden_states.scalar_type() == torch::kFloat16 ||
+          hidden_states.scalar_type() == torch::kFloat32,
+      "qwen36 shared expert fused gate/mul only supports bf16, fp16, and fp32");
+
+  if (hidden_states.scalar_type() == torch::kBFloat16) {
+    qwen36_shared_expert_gate_mul_out_impl(
+        reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(
+            hidden_states.data_ptr()),
+        reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(
+            expert_gate_w.data_ptr()),
+        reinterpret_cast<const sycl::ext::oneapi::bfloat16*>(
+            down_out.data_ptr()),
+        reinterpret_cast<sycl::ext::oneapi::bfloat16*>(output.data_ptr()),
+        rows,
+        hidden);
+  } else if (hidden_states.scalar_type() == torch::kFloat16) {
+    qwen36_shared_expert_gate_mul_out_impl(
+        reinterpret_cast<const sycl::half*>(hidden_states.data_ptr()),
+        reinterpret_cast<const sycl::half*>(expert_gate_w.data_ptr()),
+        reinterpret_cast<const sycl::half*>(down_out.data_ptr()),
+        reinterpret_cast<sycl::half*>(output.data_ptr()),
+        rows,
+        hidden);
+  } else {
+    qwen36_shared_expert_gate_mul_out_impl(
+        hidden_states.data_ptr<float>(),
+        expert_gate_w.data_ptr<float>(),
+        down_out.data_ptr<float>(),
+        output.data_ptr<float>(),
+        rows,
+        hidden);
+  }
+}
