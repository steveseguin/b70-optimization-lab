+
+torch::Tensor qwen36_shared_expert_w8a8_out(
+    const torch::Tensor& hidden_states,
+    torch::Tensor& hidden_q,
+    torch::Tensor& hidden_scales,
+    const torch::Tensor& gate_up_w,
+    const torch::Tensor& gate_up_w_scales,
+    torch::Tensor& gate_up_out,
+    torch::Tensor& act_q,
+    torch::Tensor& act_scales,
+    const torch::Tensor& down_w,
+    const torch::Tensor& down_w_scales,
+    torch::Tensor& down_out,
+    const torch::Tensor& expert_gate_w,
+    torch::Tensor& output) {
+  require_xpu_contiguous(hidden_states, "hidden_states");
+  require_xpu_contiguous(hidden_q, "hidden_q");
+  require_xpu_contiguous(hidden_scales, "hidden_scales");
+  require_xpu_contiguous(gate_up_w, "gate_up_w");
+  require_xpu_contiguous(gate_up_w_scales, "gate_up_w_scales");
+  require_xpu_contiguous(gate_up_out, "gate_up_out");
+  require_xpu_contiguous(act_q, "act_q");
+  require_xpu_contiguous(act_scales, "act_scales");
+  require_xpu_contiguous(down_w, "down_w");
+  require_xpu_contiguous(down_w_scales, "down_w_scales");
+  require_xpu_contiguous(down_out, "down_out");
+  require_xpu_contiguous(expert_gate_w, "expert_gate_w");
+  require_xpu_contiguous(output, "output");
+  require_same_device(hidden_states, hidden_q, "hidden_q");
+  require_same_device(hidden_states, hidden_scales, "hidden_scales");
+  require_same_device(hidden_states, gate_up_w, "gate_up_w");
+  require_same_device(hidden_states, gate_up_w_scales, "gate_up_w_scales");
+  require_same_device(hidden_states, gate_up_out, "gate_up_out");
+  require_same_device(hidden_states, act_q, "act_q");
+  require_same_device(hidden_states, act_scales, "act_scales");
+  require_same_device(hidden_states, down_w, "down_w");
+  require_same_device(hidden_states, down_w_scales, "down_w_scales");
+  require_same_device(hidden_states, down_out, "down_out");
+  require_same_device(hidden_states, expert_gate_w, "expert_gate_w");
+  require_same_device(hidden_states, output, "output");
+  require_dtype(hidden_q, "hidden_q", torch::kInt8);
+  require_dtype(act_q, "act_q", torch::kInt8);
+  require_dtype(hidden_scales, "hidden_scales", torch::kFloat32);
+  require_dtype(act_scales, "act_scales", torch::kFloat32);
+  TORCH_CHECK(hidden_states.dim() == 2, "hidden_states must be [rows, hidden]");
+  TORCH_CHECK(gate_up_w.dim() == 2, "gate_up_w must be [hidden, 2*inter]");
+  TORCH_CHECK(down_w.dim() == 2, "down_w must be [inter, hidden]");
+  TORCH_CHECK(expert_gate_w.dim() == 2,
+              "expert_gate_w must be [hidden, 1] or [1, hidden]");
+  const int64_t rows = hidden_states.size(0);
+  const int64_t hidden = hidden_states.size(1);
+  const int64_t inter = down_w.size(0);
+  TORCH_CHECK(gate_up_w.size(0) == hidden, "gate_up_w K mismatch");
+  TORCH_CHECK(gate_up_w.size(1) == 2 * inter, "gate_up_w N mismatch");
+  TORCH_CHECK(down_w.size(1) == hidden, "down_w N mismatch");
+  const bool expert_gate_col_major =
+      expert_gate_w.size(0) == hidden && expert_gate_w.size(1) == 1;
+  const bool expert_gate_linear_layout =
+      expert_gate_w.size(0) == 1 && expert_gate_w.size(1) == hidden;
+  TORCH_CHECK(expert_gate_col_major || expert_gate_linear_layout,
+              "expert_gate_w shape mismatch: expected [",
+              hidden,
+              ", 1] or [1, ",
+              hidden,
+              "], got [",
+              expert_gate_w.size(0),
+              ", ",
+              expert_gate_w.size(1),
+              "]");
+  TORCH_CHECK(hidden_q.sizes() == hidden_states.sizes(), "hidden_q shape mismatch");
+  TORCH_CHECK(hidden_scales.sizes() == at::IntArrayRef({rows, 1}),
+              "hidden_scales shape mismatch");
+  TORCH_CHECK(gate_up_out.sizes() == at::IntArrayRef({rows, 2 * inter}),
+              "gate_up_out shape mismatch");
+  TORCH_CHECK(act_q.sizes() == at::IntArrayRef({rows, inter}),
+              "act_q shape mismatch");
+  TORCH_CHECK(act_scales.sizes() == at::IntArrayRef({rows, 1}),
+              "act_scales shape mismatch");
+  TORCH_CHECK(down_out.sizes() == at::IntArrayRef({rows, hidden}),
+              "down_out shape mismatch");
+  TORCH_CHECK(output.sizes() == at::IntArrayRef({rows, hidden}),
+              "output shape mismatch");
+
+  per_token_quant_int8_xpu_out(hidden_states, hidden_q, hidden_scales);
+  int8_gemm_w8a8_out(hidden_q,
+                     hidden_scales,
+                     gate_up_w,
+                     gate_up_w_scales,
+                     gate_up_out,
+                     std::nullopt);
+  silu_and_mul_quant_int8_xpu_out(gate_up_out, act_q, act_scales);
+  int8_gemm_w8a8_out(
+      act_q, act_scales, down_w, down_w_scales, down_out, std::nullopt);
+
+  if (qwen36_shared_expert_fused_gate_mul_enabled()) {
+    qwen36_shared_expert_gate_mul_out(
+        hidden_states, expert_gate_w, down_out, output);
+  } else {
+    auto gate = expert_gate_col_major
+        ? at::matmul(hidden_states, expert_gate_w)
+        : at::matmul(hidden_states, expert_gate_w.t());
+    output.copy_(at::sigmoid(gate) * down_out);
+  }
+  return output;
+}
