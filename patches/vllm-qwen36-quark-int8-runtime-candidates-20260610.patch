+def _prepare_int8_scale_for_xpu(
+    scale: torch.Tensor,
+    out_features: int,
+) -> torch.Tensor:
+    if scale.dim() == 3 and scale.shape[-1] == 1:
+        scale = scale.squeeze(-1)
+    if scale.dim() == 1:
+        scale = scale.view(-1, 1).expand(-1, out_features)
+    elif scale.dim() != 2 or scale.shape[-1] != out_features:
+        raise ValueError(
+            "XPU W8A8 INT8 MoE expects weight scales shaped [E], "
+            f"[E, {out_features}], or [E, {out_features}, 1]. "
+            f"Got {tuple(scale.shape)}.")
+    return scale.contiguous()
+
+
+def prepare_int8_moe_layer_for_xpu(
+    w13: torch.Tensor,
+    w2: torch.Tensor,
+    w13_scale: torch.Tensor,
+    w2_scale: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    w13_out_features = w13.shape[-2]
+    w2_out_features = w2.shape[-2]
+    return (
+        w13.transpose(-1, -2).contiguous(),
+        w2.transpose(-1, -2).contiguous(),
+        _prepare_int8_scale_for_xpu(w13_scale, w13_out_features),
+        _prepare_int8_scale_for_xpu(w2_scale, w2_out_features),
+    )
