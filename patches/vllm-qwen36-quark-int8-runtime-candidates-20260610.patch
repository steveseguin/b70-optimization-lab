+class XPUInt8RMSNormDynamicQuantPattern:
+    def __init__(self, epsilon: float) -> None:
+        self.epsilon = epsilon
+        config = get_current_vllm_config()
+        self.model_dtype = config.model_config.dtype if config.model_config else None
+        self.FUSED_OP = torch.ops._C.rms_norm_dynamic_per_token_quant.default
+        self.QUANT_OP = torch.ops._xpu_C.per_token_quant_int8_xpu.default
+
+    def register(self, pm_pass: PatternMatcherPass) -> None:
+        def pattern(
+            input: torch.Tensor, weight: torch.Tensor
+        ) -> tuple[torch.Tensor, torch.Tensor]:
+            result_rms = vllm.ir.ops.rms_norm(input, weight, self.epsilon)
+            result_rms = result_rms.to(dtype=self.model_dtype)
+            result_2d = result_rms.view(-1, result_rms.shape[-1]).contiguous()
+            return self.QUANT_OP(result_2d)
+
+        def replacement(
+            input: torch.Tensor, weight: torch.Tensor
+        ) -> tuple[torch.Tensor, torch.Tensor]:
+            # Match the existing XPU dense INT8 path contract:
+            # q is flattened int8 activation, scale is [tokens, 1].
+            input = input.to(dtype=self.model_dtype)
+            input_2d = input.view(-1, input.shape[-1]).contiguous()
+            weight = weight.to(dtype=self.model_dtype)
+            result = torch.empty_like(input_2d, dtype=torch.int8)
+            scale = torch.empty(
+                (*input_2d.shape[:-1], 1),
+                device=input.device,
+                dtype=torch.float32,
+            )
+            at = auto_functionalized(
+                self.FUSED_OP,
+                result=result,
+                input=input_2d,
+                weight=weight,
+                scale=scale,
+                epsilon=self.epsilon,
+                scale_ub=None,
+                residual=None,
+            )
+
+            return at[1], at[2]
+
+        pm.register_replacement(
+            pattern,
+            replacement,
+            [
+                empty_xpu_bf16(5, 16),  # input
+                empty_xpu_bf16(16),  # weight
+            ],
+            pm.fwd_only,
+            pm_pass,
+        )
