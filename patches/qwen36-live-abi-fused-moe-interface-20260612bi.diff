+def _live_abi_path() -> str | None:
+    raw = os.environ.get(LIVE_ABI_FILE_ENV, "").strip()
+    if not raw:
+        return None
+    return (raw.replace("{pid}", str(os.getpid())).replace(
+        "{rank}", os.environ.get("RANK", "")).replace(
+            "{local_rank}", os.environ.get("LOCAL_RANK", "")))
+
+
+def _live_abi_rank_allowed() -> bool:
+    wanted = os.environ.get(LIVE_ABI_RANK_ENV, "").strip()
+    if not wanted:
+        return True
+    return wanted in {
+        os.environ.get("RANK", ""),
+        os.environ.get("LOCAL_RANK", ""),
+    }
+
+
+def _tensor_meta(tensor):
+    if tensor is None:
+        return None
+    try:
+        return {
+            "shape": list(tensor.shape),
+            "dtype": str(tensor.dtype).replace("torch.", ""),
+            "device": str(tensor.device),
+            "data_ptr": int(tensor.data_ptr()),
+            "stride": list(tensor.stride()),
+            "is_contiguous": bool(tensor.is_contiguous()),
+            "numel": int(tensor.numel()),
+        }
+    except Exception as exc:
+        return {"error": repr(exc)}
+
+
+def _tensor_sample(tensor, limit: int = 16):
+    if tensor is None:
+        return None
+    try:
+        if tensor.numel() == 0:
+            return []
+        values = tensor.detach().reshape(-1)[:limit].to("cpu",
+                                                        non_blocking=False)
+        if tensor.dtype in (torch.int8, torch.uint8, torch.int16, torch.int32,
+                            torch.int64):
+            return [int(v) for v in values.tolist()]
+        return [float(v) for v in values.float().tolist()]
+    except Exception as exc:
+        return {"error": repr(exc)}
+
+
+def _tensor_sample_sum(tensor, limit: int = 64):
+    sample = _tensor_sample(tensor, limit)
+    if not isinstance(sample, list):
+        return None
+    try:
+        return float(sum(sample))
+    except Exception:
+        return None
+
+
