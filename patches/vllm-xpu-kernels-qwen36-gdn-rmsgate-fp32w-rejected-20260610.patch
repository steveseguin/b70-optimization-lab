+void rms_norm_gated_silu(
+    torch::Tensor& out,
+    torch::Tensor& input,
+    torch::Tensor& gate,
+    torch::Tensor& weight,
+    double epsilon) {
+  const at::DeviceGuard device_guard(input.device());
+  TORCH_CHECK(out.is_contiguous());
+  TORCH_CHECK(input.is_contiguous());
+  TORCH_CHECK(gate.is_contiguous());
+  TORCH_CHECK(weight.is_contiguous());
+  TORCH_CHECK(input.scalar_type() == gate.scalar_type());
+  TORCH_CHECK(input.scalar_type() == out.scalar_type());
+  TORCH_CHECK(
+      weight.scalar_type() == at::ScalarType::Float ||
+      input.scalar_type() == weight.scalar_type());
+  TORCH_CHECK(input.sizes() == gate.sizes());
+  TORCH_CHECK(input.sizes() == out.sizes());
+  TORCH_CHECK(weight.dim() == 1);
+  TORCH_CHECK(weight.size(0) == input.size(-1));
+  VLLM_DISPATCH_FLOATING_TYPES(
+      input.scalar_type(), "call_rms_norm_gated_silu_kernel", [&] {
+        vllm::dispatch_rms_norm_gated_silu_weight_type<scalar_t>(
+            out, input, gate, weight, epsilon);
+      });
+}
