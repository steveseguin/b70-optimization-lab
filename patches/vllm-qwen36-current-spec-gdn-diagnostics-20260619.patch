+def _xpu_gdn_mirror_prefill_spec_state(
+    conv_state: torch.Tensor,
+    ssm_state: torch.Tensor,
+    state_indices: torch.Tensor | None,
+    ssm_source_state: torch.Tensor | None = None,
+) -> None:
+    if state_indices is None or state_indices.ndim != 2:
+        return
+    if state_indices.size(1) <= 1:
+        return
+    src_all = state_indices[:, 0].to(torch.long)
+    source_rows = torch.arange(
+        state_indices.size(0),
+        dtype=torch.long,
+        device=state_indices.device,
+    )
+    for col in range(1, state_indices.size(1)):
+        dest_all = state_indices[:, col].to(torch.long)
+        mirror_mask = (src_all > 0) & (dest_all > 0) & (src_all != dest_all)
+        if not torch.any(mirror_mask):
+            continue
+        src = src_all[mirror_mask]
+        dest = dest_all[mirror_mask]
+        conv_state.index_copy_(0, dest,
+                               conv_state.index_select(0, src).clone())
+        if ssm_source_state is None:
+            ssm_state[dest] = ssm_state.index_select(0, src).clone()
+        else:
+            rows = source_rows[mirror_mask]
