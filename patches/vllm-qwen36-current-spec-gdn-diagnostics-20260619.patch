+def _xpu_gdn_mirror_prefill_spec_state_native(
+    *,
+    conv_state: torch.Tensor,
+    ssm_state: torch.Tensor,
+    state_indices: torch.Tensor | None,
+) -> None:
+    if state_indices is None or state_indices.ndim != 2:
+        return
+    if state_indices.size(1) <= 1:
+        return
+
+    src_all = state_indices[:, 0].to(torch.long)
+    for col in range(1, state_indices.size(1)):
+        dest_all = state_indices[:, col].to(torch.long)
+        mirror_mask = (src_all > 0) & (dest_all > 0) & (src_all != dest_all)
+        if not torch.any(mirror_mask):
+            continue
+        src = src_all[mirror_mask]
+        dest = dest_all[mirror_mask]
+        conv_state.index_copy_(0, dest,
+                               conv_state.index_select(0, src).clone())
+        ssm_state.index_copy_(0, dest,
+                              ssm_state.index_select(0, src).clone())
+
+
+def _xpu_gdn_copy_state_rows_native(
+    *,
+    conv_state: torch.Tensor,
+    ssm_state: torch.Tensor,
+    dest_indices: torch.Tensor,
+    src_indices: torch.Tensor,
+) -> None:
+    dest = dest_indices.to(torch.long)
+    src = src_indices.to(torch.long)
+    copy_mask = (dest > 0) & (src > 0) & (dest != src)
+    if not torch.any(copy_mask):
+        return
+    dest = dest[copy_mask]
+    src = src[copy_mask]
+    conv_state.index_copy_(0, dest,
+                           conv_state.index_select(0, src).clone())
+    ssm_state.index_copy_(0, dest,
+                          ssm_state.index_select(0, src).clone())
+
+
+def _xpu_gdn_promote_running_state_native(
+    *,
+    conv_state: torch.Tensor,
+    ssm_state: torch.Tensor,
+    dest_indices: torch.Tensor | None,
+    source_indices: torch.Tensor | None,
+    num_tokens: int,
+) -> None:
+    if source_indices is None or dest_indices is None or num_tokens <= 0:
+        return
+    n = min(num_tokens, int(dest_indices.numel()), int(source_indices.numel()))
+    if n <= 0:
+        return
+    _xpu_gdn_copy_state_rows_native(
+        conv_state=conv_state,
+        ssm_state=ssm_state,
+        dest_indices=dest_indices[:n],
+        src_indices=source_indices[:n],
+    )
+
+
+def _xpu_gdn_manual_conv1d_state_update(
+    mixed_qkv_step: torch.Tensor,
+    conv_state: torch.Tensor,
+    conv_weights: torch.Tensor,
+    conv_bias: torch.Tensor | None,
+    activation: str | None,
+    state_indices: torch.Tensor,
+) -> torch.Tensor:
+    state_indices = state_indices.to(torch.long)
+    raw_step = mixed_qkv_step.to(conv_state.dtype)
+    current = conv_state.index_select(0, state_indices).clone()
+    kernel_width = int(conv_weights.size(1))
+    history_len = max(0, kernel_width - 1)
+
+    if current.dim() != 3:
+        raise RuntimeError(
+            "manual GDN conv replay expects a 3D conv state tensor")
+
+    # SD layout: [block, state_len, dim]. DS layout: [block, dim, state_len].
+    if current.size(-1) == raw_step.size(-1):
+        history = current[:, -history_len:, :]
+        window = torch.cat((history, raw_step.unsqueeze(1)), dim=1)
+        weight = conv_weights.to(window.dtype).transpose(0, 1).unsqueeze(0)
+        conv_out = (window * weight).sum(dim=1)
+        if conv_bias is not None:
+            conv_out = conv_out + conv_bias.to(conv_out.dtype)
+        new_state = torch.cat((current[:, 1:, :], raw_step.unsqueeze(1)),
+                              dim=1)
+    elif current.size(1) == raw_step.size(-1):
+        history = current[:, :, -history_len:]
+        window = torch.cat((history, raw_step.unsqueeze(-1)), dim=-1)
+        weight = conv_weights.to(window.dtype).unsqueeze(0)
+        conv_out = (window * weight).sum(dim=-1)
+        if conv_bias is not None:
+            conv_out = conv_out + conv_bias.to(conv_out.dtype)
+        new_state = torch.cat((current[:, :, 1:], raw_step.unsqueeze(-1)),
+                              dim=-1)
+    else:
+        raise RuntimeError(
+            "manual GDN conv replay could not infer conv state layout")
+
+    if activation in ("silu", "swish", True):
+        conv_out = conv_out * torch.sigmoid(conv_out)
+    conv_state.index_copy_(0, state_indices, new_state.to(conv_state.dtype))
+    return conv_out.to(mixed_qkv_step.dtype)
+
