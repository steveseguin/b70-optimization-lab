+            dtype=torch.int32, device=pair_indices.device
+        )
+    dest = pair_indices[:, 0].to(torch.long)
+    src = pair_indices[:, 1].to(torch.long)
+    accepted = torch.where(src != dest, 2, 1)
+    return accepted.to(dtype=torch.int32, device=pair_indices.device)
