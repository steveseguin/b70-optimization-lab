   at::Tag stride_tag = at::Tag::needs_fixed_stride_order;
 
+  xpu_ops.def(
+      "q38_tp4_oneccl_allreduce_count2560(Tensor input) -> Tensor");
+  xpu_ops.impl(
+      "q38_tp4_oneccl_allreduce_count2560",
+      torch::kXPU,
+      &q38_tp4_oneccl_allreduce_count2560);
+
