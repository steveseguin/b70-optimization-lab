+            topk = min(self.greedy_decision_trace.topk, logits.shape[-1])
+            for req_index in trace_indices:
+                output_token_ids = self.input_batch.req_output_token_ids[req_index]
+                assert output_token_ids is not None
+                top_logits, top_token_ids = torch.topk(
+                    logits[req_index].to(torch.float32), topk
+                )
+                greedy_trace_rows.append(
+                    (
+                        req_index,
+                        self.input_batch.req_ids[req_index],
+                        len(output_token_ids),
+                        top_logits,
+                        top_token_ids,
+                    )
+                )
+
         with record_function_or_nullcontext("gpu_model_runner: sample"):
             sampler_output = self._sample(logits, spec_decode_metadata)
 
+        if greedy_trace_rows:
+            with gpu_sync_allowed():
+                for (
+                    req_index,
+                    request_id,
+                    output_index,
+                    top_logits,
+                    top_token_ids,
+                ) in greedy_trace_rows:
+                    self.greedy_decision_trace.record(
+                        request_id=request_id,
+                        output_index_before_sample=output_index,
+                        batch_index=req_index,
+                        logits_shape=logits.shape,
+                        logits_dtype=str(logits.dtype),
+                        top_token_ids=top_token_ids.cpu().tolist(),
+                        top_logits=top_logits.cpu().tolist(),
+                        sampled_token_id=sampler_output.sampled_token_ids[
+                            req_index, 0
+                        ].item(),
+                    )
+
         self._update_states_after_model_execute(
             sampler_output.sampled_token_ids, scheduler_output
         )
