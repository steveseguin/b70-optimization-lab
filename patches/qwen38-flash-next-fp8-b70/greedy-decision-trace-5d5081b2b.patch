+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import json
+
+import pytest
+
+from vllm.v1.worker.greedy_decision_trace import GreedyDecisionTrace
+
+
+def make_trace(tmp_path, *, max_records=4):
+    return GreedyDecisionTrace(
+        directory=str(tmp_path / "trace"),
+        request_prefix="depth-repeat-",
+        max_records=max_records,
+        topk=2,
+    )
+
+
+def test_matching_indices_are_greedy_prefix_and_discard_scoped(tmp_path):
+    trace = make_trace(tmp_path)
+    assert trace.matching_indices(
+        ["depth-repeat-a", "other", "depth-repeat-b"],
+        [False, False, True],
+        all_greedy=True,
+    ) == [0]
+    assert not trace.matching_indices(["depth-repeat-a"], [False], all_greedy=False)
+
+
+def test_records_occurrences_and_exact_float_hex(tmp_path):
+    trace = make_trace(tmp_path)
+    common = {
+        "request_id": "depth-repeat-a",
+        "batch_index": 0,
+        "logits_shape": [1, 8],
+        "logits_dtype": "torch.float32",
+        "top_token_ids": [7, 3],
+        "top_logits": [2.5, 2.0],
+        "sampled_token_id": 7,
+    }
+    trace.record(output_index_before_sample=0, **common)
+    trace.record(output_index_before_sample=1, **common)
+    trace.record(output_index_before_sample=0, **common)
+
+    rows = [json.loads(line) for line in trace.path.read_text().splitlines()]
+    assert [row["request_occurrence"] for row in rows] == [1, 1, 2]
+    assert [row["output_index_before_sample"] for row in rows] == [0, 1, 0]
+    assert rows[0]["top_logits_float_hex"] == [
+        "0x1.4000000000000p+1",
+        "0x1.0000000000000p+1",
+    ]
+    assert rows[0]["top1_top2_margin_float_hex"] == "0x1.0000000000000p-1"
+    assert rows[0]["sampled_equals_top1"] is True
+
+
+def test_refuses_existing_trace_and_honors_record_cap(tmp_path):
+    trace = make_trace(tmp_path, max_records=1)
+    kwargs = {
+        "request_id": "depth-repeat-a",
+        "output_index_before_sample": 0,
+        "batch_index": 0,
+        "logits_shape": [1, 8],
+        "logits_dtype": "torch.float32",
+        "top_token_ids": [7, 3],
+        "top_logits": [2.5, 2.0],
+        "sampled_token_id": 7,
+    }
+    trace.record(**kwargs)
+    trace.record(**kwargs)
+    assert len(trace.path.read_text().splitlines()) == 1
+    with pytest.raises(FileExistsError):
+        make_trace(tmp_path)
