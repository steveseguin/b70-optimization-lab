+++ b/vllm/v1/worker/greedy_decision_trace.py
@@ -0,0 +1,105 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from __future__ import annotations
+
+import json
+from collections.abc import Sequence
+from pathlib import Path
+
+
+class GreedyDecisionTrace:
+    """Bounded JSONL writer for opt-in greedy-decision diagnostics."""
+
+    schema = "vllm.greedy-decision-trace.v1"
+
+    def __init__(
+        self,
+        directory: str,
+        request_prefix: str,
+        max_records: int,
+        topk: int,
+    ) -> None:
+        if not directory:
+            raise ValueError("greedy decision trace directory must not be empty")
+        if not request_prefix:
+            raise ValueError("greedy decision trace request prefix must not be empty")
+        if max_records <= 0:
+            raise ValueError("greedy decision trace max records must be positive")
+        if topk < 2:
+            raise ValueError("greedy decision trace topk must be at least 2")
+
+        root = Path(directory)
+        root.mkdir(parents=True, exist_ok=True)
+        self.path = root / "greedy-decisions-rank0.jsonl"
+        if self.path.exists():
+            raise FileExistsError(f"refusing to append to existing trace: {self.path}")
+
+        self.request_prefix = request_prefix
+        self.max_records = max_records
+        self.topk = topk
+        self.record_count = 0
+        self._occurrence_by_request: dict[str, int] = {}
+
+    def matching_indices(
+        self,
+        req_ids: Sequence[str],
+        discard_mask: Sequence[bool],
+        all_greedy: bool,
+    ) -> list[int]:
+        if not all_greedy:
+            return []
+        return [
+            index
+            for index, (req_id, discard) in enumerate(zip(req_ids, discard_mask))
+            if not discard and req_id.startswith(self.request_prefix)
+        ]
+
+    def record(
+        self,
+        *,
+        request_id: str,
+        output_index_before_sample: int,
+        batch_index: int,
+        logits_shape: Sequence[int],
+        logits_dtype: str,
+        top_token_ids: Sequence[int],
+        top_logits: Sequence[float],
+        sampled_token_id: int,
+    ) -> None:
+        if self.record_count >= self.max_records:
+            return
+        if len(top_token_ids) != len(top_logits):
+            raise ValueError("top token IDs and logits must have equal lengths")
+        if len(top_token_ids) < 2:
+            raise ValueError("at least two top logits are required")
+
+        if output_index_before_sample == 0:
+            occurrence = self._occurrence_by_request.get(request_id, 0) + 1
+            self._occurrence_by_request[request_id] = occurrence
+        else:
+            occurrence = self._occurrence_by_request.get(request_id)
+            if occurrence is None:
+                raise ValueError("trace occurrence must start at output index zero")
+
+        top_logits_float = [float(value) for value in top_logits]
+        top_ids_int = [int(token_id) for token_id in top_token_ids]
+        margin = top_logits_float[0] - top_logits_float[1]
+        row = {
+            "schema": self.schema,
+            "record_index": self.record_count,
+            "request_id": request_id,
+            "request_occurrence": occurrence,
+            "output_index_before_sample": output_index_before_sample,
+            "batch_index": batch_index,
+            "logits_shape": [int(dim) for dim in logits_shape],
+            "logits_dtype": logits_dtype,
+            "top_token_ids": top_ids_int,
+            "top_logits_float_hex": [value.hex() for value in top_logits_float],
+            "top1_top2_margin_float_hex": margin.hex(),
+            "sampled_token_id": int(sampled_token_id),
+            "sampled_equals_top1": int(sampled_token_id) == top_ids_int[0],
+        }
+        with self.path.open("a", encoding="utf-8") as output:
+            output.write(json.dumps(row, sort_keys=True, allow_nan=False) + "\n")
+        self.record_count += 1
