@@ -4914,9 +4924,56 @@ class GPUModelRunner(
                 scheduler_output, grammar_output, self.input_batch, logits
             )
 
+        greedy_trace_rows = []
+        if self.greedy_decision_trace is not None:
+            sampling_metadata = self.input_batch.sampling_metadata
+            trace_indices = self.greedy_decision_trace.matching_indices(
+                self.input_batch.req_ids,
