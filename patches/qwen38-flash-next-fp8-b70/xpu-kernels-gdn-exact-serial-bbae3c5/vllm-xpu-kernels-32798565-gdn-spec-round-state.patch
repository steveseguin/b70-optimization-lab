From 32798565c66458d5f2718233b03e5429ec6fe2f1 Mon Sep 17 00:00:00 2001
From: steve <punkrawker@gmail.com>
Date: Sat, 12 Sep 2026 00:54:41 -0400
Subject: [PATCH] gdn spec: VLLM_XPU_GDN_SPEC_ROUND_STATE rounds the carried
 SSM state through the cache dtype between verifier rows (exact multi-row
 mode, default off)

---
 csrc/xpu/gdn_attn/gdn_attn_interface.cpp |  8 +++-
 csrc/xpu/gdn_attn/spec_decode.hpp        | 51 ++++++++++++++++++------
 2 files changed, 45 insertions(+), 14 deletions(-)

diff --git a/csrc/xpu/gdn_attn/gdn_attn_interface.cpp b/csrc/xpu/gdn_attn/gdn_attn_interface.cpp
index 0e3790a..b86986d 100644
--- a/csrc/xpu/gdn_attn/gdn_attn_interface.cpp
+++ b/csrc/xpu/gdn_attn/gdn_attn_interface.cpp
@@ -941,6 +941,11 @@ void gdn_attention_spec_decode(
       gdn_env_truthy("VLLM_XPU_GDN_NATIVE_SPEC_COMPLETION_BARRIER");
   const bool persistent_scratch =
       gdn_env_truthy("VLLM_XPU_GDN_SPEC_PERSISTENT_SCRATCH");
+  // Exact multi-row verifier rows in one launch: the spec kernel rounds the
+  // carried SSM state through the cache dtype between tokens, matching the
+  // per-row decode path that vLLM's VLLM_XPU_GDN_SERIAL_SPEC_DECODE runs.
+  const bool spec_round_state_between_tokens =
+      gdn_env_truthy("VLLM_XPU_GDN_SPEC_ROUND_STATE");
   if (native_spec_recurrent_serial_exact) {
     TORCH_CHECK(
         persistent_scratch,
@@ -1235,7 +1240,8 @@ void gdn_attention_spec_decode(
           std::nullopt,                                                   \
           num_spec_decodes,                                               \
           num_actual_tokens,                                              \
-          native_spec_prefix_base_state);                                 \
+          native_spec_prefix_base_state,                                 \
+          spec_round_state_between_tokens);  \
     }                                                                     \
   } while (0)
 
diff --git a/csrc/xpu/gdn_attn/spec_decode.hpp b/csrc/xpu/gdn_attn/spec_decode.hpp
index 0dbadd4..90f43e8 100644
--- a/csrc/xpu/gdn_attn/spec_decode.hpp
+++ b/csrc/xpu/gdn_attn/spec_decode.hpp
@@ -2177,7 +2177,8 @@ struct gated_delta_rule_spec_kernel {
       const int head_k_dim,
       const int num_v_heads,
       const int head_v_dim,
-      const bool prefix_base_state)
+      const bool prefix_base_state,
+      const bool round_state_between_tokens)
       : core_attn_out(core_attn_out),
         q(q),
         k(k),
@@ -2204,7 +2205,8 @@ struct gated_delta_rule_spec_kernel {
         head_k_dim(head_k_dim),
         num_v_heads(num_v_heads),
         head_v_dim(head_v_dim),
-        prefix_base_state(prefix_base_state) {}
+        prefix_base_state(prefix_base_state),
+        round_state_between_tokens(round_state_between_tokens) {}
 
   static inline sycl::nd_range<3> get_nd_range(
       const int batch_size,
@@ -2401,6 +2403,14 @@ struct gated_delta_rule_spec_kernel {
           }
         }
       }
+      if (round_state_between_tokens && t + 1 < seq_end_offset) {
+        for (int j = 0; j < v_dim_per_sg; ++j) {
+          for (int i = 0; i < k_bucket_size; ++i) {
+            state_local[j * k_bucket_size + i] = static_cast<float>(
+                static_cast<StateT>(state_local[j * k_bucket_size + i]));
+          }
+        }
+      }
     }
   }
 
@@ -2432,6 +2442,10 @@ struct gated_delta_rule_spec_kernel {
   const int num_v_heads;
   const int head_v_dim;
   const bool prefix_base_state;
+  // Exact multi-row mode: round the carried state through StateT after every
+  // token that is not the last of its sequence, reproducing the per-row decode
+  // path (which stores the state to the cache between rows) bit for bit.
+  const bool round_state_between_tokens;
 };
 
 template <
@@ -4996,7 +5010,8 @@ void gated_delta_rule_spec_launcher(
     const std::optional<torch::Tensor>& num_accepted_tokens,
     const int num_spec_decodes,
     const int num_actual_tokens,
-    const bool prefix_base_state = false) {
+    const bool prefix_base_state = false,
+    const bool round_state_between_tokens = false) {
   using KERNEL = gated_delta_rule_spec_kernel<T, StateT, k_bucket_size>;
   auto range =
       KERNEL::get_nd_range(num_spec_decodes, v.size(1), v.size(2));
@@ -5031,7 +5046,8 @@ void gated_delta_rule_spec_launcher(
         q.size(2),
         v.size(1),
         v.size(2),
-        prefix_base_state);
+        prefix_base_state,
+          round_state_between_tokens);
     cgh.parallel_for(range, task);
   });
 }
@@ -5054,7 +5070,8 @@ void gated_delta_rule_spec_bucket_dispatch(
     const std::optional<torch::Tensor>& num_accepted_tokens,
     const int num_spec_decodes,
     const int num_actual_tokens,
-    const bool prefix_base_state = false) {
+    const bool prefix_base_state = false,
+    const bool round_state_between_tokens = false) {
   const int k_bucket_size = q.size(2) / 32;
   switch (k_bucket_size) {
     case 1:
@@ -5075,7 +5092,8 @@ void gated_delta_rule_spec_bucket_dispatch(
           num_accepted_tokens,
           num_spec_decodes,
           num_actual_tokens,
-          prefix_base_state);
+          prefix_base_state,
+          round_state_between_tokens);
       break;
     case 2:
       gated_delta_rule_spec_launcher<T, StateT, 2>(
@@ -5095,7 +5113,8 @@ void gated_delta_rule_spec_bucket_dispatch(
           num_accepted_tokens,
           num_spec_decodes,
           num_actual_tokens,
-          prefix_base_state);
+          prefix_base_state,
+          round_state_between_tokens);
       break;
     case 4:
       gated_delta_rule_spec_launcher<T, StateT, 4>(
@@ -5115,7 +5134,8 @@ void gated_delta_rule_spec_bucket_dispatch(
           num_accepted_tokens,
           num_spec_decodes,
           num_actual_tokens,
-          prefix_base_state);
+          prefix_base_state,
+          round_state_between_tokens);
       break;
     case 8:
       gated_delta_rule_spec_launcher<T, StateT, 8>(
@@ -5135,7 +5155,8 @@ void gated_delta_rule_spec_bucket_dispatch(
           num_accepted_tokens,
           num_spec_decodes,
           num_actual_tokens,
-          prefix_base_state);
+          prefix_base_state,
+          round_state_between_tokens);
       break;
     default:
       TORCH_CHECK(false, "Unsupported GDN head_k_dim bucket: ", k_bucket_size);
@@ -5160,7 +5181,8 @@ void gated_delta_rule_spec(
     const std::optional<torch::Tensor>& num_accepted_tokens,
     const int num_spec_decodes,
     const int num_actual_tokens,
-    const bool prefix_base_state = false) {
+    const bool prefix_base_state = false,
+    const bool round_state_between_tokens = false) {
   if (ssm_state.scalar_type() == at::kFloat) {
     gated_delta_rule_spec_bucket_dispatch<T, float>(
         queue,
@@ -5179,7 +5201,8 @@ void gated_delta_rule_spec(
         num_accepted_tokens,
         num_spec_decodes,
         num_actual_tokens,
-        prefix_base_state);
+        prefix_base_state,
+          round_state_between_tokens);
   } else if (ssm_state.scalar_type() == at::kBFloat16) {
     gated_delta_rule_spec_bucket_dispatch<T, sycl::ext::oneapi::bfloat16>(
         queue,
@@ -5198,7 +5221,8 @@ void gated_delta_rule_spec(
         num_accepted_tokens,
         num_spec_decodes,
         num_actual_tokens,
-        prefix_base_state);
+        prefix_base_state,
+          round_state_between_tokens);
   } else if (ssm_state.scalar_type() == at::kHalf) {
     gated_delta_rule_spec_bucket_dispatch<T, sycl::half>(
         queue,
@@ -5217,7 +5241,8 @@ void gated_delta_rule_spec(
         num_accepted_tokens,
         num_spec_decodes,
         num_actual_tokens,
-        prefix_base_state);
+        prefix_base_state,
+          round_state_between_tokens);
   } else {
     TORCH_CHECK(
         false,
