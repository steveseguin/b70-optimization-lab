+def test_unfiltered_safetensors_iterator_skips_filter_bookkeeping(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path,
+) -> None:
+    path = tmp_path / "model.safetensors"
+    save_file({"ordinary": torch.arange(4)}, path)
+
+    class RejectSet(set):
+        def __init__(self, *args, **kwargs):
+            raise AssertionError("ordinary loading must not allocate a filter set")
+
+    monkeypatch.setattr(weight_utils, "set", RejectSet, raising=False)
+
+    loaded = dict(
+        weight_utils.safetensors_weights_iterator(
+            [str(path)],
+            False,
+        )
+    )
+
+    assert set(loaded) == {"ordinary"}
+
