+++ b/tests/model_executor/layers/fused_moe/test_xpu_moe_sync_trace.py
@@ -0,0 +1,44 @@
+from types import SimpleNamespace
+
+import torch
+
+import vllm.envs as envs
+from vllm.model_executor.layers.fused_moe.runner.moe_runner import MoERunner
+
+
+def test_xpu_moe_sync_trace_is_default_off(monkeypatch) -> None:
+    monkeypatch.setattr(envs, "VLLM_XPU_MOE_SYNC_TRACE", False)
+    synchronize_calls = 0
+
+    def synchronize() -> None:
+        nonlocal synchronize_calls
+        synchronize_calls += 1
+
+    monkeypatch.setattr(torch.accelerator, "synchronize", synchronize)
+    runner = SimpleNamespace(layer_name="model.layers.0.mlp.experts")
+
+    MoERunner._xpu_sync_trace(runner, "entry", torch.empty(1, 2))
+
+    assert synchronize_calls == 0
+
+
+def test_xpu_moe_sync_trace_enabled(monkeypatch, caplog) -> None:
+    monkeypatch.setattr(envs, "VLLM_XPU_MOE_SYNC_TRACE", True)
+    synchronize_calls = 0
+
+    def synchronize() -> None:
+        nonlocal synchronize_calls
+        synchronize_calls += 1
+
+    monkeypatch.setattr(torch.accelerator, "synchronize", synchronize)
+    monkeypatch.setattr(torch.xpu, "memory_allocated", lambda: 11)
+    monkeypatch.setattr(torch.xpu, "memory_reserved", lambda: 22)
+    monkeypatch.setattr(torch.xpu, "max_memory_allocated", lambda: 33)
+    runner = SimpleNamespace(layer_name="model.layers.0.mlp.experts")
+
+    with caplog.at_level("WARNING"):
+        MoERunner._xpu_sync_trace(runner, "entry", torch.empty(1, 2))
+
+    assert synchronize_calls == 1
+    assert "phase=entry shape=[1, 2]" in caplog.text
+    assert "allocated_bytes=11 reserved_bytes=22 max_allocated_bytes=33" in caplog.text
