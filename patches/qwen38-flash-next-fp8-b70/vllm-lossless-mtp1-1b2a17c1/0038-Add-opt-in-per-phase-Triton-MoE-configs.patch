-def try_get_optimal_moe_config(
+_MOE_PHASE_CONFIG_KEYS = ("W1_CONFIG", "W2_CONFIG")
+_MOE_PHASE_CONFIG_VALUES = {
+    "BLOCK_SIZE_N": {32, 64, 128, 256},
+    "BLOCK_SIZE_K": {64, 128},
+    "GROUP_SIZE_M": {1, 16, 32, 64},
+    "num_warps": {4, 8},
+    "num_stages": {2, 3, 4, 5},
+}
+
+
+def resolve_moe_gemm_configs(
+    config: dict[str, Any], *, M: int, enable_phase_configs: bool
+) -> tuple[dict[str, int], dict[str, int]]:
+    """Resolve optional per-GEMM deltas without mutating cached config data.
+
+    Expert assignment is shared by both GEMMs, so phase deltas deliberately
+    cannot change ``BLOCK_SIZE_M``. ``SPLIT_K`` is also excluded because the
+    Triton launcher currently forces it to one.
+    """
+    raw = config.copy()
+    phase_configs = {key: raw.pop(key, None) for key in _MOE_PHASE_CONFIG_KEYS}
+    base = raw.copy()
+    if not enable_phase_configs or M != 1:
+        return base, base.copy()
+
+    resolved = []
+    for phase in _MOE_PHASE_CONFIG_KEYS:
+        delta = phase_configs[phase]
+        if delta is None:
+            resolved.append(base.copy())
+            continue
+        if not isinstance(delta, dict):
+            raise ValueError(f"{phase} must be an object")
+        unknown = set(delta) - set(_MOE_PHASE_CONFIG_VALUES)
+        if unknown:
+            raise ValueError(f"{phase} contains unsupported fields: {sorted(unknown)}")
+        phase_config = base.copy()
+        for key, value in delta.items():
+            if type(value) is not int or value not in _MOE_PHASE_CONFIG_VALUES[key]:
+                allowed = sorted(_MOE_PHASE_CONFIG_VALUES[key])
+                raise ValueError(f"{phase}.{key} must be one of {allowed}")
+            phase_config[key] = value
+        resolved.append(phase_config)
+    return resolved[0], resolved[1]
+
+
+def _get_optimal_moe_config_entry(
     w1_shape: tuple[int, ...],
     w2_shape: tuple[int, ...],
     top_k: int,
     dtype: str | None,
     M: int,
     block_shape: list[int] | None = None,
-) -> dict[str, int]:
+) -> dict[str, Any]:
     from vllm.model_executor.layers.fused_moe import get_config
 
     override_config = get_config()
@@ -1451,6 +1497,51 @@ def try_get_optimal_moe_config(
     return config
 
 
+def try_get_optimal_moe_config(
+    w1_shape: tuple[int, ...],
+    w2_shape: tuple[int, ...],
+    top_k: int,
+    dtype: str | None,
+    M: int,
+    block_shape: list[int] | None = None,
+) -> dict[str, int]:
+    config = _get_optimal_moe_config_entry(
+        w1_shape, w2_shape, top_k, dtype, M, block_shape
+    )
+    # Legacy/functional callers retain one flat config even when a modular
+    # XPU experiment supplies opt-in phase deltas in its tuned entry.
+    flat, _ = resolve_moe_gemm_configs(config, M=M, enable_phase_configs=False)
+    return flat
+
+
+def try_get_optimal_moe_gemm_configs(
+    w1_shape: tuple[int, ...],
+    w2_shape: tuple[int, ...],
+    top_k: int,
+    dtype: str | None,
+    M: int,
+    block_shape: list[int] | None = None,
+) -> tuple[dict[str, int], dict[str, int]]:
+    """Return separate static configs for modular w13 and w2 launches.
+
+    The split is opt-in through nested tuned-config deltas and is restricted
+    to the XPU M1 block-FP8 shape. Every other caller receives two copies of
+    the historical flat configuration.
+    """
+    config = _get_optimal_moe_config_entry(
+        w1_shape, w2_shape, top_k, dtype, M, block_shape
+    )
+    enable_phase_configs = (
+        current_platform.is_xpu()
+        and M == 1
+        and dtype == "fp8_w8a8"
+        and block_shape == [128, 128]
+    )
+    return resolve_moe_gemm_configs(
+        config, M=M, enable_phase_configs=enable_phase_configs
+    )
+
+
