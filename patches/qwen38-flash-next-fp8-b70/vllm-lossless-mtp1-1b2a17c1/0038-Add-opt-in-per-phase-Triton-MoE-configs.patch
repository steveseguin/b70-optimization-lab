+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+
+from vllm.model_executor.layers.fused_moe.fused_moe import (
+    resolve_moe_gemm_configs,
+)
+
+BASE = {
+    "BLOCK_SIZE_M": 16,
+    "BLOCK_SIZE_N": 64,
+    "BLOCK_SIZE_K": 128,
+    "GROUP_SIZE_M": 1,
+    "SPLIT_K": 1,
+    "num_warps": 4,
+    "num_stages": 4,
+}
+
+
+def test_flat_config_is_copied_for_both_gemms() -> None:
+    w1, w2 = resolve_moe_gemm_configs(BASE, M=1, enable_phase_configs=True)
+    assert w1 == BASE
+    assert w2 == BASE
+    assert w1 is not w2
+
+
+def test_m1_phase_deltas_merge_without_mutating_source() -> None:
+    source = BASE | {
+        "W1_CONFIG": {"num_warps": 8},
+        "W2_CONFIG": {"BLOCK_SIZE_N": 128, "num_warps": 8},
+    }
+    original = source | {
+        "W1_CONFIG": source["W1_CONFIG"].copy(),
+        "W2_CONFIG": source["W2_CONFIG"].copy(),
+    }
+    w1, w2 = resolve_moe_gemm_configs(source, M=1, enable_phase_configs=True)
+    assert w1 == BASE | {"num_warps": 8}
+    assert w2 == BASE | {"BLOCK_SIZE_N": 128, "num_warps": 8}
+    assert source == original
+
+
+@pytest.mark.parametrize("M", [2, 4, 64])
+def test_non_m1_ignores_phase_deltas(M: int) -> None:
+    source = BASE | {"W1_CONFIG": {"num_warps": 8}}
+    assert resolve_moe_gemm_configs(source, M=M, enable_phase_configs=True) == (
+        BASE,
+        BASE,
+    )
+
+
+@pytest.mark.parametrize(
+    "delta",
+    [
+        {"BLOCK_SIZE_M": 32},
+        {"SPLIT_K": 2},
+        {"BLOCK_SIZE_K": 256},
+        {"num_warps": 2},
+        {"num_stages": True},
+        {"unknown": 1},
+    ],
+)
+def test_unsafe_phase_delta_fails_closed(delta: dict[str, int]) -> None:
+    with pytest.raises(ValueError):
+        resolve_moe_gemm_configs(
+            BASE | {"W2_CONFIG": delta}, M=1, enable_phase_configs=True
+        )
