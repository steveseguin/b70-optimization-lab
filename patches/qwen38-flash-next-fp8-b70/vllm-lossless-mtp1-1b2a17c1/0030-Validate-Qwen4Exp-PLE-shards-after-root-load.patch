+class _CoverageTracker(nn.Module):
+    def __init__(self, events: list[str]) -> None:
+        super().__init__()
+        self.events = events
+
+    def begin_checkpoint_shard_coverage(self) -> None:
+        self.events.append("begin")
+
+    def validate_checkpoint_shard_coverage(self) -> None:
+        self.events.append("validate")
+
+
+def test_root_loader_owns_ple_checkpoint_coverage_lifecycle(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    events: list[str] = []
+    model = qwen4_exp_model.Qwen4ExpForConditionalGeneration.__new__(
+        qwen4_exp_model.Qwen4ExpForConditionalGeneration
+    )
+    nn.Module.__init__(model)
+    model.language_model_only = True
+    model.tracker = _CoverageTracker(events)
+    model.placeholder = nn.Module()
+
+    class _Loader:
+        def __init__(self, *_args, **_kwargs) -> None:
+            events.append("loader_init")
+
+        def load_weights(self, weights, *, mapper):
+            assert list(weights) == [("weight", torch.tensor(1.0))]
+            assert mapper is model.hf_to_vllm_mapper
+            events.append("load")
+            return {"weight"}
+
+    monkeypatch.setattr(qwen4_exp_model, "AutoWeightsLoader", _Loader)
+
+    loaded = model.load_weights(iter([("weight", torch.tensor(1.0))]))
+
+    assert loaded == {"weight"}
+    assert events == ["begin", "loader_init", "load", "validate"]
+
+
+def test_ple_checkpoint_coverage_discovery_ignores_placeholders() -> None:
+    events: list[str] = []
+    model = nn.Module()
+    model.tracker = _CoverageTracker(events)
+    model.placeholder = nn.Module()
+
+    assert qwen4_exp_model._ple_checkpoint_shard_coverage_trackers(model) == (
+        model.tracker,
+    )
