+class _PLECheckpointShardCoverageTracker(Protocol):
+    def begin_checkpoint_shard_coverage(self) -> None: ...
+
+    def validate_checkpoint_shard_coverage(self) -> None: ...
+
+
+def _ple_checkpoint_shard_coverage_trackers(
+    module: nn.Module,
+) -> tuple[_PLECheckpointShardCoverageTracker, ...]:
+    """Find split-PLE loaders that own an explicit coverage lifecycle.
+
+    XPU CPU-offload workers contain the split embedding loader. GPU placeholder
+    modules and the GPU-resident AMD implementation do not, so capability
+    discovery keeps the root load boundary valid for every worker/backend.
+    """
+
+    return tuple(
+        cast(_PLECheckpointShardCoverageTracker, child)
+        for child in module.modules()
+        if callable(getattr(child, "begin_checkpoint_shard_coverage", None))
+        and callable(getattr(child, "validate_checkpoint_shard_coverage", None))
+    )
+
