+    def begin_checkpoint_shard_coverage(self) -> None:
+        """Start one split-checkpoint load session.
+
+        AutoWeightsLoader may deliver one child module in multiple contiguous
+        prefix groups. Coverage therefore persists across ``load_weights``
+        calls and is finalized only by the parent model after its full stream
+        has been consumed.
+        """
+
+        self._observed_checkpoint_shard_indices: set[int] | None = set()
+
+    def validate_checkpoint_shard_coverage(self) -> None:
+        """Fail closed when a split checkpoint load omitted any shard."""
+
+        observed = getattr(self, "_observed_checkpoint_shard_indices", None)
+        if observed is None:
+            return
+        expected = set(range(self.split_ngram_parts))
+        if observed != expected:
+            missing = sorted(expected - observed)
+            unexpected = sorted(observed - expected)
+            raise RuntimeError(
+                "PLE embedding checkpoint shard coverage is incomplete: "
+                f"missing={missing}, unexpected={unexpected}"
+            )
+        self._observed_checkpoint_shard_indices = None
+
     def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
         """Load hash buffers and checkpoint-split embedding rows."""
 
