From 805cde592dfe198a82deaba52894ebfc0e4a4352 Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Wed, 2 Sep 2026 20:48:24 -0400
Subject: [PATCH 41/55] [XPU] Add VLLM_XPU_MKLDNN_DETERMINISTIC worker flag

When set, every XPU worker assigns torch.backends.mkldnn.deterministic=True
in init_device and logs the value. Default off; no other path changes.
Motivation: the Flash-Next TP4 trace (A65) localized run-to-run logit
jitter to a K=10240 BF16 oneDNN GEMM, the family the BF16 census made
exact with this setting.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XfKD1km1ZX1bLGJQ7wdyFR
---
 vllm/envs.py                 | 6 ++++++
 vllm/v1/worker/xpu_worker.py | 8 ++++++++
 2 files changed, 14 insertions(+)

diff --git a/vllm/envs.py b/vllm/envs.py
index f672d28da..4681dcb95 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -321,6 +321,7 @@ if TYPE_CHECKING:
     VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS: bool = True
     VLLM_NIXL_EP_MAX_NUM_RANKS: int = 32
     VLLM_XPU_ENABLE_XPU_GRAPH: bool = False
+    VLLM_XPU_MKLDNN_DETERMINISTIC: bool = False
     VLLM_XPU_USE_SAMPLER_KERNEL: bool = True
     VLLM_XPU_INC_WNA16_BACKEND: Literal["auto", "ark", "w4a16", "w4a8"] = "auto"
     VLLM_LORA_ENABLE_DUAL_STREAM: bool = False
@@ -2141,6 +2142,11 @@ environment_variables: dict[str, Callable[[], Any]] = {
         os.getenv("VLLM_NIXL_EP_MAX_NUM_RANKS", "32")
     ),
     # Whether enable XPU graph on Intel GPU
+    # Ask oneDNN for deterministic primitives in every XPU worker
+    # (torch.backends.mkldnn.deterministic). Off by default.
+    "VLLM_XPU_MKLDNN_DETERMINISTIC": lambda: bool(
+        int(os.getenv("VLLM_XPU_MKLDNN_DETERMINISTIC", "0"))
+    ),
     "VLLM_XPU_ENABLE_XPU_GRAPH": lambda: bool(
         int(os.getenv("VLLM_XPU_ENABLE_XPU_GRAPH", "0"))
     ),
diff --git a/vllm/v1/worker/xpu_worker.py b/vllm/v1/worker/xpu_worker.py
index 95921ffc6..e51bb6d8b 100644
--- a/vllm/v1/worker/xpu_worker.py
+++ b/vllm/v1/worker/xpu_worker.py
@@ -5,6 +5,7 @@ import os
 
 import torch
 
+import vllm.envs as envs
 from vllm.config import VllmConfig
 from vllm.logger import init_logger
 from vllm.platforms import current_platform
@@ -81,6 +82,13 @@ class XPUWorker(Worker):
             self.init_gpu_memory = torch.xpu.get_device_properties(
                 self.local_rank
             ).total_memory
+            if envs.VLLM_XPU_MKLDNN_DETERMINISTIC:
+                torch.backends.mkldnn.deterministic = True
+                logger.info(
+                    "XPU worker rank %d: torch.backends.mkldnn.deterministic=%s",
+                    self.rank,
+                    torch.backends.mkldnn.deterministic,
+                )
         else:
             raise RuntimeError(f"Unsupported device type: {self.device_config.device}")
 
