+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import json
+
+import pytest
+import torch
+
+from vllm.models.qwen4_exp.amd.repeatability_trace import (
+    Qwen4ExpRepeatabilityTrace,
+)
+
+
+def test_trace_is_disabled_without_path(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_FILE", raising=False)
+    trace = Qwen4ExpRepeatabilityTrace()
+    assert not trace.begin(torch.tensor([4095]), rank=0)
+
+
+def test_trace_captures_one_threshold_forward(
+    monkeypatch: pytest.MonkeyPatch, tmp_path
+) -> None:
+    path = tmp_path / "trace-{rank}.json"
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_FILE", str(path))
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_MIN_POSITION", "4000")
+    trace = Qwen4ExpRepeatabilityTrace()
+
+    assert not trace.begin(torch.tensor([0, 3999]), rank=0)
+    assert trace.begin(torch.tensor([4032, 4095]), rank=0)
+    tensor = torch.tensor([[1.0, 2.0]], dtype=torch.bfloat16)
+    trace.record("layer_0_output", hidden_states=tensor, block_output=None)
+    trace.finish()
+
+    report = json.loads((tmp_path / "trace-0.json").read_text())
+    assert report["position_min"] == 4032
+    assert report["position_max"] == 4095
+    assert [record["label"] for record in report["records"]] == [
+        "model_positions",
+        "layer_0_output",
+    ]
+    tensor_record = report["records"][1]["tensors"]["hidden_states"]
+    assert tensor_record["shape"] == [1, 2]
+    assert len(tensor_record["sha256"]) == 64
+    assert not trace.begin(torch.tensor([4096]), rank=0)
+
+
+def test_trace_rank_filter(monkeypatch: pytest.MonkeyPatch, tmp_path) -> None:
+    monkeypatch.setenv(
+        "VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_FILE", str(tmp_path / "trace.json")
+    )
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_RANK", "1")
+    trace = Qwen4ExpRepeatabilityTrace()
+    assert not trace.begin(torch.tensor([4095]), rank=0)
+
+
+def test_trace_accepts_launcher_safe_path_alias(
+    monkeypatch: pytest.MonkeyPatch, tmp_path
+) -> None:
+    monkeypatch.delenv("VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_FILE", raising=False)
+    monkeypatch.setenv("Q38_REPEATABILITY_TRACE_FILE", str(tmp_path / "trace.json"))
+    trace = Qwen4ExpRepeatabilityTrace()
+    assert trace.begin(torch.tensor([4095]), rank=0)
