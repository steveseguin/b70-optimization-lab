+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in, report-only tensor trace for Qwen4Exp late-prefill diagnosis."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+import torch
+
+
+class Qwen4ExpRepeatabilityTrace:
+    """Capture one selected rank's first forward at or beyond a position."""
+
+    def __init__(self) -> None:
+        self.raw_path = os.environ.get(
+            "VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_FILE", ""
+        ) or os.environ.get("Q38_REPEATABILITY_TRACE_FILE", "")
+        self.rank = int(
+            os.environ.get("VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_RANK", "0")
+        )
+        self.min_position = int(
+            os.environ.get(
+                "VLLM_XPU_QWEN4_EXP_REPEATABILITY_TRACE_MIN_POSITION", "4000"
+            )
+        )
+        self.active = False
+        self.complete = False
+        self._records: list[dict[str, object]] = []
+        self._position_min: int | None = None
+        self._position_max: int | None = None
+
+    @staticmethod
+    def tensor_record(tensor: torch.Tensor | None) -> dict[str, object] | None:
+        if tensor is None:
+            return None
+        detached = tensor.detach().contiguous()
+        raw = detached.view(torch.uint8).cpu().numpy().tobytes()
+        head = detached.flatten()[:8].float().cpu().tolist()
+        return {
+            "dtype": str(detached.dtype),
+            "head": head,
+            "numel": detached.numel(),
+            "sha256": hashlib.sha256(raw).hexdigest(),
+            "shape": list(detached.shape),
+        }
+
+    def begin(self, positions: torch.Tensor, rank: int) -> bool:
+        if self.complete or not self.raw_path or rank != self.rank:
+            return False
+        position_min = int(positions.min().item())
+        position_max = int(positions.max().item())
+        if position_max < self.min_position:
+            return False
+        self.active = True
+        self._position_min = position_min
+        self._position_max = position_max
+        self.record("model_positions", positions=positions)
+        return True
+
+    def record(self, label: str, **tensors: torch.Tensor | None) -> None:
+        if not self.active:
+            return
+        self._records.append(
+            {
+                "label": label,
+                "tensors": {
+                    name: self.tensor_record(tensor) for name, tensor in tensors.items()
+                },
+            }
+        )
+
+    def finish(self) -> None:
+        if not self.active:
+            return
+        path = Path(self.raw_path.format(rank=self.rank))
+        path.parent.mkdir(parents=True, exist_ok=True)
+        report = {
+            "min_position_gate": self.min_position,
+            "position_max": self._position_max,
+            "position_min": self._position_min,
+            "rank": self.rank,
+            "records": self._records,
+            "schema_version": 1,
+        }
+        with path.open("x", encoding="utf-8") as handle:
+            json.dump(report, handle, indent=2, sort_keys=True)
+            handle.write("\n")
+        self.active = False
+        self.complete = True
+
+
+__all__ = ["Qwen4ExpRepeatabilityTrace"]
