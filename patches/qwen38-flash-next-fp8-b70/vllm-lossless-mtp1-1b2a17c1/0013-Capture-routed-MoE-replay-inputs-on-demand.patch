 import torch
 
 import vllm.envs as envs
+from vllm.model_executor.layers.fused_moe.runner import moe_runner as moe_runner_module
 from vllm.model_executor.layers.fused_moe.runner.moe_runner import MoERunner
 
 
@@ -42,3 +43,53 @@ def test_xpu_moe_sync_trace_enabled(monkeypatch, caplog) -> None:
     assert synchronize_calls == 1
     assert "phase=entry shape=[1, 2]" in caplog.text
     assert "allocated_bytes=11 reserved_bytes=22 max_allocated_bytes=33" in caplog.text
+
+
+def test_xpu_moe_capture_is_default_off(monkeypatch, tmp_path) -> None:
+    monkeypatch.setattr(envs, "VLLM_XPU_MOE_CAPTURE_DIR", "")
+    runner = SimpleNamespace(_xpu_capture_done=False)
+
+    MoERunner._xpu_capture_routed_inputs(
+        runner,
+        torch.ones(1, 2),
+        torch.ones(1, 1),
+        torch.zeros(1, 1, dtype=torch.int32),
+    )
+
+    assert not list(tmp_path.iterdir())
+
+
+def test_xpu_moe_capture_enabled(monkeypatch, tmp_path) -> None:
+    monkeypatch.setattr(envs, "VLLM_XPU_MOE_CAPTURE_DIR", str(tmp_path))
+    monkeypatch.setattr(torch.accelerator, "synchronize", lambda: None)
+    monkeypatch.setattr(
+        moe_runner_module,
+        "get_world_group",
+        lambda: SimpleNamespace(rank=2, local_rank=3),
+    )
+    runner = SimpleNamespace(
+        _xpu_capture_done=False,
+        layer_name="model.layers.0.mlp.experts",
+        moe_config=SimpleNamespace(ep_rank=2, tp_rank=0),
+        routed_experts=torch.nn.Linear(2, 2, bias=False),
+        _quant_method=SimpleNamespace(moe_kernel=object()),
+    )
+    hidden_states = torch.ones(1, 2)
+    topk_weights = torch.full((1, 1), 0.5)
+    topk_ids = torch.full((1, 1), 7, dtype=torch.int32)
+
+    MoERunner._xpu_capture_routed_inputs(
+        runner, hidden_states, topk_weights, topk_ids
+    )
+
+    files = list(tmp_path.glob("*.pt"))
+    assert len(files) == 1
+    assert files[0].name.startswith("routed-input-r2-lr3-")
+    assert not list(tmp_path.glob("*.tmp"))
+    payload = torch.load(files[0], weights_only=True)
+    assert torch.equal(payload["inputs"]["hidden_states"]["value"], hidden_states)
+    assert torch.equal(payload["inputs"]["topk_weights"]["value"], topk_weights)
+    assert torch.equal(payload["inputs"]["topk_ids"]["value"], topk_ids)
+    assert payload["ep_rank"] == 2
+    assert payload["parameter_metadata"]["weight"]["shape"] == [2, 2]
+    assert runner._xpu_capture_done
