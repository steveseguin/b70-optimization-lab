+    @staticmethod
+    def _tensor_metadata(value: torch.Tensor) -> dict[str, object]:
+        storage = value.untyped_storage()
+        return {
+            "shape": list(value.shape),
+            "stride": list(value.stride()),
+            "dtype": str(value.dtype),
+            "device": str(value.device),
+            "layout": str(value.layout),
+            "numel": value.numel(),
+            "element_size": value.element_size(),
+            "data_ptr": value.data_ptr(),
+            "storage_ptr": storage.data_ptr(),
+            "storage_offset": value.storage_offset(),
+            "storage_nbytes": storage.nbytes(),
+            "contiguous": value.is_contiguous(),
+            "ptr_mod_16": value.data_ptr() % 16,
+            "ptr_mod_64": value.data_ptr() % 64,
+            "ptr_mod_4096": value.data_ptr() % 4096,
+        }
+
+    def _xpu_capture_routed_inputs(
+        self,
+        hidden_states: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> None:
+        capture_dir = envs.VLLM_XPU_MOE_CAPTURE_DIR
+        if not capture_dir or self._xpu_capture_done:
+            return
+        torch.accelerator.synchronize()
+        root = Path(capture_dir)
+        root.mkdir(parents=True, exist_ok=True)
+        world = get_world_group()
+        layer_slug = re.sub(r"[^A-Za-z0-9_.-]+", "_", self.layer_name)
+        destination = root / (
+            f"routed-input-r{world.rank}-lr{world.local_rank}-p{os.getpid()}-"
+            f"{layer_slug}.pt"
+        )
+        temporary = destination.with_suffix(".tmp")
+        parameters = {
+            name: MoERunner._tensor_metadata(parameter)
+            for name, parameter in self.routed_experts.named_parameters(
+                remove_duplicate=False
+            )
+        }
+        buffers = {
+            name: MoERunner._tensor_metadata(buffer)
+            for name, buffer in self.routed_experts.named_buffers(
+                remove_duplicate=False
+            )
+        }
+        routing_names = {
+            "_expert_map",
+            "expert_mask",
+            "expert_global_to_physical",
+            "expert_physical_to_global",
+        }
+        routing_tensors = {
+            name: buffer.detach().to("cpu", copy=True)
+            for name, buffer in self.routed_experts.named_buffers(
+                remove_duplicate=False
+            )
+            if name.rsplit(".", 1)[-1] in routing_names
+        }
+        payload = {
+            "format_version": 1,
+            "layer_name": self.layer_name,
+            "rank": world.rank,
+            "local_rank": world.local_rank,
+            "pid": os.getpid(),
+            "ep_rank": self.moe_config.ep_rank,
+            "tp_rank": self.moe_config.tp_rank,
+            "quant_method": type(self._quant_method).__qualname__,
+            "moe_kernel": type(
+                getattr(self._quant_method, "moe_kernel", None)
+            ).__qualname__,
+            "inputs": {
+                "hidden_states": {
+                    "value": hidden_states.detach().to("cpu", copy=True),
+                    "source": MoERunner._tensor_metadata(hidden_states),
+                },
+                "topk_weights": {
+                    "value": topk_weights.detach().to("cpu", copy=True),
+                    "source": MoERunner._tensor_metadata(topk_weights),
+                },
+                "topk_ids": {
+                    "value": topk_ids.detach().to("cpu", copy=True),
+                    "source": MoERunner._tensor_metadata(topk_ids),
+                },
+            },
+            "parameter_metadata": parameters,
+            "buffer_metadata": buffers,
+            "routing_tensors": routing_tensors,
+        }
+        with temporary.open("wb") as output:
+            torch.save(payload, output)
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temporary, destination)
+        self._xpu_capture_done = True
+        logger.warning("Captured XPU routed MoE inputs at %s", destination)
+
     def _apply_quant_method(
         self,
         hidden_states: torch.Tensor,
