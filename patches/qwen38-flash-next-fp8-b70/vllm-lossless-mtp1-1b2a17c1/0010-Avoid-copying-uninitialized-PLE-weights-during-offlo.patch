diff --git a/vllm/model_executor/offloader/uva.py b/vllm/model_executor/offloader/uva.py
index 5107870ff..ab22f8cd5 100644
--- a/vllm/model_executor/offloader/uva.py
+++ b/vllm/model_executor/offloader/uva.py
@@ -68,6 +68,25 @@ class UVAOffloader(BaseOffloader):
             )
         return modules
 
+    def _make_cpu_data(self, p: nn.Parameter) -> torch.Tensor:
+        if getattr(p, "_vllm_offload_discard_initial_data", False):
+            # Some checkpoint-backed parameters are intentionally created with
+            # uninitialized accelerator storage.  Copying those bytes to the
+            # host is both unnecessary and, for very large tables, can dominate
+            # model startup.  The model must opt in explicitly and guarantee
+            # that checkpoint loading fills every row that can be read before
+            # the first forward pass.
+            return torch.empty_like(
+                p.data,
+                device="cpu",
+                pin_memory=self.pin_memory,
+            )
+
+        cpu_data = p.data.to(device="cpu")
+        if self.pin_memory:
+            cpu_data = cpu_data.pin_memory()
+        return cpu_data
+
     def _maybe_offload_to_cpu(self, module: nn.Module, prefix: str = "") -> nn.Module:
         """Offload module parameters to CPU using UVA if budget allows."""
         if (params := next(module.parameters(), None)) is None:
@@ -108,9 +127,7 @@ class UVAOffloader(BaseOffloader):
                 if not should_offload:
                     continue
 
-            cpu_data = p.data.to(device="cpu")
-            if self.pin_memory:
-                cpu_data = cpu_data.pin_memory()
+            cpu_data = self._make_cpu_data(p)
 
             if not self.uva_offloading:
                 p.data = cpu_data
