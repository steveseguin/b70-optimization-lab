--- a/tests/basic_correctness/test_cpu_offload.py
+++ b/tests/basic_correctness/test_cpu_offload.py
@@ -4,6 +4,7 @@
 from operator import attrgetter
 
 import pytest
+import torch
 import torch.nn as nn
 
 import vllm.envs as envs
@@ -91,6 +92,41 @@ def _is_offloaded(p: nn.Parameter) -> bool:
     return p.device.type == "cpu" or getattr(p, "_vllm_is_uva_offloaded", False)
 
 
+def test_uva_discard_initial_data_is_explicit(monkeypatch):
+    """Only opted-in checkpoint parameters may skip the initial data copy."""
+    offloader = UVAOffloader.__new__(UVAOffloader)
+    offloader.pin_memory = False
+    offloader.uva_offloading = False
+    offloader.cpu_offload_max_bytes = 1024
+    offloader.cpu_offload_bytes = 0
+    offloader.cpu_offload_params = set()
+
+    ordinary = nn.Linear(2, 2, bias=False)
+    ordinary.weight.data.fill_(7)
+    ordinary_cpu_data = offloader._make_cpu_data(ordinary.weight)
+    assert torch.equal(ordinary_cpu_data, torch.full((2, 2), 7.0))
+
+    discarded = nn.Linear(2, 2, bias=False)
+    discarded.weight._vllm_offload_discard_initial_data = True
+    empty_like = torch.empty_like
+    calls = []
+
+    def record_empty_like(input_, **kwargs):
+        calls.append((input_.shape, kwargs))
+        return empty_like(input_, **kwargs)
+
+    monkeypatch.setattr(torch, "empty_like", record_empty_like)
+    discarded_cpu_data = offloader._make_cpu_data(discarded.weight)
+
+    assert calls == [
+        (
+            torch.Size([2, 2]),
+            {"device": "cpu", "pin_memory": False},
+        )
+    ]
+    assert discarded_cpu_data.device.type == "cpu"
+
+
 @pytest.mark.parametrize("disable_uva", [False, True])
 def test_tower_weight_offloading(vllm_runner, monkeypatch, disable_uva):
     """`cpu_offload_params` segments must reach towers built outside make_layers.
