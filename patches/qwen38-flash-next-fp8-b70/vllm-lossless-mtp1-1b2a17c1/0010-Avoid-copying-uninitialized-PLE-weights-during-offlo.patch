@@ -289,6 +289,11 @@ class Qwen4ExpNGramEmbedding(PleOffloadLayer):
                 quant_config, f"{prefix}.ngram_embedding"
             ),
         )
+        # The checkpoint shards fill every non-padding row before the first
+        # lookup.  Let selective UVA offload allocate fresh host storage instead
+        # of copying this enormous, still-uninitialized table from the
+        # accelerator during construction.  Padding rows are never addressable.
+        self.ngram_embedding.weight._vllm_offload_discard_initial_data = True
         self.register_buffer(
             "positions_buffer",
             torch.arange(max_total_tokens, dtype=torch.int64),
