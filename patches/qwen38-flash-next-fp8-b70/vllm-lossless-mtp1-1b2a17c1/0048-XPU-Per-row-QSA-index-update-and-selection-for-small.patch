From 2ebbf2a61f0e3ef0b3036f59b5aec47489c8e6f6 Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Thu, 3 Sep 2026 13:23:43 -0400
Subject: [PATCH 48/55] [XPU] Per-row QSA index update and selection for small
 multi-row batches behind VLLM_XPU_QSA_SERIAL_SPEC_INDEXER

In a multi-row step (the MTP verification step) rows in the same
compression group race for one compressed slot and an earlier row's
selection can see a later row's key; sequential decode never does. With
the flag, batches of 2-8 rows from one request are compressed, stored and
scored one row at a time with the sequence length rolled back per row.
Off by default; no other path changes.
---
 vllm/envs.py                             |  7 +++
 vllm/models/qwen4_exp/amd/indexer_qsa.py | 70 ++++++++++++++++++++++++
 2 files changed, 77 insertions(+)

diff --git a/vllm/envs.py b/vllm/envs.py
index e3b20f3c1..f195ae9e8 100755
--- a/vllm/envs.py
+++ b/vllm/envs.py
@@ -323,6 +323,7 @@ if TYPE_CHECKING:
     VLLM_XPU_ENABLE_XPU_GRAPH: bool = False
     VLLM_XPU_MKLDNN_DETERMINISTIC: bool = False
     VLLM_XPU_FA_SERIAL_SPEC_DECODE: bool = False
+    VLLM_XPU_QSA_SERIAL_SPEC_INDEXER: bool = False
     VLLM_XPU_USE_SAMPLER_KERNEL: bool = True
     VLLM_XPU_INC_WNA16_BACKEND: Literal["auto", "ark", "w4a16", "w4a8"] = "auto"
     VLLM_LORA_ENABLE_DUAL_STREAM: bool = False
@@ -2154,6 +2155,12 @@ environment_variables: dict[str, Callable[[], Any]] = {
     "VLLM_XPU_FA_SERIAL_SPEC_DECODE": lambda: bool(
         int(os.getenv("VLLM_XPU_FA_SERIAL_SPEC_DECODE", "0"))
     ),
+    # Update and select the QSA index one row at a time for small multi-row
+    # batches (the MTP verification step) on XPU, so each verifier row sees
+    # exactly the side-cache state single-row decode would. Off by default.
+    "VLLM_XPU_QSA_SERIAL_SPEC_INDEXER": lambda: bool(
+        int(os.getenv("VLLM_XPU_QSA_SERIAL_SPEC_INDEXER", "0"))
+    ),
     "VLLM_XPU_ENABLE_XPU_GRAPH": lambda: bool(
         int(os.getenv("VLLM_XPU_ENABLE_XPU_GRAPH", "0"))
     ),
diff --git a/vllm/models/qwen4_exp/amd/indexer_qsa.py b/vllm/models/qwen4_exp/amd/indexer_qsa.py
index 684d3dfd9..c3d54d7dc 100644
--- a/vllm/models/qwen4_exp/amd/indexer_qsa.py
+++ b/vllm/models/qwen4_exp/amd/indexer_qsa.py
