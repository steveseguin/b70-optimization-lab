 from vllm.forward_context import get_forward_context
 from vllm.model_executor.layers.layernorm import GemmaRMSNorm
 from vllm.model_executor.layers.linear import ReplicatedLinear
@@ -71,6 +74,10 @@ def apply_qsa_rmsnorm(
     return cast(torch.Tensor, norm(tensor))
 
 
+logger = init_logger(__name__)
+_SERIAL_SPEC_INDEXER_MAX_ROWS = 8
+
+
 class QSAIndexer(nn.Module):
     """Replicated Q/K projection plus paged, weight-free QSA selection.
 
@@ -277,6 +284,60 @@ class QSAIndexer(nn.Module):
             out,
         )
 
+    def _forward_serial_rows(
+        self,
+        q: torch.Tensor,
+        token_k: torch.Tensor,
+        positions: torch.Tensor,
+        raw_metadata: QSAForwardMetadata,
+        compressed_metadata: QSAForwardMetadata,
+        out: torch.Tensor | None,
+    ) -> torch.Tensor:
+        """Update the side caches and select one row at a time.
+
+        In a multi-row step (the MTP verification step) rows that fall in the
+        same compression group race for one compressed slot, and an earlier
+        row's selection can see a later row's key. Sequential decode never
+        does that, so with VLLM_XPU_QSA_SERIAL_SPEC_INDEXER each row is
+        compressed, stored and scored exactly as its own decode step would
+        be, with the request's sequence length rolled back to that row.
+        """
+        num_tokens = raw_metadata.num_actual_tokens
+        device = raw_metadata.query_start_loc.device
+        single_start = torch.tensor(
+            [0, 1], dtype=raw_metadata.query_start_loc.dtype, device=device
+        )
+        result = out
+        if result is None:
+            result = torch.empty(
+                (num_tokens, self.output_width), dtype=torch.int32, device=q.device
+            )
+
+        def row_view(meta: QSAForwardMetadata, i: int) -> QSAForwardMetadata:
+            back = num_tokens - 1 - i
+            return dataclasses.replace(
+                meta,
+                slot_mapping=meta.slot_mapping[i : i + 1],
+                token_to_req=meta.token_to_req[i : i + 1],
+                logical_positions=meta.logical_positions[i : i + 1],
+                query_start_loc=single_start,
+                seq_lens=meta.seq_lens - back,
+                num_actual_tokens=1,
+            )
+
+        for i in range(num_tokens):
+            raw_i = row_view(raw_metadata, i)
+            compressed_i = row_view(compressed_metadata, i)
+            self._update_and_compress(
+                token_k[i : i + 1], positions[..., i : i + 1], raw_i, compressed_i
+            )
+            self._select(q[i : i + 1], compressed_i, result[i : i + 1])
+        logger.warning_once(
+            "VLLM_XPU_QSA_SERIAL_SPEC_INDEXER reached for %d-row batches",
+            num_tokens,
+        )
+        return result
+
     def forward(
         self,
         hidden_states: torch.Tensor,
@@ -305,6 +366,15 @@ class QSAIndexer(nn.Module):
         q, token_k = self.project_qk(
             hidden_states[:num_tokens], positions[..., :num_tokens]
         )
+        if (
+            envs.VLLM_XPU_QSA_SERIAL_SPEC_INDEXER
+            and not self.skip_topk
+            and 1 < num_tokens <= _SERIAL_SPEC_INDEXER_MAX_ROWS
+            and raw_metadata.query_start_loc.numel() == 2
+        ):
+            return self._forward_serial_rows(
+                q, token_k, positions, raw_metadata, compressed_metadata, out
+            )
