Subject: [PATCH 04/55] Enable Qwen4Exp model dispatch on XPU

---
 tests/models/qwen4_exp/test_xpu.py | 23 +++++++++++++++++++++++
 vllm/models/qwen4_exp/__init__.py  |  6 +++---
 vllm/models/qwen4_exp/amd/model.py |  9 ++++++++-
 3 files changed, 34 insertions(+), 4 deletions(-)
 create mode 100644 tests/models/qwen4_exp/test_xpu.py

diff --git a/tests/models/qwen4_exp/test_xpu.py b/tests/models/qwen4_exp/test_xpu.py
new file mode 100644
index 000000000..63e87a896
--- /dev/null
+++ b/tests/models/qwen4_exp/test_xpu.py
@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+
+from vllm.platforms import current_platform
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_xpu(),
+    reason="Qwen4Exp XPU dispatch requires XPU",
+)
+
+
+def test_xpu_package_exports_model_with_offload_ple() -> None:
+    from vllm.models.qwen4_exp import (
+        Qwen4ExpForCausalLM,
+        Qwen4ExpForConditionalGeneration,
+    )
+    from vllm.models.qwen4_exp.amd import model as model_module
+
+    assert Qwen4ExpForCausalLM.__module__.endswith(".amd.model")
+    assert Qwen4ExpForConditionalGeneration.__module__.endswith(".amd.model")
+    assert model_module.Qwen4ExpPLELayer.__module__.endswith(".nvidia.ple_layer")
diff --git a/vllm/models/qwen4_exp/__init__.py b/vllm/models/qwen4_exp/__init__.py
index 9e533e28b..63a44e944 100644
--- a/vllm/models/qwen4_exp/__init__.py
+++ b/vllm/models/qwen4_exp/__init__.py
@@ -27,9 +27,9 @@ def __getattr__(name: str) -> Any:
     }:
         from vllm.platforms import current_platform
 
-        if current_platform.is_xpu() or current_platform.is_tpu():
-            raise NotImplementedError("Qwen4Exp currently supports CUDA and ROCm only")
-        if current_platform.is_rocm():
+        if current_platform.is_tpu():
+            raise NotImplementedError("Qwen4Exp does not currently support TPU")
+        if current_platform.is_rocm() or current_platform.is_xpu():
             from .amd.model import (
                 Qwen4ExpForCausalLM,
                 Qwen4ExpForConditionalGeneration,
diff --git a/vllm/models/qwen4_exp/amd/model.py b/vllm/models/qwen4_exp/amd/model.py
index 6ae206df1..3a979e607 100644
--- a/vllm/models/qwen4_exp/amd/model.py
