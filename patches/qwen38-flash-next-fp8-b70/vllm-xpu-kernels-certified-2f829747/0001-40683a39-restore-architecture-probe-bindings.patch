From 40683a39dbe9ef9db42f1432e243c52b98889531 Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Wed, 26 Aug 2026 18:04:25 -0400
Subject: [PATCH] fix(xpu): restore architecture probe bindings

Signed-off-by: Codex Agent <codex-agent@users.noreply.github.com>
---
 csrc/xpu/ops.h              |  4 ++++
 csrc/xpu/torch_bindings.cpp |  6 ++++++
 csrc/xpu/utils.cpp          | 10 ++++++++++
 3 files changed, 20 insertions(+)

diff --git a/csrc/xpu/ops.h b/csrc/xpu/ops.h
index 50abf8a..c0666f1 100644
--- a/csrc/xpu/ops.h
+++ b/csrc/xpu/ops.h
@@ -459,6 +459,10 @@ bool is_bmg(int64_t device_index);
 
 bool is_pvc(int64_t device_index);
 
+bool is_xe2_arch(int64_t device_index);
+
+bool is_xe3_arch(int64_t device_index);
+
 void kv_cache_copy_slots(
     torch::Tensor& kv_cache,
     const torch::Tensor& source_slots,
diff --git a/csrc/xpu/torch_bindings.cpp b/csrc/xpu/torch_bindings.cpp
index 2cfc1a2..e0fdce3 100644
--- a/csrc/xpu/torch_bindings.cpp
+++ b/csrc/xpu/torch_bindings.cpp
@@ -364,6 +364,12 @@ TORCH_LIBRARY_EXPAND(TORCH_EXTENSION_NAME, xpu_ops) {
   xpu_ops.def("is_pvc(int device_index) -> bool");
   xpu_ops.impl("is_pvc", &is_pvc);
 
+  xpu_ops.def("is_xe2_arch(int device_index=-1) -> bool");
+  xpu_ops.impl("is_xe2_arch", &is_xe2_arch);
+
+  xpu_ops.def("is_xe3_arch(int device_index=-1) -> bool");
+  xpu_ops.impl("is_xe3_arch", &is_xe3_arch);
+
   xpu_ops.def(
       "kv_cache_copy_slots(Tensor! kv_cache, Tensor source_slots, Tensor "
       "destination_slots) -> ()");
diff --git a/csrc/xpu/utils.cpp b/csrc/xpu/utils.cpp
index c5406ae..77dbd17 100644
--- a/csrc/xpu/utils.cpp
+++ b/csrc/xpu/utils.cpp
@@ -17,6 +17,16 @@ bool is_pvc(int64_t device_index = -1) {
   return vllm::xpu::is_pvc(dev_idx);
 }
 
+bool is_xe2_arch(int64_t device_index = -1) {
+  at::DeviceIndex dev_idx = device_index;
+  return vllm::xpu::is_xe2_arch(dev_idx);
+}
+
+bool is_xe3_arch(int64_t device_index = -1) {
+  at::DeviceIndex dev_idx = device_index;
+  return vllm::xpu::is_xe3_arch(dev_idx);
+}
+
 void kv_cache_copy_slots(
     torch::Tensor& kv_cache,
     const torch::Tensor& source_slots,
