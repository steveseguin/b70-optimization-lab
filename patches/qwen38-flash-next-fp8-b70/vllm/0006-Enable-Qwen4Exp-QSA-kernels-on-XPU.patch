+def test_xpu_qsa_index_and_sparse_attention_match_reference() -> None:
+    torch.manual_seed(7)
+    device = torch.device("xpu")
+    rows, query_heads, kv_heads, head_dim, page_size = 2, 6, 1, 256, 16
+    q = torch.randn(
+        rows,
+        query_heads,
+        head_dim,
+        dtype=torch.bfloat16,
+        device=device,
+    )
+    kv = torch.randn(
+        8,
+        page_size,
+        kv_heads,
+        2 * head_dim,
+        dtype=torch.bfloat16,
+        device=device,
+    )
+    k_cache, v_cache = kv.split(head_dim, dim=-1)
+    block_table = torch.tensor(
+        [[0, 1, 2, 3], [4, 5, 6, 7]],
+        dtype=torch.int32,
+        device=device,
+    )
+    token_to_req = torch.tensor([0, 1], dtype=torch.int32, device=device)
+    block_indices = torch.tensor([[0, 1], [0, 1]], dtype=torch.int32, device=device)
+    positions = torch.tensor([11, 11], dtype=torch.int64, device=device)
+    sequence_lengths = torch.tensor([12, 12], dtype=torch.int32, device=device)
+    logical_indices = expand_qsa_block_indices_cuda(
+        block_indices,
+        positions,
+        sequence_lengths,
+        token_to_req,
+        compress_ratio=4,
+        token_topk=8,
+    )
+    actual = qsa_sparse_paged_attention(
+        q,
+        k_cache,
+        v_cache,
+        logical_indices,
+        block_table,
+        token_to_req,
+    )
+
+    expected = torch.zeros_like(q)
+    repeats = query_heads // kv_heads
+    for row in range(rows):
+        selected = logical_indices[row]
+        selected = selected[selected >= 0].long()
+        request = token_to_req[row].long()
+        pages = block_table[request, selected // page_size].long()
+        offsets = selected % page_size
+        keys = k_cache[pages, offsets].repeat_interleave(repeats, dim=1)
+        values = v_cache[pages, offsets].repeat_interleave(repeats, dim=1)
+        scores = torch.einsum("hd,khd->hk", q[row].float(), keys.float())
+        probabilities = torch.softmax(scores * head_dim**-0.5, dim=-1)
+        expected[row] = torch.einsum("hk,khd->hd", probabilities, values.float()).to(
+            q.dtype
+        )
+
+    torch.testing.assert_close(actual, expected, rtol=2e-2, atol=2e-2)
+
+
+def test_xpu_qsa_paged_scoring_matches_reference() -> None:
+    torch.manual_seed(11)
+    device = torch.device("xpu")
+    rows, heads, head_dim, page_size = 2, 4, 128, 8
+    q = torch.randn(rows, heads, head_dim, dtype=torch.bfloat16, device=device)
+    cache = torch.randn(8, page_size, 1, head_dim, dtype=torch.bfloat16, device=device)
+    page_table = torch.tensor(
+        [[0, 1, 2, 3], [4, 5, 6, 7]],
+        dtype=torch.int32,
+        device=device,
+    )
+    token_to_req = torch.tensor([0, 1], dtype=torch.int32, device=device)
+    positions = torch.tensor([31, 31], dtype=torch.int32, device=device)
+    sequence_lengths = torch.tensor([32, 32], dtype=torch.int32, device=device)
+
+    actual, visible = qsa_mqa_paged(
+        q,
+        cache,
+        page_table,
+        token_to_req,
+        positions,
+        sequence_lengths,
+        compress_ratio=4,
+    )
+    expected = torch.full_like(actual, -float("inf"))
+    for row in range(rows):
+        request = int(token_to_req[row].item())
+        num_visible = min(
+            (int(positions[row].item()) + 1) // 4,
+            int(sequence_lengths[request].item()) // 4,
+        )
+        for column in range(num_visible):
+            key = cache[
+                page_table[request, column // page_size].long(),
+                column % page_size,
+                0,
+            ]
+            score = sum(
+                max(float(torch.dot(q[row, head].float(), key.float()).item()), 0.0)
+                for head in range(heads)
+            )
+            expected[row, column] = score / head_dim**0.5
+
+    assert visible.tolist() == [8, 8]
+    assert torch.equal(torch.isfinite(actual), torch.isfinite(expected))
+    finite = torch.isfinite(expected)
+    torch.testing.assert_close(actual[finite], expected[finite], rtol=2e-2, atol=2e-2)
