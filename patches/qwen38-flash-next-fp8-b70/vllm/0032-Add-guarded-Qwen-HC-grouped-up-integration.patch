+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+import vllm.envs as envs
+from vllm.config.compilation import CompilationMode, CUDAGraphMode
+from vllm.model_executor.layers.linear import UnquantizedLinearMethod
+from vllm.model_executor.model_loader.reload.layerwise import (
+    finalize_layerwise_reload,
+    initialize_layerwise_reload,
+    record_metadata_for_reloading,
+)
+from vllm.models.qwen4_exp.amd import low_latency_gemm
+from vllm.models.qwen4_exp.amd.hyperconnection import (
+    GatedResidual,
+    HyperConnectionConfig,
+)
+
+
+def test_grouped_up_env_defaults_off(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.delenv("VLLM_XPU_QWEN4_EXP_HC_GROUPED_UP", raising=False)
+    assert envs.VLLM_XPU_QWEN4_EXP_HC_GROUPED_UP is False
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_HC_GROUPED_UP", "1")
+    assert envs.VLLM_XPU_QWEN4_EXP_HC_GROUPED_UP is True
+
+
+def test_grouped_up_disabled_does_not_inspect_model(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.delenv("VLLM_XPU_QWEN4_EXP_HC_GROUPED_UP", raising=False)
+    low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+        object(), torch.float32, object()
+    )
+
+
+def _fake_vllm_config() -> SimpleNamespace:
+    return SimpleNamespace(
+        speculative_config=None,
+        lora_config=None,
+        parallel_config=SimpleNamespace(
+            tensor_parallel_size=4,
+            pipeline_parallel_size=1,
+        ),
+        compilation_config=SimpleNamespace(
+            mode=CompilationMode.NONE,
+            cudagraph_mode=CUDAGraphMode.NONE,
+        ),
+        offload_config=SimpleNamespace(
+            offload_backend="uva",
+            uva=SimpleNamespace(
+                cpu_offload_gb=12.0,
+                cpu_offload_params={"ple_embedding.ngram_embedding.weight"},
+            ),
+            prefetch=SimpleNamespace(offload_group_size=0),
+        ),
+        model_config=SimpleNamespace(
+            hf_text_config=SimpleNamespace(
+                num_hidden_layers=48,
+                hidden_size=2560,
+                hc_count=4,
+                hc_lowrank=320,
+            )
+        ),
+    )
+
+
+def test_grouped_up_selects_exact_97_and_rejects_draft(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    class FakeLinear(nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.quant_method = UnquantizedLinearMethod()
+
+    class FakeGatedResidual(nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.input_mix_weight_up = FakeLinear()
+
+    class FakeLayer(nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.attn_hyper_connection = FakeGatedResidual()
+            self.mlp_hyper_connection = FakeGatedResidual()
+
+    class FakeModel(nn.Module):
+        def __init__(self) -> None:
+            super().__init__()
+            self.layers = nn.ModuleList([FakeLayer() for _ in range(48)])
+            self.hyper_connection_mixer = FakeGatedResidual()
+
+    Qwen4ExpForCausalLM = type(
+        "Qwen4ExpForCausalLM",
+        (nn.Module,),
+        {"__init__": lambda self: nn.Module.__init__(self)},
+    )
+    target = Qwen4ExpForCausalLM()
+    target.model = FakeModel()
+
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_HC_GROUPED_UP", "1")
+    monkeypatch.setattr(low_latency_gemm, "GatedResidual", FakeGatedResidual)
+    monkeypatch.setattr(low_latency_gemm.current_platform, "is_xpu", lambda: True)
+    monkeypatch.setattr(
+        torch.ops._xpu_C,
+        "cutlass_grouped_gemm_interface",
+        lambda *args: args[4],
+        raising=False,
+    )
+
+    graph_config = _fake_vllm_config()
+    graph_config.compilation_config.cudagraph_mode = CUDAGraphMode.FULL
+    with pytest.raises(RuntimeError, match="fully eager"):
+        low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+            target, torch.bfloat16, graph_config
+        )
+
+    lora_config = _fake_vllm_config()
+    lora_config.lora_config = object()
+    with pytest.raises(RuntimeError, match="does not support LoRA"):
+        low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+            target, torch.bfloat16, lora_config
+        )
+
+    pp_config = _fake_vllm_config()
+    pp_config.parallel_config.pipeline_parallel_size = 2
+    with pytest.raises(RuntimeError, match="TP4 and PP1"):
+        low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+            target, torch.bfloat16, pp_config
+        )
+
+    mtp_config = _fake_vllm_config()
+    mtp_config.speculative_config = object()
+    with pytest.raises(RuntimeError, match="MTP0-only"):
+        low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+            target, torch.bfloat16, mtp_config
+        )
+
+    broad_offload_config = _fake_vllm_config()
+    broad_offload_config.offload_config.uva.cpu_offload_params = set()
+    with pytest.raises(RuntimeError, match="selective PLE-only"):
+        low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+            target, torch.bfloat16, broad_offload_config
+        )
+
+    low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+        target, torch.bfloat16, _fake_vllm_config()
+    )
+    methods = [
+        child.quant_method
+        for child in target.modules()
+        if isinstance(child, FakeLinear)
+    ]
+    assert len(methods) == 97
+    assert all(
+        isinstance(method, low_latency_gemm.Qwen4ExpXPUGroupedUpLinearMethod)
+        for method in methods
+    )
+
+    Qwen4ExpMTP = type(
+        "Qwen4ExpMTP",
+        (nn.Module,),
+        {"__init__": lambda self: nn.Module.__init__(self)},
+    )
+    with pytest.raises(RuntimeError, match="target-model-only"):
+        low_latency_gemm.enable_qwen4_exp_low_latency_gemm(
+            Qwen4ExpMTP(), torch.bfloat16, _fake_vllm_config()
+        )
+
+
+@pytest.mark.skipif(
+    not torch.xpu.is_available(),
+    reason="requires one XPU",
+)
+def test_grouped_up_shared_storage_exact_fallback_and_reload(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(
+        "vllm.model_executor.parameter.get_tensor_model_parallel_rank", lambda: 0
+    )
+    monkeypatch.setattr(
+        "vllm.model_executor.parameter.get_tensor_model_parallel_world_size",
+        lambda: 1,
+    )
+    monkeypatch.setattr(
+        "vllm.model_executor.layers.linear.get_tensor_model_parallel_rank", lambda: 0
+    )
+    monkeypatch.setattr(
+        "vllm.model_executor.layers.linear.get_tensor_model_parallel_world_size",
+        lambda: 1,
+    )
+
+    def grouped_gemm(
+        input_value,
+        packed_weight,
+        scales,
+        bias,
+        output,
+        rows,
+        n,
+        k,
+        experts,
+        is_int4,
+        is_mxfp4,
+    ):
+        assert scales is None and bias is None
+        assert rows.shape == (1,) and rows.dtype == torch.int32
+        assert (n, k, experts, is_int4, is_mxfp4) == (
+            10240,
+            320,
+            1,
+            False,
+            False,
+        )
+        output.copy_(input_value @ packed_weight[0])
+        return output
+
+    monkeypatch.setattr(
+        torch.ops._xpu_C,
+        "cutlass_grouped_gemm_interface",
+        grouped_gemm,
+        raising=False,
+    )
+    config = HyperConnectionConfig(
+        hc_count=4,
+        hidden_size=2560,
+        params_dtype=torch.bfloat16,
+        hc_lowrank=320,
+        rms_norm_eps=1e-6,
+        hc_per_branch_norm=True,
+    )
+    module = GatedResidual(config).to("xpu")
+    linear = module.input_mix_weight_up
+    method = low_latency_gemm.Qwen4ExpXPUGroupedUpLinearMethod()
+    linear.quant_method = method
+    with torch.device("xpu"):
+        record_metadata_for_reloading(linear)
+    generator = torch.Generator(device="cpu").manual_seed(20260831)
+    weight_cpu = (
+        torch.randn((10240, 320), dtype=torch.bfloat16, generator=generator) * 0.01
+    ).contiguous()
+    linear.weight_loader(linear.weight, weight_cpu)
+    x1 = (torch.randn((1, 320), dtype=torch.bfloat16, generator=generator) * 0.01).to(
+        "xpu"
+    )
+    x2 = (torch.randn((2, 320), dtype=torch.bfloat16, generator=generator) * 0.01).to(
+        "xpu"
+    )
+    authority1 = F.linear(x1, linear.weight)
+    torch.xpu.synchronize()
+
+    original_parameter = linear.weight
+    method.process_weights_after_loading(linear)
+    method.process_weights_after_loading(linear)
+    packed = linear._qwen4_exp_xpu_grouped_up_weight
+    assert linear.weight is original_parameter
+    assert packed.shape == (1, 320, 10240)
+    assert packed.is_contiguous()
+    assert (
+        packed.untyped_storage().data_ptr()
+        == original_parameter.untyped_storage().data_ptr()
+    )
+    assert torch.equal(packed[0].t().cpu(), weight_cpu)
+    assert not any("qwen4_exp_xpu_grouped" in name for name in linear.state_dict())
+
+    candidate1 = linear(x1)
+    candidate1_second = linear(x1)
+    torch.xpu.synchronize()
+    assert torch.equal(candidate1.cpu(), authority1.cpu())
+    assert torch.equal(candidate1_second.cpu(), authority1.cpu())
+    assert (
+        candidate1.untyped_storage().data_ptr()
+        != candidate1_second.untyped_storage().data_ptr()
+    )
+    with pytest.raises(RuntimeError, match="non-M1 dispatch is not qualified"):
+        linear(x2)
+
+    monkeypatch.setattr(torch.compiler, "is_compiling", lambda: True)
+    with pytest.raises(RuntimeError, match="does not support compilation"):
+        linear(x1)
+    monkeypatch.setattr(torch.compiler, "is_compiling", lambda: False)
+
+    replacement_cpu = (
+        torch.randn((10240, 320), dtype=torch.bfloat16, generator=generator) * 0.01
+    ).contiguous()
+    linear.weight_loader(original_parameter, replacement_cpu)
+    assert torch.equal(packed[0].t().cpu(), replacement_cpu)
+    replacement_authority = F.linear(x1, replacement_cpu.to("xpu"))
+    replacement_output = linear(x1)
+    torch.xpu.synchronize()
+    assert torch.equal(replacement_output.cpu(), replacement_authority.cpu())
+
+    official_reload_cpu = (
+        torch.randn((10240, 320), dtype=torch.bfloat16, generator=generator) * 0.01
+    ).contiguous()
+    kernel_parameter = linear.weight
+    kernel_packed = linear._qwen4_exp_xpu_grouped_up_weight
+    kernel_storage = kernel_packed.untyped_storage().data_ptr()
+    initialize_layerwise_reload(linear)
+    reload_parameter = linear.weight
+    reload_parameter.weight_loader(reload_parameter, official_reload_cpu)
+    finalize_layerwise_reload(linear, model_config=None)
+    assert linear.weight is kernel_parameter
+    assert linear._qwen4_exp_xpu_grouped_up_weight is kernel_packed
+    assert linear.weight.untyped_storage().data_ptr() == kernel_storage
+    assert kernel_packed.untyped_storage().data_ptr() == kernel_storage
+    assert torch.equal(kernel_packed[0].t().cpu(), official_reload_cpu)
