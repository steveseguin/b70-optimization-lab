 # SPDX-License-Identifier: Apache-2.0
 # SPDX-FileCopyrightText: Copyright contributors to the vLLM project
-"""Qwen4Exp low-latency GEMM hook for AMD ROCm."""
+"""Opt-in Qwen4Exp low-latency GEMM hooks for XPU."""
 
 import torch
 from torch import nn
 
+import vllm.envs as envs
+from vllm.config.compilation import CompilationMode, CUDAGraphMode
+from vllm.model_executor.layers.linear import (
+    LinearBase,
+    UnquantizedLinearMethod,
+)
+from vllm.platforms import current_platform
+
+from .hyperconnection import GatedResidual
+
+_HC_UP_INPUT_SIZE = 320
+_HC_UP_OUTPUT_SIZE = 10240
+_HC_UP_LAYER_COUNT = 48
+_HC_UP_TARGET_COUNT = 2 * _HC_UP_LAYER_COUNT + 1
+
+
+class Qwen4ExpXPUGroupedUpLinearMethod(UnquantizedLinearMethod):
+    """M=1 grouped GEMM over one packed HC-up weight bank."""
+
+    _PACKED_BUFFER = "_qwen4_exp_xpu_grouped_up_weight"
+    _ROWS_BUFFER = "_qwen4_exp_xpu_grouped_up_rows"
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        super().process_weights_after_loading(layer)
+        weight = layer.weight
+        packed = getattr(layer, self._PACKED_BUFFER, None)
+        rows = getattr(layer, self._ROWS_BUFFER, None)
+
+        if packed is None:
+            if (
+                weight.device.type != "xpu"
+                or weight.dtype != torch.bfloat16
+                or weight.shape != (_HC_UP_OUTPUT_SIZE, _HC_UP_INPUT_SIZE)
+                or getattr(layer, "bias", None) is not None
+                or getattr(weight, "_vllm_is_uva_offloaded", False)
+            ):
+                raise RuntimeError(
+                    "Qwen4Exp grouped HC-up requires resident XPU BF16 "
+                    "[10240,320] without bias"
+                )
+            packed = weight.detach().t().contiguous().unsqueeze(0)
+            rows = torch.ones((1,), dtype=torch.int32, device=weight.device)
+            weight.data = packed[0].t()
+            layer.register_buffer(self._PACKED_BUFFER, packed, persistent=False)
+            layer.register_buffer(self._ROWS_BUFFER, rows, persistent=False)
+
+        self._validate_packed_state(layer, packed, rows)
+
+    @staticmethod
+    def _validate_packed_state(
+        layer: nn.Module,
+        packed: torch.Tensor,
+        rows: torch.Tensor | None,
+    ) -> None:
+        weight = layer.weight
+        if (
+            packed.shape != (1, _HC_UP_INPUT_SIZE, _HC_UP_OUTPUT_SIZE)
+            or packed.stride()
+            != (_HC_UP_INPUT_SIZE * _HC_UP_OUTPUT_SIZE, _HC_UP_OUTPUT_SIZE, 1)
+            or packed.dtype != torch.bfloat16
+            or packed.device.type != "xpu"
+            or not packed.is_contiguous()
+            or rows is None
+            or rows.shape != (1,)
+            or rows.dtype != torch.int32
+            or rows.device != packed.device
+            or int(rows.item()) != 1
+            or weight.shape != (_HC_UP_OUTPUT_SIZE, _HC_UP_INPUT_SIZE)
+            or weight.stride() != (1, _HC_UP_OUTPUT_SIZE)
+            or weight.dtype != packed.dtype
+            or weight.device != packed.device
+            or weight.untyped_storage().data_ptr()
+            != packed.untyped_storage().data_ptr()
+        ):
+            raise RuntimeError("Qwen4Exp grouped HC-up packed state drifted")
+
+    def apply(
+        self,
+        layer: nn.Module,
+        x: torch.Tensor,
+        bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        packed = getattr(layer, self._PACKED_BUFFER, None)
+        rows = getattr(layer, self._ROWS_BUFFER, None)
+        if packed is None or rows is None:
+            raise RuntimeError("Qwen4Exp grouped HC-up weight was not prepared")
+        if torch.compiler.is_compiling():
+            raise RuntimeError("Qwen4Exp grouped HC-up does not support compilation")
+        if (
+            bias is not None
+            or x.device.type != "xpu"
+            or x.device != packed.device
+            or x.dtype != torch.bfloat16
+            or x.ndim != 2
+            or x.shape != (1, _HC_UP_INPUT_SIZE)
+            or not x.is_contiguous()
+        ):
+            raise RuntimeError(
+                "Qwen4Exp grouped HC-up non-M1 dispatch is not qualified"
+            )
+
+        output = torch.empty((1, _HC_UP_OUTPUT_SIZE), dtype=x.dtype, device=x.device)
+        result = torch.ops._xpu_C.cutlass_grouped_gemm_interface(
+            x,
+            packed,
+            None,
+            None,
+            output,
+            rows,
+            _HC_UP_OUTPUT_SIZE,
+            _HC_UP_INPUT_SIZE,
+            1,
+            False,
+            False,
+        )
+        if (
+            not isinstance(result, torch.Tensor)
+            or result.shape != output.shape
+            or result.dtype != output.dtype
+            or result.device != output.device
+            or result.untyped_storage().data_ptr()
+            != output.untyped_storage().data_ptr()
+        ):
+            raise RuntimeError("Qwen4Exp grouped HC-up returned unexpected output")
+        return result
+
+
+def _expected_hc_up_names() -> set[str]:
+    names = {
+        f"model.layers.{layer}.{family}_hyper_connection.input_mix_weight_up"
+        for layer in range(_HC_UP_LAYER_COUNT)
+        for family in ("attn", "mlp")
+    }
+    names.add("model.hyper_connection_mixer.input_mix_weight_up")
+    return names
+
+
+def _validate_grouped_up_config(
+    module: nn.Module,
+    dtype: torch.dtype,
+    vllm_config: object,
+) -> dict[str, LinearBase]:
+    if module.__class__.__name__ != "Qwen4ExpForCausalLM":
+        raise RuntimeError("Qwen4Exp grouped HC-up is initially target-model-only")
+    if not current_platform.is_xpu() or dtype != torch.bfloat16:
+        raise RuntimeError("Qwen4Exp grouped HC-up requires XPU BF16")
+    if getattr(vllm_config, "speculative_config", None) is not None:
+        raise RuntimeError("Qwen4Exp grouped HC-up is initially MTP0-only")
+    if getattr(vllm_config, "lora_config", None) is not None:
+        raise RuntimeError("Qwen4Exp grouped HC-up does not support LoRA")
+    if envs.VLLM_PLE_CPU_OFFLOAD:
+        raise RuntimeError("Qwen4Exp grouped HC-up rejects PLE worker offload")
+
+    parallel_config = vllm_config.parallel_config
+    if (
+        parallel_config.tensor_parallel_size != 4
+        or parallel_config.pipeline_parallel_size != 1
+    ):
+        raise RuntimeError("Qwen4Exp grouped HC-up requires TP4 and PP1")
+
+    compilation_config = vllm_config.compilation_config
+    if (
+        compilation_config.mode != CompilationMode.NONE
+        or compilation_config.cudagraph_mode != CUDAGraphMode.NONE
+    ):
+        raise RuntimeError("Qwen4Exp grouped HC-up requires fully eager execution")
+
+    offload_config = vllm_config.offload_config
+    if (
+        offload_config.offload_backend != "uva"
+        or offload_config.uva.cpu_offload_gb != 12.0
+        or offload_config.uva.cpu_offload_params
+        != {"ple_embedding.ngram_embedding.weight"}
+        or offload_config.prefetch.offload_group_size != 0
+    ):
+        raise RuntimeError(
+            "Qwen4Exp grouped HC-up requires the exact selective PLE-only "
+            "UVA offload contract"
+        )
+
+    config = vllm_config.model_config.hf_text_config
+    if (
+        config.num_hidden_layers != _HC_UP_LAYER_COUNT
+        or config.hidden_size != 2560
+        or config.hc_count != 4
+        or config.hc_lowrank != _HC_UP_INPUT_SIZE
+    ):
+        raise RuntimeError("Qwen4Exp grouped HC-up model dimensions do not match")
+    if not hasattr(torch.ops._xpu_C, "cutlass_grouped_gemm_interface"):
+        raise RuntimeError("XPU runtime lacks the grouped-GEMM interface")
+
+    targets: dict[str, LinearBase] = {}
+    for name, child in module.named_modules():
+        if not isinstance(child, GatedResidual):
+            continue
+        linear = child.input_mix_weight_up
+        targets[f"{name}.input_mix_weight_up"] = linear
+    expected = _expected_hc_up_names()
+    if set(targets) != expected or len(targets) != _HC_UP_TARGET_COUNT:
+        missing = sorted(expected - set(targets))
+        extra = sorted(set(targets) - expected)
