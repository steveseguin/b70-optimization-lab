 from vllm.utils.torch_utils import direct_register_custom_op
 
 
+def _grouped_gemma_rmsnorm_torch(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    num_groups: int,
+) -> torch.Tensor:
+    """Device-neutral grouped Gemma RMSNorm reference implementation."""
+    input_dtype = x.dtype
+    group_dim = x.shape[-1] // num_groups
+    grouped = x.float().unflatten(-1, (num_groups, group_dim))
+    variance = grouped.square().mean(dim=-1, keepdim=True)
+    normalized = grouped * torch.rsqrt(variance + eps)
+    if weight.numel() == group_dim:
+        normalized = normalized * (1.0 + weight.float())
+    else:
+        normalized = normalized.flatten(-2) * (1.0 + weight.float())
+        return normalized.to(input_dtype)
+    return normalized.flatten(-2).to(input_dtype)
+
+
+def _hc_silu_torch(x: torch.Tensor, hc_count: int) -> torch.Tensor:
+    """Device-neutral scaled SiLU reference implementation."""
+    scaled = x.float() / hc_count
+    return (scaled * torch.sigmoid(scaled)).to(x.dtype)
+
+
+def _hc_gate_mix_torch(
+    x: torch.Tensor,
+    gate: torch.Tensor,
+    hc_count: int,
+) -> torch.Tensor:
+    """Device-neutral gated HC stream reduction."""
+    hidden_size = x.shape[-1] // hc_count
+    mixed = torch.sigmoid(
+        gate.float().unflatten(-1, (hc_count, hidden_size))
+    ) * x.float().unflatten(-1, (hc_count, hidden_size))
+    return mixed.mean(dim=-2).to(x.dtype)
+
+
+def _hc_combine_torch(
+    residual: torch.Tensor,
+    block_output: torch.Tensor,
+    injection_logits: torch.Tensor,
+    hc_count: int,
+) -> torch.Tensor:
+    """Device-neutral delayed HC residual combine."""
+    hidden_size = residual.shape[-1] // hc_count
+    injection = 2.0 * torch.sigmoid(injection_logits.float() / hc_count)
+    combined = residual.float().unflatten(-1, (hc_count, hidden_size))
+    combined = combined + block_output.float().unsqueeze(-2) * injection.unsqueeze(-1)
+    return combined.flatten(-2).to(residual.dtype)
+
+
+def _hc_combine_norm_torch(
+    residual: torch.Tensor,
+    block_output: torch.Tensor,
+    injection_logits: torch.Tensor,
+    norm_weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Device-neutral combine followed by the checkpoint RMSNorm boundary."""
+    combined = _hc_combine_torch(
+        residual,
+        block_output,
+        injection_logits,
+        hc_count,
+    )
+    normalized = _grouped_gemma_rmsnorm_torch(
+        combined,
+        norm_weight,
+        eps,
+        hc_count,
+    )
+    return combined, normalized
+
+
