+def test_xpu_hc_torch_fallback_matches_reference() -> None:
+    torch.manual_seed(0)
+    hc_count = 4
+    hidden_size = 8
+    dtype = torch.bfloat16
+    residual = torch.randn(3, hc_count * hidden_size, dtype=dtype)
+    block_output = torch.randn(3, hidden_size, dtype=dtype)
+    injection = torch.randn(3, hc_count, dtype=dtype)
+    gate = torch.randn_like(residual)
+    weight = torch.randn_like(residual[0])
+    eps = 1e-6
+
+    grouped = residual.float().unflatten(-1, (hc_count, hidden_size))
+    variance = grouped.square().mean(-1, keepdim=True)
+    expected_norm = grouped * torch.rsqrt(variance + eps)
+    expected_norm = expected_norm.flatten(-2) * (1.0 + weight.float())
+    torch.testing.assert_close(
+        _grouped_gemma_rmsnorm_torch(residual, weight, eps, hc_count),
+        expected_norm.to(dtype),
+    )
+
+    scaled = residual.float() / hc_count
+    torch.testing.assert_close(
+        _hc_silu_torch(residual, hc_count),
+        (scaled * torch.sigmoid(scaled)).to(dtype),
+    )
+
+    expected_mix = (
+        torch.sigmoid(gate.float().unflatten(-1, (hc_count, hidden_size))) * grouped
+    ).mean(-2)
+    torch.testing.assert_close(
+        _hc_gate_mix_torch(residual, gate, hc_count),
+        expected_mix.to(dtype),
+    )
+
+    injection_weight = 2.0 * torch.sigmoid(injection.float() / hc_count)
+    expected_combine = grouped + block_output.float().unsqueeze(
+        -2
+    ) * injection_weight.unsqueeze(-1)
+    expected_combine = expected_combine.flatten(-2).to(dtype)
+    actual_combine = _hc_combine_torch(residual, block_output, injection, hc_count)
+    torch.testing.assert_close(actual_combine, expected_combine)
+
+    actual_combine, actual_norm = _hc_combine_norm_torch(
+        residual,
+        block_output,
+        injection,
+        weight,
+        eps,
+        hc_count,
+    )
+    grouped_combined = expected_combine.float().unflatten(-1, (hc_count, hidden_size))
+    combined_variance = grouped_combined.square().mean(-1, keepdim=True)
+    expected_combined_norm = grouped_combined * torch.rsqrt(combined_variance + eps)
+    expected_combined_norm = expected_combined_norm.flatten(-2) * (1.0 + weight.float())
+    torch.testing.assert_close(actual_combine, expected_combine)
+    torch.testing.assert_close(actual_norm, expected_combined_norm.to(dtype))
