     assert trace.labels == []
+
+
+def test_model_starts_only_present_ple_layer() -> None:
+    calls = []
+
+    class _PLE:
+        def start_xpu_uva_prefetch(self, *args) -> None:
+            calls.append(args)
+
+    tensors = (
+        torch.empty(1, 4),
+        torch.tensor([1]),
+        torch.tensor([0, 1]),
+        torch.tensor([[0, 0]]),
+    )
+    model_module.Qwen4ExpModel._start_layer_ple_prefetch(
+        SimpleNamespace(ple=None), *tensors
+    )
+    model_module.Qwen4ExpModel._start_layer_ple_prefetch(
+        SimpleNamespace(ple=_PLE()), *tensors
+    )
+    assert calls == [tensors]
+
+
+class _NoTrace:
+    def begin(self, _positions, _rank) -> bool:
+        return False
+
+
+class _OrderedPLE(nn.Module):
+    def __init__(self, calls: list[str]) -> None:
+        super().__init__()
+        self.calls = calls
+
+    def start_xpu_uva_prefetch(self, *_args) -> None:
+        self.calls.append("prefetch")
+
+    def abort_xpu_uva_prefetch(self) -> None:
+        self.calls.append("abort")
+
+
+class _OrderedLayer(nn.Module):
+    def __init__(
+        self, label: str, calls: list[str], *, ple: nn.Module | None = None
+    ) -> None:
+        super().__init__()
+        self.label = label
+        self.calls = calls
+        self.ple = ple
+        self.mlp_hyper_connection = _FakeHyperConnection()
+
+    def forward(self, *, hidden_states: torch.Tensor, **_kwargs):
+        self.calls.append(self.label)
+        return hidden_states + 1, None, None
+
+
+class _FailingLayer(_OrderedLayer):
+    def forward(self, **_kwargs):
+        self.calls.append(self.label)
+        raise RuntimeError("injected earlier-layer failure")
+
+
+class _FinalMixer(nn.Module):
+    def combine_and_mix(self, hidden_states, _block_output, _injection):
+        return hidden_states, hidden_states, None
+
+
+def _make_ordered_model(calls: list[str], *, fail_layer_zero: bool) -> Qwen4ExpModel:
+    model = Qwen4ExpModel.__new__(Qwen4ExpModel)
+    nn.Module.__init__(model)
+    ple = _OrderedPLE(calls)
+    layer_cls = _FailingLayer if fail_layer_zero else _OrderedLayer
+    model.layers = nn.ModuleList(
+        [layer_cls("layer0", calls), _OrderedLayer("layer1", calls, ple=ple)]
+    )
+    model.start_layer = 0
+    model.end_layer = 2
+    model._xpu_ple_uva_prefetch_layers = (model.layers[1],)
+    model._repeatability_trace = _NoTrace()
+    model.config = SimpleNamespace(hc_count=1)
+    model.embed_tokens = nn.Identity()
+    model.hyper_connection_mixer = _FinalMixer()
+    model._mtp_hidden_buffer = None
+    return model
+
+
+def test_model_prefetches_before_layer_zero(monkeypatch: pytest.MonkeyPatch) -> None:
+    calls: list[str] = []
+    model = _make_ordered_model(calls, fail_layer_zero=False)
+    monkeypatch.setattr(
+        model_module,
+        "get_pp_group",
+        lambda: SimpleNamespace(is_first_rank=True, is_last_rank=True),
+    )
+    monkeypatch.setattr(model_module, "get_tensor_model_parallel_rank", lambda: 0)
+    Qwen4ExpModel.forward(
+        model,
+        input_ids=torch.tensor([1]),
+        positions=torch.tensor([0]),
+        query_start_loc=torch.tensor([0, 1]),
+        ngram_context=torch.tensor([[0, 0]]),
+    )
+    assert calls == ["prefetch", "layer0", "layer1"]
+
+
+def test_model_aborts_prefetch_after_earlier_layer_failure(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    calls: list[str] = []
+    model = _make_ordered_model(calls, fail_layer_zero=True)
+    monkeypatch.setattr(
+        model_module,
+        "get_pp_group",
+        lambda: SimpleNamespace(is_first_rank=True, is_last_rank=True),
+    )
+    monkeypatch.setattr(model_module, "get_tensor_model_parallel_rank", lambda: 0)
+    with pytest.raises(RuntimeError, match="injected earlier-layer failure"):
+        Qwen4ExpModel.forward(
+            model,
+            input_ids=torch.tensor([1]),
+            positions=torch.tensor([0]),
+            query_start_loc=torch.tensor([0, 1]),
+            ngram_context=torch.tensor([[0, 0]]),
+        )
+    assert calls == ["prefetch", "layer0", "abort"]
