+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import torch
+import torch.nn as nn
+
+from vllm.models.qwen4_exp.amd.model import Qwen4ExpDecoderLayer
+
+
+class _FakePLE(nn.Module):
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        input_ids: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        ngram_context: torch.Tensor,
+    ) -> torch.Tensor:
+        del input_ids, query_start_loc, ngram_context
+        return hidden_states * 0.25
+
+
+class _FakeAttention(nn.Module):
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return hidden_states + 3
+
+
+class _FakeMLP(nn.Module):
+    def forward(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        return hidden_states - 2
+
+
+class _FakeHyperConnection(nn.Module):
+    def mix(
+        self, hidden_states: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        return hidden_states, hidden_states + 1, hidden_states + 2
+
+    def combine_and_mix(
+        self,
+        hidden_states: torch.Tensor,
+        block_output: torch.Tensor,
+        injection: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        combined = hidden_states + block_output + injection
+        return combined, combined + 1, combined + 2
+
+
+class _TraceSpy:
+    def __init__(self) -> None:
+        self.labels: list[str] = []
+
+    def record(self, label: str, **_tensors: torch.Tensor | None) -> None:
+        self.labels.append(label)
+
+
+def _make_layer(*, with_ple: bool) -> Qwen4ExpDecoderLayer:
+    layer = Qwen4ExpDecoderLayer.__new__(Qwen4ExpDecoderLayer)
+    nn.Module.__init__(layer)
+    layer.layer_idx = 1
+    layer.layer_type = "linear_attention"
+    layer.ple = _FakePLE() if with_ple else None
+    layer.attn_hyper_connection = _FakeHyperConnection()
+    layer.linear_attn = _FakeAttention()
+    layer.mlp_hyper_connection = _FakeHyperConnection()
+    layer.mlp = _FakeMLP()
+    return layer
+
+
+def _forward_kwargs() -> dict[str, object]:
+    return {
+        "hidden_states": torch.arange(8, dtype=torch.float32).reshape(2, 4),
+        "prev_block_output": None,
+        "prev_injection": None,
+        "positions": torch.tensor([4000, 4001]),
+        "input_ids": torch.tensor([10, 11]),
+        "query_start_loc": torch.tensor([0, 2]),
+        "ngram_context": torch.tensor([[8, 9]]),
+    }
+
+
+def test_disabled_trace_preserves_default_fast_path() -> None:
+    layer = _make_layer(with_ple=True)
+    default_result = layer(**_forward_kwargs())
+    explicit_none_result = layer(**_forward_kwargs(), repeatability_trace=None)
+    for default_tensor, explicit_none_tensor in zip(
+        default_result, explicit_none_result, strict=True
+    ):
+        torch.testing.assert_close(default_tensor, explicit_none_tensor)
+
+
+def test_ple_trace_records_inner_boundaries_in_order() -> None:
+    layer = _make_layer(with_ple=True)
+    trace = _TraceSpy()
+    layer(**_forward_kwargs(), repeatability_trace=trace)
+    assert trace.labels == [
+        "layer_1_ple_input",
+        "layer_1_ple_output",
+        "layer_1_post_ple",
+        "layer_1_attn_mix",
+        "layer_1_attn_output",
+        "layer_1_mlp_mix",
+        "layer_1_mlp_output",
+    ]
+
+
+def test_non_ple_layer_records_no_inner_boundaries() -> None:
+    layer = _make_layer(with_ple=False)
+    trace = _TraceSpy()
+    kwargs = _forward_kwargs()
+    kwargs.update(input_ids=None, query_start_loc=None, ngram_context=None)
+    layer(**kwargs, repeatability_trace=trace)
+    assert trace.labels == []
