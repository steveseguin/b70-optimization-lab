+) -> None:
+    worker = Worker.__new__(Worker)
+    worker.parallel_config = SimpleNamespace(
+        nnodes=1,
+        data_parallel_backend="mp",
+        data_parallel_size_local=1,
+        data_parallel_size=1,
+        pipeline_parallel_size=1,
+        prefill_context_parallel_size=1,
+        decode_context_parallel_size=1,
+        use_ubatching=False,
+    )
+    worker.model_config = SimpleNamespace(architecture="Qwen4ExpForCausalLM")
+    worker.vllm_config = SimpleNamespace(weight_transfer_config=None)
+    monkeypatch.setattr(gpu_worker_module.current_platform, "is_cuda", lambda: False)
+    monkeypatch.setattr(gpu_worker_module.current_platform, "is_xpu", lambda: True)
+    monkeypatch.setattr(envs, "VLLM_PLE_OFFLOAD_RUNTIME_TIMEOUT", timeout)
+
+    with pytest.raises(ValueError, match="VLLM_PLE_OFFLOAD_RUNTIME_TIMEOUT"):
+        worker._validate_ple_offload_config()
+
+
+def test_ple_offload_runner_signals_every_host_target() -> None:
+    class FakeSemaphore:
+        is_host_synchronized = True
+
+        def __init__(self) -> None:
+            self.failures = 0
+
+        def signal_failure(self) -> None:
+            self.failures += 1
+
+    semaphores = [FakeSemaphore() for _ in range(4)]
+    runner = ple_offload_worker.PleOffloadRunner.__new__(
+        ple_offload_worker.PleOffloadRunner
+    )
+    runner._worker_targets = {
+        0: {"ple": [SimpleNamespace(sem=semaphore) for semaphore in semaphores]}
+    }
+
+    runner.signal_failure()
+
+    assert [semaphore.failures for semaphore in semaphores] == [1, 1, 1, 1]
+
+
 @pytest.mark.parametrize(
