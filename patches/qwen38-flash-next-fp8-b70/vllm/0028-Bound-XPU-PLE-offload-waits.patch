+++ b/vllm/model_executor/layers/ple_offload_layer.py
@@ -81,6 +81,7 @@ class CpuGpuSemaphore:
 
     RESET_VALUE = 0
     DONE_VALUE = 1
+    FAILED_VALUE = -1
 
     def __init__(self, device: torch.device) -> None:
         if device.type == "xpu":
@@ -108,6 +109,8 @@ class CpuGpuSemaphore:
     def reset(self, stream: torch.cuda.Stream | None = None) -> None:
         """Enqueue ``WriteValue32(flag=0)`` on ``stream``."""
         if self.is_host_synchronized:
+            if self._flag_tensor.item() == self.FAILED_VALUE:
+                return
             self._flag_tensor.fill_(self.RESET_VALUE)
             return
         _require_cuda_driver()
@@ -141,11 +144,34 @@ class CpuGpuSemaphore:
             "CpuGpuSemaphore.signal",
         )
 
+    def signal_failure(self) -> None:
+        """Wake host-synchronized waiters after a terminal worker failure."""
+        if not self.is_host_synchronized:
+            raise RuntimeError("signal_failure is only valid for host synchronization")
+        self._flag_tensor.fill_(self.FAILED_VALUE)
+
+    def _wait_host_value(self, expected: int, operation: str) -> None:
+        timeout = envs.VLLM_PLE_OFFLOAD_RUNTIME_TIMEOUT
+        deadline = time.monotonic() + timeout
+        while True:
+            value = self._flag_tensor.item()
+            if value == expected:
+                return
+            if value == self.FAILED_VALUE:
+                raise RuntimeError(
+                    f"PLE offload worker failed while waiting to {operation}"
+                )
+            if time.monotonic() >= deadline:
+                raise TimeoutError(
+                    f"PLE offload timed out after {timeout}s while waiting "
+                    f"to {operation} (semaphore value={value})"
+                )
+            time.sleep(0.0001)
+
     def wait_reset(self, stream: torch.cuda.Stream | None = None) -> None:
         """Enqueue ``WaitValue32(flag==0)`` on ``stream``."""
         if self.is_host_synchronized:
-            while self._flag_tensor.item() != self.RESET_VALUE:
-                time.sleep(0.0001)
+            self._wait_host_value(self.RESET_VALUE, "reuse the output buffer")
             return
         _require_cuda_driver()
         if stream is None:
@@ -164,8 +190,7 @@ class CpuGpuSemaphore:
         """Block the host until a shared-host result is ready."""
         if not self.is_host_synchronized:
             raise RuntimeError("wait_done is only valid for host synchronization")
-        while self._flag_tensor.item() != self.DONE_VALUE:
-            time.sleep(0.0001)
+        self._wait_host_value(self.DONE_VALUE, "receive the CPU result")
 
 
