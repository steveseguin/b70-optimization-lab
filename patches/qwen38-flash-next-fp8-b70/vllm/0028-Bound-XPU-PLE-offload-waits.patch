diff --git a/tests/v1/worker/test_gpu_model_runner.py b/tests/v1/worker/test_gpu_model_runner.py
index be9135a78..c54ce0c57 100644
--- a/tests/v1/worker/test_gpu_model_runner.py
+++ b/tests/v1/worker/test_gpu_model_runner.py
@@ -113,6 +113,42 @@ def test_ple_offload_host_semaphore_cross_thread_round_trip() -> None:
     semaphore.wait_reset()
 
 
+@pytest.mark.parametrize(
+    ("initial_value", "wait_method"),
+    [
+        (CpuGpuSemaphore.RESET_VALUE, "wait_done"),
+        (CpuGpuSemaphore.DONE_VALUE, "wait_reset"),
+    ],
+)
+def test_ple_offload_host_semaphore_wait_is_bounded(
+    monkeypatch: pytest.MonkeyPatch,
+    initial_value: int,
+    wait_method: str,
+) -> None:
+    semaphore = CpuGpuSemaphore(torch.device("xpu"))
+    semaphore.flag_tensor.fill_(initial_value)
+    monkeypatch.setattr(
+        gpu_model_runner_module.envs,
+        "VLLM_PLE_OFFLOAD_RUNTIME_TIMEOUT",
+        0.001,
+    )
+
+    with pytest.raises(TimeoutError, match="PLE offload timed out"):
+        getattr(semaphore, wait_method)()
+
+
+@pytest.mark.parametrize("wait_method", ["wait_done", "wait_reset"])
+def test_ple_offload_host_semaphore_failure_wakes_waiter(wait_method: str) -> None:
+    semaphore = CpuGpuSemaphore(torch.device("xpu"))
+    semaphore.signal_failure()
+
+    with pytest.raises(RuntimeError, match="PLE offload worker failed"):
+        getattr(semaphore, wait_method)()
+
+    semaphore.reset()
+    assert semaphore.flag_tensor.item() == CpuGpuSemaphore.FAILED_VALUE
+
+
