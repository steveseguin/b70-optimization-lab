+
+from vllm.config.load import LoadConfig
+from vllm.model_executor.model_loader import default_loader, weight_utils
+from vllm.model_executor.model_loader.default_loader import DefaultModelLoader
+
+
+def test_filtered_loader_prunes_files_and_names(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path,
+) -> None:
+    files = [tmp_path / f"model-{index}.safetensors" for index in range(3)]
+    for path in files:
+        path.touch()
+    (tmp_path / "model.safetensors.index.json").write_text(
+        json.dumps(
+            {
+                "weight_map": {
+                    "selected.a": files[0].name,
+                    "unrelated": files[1].name,
+                    "selected.c": files[2].name,
+                }
+            }
+        ),
+        encoding="utf-8",
+    )
+    calls = []
+
+    def fake_iterator(selected_files, _use_tqdm, _strategy, **kwargs):
+        calls.append((selected_files, kwargs["weight_names"]))
+        for name in sorted(kwargs["weight_names"]):
+            yield name, torch.ones(1)
+
+    loader = DefaultModelLoader(LoadConfig(load_format="safetensors"))
+    monkeypatch.setattr(
+        loader,
+        "_prepare_weights",
+        lambda *args: (str(tmp_path), [str(path) for path in files], True),
+    )
+    monkeypatch.setattr(
+        default_loader,
+        "safetensors_weights_iterator",
+        fake_iterator,
+    )
+    model = SimpleNamespace()
+    model_config = SimpleNamespace(model=str(tmp_path), revision=None)
+
+    loaded = list(
+        loader.get_filtered_weights(
+            model_config,
+            model,
+            weight_name_filter=lambda name: name.startswith("selected."),
+        )
+    )
+
+    assert [name for name, _ in loaded] == ["selected.a", "selected.c"]
+    assert calls == [
+        (
+            [str(files[0]), str(files[2])],
+            {"selected.a", "selected.c"},
+        )
+    ]
+
+
+def test_safetensors_name_filter_precedes_materialization(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path,
+) -> None:
+    path = tmp_path / "model.safetensors"
+    save_file(
+        {
+            "selected": torch.arange(4),
+            "unrelated": torch.arange(8),
+        },
+        path,
+    )
+    opened_names = []
+    real_safe_open = weight_utils.safe_open
+
+    class TrackingSafeOpen:
+        def __init__(self, filename, **kwargs):
+            self._context = real_safe_open(filename, **kwargs)
+
+        def __enter__(self):
+            self._reader = self._context.__enter__()
+            return self
+
+        def __exit__(self, *args):
+            return self._context.__exit__(*args)
+
+        def keys(self):
+            return self._reader.keys()
+
+        def get_tensor(self, name):
+            opened_names.append(name)
+            return self._reader.get_tensor(name)
+
+    monkeypatch.setattr(weight_utils, "safe_open", TrackingSafeOpen)
+
+    loaded = dict(
+        weight_utils.safetensors_weights_iterator(
+            [str(path)],
+            False,
+            weight_names={"selected"},
+        )
+    )
+
+    assert set(loaded) == {"selected"}
+    assert opened_names == ["selected"]
+
+
+def test_filtered_loader_requires_valid_index(
+    monkeypatch: pytest.MonkeyPatch,
+    tmp_path,
+) -> None:
+    path = tmp_path / "model.safetensors"
+    path.touch()
+    loader = DefaultModelLoader(LoadConfig(load_format="safetensors"))
+    monkeypatch.setattr(
+        loader,
+        "_prepare_weights",
+        lambda *args: (str(tmp_path), [str(path)], True),
+    )
+    model_config = SimpleNamespace(model=str(tmp_path), revision=None)
+
+    with pytest.raises(RuntimeError, match="requires a valid index"):
+        list(
+            loader.get_filtered_weights(
+                model_config,
+                SimpleNamespace(),
+                weight_name_filter=lambda _name: True,
+            )
+        )
+
+
+def test_filtered_loader_rejects_unsupported_strategy() -> None:
+    loader = DefaultModelLoader(
+        LoadConfig(
+            load_format="safetensors",
+            safetensors_load_strategy="eager",
+        )
+    )
+
+    with pytest.raises(ValueError, match="lazy safetensors"):
+        list(
+            loader.get_filtered_weights(
+                SimpleNamespace(model="unused", revision=None),
+                SimpleNamespace(),
+                weight_name_filter=lambda _name: True,
+            )
+        )
