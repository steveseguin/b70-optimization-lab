+    def _get_filtered_safetensors_iterator(
+        self,
+        source: "Source",
+        weight_name_filter: Callable[[str], bool],
+    ) -> Generator[tuple[str, torch.Tensor], None, None]:
+        """Read an index-selected lazy-safetensors subset without fallback."""
+        extra_config = self.load_config.model_loader_extra_config
+        if self.load_config.load_format != "safetensors":
+            raise ValueError(
+                "Filtered weight loading requires load_format='safetensors'"
+            )
+        if self.load_config.safetensors_load_strategy not in (None, "lazy"):
+            raise ValueError(
+                "Filtered weight loading requires the lazy safetensors strategy"
+            )
+        if extra_config.get("enable_multithread_load"):
+            raise ValueError(
+                "Filtered weight loading does not support multithread load"
+            )
+
+        hf_folder, hf_weights_files, use_safetensors = self._prepare_weights(
+            source.model_or_path,
+            source.subfolder,
+            source.revision,
+            source.fall_back_to_pt,
+            source.allow_patterns_overrides,
+        )
+        if not use_safetensors:
+            raise ValueError("Filtered weight loading requires safetensors files")
+
+        index_path = os.path.join(hf_folder, SAFE_WEIGHTS_INDEX_NAME)
+        try:
+            with open(index_path, encoding="utf-8") as index_file:
+                index = json.load(index_file)
+        except (OSError, json.JSONDecodeError) as error:
+            raise RuntimeError(
+                f"Filtered weight loading requires a valid index: {index_path}"
+            ) from error
+        weight_map = index.get("weight_map")
+        if not isinstance(weight_map, dict) or not all(
+            isinstance(name, str) and isinstance(filename, str)
+            for name, filename in weight_map.items()
+        ):
+            raise RuntimeError(f"Invalid safetensors weight map: {index_path}")
+
+        selected_names = {
+            name for name in weight_map if weight_name_filter(source.prefix + name)
+        }
+        if not selected_names:
+            raise RuntimeError(
+                f"Filtered weight loading selected no indexed weights from {index_path}"
+            )
+
+        selected_paths = {
+            os.path.normpath(os.path.join(hf_folder, weight_map[name]))
+            for name in selected_names
+        }
+        available_paths = {os.path.normpath(path) for path in hf_weights_files}
+        missing_paths = sorted(selected_paths.difference(available_paths))
+        if missing_paths:
+            raise RuntimeError(
+                f"Safetensors index selected missing checkpoint files: {missing_paths}"
+            )
+
+        logger.info(
+            "Filtered checkpoint index selected %d weight(s) across %d/%d file(s).",
+            len(selected_names),
+            len(selected_paths),
+            len(hf_weights_files),
+        )
+        iterator = safetensors_weights_iterator(
+            sorted(selected_paths),
+            self.load_config.use_tqdm_on_load,
+            self.load_config.safetensors_load_strategy,
+            weight_names=selected_names,
+            safetensors_prefetch_num_threads=(
+                self.load_config.safetensors_prefetch_num_threads
+            ),
+            safetensors_prefetch_block_size=(
+                self.load_config.safetensors_prefetch_block_size
+            ),
+        )
+        yield from ((source.prefix + name, tensor) for name, tensor in iterator)
+
+    def get_filtered_weights(
+        self,
+        model_config: ModelConfig,
+        model: nn.Module,
+        *,
+        weight_name_filter: Callable[[str], bool],
+    ) -> Generator[tuple[str, torch.Tensor], None, None]:
+        """Load an exact index-filtered subset for specialized CPU workers."""
+        secondary_weights = tuple(
+            cast(
+                Iterable[DefaultModelLoader.Source],
+                getattr(model, "secondary_weights", ()),
+            )
+        )
+        if secondary_weights:
+            raise ValueError(
+                "Filtered weight loading does not support secondary weight sources"
+            )
+        primary_weights = DefaultModelLoader.Source(
+            model_config.model,
+            model_config.revision,
+            prefix="",
+            fall_back_to_pt=getattr(model, "fall_back_to_pt_during_load", True),
+            allow_patterns_overrides=getattr(model, "allow_patterns_overrides", None),
+        )
+        yield from self._get_filtered_safetensors_iterator(
+            primary_weights,
+            weight_name_filter,
+        )
+
