+def test_ple_offload_host_semaphore_cross_thread_round_trip() -> None:
+    """Exercise the blocking host synchronization used by XPU eager mode."""
+    semaphore = CpuGpuSemaphore(torch.device("xpu"))
+    assert semaphore.is_host_synchronized
+    assert semaphore.flag_tensor.is_shared()
+
+    completed = threading.Event()
+
+    def wait_for_result() -> None:
+        semaphore.wait_done()
+        completed.set()
+
+    thread = threading.Thread(target=wait_for_result)
+    thread.start()
+    time.sleep(0.01)
+    assert not completed.is_set()
+    semaphore.signal()
+    thread.join(timeout=1)
+    assert completed.is_set()
+
+    semaphore.reset()
+    semaphore.wait_reset()
+
