+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm import envs
+from vllm.models.qwen4_exp.amd.ops import hc as hc_module
+
+
+class _FakeTensor:
+    def __init__(
+        self,
+        *,
+        device_type: str = "xpu",
+        dtype: torch.dtype = torch.bfloat16,
+        shape: tuple[int, ...] = (1, 320),
+        inner_stride: int = 1,
+    ) -> None:
+        self.device = SimpleNamespace(type=device_type)
+        self.dtype = dtype
+        self.shape = shape
+        self._inner_stride = inner_stride
+
+    def dim(self) -> int:
+        return len(self.shape)
+
+    def stride(self, dim: int) -> int:
+        assert dim == 1
+        return self._inner_stride
+
+
+def test_native_hc_silu_selector_is_default_off(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.delenv("VLLM_XPU_QWEN4_EXP_HC_SILU", raising=False)
+    assert envs.VLLM_XPU_QWEN4_EXP_HC_SILU is False
+    assert not hc_module._use_native_xpu_hc_silu(  # type: ignore[arg-type]
+        _FakeTensor(), 4
+    )
+
+
+@pytest.mark.parametrize(
+    ("tensor", "hc_count"),
+    [
+        (_FakeTensor(device_type="cpu"), 4),
+        (_FakeTensor(dtype=torch.float16), 4),
+        (_FakeTensor(shape=(2, 320)), 4),
+        (_FakeTensor(shape=(1, 319)), 4),
+        (_FakeTensor(inner_stride=2), 4),
+        (_FakeTensor(), 2),
+    ],
+)
+def test_native_hc_silu_selector_is_exact_shape_only(
+    monkeypatch: pytest.MonkeyPatch,
+    tensor: _FakeTensor,
+    hc_count: int,
+) -> None:
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_HC_SILU", "1")
+    assert not hc_module._use_native_xpu_hc_silu(  # type: ignore[arg-type]
+        tensor, hc_count
+    )
+
+
+def test_native_hc_silu_selector_accepts_production_decode_shape(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_HC_SILU", "1")
+    assert hc_module._use_native_xpu_hc_silu(  # type: ignore[arg-type]
+        _FakeTensor(), 4
+    )
+
+
+def test_hc_silu_routes_exact_shape_to_native_operator(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    expected = object()
+    calls: list[tuple[object, int]] = []
+
+    def native(tensor: object, hc_count: int) -> object:
+        calls.append((tensor, hc_count))
+        return expected
+
+    tensor = _FakeTensor()
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_HC_SILU", "1")
+    monkeypatch.setattr(
+        hc_module.torch,
+        "ops",
+        SimpleNamespace(
+            _xpu_C=SimpleNamespace(qwen4_exp_hc_silu=native),
+        ),
+    )
+    assert hc_module._hc_silu(tensor, 4) is expected  # type: ignore[arg-type]
+    assert calls == [(tensor, 4)]
+
+
+def test_hc_silu_retains_fallback_when_selector_is_off(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    expected = object()
+    calls: list[tuple[object, int]] = []
+
+    def fallback(tensor: object, hc_count: int) -> object:
+        calls.append((tensor, hc_count))
+        return expected
+
+    tensor = _FakeTensor()
+    monkeypatch.delenv("VLLM_XPU_QWEN4_EXP_HC_SILU", raising=False)
+    monkeypatch.setattr(hc_module, "_hc_silu_torch", fallback)
+    assert hc_module._hc_silu(tensor, 4) is expected  # type: ignore[arg-type]
+    assert calls == [(tensor, 4)]
+
+
+def test_hc_silu_enabled_exact_shape_fails_if_native_operator_is_missing(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("VLLM_XPU_QWEN4_EXP_HC_SILU", "1")
+    monkeypatch.setattr(
+        hc_module.torch,
+        "ops",
+        SimpleNamespace(_xpu_C=SimpleNamespace()),
+    )
+    with pytest.raises(RuntimeError, match="native XPU operator is unavailable"):
+        hc_module._hc_silu(_FakeTensor(), 4)  # type: ignore[arg-type]
