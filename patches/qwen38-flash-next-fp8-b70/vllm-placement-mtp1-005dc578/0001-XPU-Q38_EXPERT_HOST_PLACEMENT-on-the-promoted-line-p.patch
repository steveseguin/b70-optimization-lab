--- /dev/null
+++ b/vllm/q38_expert_placement.py
@@ -0,0 +1,103 @@
+"""Q38 per-expert host placement (timing-only diagnostics lane, bit-exact by construction).
+
+`Q38_EXPERT_HOST_PLACEMENT=<json>`: {"<layer_idx>": [local expert ids]} names routed experts
+whose weight rows live in pinned host memory (UVA view) instead of VRAM. After the FP8 MoE
+post-load step, each MoE layer's `w13_weight` / `w2_weight` [E, N, K] is split into a resident
+device tensor and a host tensor, the original is freed, and an int64 base-address table
+(one entry per local expert) is attached to the resident tensor as `_q38_base_table`; the
+Triton kernel then loads each expert's row base from the table (`USE_B_TABLE`) and runs the
+unchanged math on the unchanged bytes. Block scales stay on the device in full.
+"""
+import json
+import os
+import re
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+PLACEMENT_PATH = os.getenv("Q38_EXPERT_HOST_PLACEMENT", "")
+_PLACEMENT: dict[int, list[int]] | None = None
+_STATS = {"layers": 0, "host_experts": 0, "host_bytes": 0}
+
+
+def _placement() -> dict[int, list[int]]:
+    """Placement for this rank. File format: {"<rank>": {"<layer>": [local ids]}} (per-rank, EP
+    linear placement) or the flat {"<layer>": [local ids]} form applied to every rank."""
+    global _PLACEMENT
+    if _PLACEMENT is None:
+        raw = json.loads(open(PLACEMENT_PATH).read()) if PLACEMENT_PATH else {}
+        if raw and all(isinstance(v, dict) for v in raw.values()):
+            from vllm.distributed import get_tensor_model_parallel_rank
+            raw = raw.get(str(get_tensor_model_parallel_rank()), {})
+        _PLACEMENT = {int(k): sorted(int(e) for e in v) for k, v in raw.items()}
+    return _PLACEMENT
+
+
+def _layer_index(layer: torch.nn.Module) -> int | None:
+    name = getattr(layer, "layer_name", None) or getattr(layer, "prefix", "") or ""
+    m = re.search(r"layers\.(\d+)\.", str(name))
+    return int(m.group(1)) if m else None
+
+
+def _split(weight: torch.Tensor, host_rows: list[int]) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Return (resident, host_uva_view, base_table) for a [E, N, K] weight."""
+    from vllm.utils.torch_utils import get_accelerator_view_from_cpu_tensor
+
+    E = weight.shape[0]
+    host_set = set(host_rows)
+    res_rows = [e for e in range(E) if e not in host_set]
+    resident = weight[res_rows].contiguous() if res_rows else weight[:0].contiguous()
+    host_cpu = torch.empty((len(host_rows),) + tuple(weight.shape[1:]), dtype=weight.dtype, pin_memory=True)
+    if host_rows:
+        host_cpu.copy_(weight[host_rows].cpu())
+    host = get_accelerator_view_from_cpu_tensor(host_cpu)
+    row_bytes = weight[0].numel() * weight.element_size()
+    # the kernel adds the table entry to the resident tensor's base pointer, so entries are
+    # signed element offsets (host rows are far away in the same virtual address space)
+    esz = weight.element_size(); base = resident.data_ptr()
+    def _off(addr: int) -> int:
+        # signed 64-bit element offset from the resident base (pointer arithmetic wraps mod 2**64)
+        d = ((addr - base) + 2**63) % 2**64 - 2**63
+        assert d % esz == 0, (addr, base, esz)
+        return d // esz
+    table = torch.empty(E, dtype=torch.int64)
+    for i, e in enumerate(res_rows):
+        table[e] = _off(resident.data_ptr() + i * row_bytes)
+    for i, e in enumerate(host_rows):
+        table[e] = _off(host.data_ptr() + i * row_bytes)
+    return resident, host, table.to(weight.device)
+
+
+def maybe_place(layer: torch.nn.Module) -> None:
+    """Split this MoE layer's expert weights per the placement file (no-op when unset)."""
+    if not PLACEMENT_PATH:
+        return
+    idx = _layer_index(layer)
+    rows = _placement().get(idx, []) if idx is not None else []
+    if not rows:
+        return
+    for name in ("w13_weight", "w2_weight"):
+        param = getattr(layer, name)
+        weight = param.data
+        assert weight.dim() == 3 and weight.is_contiguous(), (name, weight.shape, weight.is_contiguous())
+        resident, host, table = _split(weight, rows)
+        new_param = torch.nn.Parameter(resident, requires_grad=False)
+        for attr in ("weight_loader",):
+            if hasattr(param, attr):
+                setattr(new_param, attr, getattr(param, attr))
+        new_param._q38_base_table = table
+        new_param._q38_host_storage = host  # keep the UVA view alive
+        new_param._q38_num_experts = weight.shape[0]
+        setattr(layer, name, new_param)
+        _STATS["host_bytes"] += host.numel() * host.element_size()
+        del weight, param
+    _STATS["layers"] += 1
+    _STATS["host_experts"] += len(rows)
+    torch.xpu.empty_cache()
+    logger.info(
+        "Q38_EXPERT_HOST_PLACEMENT layer %s: %d experts host-resident (%d/%d layers so far, %.2f GiB host)",
+        idx, len(rows), _STATS["layers"], _STATS["layers"], _STATS["host_bytes"] / 2**30,
+    )
