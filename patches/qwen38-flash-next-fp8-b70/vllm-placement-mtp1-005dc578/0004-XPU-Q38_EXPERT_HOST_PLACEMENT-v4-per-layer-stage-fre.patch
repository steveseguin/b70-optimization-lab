-                           tuple(weight.shape[1:]), weight.dtype, weight.device, getattr(param, "weight_loader", None)))
-            setattr(layer, name, torch.nn.Parameter(torch.empty(0, dtype=weight.dtype, device=weight.device), requires_grad=False))
-            del weight, param
-    torch.xpu.synchronize(); torch.xpu.empty_cache()
-    reserved_after_free = torch.xpu.memory_reserved() / 2**30
-    for layer, name, res_cpu, host_cpu, res_rows, rows, E, tail, dtype, device, loader in staged:
-        resident = torch.empty((len(res_rows),) + tail, dtype=dtype, device=device)
-        resident.copy_(res_cpu)
-        host = get_accelerator_view_from_cpu_tensor(host_cpu)
-        row_bytes = int(torch.tensor(tail).prod().item()) * resident.element_size()
-        new_param = torch.nn.Parameter(resident, requires_grad=False)
-        if loader is not None:
-            new_param.weight_loader = loader
-        new_param._q38_base_table = _table(resident, host, res_rows, rows, E, row_bytes)
-        new_param._q38_host_storage = host
-        new_param._q38_num_experts = E
-        setattr(layer, name, new_param)
-        _STATS["host_bytes"] += host.numel() * host.element_size()
-    del staged
-    torch.xpu.synchronize(); torch.xpu.empty_cache()
-    logger.info("Q38_EXPERT_HOST_PLACEMENT finalized: %d layers, %.2f GiB host-resident; allocator reserved %.3f GiB after freeing the originals, %.3f GiB after the compact reallocation",
-                len(_PENDING), _STATS["host_bytes"] / 2**30, reserved_after_free, torch.xpu.memory_reserved() / 2**30)
-    _PENDING.clear()
+    param = getattr(layer, name); weight = param.data
+    assert weight.dim() == 3 and weight.is_contiguous(), (name, weight.shape, weight.is_contiguous())
+    E = weight.shape[0]; host_set = set(rows); tail = tuple(weight.shape[1:]); dtype = weight.dtype; device = weight.device
+    res_rows = [e for e in range(E) if e not in host_set]
+    res_cpu = torch.empty((len(res_rows),) + tail, dtype=dtype, pin_memory=True)
+    res_cpu.copy_(weight[res_rows].cpu())
+    host_cpu = torch.empty((len(rows),) + tail, dtype=dtype, pin_memory=True)
+    host_cpu.copy_(weight[rows].cpu())
+    loader = getattr(param, "weight_loader", None)
+    setattr(layer, name, torch.nn.Parameter(torch.empty(0, dtype=dtype, device=device), requires_grad=False))
+    del weight, param
+    torch.xpu.synchronize(); torch.xpu.empty_cache()  # return the original's dedicated segment to the driver
+    resident = torch.empty((len(res_rows),) + tail, dtype=dtype, device=device)
+    resident.copy_(res_cpu)
+    del res_cpu
+    host = get_accelerator_view_from_cpu_tensor(host_cpu)
+    row_bytes = int(torch.tensor(tail).prod().item()) * resident.element_size()
+    new_param = torch.nn.Parameter(resident, requires_grad=False)
+    if loader is not None:
+        new_param.weight_loader = loader
+    new_param._q38_base_table = _table(resident, host, res_rows, rows, E, row_bytes)
+    new_param._q38_host_storage = host
+    new_param._q38_num_experts = E
+    setattr(layer, name, new_param)
+    _STATS["host_bytes"] += host.numel() * host.element_size()
 
 
