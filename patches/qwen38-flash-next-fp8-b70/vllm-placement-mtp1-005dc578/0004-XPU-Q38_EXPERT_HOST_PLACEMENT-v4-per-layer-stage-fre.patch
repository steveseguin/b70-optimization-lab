@@ -73,75 +73,57 @@ def _split(weight: torch.Tensor, host_rows: list[int]) -> tuple[torch.Tensor, to
     return resident, host, _table(resident, host, res_rows, host_rows, E, row_bytes)
 
 
-# Server path (v3): record the placed layers as their post-load hook runs; when the last placed
-# layer arrives, ranks take turns (distributed barrier) to stage ALL their resident rows on the
-# host, free every original device tensor, empty the cache so the allocator returns the
-# dedicated large segments to the driver, and only then allocate the compact resident copies.
-# Splitting layer by layer leaves each copy inside its original's segment (39 MB holes that the
-# driver never gets back: A196 reserved 30.7 GiB, A199 31.2 GiB).
-_PENDING: list[tuple[torch.nn.Module, int, list[int]]] = []
+# Server path (v4): per layer, stage the rows on the host (~760 MB pinned, transient), FREE the
+# original device tensor, empty the cache so its dedicated large segment goes back to the driver,
+# and only then allocate the compact resident copy, which gets a fresh exact-size segment.
+# (v2 allocated the copy before empty_cache and it landed inside the old segment, leaving holes
+# the driver never got back; v3 staged all rows at once and exceeded the host memory left next
+# to the PLE offload.)
 
 
-def _stage_rows(weight: torch.Tensor, rows: list[int]) -> torch.Tensor:
-    t = torch.empty((len(rows),) + tuple(weight.shape[1:]), dtype=weight.dtype, pin_memory=True)
-    if rows:
-        t.copy_(weight[rows].cpu())
-    return t
-
-
-def _finalize_rank() -> None:
+def _place_param(layer: torch.nn.Module, name: str, rows: list[int]) -> None:
     from vllm.utils.torch_utils import get_accelerator_view_from_cpu_tensor
 
-    staged = []
-    for layer, idx, rows in _PENDING:
-        for name in ("w13_weight", "w2_weight"):
