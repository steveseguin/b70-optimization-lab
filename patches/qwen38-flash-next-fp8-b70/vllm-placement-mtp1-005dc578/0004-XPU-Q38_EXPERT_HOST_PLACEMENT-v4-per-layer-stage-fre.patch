-    if pl and _STATS["layers"] == len(pl) and _PENDING:
-        from vllm.distributed import get_tensor_model_parallel_rank, get_tensor_model_parallel_world_size, get_tp_group
-        rank, world = get_tensor_model_parallel_rank(), get_tensor_model_parallel_world_size()
-        group = get_tp_group().cpu_group  # host-side barrier (gloo)
-        for r in range(world):
-            if r == rank:
