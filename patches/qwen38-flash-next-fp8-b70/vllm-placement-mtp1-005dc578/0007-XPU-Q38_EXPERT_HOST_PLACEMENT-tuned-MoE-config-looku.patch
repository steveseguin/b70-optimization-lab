From ccdf43edf0108c275e45d56cc6cbcc3fda02ffe3 Mon Sep 17 00:00:00 2001
From: Codex Agent <codex-agent@users.noreply.github.com>
Date: Sun, 6 Sep 2026 11:37:42 -0400
Subject: [PATCH 7/9] [XPU] Q38_EXPERT_HOST_PLACEMENT: tuned MoE config lookup
 keys on the logical expert count (placed layers are resident-sized and fell
 back to the default config)

Co-authored-by: Claude Fable 5.1 <noreply@anthropic.com>
---
 vllm/model_executor/layers/fused_moe/fused_moe.py | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/vllm/model_executor/layers/fused_moe/fused_moe.py b/vllm/model_executor/layers/fused_moe/fused_moe.py
index e17cb4cf4..e8dce1e82 100644
--- a/vllm/model_executor/layers/fused_moe/fused_moe.py
+++ b/vllm/model_executor/layers/fused_moe/fused_moe.py
@@ -1827,10 +1827,19 @@ def fused_experts_impl(
         use_int8_w8a8=use_int8_w8a8,
     )
 
+    # Q38_EXPERT_HOST_PLACEMENT: a placed layer's weight tensors are resident-sized
+    # (cold experts live in host rows behind the per-expert table); the tuned-map
+    # key must use the layer's logical expert count, not the resident row count.
+    _q38_logical_e = getattr(w1, "_q38_num_experts", None)
+    if _q38_logical_e:
+        _w1_cfg_shape = (int(_q38_logical_e),) + tuple(w1.size())[1:]
+        _w2_cfg_shape = (int(_q38_logical_e),) + tuple(w2.size())[1:]
+    else:
+        _w1_cfg_shape, _w2_cfg_shape = w1.size(), w2.size()
     get_config_func = functools.partial(
         try_get_optimal_moe_config,
-        w1.size(),
-        w2.size(),
+        _w1_cfg_shape,
+        _w2_cfg_shape,
         top_k_num,
         config_dtype,
         block_shape=block_shape,
-- 
