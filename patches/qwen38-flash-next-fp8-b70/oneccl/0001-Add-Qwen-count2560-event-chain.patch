+extern "C" CCL_API int ccl_b70_replay_last_bf16_allreduce_q38_count2560_event_chain(
+    const void* send_buf,
+    void* recv_buf,
+    size_t count,
+    void* queue,
+    const void* producer_event,
+    void* allreduce_event) {
+#if defined(CCL_ENABLE_ZE) || defined(CCL_ENABLE_SYCL)
+    if (!b70_q38_count2560_event_chain_enabled()) {
+        return 1;
+    }
+    if (b70_q38_count2560_event_chain_comm == nullptr ||
+        b70_q38_count2560_event_chain_stream == nullptr || send_buf == nullptr ||
+        recv_buf == nullptr || queue == nullptr || producer_event == nullptr ||
+        allreduce_event == nullptr || count != 2560 ||
+        reinterpret_cast<uintptr_t>(send_buf) % 4 != 0 ||
+        reinterpret_cast<uintptr_t>(recv_buf) % 4 != 0 ||
+        b70_q38_count2560_event_chain_comm->get_node_comm()->size() != 4 ||
+        ccl::global_data::env().sycl_enable_arc_allreduce ||
+        !is_arc_card(ccl::ze::get_device_family(
+            b70_q38_count2560_event_chain_stream->get_ze_device()))) {
+        return 2;
+    }
+
+    auto* current_queue = static_cast<sycl::queue*>(queue);
+    const auto recorded_queue =
+        b70_q38_count2560_event_chain_stream->get_native_stream();
+    if (!current_queue->has_property<sycl::property::queue::in_order>() ||
+        current_queue->get_context() != recorded_queue.get_context() ||
+        current_queue->get_device() != recorded_queue.get_device()) {
+        return 3;
+    }
+
+    vector_class<event> deps;
+    sycl::event producer = *static_cast<const sycl::event*>(producer_event);
+    deps.push_back(ccl::event::create_from_native(producer));
+    bool done = false;
+    auto ring_event = allreduce_ll_ring(send_buf,
+                                        recv_buf,
+                                        count,
+                                        ccl::datatype::bfloat16,
+                                        ccl::reduction::sum,
+                                        b70_q38_count2560_event_chain_comm,
+                                        b70_q38_count2560_event_chain_stream,
+                                        current_queue,
+                                        deps,
+                                        done);
+    *static_cast<sycl::event*>(allreduce_event) = ring_event.get_native();
+    return done ? 0 : 4;
+#else
+    return 5;
+#endif
+}
