+    def _xpu_cudagraph_zero_selected_replay_outputs(self, output: Any) -> int:
+        if not self._xpu_cudagraph_zero_replay_outputs_enabled():
+            return 0
+        indices = self._xpu_cudagraph_zero_replay_output_indices()
+        if not indices:
+            return 0
+        if not isinstance(output, (tuple, list)):
+            return 0
+
+        zeroed = 0
+        with torch.no_grad():
+            for index in indices:
+                if index < 0 or index >= len(output):
+                    continue
+                tensor = output[index]
+                if isinstance(tensor, torch.Tensor) and tensor.numel() > 0:
+                    tensor.zero_()
+                    zeroed += 1
+        return zeroed
