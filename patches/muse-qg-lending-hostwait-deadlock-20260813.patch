+static bool ggml_backend_meta_tensor_ranges_overlap(const ggml_tensor * first, const ggml_tensor * second) {
+    if (first == nullptr || second == nullptr || first->data == nullptr || second->data == nullptr) {
+        return false;
+    }
+    const uintptr_t first_begin = (uintptr_t) first->data;
+    const uintptr_t second_begin = (uintptr_t) second->data;
+    const size_t first_size = ggml_nbytes(first);
+    const size_t second_size = ggml_nbytes(second);
+    if (first_size == 0 || second_size == 0 ||
+        first_size > UINTPTR_MAX - first_begin || second_size > UINTPTR_MAX - second_begin) {
+        return true;
+    }
+    return first_begin < second_begin + second_size && second_begin < first_begin + first_size;
+}
