+static bool ggml_backend_meta_muse_qg_weight(const ggml_tensor * tensor, int * layer = nullptr) {
+    if (!ggml_backend_meta_muse_qg_lend_enabled() || tensor == nullptr ||
+        tensor->op != GGML_OP_NONE || tensor->type != GGML_TYPE_BF16 ||
+        tensor->ne[0] != 6656 || tensor->ne[1] != 4096 ||
+        tensor->ne[2] != 1 || tensor->ne[3] != 1) {
+        return false;
+    }
+
+    if (std::strncmp(tensor->name, "blk.", 4) != 0) {
+        return false;
+    }
+    char * end = nullptr;
+    const long il = std::strtol(tensor->name + 4, &end, 10);
+    if (end == tensor->name + 4 || il < 0 || il >= 52 ||
+        (std::strcmp(end, ".attn_q.weight") != 0 &&
+         std::strcmp(end, ".attn_gate.weight") != 0)) {
+        return false;
+    }
+    if (layer != nullptr) {
+        *layer = (int) il;
+    }
+    return true;
+}
