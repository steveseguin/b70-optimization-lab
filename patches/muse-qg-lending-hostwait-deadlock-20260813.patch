+static bool ggml_backend_meta_muse_qg_owners(
+        const ggml_backend_meta_split_state & split_state, std::array<bool, 4> & owners) {
+    if (split_state.axis != GGML_BACKEND_SPLIT_AXIS_1 ||
+        split_state.n_segments != 1 || split_state.nr[0] != 1) {
+        return false;
+    }
+    int n_owners = 0;
+    for (size_t j = 0; j < owners.size(); ++j) {
+        if (split_state.ne[j] != 0 && split_state.ne[j] != 2048) {
+            return false;
+        }
+        owners[j] = split_state.ne[j] == 2048;
+        n_owners += owners[j];
+    }
+    return n_owners == 2 && owners[0] == owners[2] && owners[1] == owners[3] && owners[0] != owners[1];
+}
