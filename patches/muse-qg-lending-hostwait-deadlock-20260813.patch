+static ggml_backend_meta_context::muse_qg_config ggml_backend_meta_muse_qg_plan(
+        ggml_backend_meta_context * backend_ctx, ggml_cgraph * cgraph, size_t i_graph) {
+    ggml_backend_meta_context::muse_qg_config result;
+    if (!ggml_backend_meta_muse_qg_lend_enabled() || backend_ctx->backend_configs.size() != 4 ||
+        backend_ctx->muse_qg_prepare == nullptr || backend_ctx->muse_qg_clear == nullptr) {
+        return result;
+    }
+
+    const size_t i_start = backend_ctx->backend_configs[0].cgraphs[i_graph].offset;
+    const size_t i_stop = i_graph + 1 < backend_ctx->n_subgraphs ?
+        backend_ctx->backend_configs[0].cgraphs[i_graph + 1].offset : (size_t) cgraph->n_nodes;
+    ggml_tensor * q_orig = nullptr;
+    ggml_tensor * gate_orig = nullptr;
+    int q_index = -1;
+    int gate_index = -1;
+    int layer = -1;
+
+    auto projection_layer = [](const ggml_tensor * tensor, const char * prefix) -> int {
+        if (tensor == nullptr || tensor->op != GGML_OP_MUL_MAT) {
+            return -1;
+        }
+        const size_t prefix_len = std::strlen(prefix);
+        if (std::strncmp(tensor->name, prefix, prefix_len) != 0 || tensor->name[prefix_len] == '\0') {
+            return -1;
+        }
+        char * end = nullptr;
+        const long value = std::strtol(tensor->name + prefix_len, &end, 10);
+        return end != tensor->name + prefix_len && *end == '\0' && value >= 0 && value < 52 ? (int) value : -1;
+    };
+
+    for (size_t i = i_start; i < i_stop; ++i) {
+        ggml_tensor * node = cgraph->nodes[i];
+        const int q_layer = projection_layer(node, "Qcur-");
+        const int gate_layer = projection_layer(node, "attn_gate_proj-");
+        if (q_layer >= 0) {
+            if (q_orig != nullptr) {
+                return result;
+            }
+            q_orig = node;
+            q_index = (int) i;
+            layer = q_layer;
+        }
+        if (gate_layer >= 0) {
+            if (gate_orig != nullptr) {
+                return result;
+            }
+            gate_orig = node;
+            gate_index = (int) i;
+            if (layer >= 0 && layer != gate_layer) {
+                return result;
+            }
+            layer = gate_layer;
+        }
+    }
+    if (q_orig == nullptr || gate_orig == nullptr || q_index < 0 || gate_index < 0 || q_index >= gate_index ||
+        q_orig->src[0] == nullptr || gate_orig->src[0] == nullptr ||
+        q_orig->src[1] == nullptr || q_orig->src[1] != gate_orig->src[1] ||
+        !ggml_backend_meta_muse_qg_weight(q_orig->src[0]) ||
+        !ggml_backend_meta_muse_qg_weight(gate_orig->src[0]) ||
+        std::strstr(q_orig->src[0]->name, ".attn_q.weight") == nullptr ||
+        std::strstr(gate_orig->src[0]->name, ".attn_gate.weight") == nullptr) {
+        return result;
+    }
+
+    std::array<bool, 4> q_owners = {};
+    std::array<bool, 4> gate_owners = {};
+    if (!ggml_backend_meta_muse_qg_owners(ggml_backend_meta_get_split_state(q_orig->src[0], false), q_owners) ||
+        !ggml_backend_meta_muse_qg_owners(ggml_backend_meta_get_split_state(gate_orig->src[0], false), gate_owners) ||
+        q_owners != gate_owners) {
+        return result;
+    }
+
+    for (size_t owner = 0; owner < 4; ++owner) {
+        if (!q_owners[owner]) {
+            continue;
+        }
+        const size_t helper = (owner + 3) % 4;
+        auto & owner_cfg = backend_ctx->backend_configs[owner];
+        auto & helper_cfg = backend_ctx->backend_configs[helper];
+        ggml_tensor * q = owner_cfg.nodes[q_index];
+        ggml_tensor * gate = owner_cfg.nodes[gate_index];
+        ggml_tensor * helper_x = helper_cfg.nodes[q_index]->src[1];
+        ggml_tensor * helper_q_weight = ggml_backend_meta_muse_qg_aux_weight(q_orig->src[0], owner);
+        ggml_tensor * helper_gate_weight = ggml_backend_meta_muse_qg_aux_weight(gate_orig->src[0], owner);
+        if (q == nullptr || gate == nullptr || helper_x == nullptr ||
+            helper_q_weight == nullptr || helper_gate_weight == nullptr ||
+            (q->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            (gate->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+            q->src[0] == nullptr || gate->src[0] == nullptr || q->src[1] == nullptr ||
+            q->src[1] != gate->src[1] || q->src[0]->type != GGML_TYPE_BF16 ||
+            gate->src[0]->type != GGML_TYPE_BF16 || helper_q_weight->type != GGML_TYPE_BF16 ||
+            helper_gate_weight->type != GGML_TYPE_BF16 || q->src[1]->type != GGML_TYPE_F32 ||
+            helper_x->type != GGML_TYPE_F32 || q->type != GGML_TYPE_F32 || gate->type != GGML_TYPE_F32 ||
+            q->src[0]->ne[0] != 6656 || q->src[0]->ne[1] != 2048 ||
+            gate->src[0]->ne[0] != 6656 || gate->src[0]->ne[1] != 2048 ||
+            helper_q_weight->ne[0] != 6656 || helper_q_weight->ne[1] != 1024 ||
+            helper_gate_weight->ne[0] != 6656 || helper_gate_weight->ne[1] != 1024 ||
+            q->src[1]->ne[0] != 6656 || q->src[1]->ne[1] != 16 ||
+            helper_x->ne[0] != 6656 || helper_x->ne[1] != 16 ||
+            q->ne[0] != 2048 || q->ne[1] != 16 || gate->ne[0] != 2048 || gate->ne[1] != 16 ||
+            !ggml_is_contiguous(q->src[0]) || !ggml_is_contiguous(gate->src[0]) ||
+            !ggml_is_contiguous(helper_q_weight) || !ggml_is_contiguous(helper_gate_weight) ||
+            !ggml_is_contiguous(q->src[1]) || !ggml_is_contiguous(helper_x) ||
+            !ggml_is_contiguous(q) || !ggml_is_contiguous(gate) ||
+            ggml_backend_meta_tensor_ranges_overlap(q, gate) ||
+            ggml_backend_meta_tensor_ranges_overlap(q, q->src[1]) ||
+            ggml_backend_meta_tensor_ranges_overlap(gate, q->src[1])) {
+            return {};
+        }
+
+        ggml_cgraph * helper_graph = helper_cfg.cgraphs[i_graph].cgraph_main;
+        int helper_x_index = -1;
+        for (int i = 0; i < helper_graph->n_nodes; ++i) {
+            if (helper_graph->nodes[i] == helper_x) {
+                helper_x_index = i;
+                break;
+            }
+        }
+        if (helper_x_index < 0) {
+            return {};
+        }
+        for (int i = helper_x_index + 1; i < helper_graph->n_nodes; ++i) {
+            const ggml_tensor * node = helper_graph->nodes[i];
+            if ((node->flags & GGML_TENSOR_FLAG_COMPUTE) != 0 &&
+                node->op != GGML_OP_NONE && node->op != GGML_OP_VIEW && node->op != GGML_OP_RESHAPE &&
+                node->op != GGML_OP_TRANSPOSE && node->op != GGML_OP_PERMUTE &&
+                ggml_backend_meta_tensor_ranges_overlap(node, helper_x)) {
+                return {};
+            }
+        }
+
+        result.owner_mask |= 1u << owner;
+        result.q[owner] = q;
+        result.gate[owner] = gate;
+        result.helper_q_weight[owner] = helper_q_weight;
+        result.helper_gate_weight[owner] = helper_gate_weight;
+        result.helper_activation[owner] = helper_x;
+    }
+    return result.owner_mask == 0x5 || result.owner_mask == 0xa ? result : ggml_backend_meta_context::muse_qg_config {};
+}
