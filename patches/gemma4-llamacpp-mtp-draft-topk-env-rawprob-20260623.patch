+llama_token_data_array * common_sampler_rescale_candidates_to_logits_probs(
+        struct common_sampler * gsmpl, struct llama_context * ctx, int idx, bool do_sort) {
+    const auto tm = gsmpl->tm();
+
+    auto * res = &gsmpl->cur_p;
+    const auto * logits = llama_get_logits_ith(ctx, idx);
+    if (logits == nullptr || res->size == 0) {
+        return common_sampler_get_candidates(gsmpl, do_sort);
+    }
+
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+
+    float max_l = logits[0];
+    for (int token_id = 1; token_id < n_vocab; ++token_id) {
+        max_l = std::max(max_l, logits[token_id]);
+    }
+
+    double sum = 0.0;
+    for (int token_id = 0; token_id < n_vocab; ++token_id) {
+        sum += std::exp((double) logits[token_id] - (double) max_l);
+    }
+    if (sum <= 0.0) {
+        return common_sampler_get_candidates(gsmpl, do_sort);
+    }
+
+    for (size_t i = 0; i < res->size; ++i) {
+        const llama_token token_id = res->data[i].id;
+        if (token_id < 0 || token_id >= n_vocab) {
+            res->data[i].p = 0.0f;
+            continue;
+        }
+        res->data[i].logit = logits[token_id];
+        res->data[i].p = (float) (std::exp((double) logits[token_id] - (double) max_l) / sum);
+    }
+    res->sorted = false;
+
+    return common_sampler_get_candidates(gsmpl, do_sort);
+}
+
 llama_token common_sampler_last(const struct common_sampler * gsmpl) {
     return gsmpl->prev.rat(0);
 }
