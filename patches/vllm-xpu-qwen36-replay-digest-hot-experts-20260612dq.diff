+                counter_tensor = state.get("counter")
+                if ring is None or counter_tensor is None:
+                    continue
+
+                counter = int(counter_tensor.detach().cpu().item())
+                previous = int(last_seen.get(key, 0))
+                if counter <= previous:
+                    continue
+
+                records_available = int(ring.shape[0])
+                begin = max(previous, counter - records_available)
+                if counter - begin > max_rows:
+                    begin = counter - max_rows
+                ring_cpu = ring.detach().cpu()
+
+                rows = []
+                for sequence in range(begin, counter):
+                    slot = abs(sequence) % records_available
+                    values = [int(v) for v in ring_cpu[slot].tolist()]
+                    rows.append({
+                        "sequence": sequence,
+                        "slot": slot,
+                        "valid_magic": values[0] == REPLAY_DIGEST_MAGIC,
+                        "values": values,
+                    })
