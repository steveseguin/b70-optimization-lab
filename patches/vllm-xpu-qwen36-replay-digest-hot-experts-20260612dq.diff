+#include "utils.h"
+
+namespace {
+
+constexpr int64_t kDigestBaseColumns = 16;
+constexpr int64_t kDigestMagic = 0x51573336444947LL;  // "QW36DIG"
+
+void require_xpu_contiguous(
+    const torch::Tensor& tensor,
+    const char* name,
+    at::ScalarType dtype) {
+  TORCH_CHECK(tensor.defined(), name, " must be defined");
+  TORCH_CHECK(tensor.is_xpu(), name, " must be an XPU tensor");
+  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
+  TORCH_CHECK(
+      tensor.scalar_type() == dtype,
+      name,
+      " dtype mismatch: expected ",
+      dtype,
+      " got ",
+      tensor.scalar_type());
+}
+
+}  // namespace
+
+torch::Tensor qwen36_moe_replay_digest_probe(
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& rows_per_expert,
+    const torch::Tensor& output,
+    torch::Tensor& digest_ring,
+    torch::Tensor& digest_counter,
+    int64_t layer_index,
+    int64_t max_records_arg,
+    int64_t max_topk_values_arg,
+    int64_t max_output_bytes_arg,
+    int64_t hot_experts_arg) {
+  require_xpu_contiguous(topk_ids, "topk_ids", at::ScalarType::Int);
+  require_xpu_contiguous(rows_per_expert, "rows_per_expert", at::ScalarType::Int);
+  require_xpu_contiguous(digest_ring, "digest_ring", at::ScalarType::Long);
+  require_xpu_contiguous(digest_counter, "digest_counter", at::ScalarType::Long);
+
+  TORCH_CHECK(output.defined(), "output must be defined");
+  TORCH_CHECK(output.is_xpu(), "output must be an XPU tensor");
+  TORCH_CHECK(output.is_contiguous(), "output must be contiguous");
+  TORCH_CHECK(
+      output.scalar_type() == at::ScalarType::BFloat16 ||
+          output.scalar_type() == at::ScalarType::Half ||
+          output.scalar_type() == at::ScalarType::Float,
+      "output must be bf16, fp16, or fp32, got ",
+      output.scalar_type());
+
+  TORCH_CHECK(topk_ids.dim() == 2, "topk_ids must be [num_rows, topk]");
+  TORCH_CHECK(rows_per_expert.dim() == 1, "rows_per_expert must be [experts]");
+  TORCH_CHECK(output.dim() == 2, "output must be [num_rows, hidden_size]");
+  TORCH_CHECK(digest_ring.dim() == 2, "digest_ring must be [records, columns]");
+  TORCH_CHECK(
+      digest_ring.size(1) >= kDigestBaseColumns,
+      "digest_ring needs at least ",
+      kDigestBaseColumns,
+      " columns");
+  TORCH_CHECK(digest_counter.numel() >= 1, "digest_counter must have one value");
+  TORCH_CHECK(
+      topk_ids.device() == output.device() &&
+          rows_per_expert.device() == output.device() &&
+          digest_ring.device() == output.device() &&
+          digest_counter.device() == output.device(),
+      "all tensors must be on the same XPU device");
+
+  const int64_t max_records =
+      std::min<int64_t>(std::max<int64_t>(max_records_arg, 0), digest_ring.size(0));
+  if (max_records == 0) {
+    return digest_ring;
+  }
+
+  const int64_t digest_stride = digest_ring.size(1);
+  const int64_t topk_values = std::min<int64_t>(
+      std::max<int64_t>(max_topk_values_arg, 0), topk_ids.numel());
+  const int64_t output_bytes_total = output.numel() * output.element_size();
+  const int64_t output_bytes = std::min<int64_t>(
+      std::max<int64_t>(max_output_bytes_arg, 0), output_bytes_total);
+
+  auto device_guard = at::DeviceGuard(output.device());
+  auto& queue = vllm::xpu::vllmGetQueue(output.device().index());
+
+  const int32_t* topk_ptr = topk_ids.data_ptr<int32_t>();
+  const int32_t* rows_ptr = rows_per_expert.data_ptr<int32_t>();
+  const uint8_t* output_ptr =
+      reinterpret_cast<const uint8_t*>(output.data_ptr());
+  int64_t* ring_ptr = digest_ring.data_ptr<int64_t>();
+  int64_t* counter_ptr = digest_counter.data_ptr<int64_t>();
+
+  const int64_t num_rows = topk_ids.size(0);
+  const int64_t topk = topk_ids.size(1);
+  const int64_t num_experts = rows_per_expert.numel();
+  const int64_t hidden_size = output.size(1);
+  const int64_t output_numel = output.numel();
+  const int64_t hot_capacity =
+      std::max<int64_t>((digest_stride - kDigestBaseColumns) / 2, 0);
+  const int64_t hot_experts = std::min<int64_t>(
+      std::min<int64_t>(std::max<int64_t>(hot_experts_arg, 0), num_experts),
+      hot_capacity);
+
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.single_task([=]() {
+      using atomic_i64 = sycl::atomic_ref<
+          int64_t,
+          sycl::memory_order::relaxed,
+          sycl::memory_scope::device,
+          sycl::access::address_space::global_space>;
+
+      atomic_i64 counter(counter_ptr[0]);
+      const int64_t sequence = counter.fetch_add(1);
+      const int64_t slot =
+          (sequence >= 0 ? sequence : -sequence) % max_records;
+      int64_t* row = ring_ptr + slot * digest_stride;
+
+      uint64_t route_hash = 1469598103934665603ULL;
+      for (int64_t i = 0; i < topk_values; ++i) {
+        const uint64_t value = static_cast<uint32_t>(topk_ptr[i]);
+        route_hash ^= value + 0x9e3779b97f4a7c15ULL +
+                      (route_hash << 6) + (route_hash >> 2);
+        route_hash *= 1099511628211ULL;
+      }
+
+      int64_t rows_sum = 0;
+      int64_t rows_nonzero = 0;
+      int64_t rows_max = 0;
+      uint64_t row_hash = 1469598103934665603ULL;
+      for (int64_t i = 0; i < num_experts; ++i) {
+        const int64_t value = static_cast<int64_t>(rows_ptr[i]);
+        rows_sum += value;
+        rows_nonzero += value != 0;
+        rows_max = value > rows_max ? value : rows_max;
+        row_hash ^= static_cast<uint64_t>(value + 0x10000 + i);
+        row_hash *= 1099511628211ULL;
+      }
+
+      uint64_t output_hash = 1469598103934665603ULL;
+      for (int64_t i = 0; i < output_bytes; ++i) {
+        output_hash ^= static_cast<uint64_t>(output_ptr[i]);
+        output_hash *= 1099511628211ULL;
+      }
+
+      row[0] = kDigestMagic;
+      row[1] = sequence;
+      row[2] = layer_index;
+      row[3] = num_rows;
+      row[4] = topk;
+      row[5] = num_experts;
+      row[6] = hidden_size;
+      row[7] = rows_sum;
+      row[8] = rows_nonzero;
+      row[9] = rows_max;
+      row[10] = static_cast<int64_t>(route_hash);
+      row[11] = static_cast<int64_t>(row_hash);
+      row[12] = output_numel;
+      row[13] = output_bytes;
+      row[14] = static_cast<int64_t>(output_hash);
+      row[15] = 1;
+
+      for (int64_t out_idx = 0; out_idx < hot_experts; ++out_idx) {
+        int64_t best_expert = -1;
+        int64_t best_count = -1;
+
+        for (int64_t expert = 0; expert < num_experts; ++expert) {
+          bool already_selected = false;
+          for (int64_t prev = 0; prev < out_idx; ++prev) {
+            if (row[kDigestBaseColumns + 2 * prev] == expert) {
+              already_selected = true;
+            }
+          }
+          if (already_selected) {
+            continue;
+          }
+
+          const int64_t count = static_cast<int64_t>(rows_ptr[expert]);
+          if (count > best_count) {
+            best_count = count;
+            best_expert = expert;
+          }
+        }
+
+        const int64_t base = kDigestBaseColumns + 2 * out_idx;
+        if (best_count > 0) {
+          row[base] = best_expert;
+          row[base + 1] = best_count;
+        } else {
+          row[base] = -1;
+          row[base + 1] = 0;
+        }
+      }
+    });
+  });
+
+  return digest_ring;
+}
