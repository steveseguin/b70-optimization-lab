+
+    def _get_int8_layer_scratch(
+        self,
+        hidden_states: torch.Tensor,
+        w1: torch.Tensor,
+        topk: int,
+        activation: MoEActivation,
+    ) -> dict[str, torch.Tensor] | None:
+        if not (self.is_int8 and _xpu_int8_moe_layer_scratch_enabled()):
+            return None
+        num_rows = hidden_states.shape[0]
+        max_rows = _xpu_int8_moe_layer_scratch_max_rows()
