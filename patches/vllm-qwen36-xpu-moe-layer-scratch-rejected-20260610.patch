+        hidden_size = hidden_states.shape[1]
+        inter_size = w1.shape[-1] // 2
+        inter_size_scale = 2 if activation.value == "relu2_no_mul" else 1
+        num_moe_inputs = num_rows * topk
+        dtype = hidden_states.dtype
+        device = hidden_states.device
+        key = (num_rows, hidden_size, inter_size, topk, inter_size_scale,
+               dtype, device)
+        scratch = self._xpu_int8_layer_scratch.get(key)
+        if scratch is not None:
+            return scratch
+        scratch = {
+            "remapped_hidden_states":
+            torch.empty((num_moe_inputs, hidden_size),
+                        dtype=dtype,
+                        device=device),
+            "gemm1_output":
+            torch.empty((num_moe_inputs, 2 * inter_size),
+                        dtype=dtype,
+                        device=device),
+            "act_output":
+            torch.empty((num_moe_inputs, inter_size * inter_size_scale),
+                        dtype=dtype,
+                        device=device),
+            "gemm2_output":
+            torch.empty((num_moe_inputs, hidden_size),
+                        dtype=dtype,
+                        device=device),
+            "rows_per_expert":
+            torch.empty((self.moe_config.num_local_experts, ),
+                        dtype=torch.int32,
+                        device=device),
+            "unpermuted_row_to_permuted_row":
+            torch.empty((num_rows, topk), dtype=torch.int32, device=device),
+        }
+        self._xpu_int8_layer_scratch[key] = scratch
+        return scratch
