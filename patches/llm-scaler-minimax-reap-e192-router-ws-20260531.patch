+template <typename DataT, typename IndexT>
+class MiniMaxM2CandidateScores;
+
+template <typename DataT, typename IndexT>
+static void minimax_m2_candidate_scores_kernel(
+    const DataT* x,
+    const IndexT* candidate_idx,
+    const float* gate_weight,
+    const float* e_score_bias,
+    float* exact_scores,
+    float* choice_scores,
+    const int n_tokens,
+    const int hidden_size,
+    const int top_m,
+    const torch::Device& device) {
+
+    auto cgf = [&](sycl::handler& cgh) {
+        cgh.parallel_for<MiniMaxM2CandidateScores<DataT, IndexT>>(
+            sycl::range<2>(n_tokens, top_m),
+            [=](sycl::id<2> id) {
+                const int token = (int)id[0];
+                const int pos = (int)id[1];
+                const int expert = (int)candidate_idx[(size_t)token * top_m + pos];
+
+                float acc = 0.0f;
+                const DataT* x_row = x + (size_t)token * hidden_size;
+                const float* w_row = gate_weight + (size_t)expert * hidden_size;
+                for (int k = 0; k < hidden_size; ++k) {
+                    acc += (float)x_row[k] * w_row[k];
+                }
+
+                const float score = 1.0f / (1.0f + sycl::exp(-acc));
+                const size_t out = (size_t)token * top_m + pos;
+                exact_scores[out] = score;
+                choice_scores[out] = score + e_score_bias[expert];
+            });
+    };
+    submit_kernel(cgf, device, "minimax m2 candidate scores");
+}
+
+template <typename IndexT>
+class MiniMaxM2CandidateTopK;
+
+template <typename IndexT>
+static void minimax_m2_candidate_topk_kernel(
+    const IndexT* candidate_idx,
+    const float* exact_scores,
+    const float* choice_scores,
+    float* topk_weight,
+    int32_t* topk_idx,
+    const int n_tokens,
+    const int top_m,
+    const int top_k,
+    const bool norm,
+    const torch::Device& device) {
+
+    auto cgf = [&](sycl::handler& cgh) {
+        cgh.parallel_for<MiniMaxM2CandidateTopK<IndexT>>(
+            sycl::range<1>(n_tokens),
+            [=](sycl::id<1> id) {
+                const int token = (int)id[0];
+                float best_choice[16];
+                float best_weight[16];
+                int best_idx[16];
+
+                for (int k = 0; k < 16; ++k) {
+                    best_choice[k] = -3.402823466e+38f;
+                    best_weight[k] = 0.0f;
+                    best_idx[k] = 0;
+                }
+
+                for (int pos = 0; pos < top_m; ++pos) {
+                    const size_t off = (size_t)token * top_m + pos;
+                    const float choice = choice_scores[off];
+                    int insert = -1;
+                    for (int k = 0; k < top_k; ++k) {
+                        if (choice > best_choice[k]) {
+                            insert = k;
+                            break;
+                        }
+                    }
+                    if (insert >= 0) {
+                        for (int k = top_k - 1; k > insert; --k) {
+                            best_choice[k] = best_choice[k - 1];
+                            best_weight[k] = best_weight[k - 1];
+                            best_idx[k] = best_idx[k - 1];
+                        }
+                        best_choice[insert] = choice;
+                        best_weight[insert] = exact_scores[off];
+                        best_idx[insert] =
+                            (int)candidate_idx[(size_t)token * top_m + pos];
+                    }
+                }
+
+                float denom = 0.0f;
+                for (int k = 0; k < top_k; ++k) {
+                    denom += best_weight[k];
+                }
+                const float inv = (norm && denom > 0.0f) ? (1.0f / denom) : 1.0f;
+
+                for (int k = 0; k < top_k; ++k) {
+                    topk_weight[(size_t)token * top_k + k] = best_weight[k] * inv;
+                    topk_idx[(size_t)token * top_k + k] = best_idx[k];
+                }
+            });
+    };
+    submit_kernel(cgf, device, "minimax m2 candidate topk");
+}
