+torch::Tensor moe_forward_tiny_cutlass_nmajor_int4_u4_minimax(
+    torch::Tensor x,
+    torch::Tensor w13_qweight_u4,
+    torch::Tensor w13_scales,
+    torch::Tensor w2_qweight_u4,
+    torch::Tensor w2_scales,
+    torch::Tensor router_logits,
+    torch::Tensor e_score_bias,
+    int64_t top_k,
+    bool norm) {
+
+    TORCH_CHECK(x.dim() == 2 && x.size(0) >= 1 && x.size(0) <= 4 && x.is_contiguous());
+    TORCH_CHECK(router_logits.dim() == 2 && router_logits.size(0) == x.size(0) &&
+                router_logits.is_contiguous());
+    TORCH_CHECK(router_logits.scalar_type() == torch::kFloat ||
+                router_logits.scalar_type() == torch::kHalf);
+    const int num_experts = (int)router_logits.size(1);
+    TORCH_CHECK(num_experts == 192 || num_experts == 256,
+                "MiniMax M2 fast path currently expects 192 or 256 routed experts");
+    TORCH_CHECK(e_score_bias.dim() == 1 && e_score_bias.size(0) == num_experts &&
+                e_score_bias.scalar_type() == torch::kFloat &&
+                e_score_bias.is_contiguous());
+    TORCH_CHECK(top_k == 8, "MiniMax M2 fast path currently expects top_k=8");
+
+    const int n_tokens = (int)x.size(0);
+    auto topk_weight = torch::empty({n_tokens, top_k},
+        torch::device(router_logits.device()).dtype(torch::kFloat32));
+    auto topk_idx = torch::empty({n_tokens, top_k},
+        torch::device(router_logits.device()).dtype(torch::kInt32));
+
+    sycl::queue& queue = c10::xpu::getCurrentXPUStream(router_logits.device().index()).queue();
+    if (router_logits.scalar_type() == torch::kFloat) {
+        minimax_m2_top8_sigmoid_bias_host<float>(
+            router_logits.data_ptr<float>(), e_score_bias.data_ptr<float>(),
+            topk_weight.data_ptr<float>(), topk_idx.data_ptr<int32_t>(),
+            n_tokens, num_experts, norm, queue);
+    } else {
+        minimax_m2_top8_sigmoid_bias_host<fp16>(
+            (const fp16*)router_logits.data_ptr(), e_score_bias.data_ptr<float>(),
+            topk_weight.data_ptr<float>(), topk_idx.data_ptr<int32_t>(),
+            n_tokens, num_experts, norm, queue);
+    }
+
+    return moe_forward_tiny_cutlass_nmajor_int4_impl(
+        x, w13_qweight_u4, w13_scales, w2_qweight_u4, w2_scales,
+        topk_weight, topk_idx, false);
+}
