+template<int C>
+SYCL_ESIMD_FUNCTION inline void minimax_argmax_and_suppress(
+    simd<float, C>& vals, int base_idx, float& out_val, int32_t& out_idx) {
+
+    float mx = h_max<float, C>(vals);
+    union { float f; int32_t i; } mx_bits;
+    mx_bits.f = mx;
+
+    simd<int32_t, C> vals_as_int = vals.template bit_cast_view<int32_t>().read();
+    simd_mask<C> mask = (vals_as_int == mx_bits.i);
+    simd<int32_t, C> cand(999999);
+    cand.merge(simd<int32_t, C>(base_idx, 1), mask);
+    int32_t found_idx = h_min<int32_t, C>(cand);
+
+    out_val = mx;
+    out_idx = found_idx;
+
+    int local_pos = found_idx - base_idx;
+    simd_mask<C> suppress_mask = (simd<int32_t, C>(0, 1) == local_pos);
+    vals.merge(simd<float, C>(-3.402823466e+38f), suppress_mask);
+}
+
+template<int NUM_EXPERTS, int TOPK, typename LogitsT, typename WeightT>
+struct MiniMaxM2TopKSigmoidBiasKernel {
+    const LogitsT* router_logits;
+    const float* e_score_bias;
+    WeightT* top_values;
+    int32_t* top_indices;
+    int T;
+    bool norm;
+
+    void operator()(sycl::nd_item<1> item) const SYCL_ESIMD_KERNEL {
+        static_assert(NUM_EXPERTS % 64 == 0, "NUM_EXPERTS must be multiple of 64");
+        static_assert(TOPK <= 16, "TOPK must be <= 16");
+        constexpr int C = 64;
+        constexpr int N_CHUNKS = NUM_EXPERTS / C;
+
+        int row = item.get_group(0);
+        if (row >= T) return;
+
+        const LogitsT* row_ptr = router_logits + (size_t)row * NUM_EXPERTS;
+        simd<float, C> choice[N_CHUNKS];
+        simd<float, C> weights[N_CHUNKS];
+
+        #pragma unroll
+        for (int c = 0; c < N_CHUNKS; c++) {
+            simd<float, C> raw;
+            if constexpr (std::is_same_v<LogitsT, float>) {
+                raw = block_load<float, C>((const float*)row_ptr + c * C);
+            } else {
+                simd<LogitsT, C> raw_h = block_load<LogitsT, C>(row_ptr + c * C);
+                raw = convert<float>(raw_h);
+            }
+            simd<float, C> score =
+                1.0f / (1.0f + esimd_math::exp<float, C>(-raw));
+            weights[c] = score;
+            choice[c] = score + block_load<float, C>(e_score_bias + c * C);
+        }
+
+        float tv[16];
+        float tw[16];
+        int32_t ti[16];
+
+        #pragma unroll
+        for (int k = 0; k < TOPK; k++) {
+            float best_val = -3.402823466e+38f;
+            int best_chunk = 0;
+            #pragma unroll
+            for (int c = 0; c < N_CHUNKS; c++) {
+                float m = h_max<float, C>(choice[c]);
+                if (m > best_val) {
+                    best_val = m;
+                    best_chunk = c;
+                }
+            }
+
+            float selected_choice;
+            int32_t selected_idx;
+            minimax_argmax_and_suppress<C>(
+                choice[best_chunk], best_chunk * C, selected_choice, selected_idx);
+            tv[k] = selected_choice;
+            ti[k] = selected_idx;
+            tw[k] = weights[best_chunk][selected_idx - best_chunk * C];
+        }
+
+        float denom = 0.0f;
+        #pragma unroll
+        for (int k = 0; k < TOPK; k++) {
+            denom += tw[k];
+        }
+        float inv = (norm && denom > 0.0f) ? (1.0f / denom) : 1.0f;
+
+        WeightT* vp = top_values + (size_t)row * TOPK;
+        int32_t* ip = top_indices + (size_t)row * TOPK;
+        if constexpr (TOPK >= 8) {
+            simd<float, 8> sv8;
+            simd<int32_t, 8> si8;
+            #pragma unroll
+            for (int i = 0; i < 8; i++) {
+                sv8[i] = tw[i] * inv;
+                si8[i] = ti[i];
+            }
+            if constexpr (std::is_same_v<WeightT, float>) {
+                block_store<float, 8>(vp, sv8);
+            } else {
+                block_store<WeightT, 8>(vp, convert<WeightT>(sv8));
+            }
+            block_store<int32_t, 8>(ip, si8);
+        }
+        if constexpr (TOPK > 8) {
+            #pragma unroll
+            for (int i = 8; i < TOPK; i++) {
+                if constexpr (std::is_same_v<WeightT, float>) {
+                    block_store<float, 1>(vp + i, simd<float, 1>(tw[i] * inv));
+                } else {
+                    block_store<WeightT, 1>(
+                        vp + i, convert<WeightT>(simd<float, 1>(tw[i] * inv)));
+                }
+                block_store<int32_t, 1>(ip + i, simd<int32_t, 1>(ti[i]));
+            }
+        }
+    }
+};
+
+template<typename LogitsT, typename WeightT>
+static void minimax_m2_top8_sigmoid_bias_host(
+    const LogitsT* router_logits,
+    const float* e_score_bias,
+    WeightT* top_values,
+    int32_t* top_indices,
+    int n_tokens,
+    int num_experts,
+    bool norm,
+    sycl::queue& queue) {
+
+    switch (num_experts) {
+    case 192:
+        queue.submit([&](sycl::handler& cgh) {
+            cgh.parallel_for(
+                sycl::nd_range<1>({(size_t)n_tokens}, {1}),
+                MiniMaxM2TopKSigmoidBiasKernel<192, 8, LogitsT, WeightT>{
+                    router_logits, e_score_bias, top_values, top_indices,
+                    n_tokens, norm});
+            });
+        break;
+    case 256:
+        queue.submit([&](sycl::handler& cgh) {
+            cgh.parallel_for(
+                sycl::nd_range<1>({(size_t)n_tokens}, {1}),
+                MiniMaxM2TopKSigmoidBiasKernel<256, 8, LogitsT, WeightT>{
+                    router_logits, e_score_bias, top_values, top_indices,
+                    n_tokens, norm});
+            });
+        break;
+    default:
+        TORCH_CHECK(false,
+                    "MiniMax M2 fast path currently expects 192 or 256 routed experts");
+    }
+}
