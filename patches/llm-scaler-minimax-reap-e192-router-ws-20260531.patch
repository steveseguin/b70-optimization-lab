+std::tuple<torch::Tensor, torch::Tensor> minimax_m2_candidate_repair_topk(
+    torch::Tensor x,
+    torch::Tensor candidate_idx,
+    torch::Tensor gate_weight,
+    torch::Tensor e_score_bias,
+    int64_t top_k,
+    bool norm) {
+
+    TORCH_CHECK(x.dim() == 2, "x must be [n_tokens, hidden_size]");
+    TORCH_CHECK(candidate_idx.dim() == 2, "candidate_idx must be [n_tokens, top_m]");
+    TORCH_CHECK(gate_weight.dim() == 2, "gate_weight must be [n_experts, hidden_size]");
+    TORCH_CHECK(e_score_bias.dim() == 1, "e_score_bias must be [n_experts]");
+    TORCH_CHECK(x.device().is_xpu(), "x must be on XPU");
+    TORCH_CHECK(candidate_idx.device() == x.device(), "candidate_idx must be on x device");
+    TORCH_CHECK(gate_weight.device() == x.device(), "gate_weight must be on x device");
+    TORCH_CHECK(e_score_bias.device() == x.device(), "e_score_bias must be on x device");
+    TORCH_CHECK(x.scalar_type() == torch::kHalf || x.scalar_type() == torch::kBFloat16,
+        "x must be fp16 or bf16");
+    TORCH_CHECK(candidate_idx.scalar_type() == torch::kInt ||
+                    candidate_idx.scalar_type() == torch::kLong,
+        "candidate_idx must be int32 or int64");
+    TORCH_CHECK(gate_weight.scalar_type() == torch::kFloat,
+        "gate_weight must be fp32");
+    TORCH_CHECK(e_score_bias.scalar_type() == torch::kFloat,
+        "e_score_bias must be fp32");
+    TORCH_CHECK(top_k > 0 && top_k <= 16, "top_k must be in [1, 16]");
+
+    x = x.contiguous();
+    candidate_idx = candidate_idx.contiguous();
+    gate_weight = gate_weight.contiguous();
+    e_score_bias = e_score_bias.contiguous();
+
+    const int n_tokens = (int)x.size(0);
+    const int hidden_size = (int)x.size(1);
+    const int top_m = (int)candidate_idx.size(1);
+    const int n_experts = (int)gate_weight.size(0);
+    TORCH_CHECK(candidate_idx.size(0) == n_tokens, "candidate_idx token count mismatch");
+    TORCH_CHECK(gate_weight.size(1) == hidden_size, "gate_weight hidden size mismatch");
+    TORCH_CHECK(e_score_bias.size(0) == n_experts, "bias expert count mismatch");
+    TORCH_CHECK(top_m >= top_k, "top_m must be >= top_k");
+
+    auto fopts = torch::device(x.device()).dtype(torch::kFloat);
+    auto iopts = torch::device(x.device()).dtype(torch::kInt32);
+    auto exact_scores = torch::empty({n_tokens, top_m}, fopts);
+    auto choice_scores = torch::empty({n_tokens, top_m}, fopts);
+    auto topk_weight = torch::empty({n_tokens, top_k}, fopts);
+    auto topk_idx = torch::empty({n_tokens, top_k}, iopts);
+
+    if (x.scalar_type() == torch::kHalf) {
+        if (candidate_idx.scalar_type() == torch::kInt) {
+            minimax_m2_candidate_scores_kernel<fp16, int32_t>(
+                (const fp16*)x.data_ptr(), candidate_idx.data_ptr<int32_t>(),
+                gate_weight.data_ptr<float>(), e_score_bias.data_ptr<float>(),
+                exact_scores.data_ptr<float>(), choice_scores.data_ptr<float>(),
+                n_tokens, hidden_size, top_m, x.device());
