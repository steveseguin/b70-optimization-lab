+    def _xpu_spec_decode_replacement_mask(
+        *,
+        metadata: SpecDecodeMetadata,
+        output_token_ids: torch.Tensor,
+    ) -> torch.Tensor | None:
+        """Mark rows whose final valid token is a rejection replacement.
+
+        For a row with k drafts, the rejection sampler returns either k+1
+        valid tokens for full acceptance (accepted drafts plus target bonus) or
+        p+1 valid tokens for a rejection after p accepted drafts.  Therefore,
+        a valid count less than or equal to k identifies a target-owned
+        replacement token.  XPU packed k>1 replacement rows are currently not
+        exact, so this opt-in guard lets the scheduler emit only accepted
+        drafts and recompute the replacement normally.
+        """
+        if not metadata.num_draft_tokens:
+            return None
+        if output_token_ids.ndim != 2:
+            return None
+
+        masks: list[torch.Tensor] = []
+        for row, num_draft_tokens in enumerate(metadata.num_draft_tokens):
+            if num_draft_tokens <= 0 or row >= output_token_ids.shape[0]:
+                masks.append(torch.tensor(False, device=output_token_ids.device))
+                continue
+            valid_count = (
+                output_token_ids[row] != PLACEHOLDER_TOKEN_ID
+            ).sum()
+            masks.append((valid_count > 0) & (valid_count <= num_draft_tokens))
+        if not masks:
+            return None
+        return torch.stack(masks).to(dtype=torch.bool)
