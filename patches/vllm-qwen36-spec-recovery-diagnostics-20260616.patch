+        if slot_mappings_by_group is not None:
+            slot_records: dict[str, Any] = {}
+            for group_index, mapping in slot_mappings_by_group.items():
+                slot_records[str(group_index)] = self._xpu_replay_tensor_record(
+                    mapping,
+                    include_topk=False,
+                )
+            tensor_records["slot_mappings_by_group"] = slot_records
+        if tensor_records:
+            record["tensors"] = tensor_records
+
+        row_records = self._xpu_replay_logit_row_records(
+            logits_indices=logits_indices,
+            input_ids=input_ids,
+            positions=positions,
+            slot_mappings_by_group=slot_mappings_by_group,
+            sample_hidden_states=sample_hidden_states,
+            logits=logits,
+            spec_decode_metadata=spec_decode_metadata,
+        )
+        if row_records:
+            record["logit_rows"] = row_records
+
+        try:
+            with open(self.xpu_replay_microscope_file, "a", encoding="utf-8") as f:
+                f.write(
+                    json.dumps(record, separators=(",", ":"), allow_nan=False)
+                    + "\n"
+                )
+            self.xpu_replay_microscope_lines += 1
+        except Exception:
+            logger.exception("Failed to write XPU replay microscope trace")
