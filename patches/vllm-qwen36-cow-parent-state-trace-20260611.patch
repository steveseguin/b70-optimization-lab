+    def _spec_trace_request_state(self, request: Request) -> dict[str, Any]:
+        """Snapshot request counters for opt-in speculative debug traces."""
+        return {
+            "num_prompt_tokens": request.num_prompt_tokens,
+            "num_output_tokens": request.num_output_tokens,
+            "num_tokens": request.num_tokens,
+            "num_tokens_with_spec": request.num_tokens_with_spec,
+            "num_computed_tokens": request.num_computed_tokens,
+            "num_output_placeholders": request.num_output_placeholders,
+            "spec_len": len(request.spec_token_ids),
+            "spec_token_ids": list(request.spec_token_ids),
+            "max_tokens": request.max_tokens,
+            "is_prefill_chunk": request.is_prefill_chunk,
+            "status": str(request.status),
+            "last_output_token_ids": list(request.output_token_ids[-16:]),
+        }
+
+    def _cow_trace_request_state(self, request: Request) -> dict[str, Any]:
+        """Snapshot parent request/KV state for COW verifier diagnostics."""
+        state = self._spec_trace_request_state(request)
+        try:
+            kv_blocks = self.kv_cache_manager.get_blocks(request.request_id)
+            block_ids = kv_blocks.get_block_ids()
+            state["kv_block_lengths"] = [len(ids) for ids in block_ids]
+            state["kv_last_block_ids"] = [list(ids[-4:]) for ids in block_ids]
+        except Exception as exc:
+            state["kv_block_error"] = repr(exc)
+        return state
+
+    def _cow_trace_delta(
+        self,
+        before: dict[str, Any] | None,
+        after: dict[str, Any],
+    ) -> dict[str, Any] | None:
+        if before is None:
+            return None
+        keys = (
+            "num_output_tokens",
+            "num_tokens",
+            "num_tokens_with_spec",
+            "num_computed_tokens",
+            "num_output_placeholders",
+            "spec_len",
+        )
+        delta: dict[str, Any] = {}
+        for key in keys:
+            before_value = before.get(key)
+            after_value = after.get(key)
+            if isinstance(before_value, int) and isinstance(after_value, int):
+                delta[key] = after_value - before_value
+        if before.get("kv_block_lengths") != after.get("kv_block_lengths"):
+            delta["kv_block_lengths_changed"] = True
+            delta["kv_block_lengths_before"] = before.get("kv_block_lengths")
+            delta["kv_block_lengths_after"] = after.get("kv_block_lengths")
+        return delta
+
+    def _trace_cow_parent_event(
+        self,
+        *,
+        stage: str,
+        req_id: str,
+        scheduler_output: SchedulerOutput,
+        request: Request,
+        state_before: dict[str, Any] | None = None,
+        extra: dict[str, Any] | None = None,
+    ) -> None:
+        if not self.cow_verifier_trace_file:
+            return
+        if (self.cow_verifier_trace_max_lines > 0
+                and self.cow_verifier_trace_lines >=
+                self.cow_verifier_trace_max_lines):
+            return
+        state_after = self._cow_trace_request_state(request)
+        record = {
+            "ts": time.time(),
+            "stage": stage,
+            "req_id": req_id,
+            "num_scheduled_tokens":
+            scheduler_output.num_scheduled_tokens.get(req_id),
+            "scheduled_spec_token_ids":
+            scheduler_output.scheduled_spec_decode_tokens.get(req_id, []),
+            "state_before": state_before,
+            "state_after": state_after,
+            "delta": self._cow_trace_delta(state_before, state_after),
+        }
+        if extra:
+            record.update(extra)
+        try:
+            with open(self.cow_verifier_trace_file, "a",
+                      encoding="utf-8") as f:
+                f.write(json.dumps(record, separators=(",", ":")) + "\n")
+            self.cow_verifier_trace_lines += 1
+        except Exception:
+            logger.exception("Failed to write COW verifier trace record")
+
+    def _trace_cow_parent_states(
