+    def _mark_dirty(self, row_idx: int) -> None:
+        if self._xpu_dirty_commit_enabled:
+            self._dirty_rows[row_idx] = True
+
+    def _commit_dirty_block_table(self, num_reqs: int) -> None:
+        if num_reqs <= 0:
+            return
+
+        self._dirty_commit_total += 1
+        dirty = self._dirty_rows[:num_reqs]
+        dirty_count = int(dirty.sum())
+        if dirty_count == 0:
+            self._dirty_commit_skipped += 1
+            self._maybe_log_dirty_commit_stats()
+            return
+
+        if dirty_count == num_reqs:
+            self.block_table.copy_to_gpu(num_reqs)
+            dirty[:] = False
+            self._dirty_commit_full += 1
+            self._dirty_commit_rows += dirty_count
+            self._maybe_log_dirty_commit_stats()
+            return
+
+        dirty_indices = np.flatnonzero(dirty)
+        start = int(dirty_indices[0])
+        prev = start
+        for raw_idx in dirty_indices[1:]:
+            idx = int(raw_idx)
+            if idx != prev + 1:
+                self.block_table.gpu[start : prev + 1].copy_(
+                    self.block_table.cpu[start : prev + 1],
+                    non_blocking=True,
+                )
+                start = idx
+            prev = idx
+        self.block_table.gpu[start : prev + 1].copy_(
+            self.block_table.cpu[start : prev + 1],
+            non_blocking=True,
+        )
+        dirty[dirty_indices] = False
+        self._dirty_commit_partial += 1
+        self._dirty_commit_rows += dirty_count
+        self._maybe_log_dirty_commit_stats()
+
+    def _maybe_log_dirty_commit_stats(self) -> None:
+        if (
+            self._dirty_commit_log_every <= 0
+            or self._dirty_commit_total % self._dirty_commit_log_every != 0
+        ):
+            return
+        logger.info(
+            "XPU block-table dirty commits: total=%d skipped=%d full=%d "
+            "partial=%d copied_rows=%d",
+            self._dirty_commit_total,
+            self._dirty_commit_skipped,
+            self._dirty_commit_full,
+            self._dirty_commit_partial,
+            self._dirty_commit_rows,
+        )
