+    def _xpu_gdn_accepted_prefix_counts_enabled(self) -> bool:
+        return (
+            os.environ.get("VLLM_XPU_GDN_ACCEPTED_PREFIX_COUNTS", "")
+            .strip()
+            .lower()
+            in ("1", "true", "yes", "on")
+        )
+
+    def _xpu_compute_gdn_accepted_prefix_counts(
+        self,
+        output_token_ids: torch.Tensor,
+        scheduler_output: "SchedulerOutput",
+        raw_accepted_token_counts: torch.Tensor,
+        num_reqs: int,
+        xpu_suppressed_bonus_mask: torch.Tensor | None,
+        xpu_suppressed_replacement_mask: torch.Tensor | None,
+    ) -> torch.Tensor | None:
+        """Map scheduler-visible verifier rows to draft-owned prefix lengths.
+
+        ``num_accepted_tokens`` is shared with scheduler/Mamba bookkeeping and
+        can include target-owned replacement/bonus rows. GDN/DeltaNet state
+        commits must instead select only the draft-owned prefix row that was
+        actually verified. Keep this separate and default-off so existing
+        state accounting remains unchanged.
+        """
+        if (
+            not self._xpu_gdn_accepted_prefix_counts_enabled()
+            or not scheduler_output.scheduled_spec_decode_tokens
+        ):
+            return None
+
+        prefix_counts = torch.ones_like(raw_accepted_token_counts)
+        draft_only = (
+            os.environ.get("VLLM_XPU_SPEC_DECODE_DRAFT_ONLY", "")
+            .strip()
+            .lower()
+            in ("1", "true", "yes", "on")
+        )
+        for i, req_id in enumerate(self.input_batch.req_ids[:num_reqs]):
+            if req_id is None:
+                continue
+            scheduled_spec_ids = (
+                scheduler_output.scheduled_spec_decode_tokens.get(req_id)
+            )
+            if not scheduled_spec_ids:
+                continue
+            try:
+                visible_count = int(raw_accepted_token_counts[i].item())
+            except Exception:
+                visible_count = 0
+            num_draft_tokens = len(scheduled_spec_ids)
+            if visible_count <= 0 or num_draft_tokens <= 0:
+                prefix_counts[i] = 0
+                continue
+
+            visible_count = min(visible_count, int(output_token_ids.size(1)))
+            row_valid = output_token_ids[i, :visible_count]
+            prefix_count = 0
+            if draft_only:
+                prefix_count = min(visible_count, num_draft_tokens)
+            else:
+                scheduled_tensor = torch.tensor(
+                    scheduled_spec_ids,
+                    dtype=output_token_ids.dtype,
+                    device=output_token_ids.device,
+                )
+                direct_full_accept = (
+                    visible_count == num_draft_tokens
+                    and torch.equal(row_valid, scheduled_tensor)
+                )
+                shifted_full_accept = (
+                    num_draft_tokens > 1
+                    and visible_count == num_draft_tokens - 1
+                    and torch.equal(
+                        row_valid,
+                        scheduled_tensor[1:1 + visible_count],
+                    )
+                )
+                suppressed_target_owned_tail = (
+                    _xpu_mask_row_true(xpu_suppressed_bonus_mask, i)
+                    or _xpu_mask_row_true(xpu_suppressed_replacement_mask, i)
+                )
+                if direct_full_accept:
+                    prefix_count = num_draft_tokens
+                elif shifted_full_accept:
+                    prefix_count = visible_count
+                elif visible_count == num_draft_tokens + 1:
+                    prefix_count = num_draft_tokens
+                elif suppressed_target_owned_tail:
+                    prefix_count = min(
+                        max(visible_count - 1, 0),
+                        num_draft_tokens,
+                    )
+                elif visible_count <= num_draft_tokens:
+                    prefix_count = max(visible_count - 1, 0)
+                else:
+                    prefix_count = num_draft_tokens
+            prefix_counts[i] = max(0, min(prefix_count, num_draft_tokens))
+        return prefix_counts
