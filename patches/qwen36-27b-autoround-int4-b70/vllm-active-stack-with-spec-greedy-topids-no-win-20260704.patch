+        num_scheduled_tokens, _ = self._xpu_dummy_schedule_for_shape(
+            num_tokens, uniform_decode, create_mixed_batch
+        )
+        if np.all(num_scheduled_tokens == 1):
+            return None
+        logit_indices = np.cumsum(num_scheduled_tokens) - 1
+        return tuple(int(index) for index in logit_indices)
+
+    def _xpu_dummy_metadata_key_for_shape(
+        self,
+        num_tokens: int,
+        uniform_decode: bool,
+        create_mixed_batch: bool = False,
+        profile_seq_lens: int | None = None,
