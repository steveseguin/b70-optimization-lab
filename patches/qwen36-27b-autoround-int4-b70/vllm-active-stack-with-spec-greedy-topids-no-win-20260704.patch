+        num_scheduled_tokens, max_query_len = self._xpu_dummy_schedule_for_shape(
+            num_tokens, uniform_decode, create_mixed_batch
+        )
+        num_reqs = len(num_scheduled_tokens)
+        if profile_seq_lens is not None:
+            seq_lens = np.full(num_reqs, profile_seq_lens, dtype=np.int32)
+        elif create_mixed_batch:
