diff --git a/csrc/xpu/qwen_gemma_rms_norm.cpp b/csrc/xpu/qwen_gemma_rms_norm.cpp
new file mode 100644
index 0000000..12b9aa3
--- /dev/null
+++ b/csrc/xpu/qwen_gemma_rms_norm.cpp
@@ -0,0 +1,237 @@
+#include <ATen/DeviceGuard.h>
+#include <sycl/sycl.hpp>
+#include <torch/all.h>
+
+#include <algorithm>
+#include <limits>
+
+#include "utils.h"
+
+namespace {
+
+template <typename scalar_t>
+class qwen_gemma_rms_norm_f32_weight_kernel {
+ public:
+  qwen_gemma_rms_norm_f32_weight_kernel(
+      scalar_t* output,
+      const scalar_t* input,
+      const float* weight,
+      int64_t input_stride_d2,
+      int64_t input_stride_d3,
+      int64_t input_stride_d4,
+      int64_t input_shape_d2,
+      int64_t input_shape_d3,
+      int num_dims,
+      int hidden_size,
+      float epsilon,
+      sycl::local_accessor<float, 1> inverse_rms)
+      : output_(output),
+        input_(input),
+        weight_(weight),
+        input_stride_d2_(input_stride_d2),
+        input_stride_d3_(input_stride_d3),
+        input_stride_d4_(input_stride_d4),
+        input_shape_d2_(input_shape_d2),
+        input_shape_d3_(input_shape_d3),
+        num_dims_(num_dims),
+        hidden_size_(hidden_size),
+        epsilon_(epsilon),
+        inverse_rms_(inverse_rms) {}
+
+  void operator() [[sycl::reqd_sub_group_size(32)]] (
+      const sycl::nd_item<1>& item) const {
+    const int64_t row = item.get_group(0);
+    int64_t input_offset = 0;
+    if (num_dims_ == 2) {
+      input_offset = row * input_stride_d2_;
+    } else if (num_dims_ == 3) {
+      const int64_t batch = row / input_shape_d2_;
+      const int64_t head = row % input_shape_d2_;
+      input_offset = batch * input_stride_d3_ + head * input_stride_d2_;
+    } else {
+      const int64_t rows_per_batch = input_shape_d3_ * input_shape_d2_;
+      const int64_t batch = row / rows_per_batch;
+      const int64_t within_batch = row % rows_per_batch;
+      const int64_t sequence = within_batch / input_shape_d2_;
+      const int64_t head = within_batch % input_shape_d2_;
+      input_offset = batch * input_stride_d4_ +
+                     sequence * input_stride_d3_ + head * input_stride_d2_;
+    }
+
+    const scalar_t* input_row = input_ + input_offset;
+    float sum_squares = 0.0f;
+    for (int column = item.get_local_id(0); column < hidden_size_;
+         column += item.get_local_range(0)) {
+      const float value = static_cast<float>(input_row[column]);
+      sum_squares += value * value;
+    }
+
+    sum_squares = sycl::reduce_over_group(
+        item.get_group(), sum_squares, sycl::plus<float>());
+    if (item.get_local_id(0) == 0) {
+      inverse_rms_[0] =
+          sycl::rsqrt(sum_squares / static_cast<float>(hidden_size_) + epsilon_);
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+
+    const float scale = inverse_rms_[0];
+    scalar_t* output_row = output_ + row * hidden_size_;
+    for (int column = item.get_local_id(0); column < hidden_size_;
+         column += item.get_local_range(0)) {
+      const float value = static_cast<float>(input_row[column]);
+      output_row[column] =
+          static_cast<scalar_t>(value * scale * weight_[column]);
+    }
+  }
+
+ private:
+  scalar_t* output_;
+  const scalar_t* input_;
+  const float* weight_;
+  const int64_t input_stride_d2_;
+  const int64_t input_stride_d3_;
+  const int64_t input_stride_d4_;
+  const int64_t input_shape_d2_;
+  const int64_t input_shape_d3_;
+  const int num_dims_;
+  const int hidden_size_;
+  const float epsilon_;
+  sycl::local_accessor<float, 1> inverse_rms_;
+};
+
+}  // namespace
+
+template <typename torch_scalar_t>
+void launch_qwen_gemma_rms_norm_f32_weight(
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    torch::Tensor& output,
+    double epsilon,
+    int num_rows,
+    int hidden_size,
+    int num_dims,
+    int64_t stride_d2,
+    int64_t stride_d3,
+    int64_t stride_d4,
+    int64_t shape_d2,
+    int64_t shape_d3) {
+  using sycl_t = typename vllm::xpu::SyclTypeTrait<torch_scalar_t>::Type;
+  auto* input_ptr = reinterpret_cast<const sycl_t*>(
+      input.data_ptr<torch_scalar_t>());
+  auto* output_ptr =
+      reinterpret_cast<sycl_t*>(output.data_ptr<torch_scalar_t>());
+  const float* weight_ptr = weight.data_ptr<float>();
+  const size_t local_size = static_cast<size_t>(std::min(hidden_size, 1024));
+  auto& queue = vllm::xpu::vllmGetQueue(input.device().index());
+  TORCH_CHECK(
+      queue.has_property<sycl::property::queue::in_order>(),
+      "qwen Gemma RMSNorm requires an in-order XPU queue");
+
+  auto done = queue.submit([&](sycl::handler& handler) {
+    sycl::local_accessor<float, 1> inverse_rms(sycl::range<1>(1), handler);
+    handler.parallel_for(
+        sycl::nd_range<1>(
+            sycl::range<1>(static_cast<size_t>(num_rows) * local_size),
+            sycl::range<1>(local_size)),
+        qwen_gemma_rms_norm_f32_weight_kernel<sycl_t>(
+            output_ptr,
+            input_ptr,
+            weight_ptr,
+            stride_d2,
+            stride_d3,
+            stride_d4,
+            shape_d2,
+            shape_d3,
+            num_dims,
+            hidden_size,
+            static_cast<float>(epsilon),
+            inverse_rms));
+  });
+  queue.ext_oneapi_submit_barrier({done});
+}
+
+torch::Tensor qwen_gemma_rms_norm_f32_weight_out(
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    torch::Tensor& output,
+    double epsilon) {
+  const at::DeviceGuard device_guard(input.device());
+  TORCH_CHECK(input.is_xpu(), "qwen Gemma RMSNorm input must be on XPU");
+  TORCH_CHECK(weight.is_xpu(), "qwen Gemma RMSNorm weight must be on XPU");
+  TORCH_CHECK(output.is_xpu(), "qwen Gemma RMSNorm output must be on XPU");
+  TORCH_CHECK(
+      input.device() == weight.device() && input.device() == output.device(),
+      "qwen Gemma RMSNorm tensors must be on the same XPU device");
+  TORCH_CHECK(
+      input.scalar_type() == torch::kFloat16 ||
+          input.scalar_type() == torch::kFloat32,
+      "qwen Gemma RMSNorm requires FP16 or FP32 input");
+  TORCH_CHECK(
+      weight.scalar_type() == torch::kFloat32,
+      "qwen Gemma RMSNorm requires FP32 weight");
+  TORCH_CHECK(
+      output.scalar_type() == input.scalar_type(),
+      "qwen Gemma RMSNorm output dtype must match input dtype");
+  TORCH_CHECK(
+      input.dim() >= 2 && input.dim() <= 4,
+      "qwen Gemma RMSNorm expects rank 2, 3, or 4 input");
+  TORCH_CHECK(input.size(-1) > 0, "qwen Gemma RMSNorm hidden size must be positive");
+  TORCH_CHECK(
+      input.size(-1) % 32 == 0,
+      "qwen Gemma RMSNorm hidden size must be divisible by 32");
+  TORCH_CHECK(input.stride(-1) == 1, "qwen Gemma RMSNorm input last dimension must be contiguous");
+  TORCH_CHECK(weight.dim() == 1, "qwen Gemma RMSNorm weight must be rank 1");
+  TORCH_CHECK(weight.is_contiguous(), "qwen Gemma RMSNorm weight must be contiguous");
+  TORCH_CHECK(
+      weight.numel() == input.size(-1),
+      "qwen Gemma RMSNorm weight size must equal input hidden size");
+  TORCH_CHECK(output.is_contiguous(), "qwen Gemma RMSNorm output must be contiguous");
+  TORCH_CHECK(output.sizes() == input.sizes(), "qwen Gemma RMSNorm output shape mismatch");
+
+  const int64_t hidden_size_i64 = input.size(-1);
+  const int64_t num_rows_i64 = input.numel() / hidden_size_i64;
+  TORCH_CHECK(
+      hidden_size_i64 <= std::numeric_limits<int>::max() &&
+          num_rows_i64 <= std::numeric_limits<int>::max(),
+      "qwen Gemma RMSNorm dimensions exceed kernel limits");
+
+  const int hidden_size = static_cast<int>(hidden_size_i64);
+  const int num_rows = static_cast<int>(num_rows_i64);
+  const int num_dims = input.dim();
