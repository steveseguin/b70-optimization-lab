+template <typename T>
+void trace_conv_publish_once(
+    sycl::queue& queue,
+    const torch::Tensor& conv_state,
+    const torch::Tensor& state_indices) {
+  if (!gdn_env_truthy("VLLM_XPU_GDN_TRACE_CONV_PUBLISH_ONCE")) {
+    return;
+  }
+  static std::once_flag trace_once;
+  std::call_once(trace_once, [&] {
+    TORCH_CHECK(state_indices.size(0) >= 1 && state_indices.size(1) >= 4);
+    std::array<int, 4> slots{};
+    const auto* state_ptr = reinterpret_cast<const int*>(state_indices.data_ptr());
+    for (int col = 0; col < 4; ++col) {
+      queue
+          .memcpy(
+              &slots[col],
+              state_ptr + col * state_indices.stride(1),
+              sizeof(int))
+          .wait_and_throw();
+    }
+
+    const auto* conv_ptr = reinterpret_cast<const T*>(conv_state.data_ptr());
+    for (int col = 0; col < 4; ++col) {
+      std::array<T, 3> history{};
+      for (int pos = 0; pos < 3; ++pos) {
+        queue
+            .memcpy(
+                &history[pos],
+                conv_ptr + static_cast<int64_t>(slots[col]) *
+                               conv_state.stride(0) +
+                    static_cast<int64_t>(pos) * conv_state.stride(1),
+                sizeof(T))
+            .wait_and_throw();
+      }
+      TORCH_WARN(
+          "VLLM_XPU_GDN_TRACE_CONV_PUBLISH_ONCE col=",
+          col,
+          " slot=",
+          slots[col],
+          " channel0_history=[",
+          static_cast<float>(history[0]),
+          ",",
+          static_cast<float>(history[1]),
+          ",",
+          static_cast<float>(history[2]),
+          "]");
+    }
+  });
+}
