+    def _get_top_tokens_int8_chunked(
+        self,
+        lm_head: VocabParallelEmbedding,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor:
+        """Diagnostic INT8 LM-head top-1 without materializing full logits.
+
+        This is intentionally a Python/chunked screen, not the final optimized
+        design. It reuses the existing runtime INT8 LM-head buffers, computes
+        chunk logits with oneDNN, reduces each chunk to top-1, and keeps only
+        the best token ID per row. If this loses, a naïve fused kernel is
+        unlikely to be worth building; if it wins, a real fused kernel can
+        remove the Python loop and intermediate chunk tensors.
+        """
+        x = hidden_states if hidden_states.is_contiguous() else hidden_states.contiguous()
+        x_q, x_scale = torch.ops._xpu_C.per_token_quant_int8_xpu(x)
+        weight_t = lm_head._xpu_lm_head_int8_weight_t
+        weight_scale = lm_head._xpu_lm_head_int8_scale
+
+        org_vocab_start = int(lm_head.shard_indices.org_vocab_start_index)
+        local_vocab = int(self.org_vocab_size - org_vocab_start)
+        local_vocab = max(0, min(local_vocab, int(weight_t.shape[1])))
+        if local_vocab <= 0:
+            return torch.zeros(
+                (x.shape[0],), dtype=torch.int64, device=x.device)
+
+        chunk_size = int(os.environ.get(
+            "VLLM_XPU_LM_HEAD_INT8_TOP1_CHUNK_SIZE", "32768") or "32768")
+        chunk_size = max(1024, min(chunk_size, local_vocab))
+
+        best_vals: torch.Tensor | None = None
+        best_ids: torch.Tensor | None = None
+        for start in range(0, local_vocab, chunk_size):
+            end = min(start + chunk_size, local_vocab)
+            logits = torch.ops._xpu_C.int8_gemm_w8a8(
+                x_q,
+                x_scale,
+                weight_t[:, start:end],
+                weight_scale[start:end],
+                lm_head.weight.dtype,
+                None,
+            )
+            if (
+                os.environ.get("VLLM_XPU_SANITIZE_LOGITS_NAN", "0") == "1"
+                and logits.device.type == "xpu"
+            ):
+                logits = torch.nan_to_num(
+                    logits,
+                    nan=-float("inf"),
+                    posinf=torch.finfo(logits.dtype).max,
+                    neginf=-float("inf"),
+                )
+            vals, ids = logits.max(dim=-1)
+            ids = ids.to(torch.int64) + start + org_vocab_start
+            vals = vals.float()
+            if best_vals is None:
+                best_vals = vals
+                best_ids = ids
+            else:
+                update = vals > best_vals
+                best_vals = torch.where(update, vals, best_vals)
+                best_ids = torch.where(update, ids, best_ids)
+        assert best_ids is not None
+        trace_tensor("logits_processor.local_argmax_int8_chunked_top1", best_ids)
+        return best_ids
+
     def extra_repr(self) -> str:
