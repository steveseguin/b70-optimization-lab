+            num_tokens, uniform_decode, create_mixed_batch
+        )
+        if np.all(num_scheduled_tokens == 1):
+            return None
+        logit_indices = np.cumsum(num_scheduled_tokens) - 1
+        return tuple(int(index) for index in logit_indices)
