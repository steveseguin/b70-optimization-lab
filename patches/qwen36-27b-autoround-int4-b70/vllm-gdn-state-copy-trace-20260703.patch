+    trace_stage: str = "copy_state_rows_native",
 ) -> None:
+    trace_enabled = _xpu_gdn_state_copy_trace_enabled()
+    trace_sync = (
+        trace_enabled
+        and os.environ.get("VLLM_XPU_GDN_STATE_COPY_TRACE_SYNC", "0") == "1"
+        and torch.xpu.is_available()
+    )
     dest = dest_indices.to(torch.long)
     src = src_indices.to(torch.long)
     copy_mask = (dest > 0) & (src > 0) & (dest != src)
     if not torch.any(copy_mask):
+        if trace_enabled:
+            _xpu_gdn_state_copy_trace({
+                "stage": trace_stage,
+                "copied_rows": 0,
+                "requested_rows": int(min(dest.numel(), src.numel())),
+                "conv_shape": list(conv_state.shape),
+                "ssm_shape": list(ssm_state.shape),
+                "reason": "empty_or_same",
+            })
         return
     dest = dest[copy_mask]
     src = src[copy_mask]
+    copied_rows = int(dest.numel()) if trace_enabled else 0
+    bytes_per_row = 0
+    start_ns = time.perf_counter_ns() if trace_enabled else 0
+    if trace_enabled:
+        bytes_per_row = (
