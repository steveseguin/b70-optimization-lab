 logger = init_logger(__name__)
 _XPU_GDN_TRACE_LINES = 0
+_XPU_GDN_STATE_COPY_TRACE_LINES = 0
@@
+def _xpu_gdn_state_copy_trace_enabled() -> bool:
+    trace_file = os.environ.get("VLLM_XPU_GDN_STATE_COPY_TRACE_FILE", "")
+    if not trace_file:
+        return False
+    try:
+        max_lines = int(
+            os.environ.get("VLLM_XPU_GDN_STATE_COPY_TRACE_MAX_LINES", "2000")
+            or "2000")
+    except ValueError:
+        max_lines = 2000
+    return (max_lines <= 0
+            or _XPU_GDN_STATE_COPY_TRACE_LINES < max_lines)
+
+
+def _xpu_gdn_state_copy_trace(record: dict[str, Any]) -> None:
+    global _XPU_GDN_STATE_COPY_TRACE_LINES
+    if not _xpu_gdn_state_copy_trace_enabled():
+        return
+    trace_file = os.environ["VLLM_XPU_GDN_STATE_COPY_TRACE_FILE"]
+    trace_dir = os.path.dirname(trace_file)
+    if trace_dir:
+        os.makedirs(trace_dir, exist_ok=True)
+    record.setdefault("ts", time.time())
+    record.setdefault("pid", os.getpid())
+    try:
+        with open(trace_file, "a", encoding="utf-8") as handle:
+            handle.write(json.dumps(record, sort_keys=True) + "\n")
+        _XPU_GDN_STATE_COPY_TRACE_LINES += 1
+    except Exception:
+        return
+
+
 def _xpu_gdn_copy_state_rows_native(
     *,
     conv_state: torch.Tensor,
     ssm_state: torch.Tensor,
