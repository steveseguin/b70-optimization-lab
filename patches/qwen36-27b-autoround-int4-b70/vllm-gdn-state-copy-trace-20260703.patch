+            "copy_bytes": int(copied_rows * bytes_per_row),
+            "bytes_per_row": int(bytes_per_row),
+            "conv_shape": list(conv_state.shape),
+            "ssm_shape": list(ssm_state.shape),
+            "elapsed_ms_sync": (
