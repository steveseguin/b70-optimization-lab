+            + int(ssm_state[0].numel()) * int(ssm_state.element_size())
+        )
+        if trace_sync:
+            torch.xpu.synchronize()
+            start_ns = time.perf_counter_ns()
     conv_state.index_copy_(0, dest,
                            conv_state.index_select(0, src).clone())
     ssm_state.index_copy_(0, dest,
                           ssm_state.index_select(0, src).clone())
+    if trace_enabled:
