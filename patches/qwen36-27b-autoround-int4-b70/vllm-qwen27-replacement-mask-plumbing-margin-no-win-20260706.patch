         """Return opt-in low-confidence spec rows to recompute normally.
 
         This is deliberately conservative.  Bonus rows can be gated for any
         speculative length because bonus logits are one row per request.
-        Replacement-margin gating remains limited to k=1 because target logits
-        are flattened by draft token and need row-specific mapping for k>1.
         The scheduler still receives the full sampler result for acceptance
         accounting; these masks only tell it which target-owned token should
         not become user-visible because the verifier row is too low-margin to
@@
         if replacement_min_margin > 0.0 and target_logits.shape[0]:
             target_top2 = torch.topk(
                 target_logits.to(torch.float32), k=2, dim=-1)
-            target_margin = target_top2.values[:, 0] - target_top2.values[:, 1]
-            if metadata.max_spec_len == 1:
-                suppressed_replacement_mask = target_margin < replacement_min_margin
+            target_argmax = target_top2.indices[:, 0].to(
+                metadata.draft_token_ids.dtype)
+            target_margin = target_top2.values[:, 0] - target_top2.values[:, 1]
+            draft_ids = metadata.draft_token_ids.reshape(-1)
+            masks: list[torch.Tensor] = []
+            start = 0
+            for num_draft_tokens in metadata.num_draft_tokens:
+                num = int(num_draft_tokens)
+                end = start + num
+                if num <= 0 or end > draft_ids.numel():
+                    masks.append(
+                        torch.tensor(False, device=target_logits.device))
+                    start = end
+                    continue
+                row_mismatch = target_argmax[start:end] != draft_ids[start:end]
+                has_reject = torch.any(row_mismatch)
+                first_reject = torch.argmax(row_mismatch.to(torch.int32))
+                reject_margin = target_margin[start + first_reject]
+                masks.append(has_reject & (reject_margin < replacement_min_margin))
+                start = end
+            if masks:
+                suppressed_replacement_mask = torch.stack(masks).to(
+                    dtype=torch.bool)
 
         return suppressed_bonus_mask, suppressed_replacement_mask

