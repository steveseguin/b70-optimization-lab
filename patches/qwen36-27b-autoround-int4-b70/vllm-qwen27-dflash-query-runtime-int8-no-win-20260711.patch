+    def _maybe_prepare_xpu_runtime_int8(self) -> None:
+        """Prepare default-off W8A8 copies for the DFlash draft body.
+
+        The target model still verifies every proposed token. FP32 weight
+        scales are intentional: the current XPU GEMM produced invalid values
+        with BF16 scales for these non-vocabulary matrix shapes.
+        """
+
+        enabled = os.environ.get(
+            "VLLM_XPU_DFLASH_RUNTIME_INT8", "0"
+        ).strip().lower() in ("1", "true", "yes", "on")
+        if not enabled:
+            return
+        try:
+            from vllm.model_executor.kernels.linear.scaled_mm.xpu import (
+                XPUInt8ScaledMMLinearKernel,
+            )
+        except Exception as exc:
+            logger.warning(
+                "DFlash runtime INT8 requested but XPU kernels are unavailable: %r",
+                exc,
+            )
+            return
+        # These probes also install the FakeTensor registrations required when
+        # the quantized draft body is captured by torch.compile.
+        if not (
+            XPUInt8ScaledMMLinearKernel._has_int8_gemm_w8a8()
+            and XPUInt8ScaledMMLinearKernel._has_per_token_quant_int8_xpu()
+        ):
+            logger.warning(
+                "DFlash runtime INT8 requested but required XPU ops are unavailable"
+            )
+            return
+
+        prepared = 0
+        quantized_bytes = 0
+        for name, layer in self.named_modules():
+            if not isinstance(layer, LinearBase):
+                continue
+            weight = getattr(layer, "weight", None)
+            if weight is None or weight.device.type != "xpu":
+                logger.warning(
+                    "Skipping DFlash runtime INT8 for %s: weight device=%s",
+                    name,
+                    getattr(weight, "device", None),
+                )
+                continue
+            if weight.dtype not in (torch.float16, torch.bfloat16):
+                logger.warning(
+                    "Skipping DFlash runtime INT8 for %s: weight dtype=%s",
+                    name,
+                    weight.dtype,
+                )
+                continue
+            with torch.no_grad():
+                weight_f = weight.detach().float()
+                scales = (
+                    weight_f.abs().amax(dim=1).clamp_min(1.0e-10) / 127.0
+                ).contiguous()
+                weight_q_t = (
+                    torch.round(weight_f / scales.view(-1, 1))
+                    .clamp(-127, 127)
+                    .to(torch.int8)
+                    .t()
+                    .contiguous()
+                )
+                del weight_f
+            # Match vLLM's native XPU INT8 parameter layout. Parameters are
+            # treated as immutable model state by AOT/cudagraph wrappers;
+            # ordinary buffers are copied as mutable graph inputs and made the
+            # draft path catastrophically slow.
+            replace_parameter(layer, "weight", weight_q_t)
+            replace_parameter(layer, "weight_scale", scales)
+            layer.quant_method = _XpuDFlashRuntimeInt8LinearMethod()
+            prepared += 1
+            quantized_bytes += (
+                weight_q_t.numel() + scales.numel() * scales.element_size()
+            )
+            logger.info(
+                "Prepared DFlash runtime INT8 linear %s weight_t=%s scale=%s",
+                name,
+                tuple(weight_q_t.shape),
+                tuple(scales.shape),
+            )
+        logger.info(
+            "Prepared %d DFlash runtime INT8 linears (%.3f GiB transient weights)",
+            prepared,
+            quantized_bytes / (1024**3),
+        )
+
