+void rms_norm_gated(
+    torch::Tensor& out,
+    torch::Tensor& input,
+    torch::Tensor& weight,
+    torch::Tensor& z,
+    double epsilon,
+    bool use_sigmoid) {
+  const at::DeviceGuard device_guard(input.device());
+  TORCH_CHECK(out.is_contiguous());
+  TORCH_CHECK(input.dim() == 2, "rms_norm_gated currently expects 2D input");
+  TORCH_CHECK(z.dim() == 2, "rms_norm_gated currently expects 2D z");
+  TORCH_CHECK(input.sizes() == z.sizes(), "input and z shapes must match");
+  TORCH_CHECK(out.sizes() == input.sizes(), "out and input shapes must match");
+  TORCH_CHECK(input.stride(-1) == 1, "input last dim must be contiguous");
+  TORCH_CHECK(z.stride(-1) == 1, "z last dim must be contiguous");
+  TORCH_CHECK(weight.is_contiguous(), "weight must be contiguous");
+  TORCH_CHECK(
+      input.scalar_type() == out.scalar_type() &&
+          input.scalar_type() == z.scalar_type() &&
+          input.scalar_type() == weight.scalar_type(),
+      "input, out, weight and z must have the same dtype");
+
+  VLLM_DISPATCH_FLOATING_TYPES(
+      input.scalar_type(), "call_rms_norm_gated_kernel", [&] {
+        vllm::call_rms_norm_gated_kernel<scalar_t>(
+            out, input, weight, z, epsilon, use_sigmoid);
+      });
+}
