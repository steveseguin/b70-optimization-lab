+template <typename scalar_t, int VEC_SIZE>
+class rms_norm_gated_kernel {
+ public:
+  rms_norm_gated_kernel(
+      scalar_t* out_,
+      const scalar_t* input_,
+      const scalar_t* weight_,
+      const scalar_t* z_,
+      const int64_t input_stride_,
+      const int64_t z_stride_,
+      const float epsilon_,
+      const bool use_sigmoid_,
+      const int hidden_size_,
+      sycl::local_accessor<float, 1> s_variance_)
+      : out(out_),
+        input(input_),
+        weight(weight_),
+        z(z_),
+        input_stride(input_stride_),
+        z_stride(z_stride_),
+        epsilon(epsilon_),
+        use_sigmoid(use_sigmoid_),
+        hidden_size(hidden_size_),
+        s_variance(s_variance_) {}
+
+  void operator() [[sycl::reqd_sub_group_size(32)]] (
+      const sycl::nd_item<3>& item_ct1) const {
+    static_assert(VEC_SIZE > 0, "Use VEC_SIZE=0 specialization for scalar path");
+    using vec_t = vec_n_t<scalar_t, VEC_SIZE>;
+
+    float* s_variance_ptr =
+        s_variance.template get_multi_ptr<sycl::access::decorated::no>().get();
+    const int row = item_ct1.get_group(2);
+    const int vec_hidden_size = hidden_size / VEC_SIZE;
+    const int64_t vec_input_stride = input_stride / VEC_SIZE;
+    const int64_t vec_z_stride = z_stride / VEC_SIZE;
+
+    auto* __restrict__ input_v = reinterpret_cast<const vec_t*>(input);
+    auto* __restrict__ weight_v = reinterpret_cast<const vec_t*>(weight);
+    auto* __restrict__ z_v = reinterpret_cast<const vec_t*>(z);
+    auto* __restrict__ out_v = reinterpret_cast<vec_t*>(out);
+
+    float variance = 0.0f;
+    for (int idx = item_ct1.get_local_id(2); idx < vec_hidden_size;
+         idx += item_ct1.get_local_range(2)) {
+      const vec_t src = input_v[row * vec_input_stride + idx];
+#pragma unroll
+      for (int i = 0; i < VEC_SIZE; i++) {
+        const float x = static_cast<float>(src.val[i]);
+        variance += x * x;
+      }
+    }
+
+    variance = sycl::reduce_over_group(
+        sycl::ext::oneapi::this_work_item::get_work_group<3>(),
+        variance,
+        sycl::plus<>());
+    if (item_ct1.get_local_id(2) == 0) {
+      *s_variance_ptr = sycl::rsqrt(variance / hidden_size + epsilon);
+    }
+
+    item_ct1.barrier(sycl::access::fence_space::local_space);
+
+    const float s_var = *s_variance_ptr;
+    for (int idx = item_ct1.get_local_id(2); idx < vec_hidden_size;
+         idx += item_ct1.get_local_range(2)) {
+      const vec_t src = input_v[row * vec_input_stride + idx];
+      const vec_t w = weight_v[idx];
+      const vec_t gate = z_v[row * vec_z_stride + idx];
+      vec_t dst;
+#pragma unroll
+      for (int i = 0; i < VEC_SIZE; i++) {
+        const float z_val = static_cast<float>(gate.val[i]);
+        const float sigmoid = 1.0f / (1.0f + sycl::exp(-z_val));
+        const float act = use_sigmoid ? sigmoid : z_val * sigmoid;
+        const float x = static_cast<float>(src.val[i]);
+        const float weight_val = static_cast<float>(w.val[i]);
+        dst.val[i] = static_cast<scalar_t>(x * s_var * weight_val * act);
+      }
+      out_v[row * vec_hidden_size + idx] = dst;
+    }
+  }
+
+ private:
+  scalar_t* __restrict__ out;
+  const scalar_t* __restrict__ input;
+  const scalar_t* __restrict__ weight;
+  const scalar_t* __restrict__ z;
+  const int64_t input_stride;
+  const int64_t z_stride;
+  const float epsilon;
+  const bool use_sigmoid;
+  const int hidden_size;
+  sycl::local_accessor<float, 1> s_variance;
+};
+
+template <typename scalar_t>
+class rms_norm_gated_kernel<scalar_t, 0> {
+ public:
+  rms_norm_gated_kernel(
+      scalar_t* out_,
+      const scalar_t* input_,
+      const scalar_t* weight_,
+      const scalar_t* z_,
+      const int64_t input_stride_,
+      const int64_t z_stride_,
+      const float epsilon_,
+      const bool use_sigmoid_,
+      const int hidden_size_,
+      sycl::local_accessor<float, 1> s_variance_)
+      : out(out_),
+        input(input_),
+        weight(weight_),
+        z(z_),
+        input_stride(input_stride_),
+        z_stride(z_stride_),
+        epsilon(epsilon_),
+        use_sigmoid(use_sigmoid_),
+        hidden_size(hidden_size_),
+        s_variance(s_variance_) {}
+
+  void operator() [[sycl::reqd_sub_group_size(32)]] (
+      const sycl::nd_item<3>& item_ct1) const {
+    float* s_variance_ptr =
+        s_variance.template get_multi_ptr<sycl::access::decorated::no>().get();
+    const int row = item_ct1.get_group(2);
+    float variance = 0.0f;
+
+    const scalar_t* input_row = input + row * input_stride;
+    for (int idx = item_ct1.get_local_id(2); idx < hidden_size;
+         idx += item_ct1.get_local_range(2)) {
+      const float x = static_cast<float>(input_row[idx]);
+      variance += x * x;
+    }
+
+    variance = sycl::reduce_over_group(
+        sycl::ext::oneapi::this_work_item::get_work_group<3>(),
+        variance,
+        sycl::plus<>());
+    if (item_ct1.get_local_id(2) == 0) {
+      *s_variance_ptr = sycl::rsqrt(variance / hidden_size + epsilon);
+    }
+
+    item_ct1.barrier(sycl::access::fence_space::local_space);
+
+    const float s_var = *s_variance_ptr;
+    const scalar_t* z_row = z + row * z_stride;
+    scalar_t* out_row = out + row * hidden_size;
+    for (int idx = item_ct1.get_local_id(2); idx < hidden_size;
+         idx += item_ct1.get_local_range(2)) {
+      const float z_val = static_cast<float>(z_row[idx]);
+      const float sigmoid = 1.0f / (1.0f + sycl::exp(-z_val));
+      const float act = use_sigmoid ? sigmoid : z_val * sigmoid;
+      const float x = static_cast<float>(input_row[idx]);
+      const float weight_val = static_cast<float>(weight[idx]);
+      out_row[idx] = static_cast<scalar_t>(x * s_var * weight_val * act);
+    }
+  }
+
+ private:
+  scalar_t* __restrict__ out;
+  const scalar_t* __restrict__ input;
+  const scalar_t* __restrict__ weight;
+  const scalar_t* __restrict__ z;
+  const int64_t input_stride;
+  const int64_t z_stride;
+  const float epsilon;
+  const bool use_sigmoid;
+  const int hidden_size;
+  sycl::local_accessor<float, 1> s_variance;
+};
+
+template <typename scalar_t>
+void call_rms_norm_gated_kernel(
+    torch::Tensor& out,
+    torch::Tensor& input,
+    torch::Tensor& weight,
+    torch::Tensor& z,
+    float epsilon,
+    bool use_sigmoid) {
+  using sycl_t = typename vllm::xpu::SyclTypeTrait<scalar_t>::Type;
+  const int hidden_size = input.size(-1);
+  const int num_tokens = input.numel() / hidden_size;
+  const int max_block_size = (num_tokens < 256) ? 1024 : 256;
+  auto out_ptr = out.data_ptr<scalar_t>();
+  auto input_ptr = input.data_ptr<scalar_t>();
+  auto weight_ptr = weight.data_ptr<scalar_t>();
+  auto z_ptr = z.data_ptr<scalar_t>();
+  const int64_t input_stride = input.stride(-2);
+  const int64_t z_stride = z.stride(-2);
+
+  constexpr int vec_size = (sizeof(scalar_t) == 2) ? 8 : 4;
+  constexpr int req_alignment_bytes = vec_size * sizeof(scalar_t);
+  auto out_addr = reinterpret_cast<std::uintptr_t>(out_ptr);
+  auto inp_addr = reinterpret_cast<std::uintptr_t>(input_ptr);
+  auto wt_addr = reinterpret_cast<std::uintptr_t>(weight_ptr);
+  auto z_addr = reinterpret_cast<std::uintptr_t>(z_ptr);
+  const bool ptrs_aligned = (out_addr % req_alignment_bytes == 0) &&
+                            (inp_addr % req_alignment_bytes == 0) &&
+                            (wt_addr % req_alignment_bytes == 0) &&
+                            (z_addr % req_alignment_bytes == 0);
+  const bool sizes_aligned = (hidden_size % vec_size == 0) &&
+                             (input_stride % vec_size == 0) &&
+                             (z_stride % vec_size == 0);
+  const bool can_vec = ptrs_aligned && sizes_aligned;
+
+  sycl::range<3> grid(1, 1, num_tokens);
+  auto& queue = vllm::xpu::vllmGetQueue();
+
+  if (can_vec) {
+    sycl::range<3> block(
+        1, 1, std::min(hidden_size / vec_size, max_block_size));
+    queue.submit([&](sycl::handler& cgh) {
+      sycl::local_accessor<float, 1> s_variance(sycl::range<1>(1), cgh);
+      cgh.parallel_for(
+          sycl::nd_range<3>(grid * block, block),
+          rms_norm_gated_kernel<sycl_t, vec_size>(
+              (sycl_t*)out_ptr,
+              (const sycl_t*)input_ptr,
+              (const sycl_t*)weight_ptr,
+              (const sycl_t*)z_ptr,
+              input_stride,
+              z_stride,
+              epsilon,
+              use_sigmoid,
+              hidden_size,
+              s_variance));
+    });
+  } else {
+    sycl::range<3> block(1, 1, std::min(hidden_size, max_block_size));
+    queue.submit([&](sycl::handler& cgh) {
+      sycl::local_accessor<float, 1> s_variance(sycl::range<1>(1), cgh);
+      cgh.parallel_for(
+          sycl::nd_range<3>(grid * block, block),
+          rms_norm_gated_kernel<sycl_t, 0>(
+              (sycl_t*)out_ptr,
+              (const sycl_t*)input_ptr,
+              (const sycl_t*)weight_ptr,
+              (const sycl_t*)z_ptr,
+              input_stride,
+              z_stride,
+              epsilon,
+              use_sigmoid,
+              hidden_size,
+              s_variance));
+    });
+  }
+}
