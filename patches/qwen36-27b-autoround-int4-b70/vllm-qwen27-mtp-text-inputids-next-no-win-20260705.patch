+    def _xpu_use_text_input_ids_for_mtp(
+        self,
+        mm_embed_inputs: tuple[list[torch.Tensor], torch.Tensor] | None = None,
+    ) -> bool:
+        """Use token ids for text-only MTP even when the target supports MM.
+
+        Multimodal-capable models normally precompute embeddings outside the
+        graph so image/audio soft tokens can be merged. Qwen3.5 MTP text decode
+        does not need that path; passing token ids lets the embedding lookup
+        stay inside the captured draft forward. Keep this default-off because
+        multimodal/prompt-embed batches still require inputs_embeds.
+        """
+        return (
+            self.xpu_mtp_text_input_ids_next
+            and self.method == "mtp"
+            and self.supports_mm_inputs
+            and mm_embed_inputs is None
+        )
