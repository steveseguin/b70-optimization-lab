+    def _xpu_dummy_schedule_for_shape(
+        self,
+        num_tokens: int,
+        uniform_decode: bool,
+        create_mixed_batch: bool = False,
+    ) -> tuple[np.ndarray, int]:
+        max_query_len = self.uniform_decode_query_len if uniform_decode else num_tokens
+        max_num_reqs = self.scheduler_config.max_num_seqs
+        if create_mixed_batch:
+            assert not uniform_decode
+            num_decode_tokens = min(max_num_reqs - 1, num_tokens // 2)
+            num_prefill_tokens = num_tokens - num_decode_tokens
+            num_scheduled_tokens_list = [1] * num_decode_tokens + [num_prefill_tokens]
+            max_query_len = num_prefill_tokens
+        elif uniform_decode:
+            num_reqs = min(max_num_reqs, cdiv(num_tokens, max_query_len))
+            num_scheduled_tokens_list = [max_query_len] * num_reqs
+            if num_tokens % max_query_len != 0:
+                num_scheduled_tokens_list[-1] = num_tokens % max_query_len
+        else:
+            num_reqs = min(num_tokens, max_num_reqs)
+            min_tokens_per_req = num_tokens // num_reqs
+            num_scheduled_tokens_list = [min_tokens_per_req] * num_reqs
+            num_scheduled_tokens_list[-1] += num_tokens % num_reqs
+
+        num_scheduled_tokens = np.array(num_scheduled_tokens_list, dtype=np.int32)
+        return num_scheduled_tokens, max_query_len
+
+    def _xpu_dummy_logit_indices_key_for_shape(
+        self,
+        num_tokens: int,
+        uniform_decode: bool,
+        create_mixed_batch: bool = False,
+    ) -> tuple[int, ...] | None:
+        num_scheduled_tokens, _ = self._xpu_dummy_schedule_for_shape(
+            num_tokens, uniform_decode, create_mixed_batch
+        )
+        if np.all(num_scheduled_tokens == 1):
+            return None
+        logit_indices = np.cumsum(num_scheduled_tokens) - 1
+        return tuple(int(index) for index in logit_indices)
+
+    def _xpu_dummy_metadata_key_for_shape(
+        self,
+        num_tokens: int,
+        uniform_decode: bool,
+        create_mixed_batch: bool = False,
+        profile_seq_lens: int | None = None,
+    ) -> tuple[tuple[int, ...], tuple[int, ...]]:
+        num_scheduled_tokens, max_query_len = self._xpu_dummy_schedule_for_shape(
+            num_tokens, uniform_decode, create_mixed_batch
+        )
+        num_reqs = len(num_scheduled_tokens)
+        if profile_seq_lens is not None:
+            seq_lens = np.full(num_reqs, profile_seq_lens, dtype=np.int32)
+        elif create_mixed_batch:
+            num_decode_tokens = num_reqs - 1
+            num_prefill_tokens = int(num_scheduled_tokens[-1])
+            seq_lens = np.array(
+                [1] * num_decode_tokens + [num_prefill_tokens + 1],
+                dtype=np.int32,
+            )
+        else:
+            seq_lens = np.full(num_reqs, max_query_len, dtype=np.int32)
+
+        query_start_loc = np.empty(num_reqs + 1, dtype=np.int32)
+        query_start_loc[0] = 0
+        query_start_loc[1:] = np.cumsum(num_scheduled_tokens)
+        return (
+            tuple(int(seq_len) for seq_len in seq_lens),
+            tuple(int(loc) for loc in query_start_loc),
+        )
