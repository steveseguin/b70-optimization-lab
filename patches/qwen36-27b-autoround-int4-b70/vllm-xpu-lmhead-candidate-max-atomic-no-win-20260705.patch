+template <typename ElementD>
+std::tuple<torch::Tensor, torch::Tensor, torch::Tensor, torch::Tensor>
+int8_lm_head_candidate_max_atomic_w8a8_dispatch(
+    const torch::Tensor& A,
+    const torch::Tensor& A_scale,
+    const torch::Tensor& B,
+    const torch::Tensor& B_scale,
+    const torch::Tensor& candidate_ids,
+    int64_t org_vocab_size) {
+  const at::DeviceGuard device_guard(A.device());
+  auto& queue = vllm::xpu::vllmGetQueue(A.device().index());
+
+  const int rows = static_cast<int>(A.size(0));
+  const int gemm_k = static_cast<int>(A.size(1));
+  const int gemm_n = static_cast<int>(B.size(1));
