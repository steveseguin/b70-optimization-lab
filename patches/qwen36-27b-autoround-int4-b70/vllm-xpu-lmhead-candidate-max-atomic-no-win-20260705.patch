+      cute::MMA_Atom<decltype(op)>,
+      cute::Layout<typename Policy::WGTile>,
+      typename Policy::SGLayout>::TiledMMA;
+  auto mma = MMA{};
+  const int wg_tile_n = cute::get<1>(mma.tile_mnk());
+  const int n_tiles = (gemm_n + wg_tile_n - 1) / wg_tile_n;
+
+  auto top_keys = torch::zeros({rows}, A.options().dtype(torch::kInt64));
+  auto top_vals = torch::empty({rows}, A.options().dtype(torch::kFloat32));
+  auto top_ids = torch::empty({rows}, A.options().dtype(torch::kInt64));
+  auto candidate_vals =
+      torch::empty({rows}, A.options().dtype(torch::kFloat32));
+  auto candidate_is_top =
+      torch::empty({rows}, A.options().dtype(torch::kBool));
+
+  const bool scales_bf16 = B_scale.scalar_type() == torch::kBFloat16;
+  launch_top1_tiles<ElementD, Policy>(
+      queue,
+      reinterpret_cast<const int8_t*>(A.data_ptr()),
+      reinterpret_cast<const float*>(A_scale.data_ptr()),
+      reinterpret_cast<const int8_t*>(B.data_ptr()),
+      B_scale.data_ptr(),
+      reinterpret_cast<const int64_t*>(candidate_ids.data_ptr()),
+      scales_bf16,
+      nullptr,
+      nullptr,
+      reinterpret_cast<uint64_t*>(top_keys.data_ptr<int64_t>()),
+      reinterpret_cast<float*>(candidate_vals.data_ptr()),
+      rows,
+      gemm_n,
+      static_cast<int>(org_vocab_size),
+      gemm_k,
+      n_tiles);
+  launch_top1_decode<ElementD>(
+      queue,
+      reinterpret_cast<const uint64_t*>(top_keys.data_ptr<int64_t>()),
+      reinterpret_cast<const int64_t*>(candidate_ids.data_ptr()),
+      reinterpret_cast<int64_t*>(top_ids.data_ptr()),
+      reinterpret_cast<float*>(top_vals.data_ptr()),
+      reinterpret_cast<bool*>(candidate_is_top.data_ptr()),
+      rows);
+  return {top_ids, top_vals, candidate_vals, candidate_is_top};
