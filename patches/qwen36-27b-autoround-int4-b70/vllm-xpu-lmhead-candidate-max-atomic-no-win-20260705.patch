+std::tuple<torch::Tensor, torch::Tensor> int8_lm_head_top1_w8a8(
+    const torch::Tensor& A,
+    const torch::Tensor& A_scale,
+    const torch::Tensor& B,
+    const torch::Tensor& B_scale,
+    std::optional<c10::ScalarType> out_dtype,
+    int64_t org_vocab_size) {
+  TORCH_CHECK(A.is_xpu(), "A must be XPU");
+  TORCH_CHECK(B.is_xpu(), "B must be XPU");
+  TORCH_CHECK(A.is_contiguous(), "A must be contiguous");
+  TORCH_CHECK(A_scale.is_contiguous(), "A_scale must be contiguous");
+  TORCH_CHECK(B.is_contiguous(), "B must be contiguous");
+  TORCH_CHECK(B_scale.is_contiguous(), "B_scale must be contiguous");
+  TORCH_CHECK(A.scalar_type() == torch::kInt8, "A must be int8");
+  TORCH_CHECK(B.scalar_type() == torch::kInt8, "B must be int8");
+  TORCH_CHECK(A.dim() == 2, "A must be [rows, K]");
+  TORCH_CHECK(B.dim() == 2, "B must be [K, N]");
+  TORCH_CHECK(A.size(1) == B.size(0), "A.size(1) must match B.size(0)");
+  TORCH_CHECK(A.size(0) > 0, "A must have at least one row");
+  TORCH_CHECK(A.size(0) <= 8, "prototype supports rows <= 8");
+  TORCH_CHECK(B.size(1) % 32 == 0, "B.size(1) must be divisible by 32");
+  TORCH_CHECK(
+      A_scale.scalar_type() == torch::kFloat32,
+      "A_scale must be float32");
+  TORCH_CHECK(
+      A_scale.numel() == A.size(0),
+      "A_scale must have one scale per row");
+  TORCH_CHECK(
+      B_scale.scalar_type() == torch::kFloat32 ||
+          B_scale.scalar_type() == torch::kBFloat16,
+      "B_scale must be float32 or bfloat16");
+  TORCH_CHECK(
+      B_scale.numel() == B.size(1),
+      "B_scale must have one scale per output channel");
+
+  const auto dtype = out_dtype.value_or(torch::kBFloat16);
+  if (dtype == torch::kBFloat16) {
+    return int8_lm_head_top1_w8a8_dispatch<sycl::ext::oneapi::bfloat16>(
+        A, A_scale, B, B_scale, org_vocab_size);
+  }
+  if (dtype == torch::kFloat16) {
+    return int8_lm_head_top1_w8a8_dispatch<sycl::half>(
+        A, A_scale, B, B_scale, org_vocab_size);
+  }
+  TORCH_CHECK(false, "out_dtype must be bfloat16 or float16");
+}
