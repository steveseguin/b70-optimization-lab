+    chunk_rows_s = os.environ.get("VLLM_XPU_CHUNKED_LOCAL_ARGMAX_ROWS", "0")
+    try:
+        chunk_rows = int(chunk_rows_s)
+    except ValueError:
+        chunk_rows = 0
+    if (
+        chunk_rows <= 0
+        or sample_hidden_states.device.type != "xpu"
+        or sample_hidden_states.shape[0] <= chunk_rows
+    ):
+        sampled_token_ids = model.get_top_tokens(sample_hidden_states)
+        _xpu_sync_debug_stage("after_local_argmax_direct")
+        return sampled_token_ids
+
+    sampled_token_ids: torch.Tensor | None = None
+    for start in range(0, sample_hidden_states.shape[0], chunk_rows):
+        end = min(start + chunk_rows, sample_hidden_states.shape[0])
+        chunk_token_ids = model.get_top_tokens(sample_hidden_states[start:end])
+        _xpu_sync_debug_stage(f"after_local_argmax_chunk_{start}_{end}")
+        if sampled_token_ids is None:
+            sampled_token_ids = torch.empty(
+                (sample_hidden_states.shape[0],) + tuple(chunk_token_ids.shape[1:]),
+                dtype=chunk_token_ids.dtype,
