+        hot_scales = scales.index_select(0, ids).contiguous()
+        for name, tensor in (
+            ("_xpu_lm_head_hot_token_ids", ids),
+            ("_xpu_lm_head_int8_hot_weight_t", hot_weight_t),
+            ("_xpu_lm_head_int8_hot_scale", hot_scales),
+        ):
