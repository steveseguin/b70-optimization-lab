+    def _maybe_prepare_xpu_int8_lm_head_hot_vocab(
+        self,
+        layer: torch.nn.Module,
+        weight_q_t: torch.Tensor,
+        scales: torch.Tensor,
+        hot_vocab_path: str,
+    ) -> None:
+        if get_tensor_model_parallel_world_size() != 1:
+            logger.warning(
+                "VLLM_XPU_LM_HEAD_INT8_HOT_VOCAB_FILE is only implemented for "
+                "TP1; falling back to dense draft lm_head.")
+            return
+        try:
+            with open(hot_vocab_path, encoding="utf-8") as f:
+                payload = json.load(f)
+            token_ids_obj = (
+                payload.get("token_ids")
+                if isinstance(payload, dict)
+                else payload
+            )
+            token_ids: list[int] = []
+            seen: set[int] = set()
+            actual_vocab_size = int(
+                getattr(
+                    layer,
+                    "org_vocab_size",
+                    getattr(layer, "num_embeddings", weight_q_t.shape[1]),
+                )
+            )
+            for value in token_ids_obj:
+                token_id = int(value)
+                if token_id < 0 or token_id >= actual_vocab_size:
+                    continue
+                if token_id in seen:
+                    continue
+                seen.add(token_id)
+                token_ids.append(token_id)
+        except Exception as exc:
