+        logger.info(
+            "Prepared experimental XPU INT8 lm_head hot vocab: path=%s "
+            "tokens=%d weight_t=%s scale=%s",
+            hot_vocab_path,
+            len(token_ids),
+            tuple(hot_weight_t.shape),
+            tuple(hot_scales.shape),
+        )

