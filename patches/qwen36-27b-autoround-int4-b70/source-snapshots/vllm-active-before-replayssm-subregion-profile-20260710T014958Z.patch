+def _compute_logits(
+    model: nn.Module, sample_hidden_states: torch.Tensor
+) -> torch.Tensor:
+    chunk_rows_s = os.environ.get("VLLM_XPU_CHUNKED_COMPUTE_LOGITS_ROWS", "0")
+    try:
+        chunk_rows = int(chunk_rows_s)
+    except ValueError:
+        chunk_rows = 0
+    if (
+        chunk_rows <= 0
+        or sample_hidden_states.device.type != "xpu"
+        or sample_hidden_states.shape[0] <= chunk_rows
+    ):
+        logits = model.compute_logits(sample_hidden_states)
+        _xpu_sync_debug_stage("after_compute_logits_direct")
+        return logits
+
+    logits: torch.Tensor | None = None
+    for start in range(0, sample_hidden_states.shape[0], chunk_rows):
+        end = min(start + chunk_rows, sample_hidden_states.shape[0])
+        logits_chunk = model.compute_logits(sample_hidden_states[start:end])
+        _xpu_sync_debug_stage(f"after_compute_logits_chunk_{start}_{end}")
+        if logits is None:
+            logits = torch.empty(
+                (sample_hidden_states.shape[0],) + tuple(logits_chunk.shape[1:]),
+                dtype=logits_chunk.dtype,
+                device=logits_chunk.device,
+            )
+            _xpu_sync_debug_stage("after_compute_logits_alloc")
+        logits[start:end].copy_(logits_chunk)
+        _xpu_sync_debug_stage(f"after_compute_logits_copy_{start}_{end}")
+
+    assert logits is not None
+    return logits
+
+
+def _get_top_tokens(
+    model: nn.Module, sample_hidden_states: torch.Tensor
+) -> torch.Tensor:
+    chunk_rows_s = os.environ.get("VLLM_XPU_CHUNKED_LOCAL_ARGMAX_ROWS", "0")
+    try:
+        chunk_rows = int(chunk_rows_s)
+    except ValueError:
+        chunk_rows = 0
+    if (
+        chunk_rows <= 0
+        or sample_hidden_states.device.type != "xpu"
+        or sample_hidden_states.shape[0] <= chunk_rows
+    ):
+        sampled_token_ids = model.get_top_tokens(sample_hidden_states)
+        _xpu_sync_debug_stage("after_local_argmax_direct")
+        return sampled_token_ids
+
+    sampled_token_ids: torch.Tensor | None = None
+    for start in range(0, sample_hidden_states.shape[0], chunk_rows):
+        end = min(start + chunk_rows, sample_hidden_states.shape[0])
+        chunk_token_ids = model.get_top_tokens(sample_hidden_states[start:end])
+        _xpu_sync_debug_stage(f"after_local_argmax_chunk_{start}_{end}")
+        if sampled_token_ids is None:
+            sampled_token_ids = torch.empty(
+                (sample_hidden_states.shape[0],) + tuple(chunk_token_ids.shape[1:]),
+                dtype=chunk_token_ids.dtype,
+                device=chunk_token_ids.device,
+            )
+            _xpu_sync_debug_stage("after_local_argmax_alloc")
+        sampled_token_ids[start:end].copy_(chunk_token_ids)
+        _xpu_sync_debug_stage(f"after_local_argmax_copy_{start}_{end}")
+
+    assert sampled_token_ids is not None
+    return sampled_token_ids
+
+
+def _xpu_sync_debug_stage(stage: str) -> None:
+    stages = {
+        item.strip()
+        for item in os.environ.get("VLLM_XPU_SYNC_DEBUG_STAGES", "").split(",")
+        if item.strip()
+    }
+    if "*" not in stages and stage not in stages:
+        return
+    logger.info("XPU sync debug stage begin: %s", stage)
+    try:
+        torch.xpu.synchronize()
+    except Exception as exc:
+        raise RuntimeError(f"XPU sync failed at {stage}") from exc
+    logger.info("XPU sync debug stage end: %s", stage)
+
