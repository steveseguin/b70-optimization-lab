diff --git a/tests/compile/test_wrapper.py b/tests/compile/test_wrapper.py
index 5e0755ff7..5cc87e996 100644
--- a/tests/compile/test_wrapper.py
+++ b/tests/compile/test_wrapper.py
@@ -34,6 +34,55 @@ class MyWrapper(TorchCompileWithNoGuardsWrapper):
         return self.model(x)
 
 
+class StaticIndexMod(torch.nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.layers = torch.nn.ModuleList(
+            torch.nn.Linear(4, 4, bias=False) for _ in range(3)
+        )
+        with torch.no_grad():
+            for index, layer in enumerate(self.layers):
+                layer.weight.copy_(torch.eye(4) * (index + 1))
+
+    def forward(self, x: torch.Tensor, spec_step_idx: int = 0):
+        return self.layers[spec_step_idx](x)
+
+
+class GuardSpecializedWrapper(TorchCompileWithNoGuardsWrapper):
+    _vllm_preserve_compile_guard_names = frozenset({"spec_step_idx"})
+
+    def __init__(self, model):
+        self.model = model
+        super().__init__()
+
+    def forward(self, x: torch.Tensor, spec_step_idx: int = 0):  # type: ignore[override]
+        return self.model(x, spec_step_idx)
+
+
+def test_preserved_compile_guard_specializes_python_index(monkeypatch):
+    monkeypatch.setenv("VLLM_USE_AOT_COMPILE", "0")
+    monkeypatch.setenv("VLLM_USE_BYTECODE_HOOK", "0")
+    monkeypatch.setenv("VLLM_DISABLE_COMPILE_CACHE", "1")
+
+    vllm_config = VllmConfig()
+    vllm_config.compilation_config = CompilationConfig()
+    vllm_config.compilation_config.mode = CompilationMode.DYNAMO_TRACE_ONCE
+    vllm_config.compilation_config.backend = "inductor"
+
+    with set_current_vllm_config(vllm_config):
+        torch._dynamo.reset()
+        wrapper = GuardSpecializedWrapper(StaticIndexMod())
+        x = torch.tensor([[1.0, 2.0, 3.0, 4.0]])
+        outputs = [
+            wrapper(x, spec_step_idx=index)
+            for index in (0, 1, 2, 1, 0)
+        ]
+
+    expected = [x, x * 2, x * 3, x * 2, x]
+    for actual, wanted in zip(outputs, expected):
+        assert torch.equal(actual, wanted)
+
+
