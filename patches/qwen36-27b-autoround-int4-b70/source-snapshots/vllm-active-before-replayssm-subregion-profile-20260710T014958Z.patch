+    def get_hot_vocab_tokens(
+        self,
+        lm_head: VocabParallelEmbedding,
+        hidden_states: torch.Tensor,
+        hot_token_ids: torch.Tensor,
+        embedding_bias: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Approximate greedy IDs over a fixed hot vocabulary.
+
+        This is intended only for speculative draft generation, where proposal
+        quality affects speed but not final correctness. Target verification
+        must still use the full target vocabulary.
+        """
+        if embedding_bias is not None:
+            raise ValueError("hot-vocab draft head does not support bias")
+        tp_size = get_tensor_model_parallel_world_size()
+        if tp_size != 1:
+            raise ValueError("hot-vocab draft head currently supports TP1 only")
+        if self.soft_cap is not None:
+            raise ValueError("hot-vocab draft head does not support soft cap")
+        if hot_token_ids.device != hidden_states.device:
+            hot_token_ids = hot_token_ids.to(hidden_states.device)
+        hot_token_ids = hot_token_ids.to(torch.long).contiguous()
+
+        cached_ids = getattr(lm_head, "_xpu_draft_hot_vocab_token_ids", None)
+        cached_weight = getattr(lm_head, "_xpu_draft_hot_vocab_weight", None)
+        if (
+            cached_ids is None
+            or cached_weight is None
+            or cached_ids.device != hot_token_ids.device
+            or cached_ids.shape != hot_token_ids.shape
+            or not torch.equal(cached_ids, hot_token_ids)
+        ):
+            if hot_token_ids.numel() == 0:
+                raise ValueError("hot-vocab draft head got an empty vocabulary")
+            if int(hot_token_ids.min().item()) < 0:
+                raise ValueError("hot-vocab token IDs must be non-negative")
+            if int(hot_token_ids.max().item()) >= lm_head.weight.shape[0]:
+                raise ValueError(
+                    "hot-vocab token ID exceeds local TP1 lm_head rows")
+            with torch.no_grad():
+                cached_ids = hot_token_ids.clone()
+                cached_weight = lm_head.weight.index_select(0, cached_ids)
+                cached_weight = cached_weight.contiguous()
+            for name, tensor in (
+                ("_xpu_draft_hot_vocab_token_ids", cached_ids),
+                ("_xpu_draft_hot_vocab_weight", cached_weight),
+            ):
+                if name in lm_head._buffers:
+                    lm_head._buffers[name] = tensor
+                else:
+                    lm_head.register_buffer(name, tensor, persistent=False)
+            logger.info(
+                "Prepared XPU draft hot-vocab head: rows=%d hidden=%d dtype=%s",
+                cached_weight.shape[0],
+                cached_weight.shape[1],
+                cached_weight.dtype,
+            )
+
+        with timed_region("logits.hot_vocab_lm_head"):
+            logits = torch.nn.functional.linear(hidden_states, cached_weight)
+        if self.scale != 1.0:
+            logits = logits * self.scale
+        with timed_region("logits.hot_vocab_argmax"):
+            hot_indices = logits.argmax(dim=-1)
+        return cached_ids[hot_indices]
+
