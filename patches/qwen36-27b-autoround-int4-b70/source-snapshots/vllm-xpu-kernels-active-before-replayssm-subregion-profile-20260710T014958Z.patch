+void gdn_replayssm_copy_slots(
+    torch::Tensor& d_cache,       // [num_slots, num_v_heads, L, head_v_dim]
+    torch::Tensor& k_cache,       // [num_slots, num_k_heads, L, head_k_dim]
+    torch::Tensor& g_cache,       // [num_slots, num_v_heads, L], fp32
+    torch::Tensor& write_pos,     // [num_slots], int32
+    torch::Tensor& cache_base,    // [num_slots], int32
+    torch::Tensor& is_flush,      // [num_slots], int8
+    torch::Tensor& pending,       // [num_slots], int8
+    torch::Tensor& pending_len,   // [num_slots], int32
+    torch::Tensor& conv_pending,  // [num_slots, max_spec_len, conv_dim]
+    const torch::Tensor& src_indices,  // [rows], int64
+    const torch::Tensor& dst_indices,  // [rows], int64
+    const int64_t null_block_id) {
+  const int64_t rows = std::min(src_indices.numel(), dst_indices.numel());
+  if (rows <= 0) {
+    return;
+  }
+
+  TORCH_CHECK(d_cache.dim() >= 1);
+  TORCH_CHECK(k_cache.dim() >= 1);
+  TORCH_CHECK(g_cache.dim() >= 1);
+  TORCH_CHECK(conv_pending.dim() >= 1);
+  TORCH_CHECK(d_cache.is_contiguous(), "d_cache must be contiguous");
+  TORCH_CHECK(k_cache.is_contiguous(), "k_cache must be contiguous");
+  TORCH_CHECK(g_cache.is_contiguous(), "g_cache must be contiguous");
+  TORCH_CHECK(write_pos.is_contiguous(), "write_pos must be contiguous");
+  TORCH_CHECK(cache_base.is_contiguous(), "cache_base must be contiguous");
+  TORCH_CHECK(is_flush.is_contiguous(), "is_flush must be contiguous");
+  TORCH_CHECK(pending.is_contiguous(), "pending must be contiguous");
+  TORCH_CHECK(pending_len.is_contiguous(), "pending_len must be contiguous");
+  TORCH_CHECK(conv_pending.is_contiguous(), "conv_pending must be contiguous");
+  TORCH_CHECK(src_indices.is_contiguous(), "src_indices must be contiguous");
+  TORCH_CHECK(dst_indices.is_contiguous(), "dst_indices must be contiguous");
+
+  const int64_t num_slots = d_cache.size(0);
+  TORCH_CHECK(num_slots > 0, "d_cache must have at least one slot");
+  TORCH_CHECK(k_cache.size(0) == num_slots);
+  TORCH_CHECK(g_cache.size(0) == num_slots);
+  TORCH_CHECK(conv_pending.size(0) == num_slots);
+  TORCH_CHECK(write_pos.size(0) >= num_slots);
+  TORCH_CHECK(cache_base.size(0) >= num_slots);
+  TORCH_CHECK(is_flush.size(0) >= num_slots);
+  TORCH_CHECK(pending.size(0) >= num_slots);
+  TORCH_CHECK(pending_len.size(0) >= num_slots);
+
+  auto dtype = d_cache.dtype();
+  TORCH_CHECK(k_cache.dtype() == dtype);
+  TORCH_CHECK(conv_pending.dtype() == dtype);
+  TORCH_CHECK(g_cache.scalar_type() == at::kFloat);
+  TORCH_CHECK(write_pos.scalar_type() == at::kInt);
+  TORCH_CHECK(cache_base.scalar_type() == at::kInt);
+  TORCH_CHECK(is_flush.scalar_type() == at::kChar);
+  TORCH_CHECK(pending.scalar_type() == at::kChar);
+  TORCH_CHECK(pending_len.scalar_type() == at::kInt);
+  TORCH_CHECK(src_indices.scalar_type() == at::kLong);
+  TORCH_CHECK(dst_indices.scalar_type() == at::kLong);
+
+  auto& queue = vllm::xpu::vllmGetQueue();
+#define REPLAY_COPY_SLOTS_LAUNCHER(scalar_t)                             \
+  gdn::spec_decode::gdn_replayssm_copy_slots<scalar_t>(                  \
+      queue, d_cache, k_cache, g_cache, write_pos, cache_base, is_flush,  \
+      pending, pending_len, conv_pending, src_indices, dst_indices,       \
+      static_cast<int>(null_block_id))
+
+  if (dtype == at::kBFloat16) {
+    using scalar_t = sycl::ext::oneapi::bfloat16;
+    REPLAY_COPY_SLOTS_LAUNCHER(scalar_t);
+  } else if (dtype == at::kHalf) {
+    using scalar_t = sycl::half;
+    REPLAY_COPY_SLOTS_LAUNCHER(scalar_t);
+  } else if (dtype == at::kFloat) {
+    using scalar_t = float;
+    REPLAY_COPY_SLOTS_LAUNCHER(scalar_t);
+  } else {
+    TORCH_CHECK(
+        false,
+        "ReplaySSM slot copy dtype must be float32/float16/bfloat16, but got ",
+        dtype);
+  }
+#undef REPLAY_COPY_SLOTS_LAUNCHER
+}
