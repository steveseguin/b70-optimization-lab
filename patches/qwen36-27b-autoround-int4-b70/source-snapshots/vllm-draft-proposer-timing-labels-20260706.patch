+    def _get_slot_mapping_from_common_metadata(
+        self,
+        num_tokens: int,
+        common_attn_metadata: CommonAttentionMetadata,
+    ) -> dict[str, torch.Tensor]:
+        """Return per-layer slot mappings, preserving mixed draft KV groups."""
+        cad_by_gid: dict[int, CommonAttentionMetadata] | None = getattr(
+            common_attn_metadata, "_draft_common_attn_metadata_by_gid", None)
+        if not cad_by_gid or not self.draft_layer_to_kv_cache_gid:
+            return self._get_slot_mapping(
+                num_tokens, common_attn_metadata.slot_mapping)
+
+        result: dict[str, torch.Tensor] = {}
+        for layer_name in self._draft_attn_layer_names:
+            gid = self.draft_layer_to_kv_cache_gid.get(
+                layer_name, self.kv_cache_gid)
+            group_cad = cad_by_gid.get(gid, common_attn_metadata)
+            src = group_cad.slot_mapping
+            buffer = self._slot_mapping_buffers_by_gid.get(
+                gid, self._slot_mapping_buffer)
+            num_actual = min(int(src.shape[0]), num_tokens)
+            buffer[:num_actual].copy_(src[:num_actual])
+            if num_tokens > num_actual:
+                buffer[num_actual:num_tokens].fill_(PADDING_SLOT_ID)
+            result[layer_name] = buffer[:num_tokens]
+        return result
+
