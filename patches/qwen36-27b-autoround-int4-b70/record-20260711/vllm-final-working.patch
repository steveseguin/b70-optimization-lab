+    def _xpu_commit_ddtree_winner(
+        self,
+        path_indices: torch.Tensor | None,
+        winner_indices: torch.Tensor | None,
+    ) -> set[str]:
+        if path_indices is None or winner_indices is None:
+            return set()
+        if len(self.input_batch.req_ids) != 1:
+            raise NotImplementedError(
+                "The first DDTree cache commit supports one request"
