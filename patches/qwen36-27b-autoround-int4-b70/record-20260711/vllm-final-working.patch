+                mapping = slot_mappings.get(gid)
+                if mapping is None:
+                    continue
+                source_slots = mapping.index_select(0, valid_path.to(torch.long))
+                destination_slots = mapping[1 : accepted_depth + 1]
+                if not native_kv_copy:
+                    source_slot_list = source_slots.detach().cpu().tolist()
+                    destination_slot_list = destination_slots.detach().cpu().tolist()
+                for attn_group in attn_groups:
+                    if attn_group.backend.get_name() != "TREE_ATTN":
+                        continue
+                    for layer_name in attn_group.layer_names:
+                        kv_cache = forward_context[layer_name].kv_cache
+                        if native_kv_copy:
+                            torch.ops._xpu_C.kv_cache_copy_slots(
+                                kv_cache,
+                                source_slots.to(torch.long),
+                                destination_slots.to(torch.long),
+                            )
+                            continue
+                        block_size = kv_cache.shape[2]
+                        for source_slot, destination_slot in zip(
+                            source_slot_list, destination_slot_list
+                        ):
