+def _build_rooted_tree_topology(
+    tree_choices: list[tuple[int, ...]],
+) -> tuple[list[int], list[int], bool]:
+    """Convert a regular breadth-first tree to root-plus-node metadata."""
+    if not tree_choices:
+        raise ValueError("Speculative token tree must contain at least one node")
+    row_by_path: dict[tuple[int, ...], int] = {(): 0}
+    parents = [-1]
+    depths = [0]
+    child_counts: dict[int, int] = {}
+    child_labels: dict[int, list[int]] = {}
+    previous_depth = 0
+
+    for path in tree_choices:
+        if not path:
+            raise ValueError("Speculative token tree paths must be non-empty")
+        if len(path) < previous_depth:
+            raise ValueError(
+                "Speculative token tree paths must be ordered breadth-first"
+            )
+        if path in row_by_path:
+            raise ValueError(f"Duplicate speculative token tree path: {path}")
+        parent_path = path[:-1]
+        parent = row_by_path.get(parent_path)
+        if parent is None:
+            raise ValueError(
+                "Speculative token tree must be breadth-first and include every "
+                f"parent before its children; missing parent {parent_path} for {path}"
+            )
+        row_by_path[path] = len(parents)
+        parents.append(parent)
+        depths.append(len(path))
+        child_counts[parent] = child_counts.get(parent, 0) + 1
+        child_labels.setdefault(parent, []).append(path[-1])
+        previous_depth = len(path)
+
+    max_depth = max(depths)
+    paths_by_depth = {
+        depth: [path for path in tree_choices if len(path) == depth]
+        for depth in range(1, max_depth + 1)
+    }
+    for depth in range(max_depth):
+        rows = [row for row, row_depth in enumerate(depths) if row_depth == depth]
+        counts = {child_counts.get(row, 0) for row in rows}
+        if len(counts) != 1 or 0 in counts:
+            raise ValueError(
+                "Speculative token tree must be regular: every node at a "
+                "non-leaf depth must have the same positive child count"
+            )
+        expected_labels = list(range(next(iter(counts))))
+        if any(child_labels.get(row, []) != expected_labels for row in rows):
+            raise ValueError(
+                "Speculative token tree child labels must be contiguous and "
+                "parent-major at every level"
+            )
+        parent_paths = [()] if depth == 0 else paths_by_depth[depth]
+        expected_paths = [
+            parent_path + (child,)
+            for parent_path in parent_paths
+            for child in expected_labels
+        ]
+        if paths_by_depth[depth + 1] != expected_paths:
+            raise ValueError(
+                "Speculative token tree nodes must be grouped parent-major "
+                "within each breadth-first level"
+            )
+
+    is_branching = any(count > 1 for count in child_counts.values())
+    return parents, depths, is_branching
+
+
