+
+        valid_path = path_indices[0][path_indices[0] >= 0]
+        winner = int(winner_indices[0].item())
+        state_indices_by_group = self._xpu_ddtree_gdn_state_indices_by_group
+        base_state_index_by_group = self._xpu_ddtree_gdn_base_state_index_by_group
+        if not state_indices_by_group or not base_state_index_by_group:
+            raise RuntimeError("Missing DDTree GDN state indices after target forward")
