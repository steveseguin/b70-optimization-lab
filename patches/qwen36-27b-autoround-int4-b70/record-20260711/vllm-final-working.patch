+def ddtree_greedy_sample_kernel(
+    output_token_ids_ptr,
+    path_indices_ptr,
+    winner_indices_ptr,
+    cu_num_draft_tokens_ptr,
+    cu_num_sampled_tokens_ptr,
+    draft_token_ids_ptr,
+    tree_parent_indices_ptr,
+    target_argmax_ptr,
+    max_spec_len,
+    MAX_SPEC_LEN: tl.constexpr,
+):
+    req_idx = tl.program_id(0)
+    draft_start = (
+        0
+        if req_idx == 0
+        else tl.load(cu_num_draft_tokens_ptr + req_idx - 1)
+    )
+    draft_end = tl.load(cu_num_draft_tokens_ptr + req_idx)
+    tree_start = (
+        0
+        if req_idx == 0
+        else tl.load(cu_num_sampled_tokens_ptr + req_idx - 1)
+    )
+    num_drafts = draft_end - draft_start
+
+    current = 0
+    active = True
+    for output_pos in tl.static_range(0, MAX_SPEC_LEN + 1):
+        step_active = active & (output_pos <= num_drafts)
+        target_id = tl.load(
+            target_argmax_ptr + tree_start + current,
+            mask=step_active,
+            other=-1,
+        ).to(tl.int32)
+        tl.store(
+            output_token_ids_ptr
+            + req_idx * (max_spec_len + 1)
+            + output_pos,
+            target_id,
+            mask=step_active,
+        )
+
+        matching_child = -1
+        for child in tl.static_range(1, MAX_SPEC_LEN + 1):
+            valid_child = child <= num_drafts
+            parent = tl.load(
+                tree_parent_indices_ptr + tree_start + child,
+                mask=valid_child,
+                other=-2,
+            )
+            child_token = tl.load(
+                draft_token_ids_ptr + draft_start + child - 1,
+                mask=valid_child,
+                other=-1,
+            )
+            is_match = (
+                step_active
+                & valid_child
+                & (parent == current)
+                & (child_token == target_id)
+                & (matching_child < 0)
+            )
+            matching_child = tl.where(is_match, child, matching_child)
