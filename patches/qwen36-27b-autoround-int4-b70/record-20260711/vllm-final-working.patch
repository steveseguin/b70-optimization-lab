+
+        forward_context = self.compilation_config.static_forward_context
+        for gid, kv_cache_group in enumerate(self.kv_cache_config.kv_cache_groups):
+            if not isinstance(kv_cache_group.kv_cache_spec, MambaSpec):
+                continue
+            state_indices = state_indices_by_group[gid]
+            base_state_index = base_state_index_by_group[gid]
+            source_state = int(state_indices[winner].item())
+            destination_state = int(base_state_index[0].item())
+            for layer_name in kv_cache_group.layer_names:
+                layer = forward_context[layer_name]
+                for state in layer.kv_cache:
+                    state[destination_state].copy_(state[source_state])
