+    const torch::Tensor& key_cache,
+    const torch::Tensor& value_cache,
+    const torch::Tensor& block_table,
+    const torch::Tensor& seq_lens,
+    const torch::Tensor& tree_bias,
+    const double scale) {
+  using sycl_t = typename vllm::xpu::SyclTypeTrait<scalar_t>::Type;
+
+  constexpr int kHeadSize = 256;
+  constexpr int kSubgroupSize = 16;
+  constexpr int kSubgroupsPerWorkgroup = 16;
+  constexpr int kValuesPerLane = kHeadSize / kSubgroupSize;
+  constexpr int kWorkgroupSize = kSubgroupSize * kSubgroupsPerWorkgroup;
+
+  const int64_t query_len = query.size(0);
+  const int64_t num_query_heads = query.size(1);
+  const int64_t num_kv_heads = key_cache.size(2);
+  const int64_t num_query_heads_per_kv = num_query_heads / num_kv_heads;
+  const int64_t num_cache_blocks = key_cache.size(0);
+  const int64_t block_size = key_cache.size(1);
+  const int64_t max_block_table_blocks = block_table.size(1);
+  const int64_t key_block_stride = key_cache.stride(0);
+  const int64_t key_token_stride = key_cache.stride(1);
+  const int64_t key_head_stride = key_cache.stride(2);
+  const int64_t value_block_stride = value_cache.stride(0);
+  const int64_t value_token_stride = value_cache.stride(1);
+  const int64_t value_head_stride = value_cache.stride(2);
+
+  const auto* query_ptr = reinterpret_cast<const sycl_t*>(
+      query.data_ptr<scalar_t>());
+  const auto* key_ptr = reinterpret_cast<const sycl_t*>(
+      key_cache.data_ptr<scalar_t>());
+  const auto* value_ptr = reinterpret_cast<const sycl_t*>(
+      value_cache.data_ptr<scalar_t>());
+  auto* output_ptr = reinterpret_cast<sycl_t*>(output.data_ptr<scalar_t>());
+  const auto* block_table_ptr = block_table.data_ptr<int32_t>();
+  const auto* seq_lens_ptr = seq_lens.data_ptr<int32_t>();
+  const auto* tree_bias_ptr = tree_bias.data_ptr<float>();
+  const float softmax_scale = static_cast<float>(scale);
+
+  at::DeviceGuard device_guard(query.device());
+  auto& queue = vllm::xpu::vllmGetQueue();
+  const int64_t workgroups = query_len * num_query_heads;
+  const sycl::range<1> local(kWorkgroupSize);
+  const sycl::range<1> global(workgroups * kWorkgroupSize);
+
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<float, 1> partial_output(
+        sycl::range<1>(kSubgroupsPerWorkgroup * kHeadSize), cgh);
+    sycl::local_accessor<float, 1> partial_max(
+        sycl::range<1>(kSubgroupsPerWorkgroup), cgh);
+    sycl::local_accessor<float, 1> partial_sum(
+        sycl::range<1>(kSubgroupsPerWorkgroup), cgh);
+    cgh.parallel_for(
+        sycl::nd_range<1>(global, local),
+        [=](sycl::nd_item<1> item)
+            [[sycl::reqd_sub_group_size(kSubgroupSize)]] {
+              const int local_id = item.get_local_id(0);
+              const int64_t workgroup_id = item.get_group(0);
+              const int64_t query_row = workgroup_id / num_query_heads;
+              const int64_t query_head = workgroup_id % num_query_heads;
+              const int64_t kv_head =
+                  query_head / num_query_heads_per_kv;
+              const auto subgroup = item.get_sub_group();
+              const int subgroup_id = subgroup.get_group_linear_id();
+              const int lane = subgroup.get_local_linear_id();
+
+              float output_acc[kValuesPerLane];
+#pragma unroll
+              for (int i = 0; i < kValuesPerLane; ++i) {
+                output_acc[i] = 0.0f;
+              }
+              float running_max = -std::numeric_limits<float>::infinity();
+              float running_sum = 0.0f;
+
+              const int32_t seq_len = seq_lens_ptr[0];
+              const int32_t context_len = seq_len - query_len;
+              const bool valid_sequence =
+                  seq_len >= query_len &&
+                  seq_len <= max_block_table_blocks * block_size;
+
+              if (valid_sequence) {
+                for (int32_t key_pos = subgroup_id; key_pos < seq_len;
+                     key_pos += kSubgroupsPerWorkgroup) {
+                  bool allowed = key_pos < context_len;
+                  if (!allowed) {
+                    const int32_t tree_col = key_pos - context_len;
+                    allowed = tree_col >= 0 && tree_col < query_len &&
+                              sycl::isfinite(
+                                  tree_bias_ptr[query_row * query_len +
+                                                tree_col]);
+                  }
+                  if (!allowed) {
+                    continue;
+                  }
+
+                  const int32_t logical_block = key_pos / block_size;
+                  const int32_t block_offset = key_pos % block_size;
+                  const int32_t physical_block =
+                      block_table_ptr[logical_block];
+                  if (physical_block < 0 ||
+                      physical_block >= num_cache_blocks) {
+                    continue;
+                  }
+
+                  float dot = 0.0f;
+#pragma unroll
+                  for (int i = 0; i < kValuesPerLane; ++i) {
+                    const int dim = lane + i * kSubgroupSize;
+                    const int64_t query_index =
+                        (query_row * num_query_heads + query_head) *
+                            kHeadSize +
+                        dim;
+                    const int64_t cache_index =
+                        static_cast<int64_t>(physical_block) *
+                            key_block_stride +
+                        block_offset * key_token_stride +
+                        kv_head * key_head_stride +
+                        dim;
+                    dot += static_cast<float>(query_ptr[query_index]) *
+                           static_cast<float>(key_ptr[cache_index]);
+                  }
+                  const float score =
+                      sycl::reduce_over_group(subgroup, dot, sycl::plus<>()) *
+                      softmax_scale;
+                  const float next_max = sycl::fmax(running_max, score);
+                  const float old_weight =
+                      running_sum == 0.0f
+                          ? 0.0f
+                          : sycl::exp(running_max - next_max);
+                  const float new_weight = sycl::exp(score - next_max);
+
+#pragma unroll
+                  for (int i = 0; i < kValuesPerLane; ++i) {
+                    const int dim = lane + i * kSubgroupSize;
+                    const int64_t value_index =
+                        static_cast<int64_t>(physical_block) *
+                            value_block_stride +
+                        block_offset * value_token_stride +
+                        kv_head * value_head_stride +
+                        dim;
+                    output_acc[i] =
+                        old_weight * output_acc[i] +
+                        new_weight * static_cast<float>(value_ptr[value_index]);
+                  }
+                  running_sum = old_weight * running_sum + new_weight;
+                  running_max = next_max;
+                }
+              }
+
+              if (lane == 0) {
+                partial_max[subgroup_id] = running_max;
+                partial_sum[subgroup_id] = running_sum;
+              }
+#pragma unroll
+              for (int i = 0; i < kValuesPerLane; ++i) {
+                const int dim = lane + i * kSubgroupSize;
+                partial_output[subgroup_id * kHeadSize + dim] = output_acc[i];
+              }
+              item.barrier(sycl::access::fence_space::local_space);
+
+              const int dim = local_id;
+              float global_max = -std::numeric_limits<float>::infinity();
+#pragma unroll
+              for (int subgroup_index = 0;
+                   subgroup_index < kSubgroupsPerWorkgroup;
+                   ++subgroup_index) {
+                if (partial_sum[subgroup_index] > 0.0f) {
+                  global_max =
+                      sycl::fmax(global_max, partial_max[subgroup_index]);
+                }
+              }
+
+              float global_sum = 0.0f;
+              float global_output = 0.0f;
+#pragma unroll
+              for (int subgroup_index = 0;
+                   subgroup_index < kSubgroupsPerWorkgroup;
+                   ++subgroup_index) {
+                const float subgroup_sum = partial_sum[subgroup_index];
+                if (subgroup_sum > 0.0f) {
+                  const float merge_weight = sycl::exp(
+                      partial_max[subgroup_index] - global_max);
+                  global_sum += merge_weight * subgroup_sum;
+                  global_output +=
+                      merge_weight *
+                      partial_output[subgroup_index * kHeadSize + dim];
+                }
+              }
+              const int64_t output_index =
+                  (query_row * num_query_heads + query_head) * kHeadSize + dim;
+              output_ptr[output_index] = static_cast<sycl_t>(
+                  global_sum > 0.0f ? global_output / global_sum : 0.0f);
+            });
+  });
+}
+
+}  // namespace
+
+void paged_tree_attention_xpu(
+    torch::Tensor& output,
+    const torch::Tensor& query,
+    const torch::Tensor& key_cache,
+    const torch::Tensor& value_cache,
+    const torch::Tensor& block_table,
+    const torch::Tensor& seq_lens,
+    const torch::Tensor& tree_bias,
+    const double scale) {
+  CHECK_DEVICE(output);
+  CHECK_DEVICE(query);
+  CHECK_DEVICE(key_cache);
+  CHECK_DEVICE(value_cache);
+  CHECK_DEVICE(block_table);
+  CHECK_DEVICE(seq_lens);
+  CHECK_DEVICE(tree_bias);
+  CHECK_CONTIGUOUS(output);
+  CHECK_CONTIGUOUS(query);
+  CHECK_CONTIGUOUS(block_table);
+  CHECK_CONTIGUOUS(seq_lens);
+  CHECK_CONTIGUOUS(tree_bias);
+
+  TORCH_CHECK(query.dim() == 3, "query must have shape [Q, Hq, 256]");
+  TORCH_CHECK(
+      key_cache.dim() == 4 && value_cache.dim() == 4,
+      "key/value cache must have shape [blocks, block_size, Hkv, 256]");
+  TORCH_CHECK(
+      key_cache.sizes() == value_cache.sizes(),
+      "key and value cache shapes must match");
+  TORCH_CHECK(
+      key_cache.stride(3) == 1 && value_cache.stride(3) == 1,
+      "key/value cache head dimensions must be contiguous");
+  TORCH_CHECK(
+      block_table.dim() == 2 && block_table.size(0) == 1,
+      "block_table must have shape [1, max_blocks]");
+  TORCH_CHECK(seq_lens.numel() == 1, "seq_lens must contain one sequence");
+  TORCH_CHECK(
+      tree_bias.dim() == 2 && tree_bias.size(0) == query.size(0) &&
+          tree_bias.size(1) == query.size(0),
+      "tree_bias must have shape [Q, Q]");
+  TORCH_CHECK(
+      query.size(0) > 0 && query.size(0) <= 32,
+      "native tree attention supports 1 <= Q <= 32");
+  TORCH_CHECK(
+      query.size(2) == 256 && key_cache.size(3) == 256,
+      "native tree attention currently requires head_size=256");
+  TORCH_CHECK(
+      key_cache.size(1) > 0 && key_cache.size(2) > 0,
+      "key cache dimensions must be nonzero");
+  TORCH_CHECK(
+      query.size(1) % key_cache.size(2) == 0,
+      "query head count must be divisible by KV head count");
+  TORCH_CHECK(
+      output.numel() == query.numel(),
+      "output and query must have the same number of elements");
+  TORCH_CHECK(
+      output.scalar_type() == query.scalar_type() &&
+          key_cache.scalar_type() == query.scalar_type() &&
+          value_cache.scalar_type() == query.scalar_type(),
+      "query, key/value cache, and output dtypes must match");
+  TORCH_CHECK(
+      block_table.scalar_type() == at::kInt,
+      "block_table must be int32");
+  TORCH_CHECK(seq_lens.scalar_type() == at::kInt, "seq_lens must be int32");
+  TORCH_CHECK(
+      tree_bias.scalar_type() == at::kFloat,
+      "tree_bias must be float32");
+
+  VLLM_DISPATCH_FLOATING_TYPES(
+      query.scalar_type(), "paged_tree_attention_xpu", [&] {
+        paged_tree_attention_xpu_impl<scalar_t>(
+            output,
+            query,
+            key_cache,
+            value_cache,
+            block_table,
+            seq_lens,
+            tree_bias,
+            scale);
+      });
+}
