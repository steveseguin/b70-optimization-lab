+void kv_cache_copy_slots(
+    torch::Tensor& kv_cache,
+    const torch::Tensor& source_slots,
+    const torch::Tensor& destination_slots) {
+  CHECK_DEVICE(kv_cache);
+  CHECK_DEVICE(source_slots);
+  CHECK_DEVICE(destination_slots);
+  TORCH_CHECK(kv_cache.dim() >= 4, "kv_cache must have at least four dims");
+  TORCH_CHECK(kv_cache.size(0) > 0, "kv_cache plane dimension must be nonzero");
+  TORCH_CHECK(
+      source_slots.scalar_type() == at::kLong,
+      "source_slots must be int64");
+  TORCH_CHECK(
+      destination_slots.scalar_type() == at::kLong,
+      "destination_slots must be int64");
+  CHECK_CONTIGUOUS(source_slots);
+  CHECK_CONTIGUOUS(destination_slots);
+  TORCH_CHECK(
+      source_slots.numel() == destination_slots.numel(),
+      "source and destination slot counts must match");
+  if (source_slots.numel() == 0) {
+    return;
+  }
+
+  const int64_t planes = kv_cache.size(0);
+  const int64_t num_blocks = kv_cache.size(1);
+  const int64_t block_size = kv_cache.size(2);
+  const int64_t row_elements =
+      kv_cache.numel() / (planes * num_blocks * block_size);
+  TORCH_CHECK(
+      kv_cache.stride(2) == row_elements,
+      "kv_cache token rows must be contiguous");
+  const int64_t element_bytes = kv_cache.element_size();
+  const int64_t row_bytes = row_elements * element_bytes;
+  const int64_t stride0_bytes = kv_cache.stride(0) * element_bytes;
+  const int64_t stride1_bytes = kv_cache.stride(1) * element_bytes;
+  const int64_t stride2_bytes = kv_cache.stride(2) * element_bytes;
+  const int64_t num_pairs = source_slots.numel();
+  const int64_t* source_ptr = source_slots.data_ptr<int64_t>();
+  const int64_t* destination_ptr = destination_slots.data_ptr<int64_t>();
+  auto& queue = vllm::xpu::vllmGetQueue();
+
+  if (row_bytes % static_cast<int64_t>(sizeof(uint32_t)) == 0 &&
+      stride0_bytes % static_cast<int64_t>(sizeof(uint32_t)) == 0 &&
+      stride1_bytes % static_cast<int64_t>(sizeof(uint32_t)) == 0 &&
+      stride2_bytes % static_cast<int64_t>(sizeof(uint32_t)) == 0) {
+    uint32_t* cache_ptr = reinterpret_cast<uint32_t*>(kv_cache.data_ptr());
+    const int64_t row_words = row_bytes / sizeof(uint32_t);
+    const int64_t stride0 = stride0_bytes / sizeof(uint32_t);
+    const int64_t stride1 = stride1_bytes / sizeof(uint32_t);
+    const int64_t stride2 = stride2_bytes / sizeof(uint32_t);
+    queue.parallel_for(sycl::range<1>(planes * row_words), [=](sycl::id<1> id) {
+      const int64_t linear = id[0];
+      const int64_t plane = linear / row_words;
+      const int64_t word = linear % row_words;
+      for (int64_t pair = 0; pair < num_pairs; ++pair) {
+        const int64_t source_slot = source_ptr[pair];
+        const int64_t destination_slot = destination_ptr[pair];
+        const int64_t source_block = source_slot / block_size;
+        const int64_t source_offset = source_slot % block_size;
+        const int64_t destination_block = destination_slot / block_size;
+        const int64_t destination_offset = destination_slot % block_size;
+        const int64_t source_index = plane * stride0 + source_block * stride1 +
+                                     source_offset * stride2 + word;
+        const int64_t destination_index =
+            plane * stride0 + destination_block * stride1 +
+            destination_offset * stride2 + word;
+        cache_ptr[destination_index] = cache_ptr[source_index];
+      }
+    });
+    return;
+  }
+
+  uint8_t* cache_ptr = reinterpret_cast<uint8_t*>(kv_cache.data_ptr());
+  queue.parallel_for(sycl::range<1>(planes * row_bytes), [=](sycl::id<1> id) {
+    const int64_t linear = id[0];
+    const int64_t plane = linear / row_bytes;
+    const int64_t byte = linear % row_bytes;
+    for (int64_t pair = 0; pair < num_pairs; ++pair) {
+      const int64_t source_slot = source_ptr[pair];
+      const int64_t destination_slot = destination_ptr[pair];
+      const int64_t source_block = source_slot / block_size;
+      const int64_t source_offset = source_slot % block_size;
+      const int64_t destination_block = destination_slot / block_size;
+      const int64_t destination_offset = destination_slot % block_size;
+      const int64_t source_index = plane * stride0_bytes +
+                                   source_block * stride1_bytes +
+                                   source_offset * stride2_bytes + byte;
+      const int64_t destination_index =
+          plane * stride0_bytes + destination_block * stride1_bytes +
+          destination_offset * stride2_bytes + byte;
+      cache_ptr[destination_index] = cache_ptr[source_index];
+    }
+  });
+}
