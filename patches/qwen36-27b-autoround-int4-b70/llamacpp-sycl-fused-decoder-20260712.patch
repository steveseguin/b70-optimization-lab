+class sycl_cycle_timer {
+public:
+    sycl_cycle_timer(ggml_backend_sycl_context * ctx, int nodes) :
+        enabled(g_ggml_sycl_cycle_timing != 0),
+        device(ctx->device),
+        nodes(nodes) {
+        if (!enabled) {
+            return;
+        }
+        queue = ctx->stream();
+        if (!queue->has_property<sycl::property::queue::enable_profiling>()) {
+            static std::atomic<bool> warned = false;
+            if (!warned.exchange(true)) {
+                GGML_LOG_ERROR("[SYCL-CYCLE] disabled reason=queue_profiling_unavailable\n");
+            }
+            enabled = false;
+            return;
+        }
+        sequence = ++next_sequence;
+        host_begin = clock::now();
+        begin_event = queue->ext_oneapi_submit_barrier();
+    }
+
+    ~sycl_cycle_timer() noexcept {
+        if (!enabled) {
+            return;
+        }
+        try {
+            const auto host_work_submitted = clock::now();
+            sycl::event end_event = queue->ext_oneapi_submit_barrier();
+            const auto host_marker_submitted = clock::now();
+            end_event.wait_and_throw();
+            const auto host_done = clock::now();
+
+            const uint64_t begin_end = begin_event->get_profiling_info<
+                sycl::info::event_profiling::command_end>();
+            const uint64_t end_start = end_event.get_profiling_info<
+                sycl::info::event_profiling::command_start>();
+
+            double graph_queue_us = -1.0;
+            double graph_exec_us = -1.0;
+            if (graph_event.has_value()) {
+                try {
+                    const uint64_t submit = graph_event->get_profiling_info<
+                        sycl::info::event_profiling::command_submit>();
+                    const uint64_t start = graph_event->get_profiling_info<
+                        sycl::info::event_profiling::command_start>();
+                    const uint64_t end = graph_event->get_profiling_info<
+                        sycl::info::event_profiling::command_end>();
+                    graph_queue_us = elapsed_us(submit, start);
+                    graph_exec_us = elapsed_us(start, end);
+                } catch (const sycl::exception &) {
+                }
+            }
+
+            GGML_LOG_INFO(
+                "[SYCL-CYCLE] seq=%" PRIu64 " device=%d path=%s nodes=%d "
+                "host_work_submit_us=%.3f host_marker_submit_us=%.3f host_sync_us=%.3f "
+                "host_total_us=%.3f device_queue_us=%.3f graph_queue_us=%.3f graph_exec_us=%.3f\n",
+                sequence, device, path, nodes,
+                duration_us(host_begin, host_work_submitted),
+                duration_us(host_work_submitted, host_marker_submitted),
+                duration_us(host_marker_submitted, host_done),
+                duration_us(host_begin, host_done), elapsed_us(begin_end, end_start),
+                graph_queue_us, graph_exec_us);
+        } catch (const sycl::exception & e) {
+            GGML_LOG_ERROR("[SYCL-CYCLE] seq=%" PRIu64 " device=%d path=%s error=%s\n",
+                           sequence, device, path, e.what());
+        }
+    }
+
+    void set_path(const char * value) {
+        if (enabled) {
+            path = value;
+        }
+    }
+
+    void set_graph_event(sycl::event event) {
+        if (enabled) {
+            graph_event = std::move(event);
+        }
+    }
+
+private:
+    using clock = std::chrono::steady_clock;
+
+    static double duration_us(clock::time_point begin, clock::time_point end) {
+        return std::chrono::duration<double, std::micro>(end - begin).count();
+    }
+
+    static double elapsed_us(uint64_t begin, uint64_t end) {
+        return end >= begin ? static_cast<double>(end - begin) / 1000.0 : -1.0;
+    }
+
+    static std::atomic<uint64_t> next_sequence;
+    bool enabled;
+    queue_ptr queue = nullptr;
+    int device;
+    int nodes;
+    uint64_t sequence = 0;
+    const char * path = "ordinary";
+    clock::time_point host_begin;
+    std::optional<sycl::event> begin_event;
+    std::optional<sycl::event> graph_event;
+};
+
+std::atomic<uint64_t> sycl_cycle_timer::next_sequence = 0;
