+        ggml_tensor * down_add = ggml_add(ctx, down, down_residual);
+        ggml_set_name(warm, "warm");
+        ggml_set_name(first_add, "first_add");
+        ggml_set_name(rms, "rms");
+        ggml_set_name(norm_mul, "norm_mul");
+        ggml_set_name(down, "down");
+        ggml_set_name(down_add, "down_add");
+        return ggml_concat(ctx, warm, down_add, 1);
+    }
