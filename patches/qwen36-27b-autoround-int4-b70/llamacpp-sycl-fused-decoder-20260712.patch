+
+        ggml_tensor * first_weight = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, k, k);
+        ggml_tensor * down_weight = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, k, m);
