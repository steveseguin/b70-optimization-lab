+
+void ggml_sycl_ssm_conv_silu_qk_norm(
+        ggml_backend_sycl_context & ctx, ggml_tensor * conv, ggml_tensor * silu,
+        ggml_tensor * q_norm, ggml_tensor * k_norm, int head_dim, int q_heads,
+        int k_heads, float q_eps, float k_eps, const ggml_sycl_ssm_conv_cache & cache) {
+    const ggml_tensor * src = conv->src[0];
+    const ggml_tensor * weights = conv->src[1];
+    GGML_ASSERT(src->type == GGML_TYPE_F32 && weights->type == GGML_TYPE_F32 &&
+                conv->type == GGML_TYPE_F32 && silu->type == GGML_TYPE_F32 &&
+                q_norm->type == GGML_TYPE_F32 && k_norm->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(conv, silu));
+    GGML_ASSERT(head_dim > 0 && head_dim <= 256 && head_dim % WARP_SIZE == 0);
+    GGML_ASSERT(q_heads > 0 && k_heads > 0);
+
+    const int d_conv = weights->ne[0];
+    const int ncs = src->ne[0];
+    const int d_inner = src->ne[1];
+    const int n_t = conv->ne[1];
+    const int n_s = conv->ne[2];
+    const int norm_heads = q_heads + k_heads;
+    GGML_ASSERT(d_inner % head_dim == 0 && norm_heads * head_dim <= d_inner);
+
+    const float * src_data = static_cast<const float *>(src->data);
+    const float * weight_data = static_cast<const float *>(weights->data);
+    float * silu_data = static_cast<float *>(silu->data);
+    float * q_data = static_cast<float *>(q_norm->data);
+    float * k_data = static_cast<float *>(k_norm->data);
+    const int total_heads = d_inner / head_dim;
+    const size_t groups = static_cast<size_t>(total_heads) * n_t * n_s;
+    const int values_per_lane = head_dim / WARP_SIZE;
+
+    const int64_t q_s0 = q_norm->nb[0] / sizeof(float);
+    const int64_t q_s1 = q_norm->nb[1] / sizeof(float);
+    const int64_t q_s2 = q_norm->nb[2] / sizeof(float);
+    const int64_t q_s3 = q_norm->nb[3] / sizeof(float);
+    const int64_t k_s0 = k_norm->nb[0] / sizeof(float);
+    const int64_t k_s1 = k_norm->nb[1] / sizeof(float);
+    const int64_t k_s2 = k_norm->nb[2] / sizeof(float);
+    const int64_t k_s3 = k_norm->nb[3] / sizeof(float);
+
+    ctx.stream()->submit([&](sycl::handler & h) {
+        h.parallel_for(
+            sycl::nd_range<1>(sycl::range<1>(groups * WARP_SIZE), sycl::range<1>(WARP_SIZE)),
+            [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int lane = item.get_local_id(0);
+                const size_t group = item.get_group(0);
+                const int head = group % total_heads;
+                const int token = (group / total_heads) % n_t;
+                const int seq = group / (static_cast<size_t>(total_heads) * n_t);
+                float values[16];
+                float sq_sum = 0.0f;
+
+                for (int j = 0; j < values_per_lane; ++j) {
+                    const int col = lane + j * WARP_SIZE;
+                    const int channel = head * head_dim + col;
+                    const float * s = src_data + static_cast<size_t>(seq) * ncs * d_inner +
+                        static_cast<size_t>(channel) * ncs + token;
+                    const float * w = weight_data + static_cast<size_t>(channel) * d_conv;
+                    float sum = 0.0f;
+                    for (int tap = 0; tap < d_conv; ++tap) {
+                        sum += s[tap] * w[tap];
+                    }
+                    volatile float rounded_sum = sum;
+                    const float value = rounded_sum / (1.0f + sycl::exp(-rounded_sum));
+                    values[j] = value;
+                    silu_data[(static_cast<size_t>(seq) * n_t + token) * d_inner + channel] = value;
+                    if (head < norm_heads) {
+                        sq_sum += value * value;
+                    }
+                    if (token == 0) {
+                        for (int write = 0; write < cache.count; ++write) {
+                            const ggml_sycl_ssm_conv_cache_write desc = cache.writes[write];
+                            for (int tap = 0; tap < d_conv - 1; ++tap) {
+                                desc.data[static_cast<size_t>(seq) * desc.seq_stride +
+                                          static_cast<size_t>(channel) * (d_conv - 1) + tap] =
+                                    src_data[static_cast<size_t>(seq) * ncs * d_inner +
+                                             static_cast<size_t>(channel) * ncs + desc.src_offset + tap];
+                            }
+                        }
+                    }
+                }
+
+                if (head < norm_heads) {
+                    sq_sum = warp_reduce_sum<WARP_SIZE>(sq_sum);
+                    const bool is_q = head < q_heads;
+                    const int norm_head = is_q ? head : head - q_heads;
+                    const float scale = sycl::rsqrt(sycl::fmax(sq_sum,
+                        (is_q ? q_eps : k_eps) * (is_q ? q_eps : k_eps)));
+                    for (int j = 0; j < values_per_lane; ++j) {
+                        const int col = lane + j * WARP_SIZE;
+                        if (is_q) {
+                            q_data[static_cast<int64_t>(seq) * q_s3 + static_cast<int64_t>(token) * q_s2 +
+                                   static_cast<int64_t>(norm_head) * q_s1 + static_cast<int64_t>(col) * q_s0] =
+                                scale * values[j];
+                        } else {
+                            k_data[static_cast<int64_t>(seq) * k_s3 + static_cast<int64_t>(token) * k_s2 +
+                                   static_cast<int64_t>(norm_head) * k_s1 + static_cast<int64_t>(col) * k_s0] =
+                                scale * values[j];
+                        }
+                    }
+                }
+            });
+    });
+}
