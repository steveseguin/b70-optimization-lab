+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override { return 5e-4; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        constexpr int64_t k = 512;
+        constexpr int64_t m = 513;
+
+        ggml_tensor * weight = ggml_new_tensor_2d(ctx, GGML_TYPE_Q4_0, k, m);
+        ggml_tensor * warm_in = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, 1);
+        ggml_tensor * residual = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, m, n);
+        ggml_tensor * glu;
+        if (split) {
+            GGML_ASSERT(!swapped);
+            ggml_tensor * gate = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+            ggml_tensor * up = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+            ggml_set_name(gate, "gate");
+            ggml_set_name(up, "up");
+            glu = ggml_swiglu_split(ctx, gate, up);
+        } else {
+            ggml_tensor * packed = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2 * k, n);
+            ggml_set_name(packed, "packed");
+            glu = swapped ? ggml_swiglu_swapped(ctx, packed) : ggml_swiglu(ctx, packed);
+        }
+        ggml_set_name(weight, "weight");
+        ggml_set_name(warm_in, "warm_in");
+        ggml_set_name(residual, "residual");
+        ggml_set_name(glu, "swiglu");
+
+        ggml_tensor * warm = ggml_mul_mat(ctx, weight, warm_in);
+        ggml_tensor * mm = ggml_mul_mat(ctx, weight, glu);
+        ggml_tensor * add = ggml_add(ctx, mm, residual);
+        ggml_set_name(warm, "warm");
+        ggml_set_name(mm, "down");
+        ggml_set_name(add, "down_add");
+        return ggml_concat(ctx, warm, add, 1);
+    }
+};
