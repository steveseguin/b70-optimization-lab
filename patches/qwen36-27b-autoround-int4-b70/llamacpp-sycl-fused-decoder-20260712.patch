+template <bool Reorder>
+void swiglu_quantize_row_q8_1_sycl(const float * gate, const float * up, void * vy, const int kx, const int ky,
+                                   const int kx_padded, const int64_t input_stride, dpct::queue_ptr stream) {
+    static_assert(QK8_1 % WARP_SIZE == 0);
+    GGML_ASSERT(kx % QK8_1 == 0);
+    constexpr int elements_per_wi = QK8_1 / WARP_SIZE;
+    const int blocks_per_row = kx / QK8_1;
+    const size_t global_range = size_t(ky) * blocks_per_row * WARP_SIZE;
+    stream->parallel_for(sycl::nd_range<1>({global_range}, {size_t(WARP_SIZE)}),
+                         [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+        const int block_linear = it.get_group(0);
+        const int row = block_linear / blocks_per_row;
+        const int block = block_linear % blocks_per_row;
+        const int lane = it.get_local_id(0);
+        sycl::vec<float, elements_per_wi> values;
+        float sum = 0.0f;
+        float amax = 0.0f;
+#pragma unroll(elements_per_wi)
+        for (int j = 0; j < elements_per_wi; ++j) {
+            const int col = block * QK8_1 + lane * elements_per_wi + j;
+            const int64_t offset = row * input_stride + col;
+            const float x = gate[offset];
+            // Match the two-kernel path's mandatory F32 store/load boundary.
+            // Without this rounding point the compiler may reassociate the
+            // activation and multiply before Q8 quantization.
+            volatile float silu_value = x / (1.0f + sycl::exp(-x));
+            const float value = silu_value * up[offset];
+            values[j] = value;
+            sum += value;
+            amax = sycl::fmax(amax, sycl::fabs(value));
+        }
+        const auto subgroup = it.get_sub_group();
+        sum = sycl::reduce_over_group(subgroup, sum, sycl::plus<float>());
+        amax = sycl::reduce_over_group(subgroup, amax, sycl::maximum<float>());
+        const float d = amax == 0.0f ? 1.0f : amax / 127.0f;
+        sycl::vec<int8_t, elements_per_wi> quantized;
+#pragma unroll(elements_per_wi)
+        for (int j = 0; j < elements_per_wi; ++j) {
+            quantized[j] = sycl::round(values[j] / d);
+        }
+        if constexpr (Reorder) {
+            const size_t row_offset = row * (kx_padded / QK8_1) * sizeof(block_q8_1);
+            int8_t * qs = reinterpret_cast<int8_t *>(reinterpret_cast<char *>(vy) + row_offset) +
+                          block * QK8_1 + lane * elements_per_wi;
+            *reinterpret_cast<sycl::vec<int8_t, elements_per_wi> *>(qs) = quantized;
+            if (lane == 0) {
+                auto * ds = reinterpret_cast<sycl::half2 *>(reinterpret_cast<char *>(vy) + row_offset + kx +
+                                                            block * sizeof(sycl::half2));
+                *ds = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : d), sycl::half(sum));
+            }
+        } else {
+            auto * blocks = reinterpret_cast<block_q8_1 *>(vy);
+            const int block_id = row * (kx_padded / QK8_1) + block;
+            *reinterpret_cast<sycl::vec<int8_t, elements_per_wi> *>(
+                &blocks[block_id].qs[lane * elements_per_wi]) = quantized;
+            if (lane == 0) {
+                blocks[block_id].ds = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : d), sycl::half(sum));
+            }
+        }
+    });
+}
