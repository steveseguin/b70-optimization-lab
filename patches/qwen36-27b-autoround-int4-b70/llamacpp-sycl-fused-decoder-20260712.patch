+    const int d_inner = src0->ne[1];
+    const int n_t = conv->ne[1];
+    const int n_s = conv->ne[2];
+    kernel_ssm_conv(*ctx.stream(), static_cast<const float *>(src0->data),
+                    static_cast<const float *>(src1->data), static_cast<float *>(output->data),
+                    d_conv, d_inner, n_t, n_s, ncs, ncs, ncs * d_inner,
+                    d_inner, d_inner * n_t, apply_silu, cache);
