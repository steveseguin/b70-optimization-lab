+template <bool Reorder>
+void rms_norm_quantize_row_q8_1_sycl(const float * x, const float * weight, void * vy, const int kx, const int ky,
+                                     const int kx_padded, const float eps, const int work_group_size,
+                                     dpct::queue_ptr stream) {
+    static_assert(QK8_1 % WARP_SIZE == 0);
+    GGML_ASSERT(kx % QK8_1 == 0);
+    GGML_ASSERT(work_group_size % WARP_SIZE == 0);
+
+    const int num_blocks = kx / QK8_1;
+    const int num_subgroups = work_group_size / WARP_SIZE;
+    const sycl::range<1> local_range(work_group_size);
+    const sycl::range<1> global_range(ky * work_group_size);
+    dpct::has_capability_or_fail(stream->get_device(), { sycl::aspect::fp16 });
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> subgroup_sums(sycl::range<1>(num_subgroups), cgh);
+        cgh.parallel_for(sycl::nd_range<1>(global_range, local_range),
+                         [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const int row = it.get_group(0);
+            const int tid = it.get_local_id(0);
+            const auto subgroup = it.get_sub_group();
+            const int subgroup_id = subgroup.get_group_linear_id();
+            const int lane = subgroup.get_local_linear_id();
+            const float * row_x = x + row * kx;
+
+            float sum_sq = 0.0f;
+            for (int col = tid; col < kx; col += work_group_size) {
+                const float value = row_x[col];
+                sum_sq += value * value;
+            }
+            sum_sq = sycl::reduce_over_group(subgroup, sum_sq, sycl::plus<float>());
+            if (lane == 0) {
+                subgroup_sums[subgroup_id] = sum_sq;
+            }
+            it.barrier(sycl::access::fence_space::local_space);
+            if (subgroup_id == 0) {
+                float total = 0.0f;
+                for (int i = lane; i < num_subgroups; i += WARP_SIZE) {
+                    total += subgroup_sums[i];
+                }
+                total = sycl::reduce_over_group(subgroup, total, sycl::plus<float>());
+                if (lane == 0) {
+                    subgroup_sums[0] = sycl::rsqrt(total / kx + eps);
+                }
+            }
+            it.barrier(sycl::access::fence_space::local_space);
+            const float rms_scale = subgroup_sums[0];
+
+            constexpr int elements_per_wi = QK8_1 / WARP_SIZE;
+            for (int block = subgroup_id; block < num_blocks; block += num_subgroups) {
+                sycl::vec<float, elements_per_wi> values;
+                float sum = 0.0f;
+                float amax = 0.0f;
+#pragma unroll(elements_per_wi)
+                for (int i = 0; i < elements_per_wi; ++i) {
+                    const int col = block * QK8_1 + lane * elements_per_wi + i;
+                    const float value = row_x[col] * rms_scale * weight[col];
+                    values[i] = value;
+                    sum += value;
+                    amax = sycl::fmax(amax, sycl::fabs(value));
+                }
+                sum = sycl::reduce_over_group(subgroup, sum, sycl::plus<float>());
+                amax = sycl::reduce_over_group(subgroup, amax, sycl::maximum<float>());
+                const float d = amax == 0.0f ? 1.0f : amax / 127.0f;
+                sycl::vec<int8_t, elements_per_wi> quantized;
+#pragma unroll(elements_per_wi)
+                for (int i = 0; i < elements_per_wi; ++i) {
+                    quantized[i] = sycl::round(values[i] / d);
+                }
+
+                if constexpr (Reorder) {
+                    const size_t row_offset = row * (kx_padded / QK8_1) * sizeof(block_q8_1);
+                    int8_t * qs = reinterpret_cast<int8_t *>(reinterpret_cast<char *>(vy) + row_offset) +
+                                  block * QK8_1 + lane * elements_per_wi;
+                    *reinterpret_cast<sycl::vec<int8_t, elements_per_wi> *>(qs) = quantized;
+                    if (lane == 0) {
+                        sycl::half2 * ds = reinterpret_cast<sycl::half2 *>(
+                            reinterpret_cast<char *>(vy) + row_offset + kx + block * sizeof(sycl::half2));
+                        *ds = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : d), sycl::half(sum));
+                    }
+                } else {
+                    block_q8_1 * blocks = reinterpret_cast<block_q8_1 *>(vy);
+                    const int block_id = row * (kx_padded / QK8_1) + block;
+                    int8_t * qs = &blocks[block_id].qs[lane * elements_per_wi];
+                    *reinterpret_cast<sycl::vec<int8_t, elements_per_wi> *>(qs) = quantized;
+                    if (lane == 0) {
+                        blocks[block_id].ds = sycl::half2(
+                            sycl::half(amax == 0.0f ? 0.0f : d), sycl::half(sum));
+                    }
+                }
+            }
+        });
+    });
+}
