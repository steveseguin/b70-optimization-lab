+enum class mmvq_add_reject {
+    none,
+    next_op,
+    sources,
+    use_count,
+    type_shape,
+    layout,
+    device,
+    dispatch,
+    overlap,
+    flags,
+    metadata,
+};
+
+static const char * mmvq_add_reject_name(mmvq_add_reject reason) {
+    switch (reason) {
+        case mmvq_add_reject::none:      return "none";
+        case mmvq_add_reject::next_op:   return "next_op";
+        case mmvq_add_reject::sources:   return "sources";
+        case mmvq_add_reject::use_count: return "use_count";
+        case mmvq_add_reject::type_shape:return "type_shape";
+        case mmvq_add_reject::layout:    return "layout";
+        case mmvq_add_reject::device:    return "device";
+        case mmvq_add_reject::dispatch:  return "dispatch";
+        case mmvq_add_reject::overlap:   return "overlap";
+        case mmvq_add_reject::flags:     return "flags";
+        case mmvq_add_reject::metadata:  return "metadata";
+    }
+    return "unknown";
+}
+
+static bool mmvq_add_log_count(uint64_t count) {
+    return count != 0 && (count & (count - 1)) == 0;
+}
+
+static bool mmvq_add_ranges_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    const uintptr_t a0 = reinterpret_cast<uintptr_t>(a->data);
+    const uintptr_t b0 = reinterpret_cast<uintptr_t>(b->data);
+    return a0 < b0 + ggml_nbytes(b) && b0 < a0 + ggml_nbytes(a);
+}
+
+static bool mmvq_add_metadata_op(enum ggml_op op) {
+    return op == GGML_OP_RESHAPE || op == GGML_OP_TRANSPOSE || op == GGML_OP_VIEW ||
+           op == GGML_OP_PERMUTE || op == GGML_OP_NONE;
+}
+
+static bool mmvq_add_candidate(const ggml_tensor * mm) {
+    if (mm->op != GGML_OP_MUL_MAT || mm->src[0] == nullptr || mm->src[1] == nullptr ||
+        mm->type != GGML_TYPE_F32 || mm->src[1]->type != GGML_TYPE_F32) {
+        return false;
+    }
+    const enum ggml_type weight_type = mm->src[0]->type;
+    return weight_type == GGML_TYPE_Q4_0 || weight_type == GGML_TYPE_Q4_1 || weight_type == GGML_TYPE_Q5_K;
+}
+
+static bool mmvq_add_transparent_metadata(const ggml_tensor * metadata, const ggml_tensor * source) {
+    if (!mmvq_add_metadata_op(metadata->op) || metadata->src[0] != source ||
+        metadata->data != source->data || metadata->type != source->type ||
+        ggml_nelements(metadata) != ggml_nelements(source) ||
+        !ggml_is_contiguous(metadata) || !ggml_is_contiguous(source)) {
+        return false;
+    }
+    for (int j = 1; j < GGML_MAX_SRC; ++j) {
+        if (metadata->src[j] != nullptr) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool mmvq_add_would_use_mmvq(ggml_backend_sycl_context & ctx, const ggml_tensor * mm) {
+    const ggml_tensor * src0 = mm->src[0];
+    const ggml_tensor * src1 = mm->src[1];
+    if (!can_use_mul_mat_vec_q(src0, src1, const_cast<ggml_tensor *>(mm)) ||
+        ggml_backend_buffer_is_sycl_split(src0->buffer)) {
+        return false;
+    }
+
+    bool use_dmmv = can_use_dequantize_mul_mat_vec(src0, src1, const_cast<ggml_tensor *>(mm));
+    if (!g_ggml_sycl_prioritize_dmmv && should_reorder_tensor(ctx, mm) && ggml_sycl_supports_reorder_mmvq(src0->type)) {
+        if (!(ggml_sycl_info().devices[ctx.device].hw_info.arch == gpu_arch::intel_gpu_acm_g10 &&
+              src0->type == GGML_TYPE_Q4_0)) {
+            use_dmmv = false;
+        }
+    }
+    return !use_dmmv;
+}
+
+static mmvq_add_reject mmvq_add_eligible(ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph,
+                                         int mm_index, int * add_index, const ggml_tensor ** residual) {
+    ggml_tensor * mm = cgraph->nodes[mm_index];
+    if (mm->op != GGML_OP_MUL_MAT) {
+        return mmvq_add_reject::next_op;
+    }
+
+    const ggml_tensor * mm_value = mm;
+    int mm_value_index = mm_index;
+    int next = mm_index + 1;
+    for (; next < cgraph->n_nodes; ++next) {
+        ggml_tensor * candidate = cgraph->nodes[next];
+        if (ggml_is_empty(candidate) || mmvq_add_metadata_op(candidate->op) ||
+            (candidate->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            bool consumes_value = false;
+            for (int j = 0; j < GGML_MAX_SRC; ++j) {
+                consumes_value = consumes_value || candidate->src[j] == mm_value;
+            }
+            if (!consumes_value) {
+                continue;
+            }
+            if (!mmvq_add_transparent_metadata(candidate, mm_value) ||
+                ggml_node_get_use_count(cgraph, mm_value_index) != 1) {
+                return mmvq_add_reject::metadata;
+            }
+            mm_value = candidate;
+            mm_value_index = next;
+            continue;
+        }
+        break;
+    }
+    if (next == cgraph->n_nodes || cgraph->nodes[next]->op != GGML_OP_ADD) {
+        return mmvq_add_reject::next_op;
+    }
+
+    ggml_tensor * add = cgraph->nodes[next];
+    const bool mm_src0 = add->src[0] == mm_value;
+    const bool mm_src1 = add->src[1] == mm_value;
+    if (mm_src0 == mm_src1) {
+        return mmvq_add_reject::sources;
+    }
+    const ggml_tensor * res = add->src[mm_src0 ? 1 : 0];
+    if (res == nullptr || ggml_node_get_use_count(cgraph, mm_value_index) != 1) {
+        return mmvq_add_reject::use_count;
+    }
+    constexpr int observable_flags = GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT |
+                                     GGML_TENSOR_FLAG_PARAM | GGML_TENSOR_FLAG_LOSS;
+    if ((mm->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || (add->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 ||
+        (mm->flags & observable_flags) != 0 || (mm_value->flags & observable_flags) != 0) {
+        return mmvq_add_reject::flags;
+    }
+    if (mm->type != GGML_TYPE_F32 || add->type != GGML_TYPE_F32 || res->type != GGML_TYPE_F32) {
+        return mmvq_add_reject::type_shape;
+    }
+    for (int dim = 0; dim < GGML_MAX_DIMS; ++dim) {
+        if (mm->ne[dim] != add->ne[dim] || add->ne[dim] != res->ne[dim]) {
+            return mmvq_add_reject::type_shape;
+        }
+    }
+    if (mm->ne[2] != 1 || mm->ne[3] != 1) {
+        return mmvq_add_reject::type_shape;
+    }
+    if (!ggml_is_contiguous(mm) || !ggml_is_contiguous(add) || !ggml_is_contiguous(res) ||
+        !ggml_is_contiguous(mm->src[0]) || !ggml_is_contiguous(mm->src[1]) ||
+        add->nb[1] != res->nb[1]) {
+        return mmvq_add_reject::layout;
+    }
+    if (mm->buffer == nullptr || add->buffer == nullptr || res->buffer == nullptr ||
+        mm->src[0]->buffer == nullptr || mm->src[1]->buffer == nullptr ||
+        mm->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        add->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        res->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        mm->src[0]->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        mm->src[1]->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        ggml_backend_buffer_is_sycl_split(mm->src[0]->buffer) ||
+        ggml_backend_buffer_is_sycl_split(mm->src[1]->buffer) ||
+        ggml_backend_buffer_is_sycl_split(add->buffer) ||
+        ggml_backend_buffer_is_sycl_split(res->buffer)) {
+        return mmvq_add_reject::device;
+    }
+    const enum ggml_type weight_type = mm->src[0]->type;
+    if ((weight_type != GGML_TYPE_Q4_0 && weight_type != GGML_TYPE_Q4_1 && weight_type != GGML_TYPE_Q5_K) ||
+        !mmvq_add_would_use_mmvq(ctx, mm)) {
+        return mmvq_add_reject::dispatch;
+    }
+
+    const bool dst_is_residual = add->data == res->data;
+    const bool dst_is_mm = add->data == mm->data && ggml_nbytes(add) == ggml_nbytes(mm);
+    if ((!dst_is_residual && mmvq_add_ranges_overlap(add, res)) ||
+        (!dst_is_mm && mmvq_add_ranges_overlap(add, mm)) || mmvq_add_ranges_overlap(add, mm->src[0]) ||
+        mmvq_add_ranges_overlap(add, mm->src[1]) || mmvq_add_ranges_overlap(res, mm) ||
+        mmvq_add_ranges_overlap(res, mm->src[0]) || mmvq_add_ranges_overlap(res, mm->src[1])) {
+        return mmvq_add_reject::overlap;
+    }
+
+    *add_index = next;
+    *residual = res;
+    return mmvq_add_reject::none;
+}
+
+static void mmvq_add_log_rejection_detail(const ggml_cgraph * cgraph, int mm_index, mmvq_add_reject reason) {
+    GGML_LOG_INFO("MMVQ+ADD first rejection detail reason=%s mm_index=%d\n",
+                  mmvq_add_reject_name(reason), mm_index);
+    const int last = std::min(cgraph->n_nodes, mm_index + 6);
+    for (int i = mm_index; i < last; ++i) {
+        const ggml_tensor * node = cgraph->nodes[i];
+        GGML_LOG_INFO("  node[%d] name=%s op=%s data=%p bytes=%zu ne=%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64
+                      " nb=%zu,%zu,%zu,%zu flags=%d uses=%d\n",
+                      i, node->name, ggml_op_name(node->op), node->data, ggml_nbytes(node),
+                      node->ne[0], node->ne[1], node->ne[2], node->ne[3],
+                      node->nb[0], node->nb[1], node->nb[2], node->nb[3], node->flags,
+                      ggml_node_get_use_count(cgraph, i));
+        for (int j = 0; j < GGML_MAX_SRC && node->src[j] != nullptr; ++j) {
+            const ggml_tensor * src = node->src[j];
+            GGML_LOG_INFO("    src[%d] name=%s op=%s data=%p bytes=%zu\n",
+                          j, src->name, ggml_op_name(src->op), src->data, ggml_nbytes(src));
+        }
+    }
+}
+
+enum class mmvq_add_rms_q8_reject {
+    none,
+    flags,
+    predecessor,
+    consumer,
+    use_count,
+    type_shape,
+    layout,
+    device,
+    dispatch,
+};
+
+static const char * mmvq_add_rms_q8_reject_name(mmvq_add_rms_q8_reject reason) {
+    switch (reason) {
+        case mmvq_add_rms_q8_reject::none:        return "none";
+        case mmvq_add_rms_q8_reject::flags:       return "flags";
+        case mmvq_add_rms_q8_reject::predecessor: return "predecessor";
+        case mmvq_add_rms_q8_reject::consumer:    return "consumer";
+        case mmvq_add_rms_q8_reject::use_count:   return "use_count";
+        case mmvq_add_rms_q8_reject::type_shape:  return "type_shape";
+        case mmvq_add_rms_q8_reject::layout:      return "layout";
+        case mmvq_add_rms_q8_reject::device:      return "device";
+        case mmvq_add_rms_q8_reject::dispatch:    return "dispatch";
+    }
+    return "unknown";
+}
+
+static mmvq_add_rms_q8_reject mmvq_add_rms_q8_eligible(
+        ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int rms_index,
+        const ggml_tensor * fused_add, int * first_consumer_index,
+        std::array<ggml_tensor *, 3> * consumers, int * consumer_count,
+        const float ** source, const float ** weight, void ** scratch,
+        size_t * scratch_bytes, bool * reorder, float * eps) {
+    ggml_tensor * rms = cgraph->nodes[rms_index];
+    if (!g_ggml_sycl_fuse_mmvq_add || (rms->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return mmvq_add_rms_q8_reject::flags;
+    }
+    const ggml_tensor * add = rms->src[0];
+    if (add == nullptr || add->op != GGML_OP_ADD || add != fused_add ||
+        ggml_node_get_use_count(cgraph, rms_index) != 1) {
+        return mmvq_add_rms_q8_reject::predecessor;
+    }
+
+    const int mul_index = rms_index + 1;
+    if (mul_index >= cgraph->n_nodes) {
+        return mmvq_add_rms_q8_reject::consumer;
+    }
+    ggml_tensor * norm_mul = cgraph->nodes[mul_index];
+    if (norm_mul->op != GGML_OP_MUL || (norm_mul->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+        return mmvq_add_rms_q8_reject::consumer;
+    }
+    const bool rms_src0 = norm_mul->src[0] == rms;
+    const bool rms_src1 = norm_mul->src[1] == rms;
+    if (rms_src0 == rms_src1) {
+        return mmvq_add_rms_q8_reject::consumer;
+    }
+    const ggml_tensor * norm_weight = norm_mul->src[rms_src0 ? 1 : 0];
+    if (norm_weight == nullptr || ggml_node_get_use_count(cgraph, rms_index) != 1) {
+        return mmvq_add_rms_q8_reject::use_count;
+    }
+
+    const ggml_tensor * norm_value = norm_mul;
+    int norm_value_index = mul_index;
+    int next = mul_index + 1;
+    for (; next < cgraph->n_nodes; ++next) {
+        ggml_tensor * candidate = cgraph->nodes[next];
+        if (ggml_is_empty(candidate) || mmvq_add_metadata_op(candidate->op) ||
+            (candidate->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            bool consumes_value = false;
+            for (int j = 0; j < GGML_MAX_SRC; ++j) {
+                consumes_value = consumes_value || candidate->src[j] == norm_value;
+            }
+            if (!consumes_value) {
+                continue;
+            }
+            if (!mmvq_add_transparent_metadata(candidate, norm_value) ||
+                ggml_node_get_use_count(cgraph, norm_value_index) != 1) {
+                return mmvq_add_rms_q8_reject::consumer;
+            }
+            norm_value = candidate;
+            norm_value_index = next;
+            continue;
+        }
+        break;
+    }
+    const int expected_consumers = ggml_node_get_use_count(cgraph, norm_value_index);
+    if (next == cgraph->n_nodes || expected_consumers < 1 || expected_consumers > 3) {
+        return mmvq_add_rms_q8_reject::consumer;
+    }
+
+    std::array<ggml_tensor *, 3> matched = {};
+    int matched_count = 0;
+    int matched_first = -1;
+    for (int i = next; i < cgraph->n_nodes; ++i) {
+        ggml_tensor * candidate = cgraph->nodes[i];
+        bool consumes_norm = false;
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            consumes_norm = consumes_norm || candidate->src[j] == norm_value;
+        }
+        if (!consumes_norm) {
+            continue;
+        }
+        if (candidate->op != GGML_OP_MUL_MAT || candidate->src[1] != norm_value ||
+            (candidate->flags & GGML_TENSOR_FLAG_COMPUTE) == 0 || matched_count == 3) {
+            return mmvq_add_rms_q8_reject::consumer;
+        }
+        if (matched_first < 0) {
+            matched_first = i;
+        }
+        matched[matched_count++] = candidate;
+    }
+    if (matched_count != expected_consumers || matched_first != next) {
+        return mmvq_add_rms_q8_reject::consumer;
+    }
+
+    if (add->type != GGML_TYPE_F32 || rms->type != GGML_TYPE_F32 || norm_mul->type != GGML_TYPE_F32 ||
+        norm_weight->type != GGML_TYPE_F32 ||
+        add->ne[0] != rms->ne[0] || ggml_nelements(add) != ggml_nelements(rms) ||
+        ggml_nelements(norm_mul) != ggml_nelements(rms) || norm_mul->ne[0] != rms->ne[0] ||
+        norm_weight->ne[0] != rms->ne[0] || ggml_nelements(norm_weight) != rms->ne[0] ||
+        rms->ne[2] != 1 || rms->ne[3] != 1 || rms->ne[0] % QK8_1 != 0) {
+        return mmvq_add_rms_q8_reject::type_shape;
+    }
+    constexpr int observable_flags = GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT |
+                                     GGML_TENSOR_FLAG_PARAM | GGML_TENSOR_FLAG_LOSS;
+    if ((rms->flags & observable_flags) != 0 || (norm_mul->flags & observable_flags) != 0 ||
+        (norm_value->flags & observable_flags) != 0 || !ggml_is_contiguous(add) ||
+        !ggml_is_contiguous(rms) || !ggml_is_contiguous(norm_mul) || !ggml_is_contiguous(norm_weight) ||
+        !ggml_is_contiguous(norm_value)) {
+        return mmvq_add_rms_q8_reject::layout;
+    }
+    if (add->buffer == nullptr || rms->buffer == nullptr || norm_mul->buffer == nullptr ||
+        norm_weight->buffer == nullptr || norm_value->buffer == nullptr ||
+        add->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        rms->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        norm_mul->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        norm_weight->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        norm_value->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        ggml_backend_buffer_is_sycl_split(add->buffer) ||
+        ggml_backend_buffer_is_sycl_split(rms->buffer) ||
+        ggml_backend_buffer_is_sycl_split(norm_mul->buffer) ||
+        ggml_backend_buffer_is_sycl_split(norm_weight->buffer) ||
+        ggml_backend_buffer_is_sycl_split(norm_value->buffer)) {
+        return mmvq_add_rms_q8_reject::device;
+    }
+
+    bool common_reorder = false;
+    for (int i = 0; i < matched_count; ++i) {
+        ggml_tensor * mm = matched[i];
+        if (mm->src[0]->buffer == nullptr || !ggml_is_contiguous(mm->src[0]) ||
+            mm->src[0]->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+            ggml_backend_buffer_is_sycl_split(mm->src[0]->buffer) || !mmvq_add_would_use_mmvq(ctx, mm) ||
+            mmvq_add_ranges_overlap(norm_mul, mm) || mmvq_add_ranges_overlap(norm_mul, mm->src[0])) {
+            return mmvq_add_rms_q8_reject::dispatch;
+        }
+        const ggml_tensor_extra_gpu * extra = static_cast<const ggml_tensor_extra_gpu *>(mm->src[0]->extra);
+        const bool mm_reorder = (extra && extra->optimized_feature.reorder) ||
+            (g_ggml_sycl_enable_optimize && ctx.opt_feature.reorder && should_reorder_tensor(ctx, mm) &&
+             ggml_sycl_supports_reorder_mmvq(mm->src[0]->type));
+        if (i == 0) {
+            common_reorder = mm_reorder;
+        } else if (common_reorder != mm_reorder) {
+            return mmvq_add_rms_q8_reject::dispatch;
+        }
+    }
+
+    const size_t required_q8_bytes = ggml_nrows(norm_value) * GGML_PAD(norm_value->ne[0], MATRIX_ROW_PADDING) *
+                                     sizeof(block_q8_1) / QK8_1;
+    if (norm_mul->data == nullptr || reinterpret_cast<uintptr_t>(norm_mul->data) % alignof(block_q8_1) != 0 ||
+        ggml_nbytes(norm_mul) < required_q8_bytes) {
+        return mmvq_add_rms_q8_reject::layout;
+    }
+
+    *first_consumer_index = matched_first;
+    *consumers = matched;
+    *consumer_count = matched_count;
+    *source = static_cast<const float *>(add->data);
+    *weight = static_cast<const float *>(norm_weight->data);
+    *scratch = norm_mul->data;
+    *scratch_bytes = ggml_nbytes(norm_mul);
+    *reorder = common_reorder;
+    memcpy(eps, rms->op_params, sizeof(float));
+    return mmvq_add_rms_q8_reject::none;
+}
+
+static bool gdn_cache_is_view_or_noop(const ggml_tensor * tensor) {
+    return ggml_is_empty(tensor) || tensor->op == GGML_OP_RESHAPE || tensor->op == GGML_OP_TRANSPOSE ||
+           tensor->op == GGML_OP_VIEW || tensor->op == GGML_OP_PERMUTE || tensor->op == GGML_OP_NONE;
+}
+
+struct gdn_epilogue_match {
+    const ggml_tensor * rms = nullptr;
+    const ggml_tensor * learned = nullptr;
+    const ggml_tensor * silu = nullptr;
+    const ggml_tensor * final_mul = nullptr;
+    const ggml_tensor * consumer = nullptr;
+    std::array<const ggml_tensor *, 4> metadata = {};
+    int metadata_count = 0;
+    const float * input = nullptr;
+    const float * weight = nullptr;
+    const float * gate = nullptr;
+    void * scratch = nullptr;
+    size_t scratch_bytes = 0;
+    int64_t ncols = 0;
+    bool reorder = false;
+    float eps = 0.0f;
+};
+
+static int gdn_epilogue_node_index(const ggml_cgraph * cgraph, const ggml_tensor * tensor) {
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        if (cgraph->nodes[i] == tensor) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static bool gdn_epilogue_same_shape(const ggml_tensor * a, const ggml_tensor * b) {
+    return a != nullptr && b != nullptr && ggml_are_same_shape(a, b) &&
+           ggml_nelements(a) == ggml_nelements(b);
+}
+
+static bool gdn_epilogue_match_graph(
+        ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int rms_index,
+        gdn_epilogue_match * match) {
+    const ggml_tensor * rms = cgraph->nodes[rms_index];
+    if (rms->op != GGML_OP_RMS_NORM || rms->type != GGML_TYPE_F32 || rms->src[0] == nullptr) {
+        return false;
+    }
+
+    // Qwen GDN attention is the contiguous prefix view of the fused GDN result.
+    const ggml_tensor * input = rms->src[0];
+    const ggml_tensor * gdn = input->view_src;
+    if (input->op != GGML_OP_VIEW || gdn == nullptr || gdn->op != GGML_OP_GATED_DELTA_NET ||
+        input->view_offs != 0 || input->type != GGML_TYPE_F32 || !ggml_is_contiguous(input) ||
+        input->ne[0] <= 0 || input->ne[0] >= 1024) {
+        return false;
+    }
+
+    const ggml_tensor * learned = nullptr;
+    int learned_index = -1;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * candidate = cgraph->nodes[i];
+        if (candidate->op == GGML_OP_MUL && candidate->src[0] == rms) {
+            if (learned != nullptr) {
+                return false;
+            }
+            learned = candidate;
+            learned_index = i;
+        }
+    }
+    if (learned == nullptr || ggml_node_get_use_count(cgraph, rms_index) != 1) {
+        return false;
+    }
+    const ggml_tensor * weight = learned->src[1];
+    if (weight == nullptr || weight->type != GGML_TYPE_F32 || !ggml_is_contiguous(weight) ||
+        weight->ne[0] != input->ne[0] || ggml_nelements(weight) != input->ne[0]) {
+        return false;
+    }
+
+    const ggml_tensor * final_mul = nullptr;
+    const ggml_tensor * silu = nullptr;
+    int silu_index = -1;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * candidate = cgraph->nodes[i];
+        if (candidate->op != GGML_OP_MUL) {
+            continue;
+        }
+        const ggml_tensor * other = candidate->src[0] == learned ? candidate->src[1] :
+                                    candidate->src[1] == learned ? candidate->src[0] : nullptr;
+        if (other == nullptr || other->op != GGML_OP_UNARY ||
+            ggml_get_unary_op(other) != GGML_UNARY_OP_SILU) {
+            continue;
+        }
+        if (final_mul != nullptr) {
+            return false;
+        }
+        final_mul = candidate;
+        silu = other;
+        silu_index = gdn_epilogue_node_index(cgraph, silu);
+    }
+    if (final_mul == nullptr || silu_index < 0 || silu->src[0] == nullptr ||
+        silu->src[0]->type != GGML_TYPE_F32 || !ggml_is_contiguous(silu->src[0]) ||
+        ggml_nelements(silu) != ggml_nelements(input) ||
+        ggml_node_get_use_count(cgraph, learned_index) != 1 ||
+        ggml_node_get_use_count(cgraph, silu_index) != 1 ||
+        !gdn_epilogue_same_shape(rms, input) || !gdn_epilogue_same_shape(learned, input) ||
+        !gdn_epilogue_same_shape(final_mul, input)) {
+        return false;
+    }
+
+    constexpr int observable = GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT |
+                               GGML_TENSOR_FLAG_PARAM | GGML_TENSOR_FLAG_LOSS;
+    if ((rms->flags & observable) || (learned->flags & observable) || (silu->flags & observable) ||
+        !ggml_is_contiguous(rms) || !ggml_is_contiguous(learned) || !ggml_is_contiguous(silu) ||
+        !ggml_is_contiguous(final_mul)) {
+        return false;
+    }
+
+    const ggml_tensor * tensors[] = { input, weight, silu->src[0], final_mul };
+    for (const ggml_tensor * tensor : tensors) {
+        if (tensor->buffer == nullptr || tensor->data == nullptr ||
+            tensor->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+            ggml_backend_buffer_is_sycl_split(tensor->buffer)) {
+            return false;
+        }
+    }
+
+    const int final_index = gdn_epilogue_node_index(cgraph, final_mul);
+    const ggml_tensor * value = final_mul;
+    int value_index = final_index;
+    int next = final_index + 1;
+    int metadata_count = 0;
+    for (; next < cgraph->n_nodes; ++next) {
+        const ggml_tensor * candidate = cgraph->nodes[next];
+        if (candidate->op == GGML_OP_MUL_MAT && candidate->src[1] == value) {
+            break;
+        }
+        bool consumes_value = false;
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            consumes_value = consumes_value || candidate->src[j] == value;
+        }
+        if (!consumes_value) {
+            continue;
+        }
+        if (metadata_count == static_cast<int>(match->metadata.size()) ||
+            !mmvq_add_transparent_metadata(candidate, value) ||
+            ggml_node_get_use_count(cgraph, value_index) != 1) {
+            return false;
+        }
+        match->metadata[metadata_count++] = candidate;
+        value = candidate;
+        value_index = next;
+    }
+    if (next == cgraph->n_nodes || ggml_node_get_use_count(cgraph, value_index) != 1) {
+        return false;
+    }
+    const ggml_tensor * consumer = cgraph->nodes[next];
+    if (!mmvq_add_would_use_mmvq(ctx, consumer) ||
+        consumer->src[0] == nullptr || consumer->src[0]->buffer == nullptr ||
+        consumer->src[0]->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        ggml_backend_buffer_is_sycl_split(consumer->src[0]->buffer) ||
+        value->ne[0] % QK8_1 != 0 || value->ne[0] % input->ne[0] != 0) {
+        return false;
+    }
+    const ggml_tensor_extra_gpu * extra = static_cast<const ggml_tensor_extra_gpu *>(consumer->src[0]->extra);
+    const bool reorder = (extra && extra->optimized_feature.reorder) ||
+        (g_ggml_sycl_enable_optimize && ctx.opt_feature.reorder &&
+         should_reorder_tensor(ctx, consumer) &&
+         ggml_sycl_supports_reorder_mmvq(consumer->src[0]->type));
+    const size_t q8_bytes = ggml_nrows(value) * GGML_PAD(value->ne[0], MATRIX_ROW_PADDING) *
+                            sizeof(block_q8_1) / QK8_1;
+    if (final_mul->data == nullptr || reinterpret_cast<uintptr_t>(final_mul->data) % alignof(block_q8_1) != 0 ||
+        ggml_nbytes(final_mul) < q8_bytes || mmvq_add_ranges_overlap(final_mul, consumer->src[0])) {
+        return false;
+    }
+
+    match->rms = rms;
+    match->learned = learned;
+    match->silu = silu;
+    match->final_mul = final_mul;
+    match->consumer = consumer;
+    match->metadata_count = metadata_count;
+    match->input = static_cast<const float *>(input->data);
+    match->weight = static_cast<const float *>(weight->data);
+    match->gate = static_cast<const float *>(silu->src[0]->data);
+    match->scratch = final_mul->data;
+    match->scratch_bytes = ggml_nbytes(final_mul);
+    match->ncols = input->ne[0];
+    match->reorder = reorder;
+    memcpy(&match->eps, rms->op_params, sizeof(float));
+    return true;
+}
+
+// Match GATED_DELTA_NET plus the strided CPY that scatters its state snapshots
+// into the recurrent cache. This deliberately mirrors CUDA's eligibility.
+static int gdn_cache_match(
+        const ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, int node_index,
+        ggml_sycl_gated_delta_net_fused_cache * fused_cache) {
+    const ggml_tensor * gdn = cgraph->nodes[node_index];
+    if (gdn->op != GGML_OP_GATED_DELTA_NET || gdn->type != GGML_TYPE_F32 ||
+        (gdn->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+        return 0;
+    }
+
+    const ggml_tensor * src_v = gdn->src[2];
+    if (src_v == nullptr) {
+        return 0;
+    }
+    const int64_t S_v       = src_v->ne[0];
+    const int64_t H         = src_v->ne[1];
+    const int64_t n_tokens  = src_v->ne[2];
+    const int64_t n_seqs    = src_v->ne[3];
+    const int64_t D         = S_v * S_v * H;
+    const int64_t K         = ggml_get_op_params_i32(gdn, 0);
+    const int64_t n_written = std::min<int64_t>(n_tokens, K);
+    if (S_v <= 0 || H <= 0 || n_tokens <= 0 || n_seqs <= 0 || K <= 0 || n_written <= 0) {
+        return 0;
+    }
+
+    const size_t tail_offset = ggml_row_size(GGML_TYPE_F32, S_v * H * n_tokens * n_seqs);
+
+    const ggml_tensor * cpy = nullptr;
+    int skip = 0;
+    for (int i = node_index + 1; i < cgraph->n_nodes && cpy == nullptr; ++i) {
+        const ggml_tensor * candidate = cgraph->nodes[i];
+        if (gdn_cache_is_view_or_noop(candidate)) {
+            continue;
+        }
+        if (candidate->op != GGML_OP_CPY || (candidate->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return 0;
+        }
+        cpy = candidate;
+        skip = i - node_index;
+    }
+    if (cpy == nullptr) {
+        return 0;
+    }
+
+    const ggml_tensor * src = cpy->src[0];
+    const ggml_tensor * dst = cpy->src[1];
+    if (src == nullptr || dst == nullptr || src->op != GGML_OP_VIEW || src->view_src != gdn ||
+        src->view_offs != tail_offset || !ggml_is_contiguous(src)) {
+        return 0;
+    }
+
+    const std::array<int64_t, GGML_MAX_DIMS> expected_ne = { D, n_seqs, n_written, 1 };
+    if (dst->op != GGML_OP_VIEW || dst->type != GGML_TYPE_F32 || dst->data == nullptr ||
+        !std::equal(expected_ne.begin(), expected_ne.end(), dst->ne) ||
+        dst->nb[0] != ggml_type_size(GGML_TYPE_F32) ||
+        dst->nb[1] != (size_t) ggml_row_size(GGML_TYPE_F32, D)) {
+        return 0;
+    }
+
+    if (gdn->buffer == nullptr || src->buffer == nullptr || dst->buffer == nullptr ||
+        gdn->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        src->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        dst->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+        ggml_backend_buffer_is_sycl_split(gdn->buffer) ||
+        ggml_backend_buffer_is_sycl_split(src->buffer) ||
+        ggml_backend_buffer_is_sycl_split(dst->buffer)) {
+        return 0;
+    }
+
+    fused_cache->data = static_cast<float *>(dst->data);
+    fused_cache->slot_stride = K > 1 ? (int64_t) (dst->nb[2] / sizeof(float)) : 0;
+    return skip;
+}
+
+struct gdn_raw_gate_plan {
+    ggml_tensor * gdn;
+    ggml_sycl_gated_delta_net_raw_gates gates;
+    std::array<const ggml_tensor *, 4> skip;
+};
+
+static int gdn_node_index(const ggml_cgraph * cgraph, const ggml_tensor * tensor) {
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        if (cgraph->nodes[i] == tensor) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static const ggml_tensor * gdn_unwrap_metadata(const ggml_tensor * tensor) {
+    while (tensor != nullptr && mmvq_add_metadata_op(tensor->op) && tensor->src[0] != nullptr) {
+        tensor = tensor->src[0];
+    }
+    return tensor;
+}
+
+static bool gdn_raw_gate_match(
+        const ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph, ggml_tensor * gdn,
+        gdn_raw_gate_plan * plan) {
+    if (gdn->op != GGML_OP_GATED_DELTA_NET || gdn->src[3] == nullptr || gdn->src[4] == nullptr ||
+        gdn->src[3]->ne[0] != 1) {
+        return false;
+    }
+
+    const ggml_tensor * beta_sigmoid = gdn_unwrap_metadata(gdn->src[4]);
+    if (beta_sigmoid == nullptr || beta_sigmoid->op != GGML_OP_UNARY ||
+        ggml_get_unary_op(beta_sigmoid) != GGML_UNARY_OP_SIGMOID || beta_sigmoid->src[0] == nullptr) {
+        return false;
+    }
+    const ggml_tensor * raw_beta = beta_sigmoid->src[0];
+
+    const ggml_tensor * gate_mul = gdn_unwrap_metadata(gdn->src[3]);
+    if (gate_mul == nullptr || gate_mul->op != GGML_OP_MUL || gate_mul->src[0] == nullptr ||
+        gate_mul->src[1] == nullptr) {
+        return false;
+    }
+    const ggml_tensor * softplus = gate_mul->src[0];
+    const ggml_tensor * a = gate_mul->src[1];
+    if (softplus->op != GGML_OP_UNARY || ggml_get_unary_op(softplus) != GGML_UNARY_OP_SOFTPLUS) {
+        std::swap(softplus, a);
+    }
+    if (softplus->op != GGML_OP_UNARY || ggml_get_unary_op(softplus) != GGML_UNARY_OP_SOFTPLUS ||
+        softplus->src[0] == nullptr || a->op != GGML_OP_NONE) {
+        return false;
+    }
+    const ggml_tensor * biased = softplus->src[0];
+    if (biased->op != GGML_OP_ADD || biased->src[0] == nullptr || biased->src[1] == nullptr) {
+        return false;
+    }
+    const ggml_tensor * raw_alpha = biased->src[0];
+    const ggml_tensor * dt = biased->src[1];
+    if (dt->op != GGML_OP_NONE) {
+        std::swap(raw_alpha, dt);
+    }
+
+    const int beta_index = gdn_node_index(cgraph, beta_sigmoid);
+    const int add_index = gdn_node_index(cgraph, biased);
+    const int softplus_index = gdn_node_index(cgraph, softplus);
+    const int mul_index = gdn_node_index(cgraph, gate_mul);
+    if (beta_index < 0 || add_index < 0 || softplus_index < 0 || mul_index < 0 ||
+        ggml_node_get_use_count(cgraph, beta_index) != 1 || ggml_node_get_use_count(cgraph, add_index) != 1 ||
+        ggml_node_get_use_count(cgraph, softplus_index) != 1 || ggml_node_get_use_count(cgraph, mul_index) != 1) {
+        return false;
+    }
+
+    const int64_t H = gdn->src[2]->ne[1];
+    const int64_t gate_elements = gdn->src[3]->ne[1] * gdn->src[3]->ne[2] * gdn->src[3]->ne[3];
+    constexpr int observable_flags = GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT |
+                                     GGML_TENSOR_FLAG_PARAM | GGML_TENSOR_FLAG_LOSS;
+    const std::array<const ggml_tensor *, 8> tensors = {
+        beta_sigmoid, raw_beta, gate_mul, softplus, biased, raw_alpha, dt, a
+    };
+    for (const ggml_tensor * tensor : tensors) {
+        if (tensor->type != GGML_TYPE_F32 || tensor->data == nullptr || tensor->buffer == nullptr ||
+            tensor->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+            ggml_backend_buffer_is_sycl_split(tensor->buffer) || !ggml_is_contiguous(tensor)) {
+            return false;
+        }
+    }
+    if ((beta_sigmoid->flags & observable_flags) || (biased->flags & observable_flags) ||
+        (softplus->flags & observable_flags) || (gate_mul->flags & observable_flags) ||
+        ggml_nelements(raw_beta) != gate_elements || ggml_nelements(raw_alpha) != gate_elements ||
+        ggml_nelements(dt) != H || ggml_nelements(a) != H) {
+        return false;
+    }
+
+    plan->gdn = gdn;
+    plan->gates = {
+        static_cast<const float *>(raw_alpha->data), static_cast<const float *>(raw_beta->data),
+        static_cast<const float *>(dt->data), static_cast<const float *>(a->data),
+    };
+    plan->skip = { beta_sigmoid, biased, softplus, gate_mul };
+    return true;
+}
+
+struct ssm_conv_cache_plan {
+    ggml_tensor * conv = nullptr;
+    ggml_sycl_ssm_conv_cache cache = {};
+    std::array<const ggml_tensor *, GGML_SYCL_SSM_CONV_MAX_CACHE_WRITES> cpys = {};
+};
+
+struct ssm_conv_qk_norm_plan {
+    ggml_tensor * conv = nullptr;
+    ggml_tensor * silu = nullptr;
+    ggml_tensor * q_norm = nullptr;
+    ggml_tensor * k_norm = nullptr;
+    int head_dim = 0;
+    int q_heads = 0;
+    int k_heads = 0;
+    float q_eps = 0.0f;
+    float k_eps = 0.0f;
+};
+
+static bool ssm_conv_qk_norm_match(
+        const ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph,
+        ggml_tensor * conv, ssm_conv_qk_norm_plan * plan) {
+    if (conv->op != GGML_OP_SSM_CONV || conv->type != GGML_TYPE_F32 || conv->src[0] == nullptr ||
+        conv->src[1] == nullptr || conv->src[0]->type != GGML_TYPE_F32 ||
+        conv->src[1]->type != GGML_TYPE_F32 || !ggml_is_contiguous(conv)) {
+        return false;
+    }
+
+    ggml_tensor * silu = nullptr;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        ggml_tensor * node = cgraph->nodes[i];
+        if (node->op == GGML_OP_UNARY && ggml_get_unary_op(node) == GGML_UNARY_OP_SILU &&
+            node->src[0] == conv) {
+            if (silu != nullptr) {
+                return false;
+            }
+            silu = node;
+        }
+    }
+    if (silu == nullptr || silu->type != GGML_TYPE_F32 || !ggml_are_same_shape(conv, silu) ||
+        !ggml_is_contiguous(silu)) {
+        return false;
+    }
+
+    ggml_tensor * norms[2] = {};
+    const ggml_tensor * views[2] = {};
+    int count = 0;
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        ggml_tensor * node = cgraph->nodes[i];
+        if (node->op != GGML_OP_L2_NORM || node->src[0] == nullptr) {
+            continue;
+        }
+        const ggml_tensor * view = node->src[0];
+        if (view->op != GGML_OP_VIEW || view->view_src != silu) {
+            continue;
+        }
+        if (count == 2) {
+            return false;
+        }
+        norms[count] = node;
+        views[count] = view;
+        ++count;
+    }
+    if (count != 2) {
+        return false;
+    }
+    if (views[1]->view_offs < views[0]->view_offs) {
+        std::swap(views[0], views[1]);
+        std::swap(norms[0], norms[1]);
+    }
+
+    const int64_t head_dim = views[0]->ne[0];
+    const int64_t q_heads = views[0]->ne[1];
+    const int64_t k_heads = views[1]->ne[1];
+    const int64_t d_inner = conv->ne[0];
+    const size_t expected_k_offset = static_cast<size_t>(head_dim * q_heads) * sizeof(float);
+    if (head_dim <= 0 || head_dim > 256 || head_dim % WARP_SIZE != 0 || q_heads <= 0 ||
+        k_heads <= 0 || views[0]->view_offs != 0 || views[1]->view_offs != expected_k_offset ||
+        views[0]->ne[2] != conv->ne[1] || views[1]->ne[2] != conv->ne[1] ||
+        views[0]->ne[3] != conv->ne[2] || views[1]->ne[3] != conv->ne[2] ||
+        (q_heads + k_heads) * head_dim >= d_inner) {
+        return false;
+    }
+    const ggml_tensor * tensors[] = { conv, silu, norms[0], norms[1] };
+    constexpr int observable = GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT |
+                               GGML_TENSOR_FLAG_PARAM | GGML_TENSOR_FLAG_LOSS;
+    for (const ggml_tensor * tensor : tensors) {
+        if (tensor->type != GGML_TYPE_F32 || tensor->data == nullptr || tensor->buffer == nullptr ||
+            tensor->buffer->buft != ggml_backend_sycl_buffer_type(ctx.device) ||
+            ggml_backend_buffer_is_sycl_split(tensor->buffer) || (tensor->flags & observable)) {
+            return false;
+        }
+    }
+    for (int n = 0; n < 2; ++n) {
+        if (views[n]->type != GGML_TYPE_F32 || views[n]->nb[0] != sizeof(float) ||
+            views[n]->nb[1] != static_cast<size_t>(head_dim) * sizeof(float) ||
+            views[n]->nb[2] != static_cast<size_t>(d_inner) * sizeof(float) ||
+            views[n]->nb[3] != static_cast<size_t>(d_inner * conv->ne[1]) * sizeof(float) ||
+            !ggml_are_same_shape(views[n], norms[n])) {
+            return false;
+        }
+    }
+
+    plan->conv = conv;
+    plan->silu = silu;
+    plan->q_norm = norms[0];
+    plan->k_norm = norms[1];
+    plan->head_dim = head_dim;
+    plan->q_heads = q_heads;
+    plan->k_heads = k_heads;
+    memcpy(&plan->q_eps, norms[0]->op_params, sizeof(float));
+    memcpy(&plan->k_eps, norms[1]->op_params, sizeof(float));
+    return plan->q_eps >= 0.0f && plan->k_eps >= 0.0f;
+}
+
+// Match the Qwen delta-net recurrent convolution snapshots. build_conv_state()
+// creates one CPY per rollback slot from a view of the exact CONCAT consumed by
+// SSM_CONV. The writes may precede the convolution in graph order, so plans are
+// constructed before dispatch and the CPYs are suppressed individually.
+static bool ssm_conv_cache_match(
+        const ggml_backend_sycl_context & ctx, const ggml_cgraph * cgraph,
+        ggml_tensor * conv, ssm_conv_cache_plan * plan) {
+    if (conv->op != GGML_OP_SSM_CONV || conv->type != GGML_TYPE_F32 || conv->src[0] == nullptr ||
+        conv->src[1] == nullptr || conv->src[0]->op != GGML_OP_CONCAT ||
