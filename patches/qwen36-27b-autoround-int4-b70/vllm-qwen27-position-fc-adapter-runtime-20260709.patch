+def _enable_qwen35_mtp_compile(vllm_config: VllmConfig) -> bool:
+    """Position-selected weights need a graph-safe runtime selector first.
+
+    vLLM's model compile wrapper intentionally drops Python guards. Compiling
+    the current ``ModuleList[spec_step_idx]`` implementation would therefore
+    specialize the first graph to step 0 and silently reuse it at later draft
+    depths. Keep the normal checkpoint compiled, but run experimental
+    position-specific candidates eagerly until their selector is tensorized.
+    """
+    config = vllm_config.model_config.hf_text_config
+    return not (
+        int(getattr(config, "xpu_mtp_num_position_fcs", 0) or 0)
+        or int(getattr(config, "xpu_mtp_position_adapter_count", 0) or 0)
+    )
+
+
+class Qwen3_5MTPPositionAdapter(nn.Module):
+    def __init__(
+        self,
+        hidden_size: int,
+        rank: int,
+        *,
+        prefix: str,
+    ) -> None:
+        super().__init__()
+        self.down = ColumnParallelLinear(
+            hidden_size,
+            rank,
+            gather_output=True,
+            bias=False,
+            return_bias=False,
+            quant_config=None,
+            prefix=f"{prefix}.down",
+        )
+        self.up = ColumnParallelLinear(
+            rank,
+            hidden_size,
+            gather_output=True,
+            bias=False,
+            return_bias=False,
+            quant_config=None,
+            prefix=f"{prefix}.up",
+        )
+
+
