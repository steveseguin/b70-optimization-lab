+            "VLLM_XPU_GDN_ROW_TRACE_STATE_LIMIT", 4))
+        if slots is not None:
+            slots = slots[:slot_limit]
+
+        record = {
+            "ts": time.time(),
+            "pid": os.getpid(),
+            "tp_rank": tp_rank,
+            "stage": stage,
+            "layer": layer_name,
+            "layer_idx": layer_idx,
+            "num_accepted_tokens": _gdn_row_trace_int_list(num_accepted_tokens),
+            "state_indices": _gdn_row_trace_int_list(state_indices),
+            "slots_sample": _gdn_row_trace_int_list(slots),
+            "write_pos": _gdn_row_trace_int_list(
+                None if write_pos is None or slots is None
+                else write_pos.index_select(0, slots.to(write_pos.device))),
+            "cache_base": _gdn_row_trace_int_list(
+                None if cache_base is None or slots is None
+                else cache_base.index_select(0, slots.to(cache_base.device))),
+            "is_flush": _gdn_row_trace_int_list(
+                None if is_flush is None or slots is None
+                else is_flush.index_select(0, slots.to(is_flush.device))),
+            "pending": _gdn_row_trace_int_list(
+                None if pending is None or slots is None
+                else pending.index_select(0, slots.to(pending.device))),
+            "pending_len": _gdn_row_trace_int_list(
+                None if pending_len is None or slots is None
+                else pending_len.index_select(0, slots.to(pending_len.device))),
+        }
+        if _gdn_row_trace_bool_env(
+            "VLLM_XPU_GDN_ROW_TRACE_REPLAYSSM_STATE", False
+        ):
+            record["replayssm_state"] = {
+                "conv_state": _gdn_row_trace_selected_states(
+                    conv_state, slots),
+                "d_cache": _gdn_row_trace_selected_states(d_cache, slots),
+                "k_cache": _gdn_row_trace_selected_states(k_cache, slots),
+                "g_cache": _gdn_row_trace_selected_states(g_cache, slots),
+                "conv_pending": _gdn_row_trace_selected_states(
+                    conv_pending, slots),
+            }
+        trace_file = os.environ["VLLM_XPU_GDN_ROW_TRACE_FILE"]
+        trace_dir = os.path.dirname(trace_file)
+        if trace_dir:
+            os.makedirs(trace_dir, exist_ok=True)
+        with open(trace_file, "a", encoding="utf-8") as f:
+            f.write(json.dumps(record, separators=(",", ":")) + "\n")
+        _XPU_GDN_ROW_TRACE_LINES += 1
+    except Exception:
