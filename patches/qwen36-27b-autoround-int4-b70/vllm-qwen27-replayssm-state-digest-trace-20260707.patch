+def _gdn_row_trace_int_list(tensor: torch.Tensor | None,
+                            limit: int = 16) -> object:
+    if tensor is None:
+        return None
+    try:
+        return [int(x) for x in tensor.detach().to(torch.int64).cpu().flatten()
+                [:limit].tolist()]
+    except Exception as exc:
+        return {"error": repr(exc)}
+
+
+def _gdn_replayssm_commit_trace(
