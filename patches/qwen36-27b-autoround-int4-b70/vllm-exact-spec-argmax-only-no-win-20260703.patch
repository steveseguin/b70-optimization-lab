+def greedy_sample_from_argmax(
+    # [num_tokens]
+    draft_token_ids: torch.Tensor,
+    # [batch_size]
+    num_draft_tokens: list[int],
+    max_spec_len: int,
+    # [batch_size]
+    cu_num_draft_tokens: torch.Tensor,
+    # [num_tokens]
+    target_argmax: torch.Tensor,
+    # [batch_size] or [batch_size, 1]
+    bonus_token_ids: torch.Tensor,
+) -> torch.Tensor:
+    """Exact greedy speculative sampling from precomputed target argmax ids.
+
+    This is semantically equivalent to the greedy branch of
+    ``rejection_sample``: accepted draft prefix, target replacement on first
+    mismatch, and target-owned bonus token on full accept. It deliberately
+    supports only the all-greedy, no-synthetic path where argmax IDs are enough
+    to reproduce the normal full-logits sampler.
+    """
+    assert draft_token_ids.ndim == 1
+    assert cu_num_draft_tokens.ndim == 1
+    assert target_argmax.ndim == 1
+    assert bonus_token_ids.ndim in (1, 2)
+
+    batch_size = len(num_draft_tokens)
+    num_tokens = draft_token_ids.shape[0]
+    device = target_argmax.device
+    assert target_argmax.shape[0] == num_tokens
+
+    bonus_token_ids = bonus_token_ids.reshape(-1).to(torch.int32).contiguous()
+    assert bonus_token_ids.shape[0] == batch_size
+
+    output_token_ids = torch.full(
+        (batch_size, max_spec_len + 1),
+        PLACEHOLDER_TOKEN_ID,
+        dtype=torch.int32,
+        device=device,
+    )
+    if num_tokens == 0:
+        return output_token_ids
+
+    rejection_greedy_sample_kernel[(batch_size,)](
+        output_token_ids,
+        cu_num_draft_tokens,
+        draft_token_ids,
+        target_argmax.to(torch.int32).contiguous(),
+        bonus_token_ids,
+        None,
+        max_spec_len,
+        None,
+        None,
+        SYNTHETIC_MODE=False,
+    )
+    return output_token_ids
+
