+    def _trace_xpu_mtp_next_dispatch(
+        self,
+        *,
+        token_index: int,
+        batch_size: int,
+        input_batch_size: int,
+        batch_size_across_dp: torch.Tensor | int | None,
+        cudagraph_runtime_mode: CUDAGraphMode,
+        common_attn_metadata: CommonAttentionMetadata,
+        per_layer_attn_metadata: dict[str, Any],
+        slot_mapping: dict[str, torch.Tensor],
+        input_ids: torch.Tensor | None,
+        inputs_embeds: torch.Tensor | None,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+    ) -> None:
+        """Default-off JSONL trace for recurrent MTP-next graph dispatch.
+
+        This is diagnostic-only. It records compact tensor metadata and graph
+        dispatch shape before set_forward_context(), without changing model
+        inputs or target verification semantics.
+        """
+        if not self.xpu_mtp_next_dispatch_trace_file:
+            return
+        if (
+            self.xpu_mtp_next_dispatch_trace_max_lines > 0
+            and self.xpu_mtp_next_dispatch_trace_lines
+            >= self.xpu_mtp_next_dispatch_trace_max_lines
+        ):
+            return
+
+        def tensor_meta(tensor: torch.Tensor | None) -> dict[str, object] | None:
+            if tensor is None:
+                return None
+            return {
+                "shape": list(tensor.shape),
+                "dtype": str(tensor.dtype),
+                "device": str(tensor.device),
+                "is_contiguous": bool(tensor.is_contiguous()),
+            }
+
+        def maybe_scalar(value: object) -> int | None:
+            if value is None:
+                return None
+            if isinstance(value, int):
+                return int(value)
+            if isinstance(value, torch.Tensor) and value.numel() == 1:
+                try:
+                    return int(value.item())
+                except Exception:
+                    return None
+            return None
+
+        layer_type_counts: dict[str, int] = {}
+        for metadata in per_layer_attn_metadata.values():
+            name = type(metadata).__name__
+            layer_type_counts[name] = layer_type_counts.get(name, 0) + 1
+
+        payload = {
+            "event": "mtp_next_dispatch",
+            "line": int(self.xpu_mtp_next_dispatch_trace_lines),
+            "token_index": int(token_index),
+            "batch_size": int(batch_size),
+            "input_batch_size": int(input_batch_size),
+            "batch_size_across_dp": maybe_scalar(batch_size_across_dp),
+            "cudagraph_runtime_mode": str(cudagraph_runtime_mode),
+            "num_speculative_tokens": int(self.num_speculative_tokens),
+            "method": str(self.method),
+            "parallel_drafting": bool(self.parallel_drafting),
+            "pass_hidden_states_to_model": bool(self.pass_hidden_states_to_model),
+            "uses_mrope": bool(self.uses_mrope),
+            "uses_xdrope_dim": int(self.uses_xdrope_dim),
+            "draft_uses_xdrope_dim": int(self.draft_uses_xdrope_dim),
+            "metadata": {
+                "num_actual_tokens": int(common_attn_metadata.num_actual_tokens),
+                "max_query_len": int(common_attn_metadata.max_query_len),
+                "max_seq_len": int(common_attn_metadata.max_seq_len),
+                "query_start_loc": tensor_meta(
+                    common_attn_metadata.query_start_loc),
+                "seq_lens": tensor_meta(common_attn_metadata.seq_lens),
+                "block_table_tensor": tensor_meta(
+                    common_attn_metadata.block_table_tensor),
+                "slot_mapping": tensor_meta(common_attn_metadata.slot_mapping),
+            },
+            "per_layer_metadata_type_counts": layer_type_counts,
+            "slot_mapping": {
+                name: tensor_meta(tensor)
+                for name, tensor in slot_mapping.items()
+            },
+            "inputs": {
+                "input_ids": tensor_meta(input_ids),
+                "inputs_embeds": tensor_meta(inputs_embeds),
+                "positions": tensor_meta(positions),
+                "hidden_states": tensor_meta(hidden_states),
+            },
+        }
+        try:
+            with open(self.xpu_mtp_next_dispatch_trace_file, "a",
+                      encoding="utf-8") as handle:
+                handle.write(json.dumps(payload, sort_keys=True) + "\n")
+            self.xpu_mtp_next_dispatch_trace_lines += 1
+        except Exception:
+            logger.exception("Failed to write XPU MTP next dispatch trace")
+
