+def _xpu_spec_bonus_argmax_fastpath_enabled() -> bool:
+    return (
+        os.environ.get("VLLM_XPU_SPEC_DECODE_BONUS_ARGMAX_FASTPATH", "")
+        .strip()
+        .lower()
+        in ("1", "true", "yes", "on")
+    )
+
+
+def _xpu_non_argmax_processors_inactive(
+    sampling_metadata: SamplingMetadata,
+) -> bool:
+    for processor in sampling_metadata.logitsprocs.non_argmax_invariant:
+        if hasattr(processor, "min_toks"):
+            if getattr(processor, "min_toks"):
+                return False
+            continue
+        if hasattr(processor, "biases"):
+            if getattr(processor, "biases"):
+                return False
+            continue
+        return False
+    return True
+
+
+def _xpu_can_use_bonus_argmax_fastpath(
+    sampling_metadata: SamplingMetadata,
+    bonus_logits: torch.Tensor,
+) -> bool:
+    if not _xpu_spec_bonus_argmax_fastpath_enabled():
+        return False
+    if bonus_logits.ndim != 2 or bonus_logits.shape[0] == 0:
+        return False
+    if not sampling_metadata.all_greedy or sampling_metadata.all_random:
+        return False
+    if sampling_metadata.max_num_logprobs is not None:
+        return False
+    if sampling_metadata.logprob_token_ids:
+        return False
+    if not sampling_metadata.no_penalties:
+        return False
+    if sampling_metadata.allowed_token_ids_mask is not None:
+        return False
+    if sampling_metadata.bad_words_token_ids:
+        return False
+    holder = sampling_metadata.thinking_budget_state_holder
+    if holder is not None and holder.has_tracked_requests():
+        return False
+    return _xpu_non_argmax_processors_inactive(sampling_metadata)
+
+
+def _xpu_rejection_sync_debug_stage(stage: str) -> None:
+    stages = {
+        item.strip()
+        for item in os.environ.get(
+            "VLLM_XPU_REJECTION_SYNC_DEBUG_STAGES", "").split(",")
+        if item.strip()
+    }
+    if "*" not in stages and stage not in stages:
+        return
+    try:
+        torch.xpu.synchronize()
+    except Exception as exc:
+        raise RuntimeError(
+            f"XPU rejection sampler sync failed at {stage}") from exc
+
+
+def _select_spec_logits_rows(
+    logits: torch.Tensor,
+    indices: torch.Tensor,
+    num_draft_tokens: list[int],
+    *,
+    target_rows: bool,
+    draft_only: bool,
+) -> torch.Tensor:
+    if (
+        os.environ.get("VLLM_XPU_SAFE_SPEC_LOGITS_SELECT", "0") != "1"
+        or logits.device.type != "xpu"
+    ):
+        return logits[indices]
+
+    total_target_rows = sum(num_draft_tokens)
+    if target_rows:
+        if total_target_rows == 0:
+            return logits.new_empty((0, *logits.shape[1:]))
+        if draft_only and logits.shape[0] == total_target_rows:
+            return logits
+        selected = torch.empty(
+            (total_target_rows, *logits.shape[1:]),
+            dtype=logits.dtype,
+            device=logits.device,
+        )
+        src = 0
+        dst = 0
+        for num_draft in num_draft_tokens:
+            if num_draft > 0:
+                selected[dst:dst + num_draft].copy_(
+                    logits[src:src + num_draft])
+                dst += num_draft
+            src += num_draft if draft_only else num_draft + 1
+        return selected
+
+    selected = torch.empty(
+        (len(num_draft_tokens), *logits.shape[1:]),
+        dtype=logits.dtype,
+        device=logits.device,
+    )
+    src = 0
+    for req_idx, num_draft in enumerate(num_draft_tokens):
+        selected[req_idx].copy_(logits[src + num_draft])
+        src += num_draft + 1
+    return selected
+
