+    def _trace_xpu_draft_inputs(
+        self,
+        *,
+        num_tokens: int,
+        num_input_tokens: int,
+        token_indices_to_sample: torch.Tensor,
+        last_hidden_states: torch.Tensor,
+        sample_hidden_states: torch.Tensor,
+    ) -> None:
+        """Write a compact, default-off trace of proposer sampling inputs."""
+        if not self.xpu_draft_input_trace_file:
+            return
+        if (
+            self.xpu_draft_input_trace_max_lines > 0
+            and self.xpu_draft_input_trace_lines
+            >= self.xpu_draft_input_trace_max_lines
+        ):
+            return
+
+        def tensor_summary(tensor: torch.Tensor) -> dict[str, object]:
+            # Do one compact copy, then reduce on CPU. Multiple XPU scalar
+            # reductions here can serialize or stall the proposal stream and
+            # would make this diagnostic change the behavior being inspected.
+            value = tensor.detach().float().cpu()
+            finite = torch.isfinite(value)
+            finite_values = value[finite]
+            summary: dict[str, object] = {
+                "shape": list(value.shape),
+                "dtype": str(value.dtype),
+                "finite": int(finite.sum().item()),
+                "numel": int(value.numel()),
+                "zeros": int((value == 0).sum().item()),
+            }
+            if finite_values.numel():
+                finite_float = finite_values.float()
+                summary.update({
+                    "min": float(finite_float.min().item()),
+                    "max": float(finite_float.max().item()),
+                    "mean": float(finite_float.mean().item()),
+                    "norm": float(finite_float.norm().item()),
+                })
+            return summary
+
+        try:
+            payload = {
+                "ts": time.time(),
+                "method": self.method,
+                "num_tokens": int(num_tokens),
+                "num_input_tokens": int(num_input_tokens),
+                "token_indices_to_sample": (
+                    token_indices_to_sample.detach().cpu().tolist()
+                ),
+                "input_ids": self.input_ids[:num_tokens].detach().cpu().tolist(),
+                "positions": self._get_positions(num_tokens).detach().cpu().tolist(),
+                "last_hidden_states": tensor_summary(last_hidden_states),
+                "sample_hidden_states": tensor_summary(sample_hidden_states),
+            }
+            with open(self.xpu_draft_input_trace_file, "a", encoding="utf-8") as f:
+                f.write(json.dumps(payload, sort_keys=True) + "\n")
+            self.xpu_draft_input_trace_lines += 1
+        except Exception:
+            logger.exception("Failed to write XPU draft input trace")
+
