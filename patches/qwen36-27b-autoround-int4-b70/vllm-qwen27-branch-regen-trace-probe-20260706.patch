+    def _xpu_trace_branch_regen_candidates(
+        self,
+        *,
+        scheduler_output: "SchedulerOutput",
+        sampled_token_ids: torch.Tensor,
+        valid_sampled_tokens_count: torch.Tensor,
+        next_token_ids: torch.Tensor,
+    ) -> None:
+        if (
+            os.environ.get("VLLM_XPU_BRANCH_REGEN_TRACE", "")
+            .strip()
+            .lower()
+            not in ("1", "true", "yes", "on")
+            or not self._xpu_cow_worker_trace_enabled()
+        ):
+            return
+
+        try:
+            raw_counts = valid_sampled_tokens_count.detach().to("cpu")
+            next_ids = next_token_ids.detach().to("cpu")
+            sampled_rows = sampled_token_ids.detach().to("cpu")
+            scheduled_spec_tokens = (
+                scheduler_output.scheduled_spec_decode_tokens)
+            draft_only = (
+                os.environ.get("VLLM_XPU_SPEC_DECODE_DRAFT_ONLY", "")
+                .strip()
+                .lower()
+                in ("1", "true", "yes", "on")
+            )
+            rows: list[dict[str, Any]] = []
+            num_reqs = min(int(raw_counts.shape[0]),
+                           len(self.input_batch.req_ids))
+            for row in range(num_reqs):
+                req_id = self.input_batch.req_ids[row]
+                scheduled = (
+                    scheduled_spec_tokens.get(req_id, ())
+                    if req_id is not None else ()
+                )
+                scheduled_len = len(scheduled)
+                raw_visible_count = int(raw_counts[row].item())
+                if draft_only:
+                    draft_prefix_count = min(
+                        max(raw_visible_count, 0), scheduled_len)
+                else:
+                    # Normal verifier rows emit accepted draft tokens plus one
+                    # target-owned replacement/bonus token.  A legal branch
+                    # candidate can only start from the accepted draft prefix,
+                    # never from the replacement/bonus tail.
+                    draft_prefix_count = min(
+                        max(raw_visible_count - 1, 0), scheduled_len)
+                partial_reject = (
+                    scheduled_len > 0
+                    and draft_prefix_count < scheduled_len
+                )
+                full_accept = (
+                    scheduled_len > 0
+                    and draft_prefix_count == scheduled_len
+                    and raw_visible_count > 0
+                )
+                rows.append({
+                    "row": int(row),
+                    "req_id": None if req_id is None else str(req_id),
+                    "raw_visible_count": raw_visible_count,
+                    "draft_prefix_count": int(draft_prefix_count),
+                    "scheduled_spec_len": int(scheduled_len),
+                    "first_reject_index": (
+                        int(draft_prefix_count)
+                        if partial_reject else None
+                    ),
+                    "partial_reject": bool(partial_reject),
+                    "full_accept": bool(full_accept),
+                    "draft_only": bool(draft_only),
+                    "next_token_id": int(next_ids[row].item()),
+                    "scheduled_spec_ids_head": [
+                        int(tok) for tok in list(scheduled)[:8]
+                    ],
+                    "sampled_token_ids_head": [
+                        int(tok)
+                        for tok in sampled_rows[row].reshape(-1)[:8].tolist()
+                    ],
+                    "num_tokens_no_spec": int(
+                        self.input_batch.num_tokens_no_spec[row]),
+                    "num_computed_tokens_cpu": int(
+                        self.input_batch.num_computed_tokens_cpu[row]),
+                    "num_accepted_tokens_cpu": int(
+                        self.input_batch.num_accepted_tokens_cpu[row]),
+                })
+
+            self._trace_xpu_cow_worker_event(
+                stage="branch_regen_candidates",
+                scheduler_output=scheduler_output,
+                extra={
+                    "num_reqs": int(num_reqs),
+                    "rows": rows,
+                    "trace_only": True,
+                    "note": (
+                        "normal rows use max(raw_visible_count - 1, 0) "
+                        "clamped to scheduled_spec_len as accepted draft "
+                        "prefix; target-owned replacement/bonus is excluded"
+                    ),
+                },
+            )
+        except Exception:
+            logger.exception("Failed to trace XPU branch/regenerate candidates")
@@
