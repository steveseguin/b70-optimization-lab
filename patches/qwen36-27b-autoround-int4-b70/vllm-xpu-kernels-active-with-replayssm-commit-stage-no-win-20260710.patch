+        mixed_stride_0(mixed_stride_0),
+        mixed_stride_1(mixed_stride_1),
+        a_src(a_src),
+        a_stride_0(a_stride_0),
+        a_stride_1(a_stride_1),
+        b_src(b_src),
+        b_stride_0(b_stride_0),
