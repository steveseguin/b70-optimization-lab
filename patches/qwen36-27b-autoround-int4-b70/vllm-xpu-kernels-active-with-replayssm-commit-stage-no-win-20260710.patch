+template <typename T>
+void gdn_replayssm_stage_conv(
+    sycl::queue& queue,
+    torch::Tensor& q,
+    torch::Tensor& k,
+    torch::Tensor& v,
+    torch::Tensor& a_out,
+    torch::Tensor& b_out,
+    const torch::Tensor& mixed_qkv,
+    const torch::Tensor& a,
+    const torch::Tensor& b,
