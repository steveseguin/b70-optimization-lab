+      T* conv_pending,
+      const int64_t pending_stride_0,
+      const int64_t pending_stride_1,
+      const int64_t pending_stride_2,
+      const int* spec_token_indices,
+      const int* query_start_loc,
+      const int64_t* state_indices,
+      const int8_t* pending,
+      const int* pending_len,
+      const int* num_accepted_tokens,
+      const ActMode& act_mode,
