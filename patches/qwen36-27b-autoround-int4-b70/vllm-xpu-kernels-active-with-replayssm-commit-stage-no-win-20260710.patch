+  gdn_replayssm_stage_conv_launcher<T, width_value>(                      \
+      queue, q, k, v, a_out, b_out, mixed_qkv, a, b, conv_state,          \
+      conv_weights, conv_bias, conv_pending, spec_token_indices,          \
+      query_start_loc, state_indices, act_mode, rows, num_actual_tokens,  \
+      max_spec_len, null_block_id)
