+  switch (conv_weights.size(1)) {
+    case 1:
+      REPLAY_STAGE_WIDTH_CASE(1);
+      break;
+    case 2:
+      REPLAY_STAGE_WIDTH_CASE(2);
+      break;
+    case 3:
+      REPLAY_STAGE_WIDTH_CASE(3);
+      break;
+    case 4:
