+template <typename T>
+struct gdn_replayssm_copy_slots_kernel {
+  static constexpr int group_size = 256;
+
+  gdn_replayssm_copy_slots_kernel(
+      T* d_cache,
+      T* k_cache,
+      float* g_cache,
+      int* write_pos,
+      int* cache_base,
+      int8_t* is_flush,
+      int8_t* pending,
+      int* pending_len,
+      T* conv_pending,
+      const int64_t* src_indices,
+      const int64_t* dst_indices,
+      const int rows,
+      const int num_slots,
+      const int d_elems,
+      const int k_elems,
+      const int g_elems,
+      const int conv_elems,
+      const int total_elems,
+      const int null_block_id)
+      : d_cache(d_cache),
+        k_cache(k_cache),
+        g_cache(g_cache),
+        write_pos(write_pos),
+        cache_base(cache_base),
+        is_flush(is_flush),
+        pending(pending),
+        pending_len(pending_len),
+        conv_pending(conv_pending),
+        src_indices(src_indices),
+        dst_indices(dst_indices),
+        rows(rows),
+        num_slots(num_slots),
+        d_elems(d_elems),
+        k_elems(k_elems),
+        g_elems(g_elems),
+        conv_elems(conv_elems),
+        total_elems(total_elems),
+        null_block_id(null_block_id) {}
+
+  static inline sycl::nd_range<1> get_nd_range(
+      const int rows,
+      const int total_elems) {
+    const int row_elems = total_elems > 0 ? total_elems : 1;
+    const int total = rows * row_elems;
+    sycl::range<1> local(group_size);
+    sycl::range<1> global((total + group_size - 1) / group_size);
+    return sycl::nd_range<1>(global * local, local);
+  }
+
+  inline bool valid_slot(const int64_t slot) const {
+    return slot > static_cast<int64_t>(null_block_id) &&
+           slot < static_cast<int64_t>(num_slots);
+  }
+
+  void operator()(sycl::nd_item<1> item) const {
+    const int linear = item.get_global_linear_id();
+    const int row_elems = total_elems > 0 ? total_elems : 1;
+    const int total = rows * row_elems;
+    if (linear >= total) {
+      return;
+    }
+
+    const int row = linear / row_elems;
+    const int offset = linear - row * row_elems;
+    const int64_t src64 = src_indices[row];
+    const int64_t dst64 = dst_indices[row];
+    if (!valid_slot(src64) || !valid_slot(dst64)) {
+      return;
+    }
+    const int src = static_cast<int>(src64);
+    const int dst = static_cast<int>(dst64);
+
+    if (offset == 0) {
+      write_pos[dst] = write_pos[src];
+      cache_base[dst] = cache_base[src];
+      is_flush[dst] = is_flush[src];
+      pending[dst] = pending[src];
+      pending_len[dst] = pending_len[src];
+    }
+
+    int local = offset;
+    if (local < d_elems) {
+      d_cache[static_cast<int64_t>(dst) * d_elems + local] =
+          d_cache[static_cast<int64_t>(src) * d_elems + local];
+      return;
+    }
+    local -= d_elems;
+    if (local < k_elems) {
+      k_cache[static_cast<int64_t>(dst) * k_elems + local] =
+          k_cache[static_cast<int64_t>(src) * k_elems + local];
+      return;
+    }
+    local -= k_elems;
+    if (local < g_elems) {
+      g_cache[static_cast<int64_t>(dst) * g_elems + local] =
+          g_cache[static_cast<int64_t>(src) * g_elems + local];
+      return;
+    }
+    local -= g_elems;
+    if (local < conv_elems) {
+      conv_pending[static_cast<int64_t>(dst) * conv_elems + local] =
+          conv_pending[static_cast<int64_t>(src) * conv_elems + local];
+    }
+  }
+
+ private:
+  T* d_cache;
+  T* k_cache;
+  float* g_cache;
+  int* write_pos;
+  int* cache_base;
+  int8_t* is_flush;
+  int8_t* pending;
+  int* pending_len;
+  T* conv_pending;
+  const int64_t* src_indices;
+  const int64_t* dst_indices;
+  const int rows;
+  const int num_slots;
+  const int d_elems;
+  const int k_elems;
+  const int g_elems;
+  const int conv_elems;
+  const int total_elems;
+  const int null_block_id;
+};
+
+struct gdn_replayssm_reset_slots_kernel {
+  static constexpr int group_size = 256;
+
+  gdn_replayssm_reset_slots_kernel(
+      int* write_pos,
+      int* cache_base,
+      int8_t* is_flush,
+      int8_t* pending,
+      int* pending_len,
+      const int64_t* state_indices,
+      const int rows,
+      const int num_slots,
+      const int init_flush,
+      const int null_block_id)
+      : write_pos(write_pos),
+        cache_base(cache_base),
+        is_flush(is_flush),
+        pending(pending),
+        pending_len(pending_len),
+        state_indices(state_indices),
+        rows(rows),
+        num_slots(num_slots),
+        init_flush(init_flush),
+        null_block_id(null_block_id) {}
+
+  static inline sycl::nd_range<1> get_nd_range(const int rows) {
+    sycl::range<1> local(group_size);
+    sycl::range<1> global((rows + group_size - 1) / group_size);
+    return sycl::nd_range<1>(global * local, local);
+  }
+
+  void operator()(sycl::nd_item<1> item) const {
+    const int row = item.get_global_linear_id();
+    if (row >= rows) {
+      return;
+    }
+    const int64_t slot64 = state_indices[row];
+    if (slot64 <= static_cast<int64_t>(null_block_id) ||
+        slot64 >= static_cast<int64_t>(num_slots)) {
+      return;
+    }
+    const int slot = static_cast<int>(slot64);
+    write_pos[slot] = 0;
+    cache_base[slot] = 0;
+    is_flush[slot] = static_cast<int8_t>(init_flush);
+    pending[slot] = static_cast<int8_t>(0);
+    pending_len[slot] = 0;
+  }
+
+ private:
+  int* write_pos;
+  int* cache_base;
+  int8_t* is_flush;
+  int8_t* pending;
+  int* pending_len;
+  const int64_t* state_indices;
+  const int rows;
+  const int num_slots;
+  const int init_flush;
+  const int null_block_id;
+};
+
+template <typename T>
+void gdn_replayssm_copy_slots(
+    sycl::queue& queue,
+    torch::Tensor& d_cache,
+    torch::Tensor& k_cache,
+    torch::Tensor& g_cache,
+    torch::Tensor& write_pos,
+    torch::Tensor& cache_base,
+    torch::Tensor& is_flush,
+    torch::Tensor& pending,
+    torch::Tensor& pending_len,
+    torch::Tensor& conv_pending,
+    const torch::Tensor& src_indices,
+    const torch::Tensor& dst_indices,
+    const int null_block_id) {
+  using KERNEL = gdn_replayssm_copy_slots_kernel<T>;
+  const int rows = std::min(src_indices.numel(), dst_indices.numel());
+  if (rows <= 0) {
+    return;
+  }
+  const int d_elems =
+      static_cast<int>(d_cache.numel() / std::max<int64_t>(1, d_cache.size(0)));
+  const int k_elems =
+      static_cast<int>(k_cache.numel() / std::max<int64_t>(1, k_cache.size(0)));
+  const int g_elems =
+      static_cast<int>(g_cache.numel() / std::max<int64_t>(1, g_cache.size(0)));
+  const int conv_elems = static_cast<int>(
+      conv_pending.numel() / std::max<int64_t>(1, conv_pending.size(0)));
+  const int total_elems = d_elems + k_elems + g_elems + conv_elems;
+  auto range = KERNEL::get_nd_range(rows, total_elems);
+  queue.submit([&](sycl::handler& cgh) {
+    KERNEL task(
+        reinterpret_cast<T*>(d_cache.data_ptr()),
+        reinterpret_cast<T*>(k_cache.data_ptr()),
+        reinterpret_cast<float*>(g_cache.data_ptr()),
+        reinterpret_cast<int*>(write_pos.data_ptr()),
+        reinterpret_cast<int*>(cache_base.data_ptr()),
+        reinterpret_cast<int8_t*>(is_flush.data_ptr()),
+        reinterpret_cast<int8_t*>(pending.data_ptr()),
+        reinterpret_cast<int*>(pending_len.data_ptr()),
+        reinterpret_cast<T*>(conv_pending.data_ptr()),
+        reinterpret_cast<const int64_t*>(src_indices.data_ptr()),
+        reinterpret_cast<const int64_t*>(dst_indices.data_ptr()),
+        rows,
+        d_cache.size(0),
+        d_elems,
+        k_elems,
+        g_elems,
+        conv_elems,
+        total_elems,
+        null_block_id);
+    cgh.parallel_for(range, task);
+  });
+}
+
+inline void gdn_replayssm_reset_slots(
+    sycl::queue& queue,
+    torch::Tensor& write_pos,
+    torch::Tensor& cache_base,
+    torch::Tensor& is_flush,
+    torch::Tensor& pending,
+    torch::Tensor& pending_len,
+    const torch::Tensor& state_indices,
+    const int init_flush,
+    const int null_block_id) {
+  using KERNEL = gdn_replayssm_reset_slots_kernel;
+  const int rows = state_indices.numel();
+  if (rows <= 0) {
+    return;
+  }
+  auto range = KERNEL::get_nd_range(rows);
+  queue.submit([&](sycl::handler& cgh) {
+    KERNEL task(
+        reinterpret_cast<int*>(write_pos.data_ptr()),
+        reinterpret_cast<int*>(cache_base.data_ptr()),
+        reinterpret_cast<int8_t*>(is_flush.data_ptr()),
+        reinterpret_cast<int8_t*>(pending.data_ptr()),
+        reinterpret_cast<int*>(pending_len.data_ptr()),
+        reinterpret_cast<const int64_t*>(state_indices.data_ptr()),
+        rows,
+        write_pos.size(0),
+        init_flush,
+        null_block_id);
+    cgh.parallel_for(range, task);
+  });
+}
