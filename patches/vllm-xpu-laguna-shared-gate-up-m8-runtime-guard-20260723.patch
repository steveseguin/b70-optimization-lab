+            "VLLM_XPU_LAGUNA_M8_SHARED_GATE_MM",
+            "1",
+            True,
+            True,
+            "standalone shared-gate MM selector is not literal 0",
+        ),
+        (
+            "VLLM_XPU_LAGUNA_M8_SHARED_DOWN_MM",
+            "1",
+            True,
+            True,
+            "shared-down MM selector is not literal 0",
+        ),
+        (
+            None,
+            None,
+            False,
+            True,
+            "shared gate/up exact-target row marker is not true",
+        ),
+        (
+            "VLLM_XPU_EXACT_SPEC_ATTN",
+            "0",
+            True,
+            False,
+            "shared gate/up marker is not true",
+        ),
+    ],
+)
+def test_bound_shared_gate_up_mm_runtime_drift_reaches_validator(
+    monkeypatch: pytest.MonkeyPatch,
+    environment: str | None,
+    value: str | None,
+    exact_rows: bool,
+    marker: bool,
+    expected: str,
+) -> None:
+    class ForbiddenMethod(linear.UnquantizedLinearMethod):
+        def apply(self, *_args, **_kwargs):
+            raise AssertionError("runtime drift reached generic linear apply")
+
+        def apply_batched_m1(self, *_args, **_kwargs):
+            raise AssertionError("runtime drift reached incumbent BMM")
+
+    assert not envs._is_envs_cache_enabled()
+    _set_gate_up_environment(monkeypatch)
+    envs.enable_envs_cache()
+    try:
+        if environment is not None:
+            if value is None:
+                monkeypatch.delenv(environment)
+            else:
+                monkeypatch.setenv(environment, value)
+        monkeypatch.setattr(linear.current_platform, "is_xpu", lambda: True)
+        monkeypatch.setattr(
+            linear,
+            "_xpu_is_exact_decode_or_verifier_rows",
+            lambda _: True,
+        )
+        gate, _ = _make_gate_up_pair(
+            torch.zeros(256, 3072, dtype=torch.bfloat16),
+            torch.zeros(256, 3072, dtype=torch.bfloat16),
+        )
+        gate.bias = None
+        gate.skip_bias_add = False
+        gate.quant_method = ForbiddenMethod()
+        gate.gather_output = False
+        gate.tp_size = 1
+        gate.return_bias = False
+        gate.xpu_exact_spec_rows = exact_rows
+        gate.xpu_laguna_m8_shared_gate_up_mm = marker
+        rows = torch.zeros(8, 3072, dtype=torch.bfloat16)
+
+        with pytest.raises(RuntimeError, match=expected):
+            linear.ColumnParallelLinear.forward(gate, rows)
+    finally:
+        envs.disable_envs_cache()
+
+
 @pytest.mark.skipif(
     not _RUN_XPU_DEVICE_TESTS or not torch.xpu.is_available(),
     reason="explicitly authorized XPU device tests are required",
