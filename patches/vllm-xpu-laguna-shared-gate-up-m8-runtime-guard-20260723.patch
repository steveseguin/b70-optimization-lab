+            True,
+            "remote-route zero selector is enabled",
+        ),
+        (
+            "VLLM_XPU_LAGUNA_M8_W1_N_TILE",
+            "128",
+            True,
+            True,
+            "routed-W1 tile is not explicitly N64",
+        ),
+        (
+            "VLLM_XPU_LAGUNA_M8_SHARED_EXPERT_STREAM",
