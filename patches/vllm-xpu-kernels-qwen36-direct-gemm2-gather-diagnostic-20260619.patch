+template <typename scalar_t>
+void qwen36_single_token_gather_topk8_out_impl(
+    scalar_t* output,
+    const scalar_t* moe_output,
+    const float* topk_weights,
+    const int* unpermuted_row_to_permuted_row,
+    int64_t hidden_size) {
+  constexpr int kBlockSize = 256;
+  constexpr int kElemsPerItem = 8;
+  constexpr int kTopK = 8;
+  constexpr int kStride = kBlockSize * kElemsPerItem;
+  auto& queue = vllm::xpu::vllmGetQueue();
+  sycl::range<1> local(kBlockSize);
+  sycl::range<1> global(kBlockSize);
+
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.parallel_for(
+        sycl::nd_range<1>(global, local),
+        [=](sycl::nd_item<1> item)
+            [[sycl::reqd_sub_group_size(16)]] {
+              const int local_id = item.get_local_id(0);
+              int moe_ids[kTopK];
+              float scores[kTopK];
+#pragma unroll
+              for (int k = 0; k < kTopK; ++k) {
+                moe_ids[k] = unpermuted_row_to_permuted_row[k];
+                scores[k] = topk_weights[k];
+              }
+
+              for (int64_t hidden_idx = local_id * kElemsPerItem;
+                   hidden_idx < hidden_size;
+                   hidden_idx += kStride) {
+                float accum[kElemsPerItem];
+#pragma unroll
+                for (int e = 0; e < kElemsPerItem; ++e) {
+                  accum[e] = 0.0f;
+                }
+#pragma unroll
+                for (int k = 0; k < kTopK; ++k) {
+                  const int row = moe_ids[k];
+#pragma unroll
+                  for (int e = 0; e < kElemsPerItem; ++e) {
+                    accum[e] += qwen36_to_float(
+                                    moe_output[row * hidden_size + hidden_idx +
+                                               e]) *
+                                scores[k];
+                  }
+                }
+#pragma unroll
+                for (int e = 0; e < kElemsPerItem; ++e) {
+                  output[hidden_idx + e] = accum[e];
+                }
+              }
+            });
+  });
+}
+
