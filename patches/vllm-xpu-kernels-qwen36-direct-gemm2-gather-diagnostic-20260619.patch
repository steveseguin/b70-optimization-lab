+bool qwen36_can_use_single_token_direct_gemm2_gather(
+    const torch::Tensor& output,
+    const torch::Tensor& gemm2_a,
+    const torch::Tensor& gemm2_a_scales,
+    const torch::Tensor& w2,
+    const torch::Tensor& w2_scales,
+    const c10::optional<at::Tensor>& w2_bias,
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    int64_t hidden_size,
+    int64_t inter_size,
+    int64_t num_experts) {
+  const bool bias_ok = !w2_bias.has_value() ||
+      (w2_bias.value().defined() && w2_bias.value().dim() == 2 &&
+       w2_bias.value().size(0) == num_experts &&
+       w2_bias.value().size(1) == hidden_size &&
+       w2_bias.value().scalar_type() == torch::kFloat32);
+  return output.dim() == 2 && output.size(0) == 1 &&
+         output.size(1) == hidden_size &&
+         (output.scalar_type() == torch::kBFloat16 ||
+          output.scalar_type() == torch::kFloat16) &&
+         gemm2_a.dim() == 2 && gemm2_a.size(0) >= 8 &&
+         gemm2_a.size(1) == inter_size &&
+         gemm2_a.scalar_type() == torch::kInt8 &&
+         gemm2_a_scales.numel() >= 8 &&
+         gemm2_a_scales.scalar_type() == torch::kFloat32 &&
+         w2.dim() == 3 && w2.size(0) == num_experts &&
+         w2.size(1) == inter_size && w2.size(2) == hidden_size &&
+         w2.scalar_type() == torch::kInt8 &&
+         w2_scales.dim() == 2 && w2_scales.size(0) == num_experts &&
+         w2_scales.size(1) == hidden_size &&
+         w2_scales.scalar_type() == torch::kFloat32 && bias_ok &&
+         topk_ids.dim() == 2 && topk_ids.size(0) == 1 &&
+         topk_ids.size(1) == 8 &&
+         topk_ids.scalar_type() == torch::kInt64 &&
+         topk_weights.dim() == 2 && topk_weights.size(0) == 1 &&
+         topk_weights.size(1) == 8 &&
+         topk_weights.scalar_type() == torch::kFloat32 &&
+         unpermuted_row_to_permuted_row.dim() == 1 &&
+         unpermuted_row_to_permuted_row.numel() >= 8 &&
+         unpermuted_row_to_permuted_row.scalar_type() == torch::kInt32;
+}
+
+void qwen36_single_token_gemm2_gather_topk8_out(
+    torch::Tensor& output,
+    const torch::Tensor& gemm2_a,
+    const torch::Tensor& gemm2_a_scales,
+    const torch::Tensor& w2,
+    const torch::Tensor& w2_scales,
+    const c10::optional<at::Tensor>& w2_bias,
+    const torch::Tensor& topk_ids,
+    const torch::Tensor& topk_weights,
+    const torch::Tensor& unpermuted_row_to_permuted_row,
+    int64_t hidden_size,
+    int64_t inter_size,
+    int64_t topk) {
+  const float* bias_ptr = w2_bias.has_value()
+      ? w2_bias.value().data_ptr<float>()
+      : static_cast<float*>(nullptr);
+
+  if (output.scalar_type() == torch::kBFloat16) {
+    qwen36_single_token_gemm2_gather_topk8_out_impl(
+        reinterpret_cast<sycl::ext::oneapi::bfloat16*>(output.data_ptr()),
+        gemm2_a.data_ptr<int8_t>(),
+        gemm2_a_scales.data_ptr<float>(),
+        w2.data_ptr<int8_t>(),
+        w2_scales.data_ptr<float>(),
+        bias_ptr,
+        topk_ids.data_ptr<int64_t>(),
+        topk_weights.data_ptr<float>(),
+        unpermuted_row_to_permuted_row.data_ptr<int>(),
+        hidden_size,
+        inter_size,
+        topk);
+  } else {
+    qwen36_single_token_gemm2_gather_topk8_out_impl(
+        reinterpret_cast<sycl::half*>(output.data_ptr()),
+        gemm2_a.data_ptr<int8_t>(),
+        gemm2_a_scales.data_ptr<float>(),
+        w2.data_ptr<int8_t>(),
+        w2_scales.data_ptr<float>(),
+        bias_ptr,
+        topk_ids.data_ptr<int64_t>(),
+        topk_weights.data_ptr<float>(),
+        unpermuted_row_to_permuted_row.data_ptr<int>(),
+        hidden_size,
+        inter_size,
+        topk);
+  }
+}
