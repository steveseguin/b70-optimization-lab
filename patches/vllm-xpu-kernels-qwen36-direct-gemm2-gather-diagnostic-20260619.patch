+  require_xpu_contiguous(hidden_states, "hidden_states");
+  require_xpu_contiguous(topk_ids, "topk_ids");
+  require_xpu_contiguous(topk_weights, "topk_weights");
+  require_xpu_contiguous(workspace, "workspace");
+  require_xpu_contiguous(remapped_hidden_states, "remapped_hidden_states");
+  require_xpu_contiguous(
+      unpermuted_row_to_permuted_row, "unpermuted_row_to_permuted_row");
+  require_xpu_contiguous(expert_first_token_offset,
+                         "expert_first_token_offset");
+  require_xpu_contiguous(output, "output");
+
+  require_same_device(hidden_states, topk_ids, "topk_ids");
+  require_same_device(hidden_states, topk_weights, "topk_weights");
+  require_same_device(hidden_states, workspace, "workspace");
+  require_same_device(hidden_states, remapped_hidden_states,
+                      "remapped_hidden_states");
+  require_same_device(hidden_states, unpermuted_row_to_permuted_row,
+                      "unpermuted_row_to_permuted_row");
+  require_same_device(hidden_states, expert_first_token_offset,
+                      "expert_first_token_offset");
+  require_same_device(hidden_states, output, "output");
+
+  require_dtype(topk_ids, "topk_ids", torch::kInt64);
+  require_dtype(topk_weights, "topk_weights", torch::kFloat32);
+  require_dtype(workspace, "workspace", torch::kUInt8);
+  require_dtype(
+      unpermuted_row_to_permuted_row,
+      "unpermuted_row_to_permuted_row",
+      torch::kInt32);
+  require_dtype(expert_first_token_offset,
+                "expert_first_token_offset",
+                torch::kInt64);
+
+  TORCH_CHECK(hidden_states.dim() == 2, "hidden_states must be 2D");
+  TORCH_CHECK(topk_ids.dim() == 2, "topk_ids must be 2D");
+  TORCH_CHECK(topk_weights.dim() == 2, "topk_weights must be 2D");
+  TORCH_CHECK(output.dim() == 2, "output must be 2D");
+  TORCH_CHECK(
+      hidden_states.size(0) == topk_ids.size(0),
+      "topk_ids row count must match hidden_states");
+  TORCH_CHECK(
+      topk_weights.sizes() == topk_ids.sizes(),
+      "topk_weights shape must match topk_ids");
+  TORCH_CHECK(
+      hidden_states.size(1) == hidden_size,
+      "hidden_states last dim must match hidden_size");
+  TORCH_CHECK(
+      output.size(0) == hidden_states.size(0),
+      "output row count must match hidden_states");
+  TORCH_CHECK(
+      output.size(1) == hidden_size,
+      "output last dim must match hidden_size");
+
+  if (qwen36_fused_q1_enabled() &&
+      qwen36_can_use_single_token_prologue_quant1(
+          hidden_states,
+          topk_ids,
+          topk_weights,
+          expert_first_token_offset,
+          unpermuted_row_to_permuted_row,
+          gemm1_a,
+          gemm1_a_scales,
+          hidden_size,
+          num_experts)) {
+    qwen36_single_token_prologue_quant1_out(
+        hidden_states,
+        topk_ids,
+        expert_first_token_offset,
+        unpermuted_row_to_permuted_row,
+        gemm1_a,
+        gemm1_a_scales,
+        hidden_size,
+        num_experts);
+  } else {
+    c10::optional<torch::Tensor> input_scales = c10::nullopt;
+    fused_moe_prologue(
+        hidden_states,
+        input_scales,
+        topk_ids,
+        topk_weights,
+        workspace,
+        hidden_size,
+        inter_size,
+        1,
+        0,
+        1,
+        num_experts);
+
+    per_token_quant_int8_xpu_out(
+        remapped_hidden_states, gemm1_a, gemm1_a_scales);
+  }
+
+  if (qwen36_direct_gemm2_gather_enabled() &&
+      qwen36_can_use_single_token_direct_gemm2_gather(
+          output,
+          gemm2_a,
+          gemm2_a_scales,
+          w2,
+          w2_scales,
+          w2_bias,
+          topk_ids,
+          topk_weights,
+          unpermuted_row_to_permuted_row,
+          hidden_size,
+          inter_size,
+          num_experts)) {
+    cutlass_grouped_gemm_w8a8_int8_offsets_interface(
+        gemm1_a,
+        gemm1_a_scales,
+        w13,
+        w13_scales,
+        w13_bias,
+        gemm1_output,
+        expert_first_token_offset,
+        2 * inter_size,
+        hidden_size,
+        num_experts);
+
+    silu_and_mul_quant_int8_xpu_out(gemm1_output, gemm2_a, gemm2_a_scales);
+
+    qwen36_single_token_gemm2_gather_topk8_out(
+        output,
+        gemm2_a,
+        gemm2_a_scales,
+        w2,
+        w2_scales,
+        w2_bias,
+        topk_ids,
+        topk_weights,
+        unpermuted_row_to_permuted_row,
+        hidden_size,
+        inter_size,
+        8);
+  } else {
+    qwen36_moe_w8a8_middle_layerlet(
+        gemm1_a,
+        gemm1_a_scales,
+        w13,
+        w13_scales,
+        w13_bias,
+        gemm1_output,
+        gemm2_a,
+        gemm2_a_scales,
+        w2,
+        w2_scales,
+        w2_bias,
+        gemm2_output,
+        expert_first_token_offset,
+        2 * inter_size,
+        hidden_size,
+        hidden_size,
+        inter_size,
+        num_experts);
+
+    if (qwen36_fast_gather_enabled() &&
+        qwen36_can_use_single_token_fast_gather(
+            output,
+            gemm2_output,
+            topk_weights,
+            unpermuted_row_to_permuted_row,
+            hidden_size)) {
+      qwen36_single_token_gather_topk8_out(
+          output,
+          gemm2_output,
+          topk_weights,
+          unpermuted_row_to_permuted_row,
+          hidden_size);
+    } else {
+      moe_gather(
+          output, gemm2_output, topk_weights, unpermuted_row_to_permuted_row,
+          num_experts);
+    }
+  }
+  return output;
+}
