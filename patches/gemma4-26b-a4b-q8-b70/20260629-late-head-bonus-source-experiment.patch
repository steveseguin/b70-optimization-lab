+
+static llama_token common_sampler_argmax_token(struct llama_context * ctx, int idx) {
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+
+    const float * logits = llama_get_logits_ith(ctx, idx);
+    GGML_ASSERT(logits != nullptr);
+    GGML_ASSERT(n_vocab > 0);
+
+    llama_token best_id = 0;
+    float best_logit = logits[0];
+    for (llama_token token_id = 1; token_id < n_vocab; token_id++) {
+        if (logits[token_id] > best_logit) {
+            best_logit = logits[token_id];
+            best_id = token_id;
+        }
+    }
+
+    return best_id;
+}
