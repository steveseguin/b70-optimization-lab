+        const bool skip_stateless_accept =
+            common_sampler_spec_verify_skip_stateless_accept_from_env() &&
+            common_sampler_is_stateless_greedy(gsmpl, grammar_first);
+
+        auto sampled_id = [&](size_t row) {
