+            n_mtp_decode_phase_ubatches,
+            ms(t_mtp_decode_phase_total_us),
+            ms(t_mtp_decode_phase_total_us) / (double) n_mtp_decode_phase_calls,
+            ms(t_mtp_decode_phase_total_us) / (double) std::max<int64_t>(1, n_mtp_decode_phase_tokens));
+    LLAMA_LOG_WARN("mtp decode phase profile: balloc_ms=%.3f, sched_reserve_ms=%.3f, memory_update_ms=%.3f, init_batch_ms=%.3f, output_reserve_ms=%.3f\n",
+            ms(t_mtp_decode_phase_balloc_us),
