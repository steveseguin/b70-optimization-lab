+            return (double) us / 1000.0;
+        };
+        const auto avg_ms = [](int64_t us, int64_t n) {
+            return n > 0 ? (double) us / (double) n / 1000.0 : 0.0;
+        };
+
+        SRV_INF("server spec profile: draft_ms=%.3f calls=%" PRId64 " draft_tokens=%" PRId64 " avg=%.3f ms\n",
+                ms(t_spec_draft_us),
+                n_spec_draft_calls,
+                n_spec_draft_tokens,
+                avg_ms(t_spec_draft_us, n_spec_draft_calls));
+        SRV_INF("server spec profile: target_decode_ms=%.3f calls=%" PRId64 " tokens=%" PRId64 " avg=%.3f ms avg_token=%.3f ms\n",
+                ms(t_spec_target_decode_us),
+                n_spec_target_decode_calls,
+                n_spec_target_decode_tokens,
+                avg_ms(t_spec_target_decode_us, n_spec_target_decode_calls),
+                avg_ms(t_spec_target_decode_us, n_spec_target_decode_tokens));
+        SRV_INF("server spec profile: target_prompt_ms=%.3f calls=%" PRId64 " tokens=%" PRId64 " avg=%.3f ms avg_token=%.3f ms\n",
+                ms(t_spec_target_prompt_us),
+                n_spec_target_prompt_calls,
+                n_spec_target_prompt_tokens,
+                avg_ms(t_spec_target_prompt_us, n_spec_target_prompt_calls),
+                avg_ms(t_spec_target_prompt_us, n_spec_target_prompt_tokens));
+        SRV_INF("server spec profile: target_generation_ms=%.3f calls=%" PRId64 " tokens=%" PRId64 " avg=%.3f ms avg_token=%.3f ms\n",
+                ms(t_spec_target_gen_us),
+                n_spec_target_gen_calls,
+                n_spec_target_gen_tokens,
+                avg_ms(t_spec_target_gen_us, n_spec_target_gen_calls),
+                avg_ms(t_spec_target_gen_us, n_spec_target_gen_tokens));
+        SRV_INF("server spec profile: process_ms=%.3f calls=%" PRId64 " avg=%.3f ms\n",
+                ms(t_spec_process_us),
+                n_spec_process_calls,
+                avg_ms(t_spec_process_us, n_spec_process_calls));
+        SRV_INF("server spec profile: sample_accept_ms=%.3f calls=%" PRId64 " avg=%.3f ms accepted_tokens=%" PRId64 "\n",
+                ms(t_spec_sample_accept_us),
+                n_spec_sample_accept_calls,
+                avg_ms(t_spec_sample_accept_us, n_spec_sample_accept_calls),
+                n_spec_accepted_tokens);
+        SRV_INF("server spec profile: common_accept_ms=%.3f calls=%" PRId64 " avg=%.3f ms\n",
+                ms(t_spec_common_accept_us),
+                n_spec_common_accept_calls,
+                avg_ms(t_spec_common_accept_us, n_spec_common_accept_calls));
+        SRV_INF("server spec profile: emit_ms=%.3f calls=%" PRId64 " avg=%.3f ms\n",
+                ms(t_spec_emit_us),
+                n_spec_emit_calls,
+                avg_ms(t_spec_emit_us, n_spec_emit_calls));
+
+        spec_profile_dirty = false;
+    }
