+static inline bool argmax_pair_better(float val, int32_t idx, float best_val, int32_t best_idx) {
+    return val > best_val || (val == best_val && (best_idx < 0 || idx < best_idx));
+}
+
+static inline void argmax_top2_consider(
+        float val, int32_t idx,
+        float & best_val, int32_t & best_idx,
+        float & second_val, int32_t & second_idx) {
+    if (idx < 0) {
+        return;
+    }
+    if (argmax_pair_better(val, idx, best_val, best_idx)) {
+        if (idx != best_idx) {
+            second_val = best_val;
+            second_idx = best_idx;
+        }
+        best_val = val;
+        best_idx = idx;
+    } else if (idx != best_idx &&
+            argmax_pair_better(val, idx, second_val, second_idx)) {
+        second_val = val;
+        second_idx = idx;
+    }
+}
+
+static inline int32_t argmax_float_bits(float val) {
+    return sycl::bit_cast<int32_t>(val);
+}
