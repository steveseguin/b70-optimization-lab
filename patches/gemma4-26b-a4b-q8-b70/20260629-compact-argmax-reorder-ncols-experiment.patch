+        const int prev_id    = ids_dev[prev_token * ids_token_stride +
+                                      prev_slot * ids_expert_stride];
+        if (prev_id == expert_id) {
+            return;
+        }
+    }
+
+    int match_tokens[max_grouped_routes];
+    int match_slots[max_grouped_routes];
+    int match_count = 0;
+    for (int token = 0; token < n_tokens; ++token) {
+        for (int slot = 0; slot < n_experts_used; ++slot) {
+            const int id = ids_dev[token * ids_token_stride +
+                                   slot * ids_expert_stride];
+            if (id == expert_id && match_count < max_grouped_routes) {
+                match_tokens[match_count] = token;
+                match_slots[match_count]  = slot;
+                ++match_count;
+            }
+        }
+    }
+
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) +
+                    item_ct1.get_local_id(1);
+    if (row >= nrows || match_count == 0) {
+        return;
+    }
+
+    float tmp[max_grouped_routes] = {0.0f};
+
+    const int blocks_per_row = ncols / QK8_0;
+    constexpr int blocks_per_warp =
+        (VDR_Q8_0_Q8_1_MMVQ * WARP_SIZE + QI8_0 - 1) / QI8_0;
+
+    const block_q8_0 * x = (const block_q8_0 *)
+        ((const char *) vx_base + (size_t) expert_id * expert_weight_stride);
+
+    for (int i = item_ct1.get_local_id(2) / (QI8_0 / VDR_Q8_0_Q8_1_MMVQ);
+         i < blocks_per_row; i += blocks_per_warp) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i;
+
+        for (size_t elem = 0; elem < QI8_0 / VDR_Q8_0_Q8_1_MMVQ;
+             elem += WARP_SIZE) {
+            const int iqs = elem + VDR_Q8_0_Q8_1_MMVQ *
+                (item_ct1.get_local_id(2) % (QI8_0 / VDR_Q8_0_Q8_1_MMVQ));
+
+            int v[VDR_Q8_0_Q8_1_MMVQ];
+#pragma unroll
+            for (int j = 0; j < VDR_Q8_0_Q8_1_MMVQ; ++j) {
+                v[j] = get_int_from_int8(x[ibx].qs, iqs + j);
+            }
+
+#pragma unroll
+            for (int match = 0; match < max_grouped_routes; ++match) {
+                if (match >= match_count) {
+                    continue;
+                }
+                const int src1_row = match_tokens[match] * src1_rows_per_token +
+                    (src1_rows_per_token == 1 ? 0 : match_slots[match]);
+                const block_q8_1 * y = (const block_q8_1 *)
+                    ((const char *) vy_base + (size_t) src1_row * src1_row_stride);
+
+                int u[VDR_Q8_0_Q8_1_MMVQ];
+#pragma unroll
+                for (int j = 0; j < VDR_Q8_0_Q8_1_MMVQ; ++j) {
+                    u[j] = get_int_from_int8_aligned(y[iby].qs, iqs + j);
+                }
+                tmp[match] += vec_dot_q8_0_q8_1_impl<VDR_Q8_0_Q8_1_MMVQ>(
+                    v, u, x[ibx].d, y[iby].ds[0]);
+            }
+        }
+    }
+
+#pragma unroll
+    for (int match = 0; match < max_grouped_routes; ++match) {
+        if (match >= match_count) {
+            continue;
+        }
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            tmp[match] += dpct::permute_sub_group_by_xor(
+                item_ct1.get_sub_group(), tmp[match], mask);
+        }
+    }
+
+    if (item_ct1.get_local_id(2) == 0) {
+#pragma unroll
+        for (int match = 0; match < max_grouped_routes; ++match) {
+            if (match >= match_count) {
+                continue;
+            }
+            float * dst = (float *) ((char *) dst_base +
+                (size_t) match_tokens[match] * dst_token_stride +
+                (size_t) match_slots[match] * dst_row_stride);
+            dst[row] = tmp[match];
+        }
+    }
+}
