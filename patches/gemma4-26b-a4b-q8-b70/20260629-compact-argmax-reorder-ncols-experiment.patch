+static bool ggml_sycl_mul_mat_argmax_reorder_ncols_enabled() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ARGMAX_REORDER_NCOLS");
+    if (env == nullptr || env[0] == '\0') {
+        return false;
+    }
+
+    return std::strcmp(env, "1") == 0 || std::strcmp(env, "true") == 0 ||
+        std::strcmp(env, "TRUE") == 0 || std::strcmp(env, "yes") == 0 ||
+        std::strcmp(env, "on") == 0;
+}
