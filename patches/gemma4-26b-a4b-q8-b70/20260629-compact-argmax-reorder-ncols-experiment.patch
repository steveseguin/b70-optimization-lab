+int ggml_sycl_mul_mat_vec_q_argmax_tile_subgroups() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ARGMAX_TILE_SUBGROUPS");
+    if (env == nullptr || env[0] == '\0') {
+        return WARP_SIZE;
+    }
+    const int value = std::atoi(env);
+    switch (value) {
+        case 1:
+        case 2:
+        case 4:
+        case 8:
+        case 16:
+        case 32:
+            return value <= WARP_SIZE ? value : WARP_SIZE;
+        default:
+            return WARP_SIZE;
+    }
+}
