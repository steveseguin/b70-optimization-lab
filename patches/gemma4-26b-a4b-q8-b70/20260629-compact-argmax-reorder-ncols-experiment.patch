+template <typename reorder_vec_dot_q_sycl>
+static void launch_mul_mat_vec_q_moe_multi_token_reorder(
+    const void * vx_base, const void * vy, const int32_t * ids_dev,
+    float * dst_base, const int ncols, const int nrows, const int n_experts_used,
+    const int n_tokens, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t dst_token_stride,
+    const size_t src1_token_stride, const int ids_expert_stride,
+    const int ids_token_stride, dpct::queue_ptr stream) {
+    const int            block_num_y = (nrows + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums((unsigned) n_tokens, (unsigned) n_experts_used, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_moe_multi_token_reorder<reorder_vec_dot_q_sycl>(
+                    vx_base, vy, dst_base, ids_dev, ncols, nrows,
+                    expert_weight_stride, dst_row_stride, dst_token_stride,
+                    src1_token_stride, ids_expert_stride, ids_token_stride, item);
+            });
+    });
+}
