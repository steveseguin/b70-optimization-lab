+static void mul_mat_vec_q8_0_moe_multi_token_reorder_direct_vdr2(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev,
+    const int ncols, const int nrows,
+    const size_t expert_weight_stride, const size_t dst_row_stride,
+    const size_t dst_token_stride, const size_t src1_token_stride,
+    const int ids_expert_stride, const int ids_token_stride,
+    const sycl::nd_item<3> & item_ct1) {
+
+    constexpr int vdr = 2;
+    static_assert(vdr == GGML_SYCL_REORDER_Q8_0_VDR_MMVQ);
+
+    const int token_idx  = item_ct1.get_group(0);
+    const int expert_idx = item_ct1.get_group(1);
+    const int expert_id  = ids_dev[token_idx * ids_token_stride +
+                                   expert_idx * ids_expert_stride];
+
+    const char * vx  = (const char *) vx_base + (size_t) expert_id * expert_weight_stride;
+    const char * vy  = (const char *) vy_base + (size_t) token_idx * src1_token_stride;
+    float *      dst = (float *) ((char *) dst_base +
+        (size_t) token_idx * dst_token_stride +
+        (size_t) expert_idx * dst_row_stride);
+
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) +
+                    item_ct1.get_local_id(1);
+    if (row >= nrows) {
+        return;
+    }
+
+    const auto sg = item_ct1.get_sub_group();
+
+    const int     blocks_per_row              = ncols / QK8_0;
+    constexpr int block_elements_per_subgroup = QI8_0 / vdr;
+    constexpr int blocks_per_subgroup         =
+        (vdr * WARP_SIZE + QI8_0 - 1) / QI8_0;
+
+    static_assert(block_elements_per_subgroup == 4);
+    static_assert(blocks_per_subgroup > 0);
+
+    float partial_sum = 0.0f;
+    for (int i = sg.get_local_linear_id() / block_elements_per_subgroup;
+         i < blocks_per_row; i += blocks_per_subgroup) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i;
+
+        const int iqs = vdr *
+            (sg.get_local_linear_id() % block_elements_per_subgroup);
+
+        const int8_t * q8_0_quant_ptr =
+            (const int8_t *) vx + (size_t) ibx * QK8_0;
+        const ggml_half q8_0_d =
+            *reinterpret_cast<const ggml_half *>(
+                vx + (size_t) ncols * nrows +
+                (size_t) ibx * sizeof(ggml_half));
+
+        const int8_t * q8_1_quant_ptr =
+            (const int8_t *) vy + (size_t) iby * QK8_1;
+        const sycl::half2 * q8_1_ds_ptr =
+            (const sycl::half2 *) (vy + ncols +
+                (size_t) iby * sizeof(sycl::half2));
+
+        int v0 = get_int_from_int8(q8_0_quant_ptr, iqs + 0);
+        int v1 = get_int_from_int8(q8_0_quant_ptr, iqs + 1);
+        int u0 = get_int_from_int8_aligned(q8_1_quant_ptr, iqs + 0);
+        int u1 = get_int_from_int8_aligned(q8_1_quant_ptr, iqs + 1);
