+static void launch_mul_mat_vec_q_moe_multi_token(
+    const void * vx_base, const void * vy, const int32_t * ids_dev,
+    float * dst_base, const int ncols, const int nrows, const int n_experts_used,
+    const int n_tokens, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t dst_token_stride,
+    const size_t src1_token_stride, const int ids_expert_stride,
+    const int ids_token_stride, dpct::queue_ptr stream) {
