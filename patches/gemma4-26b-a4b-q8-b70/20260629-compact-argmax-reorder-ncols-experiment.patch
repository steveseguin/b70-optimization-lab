+template <typename reorder_vec_dot_q_sycl, int ncols_dst>
+static void mul_mat_vec_q_reorder_argmax_ncols_tile(
+        const void * __restrict__ vx,
+        const void * __restrict__ vy,
+        float * __restrict__ scratch_vals,
+        int32_t * __restrict__ scratch_idxs,
+        const int ncols,
+        const int nrows,
+        const int src1_padded_cols,
+        const int scratch_count_per_vec,
+        sycl::local_accessor<float, 1> tile_vals,
+        sycl::local_accessor<int32_t, 1> tile_idxs,
+        const sycl::nd_item<3> & nd_item) {
+
+    using block_type   = ggml_sycl_reordered::block_q_t<reorder_vec_dot_q_sycl::gtype>;
+    using block_traits = typename block_type::traits;
+
+    const auto sg          = nd_item.get_sub_group();
+    const int  sg_id       = sg.get_group_linear_id();
+    const int  sg_count    = sg.get_group_linear_range();
+    const int  lane        = sg.get_local_linear_id();
+    const int  tile_id     = nd_item.get_group(2);
+    const int  row         = tile_id * sg_count + sg_id;
+
+    float partial_sum[ncols_dst] = {0.0f};
+    if (row < nrows) {
+        const int     blocks_per_row              = ncols / block_traits::qk;
+        constexpr int blocks_per_subgroup         = ceil_div(block_traits::vdr_mmvq * WARP_SIZE, block_traits::qi);
+        constexpr int block_elements_per_subgroup = block_traits::qi / block_traits::vdr_mmvq;
+        const int     nblocks                     = nrows * (ncols / block_traits::qk);
+
+        for (int i = lane / block_elements_per_subgroup; i < blocks_per_row; i += blocks_per_subgroup) {
+            const int ibx = row * blocks_per_row + i;
+
+            const auto bx_offset = block_type::get_block_offset(ibx, nblocks);
+            const auto d_offset  = block_type::get_d_offset(nrows, ncols, ibx);
+
+#pragma unroll
+            for (int elem = 0; elem < block_elements_per_subgroup; elem += WARP_SIZE) {
+                const int iqs = elem + block_traits::vdr_mmvq * (lane % block_elements_per_subgroup);
+
+#pragma unroll
+                for (int j = 0; j < ncols_dst; ++j) {
+                    const int64_t row_offset = (int64_t) j * (src1_padded_cols / QK8_1) * (int64_t) sizeof(block_q8_1);
+                    const int8_t * q8_1_quant_ptr =
+                        (const int8_t *) vy + row_offset + i * QK8_1;
+                    const sycl::half2 * q8_1_ds_ptr =
+                        (const sycl::half2 *) ((const char *) vy + row_offset + ncols + i * sizeof(sycl::half2));
+
+                    partial_sum[j] += reorder_vec_dot_q_sycl()(vx, bx_offset, d_offset, q8_1_quant_ptr, q8_1_ds_ptr, iqs);
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int j = 0; j < ncols_dst; ++j) {
+        const float sum = sycl::reduce_over_group(sg, partial_sum[j], std::plus<>());
