+static bool copy_single_tensor_async_ints(
+    const std::map<llama_seq_id, ggml_tensor*> & tensor_map,
+    const buffer_view<llama_token> & sampled,
+    uint32_t row,
+    ggml_backend_sched_t sched,
+    int64_t row_stride = 1) {
+    if (!sampled.has_data() || tensor_map.size() != 1) {
+        return false;
+    }
+
+    row_stride = std::max<int64_t>(1, row_stride);
+
+    ggml_tensor * tensor = tensor_map.begin()->second;
+    const int64_t n_copy = std::min<int64_t>(row_stride, ggml_nelements(tensor));
+    const size_t offset = (size_t) row * (size_t) row_stride;
+    GGML_ASSERT(offset + (size_t) n_copy <= sampled.size);
+
+    GGML_ASSERT(ggml_is_contiguous(tensor) && "sampled tokens tensor must be contiguous for async copy");
+
+    ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched, tensor);
+    ggml_backend_tensor_get_async(backend, tensor, sampled.data + offset, 0, sizeof(sampled.data[0]) * (size_t) n_copy);
+    return true;
+}
