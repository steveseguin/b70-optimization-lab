+static bool common_speculative_env_enabled(const char * name) {
+    const char * env = std::getenv(name);
+    if (env == nullptr || env[0] == '\0') {
+        return false;
+    }
+
+    return strcmp(env, "1") == 0 || strcmp(env, "true") == 0 ||
+        strcmp(env, "TRUE") == 0 || strcmp(env, "yes") == 0 ||
+        strcmp(env, "on") == 0;
+}
+
+static int32_t common_speculative_mtp_draft_top_k_from_env() {
+    constexpr int32_t default_top_k = 10;
+
+    const char * env = std::getenv("LLAMA_MTP_DRAFT_TOP_K");
+    const char * env_name = "LLAMA_MTP_DRAFT_TOP_K";
+    if (env == nullptr || env[0] == '\0') {
+        env = std::getenv("LLAMA_SPEC_DRAFT_MTP_TOP_K");
+        env_name = "LLAMA_SPEC_DRAFT_MTP_TOP_K";
+    }
+    if (env == nullptr || env[0] == '\0') {
+        return default_top_k;
+    }
+
+    char * end = nullptr;
+    errno = 0;
+    const long value = std::strtol(env, &end, 10);
+    if (errno != 0 || end == env || *end != '\0' || value < 1 ||
+            value > std::numeric_limits<int32_t>::max()) {
+        LOG_WRN("%s: invalid %s='%s'; using default %d\n",
+                __func__, env_name, env, default_top_k);
+        return default_top_k;
+    }
+
+    return (int32_t) value;
+}
+
