+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_NVFP4:
+            return true;
+        default:
+            return false;
+    }
+}
+
+static void ggml_sycl_mul_mat_id_seed_route_cache(
+        ggml_backend_sycl_context & ctx,
+        const ggml_tensor * ids,
+        int64_t n_ids,
+        int64_t n_as) {
+    if (!ggml_sycl_mul_mat_id_route_cache_enabled()) {
+        return;
+    }
+
+    const int64_t n_tokens = ids->ne[1];
+    const int64_t n_routed_rows = n_ids * n_tokens;
+    const size_t ids_nbytes = ggml_nbytes(ids);
+    const char * ids_dev = (const char *) ids->data;
+
+    mmid_route_cache & route_cache = ctx.mmid_route_cache_host;
+    route_cache.ids_host.resize(ids_nbytes);
+
+    const queue_ptr stream = ctx.stream();
+    SYCL_CHECK(CHECK_TRY_ERROR(
+        stream->memcpy(route_cache.ids_host.data(), ids_dev, ids_nbytes)));
+    // The host route plan must be ready before we return to graph execution.
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+
+    mmid_counting_sort_rows(ids, route_cache.ids_host.data(), n_ids, n_as,
+                            n_routed_rows, route_cache.expert_row_counts,
+                            route_cache.expert_row_offsets,
+                            route_cache.routed_row_src);
+
+    route_cache.valid = true;
+    route_cache.ids_tensor = ids;
+    route_cache.ids_data = ids->data;
+    route_cache.n_as = n_as;
+    route_cache.n_ids = n_ids;
+    route_cache.n_tokens = n_tokens;
+    route_cache.n_routed_rows = n_routed_rows;
+    route_cache.ids_nbytes = ids_nbytes;
+    route_cache.ids_nb0 = ids->nb[0];
+    route_cache.ids_nb1 = ids->nb[1];
+}
+
+static int64_t ggml_sycl_mul_mat_id_route_profile_every() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_ROUTE_PROFILE_EVERY");
+    if (!env || env[0] == '\0') {
+        return 250;
+    }
+    char * end = nullptr;
+    const long value = std::strtol(env, &end, 10);
+    return end != env && value > 0 ? value : 250;
+}
+
+static bool ggml_sycl_mul_mat_id_route_timing_enabled() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_ROUTE_TIMING");
+    return env && (std::strcmp(env, "1") == 0 ||
+                   std::strcmp(env, "true") == 0 ||
+                   std::strcmp(env, "TRUE") == 0 ||
+                   std::strcmp(env, "yes") == 0 ||
+                   std::strcmp(env, "on") == 0);
+}
+
+static int64_t ggml_sycl_mul_mat_id_route_timing_every() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_ROUTE_TIMING_EVERY");
+    if (!env || env[0] == '\0') {
+        return 25;
+    }
+    char * end = nullptr;
+    const long value = std::strtol(env, &end, 10);
+    return end != env && value > 0 ? value : 25;
+}
+
+static void ggml_sycl_mul_mat_id_route_profile_record(
+        const ggml_tensor * ids, const char * ids_host,
+        int64_t n_ids, int64_t n_as,
+        const ggml_tensor * src1, const ggml_tensor * dst) {
+    static const bool enabled = ggml_sycl_mul_mat_id_route_profile_enabled();
+    if (!enabled) {
+        return;
+    }
+
+    const int64_t n_tokens = ids->ne[1];
+    if (n_ids <= 0 || n_tokens <= 0 || n_as <= 0) {
+        return;
+    }
+
+    std::vector<int64_t> expert_counts(n_as, 0);
+    int64_t token_unique_sum = 0;
+
+    for (int64_t iid1 = 0; iid1 < n_tokens; iid1++) {
+        int64_t token_unique = 0;
+        for (int64_t id = 0; id < n_ids; id++) {
+            const int32_t row_id_i = *(const int32_t *) (ids_host + iid1*ids->nb[1] + id*ids->nb[0]);
+            if (row_id_i < 0 || row_id_i >= n_as) {
+                continue;
+            }
+            if (expert_counts[row_id_i]++ == 0) {
+                // Count global unique experts below. Per-token unique is separate.
+            }
+
+            bool seen_this_token = false;
+            for (int64_t prev = 0; prev < id; prev++) {
+                const int32_t prev_id = *(const int32_t *) (ids_host + iid1*ids->nb[1] + prev*ids->nb[0]);
+                if (prev_id == row_id_i) {
+                    seen_this_token = true;
+                    break;
+                }
+            }
+            if (!seen_this_token) {
+                token_unique++;
+            }
+        }
+        token_unique_sum += token_unique;
+    }
+
+    int64_t unique_experts = 0;
+    int64_t max_expert_rows = 0;
+    for (int64_t count : expert_counts) {
+        if (count > 0) {
+            unique_experts++;
+            max_expert_rows = std::max(max_expert_rows, count);
+        }
+    }
+
+    const int64_t routed_rows = n_ids * n_tokens;
+    const int64_t repeated_rows = routed_rows - unique_experts;
+
+    struct route_profile_accum {
+        int64_t calls = 0;
+        int64_t multi_calls = 0;
+        int64_t routed_rows = 0;
+        int64_t tokens = 0;
+        int64_t ids = 0;
+        int64_t unique_experts = 0;
+        int64_t token_unique = 0;
+        int64_t repeated_rows = 0;
+        int64_t max_expert_rows = 0;
+    };
+
+    struct route_profile_totals {
+        std::mutex mutex;
+        route_profile_accum all;
+        route_profile_accum buckets[4];
+    };
+
+    const auto add_sample = [&](route_profile_accum & accum) {
+        accum.calls++;
+        accum.multi_calls += n_tokens > 1 ? 1 : 0;
+        accum.routed_rows += routed_rows;
+        accum.tokens += n_tokens;
+        accum.ids += n_ids;
+        accum.unique_experts += unique_experts;
+        accum.token_unique += token_unique_sum;
+        accum.repeated_rows += repeated_rows;
+        accum.max_expert_rows += max_expert_rows;
+    };
+
+    static route_profile_totals totals;
+    static const int64_t every = ggml_sycl_mul_mat_id_route_profile_every();
+
+    std::lock_guard<std::mutex> lock(totals.mutex);
+    add_sample(totals.all);
+
+    const int bucket =
+        n_tokens <= 1  ? 0 :
+        n_tokens <= 8  ? 1 :
+        n_tokens <= 32 ? 2 : 3;
+    add_sample(totals.buckets[bucket]);
+
+    if (totals.all.calls % every == 0) {
+        const auto log_accum = [&](const char * label, const route_profile_accum & accum) {
+            if (accum.calls == 0) {
+                return;
+            }
+            const double calls = (double) accum.calls;
+            GGML_LOG_WARN(
+                    "sycl mul_mat_id route profile: bucket=%s calls=%" PRId64
+                    " multi_calls=%" PRId64
+                    " avg_tokens=%.3f avg_ids=%.3f avg_routed_rows=%.3f"
+                    " avg_global_unique=%.3f avg_token_unique=%.3f"
+                    " avg_repeated_rows=%.3f avg_max_expert_rows=%.3f"
+                    " last_shape src1=[%" PRId64 ",%" PRId64 ",%" PRId64 "]"
+                    " dst=[%" PRId64 ",%" PRId64 ",%" PRId64 "]\n",
+                    label,
+                    accum.calls,
+                    accum.multi_calls,
+                    (double) accum.tokens / calls,
+                    (double) accum.ids / calls,
+                    (double) accum.routed_rows / calls,
+                    (double) accum.unique_experts / calls,
+                    (double) accum.token_unique / std::max<int64_t>(1, accum.tokens),
+                    (double) accum.repeated_rows / calls,
+                    (double) accum.max_expert_rows / calls,
+                    src1->ne[0], src1->ne[1], src1->ne[2],
+                    dst->ne[0], dst->ne[1], dst->ne[2]);
+        };
+
+        log_accum("all", totals.all);
+        log_accum("tok1", totals.buckets[0]);
+        log_accum("tok2_8", totals.buckets[1]);
+        log_accum("tok9_32", totals.buckets[2]);
+        log_accum("tok33p", totals.buckets[3]);
+    }
+}
+
+static void moe_selected_down_weighted_sum_matmul_epilogue_sycl(
+        const float * dst_contiguous, const int32_t * route_slot_to_sorted_row,
+        const int32_t * ids, const float * weights, const void * down_scales,
+        float * dst, const int nrows, const int n_experts_used, const int n_tokens,
+        const size_t dst_contiguous_row_stride, const int ids_expert_stride,
+        const int ids_token_stride, const size_t weights_nb1,
+        const size_t weights_nb2, const size_t down_scales_nb0,
+        const int down_scales_type, const size_t dst_nb0, const size_t dst_nb1,
+        dpct::queue_ptr stream) {
+    stream->parallel_for(
+        sycl::range<2>((size_t) n_tokens, (size_t) nrows),
+        [=](sycl::id<2> idx) {
+            const int token = (int) idx[0];
+            const int row   = (int) idx[1];
+
+            float sum = 0.0f;
+            for (int slot = 0; slot < n_experts_used; ++slot) {
+                const int routed_row =
+                    route_slot_to_sorted_row[token * n_experts_used + slot];
+                if (routed_row < 0) {
+                    continue;
+                }
+
+                const int expert_id =
+                    ids[token * ids_token_stride + slot * ids_expert_stride];
+                float w = *(const float *) ((const char *) weights +
+                    (size_t) slot * weights_nb1 + (size_t) token * weights_nb2);
+                if (down_scales != nullptr) {
+                    const char * scale_ptr = (const char *) down_scales +
+                        (size_t) expert_id * down_scales_nb0;
+                    if (down_scales_type == GGML_TYPE_F32) {
+                        w *= *(const float *) scale_ptr;
+                    } else {
+                        w *= (float) *(const sycl::half *) scale_ptr;
+                    }
+                }
+
+                const float * routed =
+                    (const float *) ((const char *) dst_contiguous +
+                        (size_t) routed_row * dst_contiguous_row_stride);
+                sum += w * routed[row];
+            }
+
+            *(float *) ((char *) dst + (size_t) row * dst_nb0 +
+                (size_t) token * dst_nb1) = sum;
+        });
+}
+
+// Alternative backend for GGML_OP_MOE_SELECTED_DOWN_WEIGHTED_SUM:
+// keep the generic per-expert MUL_MAT_ID matmul schedule, then fuse the final
+// route scatter and weighted sum. This is aimed at Gemma4 MTP verifier batches
+// where direct per-row fused down kernels underperform the tuned matmul path.
+static bool ggml_sycl_moe_selected_down_weighted_sum_matmul_epilogue(
+        ggml_backend_sycl_context & ctx, ggml_tensor * dst) try {
+    const ggml_tensor * down_exps   = dst->src[0];
+    const ggml_tensor * cur         = dst->src[1];
+    const ggml_tensor * ids         = dst->src[2];
+    const ggml_tensor * weights     = dst->src[3];
+    const ggml_tensor * down_scales = dst->src[4];
+
+    if (down_exps->type != GGML_TYPE_Q8_0 ||
+            cur->type != GGML_TYPE_F32 ||
+            ids->type != GGML_TYPE_I32 ||
+            weights->type != GGML_TYPE_F32 ||
+            dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (down_scales != nullptr &&
+            down_scales->type != GGML_TYPE_F32 &&
+            down_scales->type != GGML_TYPE_F16) {
+        return false;
+    }
+    if (!ggml_is_contiguous(cur) || ggml_is_transposed(ids)) {
+        return false;
+    }
+
+    const int64_t ncols          = cur->ne[0];
+    const int64_t n_ids          = ids->ne[0];
+    const int64_t n_tokens       = ids->ne[1];
+    const int64_t n_as           = down_exps->ne[2];
+    const int64_t nrows          = dst->ne[0];
+    const int64_t n_routed_rows  = n_ids * n_tokens;
+
+    if (ncols <= 0 || nrows <= 0 || n_ids <= 0 || n_tokens <= 0 ||
+            n_tokens > 8 || n_ids > 8 || n_routed_rows <= 0) {
+        return false;
+    }
+    if (cur->ne[1] != n_ids || cur->ne[2] != n_tokens ||
+            down_exps->ne[0] != ncols || down_exps->ne[1] != nrows ||
+            dst->ne[1] != n_tokens) {
+        return false;
+    }
+    if (ids->nb[0] % sizeof(int32_t) != 0 ||
+            ids->nb[1] % sizeof(int32_t) != 0 ||
+            cur->nb[0] != (int64_t) sizeof(float) ||
+            cur->nb[1] != (int64_t) (sizeof(float) * ncols) ||
+            dst->nb[0] != (int64_t) sizeof(float) ||
+            weights->nb[0] != (int64_t) sizeof(float) ||
+            weights->ne[0] != 1 ||
+            weights->ne[1] != n_ids ||
+            weights->ne[2] != n_tokens) {
+        return false;
+    }
+    if (down_scales != nullptr &&
+            (down_scales->ne[0] != n_as ||
+             down_scales->nb[0] != (int64_t) ggml_type_size(down_scales->type))) {
+        return false;
+    }
+
+    dpct::queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const size_t ids_span =
+        (size_t) (n_tokens - 1) * ids->nb[1] +
+        (size_t) (n_ids - 1) * ids->nb[0] + sizeof(int32_t);
+    std::vector<char> ids_raw(ids_span);
+    SYCL_CHECK(CHECK_TRY_ERROR(
+        stream->memcpy(ids_raw.data(), (const char *) ids->data, ids_span)));
+    SYCL_CHECK(CHECK_TRY_ERROR(stream->wait()));
+
+    std::vector<int32_t> ids_dense((size_t) n_routed_rows);
+    for (int64_t token = 0; token < n_tokens; ++token) {
+        for (int64_t slot = 0; slot < n_ids; ++slot) {
+            ids_dense[(size_t) token * (size_t) n_ids + (size_t) slot] =
+                *(const int32_t *) (ids_raw.data() +
+                    (size_t) token * ids->nb[1] + (size_t) slot * ids->nb[0]);
+        }
+    }
+    ggml_tensor ids_dense_tensor = *ids;
+    ids_dense_tensor.nb[0] = sizeof(int32_t);
+    ids_dense_tensor.nb[1] = n_ids * (int64_t) sizeof(int32_t);
+    ids_dense_tensor.nb[2] = n_tokens * ids_dense_tensor.nb[1];
+    ids_dense_tensor.nb[3] = ids_dense_tensor.nb[2];
+
+    ggml_sycl_mul_mat_id_route_profile_record(
+        &ids_dense_tensor, (const char *) ids_dense.data(), n_ids, n_as, cur, dst);
+
+    std::vector<int64_t> expert_row_counts;
+    std::vector<int64_t> expert_row_offsets;
+    std::vector<mmid_row_mapping> & routed_row_src = ctx.mmid_row_mapping_host;
+    mmid_counting_sort_rows(&ids_dense_tensor, (const char *) ids_dense.data(),
+                            n_ids, n_as, n_routed_rows,
+                            expert_row_counts, expert_row_offsets, routed_row_src);
+
+    std::vector<int32_t> route_slot_to_sorted_row((size_t) n_routed_rows, -1);
+    for (int64_t routed_row = 0; routed_row < n_routed_rows; ++routed_row) {
+        const mmid_row_mapping & src = routed_row_src[routed_row];
+        const int64_t slot  = src.i1;
+        const int64_t token = src.i2;
+        GGML_ASSERT(slot >= 0 && slot < n_ids);
+        GGML_ASSERT(token >= 0 && token < n_tokens);
+        route_slot_to_sorted_row[(size_t) token * (size_t) n_ids + (size_t) slot] =
+            (int32_t) routed_row;
+    }
+
+    ggml_sycl_pool_alloc<mmid_row_mapping> dev_row_mapping(ctx.pool(), n_routed_rows);
+    SYCL_CHECK(CHECK_TRY_ERROR(
+        stream->memcpy(dev_row_mapping.get(), routed_row_src.data(),
+            (size_t) n_routed_rows * sizeof(mmid_row_mapping))));
+
+    ggml_sycl_pool_alloc<int32_t> dev_route_slot_to_sorted_row(ctx.pool(), n_routed_rows);
+    SYCL_CHECK(CHECK_TRY_ERROR(
+        stream->memcpy(dev_route_slot_to_sorted_row.get(), route_slot_to_sorted_row.data(),
+            (size_t) n_routed_rows * sizeof(int32_t))));
+
+    const size_t src1_row_stride = (size_t) cur->nb[1];
+    const size_t dst_row_stride  = (size_t) sizeof(float) * (size_t) nrows;
+    ggml_sycl_pool_alloc<char> src1_contiguous(
+        ctx.pool(), (size_t) n_routed_rows * src1_row_stride);
+    ggml_sycl_pool_alloc<char> dst_contiguous(
+        ctx.pool(), (size_t) n_routed_rows * dst_row_stride);
+
+    const unsigned int max_work_group_size =
+        ggml_sycl_info().max_work_group_sizes[ctx.device];
+    assert(max_work_group_size % (WARP_SIZE * WARP_SIZE) == 0);
+
+    {
+        sycl::range<3> block_dims(
+            1, 1, std::min((unsigned int) ncols, max_work_group_size));
+        sycl::range<3> grid_dims(1, 1, n_routed_rows);
+        stream->submit([&](sycl::handler & cgh) {
+            char * src1_contiguous_get = src1_contiguous.get();
+            mmid_row_mapping * dev_row_mapping_get = dev_row_mapping.get();
+            const char * src1_original = (const char *) cur->data;
+            const int64_t ne11 = cur->ne[1];
+            const int64_t ne10 = cur->ne[0];
+            const size_t nb11 = (size_t) cur->nb[1];
+            const size_t nb12 = (size_t) cur->nb[2];
+
+            cgh.parallel_for(
+                sycl::nd_range<3>(grid_dims * block_dims, block_dims),
+                [=](sycl::nd_item<3> item_ct1) {
+                    k_copy_src1_to_contiguous(
+                        src1_original, src1_contiguous_get,
+                        dev_row_mapping_get,
+                        ne11, ne10, nb11, nb12, item_ct1);
+                });
+        });
+    }
+
+    ggml_tensor src0_row = *down_exps;
+    ggml_tensor src1_row = *cur;
+    ggml_tensor dst_row  = *dst;
+
+    src0_row.ne[2] = 1;
+    src0_row.ne[3] = 1;
+    src0_row.nb[3] = down_exps->nb[2];
+
+    src1_row.ne[2] = 1;
+    src1_row.ne[3] = 1;
+    src1_row.nb[0] = sizeof(float);
+
+    dst_row.ne[2] = 1;
+    dst_row.ne[3] = 1;
+    dst_row.nb[0] = sizeof(float);
+
+    char * src0_original = (char *) down_exps->data;
+    for (int64_t expert = 0; expert < n_as; ++expert) {
+        const int64_t num_src1_rows = expert_row_counts[expert];
+        if (num_src1_rows == 0) {
+            continue;
+        }
+
+        const int64_t expert_row_offset = expert_row_offsets[expert];
+
+        src0_row.data = src0_original + expert * down_exps->nb[2];
+
+        src1_row.data  = src1_contiguous.get() + (size_t) expert_row_offset * src1_row_stride;
+        src1_row.ne[1] = num_src1_rows;
+        src1_row.nb[1] = src1_row_stride;
+        src1_row.nb[2] = (int64_t) ((size_t) num_src1_rows * src1_row_stride);
+        src1_row.nb[3] = src1_row.nb[2];
+
+        dst_row.data  = dst_contiguous.get() + (size_t) expert_row_offset * dst_row_stride;
+        dst_row.ne[1] = num_src1_rows;
+        dst_row.nb[1] = dst_row_stride;
+        dst_row.nb[2] = (int64_t) ((size_t) num_src1_rows * dst_row_stride);
+        dst_row.nb[3] = dst_row.nb[2];
+
+        ggml_sycl_mul_mat(ctx, &src0_row, &src1_row, &dst_row);
+    }
+
+    const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+    const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+    moe_selected_down_weighted_sum_matmul_epilogue_sycl(
+        (const float *) dst_contiguous.get(),
+        dev_route_slot_to_sorted_row.get(),
+        (const int32_t *) ids->data,
+        (const float *) weights->data,
+        down_scales == nullptr ? nullptr : down_scales->data,
+        (float *) dst->data,
+        (int) nrows, (int) n_ids, (int) n_tokens,
+        dst_row_stride,
+        ids_expert_stride, ids_token_stride,
+        weights->nb[1], weights->nb[2],
+        down_scales == nullptr ? 0 : down_scales->nb[0],
+        down_scales == nullptr ? -1 : (int) down_scales->type,
+        dst->nb[0], dst->nb[1], stream);
+
+    return true;
+}
+catch (sycl::exception const & exc) {
+    std::cerr << exc.what() << "Exception caught at file:" << __FILE__
+              << ", line:" << __LINE__ << std::endl;
+    std::exit(1);
+}
+
+// Alternative backend for GGML_OP_MOE_GEGLU_SELECTED_DOWN_WEIGHTED_SUM:
+// form routed GEGLU rows, keep the tuned per-expert MUL_MAT schedule, then
+// fuse the final route scatter and weighted sum. This avoids the older direct
+// fused GEGLU+down kernel path, which underperformed on Gemma4 verifier rows.
+static bool ggml_sycl_moe_geglu_down_matmul_epilogue(
+        ggml_backend_sycl_context & ctx, ggml_tensor * dst) try {
+    const ggml_tensor * down_exps   = dst->src[0];
+    const ggml_tensor * gate        = dst->src[1];
+    const ggml_tensor * up          = dst->src[2];
+    const ggml_tensor * ids         = dst->src[3];
+    const ggml_tensor * weights     = dst->src[4];
+    const ggml_tensor * down_scales = dst->src[5];
+
+    if (down_exps->type != GGML_TYPE_Q8_0 ||
+            gate->type != GGML_TYPE_F32 ||
+            up->type != GGML_TYPE_F32 ||
+            ids->type != GGML_TYPE_I32 ||
+            weights->type != GGML_TYPE_F32 ||
+            dst->type != GGML_TYPE_F32) {
+        return false;
