+void ggml_compute_forward_moe_selected_softmax_weighted_sum(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_moe_selected_softmax_weighted_sum_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("unsupported type for ggml_compute_forward_moe_selected_softmax_weighted_sum: %s",
+                        ggml_type_name(dst->src[0]->type));
+            }
+    }
+}
