+
+    char * end = nullptr;
+    errno = 0;
+    const float value = std::strtof(env, &end);
+    if (errno != 0 || end == env || *end != '\0' || value < 0.0f) {
+        LOG_WRN("%s: invalid LLAMA_MTP_DRAFT_LOGIT_GAP_MIN='%s'; disabling logit-gap gate\n",
+                __func__, env);
+        return 0.0f;
+    }
+
+    return value;
+}
