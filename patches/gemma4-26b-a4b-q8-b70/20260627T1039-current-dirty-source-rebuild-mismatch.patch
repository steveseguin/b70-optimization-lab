+static inline void argmax_top2_insert(
+        float val, int32_t idx,
+        float & best0_val, int32_t & best0_idx,
+        float & best1_val, int32_t & best1_idx) {
+    if (idx < 0) {
+        return;
+    }
+    if (argmax_pair_better(val, idx, best0_val, best0_idx)) {
+        if (idx != best0_idx) {
+            best1_val = best0_val;
+            best1_idx = best0_idx;
+        }
+        best0_val = val;
+        best0_idx = idx;
+    } else if (idx != best0_idx && argmax_pair_better(val, idx, best1_val, best1_idx)) {
+        best1_val = val;
+        best1_idx = idx;
+    }
