+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, top2 ? 4*b->ne[1] : b->ne[1]);
+    ggml_set_op_params_i32(result, 0, top2 ? 1 : 0);
+
+    result->op     = GGML_OP_MUL_MAT_ARGMAX;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
