+// ggml_compute_forward_moe_selected_softmax
+
+static void ggml_compute_forward_moe_selected_softmax_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * logits = dst->src[0];
+    const ggml_tensor * ids    = dst->src[1];
+
+    GGML_ASSERT(logits->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->ne[0] == dst->ne[1]);
+    GGML_ASSERT(ids->ne[1] == dst->ne[2]);
+    GGML_ASSERT(logits->ne[1] == dst->ne[2]);
+
+    const int64_t n_expert      = logits->ne[0];
+    const int64_t n_expert_used = dst->ne[1];
+    const int64_t n_tokens      = dst->ne[2];
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t dr = (n_tokens + nth - 1) / nth;
+    const int64_t ir0 = dr * ith;
+    const int64_t ir1 = std::min(ir0 + dr, n_tokens);
+
+    for (int64_t token = ir0; token < ir1; ++token) {
+        float max_logit = -INFINITY;
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            const int32_t expert = *(const int32_t *) ((const char *) ids->data +
+                    slot * ids->nb[0] + token * ids->nb[1]);
+            GGML_ASSERT(expert >= 0 && expert < n_expert);
+            const float v = *(const float *) ((const char *) logits->data +
+                    expert * logits->nb[0] + token * logits->nb[1]);
+            max_logit = std::max(max_logit, v);
+        }
+
+        float denom = 0.0f;
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            const int32_t expert = *(const int32_t *) ((const char *) ids->data +
+                    slot * ids->nb[0] + token * ids->nb[1]);
+            const float v = *(const float *) ((const char *) logits->data +
+                    expert * logits->nb[0] + token * logits->nb[1]);
+            denom += expf(v - max_logit);
+        }
+
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            const int32_t expert = *(const int32_t *) ((const char *) ids->data +
+                    slot * ids->nb[0] + token * ids->nb[1]);
+            const float v = *(const float *) ((const char *) logits->data +
+                    expert * logits->nb[0] + token * logits->nb[1]);
+            *(float *) ((char *) dst->data + slot * dst->nb[1] +
+                    token * dst->nb[2]) = expf(v - max_logit) / denom;
+        }
+    }
+}
+
+void ggml_compute_forward_moe_selected_softmax(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_moe_selected_softmax_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("unsupported type for ggml_compute_forward_moe_selected_softmax: %s",
+                        ggml_type_name(dst->src[0]->type));
+            }
+    }
+}
