+// ggml_compute_forward_moe_selected_softmax_weighted_sum
+
+static void ggml_compute_forward_moe_selected_softmax_weighted_sum_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * experts = dst->src[0];
+    const ggml_tensor * logits  = dst->src[1];
+    const ggml_tensor * ids     = dst->src[2];
+
+    GGML_ASSERT(experts->type == GGML_TYPE_F32);
+    GGML_ASSERT(logits->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(experts->ne[0] == dst->ne[0]);
+    GGML_ASSERT(experts->ne[2] == dst->ne[1]);
+    GGML_ASSERT(ids->ne[0] == experts->ne[1]);
+    GGML_ASSERT(ids->ne[1] == experts->ne[2]);
+    GGML_ASSERT(logits->ne[1] == experts->ne[2]);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t n_embd        = dst->ne[0];
+    const int64_t n_tokens      = dst->ne[1];
+    const int64_t n_expert      = logits->ne[0];
+    const int64_t n_expert_used = experts->ne[1];
+    const int64_t n_outputs     = n_embd * n_tokens;
+
+    for (int64_t idx = ith; idx < n_outputs; idx += nth) {
+        const int64_t row   = idx % n_embd;
+        const int64_t token = idx / n_embd;
+
+        float max_logit = -INFINITY;
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            const int32_t expert = *(const int32_t *) ((const char *) ids->data +
+                    slot * ids->nb[0] + token * ids->nb[1]);
+            GGML_ASSERT(expert >= 0 && expert < n_expert);
+            const float v = *(const float *) ((const char *) logits->data +
+                    expert * logits->nb[0] + token * logits->nb[1]);
+            max_logit = std::max(max_logit, v);
+        }
+
+        float denom = 0.0f;
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            const int32_t expert = *(const int32_t *) ((const char *) ids->data +
+                    slot * ids->nb[0] + token * ids->nb[1]);
+            const float v = *(const float *) ((const char *) logits->data +
+                    expert * logits->nb[0] + token * logits->nb[1]);
+            denom += expf(v - max_logit);
+        }
+
+        float sum = 0.0f;
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            const int32_t expert = *(const int32_t *) ((const char *) ids->data +
+                    slot * ids->nb[0] + token * ids->nb[1]);
+            const float logit = *(const float *) ((const char *) logits->data +
+                    expert * logits->nb[0] + token * logits->nb[1]);
+            const float weight = expf(logit - max_logit) / denom;
+            const float v = *(const float *) ((const char *) experts->data +
+                    row * experts->nb[0] + slot * experts->nb[1] +
+                    token * experts->nb[2]);
+            sum += v * weight;
+        }
+
+        *(float *) ((char *) dst->data + row * dst->nb[0] +
+                token * dst->nb[1]) = sum;
+    }
+}
