+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void mul_mat_vec_q_argmax_multi_sycl(
+        const void * vx, const void * vy,
+        float * scratch_vals, int32_t * scratch_idxs,
+        const int ncols, const int nrows, const int nvec,
+        const int src1_padded_cols, const int scratch_count_per_vec,
+        dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % qk == 0);
+    constexpr size_t num_subgroups = WARP_SIZE;
+    const int block_num_y = scratch_count_per_vec;
+    const sycl::range<3> block_nums(1, 1, block_num_y * nvec);
+    const sycl::range<3> block_dims(1, 1, num_subgroups * WARP_SIZE);
