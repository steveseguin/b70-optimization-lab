+// ggml_compute_forward_moe_router_selected_weights
+
+static void ggml_compute_forward_moe_router_selected_weights_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+    const ggml_tensor * logits = dst->src[0];
+
+    GGML_ASSERT(logits->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->ne[2] == 2);
+    GGML_ASSERT(logits->ne[1] == dst->ne[1]);
+
+    const int64_t n_expert      = logits->ne[0];
+    const int64_t n_expert_used = dst->ne[0];
+    const int64_t n_tokens      = dst->ne[1];
+
+    GGML_ASSERT(n_expert_used > 0);
+    GGML_ASSERT(n_expert_used <= n_expert);
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t dr = (n_tokens + nth - 1) / nth;
+    const int64_t ir0 = dr * ith;
+    const int64_t ir1 = std::min(ir0 + dr, n_tokens);
+
+    for (int64_t token = ir0; token < ir1; ++token) {
+        float top_vals[32];
+        int32_t top_ids[32];
+
+        GGML_ASSERT(n_expert_used <= 32);
+
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            top_vals[slot] = -INFINITY;
+            top_ids[slot] = -1;
+        }
+
+        for (int64_t expert = 0; expert < n_expert; ++expert) {
+            const float v = *(const float *) ((const char *) logits->data +
+                    expert * logits->nb[0] + token * logits->nb[1]);
+            if (v > top_vals[n_expert_used - 1]) {
+                int64_t pos = n_expert_used - 1;
+                while (pos > 0 && v > top_vals[pos - 1]) {
+                    --pos;
+                }
+                for (int64_t slot = n_expert_used - 1; slot > pos; --slot) {
+                    top_vals[slot] = top_vals[slot - 1];
+                    top_ids[slot] = top_ids[slot - 1];
+                }
+                top_vals[pos] = v;
+                top_ids[pos] = (int32_t) expert;
+            }
+        }
+
+        const float max_logit = top_vals[0];
+        float denom = 0.0f;
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            denom += expf(top_vals[slot] - max_logit);
+        }
+
+        for (int64_t slot = 0; slot < n_expert_used; ++slot) {
+            *(float *) ((char *) dst->data +
+                    slot * dst->nb[0] + token * dst->nb[1]) =
+                expf(top_vals[slot] - max_logit) / denom;
+            *(float *) ((char *) dst->data +
+                    slot * dst->nb[0] + token * dst->nb[1] + dst->nb[2]) =
+                (float) top_ids[slot];
+        }
+    }
+}
+
+void ggml_compute_forward_moe_router_selected_weights(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_moe_router_selected_weights_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("unsupported type for ggml_compute_forward_moe_router_selected_weights: %s",
+                        ggml_type_name(dst->src[0]->type));
+            }
+    }
+}
