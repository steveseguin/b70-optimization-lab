+
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_argmax_multi_tile<qk, qi, block_q_t, vdr, vec_dot_q_sycl>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, src1_padded_cols,
+                    scratch_count_per_vec, tile_vals, tile_idxs, item_ct1);
+            });
+    });
