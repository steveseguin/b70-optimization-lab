+    const bool grouped_q8_0_enabled =
+        ggml_sycl_mul_mat_id_multi_token_grouped_q8_0_enabled();
+    if (!direct_fast_enabled && !grouped_q8_0_enabled) {
+        return false;
+    }
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * ids  = dst->src[2];
+    if (src0 == nullptr || src1 == nullptr || ids == nullptr) {
+        return false;
+    }
+
+    if (grouped_q8_0_enabled && src0->type == GGML_TYPE_Q8_0) {
+        const ggml_tensor_extra_gpu * src0_extra =
+            static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+        if (src0_extra && src0_extra->optimized_feature.reorder) {
+            return false;
+        }
+    } else {
+        if (!direct_fast_enabled) {
+            return false;
+        }
+        switch (src0->type) {
+            case GGML_TYPE_Q4_0:
+            case GGML_TYPE_Q4_1:
+            case GGML_TYPE_Q5_0:
+            case GGML_TYPE_Q5_1:
+            case GGML_TYPE_Q8_0:
+            case GGML_TYPE_Q2_K:
+            case GGML_TYPE_Q3_K:
+            case GGML_TYPE_Q4_K:
+            case GGML_TYPE_Q5_K:
+            case GGML_TYPE_Q6_K:
+            case GGML_TYPE_MXFP4:
+            case GGML_TYPE_NVFP4:
+                break;
+            default:
+                return false;
+        }
+    }
+
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne12 = src1->ne[2];
+    if (ne12 <= 1 || ne12 > 8) {
+        return false;
+    }
+    if (grouped_q8_0_enabled && src0->type == GGML_TYPE_Q8_0) {
+        if (ids->ne[0] > 8 || (ne11 != 1 && ne11 != ids->ne[0])) {
+            return false;
+        }
+    } else if (ne11 != 1) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (ne10 != src0->ne[0] || ne10 % QK8_1 != 0) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src1)) {
+        return false;
+    }
+    if (ids->type != GGML_TYPE_I32 || ids->ne[1] != ne12) {
+        return false;
+    }
+    if (ids->nb[0] % sizeof(int32_t) != 0 ||
+        ids->nb[1] % sizeof(int32_t) != 0) {
+        return false;
+    }
+    if (dst->ne[0] != src0->ne[1] || dst->ne[1] != ids->ne[0] ||
+        dst->ne[2] != ne12 || dst->nb[0] != sizeof(float) ||
+        dst->nb[1] % sizeof(float) != 0 ||
+        dst->nb[2] % sizeof(float) != 0) {
+        return false;
+    }
+
+    return true;
+}
