+    if (ne10 != src0->ne[0] || ne10 % QK8_1 != 0) return false;
+    if (!ggml_is_contiguous(src1)) return false;
+    if (ids->type != GGML_TYPE_I32) return false;
+    if (ids->ne[1] != ne12) return false;
+    if (ids->nb[0] % sizeof(int32_t) != 0 ||
+        ids->nb[1] % sizeof(int32_t) != 0) {
+        return false;
+    }
+    if (dst->ne[0] != src0->ne[1] || dst->ne[1] != ids->ne[0] ||
+        dst->ne[2] != ne12 || dst->nb[0] != sizeof(float) ||
+        dst->nb[1] % sizeof(float) != 0 ||
+        dst->nb[2] % sizeof(float) != 0) {
