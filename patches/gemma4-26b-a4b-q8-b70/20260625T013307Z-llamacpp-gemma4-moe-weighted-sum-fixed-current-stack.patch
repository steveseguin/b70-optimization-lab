+// ggml_compute_forward_argmax_softcap
+
+static void ggml_compute_forward_argmax_softcap_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    if (params->ith != 0) {
+        return;
+    }
+
+    assert(src0->nb[0] == sizeof(float));
+    assert(dst->nb[0] == sizeof(int32_t));
+
+    const float softcap = ggml_get_op_params_f32(dst, 0);
+    GGML_ASSERT(softcap > 0.0f);
+
+    const int64_t ne00 = src0->ne[0];
+    const int64_t ne01 = src0->ne[1];
+
+    const size_t nb01 = src0->nb[1];
+    const size_t nb0 = dst->nb[0];
+
+    for (int64_t i1 = 0; i1 < ne01; i1++) {
+        const float * src = (const float *) ((const char *) src0->data + i1*nb01);
+        int32_t * dst_ = (int32_t *) ((char *) dst->data + i1*nb0);
+
+        float max_val = -INFINITY;
+        int32_t max_idx = 0;
+        for (int64_t i0 = 0; i0 < ne00; i0++) {
+            const float val = softcap * tanhf(src[i0] / softcap);
+            if (val > max_val) {
+                max_val = val;
+                max_idx = (int32_t) i0;
+            }
+        }
+        dst_[0] = max_idx;
+    }
+}
+
+void ggml_compute_forward_argmax_softcap(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    switch (src0->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_argmax_softcap_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
