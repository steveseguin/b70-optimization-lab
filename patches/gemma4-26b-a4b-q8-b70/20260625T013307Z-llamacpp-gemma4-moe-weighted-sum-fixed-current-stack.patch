+            (const float *) src1->data, src1_ddq, (int) ne10,
+            n_tokens * (int) ne11, src1_padded_cols, stream);
+
+        const size_t bytes_per_qrow =
+            (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+        const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+        const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+
+        return ggml_sycl_mul_mat_vec_q_id_multi_token_grouped_q8_0(
+            src0->data, src1_ddq, (const int32_t *) ids->data,
+            (float *) dst->data, (int) ne10, nrows, n_experts_used, n_tokens,
+            /*expert_weight_stride=*/ src0->nb[2],
+            /*dst_row_stride=*/ dst->nb[1],
+            /*dst_token_stride=*/ dst->nb[2],
+            /*src1_row_stride=*/ bytes_per_qrow,
+            /*src1_rows_per_token=*/ (int) ne11,
+            ids_expert_stride, ids_token_stride, stream);
+    }
+
+    if (ne11 != 1) return false;
+    if (!direct_fast_enabled) return false;
+
+    opt_for_reorder_id(&ctx, src0);
+    const ggml_tensor_extra_gpu * src0_extra =
+        static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    const bool use_reorder = src0_extra &&
+        src0_extra->optimized_feature.reorder &&
+        !ggml_sycl_mul_mat_id_multi_token_no_reorder_enabled();
+
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+        (size_t) n_tokens * src1_padded_cols * sizeof(block_q8_1) / QK8_1);
+    char * src1_ddq = src1_q8_alloc.get();
+    if (use_reorder) {
+        quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+            (const float *) src1->data, src1_ddq, (int) ne10, n_tokens,
+            src1_padded_cols, stream);
+    } else {
+        quantize_row_q8_1_sycl<quantize_q8_1>(
+            (const float *) src1->data, src1_ddq, (int) ne10, n_tokens,
+            src1_padded_cols, stream);
+    }
+
+    const size_t bytes_per_qrow = (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+    const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+    const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+
+    if (use_reorder) {
+        return ggml_sycl_mul_mat_vec_q_id_multi_token_reorder(
+            src0->type, src0->data, src1_ddq, (const int32_t *) ids->data,
+            (float *) dst->data, (int) ne10, nrows, n_experts_used, n_tokens,
+            /*expert_weight_stride=*/ src0->nb[2],
+            /*dst_row_stride=*/ dst->nb[1],
+            /*dst_token_stride=*/ dst->nb[2],
+            /*src1_token_stride=*/ bytes_per_qrow,
+            ids_expert_stride, ids_token_stride, stream);
+    }
