+    return env && (std::strcmp(env, "1") == 0 ||
+                   std::strcmp(env, "true") == 0 ||
+                   std::strcmp(env, "TRUE") == 0 ||
+                   std::strcmp(env, "yes") == 0 ||
+                   std::strcmp(env, "on") == 0);
+}
+
+static bool ggml_sycl_mul_mat_id_multi_token_grouped_q8_0_enabled() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_MULTI_TOKEN_GROUPED_Q8_0");
+    return env && (std::strcmp(env, "1") == 0 ||
+                   std::strcmp(env, "true") == 0 ||
+                   std::strcmp(env, "TRUE") == 0 ||
+                   std::strcmp(env, "yes") == 0 ||
