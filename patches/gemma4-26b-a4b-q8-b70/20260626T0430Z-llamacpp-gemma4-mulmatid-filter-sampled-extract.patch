+                   std::strcmp(env, "true") == 0 ||
+                   std::strcmp(env, "TRUE") == 0 ||
+                   std::strcmp(env, "yes") == 0 ||
+                   std::strcmp(env, "on") == 0);
+}
+
+static bool ggml_sycl_mul_mat_id_multi_token_no_reorder_enabled() {
