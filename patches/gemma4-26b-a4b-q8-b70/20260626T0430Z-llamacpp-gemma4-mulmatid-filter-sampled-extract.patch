+static bool ggml_sycl_mul_mat_id_route_profile_enabled() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_ROUTE_PROFILE");
+    return env && (std::strcmp(env, "1") == 0 ||
+                   std::strcmp(env, "true") == 0 ||
+                   std::strcmp(env, "TRUE") == 0 ||
+                   std::strcmp(env, "yes") == 0 ||
+                   std::strcmp(env, "on") == 0);
+}
+
+static int64_t ggml_sycl_mul_mat_id_route_profile_every() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_ROUTE_PROFILE_EVERY");
+    if (!env || env[0] == '\0') {
+        return 250;
+    }
+    char * end = nullptr;
+    const long value = std::strtol(env, &end, 10);
+    return end != env && value > 0 ? value : 250;
+}
