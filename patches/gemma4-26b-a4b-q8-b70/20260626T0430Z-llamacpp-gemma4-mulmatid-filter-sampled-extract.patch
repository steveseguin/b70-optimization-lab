+// Fused small multi-token MoE verifier path. This covers the Gemma target
+// verifier shape produced by draft-MTP: src1=[ncols,1,n_tokens],
+// ids=[n_experts_used,n_tokens], n_tokens<=8. It avoids the generic
+// MUL_MAT_ID path below, which copies ids to host, sorts routed rows, gathers
+// src1, runs one matmul per used expert, and scatters the output.
+static bool ggml_sycl_mul_mat_id_mmvq_multi_token_fused(
+    ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+    const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst)
+{
+    const bool direct_fast_enabled =
+        ggml_sycl_mul_mat_id_multi_token_fast_enabled();
+    const bool grouped_q8_0_enabled =
+        ggml_sycl_mul_mat_id_multi_token_grouped_q8_0_enabled();
+    if (!direct_fast_enabled && !grouped_q8_0_enabled) return false;
+    if (!ggml_sycl_mul_mat_id_multi_token_filter_allows(dst)) return false;
+
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne12 = src1->ne[2];
+    if (ne12 <= 1 || ne12 > 8) return false;
+    if (ne11 != 1 && ne11 != ids->ne[0]) return false;
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (ne10 != src0->ne[0] || ne10 % QK8_1 != 0) return false;
+    if (!ggml_is_contiguous(src1)) return false;
+    if (ids->type != GGML_TYPE_I32) return false;
+    if (ids->ne[1] != ne12) return false;
+    if (ids->nb[0] % sizeof(int32_t) != 0 ||
+        ids->nb[1] % sizeof(int32_t) != 0) {
+        return false;
+    }
+    if (dst->ne[0] != src0->ne[1] || dst->ne[1] != ids->ne[0] ||
+        dst->ne[2] != ne12 || dst->nb[0] != sizeof(float) ||
+        dst->nb[1] % sizeof(float) != 0 ||
+        dst->nb[2] % sizeof(float) != 0) {
+        return false;
+    }
+
+    const queue_ptr stream           = ctx.stream();
+    const int       src1_padded_cols = GGML_PAD((int) ne10, MATRIX_ROW_PADDING);
+    const int       n_experts_used   = (int) ids->ne[0];
+    const int       nrows            = (int) src0->ne[1];
+    const int       n_tokens         = (int) ne12;
+
+    if (grouped_q8_0_enabled &&
+        src0->type == GGML_TYPE_Q8_0 &&
+        n_experts_used <= 8 &&
+        (ne11 == 1 || ne11 == n_experts_used)) {
+        const ggml_tensor_extra_gpu * src0_extra =
+            static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+        if (src0_extra && src0_extra->optimized_feature.reorder) {
+            return false;
+        }
+
+        ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+            (size_t) n_tokens * (size_t) ne11 * src1_padded_cols *
+                sizeof(block_q8_1) / QK8_1);
+        char * src1_ddq = src1_q8_alloc.get();
+        quantize_row_q8_1_sycl<quantize_q8_1>(
+            (const float *) src1->data, src1_ddq, (int) ne10,
+            n_tokens * (int) ne11, src1_padded_cols, stream);
+
+        const size_t bytes_per_qrow =
+            (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+        const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+        const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+
+        return ggml_sycl_mul_mat_vec_q_id_multi_token_grouped_q8_0(
+            src0->data, src1_ddq, (const int32_t *) ids->data,
+            (float *) dst->data, (int) ne10, nrows, n_experts_used, n_tokens,
+            /*expert_weight_stride=*/ src0->nb[2],
+            /*dst_row_stride=*/ dst->nb[1],
+            /*dst_token_stride=*/ dst->nb[2],
+            /*src1_row_stride=*/ bytes_per_qrow,
+            /*src1_rows_per_token=*/ (int) ne11,
+            ids_expert_stride, ids_token_stride, stream);
+    }
+
+    if (ne11 != 1) return false;
+    if (!direct_fast_enabled) return false;
+
+    opt_for_reorder_id(&ctx, src0);
+    const ggml_tensor_extra_gpu * src0_extra =
+        static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+    const bool use_reorder = src0_extra &&
+        src0_extra->optimized_feature.reorder &&
+        !ggml_sycl_mul_mat_id_multi_token_no_reorder_enabled();
+
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+        (size_t) n_tokens * src1_padded_cols * sizeof(block_q8_1) / QK8_1);
+    char * src1_ddq = src1_q8_alloc.get();
+    if (use_reorder) {
+        quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+            (const float *) src1->data, src1_ddq, (int) ne10, n_tokens,
