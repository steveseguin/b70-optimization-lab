+static void ggml_sycl_moe_weighted_sum(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * experts = dst->src[0];
+    const ggml_tensor * weights = dst->src[1];
+
+    GGML_ASSERT(experts->type == GGML_TYPE_F32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(experts->ne[0] == dst->ne[0]);
+    GGML_ASSERT(experts->ne[1] == weights->ne[1]);
+    GGML_ASSERT(experts->ne[2] == dst->ne[1]);
+    GGML_ASSERT(weights->ne[0] == 1);
+    GGML_ASSERT(weights->ne[2] == dst->ne[1]);
+    GGML_ASSERT(experts->nb[0] == sizeof(float));
+    GGML_ASSERT(weights->nb[0] == sizeof(float));
+    GGML_ASSERT(dst->nb[0] == sizeof(float));
+
+    dpct::queue_ptr main_stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    moe_weighted_sum_f32_sycl(
+        (const float *) experts->data,
+        (const float *) weights->data,
+        (float *) dst->data,
+        (int) dst->ne[0],
+        (int) experts->ne[1],
+        (int) dst->ne[1],
+        experts->nb[0], experts->nb[1], experts->nb[2],
+        weights->nb[1], weights->nb[2],
+        dst->nb[0], dst->nb[1], main_stream);
+}
