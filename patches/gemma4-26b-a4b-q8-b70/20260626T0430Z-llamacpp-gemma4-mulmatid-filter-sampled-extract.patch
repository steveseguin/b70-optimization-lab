+static void moe_selected_down_weighted_sum_q8_0_f32_sycl(
+        const void * down_exps, const float * cur,
+        const int32_t * ids, const float * weights,
+        const void * down_scales, float * dst,
+        const int ncols, const int nrows, const int n_experts_used,
+        const int n_tokens, const size_t expert_weight_stride,
+        const size_t cur_nb1, const size_t cur_nb2,
+        const int ids_expert_stride, const int ids_token_stride,
+        const size_t weights_nb1, const size_t weights_nb2,
+        const size_t down_scales_nb0, const int down_scales_type,
+        const size_t dst_nb0, const size_t dst_nb1, dpct::queue_ptr stream) {
+
+    const int block_num_y = (nrows + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums((unsigned) n_tokens, (unsigned) block_num_y, 1);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, WARP_SIZE);
+
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int token = item.get_group(0);
+                const int row = item.get_group(1) * item.get_local_range(1) +
+                    item.get_local_id(1);
+                if (row >= nrows) {
+                    return;
+                }
+
+                const int blocks_per_row = ncols / QK8_0;
+                const int lane = item.get_local_id(2);
+
+                float tmp = 0.0f;
+                for (int slot = 0; slot < n_experts_used; ++slot) {
+                    const int expert_id = ids[token * ids_token_stride +
+                        slot * ids_expert_stride];
+                    const block_q8_0 * x = (const block_q8_0 *)
+                        ((const char *) down_exps + (size_t) expert_id * expert_weight_stride);
+                    const float * y = (const float *) ((const char *) cur +
+                        (size_t) slot * cur_nb1 + (size_t) token * cur_nb2);
+
+                    float w = *(const float *) ((const char *) weights +
+                        (size_t) slot * weights_nb1 + (size_t) token * weights_nb2);
+                    if (down_scales != nullptr) {
+                        const char * scale_ptr = (const char *) down_scales +
+                            (size_t) expert_id * down_scales_nb0;
+                        if (down_scales_type == GGML_TYPE_F32) {
+                            w *= *(const float *) scale_ptr;
+                        } else {
+                            w *= (float) *(const sycl::half *) scale_ptr;
+                        }
+                    }
+
+                    for (int i = lane; i < blocks_per_row; i += WARP_SIZE) {
+                        const block_q8_0 & xb = x[row * blocks_per_row + i];
+                        const float d = (float) xb.d;
+#pragma unroll
+                        for (int j = 0; j < QK8_0; ++j) {
+                            tmp += w * d * (float) xb.qs[j] *
+                                y[(size_t) i * QK8_0 + (size_t) j];
+                        }
+                    }
+                }
+
+#pragma unroll
+                for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                    tmp += dpct::permute_sub_group_by_xor(item.get_sub_group(), tmp, mask);
+                }
+
+                if (lane == 0) {
+                    *(float *) ((char *) dst + (size_t) row * dst_nb0 +
+                        (size_t) token * dst_nb1) = tmp;
+                }
+            });
+    });
+}
