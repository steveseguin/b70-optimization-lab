+static bool llama_graph_use_swa_fattn_left_bound(
+        const llama_hparams & hparams,
+        const llama_cparams & cparams,
+        const llama_ubatch  & ubatch) {
+    if (!llama_graph_experimental_swa_fattn_left_bound_enabled()) {
+        return false;
+    }
+
+    const auto n_stream = cparams.kv_unified ? 1 : ubatch.n_seqs_unq;
+    const auto n_q_per_stream = n_stream > 0 ? ubatch.n_tokens/n_stream : 0;
+    const auto min_q = llama_graph_experimental_swa_fattn_left_bound_min_q();
+
+    return cparams.flash_attn &&
+        hparams.swa_type == LLAMA_SWA_TYPE_STANDARD &&
+        cparams.causal_attn &&
+        !hparams.use_alibi &&
+        n_stream > 0 &&
+        ubatch.n_tokens % n_stream == 0 &&
+        n_q_per_stream >= min_q;
+}
