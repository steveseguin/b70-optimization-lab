+
+            float   best_val = -3.402823466e+38F;
+            int32_t best_idx = -1;
+            for (int i = tid; i < scratch_count; i += reduce_block) {
+                const float   val = scratch_vals[i];
+                const int32_t idx = scratch_idxs[i];
+                if (argmax_pair_better(val, idx, best_val, best_idx)) {
+                    best_val = val;
+                    best_idx = idx;
+                }
+            }
+
+            vals[tid] = best_val;
+            idxs[tid] = best_idx;
+            item_ct1.barrier(sycl::access::fence_space::local_space);
+
+            for (int stride = reduce_block / 2; stride > 0; stride >>= 1) {
+                if (tid < stride) {
+                    const float   other_val = vals[tid + stride];
+                    const int32_t other_idx = idxs[tid + stride];
+                    if (argmax_pair_better(other_val, other_idx, vals[tid], idxs[tid])) {
+                        vals[tid] = other_val;
+                        idxs[tid] = other_idx;
+                    }
+                }
+                item_ct1.barrier(sycl::access::fence_space::local_space);
+            }
+
+            if (tid == 0) {
+                dst[0] = idxs[0];
+            }
+        });
+    });
+}
+
+bool ggml_sycl_mul_mat_vec_q_argmax(
+        enum ggml_type src0_type,
+        const void * vx,
+        const void * vy,
+        int32_t * dst,
+        int ncols,
+        int nrows,
+        bool reordered,
+        float * scratch_vals,
+        int32_t * scratch_idxs,
+        int scratch_count,
+        dpct::queue_ptr stream) {
+    const int needed_scratch = (int) ceil_div(nrows, WARP_SIZE);
+    if (scratch_count < needed_scratch) {
+        return false;
+    }
+
+    switch (src0_type) {
+        case GGML_TYPE_Q4_0:
+            if (reordered) {
+                reorder_mul_mat_vec_q_argmax_sycl<reorder_vec_dot_q_sycl<GGML_TYPE_Q4_0>>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, stream);
+            } else {
+                mul_mat_vec_q_argmax_sycl<QK4_0, QI4_0, block_q4_0, VDR_Q4_0_Q8_1_MMVQ, vec_dot_q4_0_q8_1>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, stream);
+            }
+            break;
+        case GGML_TYPE_Q8_0:
+            if (reordered) {
+                reorder_mul_mat_vec_q_argmax_sycl<reorder_vec_dot_q_sycl<GGML_TYPE_Q8_0>>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, stream);
+            } else {
+                mul_mat_vec_q_argmax_sycl<QK8_0, QI8_0, block_q8_0, VDR_Q8_0_Q8_1_MMVQ, vec_dot_q8_0_q8_1>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, stream);
+            }
+            break;
+        default:
+            return false;
+    }
+
+    reduce_argmax_tiles_sycl(scratch_vals, scratch_idxs, dst, scratch_count, stream);
+    return true;
+}
