+template <typename reorder_vec_dot_q_sycl>
+static void reorder_mul_mat_vec_q_argmax_sycl(
+        const void * vx, const void * vy,
+        float * scratch_vals, int32_t * scratch_idxs,
+        const int ncols, const int nrows,
+        dpct::queue_ptr stream) {
+    using block_type = ggml_sycl_reordered::block_q_t<reorder_vec_dot_q_sycl::gtype>;
+    GGML_ASSERT(ncols % block_type::traits::qk == 0);
+    constexpr size_t num_subgroups = WARP_SIZE;
+    const int block_num_y = ceil_div(nrows, (int) num_subgroups);
+    const sycl::range<3> block_nums(1, 1, block_num_y);
+    const sycl::range<3> block_dims(1, 1, num_subgroups * WARP_SIZE);
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> tile_vals(sycl::range<1>(num_subgroups), cgh);
+        sycl::local_accessor<int32_t, 1> tile_idxs(sycl::range<1>(num_subgroups), cgh);
+
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_reorder_argmax_tile<reorder_vec_dot_q_sycl>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, tile_vals, tile_idxs, item_ct1);
+            });
+    });
+}
