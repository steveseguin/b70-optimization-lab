+    void finish_speculative_accept_no_bonus(
+            server_slot & slot,
+            std::vector<llama_token> accepted,
+            size_t n_draft) {
+        slot.spec_i_batch.clear();
+
+        GGML_ASSERT(!accepted.empty());
+        GGML_ASSERT(accepted.size() == n_draft);
+
+        if (trace > 0) {
+            SLT_INF(slot, "accepted %2zu/%2zu draft tokens (no bonus row)\n",
+                    accepted.size(), n_draft);
+        }
+
+        const int64_t t_common_accept_start = spec_profile_enabled ? ggml_time_us() : 0;
+        common_speculative_accept(spec.get(), slot.id, (uint16_t) n_draft);
+        if (spec_profile_enabled) {
+            t_spec_common_accept_us += ggml_time_us() - t_common_accept_start;
+            n_spec_common_accept_calls++;
+            spec_profile_dirty = true;
+        }
+
+        slot.spec_draft = std::move(accepted);
+
+        const int64_t t_now = ggml_time_us();
+        const auto ids = std::move(slot.spec_draft);
+
+        slot.t_token_generation = std::max<int64_t>(1, t_now - slot.t_start_generation) / 1e3;
+
+        const size_t n_accepted_draft = ids.size();
+        slot.update_spec_adaptive_mtp(n_draft, n_accepted_draft);
+        slot.n_draft_accepted += n_accepted_draft;
+        slot.n_draft_verif_steps += 1;
+
+        if (slot.n_accepted_per_pos.empty()) {
+            slot.n_accepted_per_pos.resize(common_speculative_n_max(&params_base.speculative), 0);
+        }
+        for (size_t i = 0; i < n_accepted_draft && i < slot.n_accepted_per_pos.size(); ++i) {
+            slot.n_accepted_per_pos[i]++;
+        }
+
+        slot.prompt.tokens.keep_first(slot.prompt.n_tokens() - n_draft);
+        slot.prompt.tokens.insert({ids.begin(), ids.end()});
+
+        slot.sampled = ids.back();
+        SLT_DBG(slot, "add accepted tokens without bonus: sampled=%d, ids.size=%zu, n_draft=%zu\n",
+                slot.sampled, ids.size(), n_draft);
+
+        common_context_seq_rm(slot.ctx_tgt, slot.id, slot.prompt.tokens.pos_next(), -1);
+        if (slot.ctx_dft) {
+            common_context_seq_rm(slot.ctx_dft, slot.id, slot.prompt.tokens.pos_next(), -1);
+        }
+
+        const int64_t t_emit_start = spec_profile_enabled ? ggml_time_us() : 0;
+        for (size_t i = 0; i < ids.size(); ++i) {
+            completion_token_output result;
+
+            result.tok          = ids[i];
+            result.text_to_send = common_token_to_piece(slot.ctx_tgt, result.tok, accept_special_token(slot, result.tok));
+            result.prob         = 1.0f;
+
+            slot.n_decoded += 1;
+
+            if (!process_token(result, slot)) {
+                slot.print_timings();
+                send_final_response(slot);
+                metrics.on_prediction(slot);
+                slot.release();
+
+                return;
+            }
+        }
+        if (spec_profile_enabled) {
+            t_spec_emit_us += ggml_time_us() - t_emit_start;
+            n_spec_emit_calls++;
+            spec_profile_dirty = true;
+        }
+
+        slot.print_timings_tg();
+
+        SLT_DBG(slot, "accepted %d/%d draft tokens without bonus, new n_tokens = %d\n",
+                (int) ids.size(), (int) n_draft, slot.prompt.n_tokens());
+    }
