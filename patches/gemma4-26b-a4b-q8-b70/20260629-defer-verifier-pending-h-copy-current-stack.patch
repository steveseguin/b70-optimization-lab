+        return fallback;
+    }
+
+    char * end = nullptr;
+    const long parsed = std::strtol(value, &end, 10);
+    if (end == value) {
+        return fallback;
+    }
+
+    return (int32_t) parsed;
+}
+
+static double server_env_f64(const char * name, double fallback) {
+    const char * value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return fallback;
+    }
+
+    char * end = nullptr;
+    const double parsed = std::strtod(value, &end);
+    if (end == value) {
+        return fallback;
+    }
+
+    return parsed;
