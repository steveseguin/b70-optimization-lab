+static void ggml_sycl_mul_mat_argmax(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    GGML_ASSERT(dst->type == GGML_TYPE_I32);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->ne[1] >= 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+    GGML_ASSERT(src0->ne[0] == src1->ne[0]);
+    GGML_ASSERT(src0->type == GGML_TYPE_Q4_0 || src0->type == GGML_TYPE_Q8_0);
+    GGML_ASSERT(!ggml_backend_buffer_is_sycl_split(src0->buffer));
+    GGML_ASSERT(ggml_is_contiguous(src1));
+
+    opt_for_reorder(&ctx, src0, src1, dst, mul_mat_algo::MMVQ);
+
+    const int64_t ne10 = src1->ne[0];
+    const int64_t nvec = src1->ne[1];
+    const int64_t nrows = src0->ne[1];
+    const int src1_padded_cols = GGML_PAD((int) ne10, MATRIX_ROW_PADDING);
+
+    ggml_tensor_extra_gpu * extra = static_cast<ggml_tensor_extra_gpu *>(src0->extra);
+    const bool use_reorder = extra && extra->optimized_feature.reorder;
+
+    queue_ptr stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+        (size_t) nvec * (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1);
+    char * src1_ddq = src1_q8_alloc.get();
+
+    if (use_reorder) {
+        quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+            (const float *) src1->data, src1_ddq, (int) ne10, (int) nvec,
+            src1_padded_cols, stream);
+    } else {
+        quantize_row_q8_1_sycl<quantize_q8_1>(
+            (const float *) src1->data, src1_ddq, (int) ne10, (int) nvec,
+            src1_padded_cols, stream);
+    }
+
+    const int scratch_count_per_vec = ceil_div((int) nrows, WARP_SIZE);
+    ggml_sycl_pool_alloc<float> scratch_vals_alloc(ctx.pool(), scratch_count_per_vec * (size_t) nvec);
+    ggml_sycl_pool_alloc<int32_t> scratch_idxs_alloc(ctx.pool(), scratch_count_per_vec * (size_t) nvec);
+
+    const bool ok = nvec == 1 ?
+        ggml_sycl_mul_mat_vec_q_argmax(
+            src0->type, src0->data, src1_ddq, (int32_t *) dst->data,
+            (int) ne10, (int) nrows, use_reorder,
+            scratch_vals_alloc.get(), scratch_idxs_alloc.get(), scratch_count_per_vec,
+            stream) :
+        ggml_sycl_mul_mat_vec_q_argmax_multi(
+            src0->type, src0->data, src1_ddq, (int32_t *) dst->data,
+            (int) ne10, (int) nrows, (int) nvec, src1_padded_cols, use_reorder,
+            scratch_vals_alloc.get(), scratch_idxs_alloc.get(), scratch_count_per_vec,
+            stream);
+    GGML_ASSERT(ok);
+}
