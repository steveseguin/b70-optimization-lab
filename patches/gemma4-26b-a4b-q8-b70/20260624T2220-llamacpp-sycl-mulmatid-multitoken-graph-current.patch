+static bool ggml_sycl_mul_mat_id_multi_token_fast_enabled() {
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_MULTI_TOKEN_FAST");
+    return env && (std::strcmp(env, "1") == 0 ||
+                   std::strcmp(env, "true") == 0 ||
