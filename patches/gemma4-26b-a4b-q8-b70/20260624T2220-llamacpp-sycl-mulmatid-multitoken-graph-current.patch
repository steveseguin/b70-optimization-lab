+            [=](sycl::nd_item<3> item_ct1) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q_argmax_tile<qk, qi, block_q_t, vdr, vec_dot_q_sycl>(
