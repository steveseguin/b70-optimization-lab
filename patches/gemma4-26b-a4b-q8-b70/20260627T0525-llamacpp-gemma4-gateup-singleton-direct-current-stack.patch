+                const int token = item.get_group(0);
+                const int row = item.get_group(1) * item.get_local_range(1) +
+                    item.get_local_id(1);
+                if (row >= nrows) {
+                    return;
+                }
+
+                const int blocks_per_row = ncols / QK8_0;
+                const int lane = item.get_local_id(2);
+
+                float tmp = 0.0f;
+                for (int slot = 0; slot < n_experts_used; ++slot) {
+                    const int expert_id = ids[token * ids_token_stride +
+                        slot * ids_expert_stride];
+                    const block_q8_0 * x = (const block_q8_0 *)
+                        ((const char *) down_exps + (size_t) expert_id * expert_weight_stride);
+                    const float * y = (const float *) ((const char *) cur +
+                        (size_t) slot * cur_nb1 + (size_t) token * cur_nb2);
+
+                    float w = *(const float *) ((const char *) weights +
+                        (size_t) slot * weights_nb1 + (size_t) token * weights_nb2);
+                    if (down_scales != nullptr) {
+                        const char * scale_ptr = (const char *) down_scales +
+                            (size_t) expert_id * down_scales_nb0;
+                        if (down_scales_type == GGML_TYPE_F32) {
+                            w *= *(const float *) scale_ptr;
+                        } else {
+                            w *= (float) *(const sycl::half *) scale_ptr;
+                        }
+                    }
+
+                    for (int i = lane; i < blocks_per_row; i += WARP_SIZE) {
+                        const block_q8_0 & xb = x[row * blocks_per_row + i];
+                        const float d = (float) xb.d;
+#pragma unroll
+                        for (int j = 0; j < QK8_0; ++j) {
+                            tmp += w * d * (float) xb.qs[j] *
+                                y[(size_t) i * QK8_0 + (size_t) j];
+                        }
+                    }
+                }
+
+#pragma unroll
+                for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                    tmp += dpct::permute_sub_group_by_xor(item.get_sub_group(), tmp, mask);
+                }
+
+                if (lane == 0) {
+                    *(float *) ((char *) dst + (size_t) row * dst_nb0 +
+                        (size_t) token * dst_nb1) = tmp;
+                }
+            });
+    });
+}
+
+static void moe_selected_down_weighted_sum_q8_0_f32_parallel_slots_sycl(
+        const void * down_exps, const float * cur,
+        const int32_t * ids, const float * weights,
+        const void * down_scales, float * dst,
+        const int ncols, const int nrows, const int n_experts_used,
+        const int n_tokens, const size_t expert_weight_stride,
+        const size_t cur_nb1, const size_t cur_nb2,
+        const int ids_expert_stride, const int ids_token_stride,
+        const size_t weights_nb1, const size_t weights_nb2,
+        const size_t down_scales_nb0, const int down_scales_type,
+        const size_t dst_nb0, const size_t dst_nb1, dpct::queue_ptr stream) {
+
+    const int block_num_y = (nrows + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums((unsigned) n_tokens, (unsigned) block_num_y, 1);
+    const sycl::range<3> block_dims((unsigned) n_experts_used, GGML_SYCL_MMV_Y, WARP_SIZE);
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> slot_sums(
+            sycl::range<1>((size_t) n_experts_used * GGML_SYCL_MMV_Y), cgh);
+
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int token = item.get_group(0);
+                const int slot = item.get_local_id(0);
+                const int row_local = item.get_local_id(1);
+                const int row = item.get_group(1) * item.get_local_range(1) + row_local;
+                const int lane = item.get_local_id(2);
+
+                const int blocks_per_row = ncols / QK8_0;
+
+                float tmp = 0.0f;
+                if (row < nrows) {
+                    const int expert_id = ids[token * ids_token_stride +
+                        slot * ids_expert_stride];
+                    const block_q8_0 * x = (const block_q8_0 *)
+                        ((const char *) down_exps + (size_t) expert_id * expert_weight_stride);
+                    const float * y = (const float *) ((const char *) cur +
+                        (size_t) slot * cur_nb1 + (size_t) token * cur_nb2);
+
+                    float w = *(const float *) ((const char *) weights +
+                        (size_t) slot * weights_nb1 + (size_t) token * weights_nb2);
+                    if (down_scales != nullptr) {
+                        const char * scale_ptr = (const char *) down_scales +
+                            (size_t) expert_id * down_scales_nb0;
+                        if (down_scales_type == GGML_TYPE_F32) {
+                            w *= *(const float *) scale_ptr;
+                        } else {
+                            w *= (float) *(const sycl::half *) scale_ptr;
+                        }
+                    }
+
+                    for (int i = lane; i < blocks_per_row; i += WARP_SIZE) {
+                        const block_q8_0 & xb = x[row * blocks_per_row + i];
+                        const float d = (float) xb.d;
+#pragma unroll
+                        for (int j = 0; j < QK8_0; ++j) {
+                            tmp += w * d * (float) xb.qs[j] *
+                                y[(size_t) i * QK8_0 + (size_t) j];
+                        }
+                    }
+                }
+
+#pragma unroll
+                for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                    tmp += dpct::permute_sub_group_by_xor(item.get_sub_group(), tmp, mask);
+                }
+
+                if (lane == 0) {
+                    slot_sums[(size_t) row_local * (size_t) n_experts_used + (size_t) slot] = tmp;
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+
+                if (slot == 0 && lane == 0 && row < nrows) {
+                    float sum = 0.0f;
+                    for (int s = 0; s < n_experts_used; ++s) {
+                        sum += slot_sums[(size_t) row_local * (size_t) n_experts_used + (size_t) s];
+                    }
+                    *(float *) ((char *) dst + (size_t) row * dst_nb0 +
+                        (size_t) token * dst_nb1) = sum;
+                }
+            });
+    });
+}
+
+static __dpct_inline__ float ggml_sycl_gemma4_geglu_f32(float x, float up) {
+    const float gelu_coef_a = 0.044715f;
+    const float sqrt_2_over_pi = 0.79788456080286535587989211986876f;
+    const float x2 = x * x;
+    const float gelu = 0.5f * x *
+        (1.0f + sycl::tanh(sqrt_2_over_pi * x * (1.0f + gelu_coef_a * x2)));
+    return gelu * up;
+}
+
+static void moe_geglu_quantize_row_q8_1_sycl(
+        const float * gate, const float * up, block_q8_1 * cur_q8,
+        const int ncols, const int n_experts_used, const int n_tokens,
+        const size_t gate_nb1, const size_t gate_nb2,
+        const size_t up_nb1, const size_t up_nb2,
+        const size_t cur_q8_row_stride, dpct::queue_ptr stream) {
+    static_assert(QK8_1 % WARP_SIZE == 0);
+    constexpr int elems_per_wi = QK8_1 / WARP_SIZE;
+    const int blocks_per_row = ncols / QK8_1;
+    const int total_rows = n_tokens * n_experts_used;
+    const size_t global_range = (size_t) total_rows * (size_t) blocks_per_row * WARP_SIZE;
+
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(global_range), sycl::range<1>(WARP_SIZE)),
+        [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const int subgroup_id = (int) it.get_group(0);
+            const int lane = (int) it.get_local_id(0);
+            const int row = subgroup_id / blocks_per_row;
+            const int block = subgroup_id % blocks_per_row;
+            const int token = row / n_experts_used;
+            const int slot = row - token * n_experts_used;
+            const float * gate_row = (const float *) ((const char *) gate +
+                (size_t) slot * gate_nb1 + (size_t) token * gate_nb2);
+            const float * up_row = (const float *) ((const char *) up +
+                (size_t) slot * up_nb1 + (size_t) token * up_nb2);
+
+            float vals[elems_per_wi];
+            float sum = 0.0f;
+            float amax = 0.0f;
+#pragma unroll
+            for (int e = 0; e < elems_per_wi; ++e) {
+                const int col = block * QK8_1 + lane * elems_per_wi + e;
+                const float v = ggml_sycl_gemma4_geglu_f32(gate_row[col], up_row[col]);
+                vals[e] = v;
+                sum += v;
+                amax = sycl::fmax(amax, sycl::fabs(v));
+            }
+
+            sum = sycl::reduce_over_group(it.get_sub_group(), sum, sycl::plus<float>());
+            amax = sycl::reduce_over_group(it.get_sub_group(), amax, sycl::maximum<float>());
+            float d = amax == 0.0f ? 1.0f : amax / 127.0f;
+
+            block_q8_1 * qrow = (block_q8_1 *) ((char *) cur_q8 +
+                (size_t) row * cur_q8_row_stride);
+            block_q8_1 & qblock = qrow[block];
+#pragma unroll
+            for (int e = 0; e < elems_per_wi; ++e) {
+                qblock.qs[lane * elems_per_wi + e] = (int8_t) sycl::round(vals[e] / d);
+            }
+            if (lane == 0) {
+                qblock.ds = sycl::half2(sycl::half(amax == 0.0f ? 0.0f : d),
+                                        sycl::half(sum));
+            }
+        });
+}
+
+static void ggml_sycl_moe_geglu_selected_down_weighted_sum(
+        ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * down_exps = dst->src[0];
+    const ggml_tensor * gate      = dst->src[1];
+    const ggml_tensor * up        = dst->src[2];
+    const ggml_tensor * ids       = dst->src[3];
+    const ggml_tensor * weights   = dst->src[4];
+    const ggml_tensor * down_scales = dst->src[5];
+
+    GGML_ASSERT(down_exps->type == GGML_TYPE_Q8_0);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32);
+    GGML_ASSERT(up->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(down_scales == nullptr ||
+            down_scales->type == GGML_TYPE_F32 ||
+            down_scales->type == GGML_TYPE_F16);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    dpct::queue_ptr main_stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const int ncols = (int) gate->ne[0];
+    const int n_experts_used = (int) ids->ne[0];
+    const int n_tokens = (int) ids->ne[1];
+    const int nrows = (int) dst->ne[0];
+    const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+    const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+
+    if (ggml_sycl_moe_geglu_down_matmul_epilogue_enabled() &&
+            ggml_sycl_moe_geglu_down_matmul_epilogue(ctx, dst)) {
+        return;
+    }
+
+    const int src1_padded_cols = GGML_PAD(ncols, MATRIX_ROW_PADDING);
+    ggml_sycl_pool_alloc<char> cur_q8_alloc(ctx.pool(),
+        (size_t) n_tokens * (size_t) n_experts_used *
+            (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1);
+    char * cur_q8 = cur_q8_alloc.get();
+    const size_t cur_q8_row_stride =
+        (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+
+    moe_geglu_quantize_row_q8_1_sycl(
+        (const float *) gate->data, (const float *) up->data,
+        (block_q8_1 *) cur_q8, ncols, n_experts_used, n_tokens,
+        gate->nb[1], gate->nb[2], up->nb[1], up->nb[2],
+        cur_q8_row_stride, main_stream);
+
+    moe_selected_down_weighted_sum_q8_0_sycl(
+        down_exps->data, (const block_q8_1 *) cur_q8,
+        (const int32_t *) ids->data, (const float *) weights->data,
+        down_scales == nullptr ? nullptr : down_scales->data,
+        (float *) dst->data, ncols, nrows, n_experts_used, n_tokens,
+        down_exps->nb[2], cur_q8_row_stride, ids_expert_stride,
+        ids_token_stride, weights->nb[1], weights->nb[2],
+        down_scales == nullptr ? 0 : down_scales->nb[0],
+        down_scales == nullptr ? -1 : (int) down_scales->type,
+        dst->nb[0], dst->nb[1], main_stream);
+}
+
+static void moe_q8_0_gateup_geglu_sycl(
+        const void * gate_up_exps, const block_q8_1 * cur_q8,
+        const int32_t * ids, const void * gate_up_scales, float * dst,
+        const int ncols, const int n_ff, const int n_experts_used,
+        const int n_tokens, const size_t expert_weight_stride,
+        const size_t weight_row_stride, const size_t cur_q8_row_stride,
+        const int ids_expert_stride, const int ids_token_stride,
+        const size_t gate_up_scales_nb0, const int gate_up_scales_type,
+        const size_t dst_nb0, const size_t dst_nb1, const size_t dst_nb2,
+        dpct::queue_ptr stream) {
+
+    const int block_num_y = (n_ff + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums((unsigned) n_tokens, (unsigned) block_num_y,
+        (unsigned) n_experts_used);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, WARP_SIZE);
+
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int token = item.get_group(0);
+                const int slot = item.get_group(2);
+                const int row = item.get_group(1) * item.get_local_range(1) +
+                    item.get_local_id(1);
+                if (row >= n_ff) {
+                    return;
+                }
+
+                const int expert_id = ids[token * ids_token_stride +
+                    slot * ids_expert_stride];
+                const char * expert_base = (const char *) gate_up_exps +
+                    (size_t) expert_id * expert_weight_stride;
+                const block_q8_0 * gate_row = (const block_q8_0 *)
+                    (expert_base + (size_t) row * weight_row_stride);
+                const block_q8_0 * up_row = (const block_q8_0 *)
+                    (expert_base + (size_t) (row + n_ff) * weight_row_stride);
+                const block_q8_1 * y = (const block_q8_1 *)
+                    ((const char *) cur_q8 + (size_t) token * cur_q8_row_stride);
+
+                const int blocks_per_row = ncols / QK8_0;
+                constexpr int blocks_per_warp =
+                    (VDR_Q8_0_Q8_1_MMVQ * WARP_SIZE + QI8_0 - 1) / QI8_0;
+
+                float gate = 0.0f;
+                float up = 0.0f;
+                const int lane = item.get_local_id(2);
+                for (int i = lane / (QI8_0 / VDR_Q8_0_Q8_1_MMVQ);
+                     i < blocks_per_row; i += blocks_per_warp) {
+                    for (size_t elem = 0; elem < QI8_0 / VDR_Q8_0_Q8_1_MMVQ;
+                         elem += WARP_SIZE) {
+                        const int iqs = elem + VDR_Q8_0_Q8_1_MMVQ *
+                            (lane % (QI8_0 / VDR_Q8_0_Q8_1_MMVQ));
+                        gate += vec_dot_q8_0_q8_1(&gate_row[i], &y[i], iqs);
+                        up += vec_dot_q8_0_q8_1(&up_row[i], &y[i], iqs);
+                    }
+                }
+
+#pragma unroll
+                for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                    gate += dpct::permute_sub_group_by_xor(item.get_sub_group(), gate, mask);
+                    up += dpct::permute_sub_group_by_xor(item.get_sub_group(), up, mask);
+                }
+
+                if (lane == 0) {
+                    if (gate_up_scales != nullptr) {
+                        const char * scale_ptr = (const char *) gate_up_scales +
+                            (size_t) expert_id * gate_up_scales_nb0;
+                        const float scale = gate_up_scales_type == GGML_TYPE_F32 ?
+                            *(const float *) scale_ptr :
+                            (float) *(const sycl::half *) scale_ptr;
+                        gate *= scale;
+                        up *= scale;
+                    }
+                    *(float *) ((char *) dst + (size_t) row * dst_nb0 +
+                        (size_t) slot * dst_nb1 + (size_t) token * dst_nb2) =
+                            ggml_sycl_gemma4_geglu_f32(gate, up);
+                }
+            });
+    });
+}
