+static void mul_mat_vec_q8_0_moe_multi_token_gate_up_pair(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev,
+    const int ncols, const int nrows, const int n_experts_used,
+    const int n_tokens, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t dst_token_stride,
+    const size_t src1_token_stride, const int ids_expert_stride,
+    const int ids_token_stride, const sycl::nd_item<3> & item_ct1) {
+
+    const int n_ff       = nrows / 2;
+    const int token_idx  = item_ct1.get_group(0);
+    const int expert_idx = item_ct1.get_group(1);
+    const int expert_id  = ids_dev[token_idx * ids_token_stride +
+                                   expert_idx * ids_expert_stride];
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) +
+                    item_ct1.get_local_id(1);
+    if (row >= n_ff) {
+        return;
+    }
+
+    const int blocks_per_row = ncols / QK8_0;
+    constexpr int blocks_per_warp =
+        (VDR_Q8_0_Q8_1_MMVQ * WARP_SIZE + QI8_0 - 1) / QI8_0;
+
+    const char * expert_base = (const char *) vx_base +
+        (size_t) expert_id * expert_weight_stride;
+    const block_q8_0 * x = (const block_q8_0 *) expert_base;
+    const block_q8_1 * y = (const block_q8_1 *)
+        ((const char *) vy_base + (size_t) token_idx * src1_token_stride);
+    float * dst = (float *) ((char *) dst_base +
+            (size_t) token_idx * dst_token_stride +
+            (size_t) expert_idx * dst_row_stride);
+
+    float gate = 0.0f;
+    float up = 0.0f;
+
+    for (int i = item_ct1.get_local_id(2) / (QI8_0 / VDR_Q8_0_Q8_1_MMVQ);
+         i < blocks_per_row; i += blocks_per_warp) {
+        const int ib_gate = row * blocks_per_row + i;
+        const int ib_up = (row + n_ff) * blocks_per_row + i;
+        const int iby = i;
+
+        for (size_t elem = 0; elem < QI8_0 / VDR_Q8_0_Q8_1_MMVQ;
+             elem += WARP_SIZE) {
+            const int iqs = elem + VDR_Q8_0_Q8_1_MMVQ *
+                (item_ct1.get_local_id(2) % (QI8_0 / VDR_Q8_0_Q8_1_MMVQ));
+            gate += vec_dot_q8_0_q8_1(&x[ib_gate], &y[iby], iqs);
+            up += vec_dot_q8_0_q8_1(&x[ib_up], &y[iby], iqs);
+        }
+    }
+
+#pragma unroll
+    for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        gate += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), gate, mask);
+        up += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), up, mask);
+    }
+
+    if (item_ct1.get_local_id(2) == 0) {
+        dst[row] = gate;
+        dst[row + n_ff] = up;
+    }
+}
+
+static void launch_mul_mat_vec_q8_0_moe_multi_token_gate_up_pair(
+    const void * vx_base, const void * vy, const int32_t * ids_dev,
+    float * dst_base, const int ncols, const int nrows, const int n_experts_used,
+    const int n_tokens, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t dst_token_stride,
+    const size_t src1_token_stride, const int ids_expert_stride,
+    const int ids_token_stride, dpct::queue_ptr stream) {
+
+    const int n_ff = nrows / 2;
+    const int block_num_y = (n_ff + GGML_SYCL_MMV_Y - 1) / GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums((unsigned) n_tokens, (unsigned) n_experts_used, (unsigned) block_num_y);
+    const sycl::range<3> block_dims(1, GGML_SYCL_MMV_Y, WARP_SIZE);
+    stream->submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(
+            sycl::nd_range<3>(block_nums * block_dims, block_dims),
+            [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                mul_mat_vec_q8_0_moe_multi_token_gate_up_pair(
+                    vx_base, vy, dst_base, ids_dev, ncols, nrows,
+                    n_experts_used, n_tokens, expert_weight_stride,
+                    dst_row_stride, dst_token_stride, src1_token_stride,
+                    ids_expert_stride, ids_token_stride, item);
+            });
+    });
+}
+
+bool ggml_sycl_mul_mat_vec_q_id_multi_token_gate_up_pair_q8_0(
+    const void *       vx_base,
+    const void *       vy,
+    const int32_t *    ids_dev,
+    float *            dst_base,
+    int                ncols,
+    int                nrows,
+    int                n_experts_used,
+    int                n_tokens,
+    size_t             expert_weight_stride,
+    size_t             dst_row_stride,
+    size_t             dst_token_stride,
+    size_t             src1_token_stride,
+    int                ids_expert_stride,
+    int                ids_token_stride,
+    dpct::queue_ptr    stream) {
+    launch_mul_mat_vec_q8_0_moe_multi_token_gate_up_pair(
+        vx_base, vy, ids_dev, dst_base, ncols, nrows, n_experts_used, n_tokens,
+        expert_weight_stride, dst_row_stride, dst_token_stride,
+        src1_token_stride, ids_expert_stride, ids_token_stride, stream);
+    return true;
+}
