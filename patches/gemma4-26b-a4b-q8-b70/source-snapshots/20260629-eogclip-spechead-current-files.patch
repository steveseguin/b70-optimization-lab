+    bool try_decode_staged_mtp3() {
+        static const bool enabled = server_env_enabled("LLAMA_SPEC_VERIFY_STAGE_MTP3");
+        static const bool split_bonus = server_env_enabled("LLAMA_SPEC_VERIFY_STAGE_MTP3_SPLIT_BONUS");
+        if (!enabled || spec == nullptr || batch.size() != 4) {
+            return false;
+        }
+
+        server_slot * slot_ptr = nullptr;
+        for (auto & slot : slots) {
+            if (slot.state != SLOT_STATE_GENERATING || !slot.can_speculate() || slot.spec_draft.empty()) {
+                continue;
+            }
+            if (slot_ptr != nullptr) {
+                return false;
+            }
+            slot_ptr = &slot;
+        }
+        if (slot_ptr == nullptr) {
+            return false;
+        }
+
+        server_slot & slot = *slot_ptr;
+        if (slot.spec_draft.size() != 3 || slot.spec_i_batch.size() != 4) {
+            return false;
+        }
+        for (int i = 0; i < 4; ++i) {
+            if (slot.spec_i_batch[i] != i) {
+                return false;
+            }
+        }
+
+        const size_t n_draft = slot.spec_draft.size();
+        common_sampler_ptr smpl_save(common_sampler_clone(slot.smpl.get()));
+        std::vector<llama_token> accepted;
+        accepted.reserve(n_draft + 1);
+
+        auto sample_row = [&](int row) {
+            scoped_timer timer(t_sampl, n_sampl);
+            return common_sampler_sample(slot.smpl.get(), slot.ctx_tgt, row);
+        };
+
+        int32_t n_batch_stage = llama_n_batch(ctx_tgt);
+        llama_batch stage_a = batch.get_view(0, 2);
+        if (!decode(n_batch_stage, 0, stage_a)) {
+            return false;
+        }
+
+        const int64_t t_sample_accept_start = spec_profile_enabled ? ggml_time_us() : 0;
+
+        llama_token id = sample_row(0);
+        common_sampler_accept(slot.smpl.get(), id, true);
+        accepted.push_back(id);
+        if (id == slot.spec_draft[0]) {
+            id = sample_row(1);
+            common_sampler_accept(slot.smpl.get(), id, true);
+            accepted.push_back(id);
+        }
+
+        if (accepted.size() == 2 && accepted[1] == slot.spec_draft[1]) {
+            n_batch_stage = llama_n_batch(ctx_tgt);
+            llama_batch stage_b = split_bonus ? batch.get_view(2, 1) : batch.get_view(2, 2);
+            if (!decode(n_batch_stage, 2, stage_b)) {
+                throw std::runtime_error("staged MTP3 verifier Stage B decode failed");
+            }
+
+            common_speculative_set_verify_h_base(spec.get(), slot.id, 2);
+
+            id = sample_row(0);
+            common_sampler_accept(slot.smpl.get(), id, true);
+            accepted.push_back(id);
+            if (id == slot.spec_draft[2]) {
+                if (split_bonus) {
+                    n_batch_stage = llama_n_batch(ctx_tgt);
+                    llama_batch stage_c = batch.get_view(3, 1);
+                    if (!decode(n_batch_stage, 3, stage_c)) {
+                        throw std::runtime_error("staged MTP3 verifier Stage C decode failed");
+                    }
+
+                    common_speculative_set_verify_h_base(spec.get(), slot.id, 3);
+
+                    id = sample_row(0);
+                } else {
+                    id = sample_row(1);
+                }
+                common_sampler_accept(slot.smpl.get(), id, true);
+                accepted.push_back(id);
+            }
+        }
+
+        if (spec_profile_enabled) {
+            t_spec_sample_accept_us += ggml_time_us() - t_sample_accept_start;
+            n_spec_sample_accept_calls++;
+            n_spec_accepted_tokens += (int64_t) accepted.size();
+            spec_profile_dirty = true;
+        }
+
+        finish_speculative_accept(slot, std::move(accepted), n_draft, std::move(smpl_save));
+        return true;
+    }
