+// ggml_moe_selected_down_weighted_sum
+
+struct ggml_tensor * ggml_moe_selected_down_weighted_sum(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * down_exps,
+        struct ggml_tensor  * cur,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * weights,
+        struct ggml_tensor  * down_scales) {
+    GGML_ASSERT(cur->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(down_scales == NULL ||
+            down_scales->type == GGML_TYPE_F32 ||
+            down_scales->type == GGML_TYPE_F16);
+    GGML_ASSERT(down_exps->ne[0] == cur->ne[0]);
+    GGML_ASSERT(ids->ne[0] == cur->ne[1]);
+    GGML_ASSERT(ids->ne[1] == cur->ne[2]);
+    const bool weights_are_selected = weights->ne[0] == 1 &&
+        weights->ne[1] == ids->ne[0] &&
+        weights->ne[2] == ids->ne[1];
+    const bool weights_are_logits = weights->ne[0] == down_exps->ne[2] &&
+        weights->ne[1] == ids->ne[1];
+    GGML_ASSERT(weights_are_selected || weights_are_logits);
+    GGML_ASSERT(down_scales == NULL || down_scales->ne[0] == down_exps->ne[2]);
+
+    const int64_t ne[4] = { down_exps->ne[1], cur->ne[2], 1, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 2, ne);
+
+    result->op     = GGML_OP_MOE_SELECTED_DOWN_WEIGHTED_SUM;
+    result->src[0] = down_exps;
+    result->src[1] = cur;
+    result->src[2] = ids;
+    result->src[3] = weights;
+    result->src[4] = down_scales;
+
+    return result;
+}
