+static bool ggml_sycl_mul_mat_id_multi_token_filter_allows(const ggml_tensor * dst) {
+    const char * name_env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_MULTI_TOKEN_NAME_SUBSTR");
+    if (name_env != nullptr && name_env[0] != '\0') {
+        return std::strstr(dst->name, name_env) != nullptr;
+    }
+
+    const char * env = std::getenv("LLAMA_SYCL_MUL_MAT_ID_MULTI_TOKEN_FILTER");
+    if (env == nullptr || env[0] == '\0') {
+        return true;
+    }
+
+    const bool want_gate_up = std::strstr(env, "gate_up") != nullptr;
+    const bool want_down    = std::strstr(env, "down")    != nullptr;
+
+    if (!want_gate_up && !want_down) {
+        return true;
+    }
+
+    const char * name = dst->name;
+    const bool is_gate_up = std::strstr(name, "ffn_moe_gate_up") != nullptr;
+    const bool is_down    = std::strstr(name, "ffn_moe_down")    != nullptr;
+
+    return (want_gate_up && is_gate_up) || (want_down && is_down);
+}
