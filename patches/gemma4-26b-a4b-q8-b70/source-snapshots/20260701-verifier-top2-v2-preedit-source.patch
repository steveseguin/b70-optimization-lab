+void ggml_sycl_op_rms_norm_scale_add(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * src2 = dst->src[2];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(src2->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+    GGML_ASSERT(src1->ne[0] == src0->ne[0]);
+    GGML_ASSERT(src1->ne[1] == 1 && src1->ne[2] == 1 && src1->ne[3] == 1);
+
+    dpct::queue_ptr main_stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const float * src0_dd = static_cast<const float *>(src0->data);
+    const float * src1_dd = static_cast<const float *>(src1->data);
+    const float * src2_dd = static_cast<const float *>(src2->data);
+    float *       dst_dd  = static_cast<float *>(dst->data);
+
+    float eps;
+    memcpy(&eps, dst->op_params, sizeof(float));
+
+    GGML_TENSOR_TERNARY_OP_LOCALS
+    const size_t ts0 = ggml_type_size(src0->type);
+    GGML_ASSERT(nb00 == ts0);
+    GGML_ASSERT(nb10 == ts0);
+    GGML_ASSERT(nb20 == ts0);
+    GGML_ASSERT(nb0  == ts0);
+    GGML_ASSERT(ne10 == ne00);
+    GGML_ASSERT(ne20 == ne00 && ne21 == ne01 && ne22 == ne02 && ne23 == ne03);
+    GGML_ASSERT(ne0  == ne00 && ne1  == ne01 && ne2  == ne02 && ne3  == ne03);
+
+    const int64_t s01 = nb01 / ts0;
+    const int64_t s02 = nb02 / ts0;
+    const int64_t s03 = nb03 / ts0;
+    const int64_t r01 = nb21 / ts0;
+    const int64_t r02 = nb22 / ts0;
+    const int64_t r03 = nb23 / ts0;
+
+    rms_norm_scale_add_f32_sycl(src0_dd, src1_dd, src2_dd, dst_dd, ne00, ne01,
+            ne02, ne03, s01, s02, s03, r01, r02, r03, eps, main_stream,
+            ctx.device);
+}
