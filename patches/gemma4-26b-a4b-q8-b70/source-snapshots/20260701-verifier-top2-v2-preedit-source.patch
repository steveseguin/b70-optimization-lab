+static void common_sampler_spec_verify_synchronize(struct llama_context * ctx, size_t rows) {
+    static const bool profile = common_sampler_spec_verify_sync_profile_from_env();
+    static int64_t n_calls = 0;
+    static int64_t n_rows = 0;
+    static int64_t t_sync_us = 0;
+
+    if (!profile) {
+        llama_synchronize(ctx);
+        return;
+    }
+
+    const int64_t t0 = ggml_time_us();
+    llama_synchronize(ctx);
+    const int64_t dt = ggml_time_us() - t0;
+
+    n_calls++;
+    n_rows += (int64_t) rows;
+    t_sync_us += dt;
+
+    if ((n_calls & 127) == 0) {
+        LOG_WRN("spec verify sync profile: calls=%" PRId64 ", rows=%" PRId64
+                ", sync_ms=%.3f, avg_call_ms=%.3f, avg_row_ms=%.3f\n",
+                n_calls, n_rows,
+                (double) t_sync_us / 1000.0,
+                (double) t_sync_us / 1000.0 / (double) n_calls,
+                (double) t_sync_us / 1000.0 / (double) std::max<int64_t>(1, n_rows));
+    }
+}
+
+static llama_token common_sampler_argmax_token(struct llama_context * ctx, int idx) {
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+
+    const float * logits = llama_get_logits_ith(ctx, idx);
+    GGML_ASSERT(logits != nullptr);
+    GGML_ASSERT(n_vocab > 0);
+
+    llama_token best_id = 0;
+    float best_logit = logits[0];
+    for (llama_token token_id = 1; token_id < n_vocab; token_id++) {
+        if (logits[token_id] > best_logit) {
+            best_logit = logits[token_id];
+            best_id = token_id;
+        }
+    }
+
+    return best_id;
+}
