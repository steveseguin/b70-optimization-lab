+        sums = 0.f;
+        for (size_t i = 0; i < nreduce; i += 1) {
+            sums += s_sum[wi_in_sg + i * WARP_SIZE];
+        }
+        sums = warp_reduce_sum(sums, item_ct1);
+    }
+
+    const float scale_a = sycl::rsqrt(sums.x() / ncols + eps);
+    const float scale_b = sycl::rsqrt(sums.y() / ncols + eps);
+
+    for (int col = tid; col < ncols; col += block_size) {
+        dst[col] = a[col] * scale_a * weight_a[col] + b[col] * scale_b * weight_b[col];
+    }
+}
