+    auto data = std::make_shared<llama_ubatch::data_t>();
+    data->embd = std::move(hidden);
+    data->pos.resize(count);
+    data->n_seq_id.assign(count, 1);
+    data->seq_id_data.assign(count, 0);
+    data->seq_id.resize(count);
+    for (int32_t i = 0; i < count; ++i) {
+        data->pos[i] = i;
+        data->seq_id[i] = data->seq_id_data.data() + i;
+    }
+    data->seq_id_unq = { 0 };
+    data->seq_idx.assign(LLAMA_MAX_SEQ, -1);
+    data->seq_idx[0] = 0;
+    data->output.assign(count, 1);
+
+    llama_ubatch ubatch = {};
+    ubatch.b_equal_seqs = true;
+    ubatch.n_tokens     = count;
+    ubatch.n_seq_tokens = count;
+    ubatch.n_seqs       = 1;
+    ubatch.n_seqs_unq   = 1;
+    ubatch.n_pos        = 1;
+    ubatch.token        = nullptr;
+    ubatch.embd         = data->embd.data();
+    ubatch.pos          = data->pos.data();
+    ubatch.n_seq_id     = data->n_seq_id.data();
+    ubatch.seq_id       = data->seq_id.data();
+    ubatch.seq_id_unq   = data->seq_id_unq.data();
+    ubatch.seq_idx      = data->seq_idx.data();
+    ubatch.output       = data->output.data();
+    ubatch.data         = std::move(data);
+
+    output_swaps.clear();
+    sched_reserve();
+
+    if (output_reserve(count) < (uint32_t) count) {
+        LLAMA_LOG_WARN("%s: failed to reserve sampled-token output\n", __func__);
+        return -1;
+    }
+
+    n_outputs = count;
+
+    ggml_status status = GGML_STATUS_SUCCESS;
+    const auto * res = process_ubatch(ubatch, LLM_GRAPH_TYPE_SPEC_HEAD, nullptr, status);
+    if (!res || res->t_sampled_rows.empty()) {
+        LLAMA_LOG_WARN("%s: head-only graph failed or produced no sampled rows (status=%d)\n",
+                __func__, (int) status);
+        return -1;
+    }
+
+    auto * sampled = res->t_sampled_rows.begin()->second;
+    GGML_ASSERT(sampled != nullptr);
+    GGML_ASSERT(ggml_is_contiguous(sampled));
+    GGML_ASSERT(ggml_nelements(sampled) >= count);
+
+    ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched.get(), sampled);
+    GGML_ASSERT(backend != nullptr);
+    ggml_backend_tensor_get_async(backend, sampled, out_tokens, 0, (size_t) count * sizeof(out_tokens[0]));
+    synchronize();
+
+    return count;
+}
