+// ggml_rms_norm_dual_scale_add
+
+struct ggml_tensor * ggml_rms_norm_dual_scale_add(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * scale_a,
