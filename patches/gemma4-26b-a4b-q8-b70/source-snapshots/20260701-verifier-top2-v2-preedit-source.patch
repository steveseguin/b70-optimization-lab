+static bool ggml_sycl_mul_mat_id_multi_token_direct_supports(
+        const enum ggml_type src0_type, const bool use_reorder) {
+    if (use_reorder) {
+        return src0_type == GGML_TYPE_Q4_K ||
+               src0_type == GGML_TYPE_Q5_K ||
+               src0_type == GGML_TYPE_Q6_K ||
+               src0_type == GGML_TYPE_Q8_0;
+    }
+
+    switch (src0_type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_NVFP4:
+            return true;
+        default:
+            return false;
+    }
+}
