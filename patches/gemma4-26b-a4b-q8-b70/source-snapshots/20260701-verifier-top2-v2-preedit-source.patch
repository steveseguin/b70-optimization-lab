+    const int needed_scratch = (int) ceil_div(nrows, WARP_SIZE);
+    if (nvec < 1 || nvec > 4 || scratch_count < needed_scratch) {
+        return false;
+    }
+
+    const int stride_col_y_bytes = src1_padded_cols * (int) sizeof(block_q8_1) / QK8_1;
+
+    stream->fill(dst, (int32_t) -1, (size_t) nvec);
+    for (int out_idx = 0; out_idx < nvec; ++out_idx) {
+        const void * vy_i = (const char *) vy + (int64_t) out_idx * stride_col_y_bytes;
+        reorder_mul_mat_vec_q_argmax_accept_prefix_sycl<reorder_vec_dot_q_sycl<GGML_TYPE_Q8_0>>(
+            vx, vy_i, scratch_vals, scratch_idxs, dst, tokens, ncols, nrows, out_idx, stream);
