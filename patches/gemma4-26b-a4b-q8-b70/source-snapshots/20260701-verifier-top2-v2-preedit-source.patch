+std::vector<llama_token> common_sampler_sample_and_accept_draft_only(struct common_sampler * gsmpl, struct llama_context * ctx, const std::vector<int> & idxs, const llama_tokens & draft, bool grammar_first) {
+    GGML_ASSERT(idxs.size() == draft.size() && "idxs.size() must equal draft.size()");
+
+    std::vector<llama_token> result;
+    result.reserve(draft.size());
+
+    if (draft.empty()) {
+        return result;
+    }
+
+    if (common_sampler_can_spec_verify_greedy_argmax(gsmpl, grammar_first)) {
+        llama_synchronize(ctx);
+
+        const auto tm = gsmpl->tm();
+
+        for (size_t i = 0; i < draft.size(); i++) {
+            const llama_token id = common_sampler_argmax_token(ctx, idxs[i]);
+
+            common_sampler_accept(gsmpl, id, true);
+
+            result.push_back(id);
+
+            if (draft[i] != id) {
+                break;
+            }
+        }
+
+        return result;
+    }
+
+    if (common_sampler_spec_verify_backend_argmax_ids_from_env()) {
+        common_sampler_spec_verify_synchronize(ctx, idxs.size());
+
+        const bool use_bulk_sampled =
+            common_sampler_spec_verify_bulk_sampled_ids_from_env() &&
+            std::all_of(idxs.begin(), idxs.end(), [](int idx) { return idx >= 0; });
+        const llama_token * sampled_bulk = nullptr;
+        if (use_bulk_sampled) {
+            bool consecutive_rows = true;
+            for (size_t row = 0; row < idxs.size(); ++row) {
+                if (idxs[row] != (int) row) {
+                    consecutive_rows = false;
+                    break;
+                }
+            }
+            if (consecutive_rows) {
+                sampled_bulk = llama_get_sampled_tokens(ctx);
+            }
+        }
+
+        const bool skip_stateless_accept =
+            common_sampler_spec_verify_skip_stateless_accept_from_env() &&
+            common_sampler_is_stateless_greedy(gsmpl, grammar_first);
+
+        auto sampled_id = [&](size_t row) {
+            if (sampled_bulk != nullptr) {
+                return sampled_bulk[row];
+            }
+            return llama_get_sampled_token_ith_nosync(ctx, idxs[row]);
+        };
+
+        for (size_t i = 0; i < draft.size(); i++) {
+            llama_token id = sampled_id(i);
+            if (id == LLAMA_TOKEN_NULL) {
+                id = common_sampler_argmax_token(ctx, idxs[i]);
+            }
+
+            if (!skip_stateless_accept) {
+                common_sampler_accept(gsmpl, id, true);
+            }
+
+            result.push_back(id);
+
+            if (draft[i] != id) {
+                break;
+            }
+        }
+
+        return result;
