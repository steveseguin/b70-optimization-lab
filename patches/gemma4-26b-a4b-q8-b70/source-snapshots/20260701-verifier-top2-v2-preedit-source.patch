+        accum.multi_calls += n_tokens > 1 ? 1 : 0;
+        accum.routed_rows += routed_rows;
+        accum.tokens += n_tokens;
+        accum.ids += n_ids;
+        accum.unique_experts += unique_experts;
+        accum.token_unique += token_unique_sum;
+        accum.repeated_rows += repeated_rows;
+        accum.max_expert_rows += max_expert_rows;
+    };
+
+    static route_profile_totals totals;
+    static const int64_t every = ggml_sycl_mul_mat_id_route_profile_every();
+
+    std::lock_guard<std::mutex> lock(totals.mutex);
+    add_sample(totals.all);
+
+    const int bucket =
+        n_tokens <= 1  ? 0 :
+        n_tokens <= 8  ? 1 :
+        n_tokens <= 32 ? 2 : 3;
+    add_sample(totals.buckets[bucket]);
+
+    if (totals.all.calls % every == 0) {
+        const auto log_accum = [&](const char * label, const route_profile_accum & accum) {
+            if (accum.calls == 0) {
+                return;
+            }
+            const double calls = (double) accum.calls;
+            GGML_LOG_WARN(
+                    "sycl mul_mat_id route profile: bucket=%s calls=%" PRId64
+                    " multi_calls=%" PRId64
+                    " avg_tokens=%.3f avg_ids=%.3f avg_routed_rows=%.3f"
+                    " avg_global_unique=%.3f avg_token_unique=%.3f"
+                    " avg_repeated_rows=%.3f avg_max_expert_rows=%.3f"
+                    " last_shape src1=[%" PRId64 ",%" PRId64 ",%" PRId64 "]"
+                    " dst=[%" PRId64 ",%" PRId64 ",%" PRId64 "]\n",
+                    label,
+                    accum.calls,
+                    accum.multi_calls,
+                    (double) accum.tokens / calls,
+                    (double) accum.ids / calls,
+                    (double) accum.routed_rows / calls,
+                    (double) accum.unique_experts / calls,
+                    (double) accum.token_unique / std::max<int64_t>(1, accum.tokens),
+                    (double) accum.repeated_rows / calls,
+                    (double) accum.max_expert_rows / calls,
+                    src1->ne[0], src1->ne[1], src1->ne[2],
+                    dst->ne[0], dst->ne[1], dst->ne[2]);
+        };
+
+        log_accum("all", totals.all);
+        log_accum("tok1", totals.buckets[0]);
+        log_accum("tok2_8", totals.buckets[1]);
+        log_accum("tok9_32", totals.buckets[2]);
+        log_accum("tok33p", totals.buckets[3]);
+    }
+}
