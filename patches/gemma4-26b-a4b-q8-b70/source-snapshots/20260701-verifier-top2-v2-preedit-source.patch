+    GGML_ASSERT(scale_a->ne[0] == a->ne[0]);
+    GGML_ASSERT(scale_b->ne[0] == a->ne[0]);
+    GGML_ASSERT(scale_a->ne[1] == 1 || scale_a->ne[1] == a->ne[1]);
+    GGML_ASSERT(scale_a->ne[2] == 1 || scale_a->ne[2] == a->ne[2]);
+    GGML_ASSERT(scale_a->ne[3] == 1 || scale_a->ne[3] == a->ne[3]);
+    GGML_ASSERT(scale_b->ne[1] == 1 || scale_b->ne[1] == a->ne[1]);
+    GGML_ASSERT(scale_b->ne[2] == 1 || scale_b->ne[2] == a->ne[2]);
+    GGML_ASSERT(scale_b->ne[3] == 1 || scale_b->ne[3] == a->ne[3]);
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+
+    ggml_set_op_params(result, &eps, sizeof(eps));
+
+    result->op     = GGML_OP_RMS_NORM_DUAL_SCALE_ADD;
+    result->src[0] = a;
+    result->src[1] = scale_a;
+    result->src[2] = b;
+    result->src[3] = scale_b;
