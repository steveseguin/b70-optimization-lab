+static bool llama_env_enabled(const char * name) {
+    const char * env = std::getenv(name);
+    if (env == nullptr || env[0] == '\0') {
+        return false;
+    }
+
+    return std::strcmp(env, "1") == 0 ||
+           std::strcmp(env, "true") == 0 ||
+           std::strcmp(env, "TRUE") == 0 ||
+           std::strcmp(env, "yes") == 0 ||
+           std::strcmp(env, "on") == 0;
+}
+
+static uint32_t llama_env_u32(const char * name, uint32_t fallback) {
+    const char * env = std::getenv(name);
+    if (env == nullptr || env[0] == '\0') {
+        return fallback;
+    }
+
+    const int value = std::atoi(env);
+    return value > 0 ? (uint32_t) value : fallback;
+}
