+int32_t llama_context::spec_verify_head_from_h_nextn_range(int32_t first, int32_t count, llama_token * out_tokens) {
+    if (count <= 0) {
+        return 0;
+    }
+    if (out_tokens == nullptr) {
+        return -1;
+    }
+
+    const uint32_t n_embd = model.hparams.n_embd_out();
+    std::vector<float> hidden((size_t) n_embd * (size_t) count);
+
+    for (int32_t i = 0; i < count; ++i) {
+        if (!copy_embeddings_nextn_ith(first + i, hidden.data() + (size_t) i * n_embd)) {
+            return -1;
+        }
+    }
