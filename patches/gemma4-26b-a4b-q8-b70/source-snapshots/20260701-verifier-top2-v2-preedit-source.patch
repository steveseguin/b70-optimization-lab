+static void mul_mat_vec_q8_0_moe_multi_token_per_slot(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev,
+    const int ncols, const int nrows, const int n_experts_used,
+    const int n_tokens, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t dst_token_stride,
+    const size_t src1_row_stride, const int src1_rows_per_token,
+    const int ids_expert_stride, const int ids_token_stride,
+    const sycl::nd_item<3> & item_ct1) {
+
+    const int token_idx  = item_ct1.get_group(0);
+    const int expert_idx = item_ct1.get_group(1);
+    const int expert_id  = ids_dev[token_idx * ids_token_stride +
+                                   expert_idx * ids_expert_stride];
+
+    const block_q8_0 * x = (const block_q8_0 *)
+        ((const char *) vx_base + (size_t) expert_id * expert_weight_stride);
+    const block_q8_1 * y = (const block_q8_1 *)
+        ((const char *) vy_base +
+            (size_t) (token_idx * src1_rows_per_token + expert_idx) *
+            src1_row_stride);
+    float * dst = (float *) ((char *) dst_base +
+            (size_t) token_idx * dst_token_stride +
+            (size_t) expert_idx * dst_row_stride);
+
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) +
+                    item_ct1.get_local_id(1);
+    if (row >= nrows) {
+        return;
+    }
+
+    const int blocks_per_row = ncols / QK8_0;
+    constexpr int blocks_per_warp =
+        (VDR_Q8_0_Q8_1_MMVQ * WARP_SIZE + QI8_0 - 1) / QI8_0;
+
+    float tmp = 0.0f;
+
+    for (int i = item_ct1.get_local_id(2) / (QI8_0 / VDR_Q8_0_Q8_1_MMVQ);
+         i < blocks_per_row; i += blocks_per_warp) {
+        const int ibx = row * blocks_per_row + i;
+        const int iby = i;
+
+        for (size_t elem = 0; elem < QI8_0 / VDR_Q8_0_Q8_1_MMVQ;
+             elem += WARP_SIZE) {
+            const int iqs = elem + VDR_Q8_0_Q8_1_MMVQ *
+                (item_ct1.get_local_id(2) % (QI8_0 / VDR_Q8_0_Q8_1_MMVQ));
+
+            int v[VDR_Q8_0_Q8_1_MMVQ];
+            int u[VDR_Q8_0_Q8_1_MMVQ];
+#pragma unroll
+            for (int j = 0; j < VDR_Q8_0_Q8_1_MMVQ; ++j) {
+                v[j] = get_int_from_int8(x[ibx].qs, iqs + j);
+                u[j] = get_int_from_int8_aligned(y[iby].qs, iqs + j);
+            }
+            tmp += vec_dot_q8_0_q8_1_impl<VDR_Q8_0_Q8_1_MMVQ>(
+                v, u, x[ibx].d, y[iby].ds[0]);
+        }
+    }
+
+#pragma unroll
+    for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        tmp += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp, mask);
+    }
+
+    if (item_ct1.get_local_id(2) == 0) {
+        dst[row] = tmp;
+    }
+}
