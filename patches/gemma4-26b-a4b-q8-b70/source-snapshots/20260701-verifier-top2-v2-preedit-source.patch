+static bool ggml_sycl_mul_mat_id_route_cache_enabled();
+static bool ggml_sycl_mul_mat_id_route_cache_inplace_enabled();
+static bool ggml_sycl_mul_mat_id_gate_up_fast_seed_route_cache_enabled();
+static bool ggml_sycl_mul_mat_id_is_gate_up_node(const ggml_tensor * dst);
+static bool ggml_sycl_mul_mat_id_multi_token_direct_supports(
+        const enum ggml_type src0_type, const bool use_reorder);
+static void ggml_sycl_mul_mat_id_seed_route_cache(
+        ggml_backend_sycl_context & ctx,
+        const ggml_tensor * ids,
+        int64_t n_ids,
+        int64_t n_as);
+
+#if defined(GGML_SYCL_HAS_BF16)
+static void mul_mat_id_bf16_multi_token_direct_sycl(
+        const sycl::ext::oneapi::bfloat16 * vx_base,
+        const sycl::ext::oneapi::bfloat16 * vy,
+        const int32_t * ids_dev,
+        float * dst_base,
+        int ncols,
+        int nrows,
+        int n_experts_used,
+        int n_experts_total,
+        int n_tokens,
+        size_t expert_weight_stride,
+        size_t dst_row_stride,
+        size_t dst_token_stride,
+        int ids_expert_stride,
+        int ids_token_stride,
+        dpct::queue_ptr stream) {
+    GGML_ASSERT(ncols % WARP_SIZE == 0);
+
+    const int total_rows = nrows * n_experts_used * n_tokens;
+    const int rows_per_wg = GGML_SYCL_MMV_Y;
+    const sycl::range<3> block_nums(1, 1, ceil_div(total_rows, rows_per_wg));
+    const sycl::range<3> block_dims(1, rows_per_wg, WARP_SIZE);
+
+    stream->parallel_for(
+        sycl::nd_range<3>(block_nums * block_dims, block_dims),
+        [=](sycl::nd_item<3> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            const int flat = item.get_group(2) * rows_per_wg + item.get_local_id(1);
+            if (flat >= total_rows) {
+                return;
+            }
+
+            const int row = flat % nrows;
+            const int route = flat / nrows;
+            const int slot = route % n_experts_used;
+            const int tok = route / n_experts_used;
+            const int lane = item.get_local_id(2);
+
+            const int32_t expert_id =
+                ids_dev[tok * ids_token_stride + slot * ids_expert_stride];
+            if (expert_id < 0 || expert_id >= n_experts_total) {
+                return;
+            }
+
+            const auto * expert_base =
+                (const sycl::ext::oneapi::bfloat16 *)
+                ((const char *) vx_base + (size_t) expert_id * expert_weight_stride);
+            const auto * y = vy + (size_t) tok * (size_t) ncols;
+
+            float sum = 0.0f;
+            for (int col = lane; col < ncols; col += WARP_SIZE) {
+                sum += (float) expert_base[(size_t) row * (size_t) ncols + col] *
+                       (float) y[col];
+            }
+
+            for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+                sum += dpct::permute_sub_group_by_xor(item.get_sub_group(), sum, mask);
+            }
+
+            if (lane == 0) {
+                float * out =
+                    (float *) ((char *) dst_base +
+                        (size_t) tok * dst_token_stride +
+                        (size_t) slot * dst_row_stride);
+                out[row] = sum;
+            }
+        });
+}
+
+static bool ggml_sycl_mul_mat_id_bf16_multi_token_direct(
+        ggml_backend_sycl_context & ctx,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * ids,
+        ggml_tensor * dst) {
+    if (src0->type != GGML_TYPE_BF16 ||
+            src1->type != GGML_TYPE_F32 ||
+            dst->type != GGML_TYPE_F32 ||
+            ids->type != GGML_TYPE_I32) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_sycl_split(src0->buffer)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src1)) {
+        return false;
+    }
+
+    const int64_t ncols = src1->ne[0];
+    const int64_t n_experts_used = ids->ne[0];
+    const int64_t n_tokens = src1->ne[2];
+    if (src1->ne[1] != 1 ||
+            ids->ne[1] != n_tokens ||
+            n_tokens <= 1 || n_tokens > 8 ||
+            n_experts_used <= 0 || n_experts_used > 8 ||
+            src0->ne[0] != ncols ||
+            ncols % WARP_SIZE != 0) {
+        return false;
+    }
+    if (dst->ne[0] != src0->ne[1] ||
+            dst->ne[1] != n_experts_used ||
+            dst->ne[2] != n_tokens) {
+        return false;
+    }
+    if (src0->nb[0] != (int64_t) sizeof(sycl::ext::oneapi::bfloat16) ||
+            src0->nb[1] != ncols * (int64_t) sizeof(sycl::ext::oneapi::bfloat16) ||
+            src1->nb[0] != (int64_t) sizeof(float) ||
+            src1->nb[2] != ncols * (int64_t) sizeof(float) ||
+            ids->nb[0] % (int64_t) sizeof(int32_t) != 0 ||
+            ids->nb[1] % (int64_t) sizeof(int32_t) != 0 ||
+            dst->nb[0] != (int64_t) sizeof(float) ||
+            dst->nb[1] % (int64_t) sizeof(float) != 0 ||
+            dst->nb[2] % (int64_t) sizeof(float) != 0) {
+        return false;
+    }
+
+    queue_ptr stream = ctx.stream();
+    ggml_sycl_pool_alloc<sycl::ext::oneapi::bfloat16> src1_bf16_alloc(
+        ctx.pool(), (size_t) n_tokens * (size_t) ncols);
+    auto * src1_bf16 = src1_bf16_alloc.get();
+    const to_bf16_sycl_t to_bf16_sycl = ggml_get_to_bf16_sycl(src1->type, dst);
+    GGML_ASSERT(to_bf16_sycl != nullptr);
+    to_bf16_sycl(src1->data, src1_bf16, n_tokens * ncols, stream);
+
+    mul_mat_id_bf16_multi_token_direct_sycl(
+        (const sycl::ext::oneapi::bfloat16 *) src0->data,
+        src1_bf16,
+        (const int32_t *) ids->data,
+        (float *) dst->data,
+        (int) ncols,
+        (int) src0->ne[1],
+        (int) n_experts_used,
+        (int) src0->ne[2],
+        (int) n_tokens,
+        (size_t) src0->nb[2],
+        (size_t) dst->nb[1],
+        (size_t) dst->nb[2],
+        (int) (ids->nb[0] / (int64_t) sizeof(int32_t)),
+        (int) (ids->nb[1] / (int64_t) sizeof(int32_t)),
+        stream);
+    return true;
+}
+#endif
+
+// Fused small multi-token MoE verifier path. This covers the Gemma target
+// verifier shape produced by draft-MTP: src1=[ncols,1,n_tokens],
+// ids=[n_experts_used,n_tokens], n_tokens<=8. It avoids the generic
+// MUL_MAT_ID path below, which copies ids to host, sorts routed rows, gathers
+// src1, runs one matmul per used expert, and scatters the output.
+static bool ggml_sycl_mul_mat_id_mmvq_multi_token_fused(
+    ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
+    const ggml_tensor * src1, const ggml_tensor * ids, ggml_tensor * dst)
+{
+    const bool gate_up_seed_route_cache_enabled =
+        ggml_sycl_mul_mat_id_gate_up_fast_seed_route_cache_enabled() &&
+        ggml_sycl_mul_mat_id_route_cache_enabled() &&
+        ggml_sycl_mul_mat_id_is_gate_up_node(dst);
+    const bool direct_fast_enabled =
+        ggml_sycl_mul_mat_id_multi_token_fast_enabled() ||
+        gate_up_seed_route_cache_enabled;
+    const bool grouped_q8_0_enabled =
+        ggml_sycl_mul_mat_id_multi_token_grouped_q8_0_enabled();
+    const bool grouped_q8_0_reorder_enabled =
+        ggml_sycl_mul_mat_id_multi_token_grouped_q8_0_reorder_enabled();
+    const bool pair_slots_q8_0_reorder_enabled =
+        ggml_sycl_mul_mat_id_q8_0_reorder_pair_slots_enabled();
+    const bool top8_slots_q8_0_reorder_enabled =
+        ggml_sycl_mul_mat_id_q8_0_reorder_top8_slots_enabled();
+    const bool direct_vdr2_q8_0_reorder_enabled =
+        ggml_sycl_mul_mat_id_q8_0_reorder_direct_vdr2_enabled();
+    const int rowpack_q8_0_reorder =
+        ggml_sycl_mul_mat_id_q8_0_reorder_rowpack();
+    const bool per_slot_q8_0_enabled =
+        ggml_sycl_mul_mat_id_multi_token_per_slot_q8_0_enabled();
+    const bool bf16_direct_enabled =
+        ggml_sycl_mul_mat_id_multi_token_bf16_direct_enabled();
+    if (!direct_fast_enabled && !grouped_q8_0_enabled &&
+            !grouped_q8_0_reorder_enabled &&
+            !pair_slots_q8_0_reorder_enabled &&
+            !top8_slots_q8_0_reorder_enabled &&
+            !direct_vdr2_q8_0_reorder_enabled &&
+            rowpack_q8_0_reorder == 0 &&
+            !per_slot_q8_0_enabled &&
+            !bf16_direct_enabled) {
+        return false;
+    }
+    if (!gate_up_seed_route_cache_enabled &&
+            !ggml_sycl_mul_mat_id_multi_token_filter_allows(dst)) {
+        return false;
+    }
+
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne12 = src1->ne[2];
+    if (ne12 <= 1 || ne12 > 8) return false;
+    if (ne11 != 1 && ne11 != ids->ne[0]) return false;
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    if (ne10 != src0->ne[0] || ne10 % QK8_1 != 0) return false;
+    if (!ggml_is_contiguous(src1)) return false;
+    if (ids->type != GGML_TYPE_I32) return false;
+    if (ids->ne[1] != ne12) return false;
+    if (ids->nb[0] % sizeof(int32_t) != 0 ||
+        ids->nb[1] % sizeof(int32_t) != 0) {
+        return false;
+    }
+    if (dst->ne[0] != src0->ne[1] || dst->ne[1] != ids->ne[0] ||
+        dst->ne[2] != ne12 || dst->nb[0] != sizeof(float) ||
+        dst->nb[1] % sizeof(float) != 0 ||
+        dst->nb[2] % sizeof(float) != 0) {
+        return false;
+    }
+
+    const queue_ptr stream           = ctx.stream();
+    const int       src1_padded_cols = GGML_PAD((int) ne10, MATRIX_ROW_PADDING);
+    const int       n_experts_used   = (int) ids->ne[0];
+    const int       nrows            = (int) src0->ne[1];
+    const int       n_tokens         = (int) ne12;
+
+#if defined(GGML_SYCL_HAS_BF16)
+    if (bf16_direct_enabled &&
+            src0->type == GGML_TYPE_BF16 &&
+            ne11 == 1) {
+        if (ggml_sycl_mul_mat_id_bf16_multi_token_direct(
+                    ctx, src0, src1, ids, dst)) {
+            return true;
+        }
+    }
+#endif
+
+    if (grouped_q8_0_reorder_enabled &&
+        src0->type == GGML_TYPE_Q8_0 &&
+        n_experts_used <= 8 &&
+        ne11 == 1) {
+        opt_for_reorder_id(&ctx, src0);
+        const ggml_tensor_extra_gpu * src0_extra =
+            static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+        if (src0_extra && src0_extra->optimized_feature.reorder) {
+            ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+                (size_t) n_tokens * src1_padded_cols *
+                    sizeof(block_q8_1) / QK8_1);
+            char * src1_ddq = src1_q8_alloc.get();
+            quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+                (const float *) src1->data, src1_ddq, (int) ne10,
+                n_tokens, src1_padded_cols, stream);
+
+            const size_t bytes_per_qrow =
+                (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+            const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+            const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+
+            return ggml_sycl_mul_mat_vec_q_id_multi_token_grouped_q8_0_reorder(
+                src0->data, src1_ddq, (const int32_t *) ids->data,
+                (float *) dst->data, (int) ne10, nrows, n_experts_used,
+                n_tokens,
+                /*expert_weight_stride=*/ src0->nb[2],
+                /*dst_row_stride=*/ dst->nb[1],
+                /*dst_token_stride=*/ dst->nb[2],
+                /*src1_row_stride=*/ bytes_per_qrow,
+                ids_expert_stride, ids_token_stride, stream);
+        }
+    }
+
+    if (pair_slots_q8_0_reorder_enabled &&
+        src0->type == GGML_TYPE_Q8_0 &&
+        n_experts_used == 2 &&
+        ne11 == 1) {
+        opt_for_reorder_id(&ctx, src0);
+        const ggml_tensor_extra_gpu * src0_extra =
+            static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+        if (src0_extra && src0_extra->optimized_feature.reorder) {
+            ggml_sycl_pool_alloc<char> src1_q8_alloc(ctx.pool(),
+                (size_t) n_tokens * src1_padded_cols *
+                    sizeof(block_q8_1) / QK8_1);
+            char * src1_ddq = src1_q8_alloc.get();
+            quantize_row_q8_1_sycl<quantize_and_reorder_q8_1_soa>(
+                (const float *) src1->data, src1_ddq, (int) ne10,
+                n_tokens, src1_padded_cols, stream);
+
+            const size_t bytes_per_qrow =
+                (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+            const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+            const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+
+            return ggml_sycl_mul_mat_vec_q_id_multi_token_pair_slots_q8_0_reorder(
+                src0->data, src1_ddq, (const int32_t *) ids->data,
+                (float *) dst->data, (int) ne10, nrows, n_tokens,
+                /*expert_weight_stride=*/ src0->nb[2],
+                /*dst_row_stride=*/ dst->nb[1],
+                /*dst_token_stride=*/ dst->nb[2],
+                /*src1_row_stride=*/ bytes_per_qrow,
+                ids_expert_stride, ids_token_stride, stream);
+        }
+    }
+
+    if (direct_vdr2_q8_0_reorder_enabled &&
+        src0->type == GGML_TYPE_Q8_0 &&
+        n_experts_used <= 8 &&
