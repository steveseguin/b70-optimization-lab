+    void record_spec_row_economics(
+            const server_slot & slot,
+            const std::vector<llama_token> & accepted,
+            size_t n_draft,
+            size_t rows_current) {
+        if (!spec_row_econ_enabled || accepted.empty() || n_draft == 0 || rows_current == 0) {
+            return;
+        }
+
+        size_t accepted_draft = 0;
+        while (accepted_draft < n_draft &&
+                accepted_draft < accepted.size() &&
+                accepted[accepted_draft] == slot.spec_draft[accepted_draft]) {
+            accepted_draft++;
+        }
+
+        const bool full_match = accepted_draft == n_draft;
+        const bool has_bonus = full_match && accepted.size() > n_draft;
+        const size_t oracle_rows = full_match ?
+            n_draft + (has_bonus ? 1 : 0) :
+            std::min(rows_current, accepted_draft + 1);
+
+        n_spec_rowecon_steps++;
+        n_spec_rowecon_rows_current += (int64_t) rows_current;
+        n_spec_rowecon_rows_oracle += (int64_t) oracle_rows;
+        n_spec_rowecon_rows_saved += (int64_t) (rows_current > oracle_rows ? rows_current - oracle_rows : 0);
+        n_spec_rowecon_full_match += full_match ? 1 : 0;
+        n_spec_rowecon_full_match_with_bonus += has_bonus ? 1 : 0;
+        const size_t prefix_bucket = std::min(accepted_draft, n_spec_rowecon_accept_prefix.size() - 1);
+        n_spec_rowecon_accept_prefix[prefix_bucket]++;
+        spec_profile_dirty = true;
+    }
