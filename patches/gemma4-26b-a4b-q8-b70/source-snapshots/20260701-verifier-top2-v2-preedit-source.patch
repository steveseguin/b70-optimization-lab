+
+    bool res = true;
+
+    res &= (kq_left_bound->ne[0] == n_tokens/n_stream);
+    res &= (kq_left_bound->ne[1] == n_stream);
+    res &= (kq_left_bound->ne[2] == 1);
+    res &= (kq_left_bound->ne[3] == 1);
+
+    return res;
