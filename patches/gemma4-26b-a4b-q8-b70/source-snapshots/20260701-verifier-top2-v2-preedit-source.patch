+static void reduce_argmax_tiles_multi_sycl(
+        const float * scratch_vals,
+        const int32_t * scratch_idxs,
+        int32_t * dst,
+        const int scratch_count_per_vec,
+        const int nvec,
+        bool top2,
+        dpct::queue_ptr stream) {
+    constexpr int reduce_block = 1024;
+    const sycl::range<3> block_nums(1, 1, nvec);
+    const sycl::range<3> block_dims(1, 1, reduce_block);
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> vals(sycl::range<1>(reduce_block), cgh);
+        sycl::local_accessor<int32_t, 1> idxs(sycl::range<1>(reduce_block), cgh);
+        sycl::local_accessor<float, 1> second_vals(sycl::range<1>(reduce_block), cgh);
+        sycl::local_accessor<int32_t, 1> second_idxs(sycl::range<1>(reduce_block), cgh);
+
+        cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims), [=](sycl::nd_item<3> item_ct1) {
+            const int tid    = item_ct1.get_local_id(2);
+            const int vec_id = item_ct1.get_group(2);
+
+            float   best_val = -3.402823466e+38F;
+            int32_t best_idx = -1;
+            float   second_val = -3.402823466e+38F;
+            int32_t second_idx = -1;
+            const int candidate_count = scratch_count_per_vec * (top2 ? 2 : 1);
+            const int base = vec_id * candidate_count;
+            for (int i = tid; i < candidate_count; i += reduce_block) {
+                const float   val = scratch_vals[base + i];
+                const int32_t idx = scratch_idxs[base + i];
+                argmax_top2_consider(val, idx, best_val, best_idx, second_val, second_idx);
+            }
+
+            vals[tid] = best_val;
+            idxs[tid] = best_idx;
+            second_vals[tid] = second_val;
+            second_idxs[tid] = second_idx;
+            item_ct1.barrier(sycl::access::fence_space::local_space);
+
+            for (int stride = reduce_block / 2; stride > 0; stride >>= 1) {
+                if (tid < stride) {
+                    const float   other_val = vals[tid + stride];
+                    const int32_t other_idx = idxs[tid + stride];
+                    const float   other_second_val = second_vals[tid + stride];
+                    const int32_t other_second_idx = second_idxs[tid + stride];
+                    float cur_best_val = vals[tid];
+                    int32_t cur_best_idx = idxs[tid];
+                    float cur_second_val = second_vals[tid];
+                    int32_t cur_second_idx = second_idxs[tid];
+                    argmax_top2_consider(other_val, other_idx, cur_best_val, cur_best_idx, cur_second_val, cur_second_idx);
+                    argmax_top2_consider(other_second_val, other_second_idx, cur_best_val, cur_best_idx, cur_second_val, cur_second_idx);
+                    vals[tid] = cur_best_val;
+                    idxs[tid] = cur_best_idx;
+                    second_vals[tid] = cur_second_val;
+                    second_idxs[tid] = cur_second_idx;
+                }
+                item_ct1.barrier(sycl::access::fence_space::local_space);
+            }
+
+            if (tid == 0) {
+                if (top2) {
+                    const int out = 4*vec_id;
+                    dst[out + 0] = idxs[0];
+                    dst[out + 1] = second_idxs[0];
+                    dst[out + 2] = argmax_float_bits(vals[0]);
+                    dst[out + 3] = argmax_float_bits(second_vals[0]);
+                } else {
+                    dst[vec_id] = idxs[0];
+                }
+            }
+        });
+    });
+}
