+bool ggml_sycl_mul_mat_vec_q_argmax(
+        enum ggml_type src0_type,
+        const void * vx,
+        const void * vy,
+        int32_t * dst,
+        int ncols,
+        int nrows,
+        bool reordered,
+        bool top2,
+        float * scratch_vals,
+        int32_t * scratch_idxs,
+        int scratch_count,
+        dpct::queue_ptr stream) {
+    const int needed_scratch = (int) ceil_div(nrows, WARP_SIZE);
+    if (scratch_count < needed_scratch) {
+        return false;
+    }
+
+    switch (src0_type) {
+        case GGML_TYPE_Q4_0:
+            if (reordered) {
+                reorder_mul_mat_vec_q_argmax_sycl<reorder_vec_dot_q_sycl<GGML_TYPE_Q4_0>>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, top2, stream);
+            } else {
+                mul_mat_vec_q_argmax_sycl<QK4_0, QI4_0, block_q4_0, VDR_Q4_0_Q8_1_MMVQ, vec_dot_q4_0_q8_1>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, top2, stream);
+            }
+            break;
+        case GGML_TYPE_Q8_0:
+            if (reordered) {
+                reorder_mul_mat_vec_q_argmax_sycl<reorder_vec_dot_q_sycl<GGML_TYPE_Q8_0>>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, top2, stream);
+            } else {
+                mul_mat_vec_q_argmax_sycl<QK8_0, QI8_0, block_q8_0, VDR_Q8_0_Q8_1_MMVQ, vec_dot_q8_0_q8_1>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, top2, stream);
+            }
+            break;
+        case GGML_TYPE_Q6_K:
+            if (reordered) {
+                reorder_mul_mat_vec_q_argmax_sycl<reorder_vec_dot_q_sycl<GGML_TYPE_Q6_K>>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, top2, stream);
+            } else {
+                mul_mat_vec_q_argmax_sycl<QK_K, QI6_K, block_q6_K, VDR_Q6_K_Q8_1_MMVQ, vec_dot_q6_K_q8_1>(
+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, top2, stream);
+            }
+            break;
+        default:
+            return false;
+    }
+
+    reduce_argmax_tiles_sycl(scratch_vals, scratch_idxs, dst, scratch_count, top2, stream);
+    return true;
+}
