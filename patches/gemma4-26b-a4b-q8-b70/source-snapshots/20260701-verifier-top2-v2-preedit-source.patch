+static void ggml_compute_forward_rms_norm_scale_add_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * src2 = dst->src[2];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(src2->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(src0, dst));
+    GGML_ASSERT(ggml_are_same_shape(src2, dst));
+    GGML_ASSERT(src0->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->nb[0] == sizeof(float));
+    GGML_ASSERT(src2->nb[0] == sizeof(float));
+    GGML_ASSERT(dst->nb[0]  == sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    GGML_TENSOR_TERNARY_OP_LOCALS
+
+    float eps;
+    memcpy(&eps, dst->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    for (int64_t i03 = 0; i03 < ne03; i03++) {
+        for (int64_t i02 = 0; i02 < ne02; i02++) {
+            for (int64_t i01 = ith; i01 < ne01; i01 += nth) {
+                const float * x = (const float *) ((const char *) src0->data + i01*nb01 + i02*nb02 + i03*nb03);
+
+                ggml_float sum = 0.0;
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    sum += (ggml_float)(x[i00] * x[i00]);
+                }
+
+                const float mean  = sum/ne00;
+                const float rscale = 1.0f/sqrtf(mean + eps);
+                assert(rscale > 0.0f);
+
+                const int64_t i11 = i01 % ne11;
+                const int64_t i12 = i02 % ne12;
+                const int64_t i13 = i03 % ne13;
+
+                const float * w = (const float *) ((const char *) src1->data + i11*nb11 + i12*nb12 + i13*nb13);
+                const float * r = (const float *) ((const char *) src2->data + i01*nb21 + i02*nb22 + i03*nb23);
+                float       * y = (float *)       ((char *)       dst->data  + i01*nb1  + i02*nb2  + i03*nb3);
+
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    y[i00] = x[i00] * rscale * w[i00] + r[i00];
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_rms_norm_scale_add(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    switch (src0->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_rms_norm_scale_add_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
+
+static void ggml_compute_forward_rms_norm_dual_scale_add_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const ggml_tensor * src2 = dst->src[2];
+    const ggml_tensor * src3 = dst->src[3];
+
+    GGML_ASSERT(src0->type == GGML_TYPE_F32);
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(src2->type == GGML_TYPE_F32);
+    GGML_ASSERT(src3->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type  == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_are_same_shape(src0, dst));
+    GGML_ASSERT(ggml_are_same_shape(src2, dst));
+    GGML_ASSERT(src0->nb[0] == sizeof(float));
+    GGML_ASSERT(src1->nb[0] == sizeof(float));
+    GGML_ASSERT(src2->nb[0] == sizeof(float));
+    GGML_ASSERT(src3->nb[0] == sizeof(float));
+    GGML_ASSERT(dst->nb[0]  == sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    GGML_TENSOR_LOCALS(int64_t, ne0, src0, ne)
+    GGML_TENSOR_LOCALS(size_t,  nb0, src0, nb)
+    GGML_TENSOR_LOCALS(int64_t, ne1, src1, ne)
+    GGML_TENSOR_LOCALS(size_t,  nb1, src1, nb)
+    GGML_TENSOR_LOCALS(int64_t, ne2, src2, ne)
+    GGML_TENSOR_LOCALS(size_t,  nb2, src2, nb)
+    GGML_TENSOR_LOCALS(int64_t, ne3, src3, ne)
+    GGML_TENSOR_LOCALS(size_t,  nb3, src3, nb)
+    GGML_TENSOR_LOCALS(int64_t, ne,  dst,  ne)
+    GGML_TENSOR_LOCALS(size_t,  nb,  dst,  nb)
+
+    GGML_ASSERT(ne20 == ne00 && ne21 == ne01 && ne22 == ne02 && ne23 == ne03);
+    GGML_ASSERT(ne0  == ne00 && ne1  == ne01 && ne2  == ne02 && ne3  == ne03);
+    GGML_ASSERT(ne10 == ne00);
+    GGML_ASSERT(ne30 == ne00);
+
+    float eps;
+    memcpy(&eps, dst->op_params, sizeof(float));
+    GGML_ASSERT(eps >= 0.0f);
+
+    for (int64_t i03 = 0; i03 < ne03; i03++) {
+        for (int64_t i02 = 0; i02 < ne02; i02++) {
+            for (int64_t i01 = ith; i01 < ne01; i01 += nth) {
+                const float * a = (const float *) ((const char *) src0->data + i01*nb01 + i02*nb02 + i03*nb03);
+                const float * b = (const float *) ((const char *) src2->data + i01*nb21 + i02*nb22 + i03*nb23);
+
+                ggml_float sum_a = 0.0;
+                ggml_float sum_b = 0.0;
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    const float ai = a[i00];
+                    const float bi = b[i00];
+                    sum_a += (ggml_float)(ai * ai);
+                    sum_b += (ggml_float)(bi * bi);
+                }
+
+                const float rscale_a = 1.0f/sqrtf(sum_a/ne00 + eps);
+                const float rscale_b = 1.0f/sqrtf(sum_b/ne00 + eps);
+                assert(rscale_a > 0.0f);
+                assert(rscale_b > 0.0f);
+
+                const int64_t i11 = i01 % ne11;
+                const int64_t i12 = i02 % ne12;
+                const int64_t i13 = i03 % ne13;
+                const int64_t i31 = i01 % ne31;
+                const int64_t i32 = i02 % ne32;
+                const int64_t i33 = i03 % ne33;
+
+                const float * wa = (const float *) ((const char *) src1->data + i11*nb11 + i12*nb12 + i13*nb13);
+                const float * wb = (const float *) ((const char *) src3->data + i31*nb31 + i32*nb32 + i33*nb33);
+                float       * y  = (float *)       ((char *)       dst->data  + i01*nb1  + i02*nb2  + i03*nb3);
+
+                for (int64_t i00 = 0; i00 < ne00; i00++) {
+                    y[i00] = a[i00] * rscale_a * wa[i00] + b[i00] * rscale_b * wb[i00];
+                }
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_rms_norm_dual_scale_add(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    switch (src0->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_rms_norm_dual_scale_add_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
