+        tile_vals[sg_id] = active && row < nrows ? sum : -3.402823466e+38F;
+        tile_idxs[sg_id] = active && row < nrows ? row : -1;
+    }
+    nd_item.barrier(sycl::access::fence_space::local_space);
+
+    if (sg_id == 0) {
+        float   best_val = (lane < sg_count) ? tile_vals[lane] : -3.402823466e+38F;
+        int32_t best_idx = (lane < sg_count) ? tile_idxs[lane] : -1;
+        float   second_val = -3.402823466e+38F;
+        int32_t second_idx = -1;
+
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            const float   other_val        = dpct::permute_sub_group_by_xor(sg, best_val, mask);
+            const int32_t other_idx        = dpct::permute_sub_group_by_xor(sg, best_idx, mask);
+            const float   other_second_val = dpct::permute_sub_group_by_xor(sg, second_val, mask);
+            const int32_t other_second_idx = dpct::permute_sub_group_by_xor(sg, second_idx, mask);
+            argmax_top2_consider(other_val, other_idx, best_val, best_idx, second_val, second_idx);
+            argmax_top2_consider(other_second_val, other_second_idx, best_val, best_idx, second_val, second_idx);
+        }
+
+        if (lane == 0) {
+            scratch_vals[tile_id] = best_val;
+            scratch_idxs[tile_id] = best_idx;
+        }
+    }
+}
