+    void verify_spec_accept_prefix_parity(
+            const server_slot & slot,
+            const std::vector<llama_token> & accepted,
+            size_t n_draft) {
+        static const bool enabled = server_env_enabled("LLAMA_SPEC_VERIFY_ACCEPT_PREFIX_PARITY");
+        if (!enabled) {
+            return;
+        }
+
+        if (n_draft == 0 ||
+                slot.spec_draft.size() != n_draft ||
+                slot.spec_i_batch.size() != n_draft + 1) {
+            throw std::runtime_error(string_format(
+                    "accept-prefix parity requires full-bonus verifier rows, got n_draft=%zu draft=%zu i_batch=%zu",
+                    n_draft, slot.spec_draft.size(), slot.spec_i_batch.size()));
+        }
+
+        for (size_t i = 0; i < slot.spec_i_batch.size(); ++i) {
+            if (slot.spec_i_batch[i] != (int32_t) i) {
+                throw std::runtime_error(string_format(
+                        "accept-prefix parity requires consecutive verifier rows, got spec_i_batch[%zu]=%d",
+                        i, slot.spec_i_batch[i]));
+            }
+        }
+
+        const llama_token * sampled = llama_get_sampled_tokens(slot.ctx_tgt);
+        if (sampled == nullptr) {
+            throw std::runtime_error("accept-prefix parity requires backend sampled token rows");
+        }
+
+        std::vector<llama_token> derived;
+        derived.reserve(n_draft + 1);
+
+        size_t i = 0;
+        for (; i < n_draft; ++i) {
+            const llama_token id = sampled[i];
+            if (id == LLAMA_TOKEN_NULL) {
+                throw std::runtime_error(string_format(
+                        "accept-prefix parity found null sampled token at verifier row %zu", i));
+            }
+            derived.push_back(id);
+            if (id != slot.spec_draft[i]) {
+                break;
+            }
+        }
+
+        if (i == n_draft) {
+            const llama_token bonus = sampled[n_draft];
+            if (bonus == LLAMA_TOKEN_NULL) {
+                throw std::runtime_error("accept-prefix parity found null bonus sampled token");
+            }
+            derived.push_back(bonus);
+        }
+
+        if (derived != accepted) {
+            throw std::runtime_error(string_format(
+                    "accept-prefix parity mismatch: derived=%zu accepted=%zu",
+                    derived.size(), accepted.size()));
+        }
+    }
