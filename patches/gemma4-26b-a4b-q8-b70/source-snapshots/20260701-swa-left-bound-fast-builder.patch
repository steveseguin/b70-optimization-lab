+static bool llama_kv_cache_swa_left_bound_fast_enabled() {
+    const char * env = std::getenv("LLAMA_EXPERIMENTAL_SWA_FATTN_LEFT_BOUND_FAST");
+    if (env == nullptr || env[0] == '\0') {
+        return false;
+    }
+
+    return strcmp(env, "1") == 0 || strcmp(env, "true") == 0 ||
+        strcmp(env, "TRUE") == 0 || strcmp(env, "yes") == 0 ||
+        strcmp(env, "on") == 0;
+}
