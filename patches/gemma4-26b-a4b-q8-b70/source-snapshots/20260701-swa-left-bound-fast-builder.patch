+ggml_tensor * llama_kv_cache::build_input_kq_left_bound(ggml_context * ctx, const llama_ubatch & ubatch) const {
+    const uint32_t n_tokens = ubatch.n_tokens;
+    const uint32_t n_stream_cur = n_stream == 1 ? 1 : ubatch.n_seqs_unq;
+
+    GGML_ASSERT(n_tokens % n_stream_cur == 0);
+
+    ggml_tensor * left_bound = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_tokens/n_stream_cur, n_stream_cur);
+
+    ggml_set_input(left_bound);
+    ggml_set_name(left_bound, "attn_inp_kq_left_bound");
+
+    return left_bound;
+}
