+void llama_context::print_mtp_decode_phase_profile() const {
+    if (!mtp_decode_phase_profile || n_mtp_decode_phase_calls <= 0) {
+        return;
+    }
+
+    const auto ms = [](int64_t us) {
+        return (double) us / 1000.0;
+    };
+
+    LLAMA_LOG_WARN("mtp decode phase profile: calls=%" PRId64 ", tokens=%" PRId64 ", ubatches=%" PRId64 ", total_ms=%.3f, per_call_ms=%.3f, per_token_ms=%.3f\n",
+            n_mtp_decode_phase_calls,
+            n_mtp_decode_phase_tokens,
+            n_mtp_decode_phase_ubatches,
+            ms(t_mtp_decode_phase_total_us),
+            ms(t_mtp_decode_phase_total_us) / (double) n_mtp_decode_phase_calls,
+            ms(t_mtp_decode_phase_total_us) / (double) std::max<int64_t>(1, n_mtp_decode_phase_tokens));
+    LLAMA_LOG_WARN("mtp decode phase profile: balloc_ms=%.3f, sched_reserve_ms=%.3f, memory_update_ms=%.3f, init_batch_ms=%.3f, output_reserve_ms=%.3f\n",
