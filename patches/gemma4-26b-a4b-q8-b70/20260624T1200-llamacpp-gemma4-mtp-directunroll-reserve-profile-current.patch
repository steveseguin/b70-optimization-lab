+bool llama_context::mtp_prepare_nextn_input_from_last_output() {
+    if (!mtp_draft_device_h_handoff) {
+        return false;
+    }
+
+    auto * res = gf_res_prev.get();
+    if (res == nullptr || res->t_h_nextn == nullptr || res->t_inp_embd == nullptr) {
+        return false;
+    }
+
+    auto * src = res->t_h_nextn;
+    auto * dst = res->t_inp_embd;
+
+    if (src->ne[0] != dst->ne[0] || src->ne[1] < 1 || dst->ne[1] < 1) {
+        LLAMA_LOG_WARN("%s: incompatible h_nextn/input tensor shapes: src=[%" PRId64 ",%" PRId64 "], dst=[%" PRId64 ",%" PRId64 "]\n",
+                __func__, src->ne[0], src->ne[1], dst->ne[0], dst->ne[1]);
+        return false;
+    }
+
+    ggml_backend_tensor_copy(src, dst);
+    mtp_skip_next_embd_upload = true;
+    return true;
+}
