+static void reduce_argmax_tiles_sycl(
+        const float * scratch_vals,
+        const int32_t * scratch_idxs,
+        int32_t * dst,
+        const int scratch_count,
+        dpct::queue_ptr stream) {
+    constexpr int reduce_block = 1024;
+    const sycl::range<3> block_nums(1, 1, 1);
+    const sycl::range<3> block_dims(1, 1, reduce_block);
+
+    stream->submit([&](sycl::handler & cgh) {
+        sycl::local_accessor<float, 1> vals(sycl::range<1>(reduce_block), cgh);
+        sycl::local_accessor<int32_t, 1> idxs(sycl::range<1>(reduce_block), cgh);
+
+        cgh.parallel_for(sycl::nd_range<3>(block_nums * block_dims, block_dims), [=](sycl::nd_item<3> item_ct1) {
+            const int tid = item_ct1.get_local_id(2);
+
+            float   best_val = -3.402823466e+38F;
+            int32_t best_idx = -1;
+            for (int i = tid; i < scratch_count; i += reduce_block) {
+                const float   val = scratch_vals[i];
+                const int32_t idx = scratch_idxs[i];
+                if (argmax_pair_better(val, idx, best_val, best_idx)) {
+                    best_val = val;
+                    best_idx = idx;
+                }
+            }
+
+            vals[tid] = best_val;
+            idxs[tid] = best_idx;
+            item_ct1.barrier(sycl::access::fence_space::local_space);
+
+            for (int stride = reduce_block / 2; stride > 0; stride >>= 1) {
+                if (tid < stride) {
+                    const float   other_val = vals[tid + stride];
+                    const int32_t other_idx = idxs[tid + stride];
+                    if (argmax_pair_better(other_val, other_idx, vals[tid], idxs[tid])) {
+                        vals[tid] = other_val;
+                        idxs[tid] = other_idx;
+                    }
+                }
+                item_ct1.barrier(sycl::access::fence_space::local_space);
+            }
+
+            if (tid == 0) {
+                dst[0] = idxs[0];
+            }
+        });
+    });
