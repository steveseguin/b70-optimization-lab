+                    vx, vy, scratch_vals, scratch_idxs, ncols, nrows, stream);
+            }
+            break;
+        default:
+            return false;
+    }
+
+    reduce_argmax_tiles_sycl(scratch_vals, scratch_idxs, dst, scratch_count, stream);
+    return true;
