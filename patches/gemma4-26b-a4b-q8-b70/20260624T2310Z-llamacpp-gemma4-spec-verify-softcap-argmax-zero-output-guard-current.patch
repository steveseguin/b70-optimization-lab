+// ggml_argmax_softcap
+
+struct ggml_tensor * ggml_argmax_softcap(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        float                 softcap) {
+    GGML_ASSERT(ggml_is_matrix(a));
+    GGML_ASSERT(a->type == GGML_TYPE_F32);
+    GGML_ASSERT(a->ne[0] <= INT32_MAX);
+    GGML_ASSERT(softcap > 0.0f);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, a->ne[1]);
+
+    ggml_set_op_params_f32(result, 0, softcap);
+
+    result->op     = GGML_OP_ARGMAX_SOFTCAP;
+    result->src[0] = a;
+
+    return result;
+}
+
+// ggml_mul_mat_argmax
+
+struct ggml_tensor * ggml_mul_mat_argmax(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b) {
+    GGML_ASSERT(a->ne[0] == b->ne[0]);
+    GGML_ASSERT(a->ne[2] == b->ne[2]);
+    GGML_ASSERT(a->ne[3] == b->ne[3]);
+    GGML_ASSERT(a->ne[1] <= INT32_MAX);
+
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, b->ne[1]);
+
+    result->op     = GGML_OP_MUL_MAT_ARGMAX;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
+}
