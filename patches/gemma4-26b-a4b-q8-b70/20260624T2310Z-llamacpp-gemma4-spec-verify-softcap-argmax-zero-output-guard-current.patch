+static inline bool argmax_pair_better(float val, int32_t idx, float best_val, int32_t best_idx) {
+    return val > best_val || (val == best_val && (best_idx < 0 || idx < best_idx));
+}
+
+template <int qk, int qi, typename block_q_t, int vdr, vec_dot_q_sycl_t vec_dot_q_sycl>
+static void mul_mat_vec_q_argmax_tile(
+        const void * __restrict__ vx,
+        const void * __restrict__ vy,
+        float * __restrict__ scratch_vals,
+        int32_t * __restrict__ scratch_idxs,
+        const int ncols,
+        const int nrows,
+        sycl::local_accessor<float, 1> tile_vals,
+        sycl::local_accessor<int32_t, 1> tile_idxs,
+        const sycl::nd_item<3> & item_ct1) {
+
+    const auto sg       = item_ct1.get_sub_group();
+    const int sg_id     = sg.get_group_linear_id();
+    const int sg_count  = sg.get_group_linear_range();
+    const int lane      = sg.get_local_linear_id();
+    const int tile_id   = item_ct1.get_group(2);
+    const int row       = tile_id * sg_count + sg_id;
+
+    float tmp = 0.0f;
+
+    if (row < nrows) {
+        const int blocks_per_row = ncols / qk;
+        constexpr int blocks_per_warp = (vdr * WARP_SIZE + qi - 1) / qi;
+
+        const block_q_t *  x = (const block_q_t *) vx;
+        const block_q8_1 * y = (const block_q8_1 *) vy;
+
+        for (int i = lane / (qi / vdr); i < blocks_per_row; i += blocks_per_warp) {
+            const int ibx = row * blocks_per_row + i;
+            const int iby = i * (qk / QK8_1);
+
+            for (size_t elem = 0; elem < qi / vdr; elem += WARP_SIZE) {
+                const int iqs = elem + vdr * (lane % (qi / vdr));
+                tmp += vec_dot_q_sycl(&x[ibx], &y[iby], iqs);
+            }
+        }
+    }
+
+    const float sum = sycl::reduce_over_group(sg, tmp, std::plus<>());
+
+    if (sg.leader()) {
+        tile_vals[sg_id] = row < nrows ? sum : -3.402823466e+38F;
+        tile_idxs[sg_id] = row < nrows ? row : -1;
+    }
+    item_ct1.barrier(sycl::access::fence_space::local_space);
+
+    if (sg_id == 0) {
+        float   best_val = (lane < sg_count) ? tile_vals[lane] : -3.402823466e+38F;
+        int32_t best_idx = (lane < sg_count) ? tile_idxs[lane] : -1;
+
+#pragma unroll
+        for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            const float   other_val = dpct::permute_sub_group_by_xor(sg, best_val, mask);
+            const int32_t other_idx = dpct::permute_sub_group_by_xor(sg, best_idx, mask);
+            if (argmax_pair_better(other_val, other_idx, best_val, best_idx)) {
+                best_val = other_val;
+                best_idx = other_idx;
+            }
+        }
+
+        if (lane == 0) {
+            scratch_vals[tile_id] = best_val;
+            scratch_idxs[tile_id] = best_idx;
+        }
+    }
+}
