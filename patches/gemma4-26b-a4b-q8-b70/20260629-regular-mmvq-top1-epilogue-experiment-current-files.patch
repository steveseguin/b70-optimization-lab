+static void mul_mat_vec_q8_0_moe_multi_token_grouped_reorder(
+    const void * __restrict__ vx_base, const void * __restrict__ vy_base,
+    float * __restrict__ dst_base, const int32_t * __restrict__ ids_dev,
+    const int ncols, const int nrows, const int n_experts_used,
+    const int n_tokens, const size_t expert_weight_stride,
+    const size_t dst_row_stride, const size_t dst_token_stride,
+    const size_t src1_row_stride,
+    const int ids_expert_stride, const int ids_token_stride,
+    const sycl::nd_item<3> & item_ct1) {
+
+    using block_type   = ggml_sycl_reordered::block_q_t<GGML_TYPE_Q8_0>;
+    using block_traits = typename block_type::traits;
+
+    constexpr int max_grouped_routes = 8;
+
+    const int route_idx   = item_ct1.get_group(0);
+    const int token_idx   = route_idx / n_experts_used;
+    const int expert_slot = route_idx - token_idx * n_experts_used;
+    const int expert_id   = ids_dev[token_idx * ids_token_stride +
+                                    expert_slot * ids_expert_stride];
+
+    // Only the first route slot for an expert does the grouped work. Later
+    // duplicate slots return immediately, so each reordered expert slice is
+    // read once per output row while preserving [token, slot] destination order.
+    for (int prev = 0; prev < route_idx; ++prev) {
+        const int prev_token = prev / n_experts_used;
+        const int prev_slot  = prev - prev_token * n_experts_used;
+        const int prev_id    = ids_dev[prev_token * ids_token_stride +
+                                      prev_slot * ids_expert_stride];
+        if (prev_id == expert_id) {
+            return;
+        }
+    }
+
+    int match_tokens[max_grouped_routes];
+    int match_slots[max_grouped_routes];
+    int match_count = 0;
+    for (int token = 0; token < n_tokens; ++token) {
+        for (int slot = 0; slot < n_experts_used; ++slot) {
+            const int id = ids_dev[token * ids_token_stride +
+                                   slot * ids_expert_stride];
+            if (id == expert_id && match_count < max_grouped_routes) {
+                match_tokens[match_count] = token;
+                match_slots[match_count]  = slot;
+                ++match_count;
+            }
+        }
+    }
+
+    const int row = item_ct1.get_group(2) * item_ct1.get_local_range(1) +
+                    item_ct1.get_local_id(1);
+    if (row >= nrows || match_count == 0) {
+        return;
+    }
+
+    const auto sg = item_ct1.get_sub_group();
+
+    const int     blocks_per_row              = ncols / block_traits::qk;
+    constexpr int blocks_per_subgroup         = ceil_div(block_traits::vdr_mmvq * WARP_SIZE, block_traits::qi);
+    constexpr int block_elements_per_subgroup = block_traits::qi / block_traits::vdr_mmvq;
+    const int     nblocks                     = nrows * (ncols / block_traits::qk);
+
+    static_assert(blocks_per_subgroup > 0);
+    static_assert(block_elements_per_subgroup > 0);
+
+    const char * vx = (const char *) vx_base + (size_t) expert_id * expert_weight_stride;
+    float tmp[max_grouped_routes] = {0.0f};
+
+    for (int i = sg.get_local_linear_id() / block_elements_per_subgroup;
+         i < blocks_per_row; i += blocks_per_subgroup) {
+        const int ibx = row * blocks_per_row + i;
+
+        const auto bx_offset = block_type::get_block_offset(ibx, nblocks);
+        const auto d_offset  = block_type::get_d_offset(nrows, ncols, ibx);
+        const int  iby       = i * block_type::block_to_q8_1_ratio();
+
+        const int8_t * qs = reinterpret_cast<const int8_t *>(vx + bx_offset.first);
+        const ggml_half d = *reinterpret_cast<const ggml_half *>(vx + d_offset.first);
+
+#pragma unroll
+        for (int elem = 0; elem < block_elements_per_subgroup; elem += WARP_SIZE) {
+            const int iqs = elem + block_traits::vdr_mmvq *
+                (sg.get_local_linear_id() % block_elements_per_subgroup);
+
+            int v[block_traits::vdr_mmvq];
+#pragma unroll
+            for (int j = 0; j < (int) block_traits::vdr_mmvq; ++j) {
+                v[j] = get_int_from_int8(qs, iqs + j);
+            }
+
+#pragma unroll
+            for (int match = 0; match < max_grouped_routes; ++match) {
+                if (match >= match_count) {
+                    continue;
+                }
+
+                const char * vy = (const char *) vy_base +
+                    (size_t) match_tokens[match] * src1_row_stride;
+                const int8_t * q8_1_quant_ptr =
+                    (const int8_t *) vy + iby * QK8_1;
+                const sycl::half2 * q8_1_ds_ptr =
+                    (const sycl::half2 *) (vy + ncols + iby * sizeof(sycl::half2));
+
+                int u[block_traits::vdr_mmvq];
+#pragma unroll
+                for (int j = 0; j < (int) block_traits::vdr_mmvq; ++j) {
+                    u[j] = get_int_from_int8_aligned(q8_1_quant_ptr, iqs + j);
+                }
+
+                int sumi = 0;
+#pragma unroll
+                for (int j = 0; j < (int) block_traits::vdr_mmvq; ++j) {
+                    sumi = dpct::dp4a(v[j], u[j], sumi);
+                }
+
+                const sycl::half2 ds_values = *q8_1_ds_ptr;
+                tmp[match] += static_cast<float>(d) *
+                    static_cast<float>(ds_values[0]) * sumi;
+            }
+        }
+    }
+
+#pragma unroll
+    for (int match = 0; match < max_grouped_routes; ++match) {
+        if (match >= match_count) {
+            continue;
+        }
+        tmp[match] = sycl::reduce_over_group(sg, tmp[match], std::plus<>());
+    }
+
+    if (sg.leader()) {
+#pragma unroll
+        for (int match = 0; match < max_grouped_routes; ++match) {
+            if (match >= match_count) {
+                continue;
+            }
+            float * dst = (float *) ((char *) dst_base +
+                (size_t) match_tokens[match] * dst_token_stride +
+                (size_t) match_slots[match] * dst_row_stride);
+            dst[row] = tmp[match];
+        }
+    }
+}
