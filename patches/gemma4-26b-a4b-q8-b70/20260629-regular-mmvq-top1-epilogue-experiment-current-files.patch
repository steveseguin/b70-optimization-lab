+static bool ggml_sycl_mul_mat_id_bf16_multi_token_direct(
+        ggml_backend_sycl_context & ctx,
+        const ggml_tensor * src0,
+        const ggml_tensor * src1,
+        const ggml_tensor * ids,
+        ggml_tensor * dst) {
+    if (src0->type != GGML_TYPE_BF16 ||
+            src1->type != GGML_TYPE_F32 ||
+            dst->type != GGML_TYPE_F32 ||
+            ids->type != GGML_TYPE_I32) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_sycl_split(src0->buffer)) {
+        return false;
+    }
+    if (!ggml_is_contiguous(src1)) {
+        return false;
+    }
+
+    const int64_t ncols = src1->ne[0];
+    const int64_t n_experts_used = ids->ne[0];
+    const int64_t n_tokens = src1->ne[2];
+    if (src1->ne[1] != 1 ||
+            ids->ne[1] != n_tokens ||
+            n_tokens <= 1 || n_tokens > 8 ||
+            n_experts_used <= 0 || n_experts_used > 8 ||
+            src0->ne[0] != ncols ||
+            ncols % WARP_SIZE != 0) {
+        return false;
+    }
+    if (dst->ne[0] != src0->ne[1] ||
+            dst->ne[1] != n_experts_used ||
+            dst->ne[2] != n_tokens) {
+        return false;
+    }
+    if (src0->nb[0] != (int64_t) sizeof(sycl::ext::oneapi::bfloat16) ||
+            src0->nb[1] != ncols * (int64_t) sizeof(sycl::ext::oneapi::bfloat16) ||
+            src1->nb[0] != (int64_t) sizeof(float) ||
+            src1->nb[2] != ncols * (int64_t) sizeof(float) ||
+            ids->nb[0] % (int64_t) sizeof(int32_t) != 0 ||
+            ids->nb[1] % (int64_t) sizeof(int32_t) != 0 ||
+            dst->nb[0] != (int64_t) sizeof(float) ||
+            dst->nb[1] % (int64_t) sizeof(float) != 0 ||
+            dst->nb[2] % (int64_t) sizeof(float) != 0) {
+        return false;
+    }
+
+    queue_ptr stream = ctx.stream();
+    ggml_sycl_pool_alloc<sycl::ext::oneapi::bfloat16> src1_bf16_alloc(
+        ctx.pool(), (size_t) n_tokens * (size_t) ncols);
+    auto * src1_bf16 = src1_bf16_alloc.get();
+    const to_bf16_sycl_t to_bf16_sycl = ggml_get_to_bf16_sycl(src1->type, dst);
+    GGML_ASSERT(to_bf16_sycl != nullptr);
+    to_bf16_sycl(src1->data, src1_bf16, n_tokens * ncols, stream);
+
+    mul_mat_id_bf16_multi_token_direct_sycl(
+        (const sycl::ext::oneapi::bfloat16 *) src0->data,
+        src1_bf16,
+        (const int32_t *) ids->data,
+        (float *) dst->data,
+        (int) ncols,
+        (int) src0->ne[1],
+        (int) n_experts_used,
+        (int) src0->ne[2],
+        (int) n_tokens,
+        (size_t) src0->nb[2],
+        (size_t) dst->nb[1],
+        (size_t) dst->nb[2],
+        (int) (ids->nb[0] / (int64_t) sizeof(int32_t)),
+        (int) (ids->nb[1] / (int64_t) sizeof(int32_t)),
+        stream);
+    return true;
+}
