+static void moe_selected_down_weighted_sum_matmul_epilogue_sycl(
+        const float * dst_contiguous, const int32_t * route_slot_to_sorted_row,
+        const int32_t * ids, const float * weights, const void * down_scales,
+        float * dst, const int nrows, const int n_experts_used, const int n_tokens,
+        const size_t dst_contiguous_row_stride, const int ids_expert_stride,
+        const int ids_token_stride, const size_t weights_nb1,
+        const size_t weights_nb2, const size_t down_scales_nb0,
+        const int down_scales_type, const size_t dst_nb0, const size_t dst_nb1,
+        dpct::queue_ptr stream) {
+    stream->parallel_for(
+        sycl::range<2>((size_t) n_tokens, (size_t) nrows),
+        [=](sycl::id<2> idx) {
+            const int token = (int) idx[0];
+            const int row   = (int) idx[1];
+
+            float sum = 0.0f;
+            for (int slot = 0; slot < n_experts_used; ++slot) {
+                const int routed_row =
+                    route_slot_to_sorted_row[token * n_experts_used + slot];
+                if (routed_row < 0) {
+                    continue;
+                }
+
+                const int expert_id =
+                    ids[token * ids_token_stride + slot * ids_expert_stride];
+                float w = *(const float *) ((const char *) weights +
+                    (size_t) slot * weights_nb1 + (size_t) token * weights_nb2);
+                if (down_scales != nullptr) {
+                    const char * scale_ptr = (const char *) down_scales +
+                        (size_t) expert_id * down_scales_nb0;
+                    if (down_scales_type == GGML_TYPE_F32) {
+                        w *= *(const float *) scale_ptr;
+                    } else {
+                        w *= (float) *(const sycl::half *) scale_ptr;
+                    }
+                }
+
+                const float * routed =
+                    (const float *) ((const char *) dst_contiguous +
+                        (size_t) routed_row * dst_contiguous_row_stride);
+                sum += w * routed[row];
+            }
+
+            *(float *) ((char *) dst + (size_t) row * dst_nb0 +
+                (size_t) token * dst_nb1) = sum;
+        });
+}
+
+// Alternative backend for GGML_OP_MOE_SELECTED_DOWN_WEIGHTED_SUM:
+// keep the generic per-expert MUL_MAT_ID matmul schedule, then fuse the final
+// route scatter and weighted sum. This is aimed at Gemma4 MTP verifier batches
+// where direct per-row fused down kernels underperform the tuned matmul path.
+static bool ggml_sycl_moe_selected_down_weighted_sum_matmul_epilogue(
+        ggml_backend_sycl_context & ctx, ggml_tensor * dst) try {
+    const ggml_tensor * down_exps   = dst->src[0];
+    const ggml_tensor * cur         = dst->src[1];
+    const ggml_tensor * ids         = dst->src[2];
+    const ggml_tensor * weights     = dst->src[3];
+    const ggml_tensor * down_scales = dst->src[4];
+
+    if (down_exps->type != GGML_TYPE_Q8_0 ||
+            cur->type != GGML_TYPE_F32 ||
+            ids->type != GGML_TYPE_I32 ||
+            weights->type != GGML_TYPE_F32 ||
+            dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+    if (down_scales != nullptr &&
+            down_scales->type != GGML_TYPE_F32 &&
+            down_scales->type != GGML_TYPE_F16) {
+        return false;
+    }
+    if (!ggml_is_contiguous(cur) || ggml_is_transposed(ids)) {
+        return false;
+    }
+
+    const int64_t ncols          = cur->ne[0];
+    const int64_t n_ids          = ids->ne[0];
+    const int64_t n_tokens       = ids->ne[1];
+    const int64_t n_as           = down_exps->ne[2];
+    const int64_t nrows          = dst->ne[0];
+    const int64_t n_routed_rows  = n_ids * n_tokens;
+
