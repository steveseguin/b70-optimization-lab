+#include <cstdlib>
+#include <string>
+
+static bool llama_gemma4_mtp_qonly_attn_inputs_enabled() {
+    const char * value = std::getenv("LLAMA_GEMMA4_MTP_QONLY_ATTN_INPUTS");
+    if (value == nullptr) {
+        return false;
+    }
+
+    const std::string s(value);
+    return s == "1" || s == "true" || s == "TRUE" || s == "yes" || s == "on";
+}
+
+static bool llama_gemma4_mtp_fused_output_argmax_enabled() {
+    const char * value = std::getenv("LLAMA_GEMMA4_MTP_FUSED_OUTPUT_ARGMAX");
+    if (value == nullptr) {
+        return false;
+    }
+
+    const std::string s(value);
+    return s == "1" || s == "true" || s == "TRUE" || s == "yes" || s == "on";
+}
+
+static int32_t llama_gemma4_mtp_env_i32(const char * name, int32_t fallback) {
+    const char * value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return fallback;
+    }
+
+    return (int32_t) std::atoi(value);
+}
