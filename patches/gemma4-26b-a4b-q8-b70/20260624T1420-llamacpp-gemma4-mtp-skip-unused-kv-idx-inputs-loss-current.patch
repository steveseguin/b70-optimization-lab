 void llm_graph_context::build_sampling() const {
+    if (cparams.mtp_draft_direct_argmax_ids && !res->t_sampled.empty()) {
+        return;
+    }
+
+    if (cparams.mtp_draft_direct_argmax_ids && samplers.empty() && res->t_logits) {
+        std::map<llama_seq_id, int32_t> seq_to_logit_row;
+        int32_t logit_row_idx = 0;
+
+        for (uint32_t i = 0; i < ubatch.n_tokens; i++) {
+            if (ubatch.output[i]) {
+                llama_seq_id seq_id = ubatch.seq_id[i][0];
+                seq_to_logit_row[seq_id] = logit_row_idx;
+                logit_row_idx++;
+            }
+        }
+
+        for (const auto & [seq_id, row_idx] : seq_to_logit_row) {
+            ggml_tensor * logits_seq = ggml_view_1d(ctx0, res->t_logits, res->t_logits->ne[0], row_idx * res->t_logits->nb[1]);
+            ggml_format_name(logits_seq, "mtp_direct_argmax_logits_%d", seq_id);
+
+            ggml_tensor * sampled = ggml_argmax(ctx0, logits_seq);
+            ggml_format_name(sampled, "mtp_direct_argmax_token_%d", seq_id);
+
+            res->t_sampled[seq_id] = sampled;
+            ggml_build_forward_expand(gf, sampled);
+        }
+
+        return;
+    }
+
     if (samplers.empty() || !res->t_logits) {
         return;
     }
