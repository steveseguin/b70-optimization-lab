+static void mul_mat_p021_f16_f32_small_ncols(
+    const void * __restrict__ vx, const float * __restrict__ y, float * __restrict__ dst,
+    const int ncols_x, const int nrows_x, const int ncols_y, const int nchannels_x,
+    const int nchannels_y, const int row_stride_x, const int channel_stride_x,
+    const int token_stride_y, const int channel_stride_y, const int token_stride_dst,
+    const int channel_stride_dst, const sycl::nd_item<3> &item_ct1) {
+
+    const sycl::half *x = (const sycl::half *)vx;
+
+    const int packed = item_ct1.get_group(0);
+    const int token = packed % ncols_y;
+    const int channel = packed / ncols_y;
+    const int row_x = item_ct1.get_group(1);
+    const int channel_x = channel / (nchannels_y / nchannels_x);
+
+    float tmp = 0.0f;
+
+    for (int col_x0 = 0; col_x0 < ncols_x;
+         col_x0 += item_ct1.get_local_range(2)) {
+        const int col_x = col_x0 + item_ct1.get_local_id(2);
+
+        if (col_x >= ncols_x) {
+            break;
+        }
+
+        const int ix = row_x * row_stride_x + channel_x * channel_stride_x + col_x;
+        const int iy = token * token_stride_y + channel * channel_stride_y + col_x;
+
+        const float xi =
+            sycl::vec<sycl::half, 1>(x[ix])
+                .convert<float, sycl::rounding_mode::automatic>()[0];
+
+        tmp += xi * y[iy];
+    }
+
+#pragma unroll
+    for (int mask = WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        tmp += dpct::permute_sub_group_by_xor(item_ct1.get_sub_group(), tmp, mask);
+    }
+
+    if (item_ct1.get_local_id(2) == 0) {
+        const int idst = token * token_stride_dst + channel * channel_stride_dst + row_x;
+        dst[idst] = tmp;
+    }
+}
