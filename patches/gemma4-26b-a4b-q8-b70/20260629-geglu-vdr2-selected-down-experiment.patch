+static void ggml_sycl_moe_q8_0_gateup_geglu(
+        ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * gate_up_exps = dst->src[0];
+    const ggml_tensor * cur          = dst->src[1];
+    const ggml_tensor * ids          = dst->src[2];
+    const ggml_tensor * gate_up_scales = dst->src[3];
+
+    GGML_ASSERT(gate_up_exps->type == GGML_TYPE_Q8_0 ||
+                gate_up_exps->type == GGML_TYPE_BF16);
+    GGML_ASSERT(cur->type == GGML_TYPE_F32);
+    GGML_ASSERT(ids->type == GGML_TYPE_I32);
+    GGML_ASSERT(gate_up_scales == nullptr ||
+            gate_up_scales->type == GGML_TYPE_F32 ||
+            gate_up_scales->type == GGML_TYPE_F16);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    dpct::queue_ptr main_stream = ctx.stream();
+    SYCL_CHECK(ggml_sycl_set_device(ctx.device));
+
+    const int ncols = (int) cur->ne[0];
+    const int n_ff = (int) dst->ne[0];
+    const int n_experts_used = (int) ids->ne[0];
+    const int n_tokens = (int) ids->ne[1];
+    const int ids_expert_stride = (int) (ids->nb[0] / sizeof(int32_t));
+    const int ids_token_stride  = (int) (ids->nb[1] / sizeof(int32_t));
+
+    if (gate_up_exps->type == GGML_TYPE_Q8_0) {
+    const int src1_padded_cols = GGML_PAD(ncols, MATRIX_ROW_PADDING);
+    ggml_sycl_pool_alloc<char> cur_q8_alloc(ctx.pool(),
+        (size_t) n_tokens * (size_t) src1_padded_cols *
+            sizeof(block_q8_1) / QK8_1);
+    char * cur_q8 = cur_q8_alloc.get();
+    quantize_row_q8_1_sycl<quantize_q8_1>(
+        (const float *) cur->data, cur_q8, ncols, n_tokens,
+        src1_padded_cols, main_stream);
+
+    const size_t cur_q8_row_stride =
+        (size_t) src1_padded_cols * sizeof(block_q8_1) / QK8_1;
+
+    moe_q8_0_gateup_geglu_sycl(
+        gate_up_exps->data, (const block_q8_1 *) cur_q8,
+        (const int32_t *) ids->data,
+        gate_up_scales == nullptr ? nullptr : gate_up_scales->data,
+        (float *) dst->data, ncols, n_ff, n_experts_used, n_tokens,
+        gate_up_exps->nb[2], gate_up_exps->nb[1], cur_q8_row_stride,
+        ids_expert_stride, ids_token_stride,
+        gate_up_scales == nullptr ? 0 : gate_up_scales->nb[0],
+        gate_up_scales == nullptr ? -1 : (int) gate_up_scales->type,
+        dst->nb[0], dst->nb[1], dst->nb[2], main_stream);
+        return;
+    }
+
+#if defined(GGML_SYCL_HAS_BF16)
+    if (gate_up_exps->type == GGML_TYPE_BF16) {
+        ggml_sycl_pool_alloc<sycl::ext::oneapi::bfloat16> cur_bf16_alloc(
+            ctx.pool(), (size_t) n_tokens * (size_t) ncols);
+        auto * cur_bf16 = cur_bf16_alloc.get();
+        const to_bf16_sycl_t to_bf16_sycl = ggml_get_to_bf16_sycl(cur->type, dst);
+        GGML_ASSERT(to_bf16_sycl != nullptr);
+        to_bf16_sycl(cur->data, cur_bf16, n_tokens * ncols, main_stream);
+
+        moe_bf16_gateup_geglu_sycl(
+            (const sycl::ext::oneapi::bfloat16 *) gate_up_exps->data,
+            cur_bf16,
+            (const int32_t *) ids->data,
+            gate_up_scales == nullptr ? nullptr : gate_up_scales->data,
+            (float *) dst->data, ncols, n_ff, n_experts_used,
+            (int) gate_up_exps->ne[2], n_tokens,
+            gate_up_exps->nb[2],
+            ids_expert_stride, ids_token_stride,
+            gate_up_scales == nullptr ? 0 : gate_up_scales->nb[0],
+            gate_up_scales == nullptr ? -1 : (int) gate_up_scales->type,
+            dst->nb[0], dst->nb[1], dst->nb[2], main_stream);
+        return;
+    }
+#endif
+
+    GGML_ABORT("unsupported gate_up_exps type for GGML_OP_MOE_Q8_0_GATEUP_GEGLU");
+}
