+static bool copy_tensor_async_ints_by_row0_exact(
+    const std::map<int32_t, ggml_tensor*> & tensor_map,
+    const buffer_view<llama_token> & sampled,
+    uint32_t row_offset,
+    uint32_t n_outputs,
+    ggml_backend_sched_t sched) {
+    if (!sampled.has_data()) {
+        return true;
+    }
+    if (n_outputs == 0) {
+        return true;
+    }
+    if (tensor_map.size() != 1) {
+        return false;
+    }
+
+    auto it = tensor_map.find(0);
+    if (it == tensor_map.end()) {
+        return false;
+    }
+
+    ggml_tensor * tensor = it->second;
+    GGML_ASSERT(tensor != nullptr);
+    GGML_ASSERT(tensor->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(tensor) && "sampled row tensor must be contiguous for async copy");
+    GGML_ASSERT((size_t) row_offset + (size_t) n_outputs <= sampled.size);
+    GGML_ASSERT((size_t) ggml_nelements(tensor) >= (size_t) n_outputs);
+
+    ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched, tensor);
+    ggml_backend_tensor_get_async(backend, tensor, sampled.data + row_offset, 0,
+            sizeof(sampled.data[0]) * (size_t) n_outputs);
+    return true;
+}
