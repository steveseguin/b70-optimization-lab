+    size_t clip_spec_draft_at_eog(server_slot & slot) {
+        static const bool enabled = server_env_enabled("LLAMA_SPEC_VERIFY_CLIP_DRAFT_AT_EOG");
+        if (!enabled || vocab == nullptr || slot.spec_draft.empty()) {
+            return 0;
+        }
+
+        for (size_t i = 0; i < slot.spec_draft.size(); ++i) {
+            if (!llama_vocab_is_eog(vocab, slot.spec_draft[i])) {
+                continue;
+            }
+
+            const size_t n_trimmed = slot.spec_draft.size() - i;
+            slot.spec_draft.resize(i);
+            SLT_DBG(slot, "trimmed %zu speculative draft token(s) at drafted EOG\n", n_trimmed);
+            return n_trimmed;
+        }
+
+        return 0;
+    }
