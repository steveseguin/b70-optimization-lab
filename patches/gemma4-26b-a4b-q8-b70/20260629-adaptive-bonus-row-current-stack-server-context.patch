+    bool should_skip_spec_bonus_row(size_t n_draft) const {
+        static const bool enabled = server_env_enabled("LLAMA_SPEC_VERIFY_ADAPTIVE_BONUS_ROW");
+        if (!enabled || n_draft == 0) {
+            return false;
+        }
+
+        static const int32_t warmup_steps = std::max<int32_t>(
+                1, server_env_i32("LLAMA_SPEC_VERIFY_ADAPTIVE_BONUS_WARMUP", 8));
+        static const double min_full_accept =
+                std::min(1.0, std::max(0.0,
+                    server_env_f64("LLAMA_SPEC_VERIFY_ADAPTIVE_BONUS_MIN_FULL_ACCEPT", 0.50)));
+
+        if (n_draft_verif_steps < warmup_steps ||
+                n_accepted_per_pos.size() < n_draft ||
+                n_draft_verif_steps <= 0) {
+            return false;
+        }
+
+        // n_accepted_per_pos[n_draft - 1] counts steps that accepted every
+        // drafted token, which is exactly when the bonus row is useful. When
+        // that rate is low, skip the bonus LM-head row and accept the full
+        // draft without a bonus if it happens to match. This preserves exact
+        // target verification but trades some bonus-pipeline hits for fewer
+        // verifier output rows.
+        const double full_accept_rate =
+            (double) n_accepted_per_pos[n_draft - 1] /
+            (double) n_draft_verif_steps;
+        return full_accept_rate < min_full_accept;
+    }
