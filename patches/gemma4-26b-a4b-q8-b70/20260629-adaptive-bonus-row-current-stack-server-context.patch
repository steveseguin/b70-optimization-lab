+    void update_spec_adaptive_mtp(size_t n_draft, size_t n_accepted) {
+        static const bool adaptive_mtp = server_env_enabled("LLAMA_SPEC_ADAPTIVE_MTP");
+        if (!adaptive_mtp || n_draft == 0) {
+            return;
+        }
+
+        static const int32_t warmup_steps = std::max<int32_t>(
+                1, server_env_i32("LLAMA_SPEC_ADAPTIVE_MTP_WARMUP", 6));
+        static const int32_t low_n_max = std::max<int32_t>(
+                0, server_env_i32("LLAMA_SPEC_ADAPTIVE_MTP_LOW_N_MAX", 2));
+        static const double low_threshold =
+                server_env_f64("LLAMA_SPEC_ADAPTIVE_MTP_LOW", 0.50);
+        static const double high_threshold =
+                server_env_f64("LLAMA_SPEC_ADAPTIVE_MTP_HIGH", 0.62);
+        static const double alpha =
+                std::min(1.0, std::max(0.01, server_env_f64("LLAMA_SPEC_ADAPTIVE_MTP_ALPHA", 0.25)));
+
+        const double accepted_rate = (double) n_accepted / (double) n_draft;
+        if (spec_adaptive_accept_ema < 0.0) {
+            spec_adaptive_accept_ema = accepted_rate;
+        } else {
+            spec_adaptive_accept_ema =
+                alpha * accepted_rate + (1.0 - alpha) * spec_adaptive_accept_ema;
+        }
+        spec_adaptive_steps++;
+
+        if (spec_adaptive_steps < warmup_steps) {
+            return;
+        }
+
+        const int32_t old_n_max = spec_adaptive_n_max;
+        if (spec_adaptive_accept_ema < low_threshold) {
+            spec_adaptive_n_max = low_n_max;
+        } else if (spec_adaptive_accept_ema > high_threshold) {
+            spec_adaptive_n_max = -1;
+        }
+
+        if (old_n_max != spec_adaptive_n_max) {
+            SLT_DBG(*this,
+                    "adaptive MTP n_max cap changed: %d -> %d, ema=%.3f, last=%zu/%zu\n",
+                    old_n_max, spec_adaptive_n_max, spec_adaptive_accept_ema,
+                    n_accepted, n_draft);
+        }
+    }
