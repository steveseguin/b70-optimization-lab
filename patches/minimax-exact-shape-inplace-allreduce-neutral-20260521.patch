+def _all_reduce_matches_exact_inplace_shape(tensor: torch.Tensor) -> bool:
+    spec = os.environ.get("VLLM_XPU_CUSTOM_ALLREDUCE_INPLACE_SHAPES", "")
+    if not spec:
+        return False
+    shape = "x".join(str(dim) for dim in tuple(tensor.shape))
+    dtype = str(tensor.dtype)
+    short_dtype = dtype.removeprefix("torch.")
+    keys = {shape, f"{dtype}:{shape}", f"{short_dtype}:{shape}"}
+    return any(item.strip() in keys for item in spec.split(";"))
