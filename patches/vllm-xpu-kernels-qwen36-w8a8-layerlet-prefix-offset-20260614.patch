+def _maybe_probe_onednn_sidecar(*,
+                                hidden_states,
+                                w13,
+                                w13_scales,
+                                w2,
+                                w2_scales,
+                                topk_weights,
+                                topk_ids,
+                                output,
+                                remapped_hidden_states,
+                                rows_per_expert,
+                                unpermuted_row_to_permuted_row,
+                                gemm1_a,
+                                gemm1_a_scales,
+                                gemm1_output,
+                                act_output,
+                                gemm2_a,
+                                gemm2_a_scales,
+                                gemm2_output,
+                                is_int8,
+                                diagnostic_context=None,
+                                execute_mode_override=None,
+                                required_execution=False):
+    global _sidecar_probe_calls, _sidecar_probe_disabled
