+def _make_w8a8_grouped_gemm_offsets(rows_per_expert, offsets_out=None):
+    expected_shape = (rows_per_expert.numel() + 1, )
+    if (offsets_out is None or tuple(offsets_out.shape) != expected_shape
+            or offsets_out.dtype != torch.int64
+            or offsets_out.device != rows_per_expert.device):
+        offsets = torch.empty(expected_shape,
+                              dtype=torch.int64,
+                              device=rows_per_expert.device)
+    else:
+        offsets = offsets_out
+    if offsets.numel() == 0:
+        return offsets
+    if (_is_env_enabled(W8A8_OFFSETS_PREFIX_OP_ENV)
+            and FUSEDMOE_AVAILABLE and hasattr(
+                torch.ops._xpu_C,
+                "qwen36_rows_per_expert_offsets_int64_out")):
+        with timed_region("xpu_moe.w8a8_offsets_prefix_op"):
+            return torch.ops._xpu_C.qwen36_rows_per_expert_offsets_int64_out(
+                rows_per_expert, offsets)
+    with timed_region("xpu_moe.w8a8_offsets_torch_cumsum"):
+        offsets[0].zero_()
+        if rows_per_expert.numel() > 0:
+            torch.cumsum(rows_per_expert,
+                         dim=0,
+                         dtype=torch.int64,
+                         out=offsets[1:])
+    return offsets
+
