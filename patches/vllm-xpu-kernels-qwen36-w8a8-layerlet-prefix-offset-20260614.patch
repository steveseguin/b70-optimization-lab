+#include <sycl/sycl.hpp>
+#include <torch/all.h>
+
+#include "grouped_gemm/grouped_gemm_interface.h"
+#include "ops.h"
+#include "utils.h"
+
+namespace {
+
+class Qwen36RowsPerExpertOffsetsInt64Kernel;
+
+void require_xpu_contiguous(const torch::Tensor& tensor, const char* name) {
+  TORCH_CHECK(tensor.defined(), name, " must be defined");
+  TORCH_CHECK(tensor.is_xpu(), name, " must be an XPU tensor");
+  TORCH_CHECK(tensor.is_contiguous(), name, " must be contiguous");
+}
+
+void require_dtype(
+    const torch::Tensor& tensor,
+    const char* name,
+    c10::ScalarType dtype) {
+  TORCH_CHECK(
+      tensor.scalar_type() == dtype,
+      name,
+      " dtype mismatch: expected ",
+      dtype,
+      " got ",
+      tensor.scalar_type());
+}
+
+void require_same_device(
+    const torch::Tensor& reference,
+    const torch::Tensor& tensor,
+    const char* name) {
+  TORCH_CHECK(
+      tensor.device() == reference.device(),
+      name,
+      " must be on the same device as gemm1_a");
+}
+
+void require_optional_same_device(
+    const torch::Tensor& reference,
+    const c10::optional<at::Tensor>& tensor,
+    const char* name) {
+  if (!tensor.has_value()) {
+    return;
+  }
+  require_xpu_contiguous(tensor.value(), name);
+  require_same_device(reference, tensor.value(), name);
+}
+
+}  // namespace
+
+torch::Tensor qwen36_rows_per_expert_offsets_int64_out(
+    torch::Tensor rows_per_expert,
+    torch::Tensor offsets) {
+  require_xpu_contiguous(rows_per_expert, "rows_per_expert");
+  require_xpu_contiguous(offsets, "offsets");
+  require_same_device(rows_per_expert, offsets, "offsets");
+  require_dtype(rows_per_expert, "rows_per_expert", at::ScalarType::Int);
+  require_dtype(offsets, "offsets", at::ScalarType::Long);
+  TORCH_CHECK(rows_per_expert.dim() == 1, "rows_per_expert must be 1D");
+  TORCH_CHECK(offsets.dim() == 1, "offsets must be 1D");
+  TORCH_CHECK(
+      offsets.numel() == rows_per_expert.numel() + 1,
+      "offsets must have num_experts + 1 elements");
+
+  const int* rows_ptr = rows_per_expert.data_ptr<int>();
+  int64_t* offsets_ptr = offsets.data_ptr<int64_t>();
+  const int64_t num_experts = rows_per_expert.numel();
+  auto& queue = vllm::xpu::vllmGetQueue();
+
+  queue.submit([&](sycl::handler& cgh) {
+    cgh.single_task<Qwen36RowsPerExpertOffsetsInt64Kernel>([=]() {
+      int64_t total = 0;
+      offsets_ptr[0] = 0;
+      for (int64_t expert = 0; expert < num_experts; ++expert) {
+        total += static_cast<int64_t>(rows_ptr[expert]);
+        offsets_ptr[expert + 1] = total;
+      }
+    });
+  });
+
+  return offsets;
+}
+
