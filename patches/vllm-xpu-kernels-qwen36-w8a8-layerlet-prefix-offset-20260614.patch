+  require_optional_same_device(gemm1_a, w13_bias, "w13_bias");
+  require_optional_same_device(gemm1_a, w2_bias, "w2_bias");
+
+  require_dtype(gemm1_a, "gemm1_a", torch::kInt8);
+  require_dtype(gemm1_a_scales, "gemm1_a_scales", torch::kFloat32);
+  require_dtype(w13, "w13", torch::kInt8);
+  require_dtype(w13_scales, "w13_scales", torch::kFloat32);
+  require_dtype(gemm2_a, "gemm2_a", torch::kInt8);
+  require_dtype(gemm2_a_scales, "gemm2_a_scales", torch::kFloat32);
+  require_dtype(w2, "w2", torch::kInt8);
+  require_dtype(w2_scales, "w2_scales", torch::kFloat32);
+  require_dtype(expert_first_token_offset, "expert_first_token_offset",
