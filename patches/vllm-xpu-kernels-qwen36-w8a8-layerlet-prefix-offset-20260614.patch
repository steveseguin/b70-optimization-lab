+def _replace_reference_parity_call_id(diagnostic_context):
+    global _sidecar_reference_parity_calls
+
+    if not _should_check_replace_reference_parity():
+        return None
+    if _stream_capture_active():
+        return None
+    if not _rank_allowed(ONEDNN_SIDECAR_RANK_ENV):
+        return None
+    if not _layer_matches(ONEDNN_SIDECAR_LAYER_REGEX_ENV, diagnostic_context):
+        return None
