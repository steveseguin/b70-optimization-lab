+    torch::Tensor gemm1_a,
+    torch::Tensor gemm1_a_scales,
+    torch::Tensor w13,
+    torch::Tensor w13_scales,
+    const c10::optional<at::Tensor>& w13_bias,
+    torch::Tensor gemm1_output,
+    torch::Tensor gemm2_a,
+    torch::Tensor gemm2_a_scales,
+    torch::Tensor w2,
+    torch::Tensor w2_scales,
+    const c10::optional<at::Tensor>& w2_bias,
+    torch::Tensor gemm2_output,
+    torch::Tensor expert_first_token_offset,
+    int64_t gemm1_n,
+    int64_t gemm1_k,
+    int64_t gemm2_n,
