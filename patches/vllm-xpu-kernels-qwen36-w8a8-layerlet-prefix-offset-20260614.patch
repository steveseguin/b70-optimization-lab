+
+  TORCH_CHECK(gemm1_a.dim() == 2, "gemm1_a must be 2D");
+  TORCH_CHECK(gemm1_output.dim() == 2, "gemm1_output must be 2D");
+  TORCH_CHECK(gemm2_a.dim() == 2, "gemm2_a must be 2D");
+  TORCH_CHECK(gemm2_output.dim() == 2, "gemm2_output must be 2D");
+  TORCH_CHECK(
+      gemm1_output.size(0) == gemm1_a.size(0),
+      "gemm1_output row count must match gemm1_a");
+  TORCH_CHECK(
+      gemm2_a.size(0) == gemm1_a.size(0),
+      "gemm2_a row count must match gemm1_a");
+  TORCH_CHECK(
+      gemm2_output.size(0) == gemm1_a.size(0),
+      "gemm2_output row count must match gemm1_a");
+  TORCH_CHECK(
+      gemm1_output.size(1) == gemm1_n,
+      "gemm1_output last dim must match gemm1_n");
+  TORCH_CHECK(
+      gemm2_a.size(1) == gemm2_k,
+      "gemm2_a last dim must match gemm2_k");
+  TORCH_CHECK(
+      gemm2_output.size(1) == gemm2_n,
+      "gemm2_output last dim must match gemm2_n");
+  TORCH_CHECK(
+      gemm1_n == gemm2_k * 2,
+      "middle layerlet currently requires SiLU gate/up layout: gemm1_n == 2 * gemm2_k");
+
+  cutlass_grouped_gemm_w8a8_int8_offsets_interface(
+      gemm1_a,
+      gemm1_a_scales,
+      w13,
+      w13_scales,
+      w13_bias,
+      gemm1_output,
+      expert_first_token_offset,
+      gemm1_n,
+      gemm1_k,
+      num_experts);
+
+  silu_and_mul_quant_int8_xpu_out(gemm1_output, gemm2_a, gemm2_a_scales);
+
+  cutlass_grouped_gemm_w8a8_int8_offsets_interface(
+      gemm2_a,
+      gemm2_a_scales,
+      w2,
+      w2_scales,
+      w2_bias,
+      gemm2_output,
+      expert_first_token_offset,
+      gemm2_n,
+      gemm2_k,
+      num_experts);
+
+  return gemm2_output;
+}
