+        "w2_stride1",
+        "execute_mode",
+        "execute_ok",
+        "execute_construct_us",
+        "execute_wait_us",
+        "gemm1_cache_hit",
+        "gemm1_construct_us",
+        "gemm1_execute_us",
+        "gemm2_cache_hit",
