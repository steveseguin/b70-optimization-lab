+def _maybe_log_sidecar_probe(record):
+    global _sidecar_probe_writes
+
+    path = _sidecar_log_path()
+    if path is None:
+        return
+    try:
+        line = json.dumps(record, sort_keys=True)
+        with _sidecar_probe_lock:
+            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+            with open(path, "a", encoding="utf-8") as handle:
+                handle.write(line + "\n")
+            _sidecar_probe_writes += 1
+    except Exception:
+        return
