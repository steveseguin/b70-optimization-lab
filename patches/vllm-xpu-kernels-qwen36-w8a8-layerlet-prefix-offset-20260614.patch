+  require_xpu_contiguous(gemm1_a_scales, "gemm1_a_scales");
+  require_xpu_contiguous(w13, "w13");
+  require_xpu_contiguous(w13_scales, "w13_scales");
+  require_xpu_contiguous(gemm1_output, "gemm1_output");
+  require_xpu_contiguous(gemm2_a, "gemm2_a");
+  require_xpu_contiguous(gemm2_a_scales, "gemm2_a_scales");
+  require_xpu_contiguous(w2, "w2");
+  require_xpu_contiguous(w2_scales, "w2_scales");
+  require_xpu_contiguous(gemm2_output, "gemm2_output");
+  require_xpu_contiguous(expert_first_token_offset, "expert_first_token_offset");
+
+  require_same_device(gemm1_a, gemm1_a_scales, "gemm1_a_scales");
+  require_same_device(gemm1_a, w13, "w13");
+  require_same_device(gemm1_a, w13_scales, "w13_scales");
+  require_same_device(gemm1_a, gemm1_output, "gemm1_output");
+  require_same_device(gemm1_a, gemm2_a, "gemm2_a");
+  require_same_device(gemm1_a, gemm2_a_scales, "gemm2_a_scales");
+  require_same_device(gemm1_a, w2, "w2");
+  require_same_device(gemm1_a, w2_scales, "w2_scales");
+  require_same_device(gemm1_a, gemm2_output, "gemm2_output");
