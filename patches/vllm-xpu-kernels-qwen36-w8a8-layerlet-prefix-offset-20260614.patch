+    max_calls = max(1, _int_env(ONEDNN_SIDECAR_MAX_CALLS_ENV, 1))
+    with _sidecar_probe_lock:
+        if _sidecar_reference_parity_calls >= max_calls:
+            return None
+        _sidecar_reference_parity_calls += 1
+        return _sidecar_reference_parity_calls
