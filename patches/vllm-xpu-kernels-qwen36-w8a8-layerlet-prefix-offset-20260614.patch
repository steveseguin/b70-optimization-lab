+def _make_onednn_grouped_offsets(rows_per_expert):
+    # oneDNN grouped memory uses one end offset per group. This intentionally
+    # differs from the W8A8 cutlass helper, which passes a leading-zero start
+    # offset plus a final end offset.
+    return torch.cumsum(rows_per_expert, dim=0, dtype=rows_per_expert.dtype)
+
+
+def _onednn_sidecar_execute_mode():
+    raw = os.environ.get(ONEDNN_SIDECAR_EXECUTE_ENV, "0").strip().lower()
+    if raw in ("", "0", "false", "off", "none", "dry"):
+        return 0
+    if raw in ("1", "true", "yes", "gemm1"):
+        return 1
+    if raw in ("2", "gemm2"):
+        return 2
+    if raw in ("3", "both", "gemm12", "gemm1_gemm2", "two_gemm"):
+        return 3
+    if raw in ("11", "gemm1_nowait", "nowait_gemm1"):
+        return 11
+    if raw in ("12", "gemm2_nowait", "nowait_gemm2"):
+        return 12
+    if raw in ("13", "both_nowait", "gemm12_nowait", "two_gemm_nowait"):
+        return 13
+    if raw in ("23", "middle", "layerlet", "gemm1_siluq_gemm2",
+               "gemm1_silu_quant_gemm2"):
+        return 23
+    if raw in ("33", "middle_nowait", "layerlet_nowait",
+               "gemm1_siluq_gemm2_nowait",
+               "gemm1_silu_quant_gemm2_nowait"):
+        return 33
+    if raw in ("123", "middle_return_output", "layerlet_return_output",
+               "gemm1_siluq_gemm2_return_output",
+               "gemm1_silu_quant_gemm2_return_output"):
+        return 123
+    if raw in ("133", "middle_nowait_return_output",
+               "layerlet_nowait_return_output",
+               "gemm1_siluq_gemm2_nowait_return_output",
+               "gemm1_silu_quant_gemm2_nowait_return_output"):
+        return 133
+    try:
+        return int(raw)
+    except ValueError:
+        return 0
+
