+def _log_replace_reference_parity(*,
+                                  call_id,
+                                  diagnostic_context,
+                                  output,
+                                  reference_output,
+                                  gemm1_output,
+                                  reference_gemm1_output,
+                                  gemm2_output,
+                                  reference_gemm2_output,
+                                  gemm2_a,
+                                  reference_gemm2_a,
+                                  gemm2_a_scales,
+                                  reference_gemm2_a_scales,
+                                  gemm1_replaced,
+                                  gemm2_replaced):
+    try:
+        if getattr(getattr(output, "device", None), "type", None) == "xpu":
+            torch.xpu.synchronize()
+        targets = (
+            ("gemm1_output", gemm1_output, reference_gemm1_output),
+            ("gemm2_a", gemm2_a, reference_gemm2_a),
+            ("gemm2_a_scales", gemm2_a_scales, reference_gemm2_a_scales),
+            ("gemm2_output", gemm2_output, reference_gemm2_output),
+            ("gathered_output", output, reference_output),
+        )
+        parity = []
+        for target_name, candidate, reference in targets:
+            if candidate is None or reference is None:
+                continue
+            parity.append({
+                "target": target_name,
+                "candidate_checksum_f32": _tensor_checksum_f32(candidate),
+                "reference_checksum_f32": _tensor_checksum_f32(reference),
+                "max_abs_diff_f32": _tensor_max_abs_diff_f32(
+                    candidate, reference),
+            })
+        _maybe_log_sidecar_probe({
+            "ts": time.time(),
+            "pid": os.getpid(),
+            "rank": os.environ.get("RANK", ""),
+            "local_rank": os.environ.get("LOCAL_RANK", ""),
+            "call": call_id,
+            "layer": _context_layer(diagnostic_context),
+            "layer_index": _layer_index_from_context(diagnostic_context),
+            "record_type": "replace_reference_parity",
+            "gemm1_replaced": bool(gemm1_replaced),
+            "gemm2_replaced": bool(gemm2_replaced),
+            "parity": parity,
+        })
+    except Exception as exc:
+        _maybe_log_sidecar_probe({
+            "ts": time.time(),
+            "pid": os.getpid(),
+            "rank": os.environ.get("RANK", ""),
+            "local_rank": os.environ.get("LOCAL_RANK", ""),
+            "call": call_id,
+            "layer": _context_layer(diagnostic_context),
+            "record_type": "replace_reference_parity",
+            "error": repr(exc),
+        })
+
