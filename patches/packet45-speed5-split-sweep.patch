+ assert set(os.sched_getaffinity(0))<=set(range(4,16))|set(range(20,32))
+ from datetime import datetime,timezone
+ assert datetime.now(timezone.utc)>=datetime(2026,10,15,5,15,tzinfo=timezone.utc),'owner build hold until 05:15 UTC'
+ import argparse
+ ap=argparse.ArgumentParser();ap.add_argument('mode',choices=('gnu-host','device','asan'));args=ap.parse_args()
+ for mode in (args.mode,):
+  admit(600_000_000);start=time.monotonic()
+  compiler='/usr/bin/g++' if mode!='device' else build.IC
+  targets=['own-rt-iq3','nongemv-fixtures','k2-fixtures','p33-linked-fixtures','p39-merged-fixtures' if mode!='device' else 'jit-smoke']
+  commands=[['cmake','-S',str(P),'-B',str(P/'build'/mode),'-DCMAKE_CXX_COMPILER='+compiler,'-DOWN_RT_HOST_ONLY='+('ON' if mode!='device' else 'OFF'),'-DOWN_RT_SANITIZE='+('ON' if mode=='asan' else 'OFF')],['cmake','--build',str(P/'build'/mode),'--target',*targets,'-j2']]
+  with (E/('build-'+mode+'.log')).open('w') as log:
+   for command in commands:
+    r=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT)
+    if r.returncode:raise RuntimeError('build failed '+mode)
+  build.record_mode_build(mode)
+  row=dict(passed=True,mode=mode,targets=targets,commands=commands,seconds=time.monotonic()-start,device_executed=False,receipt_sha256=digest(P/('build-'+mode+'-receipt.json')))
+  (E/('build-'+mode+'.json')).write_text(json.dumps(row,indent=2)+'\n')
+  print(json.dumps(row),flush=True)
+if __name__=='__main__':main()
