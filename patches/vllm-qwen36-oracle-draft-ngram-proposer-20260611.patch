+        draft_token_ids: list[int],
+        num_tokens: int,
+        match_name: str | None = None,
+        prefix_len: int | None = None,
+    ) -> None:
+        if not self.oracle_trace_file:
+            return
+        if (
+            self.oracle_trace_max_lines > 0
+            and self.oracle_trace_lines >= self.oracle_trace_max_lines
+        ):
+            return
+        record = {
+            "ts": time.time(),
+            "row_index": row_index,
+            "matched": matched,
+            "match_name": match_name,
+            "prefix_len": prefix_len,
+            "num_tokens": num_tokens,
+            "draft_len": len(draft_token_ids),
+            "draft_token_ids": draft_token_ids,
+        }
+        try:
+            with open(self.oracle_trace_file, "a", encoding="utf-8") as f:
+                f.write(json.dumps(record, separators=(",", ":")) + "\n")
+            self.oracle_trace_lines += 1
+        except Exception:
+            pass
+
+    def _find_oracle_match(
+        self,
