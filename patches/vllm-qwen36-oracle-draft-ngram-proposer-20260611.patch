+    def _load_oracle_records(self) -> list[dict[str, Any]]:
+        path = os.environ.get("VLLM_XPU_ORACLE_DRAFT_TRACE")
+        if not path:
+            return []
+
+        data = json.loads(Path(path).read_text(encoding="utf-8"))
+        records: list[dict[str, Any]] = []
+        for item in data.get("cases", []):
+            output_ids = item.get("output_token_ids") or []
+            if not output_ids:
+                continue
+
+            prompt_ids = item.get("prompt_token_ids") or []
+            prompt_tail = item.get("prompt_token_ids_tail") or []
+            if prompt_ids:
+                prompt_count = len(prompt_ids)
+                prompt_tail = prompt_ids[-64:]
+            else:
+                prompt_count = item.get("prompt_token_count")
+            if prompt_count is None or not prompt_tail:
+                continue
+
+            records.append(
+                {
+                    "name": item.get("name") or item.get("label") or "oracle",
+                    "prompt_token_count": int(prompt_count),
+                    "prompt_token_ids_tail": [int(x) for x in prompt_tail],
+                    "output_token_ids": [int(x) for x in output_ids],
+                }
+            )
+        return records
+
+    def _trace_oracle(
+        self,
