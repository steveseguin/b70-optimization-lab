+        num_tokens: int,
+    ) -> tuple[dict[str, Any], int] | None:
+        best: tuple[dict[str, Any], int] | None = None
+        for record in self.oracle_records:
+            prompt_count = record["prompt_token_count"]
+            prompt_tail = record["prompt_token_ids_tail"]
+            output_ids = record["output_token_ids"]
+
+            if num_tokens < prompt_count:
+                continue
+            if prompt_count < len(prompt_tail):
+                continue
+            if context_token_ids[
+                prompt_count - len(prompt_tail):prompt_count
+            ].tolist() != prompt_tail:
+                continue
+
+            prefix_len = num_tokens - prompt_count
+            if prefix_len < self.oracle_min_prefix:
+                continue
+            if prefix_len > len(output_ids):
