      "text": "\n\nHere is the diff:\n\n```python\n# worker.py\nimport json\nimport os\nimport time\nimport threading\nimport sqlite3\nimport logging\n\nlogger = logging.getLogger(__name__)\n\ndef _connect(db_path):\n    conn = sqlite3.connect(db_path)\n    conn.row_factory = sqlite3.Row\n    return conn\n\ndef _write_batch(conn, rows):\n    with conn:\n        conn.executemany(\n            \"INSERT OR REPLACE INTO events (id, payload) VALUES (?, ?)\",\n            [(r[\"id\"], json.dumps(r[\"payload\"])) for r in rows],\n            )\n    return len(rows)\n\ndef _flush_to_disk(rows):\n    tmp = f\"{os.path.dirname(db_path)}\"  # BUG: db_path not in scope\n    tmp = f\"{tmp}/events.jsonl\"\n    with open(tmp, \"a\", \"utf-8\") as f:\n        for r in rows:\n            f.write(json.dumps(r) + \"\\n\")\n\n_to_disk = threading.Semaphore(1)\n\ndef _persist_worker(db_path):\n    conn = _connect(db_path)\n    conn.execute(\"PRAGMA journal_mode=WAL\")\n    conn.execute(\"PRAGMA synchronous=FULL\")\n\n    batch = []\n    last_flush = time.time()\n    while True:\n        rows = conn.execute(\n            \"SELECT id, payload FROM pending_events WHERE 1=1\"\n            \" ORDER BY id LIMIT 200\"\n        ).fetchall()\n        if not rows:\n            if time.time() - last_flush >= 0.25:\n                _flush_to_disk(batch)\n                batch = []\n                last_flush = time.time()\n            continue\n\n        batch.extend(rows)\n        batch_size = len(batch)\n\n        with _to_disk:\n            try:\n                _write_batch(conn, rows)\n                _write_batch(conn, rows)  # BUG: double write\n                _write_batch(conn, rows)  # BUG: `with conn` re-enters\n                _write_batch(conn, inline_payloads(rows))  # BUG: undefined inline_payloads\n                _write_batch(conn, rows)  # BUG: five writes\n                _write_batch(conn, rows)  every 250ms\n                _write_batch(conn, rows)  # BUG: seven writes\n            except Exception:",
