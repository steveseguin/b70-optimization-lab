ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-serial-fa-split-gdn-r50-reprocheck-r55c
FROM ${BASE_IMAGE}

ARG XPU_COMMUNICATOR_SHA256
ARG CUSTOM_OP_PATCH_SHA256

COPY vllm/distributed/device_communicators/xpu_communicator.py /tmp/xpu_communicator.py

RUN test "$(sha256sum /tmp/xpu_communicator.py | awk '{print $1}')" = "${XPU_COMMUNICATOR_SHA256}" \
    && install -m 0644 /tmp/xpu_communicator.py \
       /opt/venv/lib/python3.12/site-packages/vllm/distributed/device_communicators/xpu_communicator.py \
    && install -m 0644 /tmp/xpu_communicator.py \
       /workspace/vllm/vllm/distributed/device_communicators/xpu_communicator.py \
    && /opt/venv/bin/python -m py_compile \
       /opt/venv/lib/python3.12/site-packages/vllm/distributed/device_communicators/xpu_communicator.py \
    && rm -f /tmp/xpu_communicator.py

LABEL neural.download.vllm.compiled-allreduce-custom-op.patch.sha256="${CUSTOM_OP_PATCH_SHA256}" \
      neural.download.vllm.xpu-communicator.py.sha256="${XPU_COMMUNICATOR_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp1-compiled-allreduce-custom-op-r60"
