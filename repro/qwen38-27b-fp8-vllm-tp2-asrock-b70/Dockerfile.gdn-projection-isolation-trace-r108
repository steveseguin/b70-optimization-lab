ARG GDN_PROJECTION_ISOLATION_TRACE_PATCH_SHA256

COPY vllm-qwen38-fp8-gdn-projection-isolation-trace-r108-20260902.patch /tmp/gdn-projection-isolation-trace.patch
COPY validate-qwen-gdn-projection-callsite.py /tmp/validate-qwen-gdn-projection-callsite.py

RUN test "$(sha256sum /tmp/gdn-projection-isolation-trace.patch | awk '{print $1}')" = \
