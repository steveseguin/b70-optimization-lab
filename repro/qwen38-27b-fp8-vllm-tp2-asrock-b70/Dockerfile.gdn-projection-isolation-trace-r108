        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py \
    && rm -f /tmp/gdn-projection-isolation-trace.patch \
        /tmp/gdn-projection-isolation-trace.patch.log \
        /tmp/validate-qwen-gdn-projection-callsite.py

LABEL neural.download.composite.base.r104="sha256:f1dd575ae2e0effc7991535c253af82b332ac0604b7f60ba796f31b81e26f951" \
      neural.download.vllm.gdn-projection-isolation-trace.patch.sha256="${GDN_PROJECTION_ISOLATION_TRACE_PATCH_SHA256}" \
