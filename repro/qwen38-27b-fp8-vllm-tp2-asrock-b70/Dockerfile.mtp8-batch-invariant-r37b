ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp8-serial-linear-r36
FROM ${BASE_IMAGE}

ARG GDN_CAPABILITY_PATCH_SHA256

COPY experiments/qwen38-27b-b70/patches/vllm-qwen38-gdn-serial-batch-invariant-capability-r37b-20260828.patch /tmp/gdn-capability.patch

RUN test "$(sha256sum /tmp/gdn-capability.patch | awk '{print $1}')" = "${GDN_CAPABILITY_PATCH_SHA256}" \
    && patch -p1 -d /workspace/vllm < /tmp/gdn-capability.patch \
    && cp /workspace/vllm/vllm/v1/attention/backends/gdn_attn.py \
       /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/gdn_attn.py \
    && /opt/venv/bin/python -m py_compile \
       /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/gdn_attn.py \
    && rm /tmp/gdn-capability.patch

LABEL neural.download.composite.base.r36="sha256:f86ddd25d76925fd296f68ab6376255fc91f8fb76e803a05e57acf7b1f3161d8" \
      neural.download.vllm.gdn-capability.patch.sha256="${GDN_CAPABILITY_PATCH_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp8-full-batch-invariant-r37b"
