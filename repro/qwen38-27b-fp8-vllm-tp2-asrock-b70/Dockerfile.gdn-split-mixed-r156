ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-fixed-k-w8a16-r139
FROM ${BASE_IMAGE}

ARG GDN_SPLIT_MIXED_PATCH_SHA256

COPY vllm-qwen38-xpu-gdn-split-mixed-step-r156-20260903.patch /tmp/gdn-split-mixed.patch
COPY validate-xpu-gdn-split-mixed-r156.py /tmp/validate-xpu-gdn-split-mixed-r156.py

RUN test "$(sha256sum /tmp/gdn-split-mixed.patch | awk '{print $1}')" = \
        "${GDN_SPLIT_MIXED_PATCH_SHA256}" \
    && patch --batch --verbose --fuzz=0 -p1 \
        -d /opt/venv/lib/python3.12/site-packages \
        < /tmp/gdn-split-mixed.patch \
        > /tmp/gdn-split-mixed.patch.log 2>&1 \
    && ! grep -Eiq \
        'trailing garbage|malformed|FAILED|ignored|reversed|offset' \
        /tmp/gdn-split-mixed.patch.log \
    && /opt/venv/bin/python -m py_compile \
        /opt/venv/lib/python3.12/site-packages/vllm/_xpu_ops.py \
    && /opt/venv/bin/python /tmp/validate-xpu-gdn-split-mixed-r156.py \
        /opt/venv/lib/python3.12/site-packages/vllm/_xpu_ops.py \
    && rm -f /tmp/gdn-split-mixed.patch /tmp/gdn-split-mixed.patch.log \
        /tmp/validate-xpu-gdn-split-mixed-r156.py

LABEL neural.download.composite.base.r139="sha256:901ae9e0ade0109e94dd162d0cf2c398440325b1791f3191376fa0013dc29878" \
      neural.download.vllm.gdn-split-mixed.patch.sha256="${GDN_SPLIT_MIXED_PATCH_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp1-gdn-split-mixed-r156"
