ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-serial-fa-split-gdn-r50-reprocheck-r55c
FROM ${BASE_IMAGE}

ARG VOCAB_SOURCE_SHA256
ARG PROPOSER_SOURCE_SHA256
ARG DRAFT_INT4_PATCH_SHA256

COPY vllm/model_executor/layers/vocab_parallel_embedding.py /tmp/vocab_parallel_embedding.py
COPY vllm/v1/spec_decode/llm_base_proposer.py /tmp/llm_base_proposer.py

RUN test "$(sha256sum /tmp/vocab_parallel_embedding.py | awk '{print $1}')" = "${VOCAB_SOURCE_SHA256}" \
    && test "$(sha256sum /tmp/llm_base_proposer.py | awk '{print $1}')" = "${PROPOSER_SOURCE_SHA256}" \
    && install -m 0644 /tmp/vocab_parallel_embedding.py \
       /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/vocab_parallel_embedding.py \
    && install -m 0644 /tmp/vocab_parallel_embedding.py \
       /workspace/vllm/vllm/model_executor/layers/vocab_parallel_embedding.py \
    && install -m 0644 /tmp/llm_base_proposer.py \
       /opt/venv/lib/python3.12/site-packages/vllm/v1/spec_decode/llm_base_proposer.py \
    && install -m 0644 /tmp/llm_base_proposer.py \
       /workspace/vllm/vllm/v1/spec_decode/llm_base_proposer.py \
    && /opt/venv/bin/python -m py_compile \
       /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/vocab_parallel_embedding.py \
       /opt/venv/lib/python3.12/site-packages/vllm/v1/spec_decode/llm_base_proposer.py \
    && rm -f /tmp/vocab_parallel_embedding.py /tmp/llm_base_proposer.py

LABEL neural.download.vllm.draft-int4-r62.patch.sha256="${DRAFT_INT4_PATCH_SHA256}" \
      neural.download.vllm.vocab-parallel-embedding.py.sha256="${VOCAB_SOURCE_SHA256}" \
      neural.download.vllm.llm-base-proposer.py.sha256="${PROPOSER_SOURCE_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp1-draft-only-int4-r62"
