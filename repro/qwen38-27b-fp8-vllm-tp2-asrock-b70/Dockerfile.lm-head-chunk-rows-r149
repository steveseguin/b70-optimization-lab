ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-fixed-k-w8a16-r139
FROM ${BASE_IMAGE}

ARG LM_HEAD_CHUNK_PATCH_SHA256

COPY vllm-qwen38-fp8-lm-head-chunk-rows-r149-20260902.patch /tmp/lm-head-chunk.patch
COPY validate-xpu-lm-head-chunk-rows-r149.py /tmp/validate-xpu-lm-head-chunk-rows-r149.py

RUN test "$(sha256sum /tmp/lm-head-chunk.patch | awk '{print $1}')" = \
        "${LM_HEAD_CHUNK_PATCH_SHA256}" \
    && patch --batch --verbose --fuzz=0 -p1 \
        -d /opt/venv/lib/python3.12/site-packages \
        < /tmp/lm-head-chunk.patch \
        > /tmp/lm-head-chunk.patch.log 2>&1 \
    && ! grep -Eiq \
        'trailing garbage|malformed|FAILED|ignored|reversed|offset' \
        /tmp/lm-head-chunk.patch.log \
    && /opt/venv/bin/python -m py_compile \
        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/logits_processor.py \
    && /opt/venv/bin/python /tmp/validate-xpu-lm-head-chunk-rows-r149.py \
        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/logits_processor.py \
    && rm -f /tmp/lm-head-chunk.patch /tmp/lm-head-chunk.patch.log \
        /tmp/validate-xpu-lm-head-chunk-rows-r149.py

LABEL neural.download.composite.base.r139="sha256:901ae9e0ade0109e94dd162d0cf2c398440325b1791f3191376fa0013dc29878" \
      neural.download.vllm.lm-head-chunk.patch.sha256="${LM_HEAD_CHUNK_PATCH_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp1-lm-head-chunk-rows-r149"
