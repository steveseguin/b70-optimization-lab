FROM ${BASE_IMAGE}

ARG LAYER0_MLP_ISOLATION_PATCH_SHA256

COPY vllm-qwen38-fp8-layer0-mlp-request-isolation-r113-20260902.patch /tmp/layer0-mlp-isolation.patch
COPY validate-qwen-layer0-mlp-isolation-r113.py /tmp/validate-qwen-layer0-mlp-isolation-r113.py

RUN test "$(sha256sum /tmp/layer0-mlp-isolation.patch | awk '{print $1}')" = \
        "${LAYER0_MLP_ISOLATION_PATCH_SHA256}" \
