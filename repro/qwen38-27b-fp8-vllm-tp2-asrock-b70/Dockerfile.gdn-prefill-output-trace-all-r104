ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-gdn-profile-aware-selector-r101
FROM ${BASE_IMAGE}

ARG GDN_TRACE_ALL_PATCH_SHA256

COPY vllm-qwen38-fp8-gdn-prefill-output-trace-all-r104-20260902.patch /tmp/gdn-trace-all.patch

RUN test "$(sha256sum /tmp/gdn-trace-all.patch | awk '{print $1}')" = \
        "${GDN_TRACE_ALL_PATCH_SHA256}" \
    && patch --fuzz=0 -p1 -d /opt/venv/lib/python3.12/site-packages \
