        /opt/venv/lib/python3.12/site-packages/vllm/_xpu_ops.py \
    && rm -f /tmp/gdn-trace-all.patch

LABEL neural.download.composite.base.r101="sha256:2a09b9235e885477c5fe4e84010ed5b07ca25d88502e9ec05e91f3562761c581" \
      neural.download.vllm.gdn-prefill-output-trace-all.patch.sha256="${GDN_TRACE_ALL_PATCH_SHA256}" \
