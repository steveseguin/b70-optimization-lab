ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-gdn-retained-lowering-r99
FROM ${BASE_IMAGE}

ARG GDN_RUNTIME_SELECTOR_PATCH_SHA256

COPY vllm-qwen38-fp8-gdn-runtime-metadata-selector-r100-20260901.patch /tmp/gdn-runtime-selector.patch
COPY check-gdn-runtime-metadata-selector-r100.py /opt/neural-download/check-gdn-runtime-metadata-selector-r100.py

RUN test "$(sha256sum /tmp/gdn-runtime-selector.patch | awk '{print $1}')" = \
        "${GDN_RUNTIME_SELECTOR_PATCH_SHA256}" \
    && patch -p1 -d /opt/venv/lib/python3.12/site-packages \
        < /tmp/gdn-runtime-selector.patch \
    && /opt/venv/bin/python -m py_compile \
        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py \
        /opt/neural-download/check-gdn-runtime-metadata-selector-r100.py \
    && rm -f /tmp/gdn-runtime-selector.patch

LABEL neural.download.composite.base.r99="sha256:a2e09416d1f55da2b71ffefbbec7db7d6581089b33ed125c6ea3ed147050eaf8" \
      neural.download.vllm.gdn-runtime-selector.patch.sha256="${GDN_RUNTIME_SELECTOR_PATCH_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp1-gdn-runtime-metadata-selector-r100"
