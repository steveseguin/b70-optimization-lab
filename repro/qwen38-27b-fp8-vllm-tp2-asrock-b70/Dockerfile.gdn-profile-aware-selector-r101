ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-gdn-runtime-metadata-selector-r100
FROM ${BASE_IMAGE}

ARG GDN_PROFILE_SELECTOR_PATCH_SHA256

COPY vllm-qwen38-fp8-gdn-profile-aware-selector-r101-20260901.patch /tmp/gdn-profile-selector.patch
COPY check-gdn-profile-aware-selector-r101.py /opt/neural-download/check-gdn-profile-aware-selector-r101.py

RUN test "$(sha256sum /tmp/gdn-profile-selector.patch | awk '{print $1}')" = \
        "${GDN_PROFILE_SELECTOR_PATCH_SHA256}" \
    && patch -p1 -d /opt/venv/lib/python3.12/site-packages \
        < /tmp/gdn-profile-selector.patch \
    && /opt/venv/bin/python -m py_compile \
        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py \
        /opt/neural-download/check-gdn-profile-aware-selector-r101.py \
    && rm -f /tmp/gdn-profile-selector.patch

LABEL neural.download.composite.base.r100="sha256:a7d055be59452ec90030411038386298a7240172ba29876f1ebabbb251c14e41" \
      neural.download.vllm.gdn-profile-selector.patch.sha256="${GDN_PROFILE_SELECTOR_PATCH_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp1-gdn-profile-aware-selector-r101"
