ARG BASE_IMAGE=neural-download/vllm-openai-xpu:qwen38-fp8-mtp1-gdn-split-mixed-r156
FROM ${BASE_IMAGE}

ARG DRAFT_INT4_APPLY_ROWS_PATCH_SHA256

COPY vllm-qwen38-fp8-draft-int4-head-apply-rows-r160-20260903.patch /tmp/draft-int4-apply-rows.patch
COPY validate-xpu-draft-int4-apply-rows-r160.py /tmp/validate-xpu-draft-int4-apply-rows-r160.py

RUN test "$(sha256sum /tmp/draft-int4-apply-rows.patch | awk '{print $1}')" = \
        "${DRAFT_INT4_APPLY_ROWS_PATCH_SHA256}" \
    && patch --batch --verbose --fuzz=0 -p1 \
        -d /opt/venv/lib/python3.12/site-packages \
        < /tmp/draft-int4-apply-rows.patch \
        > /tmp/draft-int4-apply-rows.patch.log 2>&1 \
    && ! grep -Eiq \
        'trailing garbage|malformed|FAILED|ignored|reversed|offset' \
        /tmp/draft-int4-apply-rows.patch.log \
    && /opt/venv/bin/python -m py_compile \
        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/vocab_parallel_embedding.py \
    && /opt/venv/bin/python /tmp/validate-xpu-draft-int4-apply-rows-r160.py \
        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/vocab_parallel_embedding.py \
    && rm -f /tmp/draft-int4-apply-rows.patch /tmp/draft-int4-apply-rows.patch.log \
        /tmp/validate-xpu-draft-int4-apply-rows-r160.py

LABEL neural.download.composite.base.r156="sha256:901ae9e0ade0109e94dd162d0cf2c398440325b1791f3191376fa0013dc29878" \
      neural.download.vllm.draft-int4-apply-rows.patch.sha256="${DRAFT_INT4_APPLY_ROWS_PATCH_SHA256}" \
      neural.download.build.lane="qwen38-fp8-mtp1-draft-int4-apply-rows-r160"
