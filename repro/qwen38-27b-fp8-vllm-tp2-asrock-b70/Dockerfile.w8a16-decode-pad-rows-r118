        /opt/venv/lib/python3.12/site-packages/vllm/model_executor/kernels/linear/scaled_mm/xpu.py \
    && rm -f /tmp/w8a16-decode-pad.patch /tmp/w8a16-decode-pad.patch.log \
        /tmp/validate-xpu-w8a16-decode-pad-rows-r118.py

LABEL neural.download.composite.base.r117="sha256:52fe73b06d0cbef8c2a007f48f06ff77831b2589fec5d04590e10f079266eedf" \
      neural.download.vllm.w8a16-decode-pad.patch.sha256="${W8A16_DECODE_PAD_PATCH_SHA256}" \
