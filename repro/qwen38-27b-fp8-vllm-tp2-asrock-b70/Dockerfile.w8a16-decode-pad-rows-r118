COPY vllm-qwen38-fp8-w8a16-decode-pad-rows-r118-20260902.patch /tmp/w8a16-decode-pad.patch
COPY validate-xpu-w8a16-decode-pad-rows-r118.py /tmp/validate-xpu-w8a16-decode-pad-rows-r118.py

RUN test "$(sha256sum /tmp/w8a16-decode-pad.patch | awk '{print $1}')" = \
