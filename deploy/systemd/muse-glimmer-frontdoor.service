[Unit]
Description=No-auth LAN OpenAI-compatible frontdoor for Muse Glimmer BF16 fleet
Documentation=https://github.com/steveseguin/b70-optimization-lab
Wants=network-online.target muse-glimmer-bf16-fleet.service
After=network-online.target muse-glimmer-bf16-fleet.service
Conflicts=b70-openai-frontdoor.service minimax-openai-frontdoor.service gemma4-26b-q8-quad-frontdoor.service

[Service]
Type=simple
User=steve
Group=steve
WorkingDirectory=/home/steve/llm-optimizations
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/steve/llm-optimizations/scripts/run-muse-glimmer-frontdoor.sh
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
