[Unit]
Description=MiniMax M2.7 vLLM OpenAI-compatible server
Documentation=https://github.com/steveseguin/b70-optimization-lab
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=steve
Group=steve
WorkingDirectory=/home/steve/llm-optimizations
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DISABLE_XET=1
Environment=VLLM_HOST=0.0.0.0
Environment=VLLM_PORT=8000
Environment=VLLM_MAX_MODEL_LEN=32768
Environment=VLLM_MAX_NUM_BATCHED_TOKENS=512
Environment=VLLM_MAX_NUM_SEQS=1
Environment=VLLM_GPU_MEMORY_UTILIZATION=0.95
ExecStart=/home/steve/bin/minimax-vllm-serve
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=1800
TimeoutStopSec=180
Restart=on-failure
RestartSec=15
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
