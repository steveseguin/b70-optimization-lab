[Unit]
Description=Gemma 4 26B A4B Q8 four-replica llama.cpp backends
Documentation=https://github.com/steveseguin/b70-optimization-lab
Wants=network-online.target
After=network-online.target
Conflicts=gemma4-26b-q8-llamacpp.service b70-vllm-slot.service minimax-vllm.service

[Service]
Type=simple
User=steve
Group=steve
WorkingDirectory=/home/steve/llm-optimizations
Environment=PYTHONUNBUFFERED=1
Environment=GEMMA4_26B_PROFILE=service
Environment=CTX_SIZE=131072
Environment=PARALLEL=2
Environment=CACHE_RAM_MIB=8192
Environment=BASE_PORT=19350
Environment=HOST=127.0.0.1
ExecStart=/home/steve/llm-optimizations/scripts/serve-gemma4-26b-q8-quad-production.sh
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=1800
TimeoutStopSec=180
Restart=on-failure
RestartSec=15
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
