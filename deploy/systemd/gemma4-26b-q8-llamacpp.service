[Unit]
Description=Gemma 4 26B A4B Q8 llama.cpp OpenAI-compatible backend
Documentation=https://github.com/steveseguin/b70-optimization-lab
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=steve
Group=steve
WorkingDirectory=/home/steve/llm-optimizations
Environment=PYTHONUNBUFFERED=1
Environment=GEMMA4_26B_PROFILE=record
Environment=GPU_INDEX=0
Environment=HOST=127.0.0.1
Environment=PORT=19350
ExecStart=/home/steve/llm-optimizations/scripts/serve-gemma4-26b-q8-production.sh
KillMode=mixed
KillSignal=SIGINT
TimeoutStartSec=1800
TimeoutStopSec=180
Restart=on-failure
RestartSec=15
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
