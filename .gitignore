.pause-minimax-production
scripts/__pycache__/
experiments/**/scripts/__pycache__/

# Per-run llama-server stdout logs are large/noisy and duplicated by the
# canonical server_log path captured in each summary.json.
data/**/server.stdout.log

# Model/checkpoint/tensor artifacts are local-only unless explicitly published
# through a large-artifact channel. Commit summaries, manifests, patches, and
# reproduction scripts instead.
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.engine

# Local credentials and tokens. Keep actual secret files outside Git.
SUDOPASSWORD.txt
*.password.txt
.config/huggingface/token
.config/huggingface/curl-auth.conf
.cache/huggingface/token
hf_token
HF_TOKEN
.hf_token
huggingface_token
huggingface-token

# LocalMaxxing API credentials - never commit
.config/localmaxxing/api_key
**/.config/localmaxxing/api_key
**/localmaxxing/api_key
**/localmaxxing/api_key.*
**/*localmaxxing*api*key*
