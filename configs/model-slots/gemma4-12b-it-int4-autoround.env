# Gemma 4 12B IT INT4 AutoRound research slot.
#
# This candidate is downloaded but currently blocked on this stack. The
# checkpoint advertises model_type=gemma4_unified, which local
# vLLM/Transformers does not recognize yet. Keep the profile for future retry
# after the architecture lands upstream.

MODEL_SLOT_NAME="gemma4-12b-it-int4-autoround"
MODEL_SLOT_TITLE="Gemma 4 12B IT INT4 AutoRound image+audio+text"
MODEL_SLOT_HF_ID="Vishva007/gemma-4-12B-it-W4A16-AutoRound"
MODEL_SLOT_MODALITIES="text,image,audio"
MODEL_SLOT_STATUS="blocked-architecture"

VENV="${VENV:-/home/steve/.venvs/vllm-xpu}"
HF_HOME="${HF_HOME:-/mnt/fast-ai/llm-cache/hf}"
TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/transformers}"
VLLM_CACHE_ROOT="${VLLM_CACHE_ROOT:-/mnt/fast-ai/vllm-cache-exp/gemma4-12b-it-int4-autoround-slot}"
MODEL_DIR="${MODEL_DIR:-/mnt/fast-ai/llm-models/gemma4-12b-it-int4-autoround-vishva007}"
VLLM_SERVED_MODEL_NAME="${VLLM_SERVED_MODEL_NAME:-gemma4-12b-it-int4-autoround}"

ONEAPI_DEVICE_SELECTOR="${ONEAPI_DEVICE_SELECTOR:-level_zero:0,1,2,3}"
ZE_AFFINITY_MASK="${ZE_AFFINITY_MASK:-0,1,2,3}"
CCL_ATL_TRANSPORT="${CCL_ATL_TRANSPORT:-ofi}"
CCL_TOPO_P2P_ACCESS="${CCL_TOPO_P2P_ACCESS:-1}"

VLLM_HOST="${VLLM_HOST:-127.0.0.1}"
VLLM_PORT="${VLLM_PORT:-18080}"
VLLM_DTYPE="${VLLM_DTYPE:-float16}"
VLLM_QUANTIZATION="${VLLM_QUANTIZATION:-auto}"
VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-4}"
VLLM_PIPELINE_PARALLEL_SIZE="${VLLM_PIPELINE_PARALLEL_SIZE:-1}"
VLLM_DISTRIBUTED_EXECUTOR_BACKEND="${VLLM_DISTRIBUTED_EXECUTOR_BACKEND:-mp}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-32768}"
VLLM_MAX_NUM_BATCHED_TOKENS="${VLLM_MAX_NUM_BATCHED_TOKENS:-4096}"
VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-8}"
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.95}"
VLLM_KV_CACHE_DTYPE="${VLLM_KV_CACHE_DTYPE:-auto}"
VLLM_ENABLE_PREFIX_CACHING="${VLLM_ENABLE_PREFIX_CACHING:-1}"
VLLM_TRUST_REMOTE_CODE="${VLLM_TRUST_REMOTE_CODE:-1}"
VLLM_EXTRA_ARGS=(--limit-mm-per-prompt '{"image":4,"audio":2}')

FRONTDOOR_HOST="${FRONTDOOR_HOST:-0.0.0.0}"
FRONTDOOR_PORT="${FRONTDOOR_PORT:-8000}"
FRONTDOOR_BACKEND_URL="${FRONTDOOR_BACKEND_URL:-http://127.0.0.1:18080}"
FRONTDOOR_MAX_ACTIVE_GENERATIONS="${FRONTDOOR_MAX_ACTIVE_GENERATIONS:-8}"
FRONTDOOR_QUEUE_TIMEOUT_S="${FRONTDOOR_QUEUE_TIMEOUT_S:-3600}"
FRONTDOOR_BACKEND_TIMEOUT_S="${FRONTDOOR_BACKEND_TIMEOUT_S:-7200}"
FRONTDOOR_PAUSE_FILE="${FRONTDOOR_PAUSE_FILE:-/home/steve/llm-optimizations/.pause-vllm-model-slot}"
