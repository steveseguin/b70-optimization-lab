# Qwen3.6 35B-A3B FP8 TP2 latency probe.
#
# Keeps the same 8-bit FP8 requant path as the TP4 profile but uses two XPUs
# to reduce tensor-parallel communication for interactive single-stream speed.

source /home/steve/llm-optimizations/configs/model-slots/qwen36-35b-a3b-fp8-requant-c48.env

MODEL_SLOT_NAME="qwen36-35b-a3b-fp8-requant-tp2-c4"
MODEL_SLOT_TITLE="Qwen3.6 35B-A3B FP8 requant TP2 c4"
MODEL_SLOT_STATUS="latency-probe-requant-tp2"

ONEAPI_DEVICE_SELECTOR="level_zero:0,1"
ZE_AFFINITY_MASK="0,1"

VLLM_TENSOR_PARALLEL_SIZE="2"
VLLM_MAX_MODEL_LEN="32768"
VLLM_MAX_NUM_BATCHED_TOKENS="4096"
VLLM_MAX_NUM_SEQS="4"
FRONTDOOR_MAX_ACTIVE_GENERATIONS="4"
