# Qwen3.6 35B-A3B Quark W8A8 INT8 production-candidate slot.
#
# Quality-preserving speed path validated 2026-06-09:
# - same Quark W8A8 INT8 checkpoint and BF16 activation/runtime dtype
# - native XPU dense INT8 linear and native XPU INT8 MoE backend
# - XPU PIECEWISE graph capture, with attention left outside captured regions
# - clone-safe custom-op all-reduce collectives inside graph regions
# - 32K context preserved
#
# Warmed local TP4/32K direct-backend benchmark:
#   no graph: ~16.7-17.2 tok/s
#   piecewise graph: ~92 tok/s after first-request warmup
#   piecewise graph + clone-safe custom collectives: ~95.3 tok/s
#   48 concurrent 256-token requests: ~2,080 aggregate tok/s, p95 ~5.9s
#   64 concurrent 256-token requests: slower aggregate; keep active cap at 48

MODEL_SLOT_NAME="qwen36-35b-a3b-quark-int8-graph32k"
MODEL_SLOT_TITLE="Qwen3.6 35B-A3B Quark W8A8 INT8 32K graph"
MODEL_SLOT_HF_ID="nameistoken/Qwen3.6-35B-A3B-Quark-W8A8-INT8"
MODEL_SLOT_MODALITIES="text"
MODEL_SLOT_STATUS="production-candidate"

VENV="${VENV:-/home/steve/.venvs/vllm-xpu}"
HF_HOME="${HF_HOME:-/mnt/fast-ai/llm-cache/hf}"
TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/transformers}"
VLLM_CACHE_ROOT="${VLLM_CACHE_ROOT:-/mnt/fast-ai/vllm-cache-exp/qwen36-35b-a3b-quark-int8-prod32k-xpugraph}"
MODEL_DIR="${MODEL_DIR:-/mnt/fast-ai/llm-cache/hf/models--nameistoken--Qwen3.6-35B-A3B-Quark-W8A8-INT8/snapshots/cced56592e8c8935f8220836b4baa04dfd389118}"
VLLM_SERVED_MODEL_NAME="${VLLM_SERVED_MODEL_NAME:-qwen36-35b-a3b-fp8}"

PYTHONPATH="/home/steve/src/vllm:/home/steve/src/vllm-xpu-kernels:${PYTHONPATH:-}"
LD_LIBRARY_PATH="/home/steve/src/vllm-xpu-kernels/vllm_xpu_kernels:${LD_LIBRARY_PATH:-}"

