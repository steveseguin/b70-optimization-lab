# Qwen3.6 35B-A3B FP8 TP2 XPU graph latency probe.

source /home/steve/llm-optimizations/configs/model-slots/qwen36-35b-a3b-fp8-requant-tp2-c4.env

MODEL_SLOT_NAME="qwen36-35b-a3b-fp8-requant-tp2-c4-xpugraph"
MODEL_SLOT_TITLE="Qwen3.6 35B-A3B FP8 requant TP2 c4 XPU graph"
MODEL_SLOT_STATUS="latency-probe-requant-tp2-xpugraph"

XPU_GRAPH="1"
VLLM_XPU_ENABLE_XPU_GRAPH="1"
VLLM_XPU_FORCE_GRAPH_WITH_COMM="1"
VLLM_XPU_GRAPH_NOOP_COMM_CAPTURE="1"
