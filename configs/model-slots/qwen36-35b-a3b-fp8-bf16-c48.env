# Qwen3.6 35B-A3B FP8 BF16-fallback comparison slot.
#
# Mirrors qwen36-35b-a3b-fp8-requant-c48 for quality/perf A/B testing, but
# leaves the experimental XPU block-FP8 requant path disabled.

source /home/steve/llm-optimizations/configs/model-slots/qwen36-35b-a3b-fp8.env

MODEL_SLOT_NAME="qwen36-35b-a3b-fp8-bf16-c48"
MODEL_SLOT_TITLE="Qwen3.6 35B-A3B FP8 BF16 fallback c48"
MODEL_SLOT_STATUS="comparison-bf16-fallback"

# Keep the public served model stable for existing clients.
VLLM_SERVED_MODEL_NAME="qwen36-35b-a3b-fp8"

# Explicitly prefer the existing safe path for block-FP8 weights.
VLLM_XPU_BLOCK_FP8_REQUANT="0"
VLLM_XPU_ENABLE_XPU_GRAPH="0"

VLLM_MAX_MODEL_LEN="32768"
VLLM_MAX_NUM_BATCHED_TOKENS="8192"
VLLM_MAX_NUM_SEQS="48"
FRONTDOOR_MAX_ACTIVE_GENERATIONS="48"

VLLM_LANGUAGE_MODEL_ONLY="1"

VLLM_EXTRA_ARGS=(--generation-config vllm)
