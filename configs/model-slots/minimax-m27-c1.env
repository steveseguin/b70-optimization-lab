# Production/default single-model slot.
#
# This profile keeps the proven MiniMax c1 service shape: one active generation,
# 32768-token served context, no CPU KV offload, and no public auth on the LAN
# frontdoor.

MODEL_SLOT_NAME="minimax-m27-c1"
MODEL_SLOT_TITLE="MiniMax M2.7 INT4 AutoRound c1"
MODEL_SLOT_HF_ID="Lasimeri/MiniMax-M2.7-int4-AutoRound"
MODEL_SLOT_MODALITIES="text"
MODEL_SLOT_STATUS="production"

source /home/steve/llm-optimizations/repro/minimax-m27-b70-89tps-20260520/configs/promoted-env.sh

MODEL_DIR="${MODEL:-/mnt/fast-ai/llm-models/minimax-m2.7-int4-autoround}"
VLLM_SERVED_MODEL_NAME="${VLLM_SERVED_MODEL_NAME:-minimax-m27-int4}"
VLLM_HOST="${VLLM_HOST:-127.0.0.1}"
VLLM_PORT="${VLLM_PORT:-18080}"
VLLM_DTYPE="${VLLM_DTYPE:-float16}"
VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-4}"
VLLM_DISTRIBUTED_EXECUTOR_BACKEND="${VLLM_DISTRIBUTED_EXECUTOR_BACKEND:-mp}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-32768}"
VLLM_MAX_NUM_BATCHED_TOKENS="${VLLM_MAX_NUM_BATCHED_TOKENS:-512}"
VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-1}"
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.95}"
VLLM_BLOCK_SIZE="${VLLM_BLOCK_SIZE:-256}"
VLLM_ENABLE_PREFIX_CACHING="${VLLM_ENABLE_PREFIX_CACHING:-0}"
VLLM_TRUST_REMOTE_CODE="${VLLM_TRUST_REMOTE_CODE:-1}"
VLLM_COMPILATION_CONFIG='{"use_inductor_graph_partition":true,"compile_sizes":[1],"cudagraph_mode":"PIECEWISE"}'

FRONTDOOR_HOST="${FRONTDOOR_HOST:-0.0.0.0}"
FRONTDOOR_PORT="${FRONTDOOR_PORT:-8000}"
FRONTDOOR_BACKEND_URL="${FRONTDOOR_BACKEND_URL:-http://127.0.0.1:18080}"
FRONTDOOR_MAX_ACTIVE_GENERATIONS="${FRONTDOOR_MAX_ACTIVE_GENERATIONS:-1}"
FRONTDOOR_QUEUE_TIMEOUT_S="${FRONTDOOR_QUEUE_TIMEOUT_S:-3600}"
FRONTDOOR_BACKEND_TIMEOUT_S="${FRONTDOOR_BACKEND_TIMEOUT_S:-7200}"
FRONTDOOR_PAUSE_FILE="${FRONTDOOR_PAUSE_FILE:-/home/steve/llm-optimizations/.pause-vllm-model-slot}"
