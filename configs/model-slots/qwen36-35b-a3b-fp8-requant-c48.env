# Qwen3.6 35B-A3B FP8 production-candidate slot.
#
# This builds on the diagnostic FP8 slot but opts into the experimental XPU
# block-FP8 requant path and raises scheduler/frontdoor concurrency. The
# requant path maps 128x128 block-FP8 weights to per-channel FP8 W8A16, so keep
# a quality smoke in the promotion checklist.

source /home/steve/llm-optimizations/configs/model-slots/qwen36-35b-a3b-fp8.env

MODEL_SLOT_NAME="qwen36-35b-a3b-fp8-requant-c48"
MODEL_SLOT_TITLE="Qwen3.6 35B-A3B FP8 requant c48"
MODEL_SLOT_STATUS="production-candidate-requant"

# Keep the public served model stable for existing clients.
VLLM_SERVED_MODEL_NAME="qwen36-35b-a3b-fp8"

# Faster but experimental dense-linear path for block-FP8 checkpoints on XPU.
VLLM_XPU_BLOCK_FP8_REQUANT="1"

# XPU graph remains off for TP4. Local notes show graph capture around
# communication ops is either disabled or negative for this class of run.
VLLM_XPU_ENABLE_XPU_GRAPH="0"

# 32K context stays enabled while raising active sequence capacity under the
# KV-cache headroom reported by vLLM for this model on 4x B70.
VLLM_MAX_MODEL_LEN="32768"
VLLM_MAX_NUM_BATCHED_TOKENS="8192"
VLLM_MAX_NUM_SEQS="48"
FRONTDOOR_MAX_ACTIVE_GENERATIONS="48"
FRONTDOOR_DEFAULT_MAX_OUTPUT_TOKENS="2048"
FRONTDOOR_MAX_OUTPUT_TOKENS="4096"

# This slot is intended for text serving through the OpenAI-compatible frontdoor.
VLLM_LANGUAGE_MODEL_ONLY="1"

VLLM_EXTRA_ARGS=(--generation-config vllm)
