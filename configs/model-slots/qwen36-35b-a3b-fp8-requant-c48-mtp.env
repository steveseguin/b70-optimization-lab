# Qwen3.6 35B-A3B FP8 requant slot with native MTP speculative decoding.
#
# This keeps the same 8-bit FP8 XPU W8A16 linear path as the c48 profile and
# enables the model's built-in multi-token prediction head for speed testing.

source /home/steve/llm-optimizations/configs/model-slots/qwen36-35b-a3b-fp8-requant-c48.env

MODEL_SLOT_NAME="qwen36-35b-a3b-fp8-requant-c48-mtp"
MODEL_SLOT_TITLE="Qwen3.6 35B-A3B FP8 requant c48 MTP"
MODEL_SLOT_STATUS="experimental-requant-mtp"

VLLM_EXTRA_ARGS=(
  --generation-config vllm
  --speculative-config '{"method":"mtp","num_speculative_tokens":3}'
)
