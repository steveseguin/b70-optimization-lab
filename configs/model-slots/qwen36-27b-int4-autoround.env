# Experimental Qwen3.6 27B INT4 AutoRound model-slot profile.
#
# This profile is available for service-slot testing after the manual TP1 smoke
# passes. It is not production-ready yet.

MODEL_SLOT_NAME="qwen36-27b-int4-autoround"
MODEL_SLOT_TITLE="Qwen3.6 27B INT4 AutoRound"
MODEL_SLOT_HF_ID="Intel/Qwen3.6-27B-int4-AutoRound"
MODEL_SLOT_MODALITIES="text"
MODEL_SLOT_STATUS="experimental-bringup"

QWEN36_27B_AR_REVISION="${QWEN36_27B_AR_REVISION:-abc86de19eb1ebbf6a7df4582341325c22ddcb7d}"
HF_HOME="${HF_HOME:-/mnt/fast-ai/llm-cache/hf}"
TRANSFORMERS_CACHE="${TRANSFORMERS_CACHE:-$HF_HOME/transformers}"
HF_HUB_DISABLE_XET="${HF_HUB_DISABLE_XET:-1}"

snapshot_dir="$HF_HOME/hub/models--Intel--Qwen3.6-27B-int4-AutoRound/snapshots/$QWEN36_27B_AR_REVISION"
if [[ -d "$snapshot_dir" ]]; then
  MODEL_DIR="${MODEL_DIR:-$snapshot_dir}"
else
  MODEL_DIR="${MODEL_DIR:-Intel/Qwen3.6-27B-int4-AutoRound}"
fi

VLLM_SERVED_MODEL_NAME="${VLLM_SERVED_MODEL_NAME:-qwen36-27b-int4-autoround}"
VLLM_HOST="${VLLM_HOST:-127.0.0.1}"
VLLM_PORT="${VLLM_PORT:-18080}"
VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-1}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-2048}"
VLLM_MAX_NUM_BATCHED_TOKENS="${VLLM_MAX_NUM_BATCHED_TOKENS:-1024}"
VLLM_MAX_NUM_SEQS="${VLLM_MAX_NUM_SEQS:-1}"
VLLM_GPU_MEMORY_UTILIZATION="${VLLM_GPU_MEMORY_UTILIZATION:-0.95}"
VLLM_ENABLE_PREFIX_CACHING="${VLLM_ENABLE_PREFIX_CACHING:-0}"
VLLM_TRUST_REMOTE_CODE="${VLLM_TRUST_REMOTE_CODE:-1}"

ONEAPI_DEVICE_SELECTOR="${ONEAPI_DEVICE_SELECTOR:-level_zero:0}"
ZE_AFFINITY_MASK="${ZE_AFFINITY_MASK:-0}"

VLLM_EXTRA_ARGS=(
  --reasoning-parser qwen3
  --default-chat-template-kwargs '{"enable_thinking": false}'
  --enable-prompt-tokens-details
  --speculative-config '{"method":"qwen3_next_mtp","num_speculative_tokens":2}'
)

FRONTDOOR_HOST="${FRONTDOOR_HOST:-0.0.0.0}"
FRONTDOOR_PORT="${FRONTDOOR_PORT:-8000}"
FRONTDOOR_BACKEND_URL="${FRONTDOOR_BACKEND_URL:-http://127.0.0.1:18080}"
FRONTDOOR_MAX_ACTIVE_GENERATIONS="${FRONTDOOR_MAX_ACTIVE_GENERATIONS:-1}"
FRONTDOOR_QUEUE_TIMEOUT_S="${FRONTDOOR_QUEUE_TIMEOUT_S:-3600}"
FRONTDOOR_BACKEND_TIMEOUT_S="${FRONTDOOR_BACKEND_TIMEOUT_S:-7200}"
FRONTDOOR_PAUSE_FILE="${FRONTDOOR_PAUSE_FILE:-/home/steve/llm-optimizations/.pause-vllm-model-slot}"
