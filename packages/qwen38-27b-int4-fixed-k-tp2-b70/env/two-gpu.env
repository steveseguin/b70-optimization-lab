# Operator knobs for the two-card profile.
#
# Nothing here changes the measured configuration. Everything that affects output identity or speed
# lives in compose.yaml, which is generated from the recipe launcher and checked in CI. Point
# MODEL_DIR at the verified model directory and the rest can stay as it is.
COMPOSE_SERVICE=two-gpu
MODEL_DIR=/path/to/qwen3.8-27b-int4-autoround-gptq-relabel
VLLM_CACHE_DIR=./cache-two-gpu
CONTAINER_NAME=qwen38-27b-int4-two-gpu
PORT=18134
